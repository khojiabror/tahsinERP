@{
    var pm = Model as tahsinERP.ControlPanel.Pages.Portal.PortalPageModel;
    bool signedIn = pm?.SignedIn == true;
    bool onPrem = pm?.CurrentTenant?.Deployment == DeploymentKind.OnPrem;
    string path = Context.Request.Path.Value ?? "/";
    string Nav(string prefix) => (prefix == "/" ? path == "/" : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    string userName = User.Identity?.Name ?? "";
    string initials = string.Concat(userName.Split(' ', '.', '@').Where(s => s.Length > 0).Take(2).Select(s => char.ToUpperInvariant(s[0])));
    bool authPage = !signedIn || new[] { "/Login", "/Otp", "/Forgot", "/Invite" }.Any(p => path.StartsWith(p, StringComparison.OrdinalIgnoreCase));
    if (authPage) { Layout = "_AuthLayout"; ViewData["AuthKind"] = "portal"; }
}
@if (authPage)
{
    @if (!string.IsNullOrEmpty(pm?.FlashOk)) { <div class="flash ok">@pm.FlashOk</div> }
    @if (!string.IsNullOrEmpty(pm?.FlashError)) { <div class="flash bad">@pm.FlashError</div> }
    @RenderBody()
}
else
{
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] · tahsinERP Kabinet</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <meta name="theme-color" content="#0a0f1d" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/fonts/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app portal">
<partial name="_Icons" />
<aside class="sidebar" id="sidebar">
    <a class="sb-brand" href="/">
        <img class="logo-img" src="/img/logo.png" alt="" width="36" height="36" />
        <span class="sb-brand-t">tahsin<b>ERP</b><small>Mijoz kabineti</small></span>
    </a>
    @if (pm!.CurrentTenant is { } ct)
    {
        <div class="sb-tenant"><svg class="i"><use href="#i-building" /></svg><span>@ct.LegalName</span></div>
    }
    <nav class="sb-nav">
        <a class="@Nav("/")" href="/"><svg class="i"><use href="#i-home" /></svg>Bosh sahifa</a>
        <a class="@Nav("/Invoices")" href="/Invoices"><svg class="i"><use href="#i-file" /></svg>Hisob-fakturalar</a>
        <a class="@Nav("/Payment")" href="/Payment"><svg class="i"><use href="#i-card" /></svg>To'lov rekvizitlari</a>
        <a class="@Nav("/Requests")" href="/Requests"><svg class="i"><use href="#i-layers" /></svg>Tarif so'rovi</a>
        @if (onPrem) { <a class="@Nav("/Licenses")" href="/Licenses"><svg class="i"><use href="#i-key" /></svg>Litsenziya kaliti</a> }
    </nav>
    <form method="post" action="/Logout" class="sb-user">
        <span class="avatar">@initials</span>
        <a class="sb-user-t" href="/Profile"><b>@userName</b><small>Profil</small></a>
        @Html.AntiForgeryToken()
        <button type="submit" class="icon-btn" title="Chiqish"><svg class="i"><use href="#i-logout" /></svg></button>
    </form>
</aside>
<div class="sb-backdrop" data-nav-close></div>
<div class="shell">
    <header class="topbar">
        <button type="button" class="icon-btn nav-toggle" data-nav-toggle aria-label="Menyu"><svg class="i"><use href="#i-menu" /></svg></button>
        <div class="crumbs"><span>Kabinet</span><b>@ViewData["Title"]</b></div>
        <div class="tb-right">
            <span class="tb-secure"><svg class="i"><use href="#i-shield" /></svg>Himoyalangan seans</span>
            <button type="button" class="icon-btn" data-theme-toggle aria-label="Mavzu"><svg class="i only-light"><use href="#i-moon" /></svg><svg class="i only-dark"><use href="#i-sun" /></svg></button>
        </div>
    </header>
    <main>
        @if (!string.IsNullOrEmpty(pm.FlashOk)) { <div class="flash ok">@pm.FlashOk</div> }
        @if (!string.IsNullOrEmpty(pm.FlashError)) { <div class="flash bad">@pm.FlashError</div> }
        @RenderBody()
    </main>
</div>
<script src="~/js/app.js" asp-append-version="true"></script>
<script src="~/js/portal.js" asp-append-version="true"></script>
</body>
</html>
}
