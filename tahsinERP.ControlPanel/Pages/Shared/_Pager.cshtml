@* Jadval ostidagi sahifalash: qatorlar soni (10/25/50/100), "1–25 / 340" va sahifa raqamlari. Model — Paging.ToPageAsync natijasi.
   Boshqa so'rov parametrlari (filtrlar, sahifadagi boshqa jadvallarning sahifasi) saqlanadi; qatorlar soni o'zgarsa — 1-sahifaga.
   Prefiksli jadval (bitta sahifada bir nechta) — havola shu jadval pager'iga qaytaradi (#{prefix}pager). *@
@model PageInfo
@{
    var keep = Context.Request.Query
        .Where(kv => kv.Key != Model.PageParam && kv.Key != Model.SizeParam && kv.Key != "handler")
        .SelectMany(kv => kv.Value.Select(v => new KeyValuePair<string, string?>(kv.Key, v)))
        .ToList();
    string anchor = Model.Prefix.Length > 0 ? "#" + Model.Prefix + "pager" : "";
    string Href(int page) => Context.Request.Path
        + QueryString.Create(keep.Append(new(Model.PageParam, page.ToString())).Append(new(Model.SizeParam, Model.Size.ToString()))) + anchor;
    // Ko'rsatiladigan sahifa raqamlari: 1, joriy ±2, oxirgi; oraliqlar "…" bilan.
    var nums = new SortedSet<int> { 1, Model.Pages };
    for (int i = Model.Page - 2; i <= Model.Page + 2; i++) if (i >= 1 && i <= Model.Pages) nums.Add(i);
    string selectId = Model.Prefix + "pager-size";
}
@if (Model.Total > PageInfo.Sizes[0])
{
    <div class="pager" id="@(Model.Prefix)pager">
        <form method="get" class="pager-size" action="@(Context.Request.Path + anchor)">
            @foreach (var kv in keep) { <input type="hidden" name="@kv.Key" value="@kv.Value" /> }
            <label for="@selectId">@L.T("Pnl_Pager_Rows")</label>
            <select id="@selectId" name="@Model.SizeParam" data-autosubmit>
                @foreach (int s in PageInfo.Sizes) { <option value="@s" selected="@(s == Model.Size)">@s</option> }
            </select>
            <noscript><button type="submit" class="secondary">OK</button></noscript>
        </form>
        <span class="pager-info">@L.T("Pnl_Pager_Info", Model.From, Model.To, Model.Total)</span>
        @if (Model.Pages > 1)
        {
            <nav class="pager-pages" aria-label="@L.T("Pnl_Pager_Nav")">
                @if (Model.Page > 1) { <a href="@Href(Model.Page - 1)" rel="prev" aria-label="@L.T("Pnl_Pager_Prev")">‹</a> }
                else { <span class="off">‹</span> }
                @{ int prev = 0; }
                @foreach (int n in nums)
                {
                    if (n - prev > 1) { <span class="gap">…</span> }
                    if (n == Model.Page) { <span class="cur" aria-current="page">@n</span> }
                    else { <a href="@Href(n)">@n</a> }
                    prev = n;
                }
                @if (Model.Page < Model.Pages) { <a href="@Href(Model.Page + 1)" rel="next" aria-label="@L.T("Pnl_Pager_Next")">›</a> }
                else { <span class="off">›</span> }
            </nav>
        }
    </div>
}
