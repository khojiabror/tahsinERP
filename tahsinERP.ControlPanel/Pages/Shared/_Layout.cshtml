@inject ControlDbContext LayoutDb
@inject Microsoft.Extensions.Options.IOptions<tahsinERP.ControlPanel.Security.SecurityOptions> Security
@{
    bool signedIn = User.Identity?.IsAuthenticated == true && User.Identity.AuthenticationType == AuthSchemes.Staff;
    bool owner = User.IsInRole(nameof(StaffRole.Owner));
    string path = Context.Request.Path.Value ?? "/";
    string Nav(string prefix) => (prefix == "/" ? path == "/" : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var flashPage = Model as PanelPageModel;
    int openRequests = signedIn ? await LayoutDb.PortalRequests.CountAsync(r => r.Status == PortalRequestStatus.Pending) : 0;
    string userName = User.Identity?.Name ?? "";
    string initials = string.Concat(userName.Split(' ', '.', '@').Where(s => s.Length > 0).Take(2).Select(s => char.ToUpperInvariant(s[0])));
    string role = User.IsInRole(nameof(StaffRole.Owner)) ? "Owner" : User.IsInRole(nameof(StaffRole.Sales)) ? L.T("Pnl_RoleSales") : L.T("Pnl_RoleSupport");
    bool authPage = !signedIn || new[] { "/Account/Login", "/Account/Totp", "/Account/EnrollTotp" }.Any(p => path.StartsWith(p, StringComparison.OrdinalIgnoreCase));
    if (authPage) { Layout = "_AuthLayout"; ViewData["AuthKind"] = "staff"; }
}
@if (authPage)
{
    @if (!string.IsNullOrEmpty(flashPage?.FlashOk)) { <div class="flash ok">@flashPage.FlashOk</div> }
    @if (!string.IsNullOrEmpty(flashPage?.FlashError)) { <div class="flash bad">@flashPage.FlashError</div> }
    @RenderBody()
}
else
{
<!DOCTYPE html>
<html lang="@L.HtmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · tahsinERP Admin</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0f1d" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (ViewData["AutoRefresh"] is int refreshSeconds) { <meta http-equiv="refresh" content="@refreshSeconds" /> }
</head>
<body class="app" data-idle-minutes="@Security.Value.EffectiveStaffIdleMinutes">
<partial name="_Icons" />
<aside class="sidebar" id="sidebar">
    <a class="sb-brand" href="/">
        <span class="logo-mark"><svg class="i"><use href="#i-shield" /></svg></span>
        <span class="sb-brand-t">tahsin<b>ERP</b><small>@L.T("Pnl_Brand")</small></span>
    </a>
    <nav class="sb-nav">
        <div class="sb-group">@L.T("Pnl_NavMain")</div>
        <a class="@Nav("/")" href="/"><svg class="i"><use href="#i-home" /></svg>@L.T("Home")</a>
        <a class="@Nav("/Tenants")" href="/Tenants"><svg class="i"><use href="#i-building" /></svg>@L.T("Pnl_NavTenants")</a>
        <a class="@Nav("/Requests")" href="/Requests"><svg class="i"><use href="#i-inbox" /></svg><span>@L.T("Pnl_NavRequests")</span>@if (openRequests > 0) { <span class="sb-count">@openRequests</span> }</a>
        <div class="sb-group">@L.T("Pnl_NavFinance")</div>
        <a class="@Nav("/Invoices")" href="/Invoices"><svg class="i"><use href="#i-file" /></svg>@L.T("Pnl_NavInvoices")</a>
        @if (owner || User.IsInRole(nameof(StaffRole.Sales)))
        {
            <a class="@Nav("/Bank")" href="/Bank"><svg class="i"><use href="#i-bank" /></svg>@L.T("Pnl_NavBank")</a>
        }
        <a class="@Nav("/Plans")" href="/Plans"><svg class="i"><use href="#i-layers" /></svg>@L.T("Pnl_NavPlans")</a>
        <div class="sb-group">@L.T("Pnl_NavTech")</div>
        <a class="@Nav("/Licenses")" href="/Licenses"><svg class="i"><use href="#i-key" /></svg>@L.T("Pnl_NavLicenses")</a>
        <a class="@Nav("/Provisioning")" href="/Provisioning"><svg class="i"><use href="#i-cpu" /></svg>@L.T("Pnl_NavProvisioning")</a>
        @if (owner)
        {
            <a class="@Nav("/Servers")" href="/Servers"><svg class="i"><use href="#i-server" /></svg>@L.T("Pnl_NavServers")</a>
            <a class="@Nav("/Updates")" href="/Updates"><svg class="i"><use href="#i-download" /></svg>@L.T("Pnl_NavUpdates")</a>
        }
        <div class="sb-group">@L.T("Pnl_NavAnalytics")</div>
        <a class="@Nav("/Traction")" href="/Traction"><svg class="i"><use href="#i-trending" /></svg>@L.T("Pnl_NavTraction")</a>
        <a class="@Nav("/Notifications")" href="/Notifications"><svg class="i"><use href="#i-bell" /></svg>@L.T("Pnl_NavNotifications")</a>
        @if (owner)
        {
            <div class="sb-group">@L.T("Pnl_NavAdmin")</div>
            <a class="@Nav("/Staff")" href="/Staff"><svg class="i"><use href="#i-users" /></svg>@L.T("Pnl_NavStaff")</a>
            <a class="@Nav("/Audit")" href="/Audit"><svg class="i"><use href="#i-shield" /></svg>@L.T("Pnl_NavAudit")</a>
        }
    </nav>
    <form method="post" action="/Account/Logout" class="sb-user" data-logout-form>
        <span class="avatar">@initials</span>
        <span class="sb-user-t"><b>@userName</b><small>@role</small></span>
        <a href="/Account/ChangePassword" class="icon-btn" title="@L.T("Pnl_ChangePassword")"><svg class="i"><use href="#i-lock" /></svg></a>
        @Html.AntiForgeryToken()
        <button type="submit" class="icon-btn" title="@L.T("Pnl_Logout")"><svg class="i"><use href="#i-logout" /></svg></button>
    </form>
</aside>
<div class="sb-backdrop" data-nav-close></div>
<div class="shell">
    <header class="topbar">
        <button type="button" class="icon-btn nav-toggle" data-nav-toggle aria-label="@L.T("Pnl_Menu")"><svg class="i"><use href="#i-menu" /></svg></button>
        <div class="crumbs"><span>@L.T("Pnl_Crumb")</span><b>@ViewData["Title"]</b></div>
        <div class="tb-right">
            <span class="tb-secure"><svg class="i"><use href="#i-shield" /></svg>@L.T("Pnl_SecureSession")</span>
            <partial name="_LangSwitch" />
            <button type="button" class="icon-btn" data-theme-toggle aria-label="@L.T("Pnl_Theme")"><svg class="i only-light"><use href="#i-moon" /></svg><svg class="i only-dark"><use href="#i-sun" /></svg></button>
        </div>
    </header>
    <main>
        @if (!string.IsNullOrEmpty(flashPage?.FlashOk))
        {
            <div class="flash ok">@flashPage.FlashOk</div>
        }
        @if (!string.IsNullOrEmpty(flashPage?.FlashError))
        {
            <div class="flash bad">@flashPage.FlashError</div>
        }
        @RenderBody()
    </main>
</div>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
}
