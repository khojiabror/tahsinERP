@* Kirish ekranlari (xodim va mijoz) uchun "xavfsiz kirish terminali" qobig'i. _Layout / _PortalLayout login bo'lmaganda shu yerga uzatadi. *@
@inject Microsoft.Extensions.Options.IOptions<tahsinERP.ControlPanel.Security.SecurityOptions> Security
@{
    bool portal = (ViewData["AuthKind"] as string) == "portal";
    bool staffTotp = Security.Value.RequireStaffTotp;
    string zone = portal ? "MIJOZ KABINETI" : "BOSHQARUV PANELI";
}
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] — tahsinERP @(portal ? "mijoz kabineti" : "panel")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth">
<partial name="_Icons" />
<div class="auth-bg" aria-hidden="true">
    <div class="auth-grid"></div>
    <div class="auth-glow"></div>
    <div class="auth-scan"></div>
</div>
<header class="auth-top">
    <a class="auth-brand" href="/">
        <span class="logo-mark"><svg class="i"><use href="#i-shield" /></svg></span>
        <span>tahsin<b>ERP</b></span>
    </a>
    <span class="auth-zone">@zone · XAVFSIZ KIRISH</span>
    <span class="auth-status"><i></i> TIZIM ONLINE</span>
    <span class="auth-clock" data-clock>--:--:-- UTC</span>
</header>
<div class="auth-wrap">
    <section class="auth-intro" aria-hidden="true">
        <div class="radar">
            <div class="radar-sweep"></div>
            <svg viewBox="0 0 200 200" class="radar-rings">
                <circle cx="100" cy="100" r="96" class="r1" />
                <circle cx="100" cy="100" r="72" class="r2" />
                <circle cx="100" cy="100" r="48" class="r3" />
                <path d="M100 4v192M4 100h192" class="cross" />
            </svg>
            <div class="radar-core"><svg class="i"><use href="#i-@(portal ? "lock" : "shield")" /></svg></div>
            <span class="blip b1"></span><span class="blip b2"></span><span class="blip b3"></span>
        </div>
        <h2>Himoyalangan hudud</h2>
        <p>Faqat vakolatli @(portal ? "mijozlar" : "xodimlar") uchun.@(portal || staffTotp ? " Shaxsingiz ikki bosqichda tasdiqlanadi." : "")</p>
        <ul class="auth-feats">
            @if (portal)
            {
                <li><svg class="i"><use href="#i-send" /></svg>Bir martalik kod — Telegram, SMS yoki email</li>
                <li><svg class="i"><use href="#i-lock" /></svg>Shifrlangan ulanish (HTTPS)</li>
                <li><svg class="i"><use href="#i-scan" /></svg>Ko'p marta xato urinishda hisob bloklanadi</li>
            }
            else
            {
                @if (staffTotp) { <li><svg class="i"><use href="#i-scan" /></svg>Ikki bosqichli tasdiqlash (TOTP)</li> }
                else { <li><svg class="i"><use href="#i-scan" /></svg>Ko'p marta xato urinishda hisob bloklanadi</li> }
                <li><svg class="i"><use href="#i-activity" /></svg>Har bir kirish audit jurnaliga yoziladi</li>
                <li><svg class="i"><use href="#i-lock" /></svg>Shifrlangan ulanish (HTTPS)</li>
            }
        </ul>
    </section>
    <main>
        @RenderBody()
    </main>
</div>
<footer class="auth-foot">
    <span>Ruxsatsiz kirish taqiqlanadi. Barcha urinishlar qayd etiladi.</span>
    <span>© @DateTime.UtcNow.Year tahsinERP</span>
</footer>
<script src="~/js/app.js" asp-append-version="true"></script>
@if (portal) { <script src="~/js/portal.js" asp-append-version="true"></script> }
</body>
</html>
