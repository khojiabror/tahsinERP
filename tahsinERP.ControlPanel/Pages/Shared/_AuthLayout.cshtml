@* Kirish ekranlari (xodim va mijoz) — tahsinerp.uz bosh sahifasi uslubida. _Layout / _PortalLayout login bo'lmaganda shu yerga uzatadi. *@
@inject Microsoft.Extensions.Options.IOptions<tahsinERP.ControlPanel.Security.SecurityOptions> Security
@inject Microsoft.Extensions.Options.IOptions<tahsinERP.ControlPanel.Hosting.PanelHostOptions> Hosts
@{
    bool portal = (ViewData["AuthKind"] as string) == "portal";
    bool staffTotp = Security.Value.RequireStaffTotp;
    string domain = Hosts.Value.Domain.Trim().Trim('.');
    string? siteUrl = domain.Contains('.') ? "https://" + domain : null; // lokal (localhost) — havola yo'q
}
<!DOCTYPE html>
<html lang="@L.HtmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] · tahsinERP @(portal ? L.T("Ptl_Crumb") : "Admin")</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <meta name="theme-color" content="#060c1d" />
    <link rel="stylesheet" href="~/fonts/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth">
<partial name="_Icons" />
<div class="auth-bg" aria-hidden="true"><span class="orb o1"></span><span class="orb o2"></span><span class="orb o3"></span><span class="auth-grid"></span></div>
<header class="auth-top">
    <a class="auth-brand" href="@(siteUrl ?? "/")">
        <img src="/img/logo.png" alt="" width="36" height="36" />
        <span>tahsin<b>ERP</b></span>
    </a>
    <span class="auth-zone">@(portal ? L.T("Ptl_Brand") : L.T("Pnl_Brand"))</span>
    @if (siteUrl is not null)
    {
        <a class="auth-home" href="@siteUrl"><svg class="i i-back"><use href="#i-arrow" /></svg>@domain</a>
    }
    <partial name="_LangSwitch" />
</header>
<div class="auth-wrap">
    <section class="auth-intro">
        <div class="auth-logo" aria-hidden="true"><span class="ring r1"></span><span class="ring r2"></span><img src="/img/logo.png" alt="" width="132" height="132" /></div>
        <span class="auth-eyebrow">@(portal ? L.T("Ptl_Auth2_Eyebrow") : L.T("Pnl_Auth2_Eyebrow"))</span>
        <h2>@(portal ? L.T("Ptl_Auth2_Headline") : L.T("Pnl_Auth2_Headline")) <span class="grad">@L.T("Pnl_Auth2_InOnePlace")</span></h2>
        <p>@(portal ? L.T("Ptl_Auth2_Intro") : L.T("Pnl_Auth2_Intro"))</p>
        <ul class="auth-feats">
            @if (portal)
            {
                <li><svg class="i"><use href="#i-check" /></svg>@L.T("Auth_FeatOtp")</li>
                <li><svg class="i"><use href="#i-check" /></svg>@L.T("Auth_FeatHttps")</li>
                <li><svg class="i"><use href="#i-check" /></svg>@L.T("Auth_FeatLockout")</li>
            }
            else
            {
                @if (staffTotp) { <li><svg class="i"><use href="#i-check" /></svg>@L.T("Auth_FeatTotp")</li> }
                else { <li><svg class="i"><use href="#i-check" /></svg>@L.T("Auth_FeatLockout")</li> }
                <li><svg class="i"><use href="#i-check" /></svg>@L.T("Auth_FeatAudit")</li>
                <li><svg class="i"><use href="#i-check" /></svg>@L.T("Auth_FeatHttps")</li>
            }
        </ul>
    </section>
    <main>
        @RenderBody()
    </main>
</div>
<footer class="auth-foot">
    <span>© @DateTime.UtcNow.Year tahsinERP · <a href="https://schain.uz" target="_blank" rel="noopener">"Taminot tizimi" MChJ</a></span>
    <span><svg class="i"><use href="#i-lock" /></svg>@L.T("Pnl_Auth2_Footer")</span>
</footer>
<script src="~/js/app.js" asp-append-version="true"></script>
@if (portal) { <script src="~/js/portal.js" asp-append-version="true"></script> }
</body>
</html>
