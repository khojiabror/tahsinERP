@* Kirish ekranlari (xodim va mijoz) uchun "xavfsiz kirish terminali" qobig'i. _Layout / _PortalLayout login bo'lmaganda shu yerga uzatadi. *@
@inject Microsoft.Extensions.Options.IOptions<tahsinERP.ControlPanel.Security.SecurityOptions> Security
@{
    bool portal = (ViewData["AuthKind"] as string) == "portal";
    bool staffTotp = Security.Value.RequireStaffTotp;
    string zone = portal ? L.T("Auth_ZonePortal") : L.T("Auth_ZonePanel");
}
<!DOCTYPE html>
<html lang="@L.HtmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] — @(portal ? L.T("Auth_TitlePortal") : L.T("Auth_TitlePanel"))</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth">
<partial name="_Icons" />
<div class="auth-bg" aria-hidden="true">
    <div class="auth-grid"></div>
    <div class="auth-glow"></div>
    <div class="auth-scan"></div>
</div>
<header class="auth-top">
    <a class="auth-brand" href="/">
        <span class="logo-mark"><svg class="i"><use href="#i-shield" /></svg></span>
        <span>tahsin<b>ERP</b></span>
    </a>
    <span class="auth-zone">@zone · @L.T("Auth_SecureLogin")</span>
    <span class="auth-status"><i></i> @L.T("Auth_Online")</span>
    <partial name="_LangSwitch" />
    <span class="auth-clock" data-clock>--:--:-- UTC</span>
</header>
<div class="auth-wrap">
    <section class="auth-intro" aria-hidden="true">
        <div class="radar">
            <div class="radar-sweep"></div>
            <svg viewBox="0 0 200 200" class="radar-rings">
                <circle cx="100" cy="100" r="96" class="r1" />
                <circle cx="100" cy="100" r="72" class="r2" />
                <circle cx="100" cy="100" r="48" class="r3" />
                <path d="M100 4v192M4 100h192" class="cross" />
            </svg>
            <div class="radar-core"><svg class="i"><use href="#i-@(portal ? "lock" : "shield")" /></svg></div>
            <span class="blip b1"></span><span class="blip b2"></span><span class="blip b3"></span>
        </div>
        <h2>@L.T("Auth_ProtectedArea")</h2>
        <p>@(portal ? L.T("Auth_OnlyClients") : L.T("Auth_OnlyStaff"))@(portal || staffTotp ? " " + L.T("Auth_TwoStep") : "")</p>
        <ul class="auth-feats">
            @if (portal)
            {
                <li><svg class="i"><use href="#i-send" /></svg>@L.T("Auth_FeatOtp")</li>
                <li><svg class="i"><use href="#i-lock" /></svg>@L.T("Auth_FeatHttps")</li>
                <li><svg class="i"><use href="#i-scan" /></svg>@L.T("Auth_FeatLockout")</li>
            }
            else
            {
                @if (staffTotp) { <li><svg class="i"><use href="#i-scan" /></svg>@L.T("Auth_FeatTotp")</li> }
                else { <li><svg class="i"><use href="#i-scan" /></svg>@L.T("Auth_FeatLockout")</li> }
                <li><svg class="i"><use href="#i-activity" /></svg>@L.T("Auth_FeatAudit")</li>
                <li><svg class="i"><use href="#i-lock" /></svg>@L.T("Auth_FeatHttps")</li>
            }
        </ul>
    </section>
    <main>
        @RenderBody()
    </main>
</div>
<footer class="auth-foot">
    <span>@L.T("Auth_Footer")</span>
    <span>© @DateTime.UtcNow.Year tahsinERP</span>
</footer>
<script src="~/js/app.js" asp-append-version="true"></script>
@if (portal) { <script src="~/js/portal.js" asp-append-version="true"></script> }
</body>
</html>
