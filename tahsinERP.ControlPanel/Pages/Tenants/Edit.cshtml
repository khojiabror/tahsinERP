@page "{id:int}"
@model tahsinERP.ControlPanel.Pages.Tenants.EditModel
@{ ViewData["Title"] = L.T("Pnl_EditNamed", Model.Tenant.LegalName); }
<h1>@L.T("Pnl_EditNamed", Model.Tenant.LegalName)</h1>
<form method="post" class="stack card">
    <div asp-validation-summary="All"></div>
    <partial name="_TenantForm" model="(Model.Input, Model.Servers, false)" />
    <div class="actions"><button type="submit">@L.T("Save")</button><a class="btn secondary" href="/Tenants/Details/@Model.Tenant.Id">@L.T("Pnl_CancelShort")</a></div>
</form>
