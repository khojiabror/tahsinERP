@page "{id:int}"
@model tahsinERP.ControlPanel.Pages.Tenants.DetailsModel
@{ var t = Model.Tenant; ViewData["Title"] = t.LegalName; }
<h1>@t.LegalName <span class="badge @Labels.Badge(t.Status)">@Labels.Of(t.Status)</span></h1>
<div asp-validation-summary="ModelOnly"></div>
@if (Model.NewRegToken is not null)
{
    <div class="secret">
        <strong>@L.T("Pnl_Ten_NewRegToken")</strong>
        <div class="mono">@Model.NewRegToken</div>
        <div class="hint">@L.T("Pnl_Ten_RegTokenHint")</div>
    </div>
}
@if (Model.NewTempPassword is not null)
{
    <div class="secret">
        <strong>@L.T("Pnl_Ten_AdminTempPassword")</strong>
        <div class="mono">@L.T("Username"): admin &nbsp; @L.T("Password"): @Model.NewTempPassword</div>
        <div class="hint">@L.T("Pnl_Ten_TempPasswordHint")</div>
    </div>
}
<div class="actions">
    @if (Model.CanSell) { <a class="btn secondary" href="/Tenants/Edit/@t.Id">@L.T("Edit")</a> }
    <form method="post" asp-page-handler="RegToken" class="inline"><button type="submit" class="secondary">@L.T("Pnl_Ten_IssueRegToken")</button></form>
    @if (Model.CanSell) { <form method="post" asp-page-handler="EnsureLicense" class="inline"><button type="submit" class="secondary">@L.T("Pnl_Ten_EnsureLicense")</button></form> }
</div>
<div class="cols">
    <div class="card">
        <dl class="props">
            <dt>Slug</dt><dd><code>@t.Slug</code></dd>
            <dt>@L.T("Pnl_Deployment")</dt><dd>@Labels.Of(t.Deployment)</dd>
            <dt>@L.T("Pnl_Inn")</dt><dd>@t.Inn</dd>
            <dt>@L.T("Pnl_Contact")</dt><dd>@t.ContactName @t.Phone @t.Email</dd>
            <dt>Telegram</dt><dd>@t.TelegramChatId</dd>
            <dt>@L.T("Pnl_Ten_DbServer")</dt><dd>@t.DbName @t.Server?.Name</dd>
            @if (t.Modules is { } mods)
            {
                <dt>@L.T("Pnl_Ten_SetupModules")</dt><dd>@string.Join(", ", mods.Split(',').Select(m => L.T("Pnl_Module_" + m)))@(t.SampleData ? " · " + L.T("Pnl_Ten_WithSample") : "")</dd>
            }
            <dt>CompanyID</dt><dd>@t.CompanyId</dd>
            <dt>InstallationId</dt><dd><code>@(t.InstallationId ?? L.T("Pnl_NotBound"))</code></dd>
            <dt>@L.T("Pnl_LastSeen")</dt><dd>@t.LastSeenUtc @t.LastVersion @t.LastHost</dd>
        </dl>
    </div>
    <div class="card">
        @if (Model.CanSell)
        {
            <form method="post" asp-page-handler="Status" class="stack">
                <div><label asp-for="NewStatus">@L.T("Pnl_Ten_ChangeStatus")</label>
                    <select asp-for="NewStatus">@foreach (var s in Enum.GetValues<TenantStatus>()) { <option value="@s">@Labels.Of(s)</option> }</select></div>
                <div><label asp-for="Reason">@L.T("Pnl_Reason")</label><input asp-for="Reason" type="text" /></div>
                <div><button type="submit">@L.T("Save")</button></div>
            </form>
        }
    </div>
</div>
@if (t.Deployment == DeploymentKind.SaaS)
{
    <h2>@L.T("Pnl_Ten_ProvTitle")</h2>
    <div class="card">
        <dl class="props">
            <dt>@L.T("Pnl_Url")</dt><dd>@(Model.TenantUrl ?? L.T("Pnl_Ten_UrlNotConfigured", t.Slug))</dd>
            <dt>@L.T("Pnl_Ten_DbCreated")</dt><dd>@(t.ProvisionedAtUtc?.ToString("dd.MM.yyyy HH:mm") ?? L.T("Pnl_NoLower"))</dd>
            <dt>tenants.json</dt><dd>@(t.RegistryEnabled switch { true => "enabled: true", false => "enabled: false", _ => L.T("Pnl_Ten_NoEntry") })</dd>
            @if (t.ArchiveLocation != null) { <dt>@L.T("Pnl_TenantStatus_Archived")</dt><dd class="mono">@t.ArchiveLocation</dd> }
            @if (t.DeletedAtUtc != null) { <dt>@L.T("Pnl_Ten_Deleted")</dt><dd>@t.DeletedAtUtc?.ToString("dd.MM.yyyy HH:mm")</dd> }
        </dl>
        @if (Model.CanSell && t.DeletedAtUtc == null && Model.ActiveJob == null)
        {
            <form method="post" class="stack">
                <div><label asp-for="ProvisionReason">@L.T("Pnl_Ten_ReasonNote")</label><input asp-for="ProvisionReason" type="text" /></div>
                <div class="actions">
                    @if (t.ProvisionedAtUtc == null && t.Status != TenantStatus.Archived)
                    {
                        <button type="submit" asp-page-handler="Provision">@L.T("Pnl_Ten_Provision")</button>
                    }
                    @if (t.ProvisionedAtUtc != null && t.Status != TenantStatus.Archived)
                    {
                        @if (t.Status != TenantStatus.Suspended) { <button type="submit" class="secondary" asp-page-handler="Suspend">@L.T("Pnl_JobType_Suspend")</button> }
                        else { <button type="submit" class="secondary" asp-page-handler="Resume">@L.T("Pnl_JobType_Resume")</button> }
                        @if (Model.IsDemo) { <button type="submit" class="secondary" asp-page-handler="Reset">@L.T("Pnl_Ten_ResetFromTemplate")</button> }
                        @if (Model.IsOwner) { <button type="submit" class="danger" asp-page-handler="Archive">@L.T("Pnl_Ten_ArchiveBtn")</button> }
                    }
                    @if (Model.IsOwner && t.Status == TenantStatus.Archived)
                    {
                        <a class="btn danger" href="/Tenants/Delete/@t.Id">@L.T("Pnl_Ten_DeleteForever")…</a>
                    }
                </div>
                @if (Model.IsOwner && t.Status == TenantStatus.Archived && t.ArchiveLocation != null)
                {
                    <div><label asp-for="RestoreSlug">@L.T("Pnl_Ten_RestoreSlug")</label><input asp-for="RestoreSlug" type="text" placeholder="@t.Slug" /></div>
                    <div class="hint">@L.T("Pnl_Ten_RestoreHint", t.Slug)</div>
                    <div class="actions"><button type="submit" class="secondary" asp-page-handler="Restore">@L.T("Pnl_Ten_RestoreBtn")</button></div>
                }
            </form>
        }
        else if (Model.ActiveJob != null)
        {
            <div class="hint">@L.T("Pnl_Ten_InProgress") <a href="/Provisioning/Job/@Model.ActiveJob.Id">@Labels.Of(Model.ActiveJob.Type) #@Model.ActiveJob.Id</a> — @L.T("Pnl_Ten_AutoRefresh")</div>
        }
    </div>
    <table>
        <tr><th>#</th><th>@L.T("Pnl_Audit_Action")</th><th>@L.T("Status")</th><th class="num">@L.T("Pnl_Prov_Attempt")</th><th>@L.T("Pnl_CreatedUtc")</th><th>@L.T("Pnl_Prov_Finished")</th><th>@L.T("Pnl_Err_Title")</th></tr>
        @foreach (var j in Model.Jobs)
        {
            <tr><td><a href="/Provisioning/Job/@j.Id">@j.Id</a></td><td>@Labels.Of(j.Type)</td><td><span class="badge @Labels.Badge(j.Status)">@Labels.Of(j.Status)</span></td>
                <td class="num">@j.Attempts/@j.MaxAttempts</td><td>@j.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</td><td>@j.FinishedAtUtc?.ToString("dd.MM.yyyy HH:mm")</td><td class="mono">@j.Error</td></tr>
        }
    </table>
}
@if (Model.AppsLoaded)
{
    <h2>@L.T("Pnl_Ten_BotAndSite")</h2>
    <div class="cols">
        <div class="card">
            <h3>Telegram bot</h3>
            @if (Model.BotError != null) { <p class="hint">@Model.BotError</p> }
            else if (Model.Bot is { } b)
            {
                <dl class="props">
                    <dt>@L.T("Status")</dt><dd>@(!b.Exists ? L.T("Pnl_Prov_AgentNotConnected") : b.Active ? L.T("Pnl_ActiveLower") : L.T("Pnl_DisabledLower"))</dd>
                    @if (b.Exists)
                    {
                        <dt>Bot</dt><dd>@if (b.BotUsername != null) { <a href="https://t.me/@b.BotUsername" target="_blank" rel="noopener">@@@b.BotUsername</a> }</dd>
                        <dt>Webhook</dt><dd class="mono">@(b.WebhookUrl ?? "—")</dd>
                        @if (b.PendingUpdates > 0) { <dt>@L.T("Pnl_JobStatus_Pending")</dt><dd>@b.PendingUpdates</dd> }
                        @if (b.LastError != null) { <dt>@L.T("Pnl_LastError")</dt><dd class="mono">@b.LastError</dd> }
                    }
                </dl>
                @if (b.Active && b.BotUsername != null)
                {
                    <p class="hint">@L.T("Pnl_Ten_BotHint1") <code>@b.BotUsername</code>, @L.T("Pnl_Ten_BotHint2") <code>/setdomain</code> — @L.T("Pnl_Ten_BotHint3")</p>
                }
            }
            @if (Model.CanSell && Model.BotConfigured && Model.BotError == null)
            {
                <form method="post" class="stack" autocomplete="off">
                    <div><label for="BotToken">@L.T("Pnl_Ten_BotToken") @(Model.Bot?.Exists == true ? L.T("Pnl_Ten_BotTokenChange") : "")</label>
                        <input id="BotToken" name="BotToken" type="password" autocomplete="new-password" placeholder="123456789:AA..." /></div>
                    <p class="hint">@L.T("Pnl_Ten_BotTokenHint")
                        @(Model.Bot?.Exists == true ? L.T("Pnl_Ten_BotNoTokenHint") : "")</p>
                    <div class="actions">
                        <button type="submit" asp-page-handler="BotConnect">@(Model.Bot?.Exists == true ? L.T("Refresh") : L.T("Pnl_Ten_BotConnect"))</button>
                        @if (Model.Bot?.Active == true) { <button type="submit" class="secondary" asp-page-handler="BotDisable">@L.T("Pnl_Ten_BotDisable")</button> }
                    </div>
                </form>
            }
        </div>
        <div class="card">
            <h3>@L.T("Pnl_Ten_SiteCatalog")</h3>
            @if (Model.SiteError != null) { <p class="hint">@Model.SiteError</p> }
            else if (Model.Site is { } st)
            {
                <dl class="props">
                    <dt>@L.T("Status")</dt><dd>@(!st.Exists ? L.T("Pnl_Ten_NotEnabled") : st.Active ? L.T("Pnl_ActiveLower") : L.T("Pnl_DisabledLower"))</dd>
                    @if (st.Exists && Model.SitePublicUrl != null) { <dt>@L.T("Pnl_Url")</dt><dd><a href="@Model.SitePublicUrl" target="_blank" rel="noopener">@Model.SitePublicUrl</a></dd> }
                    @if (st.Exists)
                    {
                        <dt>@L.T("Pnl_Ten_CatalogSnapshot")</dt><dd>@(st.SnapshotAt?.ToString("dd.MM.yyyy HH:mm") ?? L.T("Pnl_Ten_NotTakenYet")) @(st.Products is int n ? "· " + L.T("Pnl_Ten_ProductsN", n) : "")</dd>
                    }
                </dl>
            }
            @if (Model.CanSell && Model.SiteConfigured && Model.SiteError == null)
            {
                <form method="post" class="actions">
                    @if (Model.Site?.Active != true) { <button type="submit" asp-page-handler="SiteEnable">@L.T("Pnl_Ten_SiteEnable")</button> }
                    else { <button type="submit" class="secondary" asp-page-handler="SiteDisable">@L.T("Pnl_Ten_SiteDisable")</button> }
                </form>
                <p class="hint">@L.T("Pnl_Ten_SiteHint")</p>
            }
            @if (Model.SiteError == null && (Model.SiteDomain != null || Model.Site is { Exists: true, Active: true }))
            {
                var sd = Model.SiteDomain;
                <h3>@L.T("Pnl_SDom_Title")</h3>
                @if (sd != null)
                {
                    <dl class="props">
                        <dt>@L.T("Pnl_SDom_Domain")</dt>
                        <dd>@if (sd.Status == SiteDomainStatus.Active) { <a href="https://@sd.Host" target="_blank" rel="noopener">https://@sd.Host</a> } else { <code>@sd.Host</code> }
                            <span class="badge @Labels.Badge(sd.Status)">@Labels.Of(sd.Status)</span></dd>
                        <dt>DNS</dt>
                        <dd>@(sd.DnsCheckedAtUtc is null ? L.T("Pnl_SDom_DnsNotChecked") : (sd.DnsOk ? L.T("Pnl_SDom_DnsOkShort") : L.T("Pnl_SDom_DnsBadShort")) + " · " + sd.DnsResult + " · " + sd.DnsCheckedAtUtc.Value.ToString("dd.MM.yyyy HH:mm") + " UTC")</dd>
                        @if (sd.Status == SiteDomainStatus.Active && sd.RedirectToDomain) { <dt>@L.T("Pnl_SDom_RedirectShort")</dt><dd>@Model.SiteDefaultHost → @sd.Host</dd> }
                        @if (sd.LastJobId != null) { <dt>@L.T("Pnl_SDom_Job")</dt><dd><a href="/Provisioning/Job/@sd.LastJobId">#@sd.LastJobId</a></dd> }
                        @if (sd.Error != null) { <dt>@L.T("Pnl_LastError")</dt><dd class="mono">@sd.Error</dd> }
                        @if (Model.Site is { Exists: true } && Model.Site.Domain != (sd.Status == SiteDomainStatus.Removing ? null : sd.Host))
                        {
                            <dt>@L.T("Pnl_Ten_SiteCatalog")</dt><dd class="hint">@L.T("Pnl_SDom_OutOfSync", Model.Site.Domain ?? "—")</dd>
                        }
                    </dl>
                }
                @if (Model.CanSell && Model.SiteConfigured && sd?.Status != SiteDomainStatus.Removing)
                {
                    <form method="post" class="stack" autocomplete="off">
                        <div><label asp-for="SiteDomainInput">@L.T("Pnl_SDom_Domain")</label>
                            <input asp-for="SiteDomainInput" type="text" placeholder="shop.firma.uz" spellcheck="false" /></div>
                        <label class="check"><input asp-for="SiteDomainRedirect" type="checkbox" /> @L.T("Pnl_SDom_Redirect", Model.SiteDefaultHost ?? "")</label>
                        <div class="actions">
                            <button type="submit" asp-page-handler="SiteDomainSave">@(sd == null ? L.T("Pnl_SDom_Connect") : L.T("Save"))</button>
                            @if (sd?.Status is SiteDomainStatus.PendingDns or SiteDomainStatus.Failed) { <button type="submit" class="secondary" asp-page-handler="SiteDomainCheck">@L.T("Pnl_SDom_Check")</button> }
                            @if (sd != null) { <button type="submit" class="danger" asp-page-handler="SiteDomainRemove">@L.T("Pnl_SDom_Remove")</button> }
                        </div>
                    </form>
                }
                else if (Model.CanSell && sd?.Status == SiteDomainStatus.Removing && sd.Error != null)
                {
                    <form method="post" class="actions"><button type="submit" class="danger" asp-page-handler="SiteDomainRemove">@L.T("Pnl_SDom_RemoveRetry")</button></form>
                }
                <p class="hint">@L.T("Pnl_SDom_DnsHelpA", Model.SiteExpectedIps.Count > 0 ? string.Join(", ", Model.SiteExpectedIps) : L.T("Pnl_SDom_ServerIp"))
                    @if (Model.SiteDefaultHost != null) { @L.T("Pnl_SDom_DnsHelpCname", Model.SiteDefaultHost) }
                    @L.T("Pnl_SDom_DnsHelpTail")</p>
            }
        </div>
    </div>
}
<partial name="_TrialActivity" model="Model" />
<h2>@L.T("Pnl_Ten_Portal") (my.&lt;domen&gt;)</h2>
@if (Model.NewInviteUrl is not null)
{
    <div class="secret">
        <strong>@L.T("Pnl_Ten_InviteFor", Model.InviteFor)</strong>
        <div class="mono">@Model.NewInviteUrl</div>
        <div class="hint">@L.T("Pnl_Ten_InviteHint")
            @(Model.InviteSentToTelegram ? L.T("Pnl_Ten_InviteSentTg") : "")</div>
    </div>
}
<div class="card">
    @if (Model.PortalUsers.Count > 0)
    {
        <table>
            <tr><th>@L.T("Pnl_FirstName")</th><th>@L.T("Username")</th><th>@L.T("Pnl_Role")</th><th>@L.T("Status")</th><th>Telegram</th><th>@L.T("Pnl_LastLoginUtc")</th><th></th></tr>
            @foreach (var u in Model.PortalUsers)
            {
                <tr>
                    <td>@u.FullName</td><td>@u.Email @u.Phone</td><td>@u.Role</td>
                    <td>@(!u.IsActive ? L.T("Pnl_DisabledLower") : u.PasswordHash is null ? L.T("Pnl_Ten_InvitePending") : u.LockedUntilUtc > DateTime.UtcNow ? L.T("Pnl_Locked") : L.T("Pnl_ActiveLower"))</td>
                    <td>@(u.TelegramChatId is null ? "—" : L.T("Pnl_Bound"))</td>
                    <td>@u.LastLoginUtc?.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (Model.CanSell)
                        {
                            <form method="post" class="inline"><input type="hidden" name="PortalUserId" value="@u.Id" />
                                <button type="submit" class="link" asp-page-handler="PortalInvite">@(u.PasswordHash is null ? L.T("Pnl_Ten_InviteLink") : L.T("Pnl_Ten_ResetPassword"))</button> ·
                                <button type="submit" class="link" asp-page-handler="PortalToggle" asp-route-what="role">@L.T("Pnl_Ten_RoleArrow") → @(u.Role == PortalRole.Owner ? "Viewer" : "Owner")</button> ·
                                <button type="submit" class="link" asp-page-handler="PortalToggle" asp-route-what="active">@(u.IsActive ? L.T("Pnl_Ten_DisableLower") : L.T("Pnl_Ten_EnableLower"))</button>
                                @if (u.TelegramChatId is not null) { <text> · </text><button type="submit" class="link" asp-page-handler="PortalToggle" asp-route-what="telegram">@L.T("Pnl_Ten_UnlinkTelegram")</button> }
                            </form>
                        }
                    </td>
                </tr>
            }
        </table>
    }
    else
    {
        <p class="empty">@L.T("Pnl_Ten_NoPortalUsers")</p>
    }
    @if (Model.CanSell && t.Status != TenantStatus.Archived)
    {
        <form method="post" asp-page-handler="PortalUser" class="stack spaced">
            <div class="row">
                <div><label asp-for="PuName">@L.T("Pnl_FirstName")</label><input asp-for="PuName" type="text" /></div>
                <div><label asp-for="PuRole">@L.T("Pnl_Role")</label><select asp-for="PuRole"><option value="Owner">@L.T("Pnl_Ten_PuOwner")</option><option value="Viewer">@L.T("Pnl_Ten_PuViewer")</option></select></div>
            </div>
            <div class="row">
                <div><label asp-for="PuEmail">Email</label><input asp-for="PuEmail" type="email" /></div>
                <div><label asp-for="PuPhone">@L.T("Phone")</label><input asp-for="PuPhone" type="text" placeholder="+998901234567" /></div>
            </div>
            <p class="hint">@L.T("Pnl_Ten_PuLoginHint")</p>
            <div><button type="submit">@L.T("Pnl_Ten_PuAdd")</button></div>
        </form>
    }
</div>
<h2>@L.T("Pnl_Subscriptions")</h2>
@if (Model.CanSell) { <div class="actions"><a class="btn" href="/Subscriptions/Create?tenantId=@t.Id">+ @L.T("Pnl_Ten_PaidSub")</a><a class="btn secondary" href="/Invoices/Create?tenantId=@t.Id">+ @L.T("Pnl_Invoice")</a></div> }
<table>
    <tr><th>#</th><th>@L.T("Pnl_Package")</th><th>@L.T("Period")</th><th class="num">@L.T("Pnl_UsersShort")</th><th>@L.T("Pnl_Start")</th><th>@L.T("Pnl_End")</th><th>@L.T("Status")</th></tr>
    @foreach (var s in Model.Subscriptions)
    {
        <tr><td>@if (Model.CanSell) { <a href="/Subscriptions/Edit/@s.Id">@s.Id</a> } else { @s.Id }</td><td>@s.Plan?.Name @if (s.Plan?.IsAddOn == true) { <span class="badge info">@L.T("Pnl_AddOnBadge")</span> } @if (Model.CanSell && s.Status is SubscriptionStatus.Pending or SubscriptionStatus.Active && s.Period != BillingPeriod.Trial) { <a class="hint" href="/Invoices/Create?tenantId=@t.Id&subscriptionId=@s.Id">@L.T("Pnl_InvoiceLower")</a> }</td><td>@Labels.Of(s.Period)</td><td class="num">@s.Users</td><td>@s.StartDate.ToString("dd.MM.yyyy")</td><td>@s.EndDate.ToString("dd.MM.yyyy")</td><td>@Labels.Of(s.Status)</td></tr>
    }
</table>
<h2>@L.T("Pnl_NavInvoices")</h2>
<table>
    <tr><th>@L.T("Number")</th><th>@L.T("Date")</th><th class="num">@L.T("Total")</th><th class="num">@L.T("Pnl_InvStatus_Paid")</th><th>@L.T("Status")</th></tr>
    @foreach (var i in Model.Invoices)
    {
        <tr><td><a href="/Invoices/Details/@i.Id">@(i.Number ?? L.T("Pnl_DraftLower"))</a></td><td>@i.IssueDate.ToString("dd.MM.yyyy")</td><td class="num">@Money.Format(i.TotalTiyin)</td><td class="num">@Money.Format(i.PaidTiyin)</td><td><span class="badge @Labels.Badge(i.Status)">@Labels.Of(i.Status)</span></td></tr>
    }
</table>
<h2>@L.T("Pnl_Ten_LicHistory")</h2>
@if (Model.IsOwner) { <div class="actions"><a class="btn secondary" href="/Licenses/Issue?tenantId=@t.Id">@L.T("Pnl_Lic_ManualIssue")</a></div> }
<table>
    <tr><th>#</th><th>Edition</th><th class="num">@L.T("Pnl_UsersShort")</th><th>@L.T("Pnl_Due")</th><th>@L.T("Pnl_Key")</th><th>@L.T("Pnl_Source")</th><th>@L.T("Status")</th></tr>
    @foreach (var l in Model.Licenses)
    {
        <tr><td><a href="/Licenses/Details/@l.Id">@l.Id</a></td><td>@l.Edition</td><td class="num">@l.MaxUsers</td><td>@l.StartDate.ToString("dd.MM.yyyy") – @l.ExpiryDate.ToString("dd.MM.yyyy")</td><td>@l.KeyId</td><td>@Labels.Of(l.Source)</td>
            <td>@(l.RevokedAtUtc != null ? L.T("Pnl_Lic_RevokedBadge") : l.SupersededById != null ? L.T("Pnl_Lic_Superseded") : L.T("Pnl_Lic_Current"))</td></tr>
    }
</table>
<h2>@L.T("Pnl_Ten_AuditLast30")</h2>
<table>
    <tr><th>@L.T("Pnl_TimeUtc")</th><th>@L.T("Pnl_Employee")</th><th>@L.T("Pnl_Audit_Action")</th><th>@L.T("Pnl_Audit_After")</th></tr>
    @foreach (var a in Model.Audit)
    {
        <tr><td>@a.AtUtc.ToString("dd.MM.yyyy HH:mm")</td><td>@(a.StaffUserId is int sid && Model.StaffNames.TryGetValue(sid, out var n) ? n : L.T("Pnl_Audit_System"))</td><td>@a.Action</td><td class="mono">@a.After</td></tr>
    }
</table>
