@model (TenantInput Input, List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> Servers, bool IsNew)
@using tahsinERP.ControlPanel.Pages.Tenants
@{ var i = Model.Input; }
<div class="row">
    <div>
        <label for="Input_Slug">@L.T("Pnl_Ten_SlugLabel")</label>
        @if (Model.IsNew)
        {
            <input id="Input_Slug" name="Input.Slug" value="@i.Slug" type="text" placeholder="firma1" />
            <div class="hint">a-z, 0-9, '-'. @L.T("Pnl_Ten_SaasUrl") &lt;slug&gt;.&lt;domen&gt;. @L.T("Pnl_Ten_SlugHint")</div>
        }
        else
        {
            <input id="Input_Slug" value="@i.Slug" type="text" disabled />
        }
    </div>
    <div>
        <label for="Input_Deployment">@L.T("Pnl_Deployment")</label>
        <select id="Input_Deployment" name="Input.Deployment">
            <option value="SaaS" selected="@(i.Deployment == DeploymentKind.SaaS)">@L.T("Pnl_Ten_SaasOurServer")</option>
            <option value="OnPrem" selected="@(i.Deployment == DeploymentKind.OnPrem)">@L.T("Pnl_Deployment_OnPrem")</option>
        </select>
    </div>
</div>
<div><label for="Input_LegalName">@L.T("Pnl_LegalName")</label><input id="Input_LegalName" name="Input.LegalName" value="@i.LegalName" type="text" /></div>
<div class="row">
    <div><label for="Input_Inn">@L.T("Pnl_InnPinfl")</label><input id="Input_Inn" name="Input.Inn" value="@i.Inn" type="text" maxlength="14" /></div>
    <div><label for="Input_CompanyId">CompanyID (ERP)</label><input id="Input_CompanyId" name="Input.CompanyId" value="@i.CompanyId" type="number" /><div class="hint">@L.T("Pnl_Ten_CompanyIdHint")</div></div>
</div>
<div class="row">
    <div><label for="Input_ContactName">@L.T("Pnl_ContactPerson")</label><input id="Input_ContactName" name="Input.ContactName" value="@i.ContactName" type="text" /></div>
    <div><label for="Input_Phone">@L.T("Phone")</label><input id="Input_Phone" name="Input.Phone" value="@i.Phone" type="text" placeholder="+998 90 123 45 67" /></div>
</div>
<div class="row">
    <div><label for="Input_Email">Email</label><input id="Input_Email" name="Input.Email" value="@i.Email" type="email" /></div>
    <div><label for="Input_TelegramChatId">Telegram chat ID</label><input id="Input_TelegramChatId" name="Input.TelegramChatId" value="@i.TelegramChatId" type="text" /><div class="hint">@L.T("Pnl_Ten_ChatHint")</div></div>
</div>
<div><label for="Input_Address">@L.T("Address")</label><input id="Input_Address" name="Input.Address" value="@i.Address" type="text" /></div>
<div class="row">
    <div><label for="Input_DbName">@L.T("Pnl_Ten_DbName")</label><input id="Input_DbName" name="Input.DbName" value="@i.DbName" type="text" placeholder="@L.T("Pnl_Ten_DbNamePlaceholder")" /></div>
    <div>
        <label for="Input_ServerId">@L.T("Pnl_Server")</label>
        <select id="Input_ServerId" name="Input.ServerId">
            @foreach (var s in Model.Servers)
            {
                <option value="@s.Value" selected="@(s.Value == i.ServerId?.ToString())">@s.Text</option>
            }
        </select>
    </div>
</div>
<div class="row">
    <div>
        <label for="Input_OnlineCheck">@L.T("Pnl_Ten_OnlineCheck")</label>
        <select id="Input_OnlineCheck" name="Input.OnlineCheck">
            <option value="Optional" selected="@(i.OnlineCheck == OnlineCheckMode.Optional)">@L.T("Pnl_Ten_OnlineOptional")</option>
            <option value="Required" selected="@(i.OnlineCheck == OnlineCheckMode.Required)">@L.T("Pnl_Ten_OnlineRequired")</option>
        </select>
        <div class="hint">@L.T("Pnl_Ten_OnlineHint1") <code>LicensePanelUrl</code> @L.T("Pnl_Ten_OnlineHint2")</div>
    </div>
    <div>
        <label for="Input_OfflineGraceDays">@L.T("Pnl_Ten_OfflineDays")</label>
        <input id="Input_OfflineGraceDays" name="Input.OfflineGraceDays" value="@i.OfflineGraceDays" type="number" min="7" max="90" placeholder="@L.T("Pnl_Ten_Default30")" />
        <div class="hint">@L.T("Pnl_Ten_OfflineHint")</div>
    </div>
</div>
<div><label for="Input_Notes">@L.T("Comment")</label><textarea id="Input_Notes" name="Input.Notes">@i.Notes</textarea></div>
