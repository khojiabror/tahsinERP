@page
@model tahsinERP.ControlPanel.Pages.Tenants.CreateModel
@{ ViewData["Title"] = L.T("Pnl_Ten_New"); }
<h1>@L.T("Pnl_Ten_New")</h1>
<form method="post" class="stack card">
    <div asp-validation-summary="All"></div>
    <partial name="_TenantForm" model="(Model.Input, Model.Servers, true)" />
    <label class="check"><input asp-for="StartTrial" /> @L.T("Pnl_Ten_StartTrial")</label>
    <div class="hint">@L.T("Pnl_Ten_CreateHint")</div>
    <div class="actions"><button type="submit">@L.T("Create")</button><a class="btn secondary" href="/Tenants">@L.T("Pnl_CancelShort")</a></div>
</form>
