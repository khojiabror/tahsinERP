@page
@model tahsinERP.ControlPanel.Pages.Tenants.CreateModel
@{ ViewData["Title"] = "Yangi tashkilot"; }
<h1>Yangi tashkilot</h1>
<form method="post" class="stack card">
    <div asp-validation-summary="All"></div>
    <partial name="_TenantForm" model="(Model.Input, Model.Servers, true)" />
    <label class="check"><input asp-for="StartTrial" /> 14 kunlik sinov (TRIAL: Korporativ modullari, 5 foydalanuvchi) boshlansin</label>
    <div class="hint">Belgilanmasa tashkilot «To'xtatilgan» holatida yaratiladi va birinchi to'lovdan keyin faollashadi. Baza yaratish — tashkilot sahifasidagi «Bazani yaratish» tugmasi (yoki tezkor yo'l: «Sinov ochish»).</div>
    <div class="actions"><button type="submit">Yaratish</button><a class="btn secondary" href="/Tenants">Bekor</a></div>
</form>
