@page
@model tahsinERP.ControlPanel.Pages.Tenants.IndexModel
@{ ViewData["Title"] = L.T("Pnl_NavTenants"); }
<h1>@L.T("Pnl_NavTenants")</h1>
<form method="get" class="toolbar">
    <div><label for="Q">@L.T("Pnl_SearchLabel")</label><input id="Q" name="Q" value="@Model.Q" type="text" placeholder="@L.T("Pnl_Ten_SearchPlaceholder")" /></div>
    <div>
        <label for="Status">@L.T("Status")</label>
        <select id="Status" name="Status">
            <option value="">@L.T("Pnl_Ten_AllExceptArchive")</option>
            @foreach (var s in Enum.GetValues<TenantStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@Labels.Of(s)</option>
            }
        </select>
    </div>
    <button type="submit" class="secondary">@L.T("Pnl_Show")</button>
    @if (Model.CanSell) { <a class="btn" href="/Tenants/Trial">+ @L.T("Pnl_Ten_OpenTrial")</a><a class="btn secondary" href="/Tenants/Create">+ @L.T("Pnl_Ten_New")</a> }
    @if (Model.IsOwner) { <a class="btn secondary" href="/Tenants/Demo">+ @L.T("Pnl_Demo_Title")</a> }
</form>
<table>
    <tr><th>@L.T("Pnl_Organization")</th><th>Slug</th><th>@L.T("Pnl_Deployment")</th><th>@L.T("Status")</th><th>@L.T("Pnl_Package")</th><th>@L.T("Pnl_Dash_Ends")</th><th class="num">@L.T("Pnl_Dash_DebtSom")</th><th>ERP</th></tr>
    @foreach (var r in Model.Rows)
    {
        var t = r.Tenant;
        <tr>
            <td><a href="/Tenants/Details/@t.Id">@t.LegalName</a> @if (t.IsDemo) { <span class="badge info">@L.T("Pnl_Demo_Badge")</span> } <span class="hint">@t.Inn</span></td>
            <td><code>@t.Slug</code></td>
            <td>@(t.Deployment == DeploymentKind.SaaS ? "SaaS" : "On-prem")</td>
            <td><span class="badge @Labels.Badge(t.Status)">@Labels.Of(t.Status)</span></td>
            <td>@r.Plan</td>
            <td>@r.EndDate?.ToString("dd.MM.yyyy")</td>
            <td class="num">@(r.DebtTiyin > 0 ? Money.Format(r.DebtTiyin) : "")</td>
            <td>@(t.InstallationId is null ? L.T("Pnl_NotBound") : L.T("Pnl_Bound"))</td>
        </tr>
    }
</table>
<partial name="_Pager" model="Model.Pager" />
@if (Model.Rows.Count == 0)
{
    <div class="empty">@L.T("Pnl_NotFoundDot")</div>
}
