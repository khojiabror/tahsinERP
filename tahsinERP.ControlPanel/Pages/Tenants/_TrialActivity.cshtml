@model tahsinERP.ControlPanel.Pages.Tenants.DetailsModel
@{ var t = Model.Tenant; }
@if (t.Deployment == DeploymentKind.SaaS && (t.ProvisionedAtUtc != null || Model.Usage != null))
{
    <h2>@L.T("Pnl_Activity")</h2>
    <div class="card">
        <dl class="props">
            <dt>@L.T("Pnl_LastLogin")</dt><dd>@(Model.Usage?.LastLoginUtc is DateTime ll ? ll.ToString("dd.MM.yyyy HH:mm") + " UTC" : L.T("Pnl_NoDataLower"))</dd>
            <dt>@L.T("Pnl_LastAction")</dt><dd>@(Model.Usage?.LastActionUtc?.ToString("dd.MM.yyyy HH:mm"))</dd>
            <dt>@L.T("Pnl_DaysCount", 7)</dt><dd>@L.T("Pnl_Act_LoginsActions", Model.Logins7d, Model.Actions7d)</dd>
            <dt>@L.T("Pnl_Collected")</dt><dd>@(Model.Usage?.SyncedAtUtc?.ToString("dd.MM.yyyy HH:mm") ?? L.T("Pnl_NotYet")) @if (Model.Usage?.Error != null) { <span class="badge bad">@Model.Usage.Error</span> }</dd>
        </dl>
        <a class="btn secondary" href="/Tenants/Activity/@t.Id">@L.T("Pnl_Act_AndLogs") →</a>
    </div>
}
@if (Model.IsTrialOnly && Model.CanSell && t.Status != TenantStatus.Archived && Model.ActiveJob == null)
{
    <h2>@L.T("Pnl_JobType_EndTrial")</h2>
    <form method="post" asp-page-handler="EndTrial" class="stack card">
        <div class="hint">@L.T("Pnl_Ten_EndTrialHint")</div>
        <div class="row">
            <div><label asp-for="EndTrialReason">@L.T("Pnl_Reason")</label><input asp-for="EndTrialReason" type="text" placeholder="@L.T("Pnl_Ten_EndTrialPlaceholder")" /></div>
            <div><label asp-for="EndTrialConfirmSlug">@L.T("Pnl_Ten_SlugToConfirm") <code>@t.Slug</code></label><input asp-for="EndTrialConfirmSlug" type="text" autocomplete="off" /></div>
        </div>
        <label class="check"><input asp-for="EndTrialBackup" /> @L.T("Pnl_Ten_BackupBeforeDelete")</label>
        <div class="actions"><button type="submit" class="danger">@L.T("Pnl_Ten_EndTrialBtn")</button></div>
    </form>
}
