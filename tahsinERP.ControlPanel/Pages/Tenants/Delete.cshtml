@page "{id:int}"
@model tahsinERP.ControlPanel.Pages.Tenants.DeleteModel
@{ var t = Model.Tenant; ViewData["Title"] = L.T("Pnl_Ten_DeleteTitle", t.Slug); }
<h1>@L.T("Pnl_Ten_DeleteForever"): @t.LegalName <code>@t.Slug</code></h1>
<form method="post" class="stack card">
    <div asp-validation-summary="All"></div>
    @* asp-for emas: tag helper POST'dagi eski qiymatni (ModelState, "1") chiqaradi va yakuniy tasdiq yana 1-qadamga qaytadi *@
    <input type="hidden" name="Step" value="@Model.Step" />
    @if (Model.Step < 2)
    {
        <p>@L.T("Pnl_Ten_DeleteWarn1") <strong>@L.T("Pnl_Ten_DeleteIrreversible")</strong>: @L.T("Pnl_Ten_DeleteWarn2") (<span class="mono">@t.ArchiveLocation</span>) @L.T("Pnl_Ten_DeleteWarn3")</p>
        <p class="hint">@L.T("Pnl_Ten_DeleteFreesSlug", t.Slug)</p>
        <div><label asp-for="ConfirmSlug">@L.T("Pnl_Ten_TypeSlug") <code>@t.Slug</code></label><input asp-for="ConfirmSlug" type="text" autocomplete="off" /></div>
        <div><label asp-for="Reason">@L.T("Pnl_Reason")</label><input asp-for="Reason" type="text" /></div>
        <label class="check"><input asp-for="Understand" /> @L.T("Pnl_Ten_Understand")</label>
        <div class="actions"><button type="submit" class="danger">@L.T("Pnl_Acc_Continue")</button><a class="btn secondary" href="/Tenants/Details/@t.Id">@L.T("Pnl_CancelShort")</a></div>
    }
    else
    {
        <input type="hidden" asp-for="ConfirmSlug" />
        <input type="hidden" asp-for="Reason" />
        <input type="hidden" asp-for="Understand" />
        <div class="secret"><strong>@L.T("Pnl_Ten_FinalConfirm")</strong> @L.T("Pnl_Ten_FinalConfirmText", t.LegalName, t.Slug) @L.T("Pnl_Reason"): @Model.Reason</div>
        <div class="actions"><button type="submit" class="danger">@L.T("Pnl_Ten_YesDelete")</button><a class="btn secondary" href="/Tenants/Details/@t.Id">@L.T("Pnl_Ten_NoBack")</a></div>
    }
</form>
