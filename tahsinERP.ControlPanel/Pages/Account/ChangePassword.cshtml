@page
@model tahsinERP.ControlPanel.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = L.T("Pnl_ChangePassword"); }
<h1>@L.T("Pnl_ChangePassword")</h1>
<form method="post" class="stack card">
    <div asp-validation-summary="ModelOnly"></div>
    <div><label asp-for="Current">@L.T("Pnl_Val_CurrentPassword")</label><input asp-for="Current" autocomplete="current-password" /><span asp-validation-for="Current"></span></div>
    <div><label asp-for="New">@L.T("Pnl_Val_NewPassword")</label><input asp-for="New" autocomplete="new-password" /><span asp-validation-for="New"></span><div class="hint">@L.T("Pnl_Acc_PasswordPolicyHint")</div></div>
    <div><label asp-for="Confirm">@L.T("Pnl_Acc_NewPasswordRepeat")</label><input asp-for="Confirm" autocomplete="new-password" /><span asp-validation-for="Confirm"></span></div>
    <div><button type="submit">@L.T("Save")</button></div>
</form>
