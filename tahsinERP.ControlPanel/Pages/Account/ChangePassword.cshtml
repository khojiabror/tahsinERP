@page
@model tahsinERP.ControlPanel.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "Parolni almashtirish"; }
<h1>Parolni almashtirish</h1>
<form method="post" class="stack card">
    <div asp-validation-summary="ModelOnly"></div>
    <div><label asp-for="Current">Joriy parol</label><input asp-for="Current" autocomplete="current-password" /><span asp-validation-for="Current"></span></div>
    <div><label asp-for="New">Yangi parol</label><input asp-for="New" autocomplete="new-password" /><span asp-validation-for="New"></span><div class="hint">Kamida 12 belgi, harf va raqam.</div></div>
    <div><label asp-for="Confirm">Yangi parol (takror)</label><input asp-for="Confirm" autocomplete="new-password" /><span asp-validation-for="Confirm"></span></div>
    <div><button type="submit">Saqlash</button></div>
</form>
