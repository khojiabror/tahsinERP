@page
@model tahsinERP.ControlPanel.Pages.Account.EnrollTotpModel
@{ ViewData["Title"] = "2FA ulash"; }
<div class="card login">
    <h1>Ikki bosqichli tasdiqlash (2FA)</h1>
    <p>Panelga kirish uchun 2FA majburiy. Telefoningizdagi autentifikator ilovasi (Google Authenticator, Microsoft Authenticator, Aegis…) bilan QR kodni skanerlang.</p>
    <p><img class="qr" src="@Model.QrDataUri" alt="QR kod" /></p>
    <p class="hint">Skanerlab bo'lmasa, kalitni qo'lda kiriting:</p>
    <p class="secret mono">@Model.SecretText</p>
    <form method="post" class="stack">
        <div asp-validation-summary="All"></div>
        <input type="hidden" asp-for="ProtectedSecret" />
        <input type="hidden" asp-for="ReturnUrl" />
        <div><label asp-for="Code">Ilovadagi 6 xonali kod</label><input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7" /></div>
        <button type="submit">Tasdiqlash va kirish</button>
    </form>
</div>
