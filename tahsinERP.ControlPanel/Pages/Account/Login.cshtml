@page
@model tahsinERP.ControlPanel.Pages.Account.LoginModel
@{ ViewData["Title"] = "Kirish"; }
<div class="card login">
    <h1>Panelga kirish</h1>
    <form method="post" class="stack">
        <div asp-validation-summary="All"></div>
        <div><label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="username" autofocus /></div>
        <div><label asp-for="Password">Parol</label><input asp-for="Password" autocomplete="current-password" /></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit">Davom etish</button>
        <p class="hint">Keyingi qadam — autentifikator ilovasidagi 6 xonali kod (2FA majburiy).</p>
    </form>
</div>
