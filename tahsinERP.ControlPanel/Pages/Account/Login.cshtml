@page
@model tahsinERP.ControlPanel.Pages.Account.LoginModel
@{ ViewData["Title"] = L.T("Login"); }
<div class="card login">
    <div class="hud-head"><span>@L.T("Pnl_Auth2_SecureLogin")</span><span>AUTH-01</span></div>
    <h1>@L.T("Pnl_Acc_LoginTitle")</h1>
    <p class="hud-sub">@L.T("Pnl_Acc_LoginIntro")</p>
    @if (Model.TotpRequired) { <ol class="steps"><li class="on">@L.T("Password")</li><li>@L.T("Pnl_Acc_2faCode")</li><li>@L.T("Login")</li></ol> }
    else { <ol class="steps"><li class="on">@L.T("Password")</li><li>@L.T("Login")</li></ol> }
    @if (Model.Expired)
    {
        <div class="flash info">@L.T("Pnl_Acc_SessionExpired", Model.IdleMinutes)</div>
    }
    <form method="post" class="stack">
        <div asp-validation-summary="All"></div>
        <div>
            <label asp-for="Email">Email</label>
            <div class="field-ic"><svg class="i"><use href="#i-mail" /></svg><input asp-for="Email" type="email" autocomplete="username" placeholder="siz@tahsinerp.uz" autofocus /></div>
        </div>
        <div>
            <label asp-for="Password">@L.T("Password")</label>
            <div class="field-ic"><svg class="i"><use href="#i-lock" /></svg><input asp-for="Password" autocomplete="current-password" placeholder="••••••••••••" /></div>
        </div>
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit">@L.T("Pnl_Acc_Continue") <svg class="i"><use href="#i-arrow" /></svg></button>
        @if (Model.TotpRequired)
        {
            <p class="hint">@L.T("Pnl_Acc_NextStepHint")</p>
        }
    </form>
    <div class="auth-meta"><span>@L.T("Pnl_Auth2_SessionEncrypted")</span><span>@L.T("Pnl_Auth2_AuditOn")</span></div>
</div>
