@page
@model tahsinERP.ControlPanel.Pages.Account.TotpModel
@{ ViewData["Title"] = L.T("Pnl_Acc_VerifyCode"); }
<div class="card login">
    <div class="hud-head"><span>@L.T("Pnl_Acc_SecondFactorHud")</span><span>AUTH-02</span></div>
    <h1>@L.T("Pnl_Acc_VerifyCode")</h1>
    <p class="hud-sub">@L.T("Pnl_Acc_TotpIntro")</p>
    <ol class="steps"><li class="done">@L.T("Password")</li><li class="on">@L.T("Pnl_Acc_2faCode")</li><li>@L.T("Login")</li></ol>
    <form method="post" class="stack">
        <div asp-validation-summary="All"></div>
        <div>
            <label asp-for="Code">@L.T("Pnl_Acc_OneTimeCode")</label>
            <input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7" placeholder="000000" autofocus />
        </div>
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit">@L.T("Login") <svg class="i"><use href="#i-arrow" /></svg></button>
        <p class="hint">@L.T("Pnl_Acc_LostPhoneHint")</p>
    </form>
    <div class="auth-meta"><span>@L.T("Pnl_Acc_Totp30s")</span><span><a href="/Account/Login">← @L.T("Pnl_Acc_OtherAccount")</a></span></div>
</div>
