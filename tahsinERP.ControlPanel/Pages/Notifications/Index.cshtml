@page
@model tahsinERP.ControlPanel.Pages.Notifications.IndexModel
@{ ViewData["Title"] = L.T("Pnl_NavNotifications"); }
<h1>@L.T("Pnl_NavNotifications")</h1>
<p class="hint">@L.T("Pnl_Notif_Hint")
    Telegram: @(Model.TelegramConfigured ? L.T("Pnl_Notif_Configured") : L.T("Pnl_Notif_NoToken")).</p>
@if (Model.IsOwner)
{
    <form method="post" asp-page-handler="Run" class="actions"><button type="submit" class="secondary">@L.T("Pnl_Notif_RunNow")</button></form>
}
<table>
    <tr><th>@L.T("Pnl_TimeUtc")</th><th>@L.T("Pnl_Organization")</th><th>@L.T("Pnl_Notif_Template")</th><th>@L.T("Pnl_Notif_Channel")</th><th>@L.T("Pnl_Notif_Recipient")</th><th>@L.T("Status")</th><th>@L.T("Pnl_Notif_Text")</th></tr>
    @foreach (var n in Model.Rows)
    {
        <tr>
            <td>@n.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
            <td>@(n.TenantId is int t ? Model.Tenants.GetValueOrDefault(t) : "")</td>
            <td>@n.Template</td><td>@n.Channel</td><td>@n.Recipient</td>
            <td><span class="badge @(n.Status == NotificationStatus.Failed ? "bad" : n.Status == NotificationStatus.Sent ? "ok" : "muted")">@Labels.Of(n.Status)</span> @n.Error</td>
            <td>@n.Message</td>
        </tr>
    }
</table>
@if (Model.Rows.Count == 0) { <div class="empty">@L.T("Pnl_Notif_Empty")</div> }
