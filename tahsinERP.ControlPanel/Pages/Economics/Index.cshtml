@page
@model tahsinERP.ControlPanel.Pages.Economics.IndexModel
@using tahsinERP.ControlPanel.Pages.Economics
@{
    ViewData["Title"] = L.T("Pnl_Econ_Title");
    var a = Model.Actual;
    var f = Model.Flex;
    var p = Model.Plan;
    var asm = Model.Calc.Assumptions;
    decimal rate = Model.Settings.UsdRate;
    int? be = p.BreakEvenFirms;
    long trendMax = (long)Math.Max(1, Model.Trend.Max(t => Math.Max(t.Mrr, t.Expenses)));
    var rows = new (string Label, decimal Plan, decimal Fact, bool HigherBetter, string Kind, string Css)[]
    {
        (L.T("Pnl_Econ_Firms"), f.Cost.Firms, a.Tenants, true, "n", ""),
        (L.T("Pnl_Users"), a.Users, a.Users, true, "n", ""),
        (L.T("Pnl_Econ_RevenueMrr"), f.Revenue, a.Mrr, true, "m", "key"),
        (L.T("Pnl_Econ_Deductions"), f.Deductions, a.Deductions, false, "m", ""),
        (L.T("Pnl_Econ_Cat_Infra"), f.Cost.Infra, a.Exp(CostCategory.Infra), false, "m", ""),
        (L.T("Pnl_Econ_Cat_Support"), f.Cost.Support, a.Exp(CostCategory.Support), false, "m", ""),
        (L.T("Pnl_Econ_CogsTotal"), f.Cost.Cogs, a.Cogs, false, "m", "total"),
        (L.T("Pnl_Econ_Cat_Development"), asm.OpexDevelopment, a.Exp(CostCategory.Development), false, "m", ""),
        (L.T("Pnl_Econ_Cat_Sales"), asm.OpexSales, a.Exp(CostCategory.Sales), false, "m", ""),
        (L.T("Pnl_Econ_Cat_Admin"), asm.OpexAdmin, a.Exp(CostCategory.Admin), false, "m", ""),
        (L.T("Pnl_Econ_OpexTotal"), asm.Opex, a.Opex, false, "m", "total"),
        (L.T("Pnl_Econ_TotalCost"), f.Cost.Total, a.Total, false, "m", "total"),
        (L.T("Pnl_Econ_Profit"), f.Profit, a.Profit, true, "m", "key"),
        (L.T("Pnl_Econ_GrossMargin"), f.GrossMargin, a.GrossMargin, true, "p", ""),
        (L.T("Pnl_Econ_CostPerFirm"), f.Cost.PerFirm, a.CostPerFirm, false, "m", ""),
        (L.T("Pnl_Econ_CostPerUser"), f.Cost.PerUser, a.CostPerUser, false, "m", ""),
    };
    string Fmt(decimal v, string kind) => kind switch { "n" => v.ToString("#,0"), "p" => Econ.Pct(v), _ => Econ.M(v) };
}
<h1>@L.T("Pnl_Econ_Title")</h1>
<partial name="_EconNav" />
<form method="get" class="toolbar">
    <label for="m">@L.T("Pnl_Month")</label>
    <input type="month" id="m" name="m" value="@Model.Month" />
    <button type="submit" class="secondary">@L.T("Pnl_Econ_Show")</button>
    <span class="hint">@L.T("Pnl_Econ_IndexHint")</span>
</form>

<div class="grid">
    <div class="stat"><span class="stat-ic"><svg class="i"><use href="#i-building" /></svg></span>
        <div class="l">@L.T("Pnl_Econ_PayingFirms")</div><div class="v">@a.Tenants</div>
        <div class="hint">@(be is null ? L.T("Pnl_Econ_BreakEvenNone") : L.T("Pnl_Econ_BreakEvenAt", be))</div></div>
    <div class="stat"><span class="stat-ic violet"><svg class="i"><use href="#i-trending" /></svg></span>
        <div class="l">@L.T("Pnl_Econ_RevenueMrr")</div><div class="v">@Econ.M(a.Mrr)</div>
        <div class="hint">@L.T("Pnl_Econ_PlanValue", Econ.M(f.Revenue)) · @Econ.Usd(a.Mrr, rate)</div></div>
    <div class="stat"><span class="stat-ic warn"><svg class="i"><use href="#i-wallet" /></svg></span>
        <div class="l">@L.T("Pnl_Econ_TotalCost")</div><div class="v">@Econ.M(a.Total)</div>
        <div class="hint">@L.T("Pnl_Econ_PlanValue", Econ.M(f.Cost.Total)) · @Econ.Usd(a.Total, rate)</div></div>
    <div class="stat"><span class="stat-ic @(a.Profit < 0 ? "bad" : "teal")"><svg class="i"><use href="#i-layers" /></svg></span>
        <div class="l">@L.T("Pnl_Econ_Profit")</div><div class="v @(a.Profit < 0 ? "var-bad" : "var-good")">@Econ.M(a.Profit)</div>
        <div class="hint">@L.T("Pnl_Econ_PlanValue", Econ.M(f.Profit))</div></div>
    <div class="stat"><span class="stat-ic"><svg class="i"><use href="#i-users" /></svg></span>
        <div class="l">@L.T("Pnl_Econ_CostPerFirm")</div><div class="v">@(a.Tenants > 0 ? Econ.M(a.CostPerFirm) : "—")</div>
        <div class="hint">@L.T("Pnl_Econ_PlanAtVolume", Econ.M(p.AtPlan.PerFirm), p.PlannedFirms)</div></div>
</div>

@if (a.Total == 0)
{
    <div class="flash info">@L.T("Pnl_Econ_NoExpenses") <a href="/Economics/Expenses?m=@Model.Month">@L.T("Pnl_Econ_AddExpenses")</a></div>
}

<div class="cols">
    <div class="card">
        <h2>@L.T("Pnl_Econ_PlanVsFact")</h2>
        <p class="hint">@L.T("Pnl_Econ_FlexHint", a.Tenants)</p>
        <table class="econ">
            <tr><th></th><th class="num">@L.T("Pnl_Econ_ColPlan")</th><th class="num">@L.T("Pnl_Econ_ColFact")</th><th class="num">@L.T("Pnl_Econ_ColDiff")</th></tr>
            @foreach (var r in rows)
            {
                decimal diff = r.Fact - r.Plan;
                <tr class="@r.Css"><td class="lbl">@r.Label</td><td class="num">@Fmt(r.Plan, r.Kind)</td><td class="num">@Fmt(r.Fact, r.Kind)</td>
                    <td class="num @Econ.VarClass(diff, r.HigherBetter)">@(diff == 0 ? "—" : (diff > 0 ? "+" : "") + Fmt(diff, r.Kind))</td></tr>
            }
            <tr class="sub"><td colspan="4">@L.T("Pnl_Econ_CashBasis")</td></tr>
            <tr><td class="lbl">@L.T("Pnl_Econ_CashIn")</td><td class="num">—</td><td class="num">@Econ.M(a.CashNet)</td><td></td></tr>
            <tr class="total"><td class="lbl">@L.T("Pnl_Econ_CashFlow")</td><td class="num">—</td><td class="num @(a.CashFlow < 0 ? "var-bad" : "var-good")">@Econ.M(a.CashFlow)</td><td></td></tr>
        </table>
    </div>
    <div>
        <div class="card">
            <h2>@L.T("Pnl_Econ_BreakEven")</h2>
            @if (be is null)
            {
                <p>@L.T("Pnl_Econ_BreakEvenNoneLong")</p>
            }
            else
            {
                <p><strong>@L.T("Pnl_Econ_BreakEvenAt", be)</strong> — @L.T("Pnl_Econ_BreakEvenMrr", Econ.M(be.Value * p.AvgNetPrice))</p>
                <progress class="be" max="@be" value="@Math.Min(a.Tenants, be.Value)"></progress>
                <p class="hint">@(a.Tenants >= be ? L.T("Pnl_Econ_BreakEvenReached") : L.T("Pnl_Econ_BreakEvenLeft", be.Value - a.Tenants))</p>
            }
            <p class="hint">@L.T("Pnl_Econ_BreakEvenBasis", Econ.M(p.AvgNetPrice), p.AvgUsers.ToString("0.#"))</p>
        </div>
        <div class="card">
            <h2>@L.T("Pnl_Econ_ByPackage")</h2>
            @if (a.Plans.Count == 0) { <div class="empty">@L.T("Pnl_Econ_NoPaying")</div> }
            else
            {
                <table class="econ">
                    <tr><th>@L.T("Pnl_Package")</th><th class="num">@L.T("Pnl_Econ_Firms")</th><th class="num">@L.T("Pnl_Users")</th><th class="num">MRR</th></tr>
                    @foreach (var r in a.Plans)
                    {
                        <tr><td><code>@r.Code</code> @r.Name</td><td class="num">@r.Tenants</td><td class="num">@r.Users</td><td class="num">@Econ.M(r.Mrr)</td></tr>
                    }
                </table>
            }
            <p class="hint">@L.T("Pnl_Econ_MrrHint")</p>
        </div>
    </div>
</div>

<div class="card">
    <h2>@L.T("Pnl_Econ_Trend")</h2>
    <svg viewBox="0 0 600 170" width="100%" height="190" role="img" aria-label="@L.T("Pnl_Econ_Trend")">
        <line x1="0" y1="135.5" x2="600" y2="135.5" class="grid-line" />
        @for (int i = 0; i < Model.Trend.Count; i++)
        {
            var t = Model.Trend[i];
            double w = 600.0 / Model.Trend.Count;
            double hr = (double)(t.Mrr * 115m / trendMax);
            double he = (double)(t.Expenses * 115m / trendMax);
            <g>
                <rect x="@(i * w + 12)" y="@(135 - hr)" width="@((w - 30) / 2)" height="@Math.Max(1, hr)" class="trend-rev" rx="4"></rect>
                <rect x="@(i * w + 12 + (w - 30) / 2 + 6)" y="@(135 - he)" width="@((w - 30) / 2)" height="@Math.Max(1, he)" class="trend-exp" rx="4"></rect>
                <text x="@(i * w + w / 2)" y="155" text-anchor="middle" font-size="11" class="bar-lbl">@Labels.Month(t.Month) @t.Year</text>
            </g>
        }
    </svg>
    <p class="hint"><span class="legend rev"></span> @L.T("Pnl_Econ_RevenueMrr") &nbsp; <span class="legend exp"></span> @L.T("Pnl_Econ_TotalCost")</p>
    <table class="econ">
        <tr><th>@L.T("Pnl_Month")</th><th class="num">@L.T("Pnl_Econ_Firms")</th><th class="num">@L.T("Pnl_Econ_RevenueMrr")</th><th class="num">@L.T("Pnl_Econ_CashIn")</th><th class="num">@L.T("Pnl_Econ_TotalCost")</th><th class="num">@L.T("Pnl_Econ_Profit")</th></tr>
        @foreach (var t in Model.Trend.AsEnumerable().Reverse())
        {
            decimal profit = t.Profit(asm.Deduction);
            <tr><td><a href="/Economics?m=@($"{t.Year:0000}-{t.Month:00}")">@Labels.Month(t.Month) @t.Year</a></td><td class="num">@t.Tenants</td>
                <td class="num">@Econ.M(t.Mrr)</td><td class="num">@Econ.M(t.CashNet)</td><td class="num">@Econ.M(t.Expenses)</td>
                <td class="num @(profit < 0 ? "var-bad" : "var-good")">@Econ.M(profit)</td></tr>
        }
    </table>
</div>
