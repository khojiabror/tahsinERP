@page "{id:long}"
@model tahsinERP.ControlPanel.Pages.Provisioning.JobModel
@{ var j = Model.Job; ViewData["Title"] = $"Job #{j.Id}"; }
<h1>Job #@j.Id — @Labels.Of(j.Type) <span class="badge @Labels.Badge(j.Status)">@Labels.Of(j.Status)</span></h1>
<div asp-validation-summary="ModelOnly"></div>
<div class="actions">
    <a class="btn secondary" href="/Tenants/Details/@j.TenantId">← @j.Tenant?.LegalName</a>
    @if (Model.CanSell && j.Status == ProvisioningJobStatus.Failed)
    {
        <form method="post" asp-page-handler="Retry" class="inline"><button type="submit">@L.T("Pnl_Prov_Retry")</button></form>
    }
    @if (Model.CanSell && j.Status is ProvisioningJobStatus.Pending or ProvisioningJobStatus.Failed)
    {
        <form method="post" asp-page-handler="Cancel" class="inline"><button type="submit" class="secondary">@L.T("Cancel")</button></form>
    }
</div>
<div class="card">
    <dl class="props">
        <dt>@L.T("Pnl_Organization")</dt><dd><code>@j.Tenant?.Slug</code></dd>
        <dt>@L.T("Pnl_Prov_Attempts")</dt><dd>@j.Attempts / @j.MaxAttempts</dd>
        <dt>@L.T("Pnl_Prov_CreatedBy")</dt><dd>@(Model.CreatedBy ?? L.T("Pnl_Audit_System")) — @j.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm:ss") UTC</dd>
        <dt>@L.T("Pnl_Prov_StartedFinished")</dt><dd>@j.StartedAtUtc?.ToString("dd.MM.yyyy HH:mm:ss") — @j.FinishedAtUtc?.ToString("dd.MM.yyyy HH:mm:ss")</dd>
        <dt>@L.T("Pnl_Prov_NextAttempt")</dt><dd>@(j.Status == ProvisioningJobStatus.Pending ? j.NotBeforeUtc.ToString("dd.MM.yyyy HH:mm:ss") : "")</dd>
        <dt>Lease</dt><dd>@j.LeaseUntilUtc?.ToString("dd.MM.yyyy HH:mm:ss")</dd>
        <dt>@L.T("Pnl_Prov_ExitCode")</dt><dd>@j.ExitCode</dd>
        <dt>@L.T("Pnl_Err_Title")</dt><dd class="mono">@j.Error</dd>
        <dt>@L.T("Pnl_Prov_Parameters")</dt><dd class="mono">@j.Payload</dd>
        <dt>@L.T("Pnl_Prov_Result")</dt><dd class="mono">@j.Result</dd>
    </dl>
</div>
<h2>Log</h2>
<pre class="log">@j.Log</pre>
