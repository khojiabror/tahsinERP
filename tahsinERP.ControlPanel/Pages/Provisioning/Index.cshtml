@page
@model tahsinERP.ControlPanel.Pages.Provisioning.IndexModel
@{ ViewData["Title"] = L.T("Pnl_NavProvisioning"); }
<h1>@L.T("Pnl_Prov_Queue")</h1>
<form method="get" class="actions">
    <select name="Status">
        <option value="">— @L.T("Pnl_AllLower") —</option>
        @foreach (var s in Enum.GetValues<ProvisioningJobStatus>()) { <option value="@s" selected="@(Model.Status == s)">@Labels.Of(s)</option> }
    </select>
    <button type="submit" class="secondary">@L.T("Filter")</button>
</form>
<h2>@L.T("Pnl_Prov_Agents")</h2>
<table>
    <tr><th>@L.T("Pnl_Server")</th><th>@L.T("Pnl_Agent")</th><th>@L.T("Pnl_LastSeenUtc")</th><th>@L.T("Pnl_Version")</th></tr>
    @foreach (var s in Model.Servers)
    {
        <tr><td>@s.Name</td><td>@(s.AgentSecretProtected is null ? L.T("Pnl_Prov_AgentNotConnected") : L.T("Pnl_Prov_AgentHasKey"))</td><td>@s.AgentLastSeenUtc?.ToString("dd.MM.yyyy HH:mm:ss")</td><td>@s.AgentVersion</td></tr>
    }
</table>
<h2>@L.T("Pnl_Prov_Jobs")</h2>
<table>
    <tr><th>#</th><th>@L.T("Pnl_Organization")</th><th>@L.T("Pnl_Audit_Action")</th><th>@L.T("Status")</th><th class="num">@L.T("Pnl_Prov_Attempt")</th><th>@L.T("Pnl_CreatedUtc")</th><th>@L.T("Pnl_Prov_Finished")</th><th>@L.T("Pnl_Err_Title")</th></tr>
    @foreach (var j in Model.Jobs)
    {
        <tr>
            <td><a href="/Provisioning/Job/@j.Id">@j.Id</a></td>
            <td><a href="/Tenants/Details/@j.TenantId">@j.Tenant?.Slug</a></td>
            <td>@Labels.Of(j.Type)</td>
            <td><span class="badge @Labels.Badge(j.Status)">@Labels.Of(j.Status)</span></td>
            <td class="num">@j.Attempts/@j.MaxAttempts</td>
            <td>@j.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
            <td>@j.FinishedAtUtc?.ToString("dd.MM.yyyy HH:mm")</td>
            <td class="mono">@j.Error</td>
        </tr>
    }
</table>
@if (Model.Jobs.Count == 0) { <div class="empty">@L.T("Pnl_Prov_NoJobs")</div> }
