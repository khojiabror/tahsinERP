@page
@model tahsinERP.ControlPanel.Pages.Requests.IndexModel
@using tahsinERP.ControlPanel.Portal
@{ ViewData["Title"] = L.T("Pnl_NavRequests"); }
<h1>@L.T("Pnl_Req_Title")</h1>
<div class="toolbar">
    <a class="btn @(Model.All || Model.Status != PortalRequestStatus.Pending ? "secondary" : "")" href="/Requests">@L.T("Pnl_Req_Queue")</a>
    <a class="btn @(Model.All ? "" : "secondary")" href="/Requests?all=true">@L.T("All")</a>
</div>
<div asp-validation-summary="ModelOnly"></div>
<p class="hint">@L.T("Pnl_Req_Hint")</p>
@if (Model.Rows.Count == 0)
{
    <p class="empty">@L.T("Pnl_Req_Empty")</p>
}
else
{
    <table>
        <tr><th>#</th><th>@L.T("Pnl_DateUtc")</th><th>@L.T("Pnl_Organization")</th><th>@L.T("Pnl_Req_Who")</th><th>@L.T("Pnl_Req_Request")</th><th>@L.T("Comment")</th><th>@L.T("Status")</th><th>@L.T("Pnl_Prov_Result")</th></tr>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
                <td><a href="/Tenants/Details/@r.TenantId">@r.Tenant?.LegalName</a></td>
                <td>@r.PortalUser?.FullName</td>
                <td>«@r.Plan?.Name», @r.PeriodCount @PortalRequestService.PeriodUnit(r.Period) — @PortalRequestService.KindText(r.Kind), @L.T("Pnl_Req_FromDate", r.EffectiveDate.ToString("dd.MM.yyyy"))</td>
                <td>@r.Comment</td>
                <td><span class="badge @tahsinERP.ControlPanel.Pages.Requests.IndexModel.Badge(r.Status)">@tahsinERP.ControlPanel.Pages.Requests.IndexModel.Of(r.Status)</span></td>
                <td>
                    @if (r.Status == PortalRequestStatus.Pending && Model.CanSell)
                    {
                        <form method="post" class="inline"><input type="hidden" name="RequestId" value="@r.Id" />
                            <button type="submit" asp-page-handler="Approve">@L.T("Confirm")</button></form>
                        <form method="post" class="inline"><input type="hidden" name="RequestId" value="@r.Id" />
                            <input type="text" name="Reason" placeholder="@L.T("Pnl_Req_RejectReason")" />
                            <button type="submit" class="secondary" asp-page-handler="Reject">@L.T("Reject")</button></form>
                    }
                    else
                    {
                        @if (r.InvoiceId is int iid && Model.Invoices.TryGetValue(iid, out var inv))
                        {
                            <a href="/Invoices/Details/@iid">@(inv.Number ?? L.T("Pnl_DraftLower"))</a> <span class="hint">@Labels.Of(inv.Status)</span>
                        }
                        @r.DecisionReason
                        @if (r.DecidedByStaffId is int sid) { <span class="hint">— @Model.StaffNames.GetValueOrDefault(sid)</span> }
                    }
                </td>
            </tr>
        }
    </table>
    <partial name="_Pager" model="Model.Pager" />
}
