@page "{id:int}"
@model tahsinERP.ControlPanel.Pages.Invoices.DetailsModel
@{ var inv = Model.Invoice; ViewData["Title"] = inv.Number ?? L.T("Pnl_InvStatus_Draft"); }
<h1>@(inv.Number ?? L.T("Pnl_Inv_DraftNo", inv.Id)) <span class="badge @Labels.Badge(inv.Status)">@Labels.Of(inv.Status)</span></h1>
<div asp-validation-summary="All"></div>
<div class="actions">
    <a class="btn secondary" href="/Invoices/Details/@inv.Id?handler=Pdf">PDF</a>
    @if (Model.CanSell && inv.Status == InvoiceStatus.Draft)
    {
        <a class="btn secondary" href="/Invoices/Edit/@inv.Id">@L.T("Edit")</a>
        <form method="post" asp-page-handler="Issue" class="inline"><button type="submit">@L.T("Pnl_Inv_Issue")</button></form>
    }
    <a href="/Tenants/Details/@inv.TenantId">← @inv.Tenant!.LegalName</a>
</div>
<div class="card">
    <dl class="props">
        <dt>@L.T("Pnl_Inv_DateDue")</dt><dd>@inv.IssueDate.ToString("dd.MM.yyyy") / @inv.DueDate.ToString("dd.MM.yyyy")</dd>
        <dt>@L.T("Pnl_Subscription")</dt><dd>@(inv.Subscription is null ? "—" : $"#{inv.Subscription.Id} {inv.Subscription.Plan?.Name}, {inv.PeriodCount} × {Labels.Of(inv.Subscription.Period).ToLower()}")
            @if (inv.SubscriptionAppliedUtc != null) { <span class="badge ok">@L.T("Pnl_Inv_Extended")</span> }</dd>
        <dt>@L.T("Pnl_Inv_TotalWithVat")</dt><dd><strong>@Money.FormatSom(inv.TotalTiyin)</strong>, @L.T("Pnl_Inv_OfWhichVat") @Money.FormatSom(inv.VatTiyin)</dd>
        <dt>@L.T("Pnl_Inv_PaidRemaining")</dt><dd>@Money.FormatSom(inv.PaidTiyin) / <strong>@Money.FormatSom(inv.RemainingTiyin)</strong></dd>
        @if (!string.IsNullOrEmpty(inv.Note)) { <dt>@L.T("Comment")</dt><dd>@inv.Note</dd> }
    </dl>
</div>
<table>
    <tr><th>№</th><th>@L.T("Pnl_Service")</th><th class="num">@L.T("Quantity")</th><th class="num">@L.T("Price")</th><th class="num">@L.T("Amount")</th><th class="num">@L.T("Pnl_VatPercent")</th><th class="num">@L.T("Pnl_Vat")</th></tr>
    @foreach (var l in inv.Lines.OrderBy(l => l.LineNo))
    {
        <tr><td>@l.LineNo</td><td>@l.Description</td><td class="num">@l.Quantity.ToString("0.###")</td><td class="num">@Money.Format(l.UnitPriceTiyin)</td>
            <td class="num">@Money.Format(l.AmountTiyin)</td><td class="num">@l.VatRatePercent.ToString("0.##")</td><td class="num">@Money.Format(l.VatTiyin)</td></tr>
    }
</table>

<h2>@L.T("Pnl_Inv_DidoxTitle")</h2>
<div class="card">
    @if (inv.DidoxId is not null)
    {
        <dl class="props">
            <dt>Didox ID</dt><dd class="mono">@inv.DidoxId</dd>
            <dt>@L.T("Status")</dt><dd>@(inv.DidoxStatus ?? "—") @if (inv.DidoxCheckedAtUtc != null) { <span class="hint">@L.T("Pnl_Inv_Checked") @inv.DidoxCheckedAtUtc.Value.ToString("dd.MM.yyyy HH:mm") UTC</span> }</dd>
            <dt>@L.T("Pnl_Inv_Sent")</dt><dd>@inv.DidoxSentAtUtc?.ToString("dd.MM.yyyy HH:mm") UTC</dd>
            @if (inv.DidoxError != null) { <dt>@L.T("Pnl_Err_Title")</dt><dd>@inv.DidoxError</dd> }
        </dl>
        @if (Model.DidoxEnabled)
        {
            <form method="post" asp-page-handler="DidoxRefresh" class="inline"><button type="submit" class="secondary">@L.T("Pnl_Inv_RefreshStatus")</button></form>
        }
    }
    else if (!Model.DidoxEnabled)
    {
        <p class="hint">@L.T("Pnl_Inv_DidoxOff") @string.Join(", ", Model.DidoxMissing) (<code>ControlPanel:Didox:*</code>, 08_STAGE4.md). @L.T("Pnl_Inv_DidoxManual")</p>
    }
    else if (Model.CanSell && DidoxService.CanSend(inv))
    {
        @if (inv.DidoxError != null) { <p class="hint">@L.T("Pnl_Inv_LastAttemptError") @inv.DidoxError</p> }
        <form method="post" asp-page-handler="DidoxSend" class="inline"><button type="submit">@L.T("Pnl_Inv_SendDidox")</button></form>
        <span class="hint">@L.T("Pnl_Inv_DidoxSendHint")</span>
    }
    else
    {
        <p class="hint">@L.T("Pnl_Inv_DidoxOnlyIssued")</p>
    }
</div>

<h2>@L.T("Pnl_Payments")</h2>
<table>
    <tr><th>@L.T("Date")</th><th>@L.T("Pnl_Method")</th><th class="num">@L.T("Amount")</th><th>@L.T("Pnl_DocNo")</th><th>@L.T("Comment")</th><th>@L.T("Pnl_Inv_RecordedBy")</th><th>@L.T("Pnl_Reversal")</th></tr>
    @foreach (var p in inv.Payments.OrderBy(p => p.Id))
    {
        <tr class="@(p.IsReversed ? "reversed" : "")">
            <td>@p.PaidAt.ToString("dd.MM.yyyy")</td><td>@Labels.Of(p.Method)</td><td class="num">@Money.Format(p.AmountTiyin)</td>
            <td>@p.Reference</td><td>@p.Note</td>
            <td>@Model.StaffNames.GetValueOrDefault(p.RecordedByStaffId) <span class="hint">@p.RecordedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC</span></td>
            <td>
                @if (p.IsReversed)
                {
                    <span>@Model.StaffNames.GetValueOrDefault(p.ReversedByStaffId ?? 0): @p.ReverseReason</span>
                }
                else if (Model.IsOwner)
                {
                    <form method="post" asp-page-handler="Reverse" class="toolbar">
                        <input type="hidden" name="PaymentId" value="@p.Id" />
                        <input type="text" name="Reason" placeholder="@L.T("Pnl_Inv_ReasonRequired")" />
                        <button type="submit" class="danger">@L.T("Pnl_Reversal")</button>
                    </form>
                }
                @if (Model.IsOwner)
                {
                    <form method="post" asp-page-handler="DeletePayment" class="toolbar" onsubmit="return confirm('@L.T("Pnl_Inv_DeletePaymentConfirm")')">
                        <input type="hidden" name="PaymentId" value="@p.Id" />
                        <input type="text" name="Reason" placeholder="@L.T("Pnl_Inv_DeleteReason")" />
                        <button type="submit" class="danger">@L.T("Delete")</button>
                    </form>
                }
            </td>
        </tr>
    }
</table>
@if (inv.Payments.Count == 0) { <div class="empty">@L.T("Pnl_Inv_NoPayments")</div> }

@if (Model.CanSell && inv.Status is InvoiceStatus.Issued or InvoiceStatus.PartiallyPaid)
{
    <h2>@L.T("Pnl_Inv_PaymentReceived")</h2>
    <form method="post" asp-page-handler="Pay" class="stack card">
        <div class="row">
            <div><label asp-for="Amount">@L.T("Pnl_AmountSom")</label><input asp-for="Amount" type="text" /><span asp-validation-for="Amount"></span></div>
            <div><label asp-for="PaidAt">@L.T("Pnl_PaymentDate")</label><input asp-for="PaidAt" type="date" /></div>
        </div>
        <div class="row">
            <div><label asp-for="Method">@L.T("Pnl_Method")</label>
                <select asp-for="Method">@foreach (var m in Enum.GetValues<PaymentMethod>()) { <option value="@m">@Labels.Of(m)</option> }</select></div>
            <div><label asp-for="Reference">@L.T("Pnl_Inv_Reference")</label><input asp-for="Reference" type="text" /></div>
        </div>
        <div><label asp-for="PaymentNote">@L.T("Comment")</label><input asp-for="PaymentNote" type="text" /></div>
        <div class="hint">@L.T("Pnl_Inv_PayHint")</div>
        <div><button type="submit">@L.T("Pnl_Inv_RecordPayment")</button></div>
    </form>
}
@if (Model.CanSell && inv.Status is InvoiceStatus.Draft or InvoiceStatus.Issued && inv.PaidTiyin == 0)
{
    <form method="post" asp-page-handler="Cancel" class="toolbar card">
        <div><label for="Reason">@L.T("Pnl_CancelReason")</label><input id="Reason" name="Reason" type="text" /></div>
        <button type="submit" class="danger">@L.T("Pnl_Inv_CancelInvoice")</button>
    </form>
}
@if (Model.IsOwner && inv.Payments.Count == 0 && inv.DidoxId == null)
{
    <form method="post" asp-page-handler="DeleteInvoice" class="toolbar card" onsubmit="return confirm('@L.T("Pnl_Inv_DeleteInvoiceConfirm")')">
        <div><label for="DeleteReason">@L.T("Pnl_Inv_DeleteReason")</label><input id="DeleteReason" name="Reason" type="text" /></div>
        <button type="submit" class="danger">@L.T("Pnl_Inv_DeleteInvoice")</button>
        <span class="hint">@L.T("Pnl_Inv_DeleteInvoiceHint")</span>
    </form>
}
