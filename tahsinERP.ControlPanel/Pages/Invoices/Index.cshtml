@page
@model tahsinERP.ControlPanel.Pages.Invoices.IndexModel
@{ ViewData["Title"] = "Hisob-fakturalar"; }
<h1>Hisob-fakturalar</h1>
<form method="get" class="toolbar">
    <div>
        <label for="Status">Holat</label>
        <select id="Status" name="Status">
            <option value="">Hammasi</option>
            @foreach (var s in Enum.GetValues<InvoiceStatus>()) { <option value="@s" selected="@(Model.Status == s)">@Labels.Of(s)</option> }
        </select>
    </div>
    <label class="check"><input type="checkbox" name="Overdue" value="true" checked="@Model.Overdue" /> Faqat muddati o'tganlar</label>
    <button type="submit" class="secondary">Ko'rsatish</button>
</form>
<p class="hint">Yangi hisob-faktura — tashkilot sahifasidan (obuna bo'yicha).</p>
<table>
    <tr><th>Raqam</th><th>Tashkilot</th><th>Sana</th><th>Muddat</th><th class="num">Jami</th><th class="num">QQS</th><th class="num">To'langan</th><th>Holat</th></tr>
    @foreach (var i in Model.Rows)
    {
        bool overdue = i.Status is InvoiceStatus.Issued or InvoiceStatus.PartiallyPaid && i.DueDate < Model.Today;
        <tr>
            <td><a href="/Invoices/Details/@i.Id">@(i.Number ?? $"qoralama #{i.Id}")</a></td>
            <td>@i.Tenant!.LegalName</td>
            <td>@i.IssueDate.ToString("dd.MM.yyyy")</td>
            <td>@i.DueDate.ToString("dd.MM.yyyy") @if (overdue) { <span class="badge bad">o'tgan</span> }</td>
            <td class="num">@Money.Format(i.TotalTiyin)</td><td class="num">@Money.Format(i.VatTiyin)</td><td class="num">@Money.Format(i.PaidTiyin)</td>
            <td><span class="badge @Labels.Badge(i.Status)">@Labels.Of(i.Status)</span></td>
        </tr>
    }
</table>
@if (Model.Rows.Count == 0) { <div class="empty">Yo'q.</div> }
