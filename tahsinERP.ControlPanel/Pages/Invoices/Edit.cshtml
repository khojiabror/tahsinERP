@page "{id:int}"
@model tahsinERP.ControlPanel.Pages.Invoices.EditModel
@{ ViewData["Title"] = L.T("Pnl_Inv_EditDraft"); }
<h1>@L.T("Pnl_Inv_DraftNo", Model.Invoice.Id) — @Model.Invoice.Tenant!.LegalName</h1>
<form method="post" class="stack card">
    <div asp-validation-summary="All"></div>
    <partial name="_Lines" model="Model.Lines" />
    <div class="row">
        <div><label asp-for="DueDate">@L.T("Pnl_DueDate")</label><input asp-for="DueDate" type="date" /></div>
        <div><label asp-for="Note">@L.T("Comment")</label><input asp-for="Note" type="text" /></div>
    </div>
    <div class="actions"><button type="submit">@L.T("Save")</button><a class="btn secondary" href="/Invoices/Details/@Model.Invoice.Id">@L.T("Pnl_CancelShort")</a></div>
</form>
