@page "{id:int}"
@model tahsinERP.ControlPanel.Pages.Subscriptions.EditModel
@{ ViewData["Title"] = L.T("Pnl_Sub_No", Model.Sub.Id); }
<h1>@L.T("Pnl_Sub_No", Model.Sub.Id) — @Model.Sub.Tenant!.LegalName</h1>
<div asp-validation-summary="All"></div>
<div class="card">
    <dl class="props">
        <dt>@L.T("Pnl_Sub_CurrentPackage")</dt><dd>@Model.Sub.Plan!.Name (@Labels.Of(Model.Sub.Period))</dd>
        <dt>@L.T("Period")</dt><dd>@Model.Sub.StartDate.ToString("dd.MM.yyyy") – @Model.Sub.EndDate.ToString("dd.MM.yyyy")</dd>
        <dt>@L.T("Status")</dt><dd>@Labels.Of(Model.Sub.Status)</dd>
    </dl>
</div>
@if (Model.Sub.Period != BillingPeriod.Trial && Model.Sub.Status is SubscriptionStatus.Pending or SubscriptionStatus.Active)
{
    <form method="post" action="@Url.Page(null)" asp-antiforgery="true" class="stack card">
        @if (Model.Sub.Plan!.IsAddOn)
        {
            <input type="hidden" asp-for="PlanId" /><input type="hidden" asp-for="Users" />
            <div class="hint">@L.T("Pnl_Sub_AddOnEditHint")</div>
        }
        else
        {
        <div class="row">
            <div>
                <label asp-for="PlanId">@L.T("Pnl_Package")</label>
                <select asp-for="PlanId">@foreach (var p in Model.Plans.Where(p => !p.IsAddOn)) { <option value="@p.Id">@p.Name — @p.MaxUsers @L.T("Pnl_UsersAbbr")</option> }</select>
            </div>
            <div><label asp-for="Users">@L.T("Pnl_UsersPlural")</label><input asp-for="Users" type="number" /></div>
        </div>
        }
        <label class="check"><input asp-for="AutoRenew" /> @L.T("Pnl_AutoRenew")</label>
        <div class="hint">@L.T("Pnl_Sub_ChangePlanHint")</div>
        <div><button type="submit">@L.T("Save")</button></div>
    </form>
    <form method="post" asp-page-handler="Cancel" class="stack card">
        <div><label asp-for="Reason">@L.T("Pnl_CancelReason")</label><input asp-for="Reason" type="text" /></div>
        <div><button type="submit" class="danger">@L.T("Pnl_Sub_Cancel")</button></div>
        <div class="hint">@L.T("Pnl_Sub_CancelHint")</div>
    </form>
}
<p><a href="/Tenants/Details/@Model.Sub.TenantId">← @L.T("Pnl_ToOrganization")</a></p>
