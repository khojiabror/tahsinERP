@page
@model tahsinERP.ControlPanel.Pages.Updates.IndexModel
@using tahsinERP.ControlPanel.Pages.Updates
@using tahsinERP.Provisioning.Contracts
@{ ViewData["Title"] = L.T("Pnl_NavUpdates"); var inv = Model.Inventory; }
<h1>@L.T("Pnl_NavUpdates")</h1>
<div asp-validation-summary="ModelOnly"></div>

<div class="actions">
    @if (Model.Servers.Count > 1)
    {
        <form method="get" class="inline">
            <select name="ServerId">
                @foreach (var s in Model.Servers) { <option value="@s.Id" selected="@(s.Id == Model.ServerId)">@s.Name</option> }
            </select>
            <button type="submit" class="secondary">@L.T("Pnl_Choose")</button>
        </form>
    }
    <form method="post" asp-page-handler="Refresh" class="inline">
        <input type="hidden" name="ServerId" value="@Model.ServerId" />
        <button type="submit" class="secondary" disabled="@(!Model.SourceConfigured)">@L.T("Pnl_Upd_CheckNow")</button>
    </form>
    @if (!Model.SourceConfigured)
    {
        <span class="badge warn">@L.T("Pnl_Upd_TokenNotConfigured")</span>
    }
</div>

@if (Model.Server is null)
{
    <div class="empty">@L.T("Pnl_Upd_NoAgentServer")</div>
    return;
}

<div class="card">
    <dl class="props">
        <dt>@L.T("Pnl_Server")</dt><dd>@Model.Server.Name <span class="hint">@Model.Server.Host</span></dd>
        <dt>@L.T("Pnl_Agent")</dt><dd>@(Model.Server.AgentVersion ?? "—") · @L.T("Pnl_Upd_LastSeen", Model.Server.AgentLastSeenUtc?.ToString("dd.MM.yyyy HH:mm"))</dd>
        <dt>@L.T("Pnl_Upd_Updater")</dt>
        <dd>
            @if (inv?.UpdaterVersion is { } uv) { <span class="badge ok">@uv</span> }
            else { <span class="badge bad">@L.T("Pnl_Upd_NotInstalled")</span> <span class="hint">@L.T("Pnl_Upd_InstallUpdaterHint")</span> }
            @if (Model.InventoryAtUtc is { } at) { <span class="hint">@L.T("Pnl_Upd_InventoryAt", at.ToString("dd.MM.yyyy HH:mm"))</span> }
        </dd>
    </dl>
</div>

<h2>@L.T("Pnl_Upd_ServerApps")</h2>
<table>
    <tr><th>@L.T("Pnl_Upd_App")</th><th>@L.T("Pnl_Upd_Installed")</th><th>@L.T("Pnl_Upd_Available")</th><th>@L.T("Pnl_Upd_Changes")</th><th></th></tr>
    @foreach (var a in Model.Apps)
    {
        <tr>
            <td><b>@ReleaseApps.Title(a.App)</b></td>
            <td class="mono">@UpdateLabels.Version(a.Installed?.Version)<br /><span class="hint">@a.Installed?.InstalledAtUtc?.ToString("dd.MM.yyyy HH:mm")</span></td>
            <td>
                @if (a.Offer is not null) { <span class="badge info">@a.Offer.Version</span> }
                else if (a.Newer.Count > 0) { <span class="badge ok">@L.T("Pnl_Upd_Latest")</span> <span class="hint">@L.T("Pnl_Auth2_AppUnchanged", a.Newer[0].Version)</span> }
                else { <span class="badge ok">@L.T("Pnl_Upd_Latest")</span> }
            </td>
            <td>
                @foreach (var r in a.Newer.Where(r => UpdatesService.ChangedIn(r, a.App)).Take(10))
                {
                    <details><summary>@r.Version · @r.PublishedAtUtc.ToString("dd.MM.yyyy")</summary><pre class="log">@IndexModel.NotesFor(r, a.App)</pre></details>
                }
            </td>
            <td>
                @if (a.Active is not null)
                {
                    <a class="badge @UpdateLabels.Badge(a.Active.Status)" href="/Updates/Job/@a.Active.Id">@UpdateLabels.Of(a.Active.Status)</a>
                }
                else
                {
                    @* Kodi o'zgarmagan relizga tugma yo'q — o'rnatishdan foyda yo'q (versiya raqamigina o'zgaradi) *@
                    @if (a.Offer is not null)
                    {
                        var target = a.Offer;
                        <form method="post" asp-page-handler="Install" class="inline"
                              data-confirm="@L.T("Pnl_Upd_ConfirmInstallApp", ReleaseApps.Title(a.App), target.Version)">
                            <input type="hidden" name="ServerId" value="@Model.ServerId" />
                            <input type="hidden" name="app" value="@a.App" />
                            <input type="hidden" name="version" value="@target.Version" />
                            <button type="submit">@L.T("Pnl_Upd_InstallVersion", target.Version)</button>
                        </form>
                    }
                    @if (a.Installed?.CanRollback == true)
                    {
                        <form method="post" asp-page-handler="Rollback" class="inline"
                              data-confirm="@L.T("Pnl_Upd_ConfirmRollbackApp", ReleaseApps.Title(a.App), UpdateLabels.Version(a.Installed.PreviousVersion))">
                            <input type="hidden" name="ServerId" value="@Model.ServerId" />
                            <input type="hidden" name="app" value="@a.App" />
                            <button type="submit" class="secondary">@L.T("Pnl_Upd_Rollback")</button>
                        </form>
                    }
                }
            </td>
        </tr>
    }
</table>

<h2>@L.T("Pnl_Upd_TenantsErp")</h2>
<p class="hint">@L.T("Pnl_Upd_TenantsHint")</p>
<table>
    <tr><th>@L.T("Pnl_Upd_Tenant")</th><th>@L.T("Pnl_Upd_ErpVersion")</th><th>@L.T("Pnl_Upd_DbSchema")</th><th>@L.T("Pnl_Upd_Available")</th><th></th></tr>
    @foreach (var t in Model.Tenants)
    {
        var i = t.Instance;
        <tr>
            <td><a href="/Tenants/Details/@t.Tenant.Id">@t.Tenant.Slug</a><br /><span class="hint">@t.Tenant.DbName</span></td>
            <td class="mono">
                @if (i is null) { <span class="badge muted">@L.T("Pnl_Upd_SharedSite")</span> }
                else { @UpdateLabels.Version(i.Version) <br /><span class="hint">@i.InstalledAtUtc?.ToString("dd.MM.yyyy HH:mm")</span> }
            </td>
            <td class="mono">@i?.SchemaVersion</td>
            <td>
                @if (t.Offer is not null) { <span class="badge info">@t.Offer.Version</span> }
                else if (i is not null) { <span class="badge ok">@L.T("Pnl_Upd_Latest")</span> }
            </td>
            <td>
                @if (t.Active is not null)
                {
                    <a class="badge @UpdateLabels.Badge(t.Active.Status)" href="/Updates/Job/@t.Active.Id">@UpdateLabels.Of(t.Active.Status)</a>
                }
                else if (i is null)
                {
                    @if (t.Newer.Count > 0)
                    {
                        <form method="post" asp-page-handler="Tenant" class="inline"
                              data-confirm="@L.T("Pnl_Upd_ConfirmCreateInstance", t.Tenant.Slug)">
                            <input type="hidden" name="ServerId" value="@Model.ServerId" />
                            <input type="hidden" name="tenantId" value="@t.Tenant.Id" />
                            <input type="hidden" name="action" value="@UpdateAction.CreateInstance" />
                            <select name="version">@foreach (var r in t.Newer) { <option value="@r.Version">@r.Version</option> }</select>
                            <button type="submit">@L.T("Pnl_Upd_Action_CreateInstance")</button>
                        </form>
                    }
                    else { <span class="hint">@L.T("Pnl_Upd_NoErpRelease")</span> }
                }
                else
                {
                    @if (t.Newer.Count > 0)
                    {
                        <form method="post" asp-page-handler="Tenant" class="inline"
                              data-confirm="@L.T("Pnl_Upd_ConfirmInstallTenant", t.Tenant.Slug)">
                            <input type="hidden" name="ServerId" value="@Model.ServerId" />
                            <input type="hidden" name="tenantId" value="@t.Tenant.Id" />
                            <input type="hidden" name="action" value="@UpdateAction.InstallTenant" />
                            <select name="version">@foreach (var r in t.Newer) { <option value="@r.Version">@r.Version</option> }</select>
                            <button type="submit">@L.T("Pnl_Upd_Update")</button>
                        </form>
                    }
                    <details>
                        <summary>@L.T("Pnl_Upd_MoreActions")</summary>
                        @if (i.CanRollback)
                        {
                            <form method="post" asp-page-handler="Tenant"
                                  data-confirm="@L.T("Pnl_Upd_ConfirmRollbackTenant", t.Tenant.Slug, UpdateLabels.Version(i.PreviousVersion))">
                                <input type="hidden" name="ServerId" value="@Model.ServerId" />
                                <input type="hidden" name="tenantId" value="@t.Tenant.Id" />
                                <input type="hidden" name="action" value="@UpdateAction.RollbackTenant" />
                                @if (i.HasDatabaseBackup)
                                {
                                    <label><input type="checkbox" name="restoreDatabase" value="true" /> @L.T("Pnl_Upd_RestoreDbToo")
                                        <span class="badge bad">@L.T("Pnl_Upd_DataLossWarn")</span></label>
                                }
                                <button type="submit" class="secondary">@L.T("Pnl_Upd_Rollback")</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="Tenant" data-confirm="@L.T("Pnl_Upd_ConfirmMigrate", t.Tenant.Slug)">
                            <input type="hidden" name="ServerId" value="@Model.ServerId" />
                            <input type="hidden" name="tenantId" value="@t.Tenant.Id" />
                            <input type="hidden" name="action" value="@UpdateAction.MigrateTenant" />
                            <button type="submit" class="secondary">@L.T("Pnl_Upd_MigrateDb")</button>
                        </form>
                    </details>
                }
            </td>
        </tr>
    }
</table>
@if (Model.Tenants.Count == 0) { <div class="empty">@L.T("Pnl_Upd_NoTenants")</div> }

<h2>@L.T("Pnl_Upd_RecentJobs")</h2>
<table>
    <tr><th>#</th><th>@L.T("Pnl_Audit_Action")</th><th>@L.T("Pnl_Upd_AppOrTenant")</th><th>@L.T("Pnl_Version")</th><th>@L.T("Status")</th><th>@L.T("Pnl_CreatedUtc")</th><th>@L.T("Pnl_Err_Title")</th></tr>
    @foreach (var j in Model.Jobs)
    {
        <tr>
            <td><a href="/Updates/Job/@j.Id">@j.Id</a></td>
            <td>@UpdateLabels.Of(j.Action)</td>
            <td>@(j.Slug ?? ReleaseApps.Title(j.App))</td>
            <td class="mono">@UpdateLabels.Version(j.FromVersion) → @(j.Version ?? j.InstalledVersion ?? L.T("Pnl_Upd_Backup"))</td>
            <td><span class="badge @UpdateLabels.Badge(j.Status)">@UpdateLabels.Of(j.Status)</span> <span class="hint">@j.Stage</span></td>
            <td>@j.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
            <td class="mono">@j.Error</td>
        </tr>
    }
</table>
@if (Model.Jobs.Count == 0) { <div class="empty">@L.T("Pnl_Upd_NoJobs")</div> }

<h2>@L.T("Pnl_Upd_Releases")</h2>
<table>
    <tr><th>@L.T("Pnl_Version")</th><th>@L.T("Pnl_DateUtc")</th><th>@L.T("Pnl_Upd_Commit")</th><th>@L.T("Pnl_Lic_Signature")</th><th>@L.T("Pnl_Upd_AppsChanged")</th></tr>
    @foreach (var r in Model.Releases)
    {
        <tr>
            <td class="mono">@r.Version @if (r.Prerelease) { <span class="badge warn">@L.T("Pnl_Upd_Prerelease")</span> }</td>
            <td>@r.PublishedAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
            <td class="mono">@r.Commit?[..Math.Min(8, r.Commit.Length)]</td>
            <td>@if (r.SignatureValid) { <span class="badge ok">OK</span> } else { <span class="badge bad" title="@r.VerifyError">@L.T("Pnl_Upd_Invalid")</span> }</td>
            <td class="mono">@r.Apps</td>
        </tr>
    }
</table>
@if (Model.Releases.Count == 0) { <div class="empty">@L.T("Pnl_Upd_NoReleases")</div> }
