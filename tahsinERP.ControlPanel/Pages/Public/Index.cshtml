@page "{lang?}"
@model tahsinERP.ControlPanel.Pages.Public.IndexModel
@using tahsinERP.ControlPanel.Pages.Public
@{
    Layout = null;
    var C = Model.C;
    string self = IndexModel.PathFor(Model.Lang);
    string canonical = "https://" + Model.Request.Host.Host + self;
    string Img(string name) => $"/landing/img/{name}.webp";
}
<!DOCTYPE html>
<html lang="@C["htmlLang"]" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@C["meta.title"]</title>
    <meta name="description" content="@C["meta.description"]" />
    <link rel="canonical" href="@canonical" />
    @foreach (var l in LandingContent.Languages)
    {
        <link rel="alternate" hreflang="@l" href="https://@Model.Request.Host.Host@IndexModel.PathFor(l)" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@C["meta.title"]" />
    <meta property="og:description" content="@C["meta.description"]" />
    <meta property="og:image" content="https://@Model.Request.Host.Host/landing/img/finance.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#070d1f" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/fonts/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/landing/landing.css" asp-append-version="true" />
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" class="sprite" aria-hidden="true">
    <symbol id="i-cart" viewBox="0 0 24 24"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></symbol>
    <symbol id="i-box" viewBox="0 0 24 24"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></symbol>
    <symbol id="i-factory" viewBox="0 0 24 24"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/></symbol>
    <symbol id="i-layers" viewBox="0 0 24 24"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></symbol>
    <symbol id="i-handshake" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></symbol>
    <symbol id="i-send" viewBox="0 0 24 24"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></symbol>
    <symbol id="i-wallet" viewBox="0 0 24 24"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></symbol>
    <symbol id="i-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
    <symbol id="i-truck" viewBox="0 0 24 24"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></symbol>
    <symbol id="i-file" viewBox="0 0 24 24"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="m9 12 2 2 4-4"/></symbol>
    <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></symbol>
    <symbol id="i-trending" viewBox="0 0 24 24"><path d="m22 7-8.5 8.5-5-5L2 17"/><path d="M16 7h6v6"/></symbol>
    <symbol id="i-zap" viewBox="0 0 24 24"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></symbol>
    <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0"/><circle cx="12" cy="12" r="3"/></symbol>
    <symbol id="i-mic" viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/></symbol>
    <symbol id="i-route" viewBox="0 0 24 24"><circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/></symbol>
    <symbol id="i-cloud" viewBox="0 0 24 24"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></symbol>
    <symbol id="i-language" viewBox="0 0 24 24"><path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/></symbol>
    <symbol id="i-plug" viewBox="0 0 24 24"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/></symbol>
    <symbol id="i-settings" viewBox="0 0 24 24"><path d="M21 4h-7"/><path d="M10 4H3"/><path d="M21 12h-9"/><path d="M8 12H3"/><path d="M21 20h-5"/><path d="M12 20H3"/><path d="M14 2v4"/><path d="M8 10v4"/><path d="M16 18v4"/></symbol>
    <symbol id="i-headset" viewBox="0 0 24 24"><path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"/><path d="M21 16v2a4 4 0 0 1-4 4h-5"/></symbol>
    <symbol id="i-tick" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></symbol>
    <symbol id="i-x" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></symbol>
    <symbol id="i-phone" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></symbol>
    <symbol id="i-tg" viewBox="0 0 24 24"><path d="M21.2 4.4 2.9 11.5c-1.2.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.4.8.9.8s.7-.2 1-.5l2.2-2.1 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.9-1.6-1.4Z"/><path d="m7.5 14.5 9.5-6.5"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></symbol>
    <symbol id="i-chart" viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></symbol>
    <symbol id="i-home" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1Z"/></symbol>
    <symbol id="i-spark" viewBox="0 0 24 24"><path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0l1.58 6.14a2 2 0 0 0 1.44 1.44l6.14 1.58a.5.5 0 0 1 0 .96l-6.14 1.58a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0z"/></symbol>
</svg>

<header class="hdr" id="top" data-header>
    <div class="wrap hdr-in">
        <a class="brand" href="@self" aria-label="tahsinERP">
            <img src="/img/logo.png" alt="" width="36" height="36" />
            <span>tahsin<b>ERP</b></span>
        </a>
        <nav class="nav" data-nav>
            <a href="#why">@C["nav.product"]</a>
            <a href="#modules">@C["nav.modules"]</a>
            <a href="#distribution">@C["nav.distribution"]</a>
            <a href="#process">@C["nav.process"]</a>
            <a href="#plans">@C["nav.pricing"]</a>
            <a href="#faq">@C["nav.faq"]</a>
            <a class="nav-login-m" href="@Model.PortalUrl">@C["nav.login"]</a>
        </nav>
        <div class="hdr-act">
            <div class="langs" role="group" aria-label="Language">
                @foreach (var l in LandingContent.Languages)
                {
                    <a href="@IndexModel.PathFor(l)" class="@(l == Model.Lang ? "on" : "")" hreflang="@l" lang="@l">@l.ToUpperInvariant()</a>
                }
            </div>
            <a class="lnk-login" href="@Model.PortalUrl"><svg class="i"><use href="#i-user" /></svg>@C["nav.login"]</a>
            <a class="btn btn-pri btn-sm" href="#demo">@C["nav.demo"]</a>
            <button type="button" class="burger" data-burger aria-label="Menu"><svg class="i"><use href="#i-menu" /></svg></button>
        </div>
    </div>
</header>

<main>
<!-- ═════════ HERO ═════════ -->
<section class="hero">
    <div class="hero-bg" aria-hidden="true"><span class="orb o1"></span><span class="orb o2"></span><span class="orb o3"></span><span class="grid"></span></div>
    <div class="wrap hero-in">
        <div class="hero-copy">
            <span class="eyebrow eyebrow-dark"><svg class="i"><use href="#i-spark" /></svg>@C["hero.eyebrow"]</span>
            <h1>@C["hero.titleA"] <span class="grad">@C["hero.titleHi"]</span>@(string.IsNullOrEmpty(C["hero.titleB"]) ? "" : " " + C["hero.titleB"])</h1>
            <p class="lead">@C["hero.subtitle"]</p>
            <div class="hero-cta">
                <a class="btn btn-pri btn-lg" href="#demo">@C["hero.cta"]<svg class="i"><use href="#i-arrow" /></svg></a>
                <a class="btn btn-ghost btn-lg" href="#modules">@C["hero.cta2"]</a>
            </div>
            <ul class="hero-points">
                @foreach (var p in C.Strings("hero.points"))
                {
                    <li><svg class="i"><use href="#i-tick" /></svg>@p</li>
                }
            </ul>
        </div>

        <div class="hero-visual" aria-hidden="true">
            <div class="mock" data-mock>
                <div class="mock-bar"><i></i><i></i><i></i><span>app.tahsinerp.uz</span><em class="live"><b></b>@C["hero.liveLabel"]</em></div>
                <div class="mock-body">
                    <aside class="mock-side">
                        <span class="ms-logo"><img src="/img/logo.png" alt="" width="22" height="22" /></span>
                        <svg class="i on"><use href="#i-home" /></svg><svg class="i"><use href="#i-chart" /></svg><svg class="i"><use href="#i-cart" /></svg>
                        <svg class="i"><use href="#i-box" /></svg><svg class="i"><use href="#i-factory" /></svg><svg class="i"><use href="#i-wallet" /></svg>
                        <svg class="i"><use href="#i-send" /></svg><svg class="i"><use href="#i-users" /></svg>
                    </aside>
                    <div class="mock-main">
                        <div class="mock-h">@C["hero.mock.title"]</div>
                        <div class="kpis">
                            <div class="kpi k1"><small>@C["hero.mock.kpi1"]</small><b data-live="sales" data-v="2847">2 847</b><span class="up">+12.4%</span></div>
                            <div class="kpi k2"><small>@C["hero.mock.kpi2"]</small><b data-live="profit" data-v="418">418</b><span class="up">+18.4%</span></div>
                            <div class="kpi k3"><small>@C["hero.mock.kpi3"]</small><b data-live="plan" data-v="92.6" data-dec="1">92.6</b><span class="pct">%</span></div>
                        </div>
                        <div class="mock-grid">
                            <div class="panel chart">
                                <small>@C["hero.mock.chart"]</small>
                                <svg viewBox="0 0 300 110" preserveAspectRatio="none" class="area">
                                    <defs>
                                        <linearGradient id="ga" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3b82f6" stop-opacity=".45" /><stop offset="1" stop-color="#3b82f6" stop-opacity="0" /></linearGradient>
                                        <linearGradient id="gb" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#22d3ee" stop-opacity=".3" /><stop offset="1" stop-color="#22d3ee" stop-opacity="0" /></linearGradient>
                                    </defs>
                                    <path class="a-fill" d="M0 88 C30 80 45 70 70 72 S120 52 150 54 S205 30 230 34 S280 14 300 12 L300 110 L0 110Z" fill="url(#ga)" />
                                    <path class="a-line" d="M0 88 C30 80 45 70 70 72 S120 52 150 54 S205 30 230 34 S280 14 300 12" />
                                    <path class="b-fill" d="M0 96 C35 92 50 86 75 88 S125 74 150 76 S200 62 230 64 S275 50 300 46 L300 110 L0 110Z" fill="url(#gb)" />
                                    <path class="b-line" d="M0 96 C35 92 50 86 75 88 S125 74 150 76 S200 62 230 64 S275 50 300 46" />
                                    <circle class="a-dot" cx="300" cy="12" r="4" />
                                </svg>
                            </div>
                            <div class="panel bars-p">
                                <small>@C["hero.mock.bars"]</small>
                                <div class="bars"><i class="b1"></i><i class="b2"></i><i class="b3"></i><i class="b4"></i><i class="b5"></i><i class="b6"></i></div>
                            </div>
                        </div>
                        <div class="panel feed">
                            <small>@C["hero.mock.feed"]</small>
                            <ul data-feed>
                                @foreach (var e in C.Strings("hero.mock.events").Take(3))
                                {
                                    <li>@e</li>
                                }
                            </ul>
                            <template data-feed-src>@string.Join("\n", C.Strings("hero.mock.events"))</template>
                        </div>
                    </div>
                </div>
            </div>
            <div class="float f1"><span class="fi"><svg class="i"><use href="#i-trending" /></svg></span><div><small>@C["hero.mock.float1"]</small><b>+18.4%</b></div></div>
            <div class="float f2"><span class="fi tg"><svg class="i"><use href="#i-send" /></svg></span><div><small>@C["hero.mock.float2"]</small><b>#1042 · 4.86 mln</b></div></div>
        </div>
    </div>

    <div class="wrap">
        <div class="stats">
            @foreach (var s in C.List("stats"))
            {
                <div class="stat"><b><span data-count="@s["value"]">@s["value"]</span>@s["suffix"]</b><span>@s["label"]</span></div>
            }
        </div>
    </div>
</section>

<!-- ═════════ AUDIENCE ═════════ -->
<section class="aud">
    <div class="wrap aud-in">
        <span class="aud-l">@C["audience.label"]</span>
        <div class="marquee"><div class="mq-track">
            @for (int rep = 0; rep < 2; rep++)
            {
                foreach (var a in C.Strings("audience.items"))
                {
                    <span class="mq-item"><svg class="i"><use href="#i-factory" /></svg>@a</span>
                }
            }
        </div></div>
    </div>
</section>

<!-- ═════════ PAINS ═════════ -->
<section class="sec" id="why">
    <div class="wrap">
        <div class="sec-h reveal">
            <span class="eyebrow">@C["pains.eyebrow"]</span>
            <h2>@C["pains.title"]</h2>
            <p>@C["pains.subtitle"]</p>
        </div>
        <div class="pains">
            @foreach (var p in C.List("pains.items"))
            {
                <article class="pain reveal">
                    <span class="ic"><svg class="i"><use href="#i-@p["icon"]" /></svg></span>
                    <h3>@p["title"]</h3>
                    <dl>
                        <div class="r-pain"><dt>@C["pains.painLabel"]</dt><dd>@p["pain"]</dd></div>
                        <div class="r-sol"><dt>@C["pains.solutionLabel"]</dt><dd>@p["solution"]</dd></div>
                        <div class="r-res"><dt>@C["pains.resultLabel"]</dt><dd>@p["result"]</dd></div>
                    </dl>
                </article>
            }
        </div>
    </div>
</section>

<!-- ═════════ MODULES ═════════ -->
<section class="sec sec-alt" id="modules">
    <div class="wrap">
        <div class="sec-h reveal">
            <span class="eyebrow">@C["modules.eyebrow"]</span>
            <h2>@C["modules.title"]</h2>
            <p>@C["modules.subtitle"]</p>
        </div>
        <div class="mods">
            @foreach (var m in C.List("modules.items"))
            {
                <article class="mod reveal @(m.Flag("isNew") ? "is-new" : "")">
                    <div class="mod-top">
                        <span class="ic"><svg class="i"><use href="#i-@m["icon"]" /></svg></span>
                        <span class="tag">@m["tag"]</span>
                        @if (m.Flag("isNew")) { <span class="new">@C["modules.newLabel"]</span> }
                    </div>
                    <h3>@m["name"]</h3>
                    <p>@m["desc"]</p>
                    <ul>
                        @foreach (var f in m.Strings("features"))
                        {
                            <li><svg class="i"><use href="#i-tick" /></svg>@f</li>
                        }
                    </ul>
                </article>
            }
        </div>
    </div>
</section>

<!-- ═════════ FLOW ═════════ -->
<section class="sec sec-dark flow-sec">
    <div class="wrap">
        <div class="sec-h reveal">
            <span class="eyebrow eyebrow-dark">@C["flow.eyebrow"]</span>
            <h2>@C["flow.title"]</h2>
            <p>@C["flow.subtitle"]</p>
        </div>
        <ol class="flow reveal" data-flow>
            @{ int fi = 0; }
            @foreach (var s in C.List("flow.steps"))
            {
                fi++;
                <li class="fstep">
                    <span class="fnum">0@(fi)</span>
                    <span class="ic"><svg class="i"><use href="#i-@s["icon"]" /></svg></span>
                    <b>@s["name"]</b>
                    <small>@s["desc"]</small>
                </li>
            }
        </ol>
    </div>
</section>

<!-- ═════════ SHOWCASE ═════════ -->
<section class="sec" id="product">
    <div class="wrap">
        <div class="sec-h reveal">
            <span class="eyebrow">@C["showcase.eyebrow"]</span>
            <h2>@C["showcase.title"]</h2>
            <p>@C["showcase.subtitle"]</p>
        </div>
        <div class="show reveal" data-show>
            <div class="show-tabs" role="tablist">
                @{ int ti = 0; }
                @foreach (var t in C.List("showcase.tabs"))
                {
                    <button type="button" role="tab" class="stab @(ti == 0 ? "on" : "")" data-tab="@ti" aria-selected="@(ti == 0 ? "true" : "false")">
                        <b>@t["name"]</b><small>@t["desc"]</small><i class="prog"></i>
                    </button>
                    ti++;
                }
            </div>
            <div class="show-view">
                <div class="browser">
                    <div class="mock-bar"><i></i><i></i><i></i><span>app.tahsinerp.uz</span></div>
                    <div class="shots">
                        @{ ti = 0; }
                        @foreach (var t in C.List("showcase.tabs"))
                        {
                            <img src="@Img(t["img"])" alt="tahsinERP — @t["name"]" loading="lazy" width="1600" height="900" class="@(ti == 0 ? "on" : "")" data-shot="@ti" />
                            ti++;
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═════════ DISTRIBUTION ═════════ -->
<section class="sec dist-sec" id="distribution">
    <div class="dist-bg" aria-hidden="true"><span class="orb o4"></span><span class="orb o5"></span></div>
    <div class="wrap dist">
        <div class="dist-copy reveal">
            <span class="eyebrow eyebrow-dark"><svg class="i"><use href="#i-spark" /></svg>@C["dist.eyebrow"]</span>
            <h2>@C["dist.title"]</h2>
            <p class="lead">@C["dist.subtitle"]</p>
            <div class="dfeats">
                @foreach (var f in C.List("dist.features"))
                {
                    <div class="dfeat"><span class="ic"><svg class="i"><use href="#i-@f["icon"]" /></svg></span><div><b>@f["title"]</b><small>@f["desc"]</small></div></div>
                }
            </div>
            <a class="btn btn-pri btn-lg" href="#demo">@C["nav.demo"]<svg class="i"><use href="#i-arrow" /></svg></a>
        </div>
        <div class="phone-wrap reveal" aria-hidden="true">
            <div class="phone" data-phone>
                <div class="ph-notch"></div>
                <div class="ph-head"><span class="ph-av">B</span><div><b>@C["dist.phone.bot"]</b><small>@C["dist.phone.status"]</small></div></div>
                <div class="ph-chat">
                    <div class="msg in m1">@C["dist.phone.greeting"]<span class="kb">@C["dist.phone.catalog"]</span></div>
                    <div class="mini m2">
                        <div class="mi-row"><span class="mi-img p1"></span><div><b>@C["dist.phone.item1"]</b><small>@C["dist.phone.price1"]</small></div><span class="mi-q">×40</span></div>
                        <div class="mi-row"><span class="mi-img p2"></span><div><b>@C["dist.phone.item2"]</b><small>@C["dist.phone.price2"]</small></div><span class="mi-q">×60</span></div>
                        <div class="mi-tot"><span>@C["dist.phone.total"]</span><b>4 860 000</b></div>
                        <span class="mi-btn">@C["dist.phone.checkout"]</span>
                    </div>
                    <div class="msg in m3">@C["dist.phone.order"]</div>
                </div>
            </div>
            <div class="float f3"><span class="fi"><svg class="i"><use href="#i-route" /></svg></span><div><small>KPI</small><b>14 / 14</b></div></div>
        </div>
    </div>
</section>

<!-- ═════════ WHY ═════════ -->
<section class="sec">
    <div class="wrap">
        <div class="sec-h reveal">
            <span class="eyebrow">@C["why.eyebrow"]</span>
            <h2>@C["why.title"]</h2>
        </div>
        <div class="whys">
            @foreach (var w in C.List("why.items"))
            {
                <div class="why reveal"><span class="ic"><svg class="i"><use href="#i-@w["icon"]" /></svg></span><h3>@w["title"]</h3><p>@w["desc"]</p></div>
            }
        </div>
    </div>
</section>

<!-- ═════════ COMPARE ═════════ -->
<section class="sec sec-alt">
    <div class="wrap">
        <div class="sec-h reveal">
            <span class="eyebrow">@C["compare.eyebrow"]</span>
            <h2>@C["compare.title"]</h2>
            <p>@C["compare.subtitle"]</p>
        </div>
        <div class="cmp-wrap reveal">
            <table class="cmp">
                <thead><tr><th>@C["compare.colFeature"]</th><th class="us">@C["compare.colUs"]</th><th>@C["compare.colA"]</th><th>@C["compare.colB"]</th><th>@C["compare.colC"]</th></tr></thead>
                <tbody>
                    @foreach (var r in C.List("compare.rows"))
                    {
                        var vals = r.Ints("v").ToList();
                        <tr>
                            <td>@r["name"]</td>
                            @for (int k = 0; k < vals.Count; k++)
                            {
                                <td class="@(k == 0 ? "us" : "")"><span class="yn @(vals[k] == 1 ? "y" : "n")"><svg class="i"><use href="#i-@(vals[k] == 1 ? "tick" : "x")" /></svg></span></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- ═════════ PROCESS ═════════ -->
<section class="sec" id="process">
    <div class="wrap">
        <div class="sec-h reveal">
            <span class="eyebrow">@C["process.eyebrow"]</span>
            <h2>@C["process.title"]</h2>
            <p>@C["process.subtitle"]</p>
        </div>
        <ol class="steps">
            @{ int si = 0; }
            @foreach (var s in C.List("process.steps"))
            {
                si++;
                <li class="step reveal"><span class="sn">@si</span><em>@s["when"]</em><h3>@s["title"]</h3><p>@s["desc"]</p></li>
            }
        </ol>
    </div>
</section>

<!-- ═════════ PLANS ═════════ -->
<section class="sec sec-alt" id="plans">
    <div class="wrap">
        <div class="sec-h reveal">
            <span class="eyebrow">@C["plans.eyebrow"]</span>
            <h2>@C["plans.title"]</h2>
            <p>@C["plans.subtitle"]</p>
        </div>
        <div class="plans">
            @foreach (var p in C.List("plans.items"))
            {
                <article class="plan reveal @(p.Flag("popular") ? "pop" : "")">
                    @if (p.Flag("popular")) { <span class="pop-b">@C["plans.popular"]</span> }
                    <span class="code">@p["code"]</span>
                    <h3>@p["name"]</h3>
                    <p class="for">@p["for"]</p>
                    <div class="users"><svg class="i"><use href="#i-users" /></svg><b>@p["users"]</b> @C["plans.usersLabel"]</div>
                    <ul>
                        @foreach (var m in p.Strings("modules"))
                        {
                            <li><svg class="i"><use href="#i-tick" /></svg>@m</li>
                        }
                    </ul>
                    <div class="price">@C["plans.priceLabel"]</div>
                    <a class="btn @(p.Flag("popular") ? "btn-pri" : "btn-out") btn-block" href="#demo" data-plan="@p["code"]">@C["plans.cta"]</a>
                </article>
            }
        </div>
        <p class="addon reveal"><svg class="i"><use href="#i-globe" /></svg>@C["plans.addon"]</p>
    </div>
</section>

<!-- ═════════ CTA BAND ═════════ -->
<section class="band">
    <div class="wrap band-in reveal">
        <div><h2>@C["cta.title"]</h2><p>@C["cta.subtitle"]</p></div>
        <a class="btn btn-white btn-lg" href="#demo">@C["cta.button"]<svg class="i"><use href="#i-arrow" /></svg></a>
    </div>
</section>

<!-- ═════════ FAQ ═════════ -->
<section class="sec" id="faq">
    <div class="wrap faq-wrap">
        <div class="sec-h sec-h-left reveal">
            <span class="eyebrow">@C["faq.eyebrow"]</span>
            <h2>@C["faq.title"]</h2>
            <p class="faq-contact"><a href="@IndexModel.PhoneHref"><svg class="i"><use href="#i-phone" /></svg>@IndexModel.Phone</a><a href="@IndexModel.Telegram" target="_blank" rel="noopener"><svg class="i"><use href="#i-tg" /></svg>Telegram</a></p>
        </div>
        <div class="faq">
            @{ int qi = 0; }
            @foreach (var f in C.List("faq.items"))
            {
                <details class="qa reveal" open="@(qi == 0 ? "open" : null)"><summary>@f["q"]<span class="pm"><svg class="i"><use href="#i-plus" /></svg></span></summary><p>@f["a"]</p></details>
                qi++;
            }
        </div>
    </div>
</section>

<!-- ═════════ DEMO ═════════ -->
<section class="sec demo-sec" id="demo">
    <div class="dist-bg" aria-hidden="true"><span class="orb o6"></span></div>
    <div class="wrap demo">
        <div class="demo-copy reveal">
            <span class="eyebrow eyebrow-dark">@C["demo.eyebrow"]</span>
            <h2>@C["demo.title"]</h2>
            <p class="lead">@C["demo.subtitle"]</p>
            <ol class="dsteps">
                @{ int di = 0; }
                @foreach (var s in C.List("demo.steps"))
                {
                    di++;
                    <li><span>@di</span><div><b>@s["title"]</b><small>@s["desc"]</small></div></li>
                }
            </ol>
            <div class="direct">
                <small>@C["demo.orCall"]</small>
                <a href="@IndexModel.PhoneHref"><svg class="i"><use href="#i-phone" /></svg>@IndexModel.Phone</a>
                <a href="@IndexModel.Telegram" target="_blank" rel="noopener"><svg class="i"><use href="#i-tg" /></svg>Telegram</a>
            </div>
        </div>

        <div class="form-card reveal">
            <div class="ok-box @(Model.DemoSent ? "show" : "")" data-ok>
                <span class="ok-ic"><svg class="i"><use href="#i-tick" /></svg></span>
                <h3 data-ok-title>@C["demo.okTitle"]</h3>
                <p data-ok-text>@C["demo.okText"]</p>
                <a class="btn btn-out" href="@IndexModel.PhoneHref"><svg class="i"><use href="#i-phone" /></svg>@IndexModel.Phone</a>
            </div>
            <form method="post" action="@(self)?handler=Demo" class="dform @(Model.DemoSent ? "hide" : "")" data-demo-form novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="Input.Plan" value="" data-plan-input />
                <div class="hp" aria-hidden="true"><label>Website <input type="text" name="Input.Website" tabindex="-1" autocomplete="off" /></label></div>
                <div class="f-row">
                    <label class="fld"><span>@C["demo.form.fullName"] *</span><input type="text" name="Input.FullName" value="@Model.Input.FullName" required maxlength="200" autocomplete="name" placeholder="@C["demo.form.fullNamePh"]" /></label>
                    <label class="fld"><span>@C["demo.form.company"] *</span><input type="text" name="Input.Company" value="@Model.Input.Company" required maxlength="300" autocomplete="organization" placeholder="@C["demo.form.companyPh"]" /></label>
                </div>
                <div class="f-row">
                    <label class="fld"><span>@C["demo.form.phone"] *</span><input type="tel" name="Input.Phone" value="@Model.Input.Phone" required maxlength="50" autocomplete="tel" inputmode="tel" placeholder="@C["demo.form.phonePh"]" data-phone-input /></label>
                    <label class="fld"><span>@C["demo.form.email"]</span><input type="email" name="Input.Email" value="@Model.Input.Email" maxlength="200" autocomplete="email" placeholder="@C["demo.form.emailPh"]" /></label>
                </div>
                <div class="f-row">
                    <label class="fld"><span>@C["demo.form.industry"]</span>
                        <select name="Input.Industry">
                            <option value="">@C["demo.form.choose"]</option>
                            @foreach (var code in tahsinERP.ControlPanel.Services.DemoRequestService.Industries)
                            {
                                <option value="@code" selected="@(Model.Input.Industry == code ? "selected" : null)">@C["demo.form.industries." + code]</option>
                            }
                        </select></label>
                    <label class="fld"><span>@C["demo.form.size"]</span>
                        <select name="Input.CompanySize">
                            <option value="">@C["demo.form.choose"]</option>
                            @foreach (var sz in tahsinERP.ControlPanel.Services.DemoRequestService.Sizes)
                            {
                                <option value="@sz" selected="@(Model.Input.CompanySize == sz ? "selected" : null)">@sz</option>
                            }
                        </select></label>
                </div>
                <fieldset class="fld chips">
                    <legend>@C["demo.form.modules"]</legend>
                    @foreach (var code in tahsinERP.ControlPanel.Services.DemoRequestService.ModuleCodes)
                    {
                        <label class="chip"><input type="checkbox" name="Input.Modules" value="@code" checked="@(Model.Input.Modules.Contains(code) ? "checked" : null)" /><span>@C["demo.form.moduleNames." + code]</span></label>
                    }
                </fieldset>
                <label class="fld"><span>@C["demo.form.message"]</span><textarea name="Input.Message" rows="3" maxlength="2000" placeholder="@C["demo.form.messagePh"]">@Model.Input.Message</textarea></label>
                <div class="f-err @(Model.DemoError is null ? "" : "show")" data-err role="alert">@Model.DemoError</div>
                <button type="submit" class="btn btn-pri btn-lg btn-block" data-submit data-sending="@C["demo.form.sending"]">@C["demo.form.submit"]<svg class="i"><use href="#i-arrow" /></svg></button>
                <p class="consent">@C["demo.form.consent"]</p>
                <template data-msgs data-required="@C["demo.errRequired"]" data-phone="@C["demo.errPhone"]" data-email="@C["demo.errEmail"]" data-generic="@C["demo.errGeneric"]"></template>
            </form>
        </div>
    </div>
</section>
</main>

<footer class="ftr">
    <div class="wrap ftr-in">
        <div class="ftr-about">
            <a class="brand" href="@self"><img src="/img/logo.png" alt="" width="36" height="36" /><span>tahsin<b>ERP</b></span></a>
            <p>@C["footer.about"]</p>
            <a class="schain" href="@IndexModel.SchainUrl" target="_blank" rel="noopener"><img src="/landing/img/schain-logo.webp" alt="SCHAIN" width="132" height="28" /></a>
        </div>
        <div>
            <h4>@C["footer.product"]</h4>
            <a href="#modules">@C["nav.modules"]</a>
            <a href="#distribution">@C["nav.distribution"]</a>
            <a href="#plans">@C["nav.pricing"]</a>
            <a href="#faq">@C["nav.faq"]</a>
        </div>
        <div>
            <h4>@C["footer.company"]</h4>
            <a href="@IndexModel.SchainUrl" target="_blank" rel="noopener">@C["footer.schain"]</a>
            <a href="@Model.PortalUrl">@C["footer.portal"]</a>
            <a href="@IndexModel.TelegramChannel" target="_blank" rel="noopener">Telegram: @@schainuz</a>
        </div>
        <div>
            <h4>@C["footer.contacts"]</h4>
            <a href="@IndexModel.PhoneHref"><svg class="i"><use href="#i-phone" /></svg>@IndexModel.Phone</a>
            <a href="@IndexModel.Telegram" target="_blank" rel="noopener"><svg class="i"><use href="#i-tg" /></svg>Telegram</a>
            <span class="muted">@C["footer.address"]</span>
        </div>
    </div>
    <div class="wrap ftr-bot">
        <span>© @DateTime.UtcNow.Year tahsinERP · SCHAIN. @C["footer.rights"]</span>
        <div class="langs langs-ftr">
            @foreach (var l in LandingContent.Languages)
            {
                <a href="@IndexModel.PathFor(l)" class="@(l == Model.Lang ? "on" : "")" hreflang="@l">@LandingContent.For(l)["langName"]</a>
            }
        </div>
    </div>
</footer>

<a class="sticky-cta" href="#demo" data-sticky>@C["nav.demo"]<svg class="i"><use href="#i-arrow" /></svg></a>

<script src="~/landing/landing.js" asp-append-version="true"></script>
</body>
</html>
