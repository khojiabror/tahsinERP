@page
@model tahsinERP.ControlPanel.Pages.Bank.IndexModel
@{ ViewData["Title"] = L.T("Pnl_Bank_Title"); }
<h1>@L.T("Pnl_Bank_Title")</h1>
<div asp-validation-summary="All"></div>
<form method="post" enctype="multipart/form-data" class="card stack">
    <div><label asp-for="Upload">@L.T("Pnl_File")</label><input asp-for="Upload" type="file" accept=".txt,.csv,.xlsx" /></div>
    <div class="hint">
        @L.T("Pnl_Bank_HelpFormat") (<code>1CClientBankExchange</code>, .txt) @L.T("Pnl_Bank_HelpColumns")
        <code>TE-YYYY-NNNNNN</code> @L.T("Pnl_Bank_HelpMatch")
        @L.T("Pnl_Bank_HelpDuplicate")
    </div>
    <div><button type="submit">@L.T("Pnl_Bank_UploadAndMatch")</button></div>
</form>
<table>
    <tr><th>#</th><th>@L.T("Pnl_File")</th><th>@L.T("Pnl_Format")</th><th>@L.T("Period")</th><th>@L.T("Pnl_Bank_UploadedUtc")</th><th class="num">@L.T("Pnl_Bank_Lines")</th><th class="num">@L.T("Pnl_Bank_ReadyToApply")</th><th class="num">@L.T("Pnl_Bank_AppliedCol")</th><th class="num">@L.T("Amount")</th></tr>
    @foreach (var r in Model.Rows)
    {
        <tr>
            <td><a href="/Bank/Details/@r.Import.Id">#@r.Import.Id</a></td>
            <td>@r.Import.FileName</td><td>@r.Import.Format</td>
            <td>@r.Import.DateFrom?.ToString("dd.MM.yyyy") — @r.Import.DateTo?.ToString("dd.MM.yyyy")</td>
            <td>@r.Import.UploadedAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
            <td class="num">@r.Lines</td><td class="num">@r.Matched</td><td class="num">@r.Applied</td><td class="num">@Money.Format(r.AppliedTiyin)</td>
        </tr>
    }
</table>
<partial name="_Pager" model="Model.Pager" />
@if (Model.Rows.Count == 0) { <div class="empty">@L.T("Pnl_Bank_Empty")</div> }
