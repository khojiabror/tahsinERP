@page
@model tahsinERP.ControlPanel.Pages.Staff.CreateModel
@{ ViewData["Title"] = "Yangi xodim"; }
<h1>Yangi xodim</h1>
<form method="post" class="stack card">
    <div asp-validation-summary="All"></div>
    <div class="row">
        <div><label asp-for="Email">Email</label><input asp-for="Email" type="email" /></div>
        <div><label asp-for="FullName">Ism familiya</label><input asp-for="FullName" type="text" /></div>
    </div>
    <div class="row">
        <div><label asp-for="Role">Rol</label>
            <select asp-for="Role">@foreach (var r in Enum.GetValues<StaffRole>()) { <option value="@r">@Labels.Of(r)</option> }</select></div>
        <div><label asp-for="Password">Vaqtinchalik parol</label><input asp-for="Password" autocomplete="new-password" /><div class="hint">Kamida 12 belgi, harf va raqam.</div></div>
    </div>
    <div class="actions"><button type="submit">Qo'shish</button><a class="btn secondary" href="/Staff">Bekor</a></div>
</form>
