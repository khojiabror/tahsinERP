@page "{id:int}"
@model tahsinERP.ControlPanel.Pages.Staff.EditModel
@{ ViewData["Title"] = L.T("Pnl_Staff_Title", Model.Staff.Email); }
<h1>@L.T("Pnl_Staff_Title", Model.Staff.Email)</h1>
<div asp-validation-summary="All"></div>
<form method="post" action="@Url.Page(null)" asp-antiforgery="true" class="stack card">
    <div><label asp-for="Role">@L.T("Pnl_Role")</label>
        <select asp-for="Role">@foreach (var r in Enum.GetValues<StaffRole>()) { <option value="@r">@Labels.Of(r)</option> }</select></div>
    <label class="check"><input asp-for="IsActive" /> @L.T("Active")</label>
    <div><button type="submit">@L.T("Save")</button></div>
</form>
<form method="post" asp-page-handler="Password" class="stack card">
    <div><label asp-for="NewPassword">@L.T("Pnl_Staff_NewTempPassword")</label><input asp-for="NewPassword" autocomplete="new-password" /></div>
    <div><button type="submit" class="secondary">@L.T("Pnl_Staff_ResetPasswordUnlock")</button></div>
</form>
<form method="post" asp-page-handler="ResetTotp" class="card">
    <p>2FA: @(Model.Staff.TotpSecretProtected is null ? L.T("Pnl_NotConnected") : L.T("Pnl_Connected")). @L.T("Pnl_Staff_ResetTotpHint")</p>
    <button type="submit" class="danger">@L.T("Pnl_Staff_ResetTotp")</button>
</form>
<p><a href="/Staff">← @L.T("Pnl_NavStaff")</a></p>
