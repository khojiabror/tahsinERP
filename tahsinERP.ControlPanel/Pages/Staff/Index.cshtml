@page
@model tahsinERP.ControlPanel.Pages.Staff.IndexModel
@{ ViewData["Title"] = L.T("Pnl_NavStaff"); }
<h1>@L.T("Pnl_NavStaff")</h1>
<div class="actions"><a class="btn" href="/Staff/Create">+ @L.T("Pnl_Staff_Add")</a></div>
<p class="hint">@L.T("Pnl_Staff_RolesHint")</p>
<table>
    <tr><th>Email</th><th>@L.T("Pnl_FirstName")</th><th>@L.T("Pnl_Role")</th><th>2FA</th><th>@L.T("Status")</th><th>@L.T("Pnl_LastLoginUtc")</th><th></th></tr>
    @foreach (var s in Model.Rows)
    {
        <tr>
            <td>@s.Email</td><td>@s.FullName</td><td>@Labels.Of(s.Role)</td>
            <td>@(s.TotpSecretProtected is null ? L.T("Pnl_NotConnected") : L.T("Pnl_Connected"))</td>
            <td>@(s.IsActive ? (s.LockedUntilUtc > DateTime.UtcNow ? L.T("Pnl_Locked") : L.T("Pnl_ActiveLower")) : L.T("Pnl_DisabledLower"))</td>
            <td>@s.LastLoginUtc?.ToString("dd.MM.yyyy HH:mm")</td>
            <td><a href="/Staff/Edit/@s.Id">@L.T("Pnl_Manage")</a></td>
        </tr>
    }
</table>
