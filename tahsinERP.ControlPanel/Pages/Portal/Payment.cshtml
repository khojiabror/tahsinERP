@page
@model PaymentModel
@{ ViewData["Title"] = L.T("Ptl_NavPayment"); var v = Model.Vendor; }
<h1>@L.T("Ptl_NavPayment")</h1>
@if (!Model.VendorReady)
{
    <div class="warnbox">@L.T("Ptl_VendorNotReady")</div>
}
else
{
    <div class="card">
        <dl class="props">
            <dt>@L.T("Ptl_Recipient")</dt><dd><strong>@v.LegalName</strong></dd>
            <dt>@L.T("Ptl_Inn")</dt><dd>@v.Inn</dd>
            @if (!string.IsNullOrEmpty(v.VatCode)) { <dt>@L.T("Ptl_VatCode")</dt><dd>@v.VatCode</dd> }
            <dt>@L.T("Ptl_Bank")</dt><dd>@v.BankName</dd>
            <dt>@L.T("Ptl_Account")</dt><dd><span class="mono" id="acc">@v.BankAccount</span> <button type="button" class="link" data-copy="acc" data-copied="@(L.T("Ptl_Copied") + " ✓")">@L.T("Ptl_CopyLower")</button></dd>
            <dt>@L.T("Ptl_Mfo")</dt><dd>@v.Mfo</dd>
            @if (!string.IsNullOrEmpty(v.Address)) { <dt>@L.T("Address")</dt><dd>@v.Address</dd> }
            @if (!string.IsNullOrEmpty(v.Phone)) { <dt>@L.T("Phone")</dt><dd>@v.Phone</dd> }
        </dl>
    </div>
}
<h2>@L.T("Ptl_HowToPay")</h2>
<div class="card">
    <ol>
        <li>@L.T("Ptl_PayStep1")</li>
        <li><strong>@L.T("Ptl_PayStep2")</strong> (@L.T("Ptl_ForExample") <code>TE-2026-000123</code>) — @L.T("Ptl_PayStep2Tail")</li>
        <li>@L.T("Ptl_PayStep3")</li>
        <li>@L.T("Ptl_PayStep4")</li>
    </ol>
</div>
@if (Model.Unpaid.Count > 0)
{
    <h2>@L.T("Ptl_UnpaidInvoices")</h2>
    @foreach (var i in Model.Unpaid)
    {
        <div class="card">
            <strong>@i.Number</strong> — @L.T("Ptl_BalanceLower") <strong>@Money.FormatSom(i.RemainingTiyin)</strong>, @L.T("Ptl_DueLower") @i.DueDate.ToString("dd.MM.yyyy")
            <div class="spaced">
                <label for="purpose-@i.Id">@L.T("Ptl_PaymentPurposeLabel")</label>
                <textarea id="purpose-@i.Id" readonly rows="2">@PortalPageModel.PaymentPurpose(i)</textarea>
                <div class="actions spaced">
                    <button type="button" class="secondary" data-copy="purpose-@i.Id" data-copied="@(L.T("Ptl_Copied") + " ✓")">@L.T("Ptl_Copy")</button>
                    <a class="btn secondary" href="/Invoices?handler=Pdf&amp;id=@i.Id">PDF</a>
                </div>
            </div>
        </div>
    }
}
