@page
@model LoginModel
@{ ViewData["Title"] = L.T("Login"); }
<div class="card login">
    <div class="hud-head"><span>@L.T("Pnl_Auth2_SecureLogin")</span><span>AUTH-01</span></div>
    <h1>@L.T("Ptl_LoginHeading")</h1>
    <p class="hud-sub">@L.T("Ptl_LoginSub")</p>
    <ol class="steps"><li class="on">@L.T("Password")</li><li>@L.T("Code")</li><li>@L.T("Ptl_Crumb")</li></ol>
    <form method="post" class="stack">
        <div asp-validation-summary="All"></div>
        <div>
            <label asp-for="Login">@L.T("Ptl_EmailOrPhone")</label>
            <div class="field-ic"><svg class="i"><use href="#i-user" /></svg><input asp-for="Login" type="text" autocomplete="username" placeholder="@L.T("Ptl_LoginPlaceholder")" autofocus /></div>
        </div>
        <div>
            <label asp-for="Password">@L.T("Password")</label>
            <div class="field-ic"><svg class="i"><use href="#i-lock" /></svg><input asp-for="Password" autocomplete="current-password" placeholder="••••••••••••" /></div>
        </div>
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit">@L.T("Ptl_Continue") <svg class="i"><use href="#i-arrow" /></svg></button>
        <p class="hint">@L.T("Ptl_LoginHint")</p>
    </form>
    <div class="auth-meta"><span>@L.T("Pnl_Auth2_SessionEncrypted")</span><span><a href="/Forgot">@L.T("Ptl_ForgotLink")</a></span></div>
</div>
