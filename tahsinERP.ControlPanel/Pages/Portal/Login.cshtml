@page
@model LoginModel
@{ ViewData["Title"] = "Kirish"; }
<div class="card login">
    <div class="hud-head"><span>// MIJOZ IDENTIFIKATSIYASI</span><span>AUTH-01</span></div>
    <h1>Mijoz kabinetiga kirish</h1>
    <p class="hud-sub">Hisob-fakturalar, to'lovlar va litsenziya — bir joyda.</p>
    <ol class="steps"><li class="on">Parol</li><li>Kod</li><li>Kabinet</li></ol>
    <form method="post" class="stack">
        <div asp-validation-summary="All"></div>
        <div>
            <label asp-for="Login">Email yoki telefon</label>
            <div class="field-ic"><svg class="i"><use href="#i-user" /></svg><input asp-for="Login" type="text" autocomplete="username" placeholder="email yoki +998…" autofocus /></div>
        </div>
        <div>
            <label asp-for="Password">Parol</label>
            <div class="field-ic"><svg class="i"><use href="#i-lock" /></svg><input asp-for="Password" autocomplete="current-password" placeholder="••••••••••••" /></div>
        </div>
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit">Davom etish <svg class="i"><use href="#i-arrow" /></svg></button>
        <p class="hint">Keyingi qadam — bir martalik kod (Telegram, yoki profilda tanlangan SMS / email).</p>
    </form>
    <div class="auth-meta"><span>SEANS: SHIFRLANGAN</span><span><a href="/Forgot">Parolni unutdingizmi?</a></span></div>
</div>
