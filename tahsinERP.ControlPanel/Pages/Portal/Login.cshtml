@page
@model LoginModel
@{ ViewData["Title"] = "Kirish"; }
<div class="card login">
    <h1>Mijoz kabinetiga kirish</h1>
    <form method="post" class="stack">
        <div asp-validation-summary="All"></div>
        <div><label asp-for="Login">Email yoki telefon</label><input asp-for="Login" type="text" autocomplete="username" autofocus /></div>
        <div><label asp-for="Password">Parol</label><input asp-for="Password" autocomplete="current-password" /></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit">Davom etish</button>
        <p class="hint">Keyingi qadam — bir martalik kod (Telegram, yoki profilda tanlangan SMS / email). <a href="/Forgot">Parolni unutdingizmi?</a></p>
    </form>
</div>
