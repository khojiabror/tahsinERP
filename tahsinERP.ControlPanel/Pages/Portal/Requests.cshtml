@page
@model RequestsModel
@{ ViewData["Title"] = L.T("Ptl_NavRequests"); var cur = Model.Overview.Current; }
<h1>@L.T("Ptl_RequestsHeading")</h1>
<p class="hint">
    @L.T("Ptl_CurrentPlan") <strong>@(cur?.Plan?.Name ?? L.T("Ptl_None"))</strong>@if (cur is not null) { <text>, @L.T("Ptl_UntilDate", cur.EndDate.ToString("dd.MM.yyyy"))</text> }.
    @L.T("Ptl_RequestsHint")
</p>
<div asp-validation-summary="ModelOnly"></div>
@if (Model.IsPortalOwner)
{
    <form method="post" action="@Url.Page(null)" asp-antiforgery="true" class="card stack">
        <div>
            <label>@L.T("Ptl_Plan")</label>
            <div class="plans">
                @foreach (var p in Model.Plans)
                {
                    <label class="plan">
                        <input type="radio" name="PlanId" value="@p.Id" checked="@(p.Id == Model.PlanId)" />
                        <strong>@p.Name</strong>
                        @L.T("Ptl_UpToUsers", p.MaxUsers)<br />
                        @L.T("Ptl_PerMonth") @(p.PriceMonthTiyin is long m ? Money.FormatSom(m) : L.T("Ptl_Negotiable"))<br />
                        @L.T("Ptl_PerYear") @(p.PriceYearTiyin is long y ? Money.FormatSom(y) : L.T("Ptl_Negotiable"))<br />
                        <span class="hint">@Model.Explain(p, Model.Period)</span>
                    </label>
                }
            </div>
        </div>
        <div class="row">
            <div><label asp-for="Period">@L.T("Period")</label>
                <select asp-for="Period"><option value="Month">@L.T("Ptl_Monthly")</option><option value="Year">@L.T("Ptl_Yearly")</option></select></div>
            <div><label asp-for="PeriodCount">@L.T("Ptl_PeriodCount")</label><input asp-for="PeriodCount" type="number" min="1" max="12" /></div>
        </div>
        <div><label asp-for="Comment">@L.T("Comment") (@L.T("Optional"))</label><textarea asp-for="Comment" maxlength="1000"></textarea></div>
        <div><button type="submit">@L.T("Ptl_SendRequest")</button></div>
    </form>
}
else
{
    <div class="warnbox">@L.T("Ptl_RequestOwnerOnly")</div>
}
<h2>@L.T("Ptl_RequestHistory")</h2>
@if (Model.Rows.Count == 0)
{
    <p class="empty">@L.T("Ptl_NoRequests")</p>
}
else
{
    <div class="scroll"><table>
        <tr><th>#</th><th>@L.T("Date")</th><th>@L.T("Ptl_Request")</th><th>@L.T("Status")</th><th>@L.T("Ptl_CommentResult")</th><th></th></tr>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.CreatedAtUtc.ToString("dd.MM.yyyy")</td>
                <td>«@r.Plan?.Name», @r.PeriodCount @PortalRequestService.PeriodUnit(r.Period) — @PortalRequestService.KindText(r.Kind)<br /><span class="hint">@L.T("Ptl_FromDate", r.EffectiveDate.ToString("dd.MM.yyyy"))</span></td>
                <td><span class="badge @PortalPageModel.Badge(r.Status)">@PortalPageModel.Of(r.Status)</span></td>
                <td>@r.DecisionReason @if (r.InvoiceId is int iid) { if (Model.InvoiceNumbers.TryGetValue(iid, out var num)) { <a href="/Invoices">@num</a> } else { <span class="hint">@L.T("Ptl_InvoicePreparing")</span> } }</td>
                <td>@if (r.Status == PortalRequestStatus.Pending && Model.IsPortalOwner)
                    {
                        <form method="post" asp-page-handler="Cancel" class="inline"><input type="hidden" name="RequestId" value="@r.Id" /><button type="submit" class="link">@L.T("Ptl_CancelLower")</button></form>
                    }</td>
            </tr>
        }
    </table></div>
}
