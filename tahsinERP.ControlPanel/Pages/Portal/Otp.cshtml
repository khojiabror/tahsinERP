@page
@model OtpModel
@{ ViewData["Title"] = "Tasdiqlash kodi"; }
<div class="card login">
    <div class="hud-head"><span>// IKKINCHI OMIL</span><span>AUTH-02</span></div>
    <h1>Tasdiqlash kodi</h1>
    <p class="hud-sub">Kod yuborildi: <strong>@Model.Destination</strong></p>
    <ol class="steps"><li class="done">Parol</li><li class="on">Kod</li><li>Kabinet</li></ol>
    <form method="post" action="@Url.Page(null)" asp-antiforgery="true" class="stack">
        <div asp-validation-summary="All"></div>
        <div>
            <label asp-for="Code">6 xonali kod</label>
            <input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7" placeholder="000000" autofocus />
        </div>
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit">Kirish <svg class="i"><use href="#i-arrow" /></svg></button>
    </form>
    <form method="post" asp-page-handler="Resend" class="stack spaced">
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit" class="secondary">Kodni qayta yuborish</button>
    </form>
    <div class="auth-meta"><span>BIR MARTALIK KOD</span><span><a href="/Login">← Boshqa hisob</a></span></div>
</div>
