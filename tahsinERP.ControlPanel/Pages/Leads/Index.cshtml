@page
@model tahsinERP.ControlPanel.Pages.Leads.IndexModel
@inject Clock Clock
@{ ViewData["Title"] = "Demo so'rovlar"; }
<h1>Demo so'rovlar (tahsinerp.uz)</h1>
<div class="toolbar">
    <a class="btn @(Model.All ? "secondary" : "")" href="/Leads">Navbat (yangi va bog'lanilgan)</a>
    <a class="btn @(Model.All ? "" : "secondary")" href="/Leads?all=true">Hammasi</a>
</div>
<p class="hint">Mijozga qo'ng'iroq qiling, ehtiyojini aniqlang va «Sinov ochish» — forma so'rovdan to'ldiriladi, 14 kunlik demo baza namuna ma'lumotlar bilan yaratiladi. Kirish ma'lumotlarini mijozga o'zingiz yetkazasiz.</p>
@if (Model.Rows.Count == 0)
{
    <p class="empty">So'rov yo'q.</p>
}
else
{
    <table>
        <tr><th>#</th><th>Sana</th><th>Kompaniya</th><th>Aloqa</th><th>Ehtiyoj</th><th>Holat</th><th>Amal</th></tr>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.Id</td>
                <td>@Clock.ToLocal(r.CreatedAtUtc).ToString("dd.MM.yyyy HH:mm")<div class="hint">@r.Lang.ToUpperInvariant()</div></td>
                <td><b>@r.Company</b>@if (r.Industry is not null) { <div class="hint">@tahsinERP.ControlPanel.Pages.Leads.IndexModel.Industry(r.Industry)@(r.CompanySize is null ? "" : ", " + r.CompanySize + " xodim")</div> }</td>
                <td>@r.FullName<div><a href="tel:@r.Phone">@r.Phone</a></div>@if (r.Email is not null) { <div class="hint">@r.Email</div> }</td>
                <td>
                    @if (r.Plan is not null) { <span class="badge info">@r.Plan</span> }
                    @if (r.Modules is not null) { <div class="hint">@r.Modules</div> }
                    @if (r.Message is not null) { <div>@r.Message</div> }
                    @if (r.StaffNote is not null) { <div class="hint">Izoh: @r.StaffNote</div> }
                </td>
                <td><span class="badge @tahsinERP.ControlPanel.Pages.Leads.IndexModel.Badge(r.Status)">@tahsinERP.ControlPanel.Pages.Leads.IndexModel.Of(r.Status)</span>
                    @if (r.HandledByStaffId is int sid) { <div class="hint">@Model.StaffNames.GetValueOrDefault(sid)</div> }</td>
                <td>
                    @if (r.Status == DemoRequestStatus.TrialOpened && r.TenantId is int tid)
                    {
                        <a href="/Tenants/Details/@tid">@Model.Tenants.GetValueOrDefault(tid, "#" + tid)</a>
                    }
                    else if (Model.CanSell && r.Status != DemoRequestStatus.Rejected)
                    {
                        <a class="btn" href="/Tenants/Trial?demo=@r.Id">Sinov ochish</a>
                        <form method="post" class="inline"><input type="hidden" name="RequestId" value="@r.Id" />
                            <input type="text" name="Note" placeholder="Izoh (ixtiyoriy)" />
                            @if (r.Status == DemoRequestStatus.New) { <button type="submit" class="secondary" asp-page-handler="Contacted">Bog'lanildi</button> }
                            <button type="submit" class="secondary" asp-page-handler="Reject">Yopish</button></form>
                    }
                </td>
            </tr>
        }
    </table>
}
