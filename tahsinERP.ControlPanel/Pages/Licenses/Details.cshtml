@page "{id:int}"
@model tahsinERP.ControlPanel.Pages.Licenses.DetailsModel
@{ var l = Model.License; ViewData["Title"] = L.T("Pnl_Lic_KeyNo", l.Id); }
<h1>@L.T("Pnl_Lic_KeyNo", l.Id) — @l.Tenant!.LegalName</h1>
<div asp-validation-summary="All"></div>
<div class="card">
    <dl class="props">
        <dt>@L.T("Status")</dt><dd>@(l.RevokedAtUtc != null ? L.T("Pnl_Lic_RevokedInfo", l.RevokedAtUtc.Value.ToString("dd.MM.yyyy"), Model.StaffNames.GetValueOrDefault(l.RevokedByStaffId ?? 0), l.RevokeReason) : l.SupersededById != null ? L.T("Pnl_Lic_SupersededBy", l.SupersededById) : L.T("Pnl_Lic_Current"))</dd>
        <dt>@L.T("Pnl_Lic_EditionUsers")</dt><dd>@l.Edition / @l.MaxUsers</dd>
        <dt>@L.T("Pnl_Due")</dt><dd>@l.StartDate.ToString("dd.MM.yyyy") – @l.ExpiryDate.ToString("dd.MM.yyyy")</dd>
        <dt>InstallationId</dt><dd><code>@l.InstallationId</code></dd>
        <dt>CompanyID</dt><dd>@l.CompanyId</dd>
        <dt>@L.T("Pnl_Lic_SigningKey")</dt><dd>@l.KeyId</dd>
        <dt>@L.T("Pnl_Source")</dt><dd>@Labels.Of(l.Source) @(l.IssuedByStaffId is int s ? Model.StaffNames.GetValueOrDefault(s) : "") · @l.IssuedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC</dd>
        <dt>@L.T("Pnl_Reason")</dt><dd>@l.Reason</dd>
        <dt>ETag</dt><dd><code>@l.ETag</code></dd>
    </dl>
</div>
<h2>@L.T("Pnl_Lic_KeyText")</h2>
<div class="secret mono">@l.LicenseKey</div>
<p><a class="btn secondary" href="/Licenses/Details/@l.Id?handler=Download">@L.T("Pnl_Lic_DownloadLic")</a>
   <a class="btn secondary" href="/Tenants/Details/@l.TenantId">← @L.T("Pnl_ToOrganization")</a></p>
@if (Model.IsOwner && l.RevokedAtUtc == null)
{
    <h2>@L.T("Cancel")</h2>
    <form method="post" asp-page-handler="Revoke" class="stack card">
        <div><label asp-for="Reason">@L.T("Pnl_ReasonMandatory")</label><input asp-for="Reason" type="text" /></div>
        <div><label asp-for="ReplacementExpiry">@L.T("Pnl_Lic_ReplacementExpiry")</label><input asp-for="ReplacementExpiry" type="date" /></div>
        <div class="hint">@L.T("Pnl_Lic_RevokeHint")</div>
        <div><button type="submit" class="danger">@L.T("Cancel")</button></div>
    </form>
}
