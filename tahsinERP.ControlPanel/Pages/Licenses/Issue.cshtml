@page
@model tahsinERP.ControlPanel.Pages.Licenses.IssueModel
@{ ViewData["Title"] = L.T("Pnl_Lic_ManualIssue"); }
<h1>@L.T("Pnl_Lic_ManualIssue"): @Model.Tenant.LegalName</h1>
@if (Model.Tenant.InstallationId is null)
{
    <div class="flash bad">@L.T("Pnl_Lic_NotBound")</div>
}
<form method="post" class="stack card">
    <div asp-validation-summary="All"></div>
    <input type="hidden" asp-for="TenantId" />
    <div class="row">
        <div><label asp-for="Edition">@L.T("Pnl_Lic_PackageEdition")</label>
            <select asp-for="Edition">@foreach (var p in Model.Packages) { <option value="@p.Code">@p.Code — @p.Name</option> }</select></div>
        <div><label asp-for="MaxUsers">@L.T("Pnl_Lic_UsersUnlimited")</label><input asp-for="MaxUsers" type="number" min="0" /></div>
    </div>
    @if (Model.AddOnPlans.Any())
    {
        <div><label>@L.T("Pnl_AddOnServices")</label>
            @foreach (var p in Model.AddOnPlans)
            {
                <label class="check"><input type="checkbox" name="AddOnCodes" value="@p.Code" checked="@Model.AddOnCodes.Contains(p.Code)" /> @p.Name (<code>+@p.Code</code>)</label>
            }
            <div class="hint">@L.T("Pnl_Lic_EditionHint1") <code>KORP+SITE</code>. @L.T("Pnl_Lic_EditionHint2")</div>
        </div>
    }
    <div class="row">
        <div><label asp-for="StartDate">@L.T("Pnl_Start")</label><input asp-for="StartDate" type="date" /></div>
        <div><label asp-for="ExpiryDate">@L.T("Pnl_End")</label><input asp-for="ExpiryDate" type="date" /></div>
    </div>
    <div><label asp-for="Reason">@L.T("Pnl_Reason")</label><input asp-for="Reason" type="text" placeholder="@L.T("Pnl_Lic_ReasonPlaceholder")" /></div>
    <div class="hint">InstallationId: <code>@Model.Tenant.InstallationId</code>, CompanyID: @Model.Tenant.CompanyId. @L.T("Pnl_Lic_OnPremHint")</div>
    <div class="actions"><button type="submit">@L.T("Pnl_Lic_SignAndIssue")</button><a class="btn secondary" href="/Tenants/Details/@Model.TenantId">@L.T("Pnl_CancelShort")</a></div>
</form>
