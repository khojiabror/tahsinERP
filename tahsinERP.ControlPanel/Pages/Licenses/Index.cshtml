@page
@model tahsinERP.ControlPanel.Pages.Licenses.IndexModel
@{ ViewData["Title"] = "Litsenziya kalitlari"; }
<h1>Litsenziya kalitlari</h1>
<form method="get" class="toolbar">
    @if (Model.TenantId is not null) { <input type="hidden" name="TenantId" value="@Model.TenantId" /> }
    <label class="check"><input type="checkbox" name="OnlyCurrent" value="true" checked="@Model.OnlyCurrent" /> Faqat joriy (faol)</label>
    <button type="submit" class="secondary">Ko'rsatish</button>
</form>
<p class="hint">Kalitlar o'chirilmaydi: yangi kalit eskisini «almashtirilgan» qiladi, bekor qilish sabab bilan yoziladi. Qo'lda chiqarish — tashkilot sahifasidan (faqat Owner).</p>
<table>
    <tr><th>#</th><th>Tashkilot</th><th>Edition</th><th class="num">Foyd.</th><th>Muddat</th><th>Imzo</th><th>Manba</th><th>Chiqarilgan</th><th>Holat</th></tr>
    @foreach (var l in Model.Rows)
    {
        <tr>
            <td><a href="/Licenses/Details/@l.Id">@l.Id</a></td>
            <td><a href="/Tenants/Details/@l.TenantId">@l.Tenant!.LegalName</a></td>
            <td>@l.Edition</td><td class="num">@l.MaxUsers</td>
            <td>@l.StartDate.ToString("dd.MM.yyyy") – @l.ExpiryDate.ToString("dd.MM.yyyy")</td>
            <td>@l.KeyId</td><td>@Labels.Of(l.Source)</td><td>@l.IssuedAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
            <td>@if (l.RevokedAtUtc != null) { <span class="badge bad">bekor</span> } else if (l.SupersededById != null) { <span class="badge muted">almashtirilgan</span> } else { <span class="badge ok">joriy</span> }</td>
        </tr>
    }
</table>
@if (Model.Rows.Count == 0) { <div class="empty">Kalit yo'q.</div> }
