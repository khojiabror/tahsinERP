@page
@model tahsinERP.ControlPanel.Pages.Traction.IndexModel
@using tahsinERP.ControlPanel.Services
@{
    ViewData["Title"] = L.T("Pnl_NavTraction");
    var r = Model.R;
    var o = r.Overview;
    string Pct(double v) => (v * 100).ToString("0.#") + "%";
    string SortLink(string key, string text) => $"<a href=\"{Model.Query(key)}\">{text}{(Model.Sort == key ? " ▾" : "")}</a>";
}
<h1>@L.T("Pnl_NavTraction")</h1>
<p class="hint">@L.T("Period"): @r.Filter.From.ToString("dd.MM.yyyy") – @r.Filter.To.ToString("dd.MM.yyyy") (@L.T("Pnl_Tr_PeriodHint", r.Filter.Days)). @L.T("Pnl_Tr_DemoExcluded") @L.T("Pnl_Tr_Defs") Docs/ControlPanel/07_TRACTION.md.</p>
<form method="get" class="actions">
    @foreach (var d in new[] { 7, 30, 90 })
    {
        <a class="btn @(Model.From == null && Model.To == null && Model.Days == d ? "" : "secondary")" href="?Days=@d&Plan=@Model.Plan&Status=@Model.Status">@L.T("Pnl_DaysCount", d)</a>
    }
    <input type="date" name="From" value="@Model.From?.ToString("yyyy-MM-dd")" />
    <input type="date" name="To" value="@Model.To?.ToString("yyyy-MM-dd")" />
    <select name="Plan"><option value="">— @L.T("Pnl_PackageLower") —</option>@foreach (var p in new[] { "START", "BIZNES", "KORP", "TRIAL", "SITE" }) { <option value="@p" selected="@(Model.Plan == p)">@p</option> }</select>
    <select name="Status"><option value="">— @L.T("Pnl_StatusLower") —</option>@foreach (var s in Enum.GetValues<TenantStatus>()) { <option value="@s" selected="@(Model.Status == s)">@Labels.Of(s)</option> }</select>
    <input type="hidden" name="Days" value="@Model.Days" />
    <button type="submit" class="secondary">@L.T("Apply")</button>
</form>

<h2>@L.T("Pnl_Tr_Overview")</h2>
<div class="tiles">
    <div class="tile"><div class="tile-v">@o.ActiveTenants <small>/ @o.TotalTenants</small></div><div class="tile-l">@L.T("Pnl_Dash_ActiveTenants")</div></div>
    <div class="tile"><div class="tile-v">@o.Dau</div><div class="tile-l">@L.T("Pnl_Tr_DauAvg")</div></div>
    <div class="tile"><div class="tile-v">@o.Wau</div><div class="tile-l">WAU</div></div>
    <div class="tile"><div class="tile-v">@o.Mau</div><div class="tile-l">MAU</div></div>
    <div class="tile"><div class="tile-v">@Pct(o.Stickiness)</div><div class="tile-l">Stickiness (DAU/MAU)</div></div>
    <div class="tile"><div class="tile-v">@Pct(o.Conversion) <small>@o.TrialsConverted/@o.TrialsStarted</small></div><div class="tile-l">@L.T("Pnl_Tr_TrialToPaid")</div></div>
    <div class="tile"><div class="tile-v">@Money.Format(o.MrrTiyin)</div><div class="tile-l">@L.T("Pnl_Tr_MrrSom")</div></div>
    <div class="tile"><div class="tile-v">@Money.Format(o.AddOnMrrTiyin) <small>@L.T("Pnl_Tr_TenantsN", o.AddOnTenants)</small></div><div class="tile-l">@L.T("Pnl_Tr_OfWhichAddOns")</div></div>
    <div class="tile"><div class="tile-v">@Money.Format(o.RevenueTiyin)</div><div class="tile-l">@L.T("Pnl_Tr_PeriodRevenue")</div></div>
    <div class="tile"><div class="tile-v">@Pct(o.ChurnRate) <small>@o.Churned/@o.PayingAtStart</small></div><div class="tile-l">Churn</div></div>
    <div class="tile"><div class="tile-v">@o.DocsTotal</div><div class="tile-l">@L.T("Pnl_Tr_MainDocs")</div></div>
</div>
<div class="cols">
    <div class="card"><h3>@L.T("Pnl_Act_Daily")</h3><canvas id="chart-active" height="160"></canvas></div>
    <div class="card"><h3>@L.T("Pnl_Tr_ModuleActionsDaily")</h3><canvas id="chart-modules" height="160"></canvas></div>
</div>

<h2>@L.T("Pnl_Modules") <a class="hint" href="@Model.Query(csv: "modules")">CSV</a></h2>
<table>
    <tr><th>@L.T("Pnl_Module")</th><th class="num">@L.T("Pnl_Tenants")</th><th class="num">@L.T("Actions")</th><th class="num">@L.T("Pnl_Tr_PrevPeriod")</th><th class="num">Trend</th><th class="num">@L.T("Pnl_Tr_UnusedInPackage")</th></tr>
    @foreach (var m in r.Modules)
    {
        <tr><td>@m.Name</td><td class="num">@m.Tenants</td><td class="num">@m.Actions</td><td class="num">@m.PrevActions</td>
            <td class="num">@(m.TrendPct is double tp ? (tp > 0 ? "+" : "") + tp.ToString("0.#") + "%" : L.T("Pnl_NewLower"))</td>
            <td class="num">@if (m.UnusedInPackage > 0) { <span class="badge warn">@L.T("Pnl_Tr_TenantsN", m.UnusedInPackage)</span> }</td></tr>
    }
</table>
<p class="hint">@L.T("Pnl_Tr_UnusedHint")</p>

<div class="cols">
    <div>
        <h2>@L.T("Pnl_Tr_TopActions") <a class="hint" href="@Model.Query(csv: "pages")">CSV</a></h2>
        <table>
            <tr><th>@L.T("Pnl_Tr_PageController")</th><th>@L.T("Pnl_Module")</th><th>@L.T("Pnl_Audit_Action")</th><th class="num">@L.T("Pnl_Tr_Count")</th><th class="num">@L.T("Pnl_Tr_Tenant")</th></tr>
            @foreach (var p in r.Pages.Take(25))
            {
                <tr><td>@p.Controller @if (!p.Mapped) { <span class="badge muted" title="@L.T("Pnl_Tr_NotInEditionMap")">@L.T("Pnl_Tr_NotInMap")</span> }</td><td>@TractionService.ModuleLabel(p.Module)</td><td>@p.ActionType</td><td class="num">@p.Actions</td><td class="num">@p.Tenants</td></tr>
            }
        </table>
        <div class="hint">@L.T("Pnl_Tr_ActionTypes") @string.Join(", ", r.ActionTypes.OrderByDescending(x => x.Value).Select(x => $"{x.Key} {x.Value}")). @L.T("Pnl_Tr_ActionTypesHint")</div>
    </div>
    <div>
        <h2>@L.T("Pnl_Tr_BusinessVolume")</h2>
        <table>
            <tr><th>@L.T("Pnl_Document")</th><th class="num">@L.T("Pnl_Tr_Count")</th><th class="num">@L.T("Pnl_Tr_Tenant")</th></tr>
            @foreach (var d in r.Docs) { <tr><td>@TractionService.DocLabel(d.DocType)</td><td class="num">@d.Count</td><td class="num">@d.Tenants</td></tr> }
        </table>
        <h2>@L.T("Pnl_Tr_Funnel")</h2>
        <canvas id="chart-funnel" height="140" data-label="@L.T("Pnl_Tenants")"></canvas>
        <table>
            @{ int first = Math.Max(1, r.Funnel.FirstOrDefault()?.Count ?? 1); }
            @foreach (var s in r.Funnel) { <tr><td>@s.Name</td><td class="num">@s.Count</td><td class="num">@((100.0 * s.Count / first).ToString("0"))%</td></tr> }
        </table>
    </div>
</div>

<h2>@L.T("Pnl_Tenants") <a class="hint" href="@Model.Query(csv: "tenants")">CSV</a></h2>
<table>
    <tr>
        <th>@Html.Raw(SortLink("name", Html.Encode(L.T("Pnl_Organization"))))</th><th>@L.T("Status")</th><th>@L.T("Pnl_Package")</th><th class="num">@Html.Raw(SortLink("mrr", "MRR"))</th>
        <th>@Html.Raw(SortLink("last", Html.Encode(L.T("Pnl_LastLogin"))))</th><th class="num">@L.T("Pnl_Tr_UsersLimit")</th><th class="num">@L.T("Pnl_Modules")</th>
        <th class="num">@Html.Raw(SortLink("actions", Html.Encode(L.T("Actions"))))</th><th class="num">Trend</th><th class="num">@L.T("Pnl_Document")</th><th class="num">@Html.Raw(SortLink("score", Html.Encode(L.T("Pnl_Tr_Score"))))</th><th>@L.T("Pnl_Tr_Risk")</th>
    </tr>
    @foreach (var t in Model.Rows)
    {
        <tr>
            <td><a href="/Tenants/Activity/@t.Tenant.Id">@t.Tenant.LegalName</a> <code>@t.Tenant.Slug</code></td>
            <td><span class="badge @Labels.Badge(t.Tenant.Status)">@Labels.Of(t.Tenant.Status)</span></td>
            <td>@t.Plan</td><td class="num">@Money.Format(t.MrrTiyin)</td>
            <td>@(t.LastLoginUtc?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
            <td class="num">@t.ActiveUsers / @t.SeatLimit</td>
            <td class="num" title="@L.T("Pnl_Tr_Unused") @string.Join(", ", t.UnusedModules)">@t.ModulesUsed / @t.ModulesAllowed</td>
            <td class="num">@t.Actions</td>
            <td class="num">@(t.PrevActions == 0 ? (t.Actions > 0 ? L.T("Pnl_NewLower") : "—") : ((100.0 * (t.Actions - t.PrevActions) / t.PrevActions).ToString("+0;-0") + "%"))</td>
            <td class="num">@t.Docs</td>
            <td class="num"><strong>@t.Score</strong></td>
            <td><span class="badge @(t.Risk == "Yuqori" ? "bad" : t.Risk == "O'rta" ? "warn" : "ok")">@(t.Risk == "Yuqori" ? L.T("Pnl_Risk_High") : t.Risk == "O'rta" ? L.T("Pnl_Risk_Medium") : L.T("Pnl_Risk_Low"))</span></td>
        </tr>
    }
</table>
@if (Model.Rows.Count == 0) { <div class="empty">@L.T("Pnl_Tr_NoTenants")</div> }

<h2>@L.T("Pnl_Tr_Cohorts") <a class="hint" href="@Model.Query(csv: "cohorts")">CSV</a></h2>
<p class="hint">@L.T("Pnl_Tr_CohortHint")</p>
<table class="cohort">
    <tr><th>@L.T("Pnl_Month")</th><th class="num">@L.T("Pnl_Tr_Tenant")</th>@for (int w = 0; w < 12; w++) { <th class="num">H@(w)</th> }</tr>
    @foreach (var c in r.Cohorts)
    {
        <tr><td>@c.Month</td><td class="num">@c.Size</td>
            @foreach (var v in c.Weeks)
            {
                <td class="num heat-@(v is null ? "na" : ((int)(v.Value / 25)).ToString())">@(v is null ? "" : v.Value.ToString("0") + "%")</td>
            }
        </tr>
    }
</table>

<script type="application/json" id="traction-data">@Html.Raw(Model.ChartJson)</script>
<script src="~/lib/chartjs/chart.umd.js"></script>
<script src="~/js/traction.js" asp-append-version="true"></script>
