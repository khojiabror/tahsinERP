@page
@model tahsinERP.ControlPanel.Pages.Servers.IndexModel
@{ ViewData["Title"] = L.T("Pnl_NavServers"); }
<h1>@L.T("Pnl_Srv_Title")</h1>
<div class="actions"><a class="btn" href="/Servers/Edit">+ @L.T("Pnl_Srv_Add")</a></div>
<p class="hint">@Html.Raw(L.T("Pnl_Auth2_SrvBackupHint", "<code>Install-Backup.ps1</code>"))</p>
<p class="hint">@L.T("Pnl_Srv_Hint")</p>
<table>
    <tr><th>@L.T("Name")</th><th>Host</th><th>@L.T("Pnl_Region")</th><th>SQL instance</th><th class="num">@L.T("Pnl_Tenants")</th><th>@L.T("Status")</th><th>@L.T("Pnl_Auth2_LastBackup")</th><th></th></tr>
    @foreach (var r in Model.Rows)
    {
        <tr>
            <td>@r.Server.Name</td><td>@r.Server.Host</td><td>@r.Server.Region</td><td><code>@r.Server.SqlInstance</code></td>
            <td class="num">@r.Tenants / @r.Server.MaxTenants</td><td>@(r.Server.IsActive ? L.T("Pnl_ActiveLower") : L.T("Pnl_DisabledLower"))</td>
            <td><partial name="_BackupCell" model="r.Backup" /></td>
            <td><a href="/Servers/Edit/@r.Server.Id">@L.T("Edit")</a></td>
        </tr>
    }
</table>
@if (Model.Rows.Count == 0)
{
    <div class="empty">@L.T("Pnl_Srv_Empty")</div>
}
