@page "{id:int?}"
@model tahsinERP.ControlPanel.Pages.Servers.EditModel
@{ ViewData["Title"] = Model.IsNew ? "Yangi server" : "Server"; }
<h1>@ViewData["Title"]</h1>
<form method="post" action="@Url.Page(null)" asp-antiforgery="true" class="stack card">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="row">
        <div><label asp-for="Name">Nomi</label><input asp-for="Name" /><span asp-validation-for="Name"></span></div>
        <div><label asp-for="Region">Hudud</label><input asp-for="Region" placeholder="ap-south-1" /></div>
    </div>
    <div class="row">
        <div><label asp-for="Host">ERP host (DNS/IP)</label><input asp-for="Host" /><span asp-validation-for="Host"></span></div>
        <div><label asp-for="SqlInstance">SQL instance</label><input asp-for="SqlInstance" placeholder="localhost\SQLEXPRESS" /><span asp-validation-for="SqlInstance"></span></div>
    </div>
    <div><label asp-for="MaxTenants">Ko'pi bilan tenant</label><input asp-for="MaxTenants" type="number" /></div>
    <div><label asp-for="Notes">Izoh</label><textarea asp-for="Notes"></textarea></div>
    <label class="check"><input asp-for="IsActive" /> Faol (yangi tenantlar joylashtirilishi mumkin)</label>
    <div class="actions"><button type="submit">Saqlash</button><a class="btn secondary" href="/Servers">Bekor</a></div>
</form>
@if (!Model.IsNew && Model.Existing is not null)
{
    <h2>Provisioning agenti</h2>
    <div class="card stack">
        <dl class="props">
            <dt>Server ID</dt><dd><code>@Model.Existing.Id</code> (agent sozlamasi <code>Panel:ServerId</code>)</dd>
            <dt>Kalit</dt><dd>@(Model.Existing.AgentSecretProtected is null ? "chiqarilmagan" : "bor")</dd>
            <dt>Oxirgi aloqa (UTC)</dt><dd>@Model.Existing.AgentLastSeenUtc?.ToString("dd.MM.yyyy HH:mm:ss") @Model.Existing.AgentVersion</dd>
        </dl>
        @if (Model.NewAgentSecret is not null)
        {
            <div class="secret">
                <strong>Agent siri (faqat hozir ko'rinadi):</strong>
                <div class="mono">@Model.NewAgentSecret</div>
                <div class="hint">ERP serverida: <code>setx /M TAHSIN_AGENT_Panel__Secret "&lt;siri&gt;"</code> yoki xizmat env'i, so'ng agentni qayta ishga tushiring (05_PROVISIONING.md).</div>
            </div>
        }
        <form method="post" asp-page-handler="AgentSecret" asp-route-id="@Model.Existing.Id" class="inline">
            <button type="submit" class="secondary">@(Model.Existing.AgentSecretProtected is null ? "Agent kalitini chiqarish" : "Agent kalitini almashtirish (eskisi bekor bo'ladi)")</button>
        </form>
    </div>
}
