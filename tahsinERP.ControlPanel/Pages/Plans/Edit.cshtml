@page "{id:int}"
@model tahsinERP.ControlPanel.Pages.Plans.EditModel
@{ ViewData["Title"] = L.T("Pnl_Plan_Title", Model.Plan.Code); }
<h1>@L.T("Pnl_Plan_Label") <code>@Model.Plan.Code</code></h1>
<form method="post" class="stack card">
    <div asp-validation-summary="ModelOnly"></div>
    <div><label asp-for="Name">@L.T("Name")</label><input asp-for="Name" /><span asp-validation-for="Name"></span></div>
    <div class="row">
        <div><label asp-for="PriceMonth">@L.T("Pnl_Plan_PriceMonth")</label><input asp-for="PriceMonth" type="text" placeholder="@L.T("Pnl_NotSet")" /><span asp-validation-for="PriceMonth"></span></div>
        <div><label asp-for="PriceYear">@L.T("Pnl_Plan_PriceYear")</label><input asp-for="PriceYear" type="text" placeholder="@L.T("Pnl_NotSet")" /><span asp-validation-for="PriceYear"></span></div>
    </div>
    <div class="row">
        @if (Model.Plan.IsAddOn)
        {
            <div><label>@L.T("Pnl_Plan_UserLimit")</label><div class="hint">@L.T("Pnl_Plan_AddOnNoUsers")</div></div>
        }
        else
        {
            <div><label asp-for="MaxUsers">@L.T("Pnl_Plan_UserLimit")</label><input asp-for="MaxUsers" type="number" /><span asp-validation-for="MaxUsers"></span></div>
        }
        <div><label asp-for="VatRatePercent">@L.T("Pnl_Plan_VatRate")</label><input asp-for="VatRatePercent" type="number" step="0.01" /><span asp-validation-for="VatRatePercent"></span></div>
    </div>
    <div>
        <label asp-for="Modules">@L.T("Pnl_Plan_Modules")</label><input asp-for="Modules" />
        <div class="hint">Srm, Crm, Tasks, Mes, Engineering, Finance, Hr, Logistics, Docs, Distribution; @L.T("Pnl_Plan_ModulesHint")</div>
    </div>
    @if (Model.Plan.Code == PlanCodes.Trial)
    {
        <div><label asp-for="TrialDays">@L.T("Pnl_Plan_TrialDays")</label><input asp-for="TrialDays" type="number" /></div>
    }
    <label class="check"><input asp-for="IsActive" /> @L.T("Pnl_Plan_ActiveHint")</label>
    <div class="actions"><button type="submit">@L.T("Save")</button><a class="btn secondary" href="/Plans">@L.T("Pnl_CancelShort")</a></div>
</form>
