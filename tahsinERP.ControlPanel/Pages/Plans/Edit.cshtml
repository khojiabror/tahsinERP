@page "{id:int}"
@model tahsinERP.ControlPanel.Pages.Plans.EditModel
@{ ViewData["Title"] = "Tarif: " + Model.Plan.Code; }
<h1>Tarif: <code>@Model.Plan.Code</code></h1>
<form method="post" class="stack card">
    <div asp-validation-summary="ModelOnly"></div>
    <div><label asp-for="Name">Nomi</label><input asp-for="Name" /><span asp-validation-for="Name"></span></div>
    <div class="row">
        <div><label asp-for="PriceMonth">Oylik narx, so'm (QQS bilan)</label><input asp-for="PriceMonth" type="text" placeholder="belgilanmagan" /><span asp-validation-for="PriceMonth"></span></div>
        <div><label asp-for="PriceYear">Yillik narx, so'm (QQS bilan)</label><input asp-for="PriceYear" type="text" placeholder="belgilanmagan" /><span asp-validation-for="PriceYear"></span></div>
    </div>
    <div class="row">
        @if (Model.Plan.IsAddOn)
        {
            <div><label>Foydalanuvchilar chegarasi</label><div class="hint">Qo'shimcha xizmat — foydalanuvchiga bog'liq emas (paket chegarasi amal qiladi).</div></div>
        }
        else
        {
            <div><label asp-for="MaxUsers">Foydalanuvchilar chegarasi</label><input asp-for="MaxUsers" type="number" /><span asp-validation-for="MaxUsers"></span></div>
        }
        <div><label asp-for="VatRatePercent">QQS stavkasi, %</label><input asp-for="VatRatePercent" type="number" step="0.01" /><span asp-validation-for="VatRatePercent"></span></div>
    </div>
    <div>
        <label asp-for="Modules">Modullar (ERP ProductModule nomlari, vergul bilan)</label><input asp-for="Modules" />
        <div class="hint">Srm, Crm, Tasks, Mes, Engineering, Finance, Hr, Logistics, Docs, Distribution; qo'shimcha xizmat: Website. Ma'lumot uchun — ERP cheklovni Edition bo'yicha qiladi.</div>
    </div>
    @if (Model.Plan.Code == PlanCodes.Trial)
    {
        <div><label asp-for="TrialDays">Sinov muddati, kun</label><input asp-for="TrialDays" type="number" /></div>
    }
    <label class="check"><input asp-for="IsActive" /> Faol (yangi obunalarda tanlash mumkin)</label>
    <div class="actions"><button type="submit">Saqlash</button><a class="btn secondary" href="/Plans">Bekor</a></div>
</form>
