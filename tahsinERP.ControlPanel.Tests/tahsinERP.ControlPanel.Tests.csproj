<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- ERP fayli (C# 7.3, nullable'siz) ulangan -->
    <NoWarn>$(NoWarn);CS8632;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ERP'ning HAQIQIY License API klienti (tahsinERP/Services/LicenseSync) — panel unga mos kelishi integratsion testda
      shu fayl orqali isbotlanadi. Fayl faqat HttpClient + Newtonsoft.Json ishlatadi.
    -->
    <Compile Include="..\tahsinERP\Services\LicenseSync\LicensePanelClient.cs" Link="Erp\LicensePanelClient.cs" />
    <!-- ERP'ning HAQIQIY tenant reestri — agent yozgan tenants.json ni ERP qanday o'qishi shu bilan tekshiriladi -->
    <Compile Include="..\tahsinERP\Configuration\Tenancy\TenantRegistry.cs" Link="Erp\TenantRegistry.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\tahsinERP.ControlPanel\tahsinERP.ControlPanel.csproj" />
    <!-- Provisioning agenti: unit + panel bilan integratsion testlar (ProvisioningTests.cs) -->
    <ProjectReference Include="..\tahsinERP.ProvisioningAgent\tahsinERP.ProvisioningAgent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
