        <Function Name="sp_Fin_AddTransaction" Aggregate="false" BuiltIn="false" NiladicFunction="false" IsComposable="false" ParameterTypeSemantics="AllowImplicitConversion" Schema="dbo">
          <Parameter Name="TxnDate" Type="date" Mode="In" />
          <Parameter Name="AccountID" Type="int" Mode="In" />
          <Parameter Name="CategoryID" Type="int" Mode="In" />
          <Parameter Name="Direction" Type="tinyint" Mode="In" />
