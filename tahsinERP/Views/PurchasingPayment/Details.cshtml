@model tahsinERP.Models.PURCHASING_CONTRACT_PAYMENTS
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item ">
                                        <a href="~/PurchasingPayment">Harid to'lovlari</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Harid to'lovi ma'lumotlari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <!-- app invoice View Page -->
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <!-- invoice view page -->
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                <h4 class="text-primary">Harid to'lovi ma'lumotlari</h4>
                                                <hr />
                                                <span>Ta'minotchi:<b> @Html.DisplayFor(model => model.Supplier, new { @class = "form-control" })</b></span>
                                                <br />
                                                <span>Miqdori:<b> @Html.DisplayFor(model => model.Payment_Amount, new { @class = "form-control" }) @Model.Currency</b></span>
                                                <hr />
                                                <span>Izoh:<b> @Html.DisplayFor(model => model.Comment, new { @class = "form-control" })</b></span>
                                                <br />
                                                <section>
                                                    <div>
                                                        <h6 class="text-primary">Shartnoma ma'lumotlari</h6>
                                                        <span>Shartnoma raqami: <b>@Html.DisplayFor(model => model.PURCHASING_CONTRACTS.ContractNo, new { @class = "form-control" })</b></span>
                                                        <br />
                                                        <span>Shartnoma sanasi:<b> @Html.DisplayFor(model => model.PURCHASING_CONTRACTS.IssueDT, new { @class = "form-control" })</b></span>
                                                        <br />
                                                    </div>
                                                </section>
                                            </div>
                                        </div>
                                        <hr>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}