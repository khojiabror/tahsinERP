@model tahsinERP.ViewModels.POrder.POrderEditViewModel
@using System.Collections.Generic
@using System.Web.Mvc
@{
    ViewBag.Title = "Buyurtmani tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isDirectOrder = ViewBag.IsDirectOrder as bool? ?? false;
    // Buyurtmaga haqiqatda qo'llangan QQS stavkasini ko'rsatamiz (shartnoma stavkasi emas).
    var initialVatRate = ViewBag.AppliedVatRate != null
        ? (double)ViewBag.AppliedVatRate
        : (ViewBag.ContractVatRate != null ? (double)ViewBag.ContractVatRate : 0d);

    var purchasableProductsData = new List<object>();
    var unitsData = new List<object>();

    if (ViewBag.PurchasableProductsList != null)
    {
        var ppSl = new SelectList(ViewBag.PurchasableProductsList, "ID", "PNo");
        foreach (SelectListItem item in ppSl)
        {
            purchasableProductsData.Add(new { Value = item.Value, Text = item.Text });
        }
    }

    if (ViewBag.UnitsList != null)
    {
        var uSl = new SelectList(ViewBag.UnitsList, "ID", "ShortName");
        foreach (SelectListItem item in uSl)
        {
            unitsData.Add(new { Value = item.Value, Text = item.Text });
        }
    }
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "POrders"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/POrders/Index">Xarid buyurtmalari</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Tahrirlash
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Edit", "POrders", FormMethod.Post, new { @class = "form", @id = "orderForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(model => model.ID)
                                            @Html.ValidationSummary(false, "", new { @class = "text-danger mb-2" })

                                            <!-- Order Header -->
                                            <div class="row">
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="OrderNo">Buyurtma raqami</label>
                                                    @Html.TextBoxFor(model => model.OrderNo, new { @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.OrderNo, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="IssuedDate">Sana</label>
                                                    @Html.TextBoxFor(model => model.IssuedDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.IssuedDate, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="CompanyID">Korxona</label>
                                                    @Html.DropDownListFor(model => model.CompanyID, ViewBag.Companies as SelectList, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.CompanyID, "", new { @class = "text-danger" })
                                                </div>
                                                @if (!isDirectOrder)
                                                {
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label for="SupplierID">Ta'minotchi</label>
                                                        @Html.DropDownListFor(model => model.SupplierID, ViewBag.Suppliers as SelectList, "---Tanlang---", new { @class = "form-control select2", @id = "supplierSelect" })
                                                        @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label for="ContractID">Shartnoma</label>
                                                        @Html.DropDownListFor(model => model.ContractID, ViewBag.Contracts as SelectList, "---Tanlang---", new { @class = "form-control select2", @id = "contractSelect" })
                                                        @Html.ValidationMessageFor(model => model.ContractID, "", new { @class = "text-danger" })
                                                    </div>
                                                }
                                                else
                                                {
                                                    @Html.HiddenFor(model => model.SupplierID)
                                                    @Html.HiddenFor(model => model.ContractID)
                                                }
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="CurrencyID">Valyuta</label>
                                                    @Html.DropDownListFor(model => model.CurrencyID, ViewBag.Currencies as SelectList, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="vatRateInput">QQS %</label>
                                                    <input type="number" id="vatRateInput" name="VatRate" class="form-control" value="@initialVatRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" step="0.01" min="0" max="100" />
                                                </div>
                                                <div class="col-md-12 col-12 form-group">
                                                    <label for="Description">Izoh</label>
                                                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = "2", @placeholder = "Qisqacha izoh" })
                                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <br />
                                            <h5>Buyurtma mahsulotlari</h5>
                                            
                                            <!-- Editable Products Table -->
                                            <div class="table-responsive">
                                                <table id="orderProductsTable" class="table table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>Mahsulot kodi</th>
                                                            <th>Mahsulot nomi</th>
                                                            <th>Miqdor</th>
                                                            <th>Birlik</th>
                                                            <th>Narx</th>
                                                            <th>Jami</th>
                                                            <th>MOQ</th>
                                                            <th style="min-width: 16rem;">Hisob tushuntirishi</th>
                                                            <th>Amallar</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (Model.OrderProducts != null)
                                                        {
                                                            for (int i = 0; i < Model.OrderProducts.Count; i++)
                                                            {
                                                                var product = Model.OrderProducts[i];
                                                                <tr data-row-index="@i">
                                                                    <td>
                                                                        @Html.DropDownListFor(m => m.OrderProducts[i].ProductID, new SelectList(ViewBag.PurchasableProductsList, "ID", "PNo", product.ProductID), "---Tanlang---", new { @class = "form-control product-select", @required = "required" })
                                                                        @Html.HiddenFor(m => m.OrderProducts[i].ID)
                                                                        @Html.HiddenFor(m => m.OrderProducts[i].ProductPNo, new { @class = "product-pno" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.OrderProducts[i].ProductName, new { @class = "form-control product-name", @readonly = "readonly" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.OrderProducts[i].Amount, new { @type = "number", @class = "form-control amount-input", @step = "0.01", @min = "0", @required = "required" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.DropDownListFor(m => m.OrderProducts[i].UnitID, new SelectList(ViewBag.UnitsList, "ID", "ShortName", product.UnitID), "---Tanlang---", new { @class = "form-control unit-select", @required = "required" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.OrderProducts[i].Price, new { @type = "number", @class = "form-control price-input", @step = "0.01", @min = "0", @required = "required" })
                                                                        <small class="text-muted d-block mt-1">QQS bilan: <span class="price-with-vat">0.00</span></small>
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.OrderProducts[i].TotalPrice, new { @type = "number", @class = "form-control total-price", @readonly = "readonly" })
                                                                        <small class="text-muted d-block mt-1">QQS bilan jami: <span class="line-total-with-vat">0.00</span></small>
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.OrderProducts[i].MOQ, new { @type = "number", @class = "form-control moq-input", @step = "0.01", @min = "0" })
                                                                    </td>
                                                                    <td class="align-top small">
                                                                        @(string.IsNullOrWhiteSpace(product.CalculationExplanation) ? "—" : product.CalculationExplanation)
                                                                        @Html.HiddenFor(m => m.OrderProducts[i].CalculationExplanation)
                                                                        @Html.HiddenFor(m => m.OrderProducts[i].CalculationSummary)
                                                                    </td>
                                                                    <td>
                                                                        <button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="5" class="text-right"><strong>Jami:</strong></td>
                                                            <td id="totalAmount" class="text-right"><strong>0.00</strong></td>
                                                            <td colspan="3"></td>
                                                        </tr>
                                                        <tr>
                                                            <td colspan="5" class="text-right"><strong>Jami (QQS bilan):</strong></td>
                                                            <td id="totalAmountWithVat" class="text-right"><strong>0.00</strong></td>
                                                            <td colspan="3"></td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>

                                            <div class="row mt-2">
                                                <div class="col-12">
                                                    <button type="button" class="btn btn-outline-primary" id="addRowBtn">
                                                        <i class="bx bx-plus"></i> Qo'shish
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-12">
                                                    <button type="submit" class="btn btn-success">
                                                        <i class="bx bx-save"></i> Saqlash
                                                    </button>
                                                    <a href="@Url.Action("Index", "POrders")" class="btn btn-secondary">
                                                        <i class="bx bx-x"></i> Bekor qilish
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        (function () {
            function initEditPOrderScripts() {
                // jQuery va Select2 yuklanmaguncha kutamiz — aks holda ready ichidagi kod (Qo'shish tugmasi,
                // QQS hisoblari) xatolik tufayli umuman bog'lanmay qolardi.
                if (typeof jQuery === 'undefined' || typeof jQuery.fn.select2 === 'undefined') {
                    setTimeout(initEditPOrderScripts, 100);
                    return;
                }

                var $ = jQuery;

                $(document).ready(function () {
                    if (typeof $.fn.select2 !== 'undefined') {
                        $('.select2').select2();
                    }

            var productRowIndex = @(Model.OrderProducts?.Count ?? 0);
            var purchasableProducts = @Html.Raw(Json.Encode(purchasableProductsData ?? new List<object>()));
            var units = @Html.Raw(Json.Encode(unitsData ?? new List<object>()));
            var $vatRateInput = $('#vatRateInput');
            var selectedContractId = '@(Model.ContractID.HasValue ? Model.ContractID.Value.ToString() : "")';
            var isDirectOrder = @(isDirectOrder ? "true" : "false");

            function getVatRate() {
                var vatRate = parseFloat($vatRateInput.val());
                return isNaN(vatRate) || vatRate < 0 ? 0 : vatRate;
            }

            function toVatAmount(baseAmount) {
                return baseAmount * (1 + (getVatRate() / 100));
            }

            function updateRowDisplayWithVat($row, amount, price) {
                $row.find('.price-with-vat').text(toVatAmount(price).toFixed(2));
                $row.find('.line-total-with-vat').text(toVatAmount(amount * price).toFixed(2));
            }

            function loadContractsBySupplier(supplierId, selectedId) {
                var $contractSelect = $('#contractSelect');
                $contractSelect.empty().append('<option value="">---Tanlang---</option>');

                if (!supplierId) {
                    if (typeof $.fn.select2 !== 'undefined') {
                        $contractSelect.select2();
                    }
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetContractsBySupplier", "POrders")',
                    type: 'POST',
                    data: { supplierId: supplierId },
                    success: function (response) {
                        if (response && response.success && response.data && Array.isArray(response.data)) {
                            response.data.forEach(function (contract) {
                                var $option = $('<option>')
                                    .attr('value', contract.ID)
                                    .attr('data-vat-rate', contract.VatRate != null ? contract.VatRate : 0)
                                    .text(contract.ContractNo);
                                if (selectedId && String(contract.ID) === String(selectedId)) {
                                    $option.attr('selected', 'selected');
                                }
                                $contractSelect.append($option);
                            });
                        }

                        if (typeof $.fn.select2 !== 'undefined') {
                            $contractSelect.select2();
                        }
                        $contractSelect.trigger('change');
                    }
                });
            }

            // Calculate totals for existing rows
            $('.amount-input, .price-input').each(function () {
                var $row = $(this).closest('tr');
                var amount = parseFloat($row.find('.amount-input').val()) || 0;
                var price = parseFloat($row.find('.price-input').val()) || 0;
                var total = amount * price;
                $row.find('.total-price').val(total.toFixed(2));
                updateRowDisplayWithVat($row, amount, price);
            });
            updateTotal();
            if (!isDirectOrder && $('#supplierSelect').length > 0) {
                loadContractsBySupplier($('#supplierSelect').val(), selectedContractId);
            }

            // Add new row manually (delegated — har doim ishlashi uchun)
            $(document).on('click', '#addRowBtn', function () {
                addProductRow(null, '', '', 0, null, null, null, '', '');
            });

            if (!isDirectOrder && $('#supplierSelect').length > 0) {
                $('#supplierSelect').on('change', function () {
                    loadContractsBySupplier($(this).val(), null);
                });
            }

            if (!isDirectOrder && $('#contractSelect').length > 0) {
                $('#contractSelect').on('change', function () {
                    var selected = $(this).find('option:selected');
                    var vatRate = parseFloat(selected.attr('data-vat-rate'));
                    if (!isNaN(vatRate)) {
                        $vatRateInput.val(vatRate.toFixed(2));
                    }
                    updateTotal();
                    $('.amount-input, .price-input').trigger('input');
                });
            }

            $vatRateInput.on('input', function () {
                updateTotal();
                $('.amount-input, .price-input').trigger('input');
            });

            function escapeHtmlEdit(text) {
                if (text == null || text === undefined) return '';
                var div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
            function escapeAttrEdit(text) {
                if (text == null || text === undefined) return '';
                return String(text)
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#x27;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }

            function addProductRow(productId, productPNo, productName, amount, unitId, price, moq, calculationExplanation, calculationSummary) {
                var calc = calculationExplanation || '';
                var sum = calculationSummary || '';
                var row = '<tr data-row-index="' + productRowIndex + '">' +
                    '<td>' +
                        '<select name="OrderProducts[' + productRowIndex + '].ProductID" class="form-control product-select" required>' +
                        '<option value="">---Tanlang---</option>';
                
                purchasableProducts.forEach(function (product) {
                    var selected = product.Value == productId ? 'selected' : '';
                    row += '<option value="' + product.Value + '" ' + selected + ' data-pno="' + product.Text + '">' + product.Text + '</option>';
                });
                
                row += '</select>' +
                    '<input type="hidden" name="OrderProducts[' + productRowIndex + '].ID" value="" />' +
                    '<input type="hidden" name="OrderProducts[' + productRowIndex + '].ProductPNo" class="product-pno" value="' + (productPNo || '') + '" />' +
                    '</td>' +
                    '<td><input type="text" name="OrderProducts[' + productRowIndex + '].ProductName" class="form-control product-name" value="' + (productName || '') + '" readonly /></td>' +
                    '<td><input type="number" name="OrderProducts[' + productRowIndex + '].Amount" class="form-control amount-input" value="' + (amount || 0) + '" step="0.01" min="0" required /></td>' +
                    '<td>' +
                        '<select name="OrderProducts[' + productRowIndex + '].UnitID" class="form-control unit-select" required>' +
                        '<option value="">---Tanlang---</option>';
                
                units.forEach(function (unit) {
                    var selected = unit.Value == unitId ? 'selected' : '';
                    row += '<option value="' + unit.Value + '" ' + selected + '>' + unit.Text + '</option>';
                });
                
                row += '</select></td>' +
                    '<td><input type="number" name="OrderProducts[' + productRowIndex + '].Price" class="form-control price-input" value="' + (price || 0) + '" step="0.01" min="0" required /></td>' +
                    '<td><small class="text-muted d-block">QQS bilan: <span class="price-with-vat">0.00</span></small><input type="number" name="OrderProducts[' + productRowIndex + '].TotalPrice" class="form-control total-price" value="0" readonly /><small class="text-muted d-block mt-1">QQS bilan jami: <span class="line-total-with-vat">0.00</span></small></td>' +
                    '<td><input type="number" name="OrderProducts[' + productRowIndex + '].MOQ" class="form-control moq-input" value="' + (moq || 0) + '" step="0.01" min="0" /></td>' +
                    '<td class="align-top small">' + escapeHtmlEdit(calc || '—') +
                    '<input type="hidden" name="OrderProducts[' + productRowIndex + '].CalculationExplanation" value="' + escapeAttrEdit(calc) + '" />' +
                    '<input type="hidden" name="OrderProducts[' + productRowIndex + '].CalculationSummary" value="' + escapeAttrEdit(sum) + '" /></td>' +
                    '<td><button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button></td>' +
                    '</tr>';

                $('#orderProductsTable tbody').append(row);
                
                // Initialize Select2 for new row
                if (typeof $.fn.select2 !== 'undefined') {
                    $('select.product-select').last().select2();
                    $('select.unit-select').last().select2();
                }

                productRowIndex++;
            }

            // Remove row
            $(document).on('click', '.remove-row', function () {
                $(this).closest('tr').remove();
                updateTotal();
            });

            // Calculate totals on input change
            $(document).on('input', '.amount-input, .price-input', function () {
                var $row = $(this).closest('tr');
                var amount = parseFloat($row.find('.amount-input').val()) || 0;
                var price = parseFloat($row.find('.price-input').val()) || 0;
                var total = amount * price;
                $row.find('.total-price').val(total.toFixed(2));
                updateRowDisplayWithVat($row, amount, price);
                updateTotal();
            });

            function updateTotal() {
                var total = 0;
                $('.total-price').each(function () {
                    total += parseFloat($(this).val()) || 0;
                });
                $('#totalAmount').text(total.toFixed(2));
                $('#totalAmountWithVat').text(toVatAmount(total).toFixed(2));
            }

            // Form submission validation
            $('#orderForm').submit(function (e) {
                if ($('#orderProductsTable tbody tr').length === 0) {
                    e.preventDefault();
                    alert('Kamida bitta mahsulot qo\'shilishi kerak');
                    return false;
                }
            });
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initEditPOrderScripts);
            } else {
                initEditPOrderScripts();
            }
        })();
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
