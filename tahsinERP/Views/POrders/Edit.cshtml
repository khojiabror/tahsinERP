@model tahsinERP.ViewModels.POrder.POrderEditViewModel
@using System.Collections.Generic
@using System.Web.Mvc
@{
    ViewBag.Title = L.T("Srm_EditOrder");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isDirectOrder = ViewBag.IsDirectOrder as bool? ?? false;
    // Buyurtmaga haqiqatda qo'llangan QQS stavkasini ko'rsatamiz (shartnoma stavkasi emas).
    var initialVatRate = ViewBag.AppliedVatRate != null
        ? (decimal)ViewBag.AppliedVatRate
        : (ViewBag.ContractVatRate != null ? (decimal)ViewBag.ContractVatRate : 0m);

    var purchasableProductsData = new List<object>();
    var unitsData = new List<object>();

    // Qatorlarda faqat tanlangan mahsulot <option>'i chiqariladi, ro'yxat JS'dan (SRM-P02)
    var productTextById = new Dictionary<string, string>();
    if (ViewBag.PurchasableProductsList != null)
    {
        var ppSl = new SelectList(ViewBag.PurchasableProductsList, "ID", "PNo");
        foreach (SelectListItem item in ppSl)
        {
            purchasableProductsData.Add(new { Value = item.Value, Text = item.Text });
            productTextById[item.Value] = item.Text;
        }
    }

    if (ViewBag.UnitsList != null)
    {
        var uSl = new SelectList(ViewBag.UnitsList, "ID", "Text");
        foreach (SelectListItem item in uSl)
        {
            unitsData.Add(new { Value = item.Value, Text = item.Text });
        }
    }
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/POrders/Index">@L.T("Menu_PurchaseOrders")</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Edit")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <section id="form-repeater-wrapper">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Edit", "POrders", FormMethod.Post, new { @class = "form", @id = "orderForm", data_renumber = "OrderProducts" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(model => model.ID)
                                        @Html.ValidationSummary(false, "", new { @class = "text-danger mb-2" })

                                        <!-- Order Header -->
                                        <div class="row">
                                            <div class="col-md-3 col-12 form-group">
                                                <label for="OrderNo">@L.T("Srm_OrderNo")</label>
                                                @Html.TextBoxFor(model => model.OrderNo, new { @class = "form-control", @required = "required" })
                                                @Html.ValidationMessageFor(model => model.OrderNo, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-3 col-12 form-group">
                                                <label for="IssuedDate">@L.T("Date")</label>
                                                @Html.TextBoxFor(model => model.IssuedDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @required = "required" })
                                                @Html.ValidationMessageFor(model => model.IssuedDate, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-3 col-12 form-group">
                                                <label for="CompanyID">@L.T("Menu_Company")</label>
                                                @Html.DropDownListFor(model => model.CompanyID, ViewBag.Companies as SelectList, L.T("SelectPlaceholder"), new { @class = "form-control select2", @required = "required" })
                                                @Html.ValidationMessageFor(model => model.CompanyID, "", new { @class = "text-danger" })
                                            </div>
                                            @if (!isDirectOrder)
                                            {
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="SupplierID">@L.T("Srm_Supplier")</label>
                                                    @Html.DropDownListFor(model => model.SupplierID, ViewBag.Suppliers as SelectList, L.T("SelectPlaceholder"), new { @class = "form-control select2", @id = "supplierSelect" })
                                                    @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="ContractID">@L.T("Srm_Contract")</label>
                                                    @Html.DropDownListFor(model => model.ContractID, ViewBag.Contracts as SelectList, L.T("SelectPlaceholder"), new { @class = "form-control select2", @id = "contractSelect" })
                                                    @Html.ValidationMessageFor(model => model.ContractID, "", new { @class = "text-danger" })
                                                </div>
                                            }
                                            else
                                            {
                                                @Html.HiddenFor(model => model.SupplierID)
                                                @Html.HiddenFor(model => model.ContractID)
                                            }
                                            <div class="col-md-3 col-12 form-group">
                                                <label for="CurrencyID">@L.T("Currency")</label>
                                                @Html.DropDownListFor(model => model.CurrencyID, ViewBag.Currencies as SelectList, L.T("SelectPlaceholder"), new { @class = "form-control select2", @required = "required" })
                                                @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-3 col-12 form-group">
                                                <label for="vatRateInput">@L.T("Srm_VatPercentShort")</label>
                                                <input type="number" id="vatRateInput" name="VatRate" class="form-control" value="@initialVatRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" step="0.01" min="0" max="100" />
                                            </div>
                                            <div class="col-md-12 col-12 form-group">
                                                <label for="Description">@L.T("Comment")</label>
                                                @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = "2", @placeholder = L.T("Srm_ShortComment") })
                                                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <br />
                                        <h5>@L.T("Srm_OrderProducts")</h5>
                                        
                                        <!-- Editable Products Table -->
                                        <div class="table-responsive">
                                            <table id="orderProductsTable" class="table table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th>@L.T("Srm_ProductCode")</th>
                                                        <th>@L.T("Srm_ProductName")</th>
                                                        <th>@L.T("Quantity")</th>
                                                        <th>@L.T("Unit")</th>
                                                        <th>@L.T("Price")</th>
                                                        <th>@L.T("Total")</th>
                                                        <th>MOQ</th>
                                                        <th style="min-width: 16rem;">@L.T("Srm_CalcExplanation")</th>
                                                        <th>@L.T("Actions")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.OrderProducts != null)
                                                    {
                                                        for (int i = 0; i < Model.OrderProducts.Count; i++)
                                                        {
                                                            var product = Model.OrderProducts[i];
                                                            <tr data-row-index="@i">
                                                                <td>
                                                                    @{
                                                                        var productIdStr = product.ProductID.ToString();
                                                                        var productText = productTextById.ContainsKey(productIdStr) ? productTextById[productIdStr] : product.ProductPNo;
                                                                    }
                                                                    <select name="OrderProducts[@i].ProductID" class="form-control product-select" required>
                                                                        <option value="">@L.T("SelectPlaceholder")</option>
                                                                        @if (product.ProductID > 0)
                                                                        {
                                                                            <option value="@productIdStr" data-pno="@productText" selected>@productText</option>
                                                                        }
                                                                    </select>
@Html.HiddenFor(m => m.OrderProducts[i].ID)
                                                                    @Html.HiddenFor(m => m.OrderProducts[i].ProductPNo, new { @class = "product-pno" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.OrderProducts[i].ProductName, new { @class = "form-control product-name", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.OrderProducts[i].Amount, "{0:0.######}", new { @type = "number", @class = "form-control amount-input", @step = "0.01", @min = "0", @required = "required" })
                                                                </td>
                                                                <td>
                                                                    @Html.DropDownListFor(m => m.OrderProducts[i].UnitID, new SelectList(ViewBag.UnitsList, "ID", "Text", product.UnitID), L.T("SelectPlaceholder"), new { @class = "form-control unit-select", @required = "required" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.OrderProducts[i].Price, "{0:0.######}", new { @type = "number", @class = "form-control price-input", @step = "0.01", @min = "0", @required = "required" })
                                                                    <small class="text-muted d-block mt-1">@L.T("Srm_WithVat") <span class="price-with-vat">0.00</span></small>
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.OrderProducts[i].TotalPrice, "{0:0.############}", new { @type = "number", @class = "form-control total-price", @readonly = "readonly" })
                                                                    <small class="text-muted d-block mt-1">@L.T("Srm_WithVatTotal") <span class="line-total-with-vat">0.00</span></small>
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.OrderProducts[i].MOQ, "{0:0.######}", new { @type = "number", @class = "form-control moq-input", @step = "0.01", @min = "0" })
                                                                </td>
                                                                <td class="align-top small">
                                                                    @(string.IsNullOrWhiteSpace(product.CalculationExplanation) ? "—" : product.CalculationExplanation)
                                                                    @Html.HiddenFor(m => m.OrderProducts[i].CalculationExplanation)
                                                                    @Html.HiddenFor(m => m.OrderProducts[i].CalculationSummary)
                                                                </td>
                                                                <td>
                                                                    <button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                                <tfoot>
                                                    <tr>
                                                        <td colspan="5" class="text-right"><strong>@L.T("Total"):</strong></td>
                                                        <td id="totalAmount" class="text-right"><strong>0.00</strong></td>
                                                        <td colspan="3"></td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="5" class="text-right"><strong>@L.T("Srm_TotalWithVat"):</strong></td>
                                                        <td id="totalAmountWithVat" class="text-right"><strong>0.00</strong></td>
                                                        <td colspan="3"></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>

                                        <div class="row mt-2">
                                            <div class="col-12">
                                                <button type="button" class="btn btn-outline-primary" id="addRowBtn">
                                                    <i class="bx bx-plus"></i> @L.T("Add")
                                                </button>
                                            </div>
                                        </div>

                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <button type="submit" class="btn btn-success">
                                                    <i class="bx bx-save"></i> @L.T("Save")
                                                </button>
                                                <a href="@Url.Action("Index", "POrders")" class="btn btn-secondary">
                                                    <i class="bx bx-x"></i> @L.T("Cancel")
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<script src="@Url.Content("~/Scripts/app/indexed-rows.js")"></script>
<script src="@Url.Content("~/Scripts/app/product-select.js")"></script>
<script src="@Url.Content("~/Scripts/app/contract-picker.js")"></script>

<script>
    (function () {
        function initEditPOrderScripts() {
            // jQuery va Select2 yuklanmaguncha kutamiz — aks holda ready ichidagi kod (Qo'shish tugmasi,
            // QQS hisoblari) xatolik tufayli umuman bog'lanmay qolardi.
            if (typeof jQuery === 'undefined' || typeof jQuery.fn.select2 === 'undefined') {
                setTimeout(initEditPOrderScripts, 100);
                return;
            }

            var $ = jQuery;

            $(document).ready(function () {
                if (typeof $.fn.select2 !== 'undefined') {
                    $('.select2').select2();
                }

        var productRowIndex= @(Model.OrderProducts?.Count ?? 0);
        var purchasableProducts = @Html.Raw(Json.Encode(purchasableProductsData ?? new List<object>()));
        var units = @Html.Raw(Json.Encode(unitsData ?? new List<object>()));
        ProductSelect.attach($('select.product-select'), purchasableProducts);
        var $vatRateInput= $('#vatRateInput');
        var selectedContractId = '@(Model.ContractID.HasValue ? Model.ContractID.Value.ToString() : "")';
        var isDirectOrder = @(isDirectOrder ? "true" : "false");

        function getVatRate() {
            var vatRate = parseFloat($vatRateInput.val());
            return isNaN(vatRate) || vatRate < 0 ? 0 : vatRate;
        }

        function toVatAmount(baseAmount) {
            return baseAmount * (1 + (getVatRate() / 100));
        }

        function updateRowDisplayWithVat($row, amount, price) {
            $row.find('.price-with-vat').text(toVatAmount(price).toFixed(2));
            $row.find('.line-total-with-vat').text(toVatAmount(amount * price).toFixed(2));
        }

        function loadContractsBySupplier(supplierId, selectedId) {
            ContractPicker.load($('#contractSelect'), '@Url.Action("GetContractsBySupplier", "POrders")', supplierId, selectedId, {});
        }

        // Calculate totals for existing rows
        $('.amount-input, .price-input').each(function () {
            var $row = $(this).closest('tr');
            var amount = parseFloat($row.find('.amount-input').val()) || 0;
            var price = parseFloat($row.find('.price-input').val()) || 0;
            var total = amount * price;
            $row.find('.total-price').val(total.toFixed(2));
            updateRowDisplayWithVat($row, amount, price);
        });
        updateTotal();
        if (!isDirectOrder && $('#supplierSelect').length > 0) {
            loadContractsBySupplier($('#supplierSelect').val(), selectedContractId);
        }

        // Add new row manually (delegated — har doim ishlashi uchun)
        $(document).on('click', '#addRowBtn', function () {
            addProductRow(null, '', '', 0, null, null, null, '', '');
        });

        if (!isDirectOrder && $('#supplierSelect').length > 0) {
            $('#supplierSelect').on('change', function () {
                loadContractsBySupplier($(this).val(), null);
            });
        }

        if (!isDirectOrder && $('#contractSelect').length > 0) {
            $('#contractSelect').on('change', function () {
                var selected = $(this).find('option:selected');
                var vatRate = parseFloat(selected.attr('data-vat-rate'));
                if (!isNaN(vatRate)) {
                    $vatRateInput.val(vatRate.toFixed(2));
                }
                updateTotal();
                $('.amount-input, .price-input').trigger('input');
            });
        }

        $vatRateInput.on('input', function () {
            updateTotal();
            $('.amount-input, .price-input').trigger('input');
        });

        function addProductRow(productId, productPNo, productName, amount, unitId, price, moq, calculationExplanation, calculationSummary) {
            var calc = calculationExplanation || '';
            var sum = calculationSummary || '';
            var row = '<tr data-row-index="' + productRowIndex + '">' +
                '<td>' +
                    '<select name="OrderProducts[' + productRowIndex + '].ProductID" class="form-control product-select" required>' +
                    ProductSelect.optionsHtml(purchasableProducts, productId, productPNo);

            row += '</select>' +
                '<input type="hidden" name="OrderProducts[' + productRowIndex + '].ID" value="" />' +
                '<input type="hidden" name="OrderProducts[' + productRowIndex + '].ProductPNo" class="product-pno" value="' + htmlEscape(productPNo) + '" />' +
                '</td>' +
                '<td><input type="text" name="OrderProducts[' + productRowIndex + '].ProductName" class="form-control product-name" value="' + htmlEscape(productName) + '" readonly /></td>' +
                '<td><input type="number" name="OrderProducts[' + productRowIndex + '].Amount" class="form-control amount-input" value="' + (amount || 0) + '" step="0.01" min="0" required /></td>' +
                '<td>' +
                    '<select name="OrderProducts[' + productRowIndex + '].UnitID" class="form-control unit-select" required>' +
                    '<option value="">@L.Js("SelectPlaceholder")</option>';
            
            units.forEach(function (unit) {
                var selected = unit.Value == unitId ? 'selected' : '';
                row += '<option value="' + unit.Value + '" ' + selected + '>' + htmlEscape(unit.Text) + '</option>';
            });
            
            row += '</select></td>' +
                '<td><input type="number" name="OrderProducts[' + productRowIndex + '].Price" class="form-control price-input" value="' + (price || 0) + '" step="0.01" min="0" required /></td>' +
                '<td><small class="text-muted d-block">@L.Js("Srm_WithVat") <span class="price-with-vat">0.00</span></small><input type="number" name="OrderProducts[' + productRowIndex + '].TotalPrice" class="form-control total-price" value="0" readonly /><small class="text-muted d-block mt-1">@L.Js("Srm_WithVatTotal") <span class="line-total-with-vat">0.00</span></small></td>' +
                '<td><input type="number" name="OrderProducts[' + productRowIndex + '].MOQ" class="form-control moq-input" value="' + (moq || 0) + '" step="0.01" min="0" /></td>' +
                '<td class="align-top small">' + htmlEscape(calc || '—') +
                '<input type="hidden" name="OrderProducts[' + productRowIndex + '].CalculationExplanation" value="' + htmlEscape(calc) + '" />' +
                '<input type="hidden" name="OrderProducts[' + productRowIndex + '].CalculationSummary" value="' + htmlEscape(sum) + '" /></td>' +
                '<td><button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button></td>' +
                '</tr>';

            $('#orderProductsTable tbody').append(row);
            
            // Initialize Select2 for new row
            if (typeof $.fn.select2 !== 'undefined') {
                ProductSelect.attach($('select.product-select').last(), purchasableProducts);
                $('select.unit-select').last().select2();
            }

            productRowIndex++;
        }

        // Remove row
        $(document).on('click', '.remove-row', function () {
            $(this).closest('tr').remove();
            updateTotal();
        });

        // Calculate totals on input change
        $(document).on('input', '.amount-input, .price-input', function () {
            var $row = $(this).closest('tr');
            var amount = parseFloat($row.find('.amount-input').val()) || 0;
            var price = parseFloat($row.find('.price-input').val()) || 0;
            var total = amount * price;
            $row.find('.total-price').val(total.toFixed(2));
            updateRowDisplayWithVat($row, amount, price);
            updateTotal();
        });

        function updateTotal() {
            var total = 0;
            $('.total-price').each(function () {
                total += parseFloat($(this).val()) || 0;
            });
            $('#totalAmount').text(total.toFixed(2));
            $('#totalAmountWithVat').text(toVatAmount(total).toFixed(2));
        }

        // Form submission validation
        $('#orderForm').submit(function (e) {
            if ($('#orderProductsTable tbody tr').length === 0) {
                e.preventDefault();
                alert('@L.Js("Srm_AtLeastOneProduct")');
                return false;
            }
        });
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initEditPOrderScripts);
        } else {
            initEditPOrderScripts();
        }
    })();
</script>
