@model tahsinERP.Models.P_ORDERS
@{
    ViewBag.Title = "Buyurtmani o'chirish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/POrders/Index">Xarid buyurtmalari</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    O'chirish
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title text-danger">Buyurtmani o'chirish</h4>
                        </div>
                        <div class="card-content">
                            <div class="card-body">
                                <div class="alert alert-warning">
                                    <h5>Diqqat!</h5>
                                    <p>Ushbu buyurtmani o'chirishni tasdiqlaysizmi? Bu amalni qaytarib bo'lmaydi.</p>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <table class="table table-borderless">
                                            <tr>
                                                <th width="40%">Buyurtma raqami:</th>
                                                <td>@Model.OrderNo</td>
                                            </tr>
                                            <tr>
                                                <th>Sana:</th>
                                                <td>@Model.IssuedDate.ToString("dd.MM.yyyy")</td>
                                            </tr>
                                            <tr>
                                                <th>Ta'minotchi:</th>
                                                <td>@(Model.SUPPLIER?.Name ?? "-")</td>
                                            </tr>
                                            <tr>
                                                <th>Jami summa:</th>
                                                <td><strong>@(Model.Amount?.ToString("N2") ?? "0.00")</strong></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                @if (Model.P_ORDER_PRODUCTS != null && Model.P_ORDER_PRODUCTS.Any())
                                {
                                    <hr />
                                    <h5>Buyurtma mahsulotlari (@Model.P_ORDER_PRODUCTS.Count ta)</h5>
                                }

                                @using (Html.BeginForm("Delete", "POrders", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.HiddenFor(model => model.ID)

                                    <div class="form-actions">
                                        <button type="submit" class="btn btn-danger">
                                            <i class="bx bx-trash"></i> Ha, o'chirish
                                        </button>
                                        <a href="@Url.Action("Index", "POrders")" class="btn btn-secondary">
                                            <i class="bx bx-x"></i> Bekor qilish
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
