@{
    ViewBag.Title = "Xarid buyurtmalari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    bool changePermit = ViewBag.ChangePermit as bool? ?? false;
}
<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Xarid buyurtmalari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "POrders")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi buyurtma (Direct)
                            </a>
                            <a href="@Url.Action("Index", "PRequisitions")" class="btn btn-info bg-light invoice-create ml-1" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Xarid arizasi (Indirect)
                            </a>
                        </div>
                    }

                    <!-- Purchase Type Filter -->
                    <div class="row mb-2">
                        <div class="col-md-3">
                            @using (Html.BeginForm("Index", "POrders", FormMethod.Get, new { id = "pOrdersFilter" }))
                            {
                                <div class="form-group">
                                    <label for="purchaseTypeFilter">Xarid turi</label>
                                    @Html.DropDownList("purchaseTypeFilter", new SelectList(new[]
                                    {
                                        new { Value = "", Text = "Barchasi" },
                                        new { Value = "Direct", Text = "Direct Purchase" },
                                        new { Value = "Indirect", Text = "Indirect Purchase" }
                                    }, "Value", "Text", (string)ViewBag.PurchaseTypeFilter), new { @class = "form-control select2" })
                                </div>
                                if (ViewBag.SupplierID != null)
                                {
                                    <input type="hidden" name="supplierID" value="@ViewBag.SupplierID" />
                                }
                                if (ViewBag.ContractID != null)
                                {
                                    <input type="hidden" name="contractID" value="@ViewBag.ContractID" />
                                }
                            }
                        </div>
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="pOrdersTable" class="table dt-responsive nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Buyurtma raqami</th>
                                                    <th>Turi</th>
                                                    <th>Sana</th>
                                                    <th>Summa (QQS bilan)</th>
                                                    <th>Valyuta</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

@section Scripts {
    <script src="~/Scripts/srm/srm-server-table.js"></script>
    <script>
        $(document).ready(function () {
            var detailsUrl = '@Url.Action("Details", "POrders")/';
            var editUrl = '@Url.Action("Edit", "POrders")/';
            var deleteUrl = '@Url.Action("Delete", "POrders")/';
            var columns = [
                { data: 'orderNo', render: function (v, t, r) { return '<a href="' + detailsUrl + r.id + '">' + srmEsc(v) + '</a>'; } },
                { data: 'indirect', render: function (v) { return v ? '<span class="badge badge-info">Indirect</span>' : '<span class="badge badge-primary">Direct</span>'; } },
                { data: 'date' },
                { data: 'amount' },
                { data: 'currency', render: function (v) { return srmEsc(v); } }
            ];
            @if (changePermit)
            {
                <text>
                columns.push({
                    data: null, orderable: false, render: function (v, t, r) {
                        return '<div class="d-flex">' +
                            '<a href="' + detailsUrl + r.id + '" class="btn btn-sm btn-icon btn-outline-primary mr-1" title="Ko&#39;rish"><i class="bx bx-show"></i></a>' +
                            '<a href="' + editUrl + r.id + '" class="btn btn-sm btn-icon btn-outline-warning mr-1" title="Tahrirlash"><i class="bx bx-edit-alt"></i></a>' +
                            '<a href="' + deleteUrl + r.id + '" class="btn btn-sm btn-icon btn-outline-danger" title="O&#39;chirish" onclick="return confirm(&quot;Ushbu buyurtmani o&#39;chirishni tasdiqlaysizmi?&quot;);"><i class="bx bx-trash"></i></a>' +
                            '</div>';
                    }
                });
                </text>
            }
            var table = srmServerTable('#pOrdersTable', {
                dataUrl: '@Url.Action("IndexData", "POrders")',
                exportUrl: '@Url.Action("ExportExcel", "POrders")',
                filterForm: '#pOrdersFilter',
                order: [[2, 'desc']],
                columns: columns
            });
            $('#pOrdersFilter select').on('change', function () { table.ajax.reload(); });
            $('#pOrdersFilter').on('submit', function (e) { e.preventDefault(); table.ajax.reload(); });
        });
    </script>
}
