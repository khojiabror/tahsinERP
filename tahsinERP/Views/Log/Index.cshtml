@{
    ViewBag.Title = "Tizim loglari";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item active">Loglar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title"><i class="bx bx-filter mr-1"></i>Filterlar</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Index", "Log", FormMethod.Get, new { @class = "row" }))
                                    {
                                        <div class="col-md-3 col-12">
                                            <label>Modul</label>
                                            @Html.DropDownList("module", (SelectList)ViewBag.Modules, "Barcha modullar", new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-3 col-12">
                                            <label>Foydalanuvchi</label>
                                            @Html.DropDownList("userId", (SelectList)ViewBag.Users, "Barcha foydalanuvchilar", new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-2 col-12">
                                            <label>Dan</label>
                                            @Html.TextBox("startDate", (string)ViewBag.StartDate, new { @class = "form-control", @type = "date" })
                                        </div>
                                        <div class="col-md-2 col-12">
                                            <label>Gacha</label>
                                            @Html.TextBox("endDate", (string)ViewBag.EndDate, new { @class = "form-control", @type = "date" })
                                        </div>
                                        <div class="col-md-2 col-12 d-flex align-items-end">
                                            <button type="submit" class="btn btn-primary btn-block">
                                                <i class="bx bx-search"></i> Qidirish
                                            </button>
                                            <a class="btn btn-success btn-block mt-0 ml-1" title="Filtrdagi barcha yozuvlar"
                                               href="@Url.Action("ExportExcel", "Log", new { module = ViewBag.Module, userId = ViewBag.UserId, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })">
                                                <i class="bx bxs-file-excel"></i> Excel
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="logDataTable" class="table table-striped table-bordered dataex-html5-selectors" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Foydalanuvchi</th>
                                                    <th>Controller</th>
                                                    <th>Action</th>
                                                    <th>IP manzili</th>
                                                    <th>MAC manzili</th>
                                                    <th>Sana</th>
                                                    <th>Vaqt</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(function () {
                $('#logDataTable').DataTable({
                    serverSide: true,
                    processing: true,
                    searchDelay: 400,
                    ajax: { url: '@Url.Action("Data", "Log")', data: function (d) { return $.extend(d, { module: @Html.Raw(Json.Encode(ViewBag.Module)), userId: @Html.Raw(Json.Encode(ViewBag.UserId)), startDate: @Html.Raw(Json.Encode(ViewBag.StartDate)), endDate: @Html.Raw(Json.Encode(ViewBag.EndDate)) }); } },
                    columns: [
                        { data: 'user' },
                        { data: 'controller' },
                        { data: 'action' },
                        { data: 'ip' },
                        { data: 'mac', orderable: false },
                        { data: 'date' },
                        { data: 'time', orderable: false }
                    ],
                    pageLength: 25,
                    lengthMenu: [[10, 25, 50, 100, 500], [10, 25, 50, 100, 500]],
                    order: [[5, "desc"]],
                    scrollX: true,
                    language: {
                        search: "Qidirish:",
                        lengthMenu: "_MENU_ ta ko'rsatish",
                        info: "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                        infoEmpty: "Yozuvlar yo'q",
                        infoFiltered: "(jami _MAX_ ta yozuvdan filtrlangan)",
                        processing: "Yuklanmoqda...",
                        paginate: { first: "Birinchi", last: "Oxirgi", next: "Keyingi", previous: "Oldingi" },
                        zeroRecords: "Ma'lumot topilmadi"
                    }
                });
            });
        </script>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

