@model tahsinERP.ViewModels.PInvoice.PInvoiceCreateViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var type = ViewBag.Type;
}
<style>
    /* Hide the default file input */
    .custom-file-input {
        display: none;
    }

    /* Style the custom button */
    .custom-file-button {
        display: inline-block;
        padding: 10px 20px;
        font-size: 16px;
        color: #fff;
        background-color: #007bff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        text-align: center;
    }

        /* Optional: Change button color on hover */
        .custom-file-button:hover {
            background-color: #0056b3;
        }
</style>

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString(), type))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/PInvoice/Index">Invoice lar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Invoice
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Create", "PInvoice", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form repeater-default" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row justify-content-around d-flex align-items-start">
                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="InvoiceNo">Invoice raqami</label>
                                                            @Html.TextBoxFor(model => model.InvoiceNo, new { @type = "text", @class = "form-control", @id = "InvoiceNo", @placeholder = "Invoice raqami", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.InvoiceNo, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="SupplierID">Ta`minotchi</label>
                                                            @Html.DropDownListFor(model => model.SupplierID, (SelectList)ViewBag.Supplier, "", new { @class = "form-control select2", id = "SupplierID", @required = "required", onchange = "RefreshOrderListbySupplier()" })
                                                            @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="ContractID">Buyurtma raqami</label>
                                                            @Html.DropDownListFor(model => model.OrderID, (SelectList)ViewBag.POrder, "", new { @class = "form-control select2", id = "OrderID", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.OrderID, "", new { @class = "text-danger" })
                                                        </div>

                                                    </div>
                                                </div>

                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group position-relative has-icon-left">
                                                            <label for="dateInput">Invoys sanasi:</label>
                                                            @Html.TextBoxFor(model => model.InvoiceDate, new { @class = "form-control", @id = "dateInput", @name = "Date", @placeholder = "Sana", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.InvoiceDate, "", new { @class = "text-danger" })
                                                            <div class="form-control-position mt-2">
                                                                <i class='bx bx-calendar'></i>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="Currency">Valyuta<i class='bx bx-info-circle' data-toggle="tooltip" data-placement="right" title="Valyuta ma'lumotlarini sozlamalardan o'zgartiring"></i></label>
                                                            @Html.DropDownListFor(model => model.CurrencyID, (SelectList)ViewBag.currencies, "", new { @class = "form-control select2", @id = "Currency", @placeholder = "Valyuta" })
                                                            @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-12 form-group">
                                                <hr />
                                                <label>Invoys faylini yuklang:</label>
                                                <!-- Hidden file input -->
                                                <input type="file" id="docUpload" name="docUpload" class="custom-file-input" />
                                                <!-- Custom button -->
                                                <label style="font-size:smaller;" for="docUpload" class="custom-file-button">Faylni yuklang</label>
                                                @Html.ValidationMessageFor(model => model.File, "", new { @class = "text-danger" })
                                                <hr />
                                            </div>
                                            <br />
                                            <h4>Ehtiyot qismlar</h4>
                                            <div data-repeater-list="Parts">
                                                <div data-repeater-item>
                                                    <div class="row col-12 justify-content-between">
                                                        <input type="hidden" name="ID" />
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_PartID">Qismni tanlang</label>
                                                            @Html.DropDownList("PartID", (SelectList)ViewBag.partList, new { @class = "form-control select PartID", id = "PartID", onchange = "getPriceAndQuantity(this)", onclick = "getPriceAndQuantity(this)" })
                                                            @Html.ValidationMessageFor(model => model.Parts[0].PartID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Unit">Birligi<i class='bx bx-info-circle' data-toggle="tooltip" data-placement="right" title="O'lchov ma'lumotlarini sozlamalardan o'zgartiring"></i></label>
                                                            @Html.DropDownList("UnitID", (SelectList)ViewBag.units, new { @class = "form-control select", id = "UnitID" })
                                                            @Html.ValidationMessageFor(model => model.Parts[0].UnitID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Quantity">Miqdori</label>
                                                            <input type="number" name="Quantity" step="0.01" class="form-control Part_Quantity" id="Part_Quantity" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Quantity, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Price">Narx</label>
                                                            <input type="number" name="Price" step="0.01" class="form-control Part_Price" id="Part_Price" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Price, "", new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_TotalPrice">Umumiy Narxi</label>
                                                            <input type="number" name="TotalPrice" step="0.01" class="form-control Part_TotalPrice" id="Part_TotalPrice" disabled="disabled" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].TotalPrice, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-1 col-sm-12 form-group d-flex align-items-center pt-2">
                                                            <button data-repeater-delete type="button" class="btn btn-danger">O`chirish</button>
                                                        </div>
                                                    </div>
                                                    <hr>
                                                </div>
                                            </div>

                                            <button data-repeater-create type="button" class="btn btn-primary" onclick="getOrderDetails()">Yangi qism qo'shish</button>

                                            <ul class="list-group list-group-flush">
                                                <li class="list-group-item border-0 pb-0">
                                                    <button class="btn btn-primary btn-block subtotal-preview-btn" name="create" type="submit" value="Create">
                                                        <i class='bx bx-save'></i>
                                                        Saqlash
                                                    </button>
                                                </li>
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            flatpickr("#dateInput", {
                dateFormat: "d-m-Y", // You can customize the date format
                // Optional: restricts the selection to today's date or later
                altInput: true, // Optional: creates an alternate input (more user-friendly)
                altFormat: "F j, Y", // Format displayed in alt input
                weekNumbers: true,
                showTodayButton: true,
                maxDate: "today",
                locale: "uz",
            });
        });
    </script>
    <script type="text/javascript">
    // Supplier tanlanganda orderlarni yangilash va valyutani to'ldirish
    function RefreshOrderListbySupplier() {
        const supplierID = document.getElementById("SupplierID").value;
        $.ajax({
            url: '@Url.Action("GetOrdersBySupplier", "PInvoice")',
            type: 'GET',
            data: { supplierID: supplierID },
            success: function (data) {
                var contractDropdown = $("#OrderID");
                contractDropdown.empty();

                // Order dropdown ni yangilash
                $.each(data, function (index, item) {
                    contractDropdown.append(new Option(item.Text, item.Value));
                });

                // Birinchi order tanlanadi va tafsilotlari avtomatik ko'rinadi
                if (data.length > 0) {
                    contractDropdown.val(data[0].Value).trigger('change');
                }
            },
            error: function (xhr, status, error) {
                console.error("Buyurtmalarni olishda xatolik:", error);
            }
        });
    }

    // Yangi qism qo'shilganda qismlar ro'yxatini yangilash
    $(document).on('click', '[data-repeater-create]', function () {
        setTimeout(function () {
            var orderID = $("#OrderID").val(); // OrderID qiymatini olamiz
            if (orderID) {
                updatePartList(orderID); // Yangilangan qismlar ro'yxati
            } else {
                console.error("Buyurtmasi yo'q qism tanlanyabdi!");
            }
        }, 100);
    });

    </script>

    <script>
$(document).ready(function () {
    // Event listener for OrderID change
    $('#OrderID').on('change', function () {
        var orderID = $(this).val();
        if (orderID) {
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("GetPartList", "PInvoice")',
                type: 'GET',
                headers: { 'RequestVerificationToken': token },
                data: { orderID: orderID },
                success: function (response) {
                    $('[data-repeater-list="Parts"]').empty();

                    response.forEach(function (item, index) {
                        var partOptions = '';
                        item.Parts.forEach(function (partOption) {
                            partOptions += `<option value="${partOption.ID}" ${partOption.ID === item.PartID ? 'selected' : ''}>${partOption.PNo}</option>`;
                        });

                        var unitOptions = '';
                        item.Units.forEach(function (unitOption) {
                            unitOptions += `<option value="${unitOption.ID}" ${unitOption.ID === item.UnitID ? 'selected' : ''}>${unitOption.ShortName}</option>`;
                        });

                        var newItem = `
                        <div data-repeater-item>
                            <div class="row justify-content-between">
                                <input type="hidden" name="Parts[${index}].ID" value="${item.ID}" />

                                <div class="col-md-2 col-sm-12 form-group">
                                    <label>Qismni tanlang</label>
                                    <select name="Parts[${index}].PartID" class="form-control select">
                                        ${partOptions}
                                    </select>
                                </div>

                                <div class="col-md-2 col-sm-12 form-group">
                                    <label>Birligi<i class='bx bx-info-circle' data-toggle="tooltip" data-placement="right" title="O'lchov ma'lumotlarini sozlamalardan o'zgartiring"></i></label>
                                    <select name="Parts[${index}].UnitID" class="form-control select">
                                        ${unitOptions}
                                    </select>
                                </div>

                                <div class="col-md-2 col-sm-12 form-group">
                                    <label>Miqdori</label>
                                    <input type="number" name="Parts[${index}].Quantity" value="${item.Amount}" class="form-control Part_Quantity" />
                                </div>
                                <div class="col-md-2 col-sm-12 form-group">
                                    <label>Dona narxi</label>
                                    <input type="number" name="Parts[${index}].Price" value="${item.Price}" class="form-control Part_Price" step="0.001" />
                                </div>

                                <div class="col-md-2 col-sm-12 form-group">
                                    <label>Umumiy narxi</label>
                                    <input type="number" name="Parts[${index}].TotalPrice" value="${item.TotalPrice}" class="form-control Part_TotalPrice" step="0.001" disabled />
                                </div>

                                <div class="col-md-2 col-sm-12 form-group">
                                    <button data-repeater-delete type="button" class="btn btn-danger">O'chirish</button>
                                </div>
                            </div>
                            <hr>
                        </div>`;
                        $('[data-repeater-list="Parts"]').append(newItem);
                    });
                },
                error: function () {
                    alert('Qismlarni yuklashda muammo bor.');
                }
            });
        }
    });

    // Dynamic calculation for TotalPrice
    $(document).on('input', '.Part_Price, .Part_Quantity', function () {
        // Find the row of the input field
        const row = $(this).closest('[data-repeater-item]');

        // Get the price and quantity inputs within the same row
        const priceInput = row.find('.Part_Price');
        const quantityInput = row.find('.Part_Quantity');
        const totalPriceInput = row.find('.Part_TotalPrice');

        // Parse the values as numbers and calculate the total price
        const price = parseFloat(priceInput.val()) || 0;
        const quantity = parseFloat(quantityInput.val()) || 0;
        const totalPrice = price * quantity;

        // Update the TotalPrice field
        totalPriceInput.val(totalPrice.toFixed(6)); // Adjust decimal places as needed
    });
});
    </script>

    <script>
        document.addEventListener('input', function (event) {
            if (event.target.matches('.Part_Price') || event.target.matches('.Part_Quantity')) {
                // Find the row of the input field
                const row = event.target.closest('[data-repeater-item]');

                // Get the price and quantity inputs within the same row
                const priceInput = row.querySelector('.Part_Price');
                const quantityInput = row.querySelector('.Part_Quantity');
                const totalPriceInput = row.querySelector('.Part_TotalPrice');

                // Parse the values as numbers and calculate the total price
                const price = parseFloat(priceInput.value) || 0;
                const quantity = parseFloat(quantityInput.value) || 0;
                const totalPrice = price * quantity;

                // Update the TotalPrice field
                totalPriceInput.value = totalPrice.toFixed(6); // Adjust decimal places as needed
            }
        });
    </script>

}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

