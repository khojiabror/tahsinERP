@model tahsinERP.Models.FIN_ACCOUNTS

@{
    ViewBag.Title = "Hisobni tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/FinAccounts">Hisoblar</a></li>
                                    <li class="breadcrumb-item active">Tahrirlash</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Hisobni tahrirlash</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Edit", "FinAccounts", FormMethod.Post, new { @class = "form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(m => m.ID)
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Code, "Kod *", new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.Code, new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                                        </div>
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Name, "Nomi *", new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                                        </div>
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.OwnerName, "Egasi", new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.OwnerName, new { @class = "form-control" })
                                        </div>
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.CurrencyID, "Valyuta *", new { @class = "control-label" })
                                            @Html.DropDownListFor(m => m.CurrencyID, ViewBag.CurrencyID as SelectList, "Tanlang...", new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(m => m.CurrencyID, "", new { @class = "text-danger" })
                                        </div>
                                        
                                        <div class="form-group">
                                            <div class="custom-control custom-checkbox">
                                                @Html.CheckBoxFor(m => m.IsCash, new { @class = "custom-control-input", id = "IsCash" })
                                                <label class="custom-control-label" for="IsCash">Naqd pul</label>
                                            </div>
                                        </div>
                                        
                                        <div class="form-group">
                                            <div class="custom-control custom-checkbox">
                                                @Html.CheckBoxFor(m => m.IsBank, new { @class = "custom-control-input", id = "IsBank" })
                                                <label class="custom-control-label" for="IsBank">Bank</label>
                                            </div>
                                        </div>
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.BalanceCategoryID, "Balans kategoriyasi", new { @class = "control-label" })
                                            @Html.DropDownListFor(m => m.BalanceCategoryID, ViewBag.BalanceCategoryID as SelectList, "Tanlang... (ixtiyoriy)", new { @class = "form-control" })
                                            <small class="form-text text-muted">Hisobni balans hisobotida qaysi kategoriyaga qo'shishni belgilang</small>
                                        </div>
                                        
                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-primary">Saqlash</button>
                                            <a href="@Url.Action("Index")" class="btn btn-secondary">Bekor qilish</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
