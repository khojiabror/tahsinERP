@model tahsinERP.Models.FIN_ACCOUNTS

@{
    ViewBag.Title = "Hisobni o'chirish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/FinAccounts">Hisoblar</a></li>
                                    <li class="breadcrumb-item active">O'chirish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title text-danger">Hisobni o'chirish</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="alert alert-warning">
                                        <h5>Diqqat!</h5>
                                        <p>Ushbu hisobni o'chirishni tasdiqlaysizmi?</p>
                                        @if (ViewBag.HasTransactions)
                                        {
                                            <p class="text-danger"><strong>Bu hisobda tranzaksiyalar mavjud. O'chirilganda faollikdan chiqariladi.</strong></p>
                                        }
                                    </div>
                                    
                                    <dl class="row">
                                        <dt class="col-sm-4">Kod:</dt>
                                        <dd class="col-sm-8">@Model.Code</dd>
                                        
                                        <dt class="col-sm-4">Nomi:</dt>
                                        <dd class="col-sm-8">@Model.Name</dd>
                                        
                                        <dt class="col-sm-4">Valyuta:</dt>
                                        <dd class="col-sm-8">@Model.CURRENCy?.Name</dd>
                                    </dl>
                                    
                                    @using (Html.BeginForm("Delete", "FinAccounts", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(m => m.ID)
                                        
                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-danger">Ha, o'chirish</button>
                                            <a href="@Url.Action("Index")" class="btn btn-secondary">Bekor qilish</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
