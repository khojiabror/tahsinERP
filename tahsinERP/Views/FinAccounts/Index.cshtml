@model List<tahsinERP.Models.FIN_ACCOUNTS>

@{
    ViewBag.Title = "Moliya hisoblari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinAccounts");
}

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">Moliya</li>
                                    <li class="breadcrumb-item active">Hisoblar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <button type="button" class="btn btn-outline-success mr-1 mb-1" onclick="window.location.href='/FinAccounts/Create';">
                                <span class="align-middle ml-25">Hisob qo'shish</span>
                            </button>
                        </div>
                    }
                    
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="accountsTable" class="table table-striped table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Kod</th>
                                                <th>Nomi</th>
                                                <th>Egasi</th>
                                                <th>Valyuta</th>
                                                <th>Turi</th>
                                                <th>Holati</th>
                                                @if (changePermit)
                                                {
                                                    <th>Amallar</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td><a href="@Url.Action("Details", new { id = item.ID })">@item.Code</a></td>
                                                    <td>@item.Name</td>
                                                    <td>@(item.OwnerName ?? "-")</td>
                                                    <td>@(item.CURRENCy != null ? item.CURRENCy.Shortname : "-")</td>
                                                    <td>
                                                        @if (item.IsCash)
                                                        { <span class="badge badge-success">Naqd pul</span> }
                                                        else if (item.IsBank)
                                                        { <span class="badge badge-info">Bank</span> }
                                                        else
                                                        { <span class="badge badge-secondary">Boshqa</span> }
                                                    </td>
                                                    <td>
                                                        @if (item.IsActive)
                                                        { <span class="badge badge-success">Faol</span> }
                                                        else
                                                        { <span class="badge badge-danger">Nofaol</span> }
                                                    </td>
                    @if (changePermit)
                    {
                        <td class="text-center">
                            <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-outline-info" title="Ko'rish">
                                <i class="bx bx-show"></i>
                            </a>
                            <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-outline-primary" title="Tahrirlash">
                                <i class="bx bx-edit"></i>
                            </a>
                            <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-outline-danger" title="O'chirish">
                                <i class="bx bx-trash"></i>
                            </a>
                            <a href="@Url.Action("Transactions", new { id = item.ID })" class="btn btn-sm btn-outline-secondary" title="Tranzaksiyalar">
                                <i class="bx bx-list-ul"></i>
                            </a>
                        </td>
                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                var changePermit = @(changePermit ? "true" : "false");
                
                var columnDefs = [
                    { "className": "text-center", "targets": [0, 1, 2, 3, 4, 5] }
                ];
                if (changePermit) {
                    columnDefs.push({ "orderable": false, "targets": -1, "className": "text-center" });
                }
                
                $('#accountsTable').DataTable({
                    "language": {
                        "search": "Qidirish:",
                        "lengthMenu": "_MENU_ ta ko'rsatish",
                        "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                        "infoEmpty": "Yozuvlar yo'q",
                        "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                        "paginate": {
                            "first": "Birinchi",
                            "last": "Oxirgi",
                            "next": "Keyingi",
                            "previous": "Oldingi"
                        },
                        "zeroRecords": "Ma'lumot topilmadi"
                    },
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Barchasi"]],
                    "order": [[0, "asc"]],
                    "columnDefs": columnDefs,
                    "dom": 'lBfrtip',
                    "pagingType": "full_numbers",
                    "buttons": erpDataTable.buttons({ fileName: 'FinAccounts', columns: changePermit ? ':not(:last-child)' : ':visible', pdf: false })
                });
            });
        </script>
    }
