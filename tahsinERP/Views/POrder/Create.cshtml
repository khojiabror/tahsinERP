@model tahsinERP.ViewModels.POrder.POrderCreateViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Hide the default file input */
    .custom-file-input {
        display: none;
    }

    /* Style the custom button */
    .custom-file-button {
        display: inline-block;
        padding: 10px 20px;
        font-size: 16px;
        color: #fff;
        background-color: #007bff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        text-align: center;
    }

        /* Optional: Change button color on hover */
        .custom-file-button:hover {
            background-color: #0056b3;
        }
</style>

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/POrder/Index">Buyurtmalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Buyurtma yaratish
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Create", "POrder", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form repeater-default" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row justify-content-around d-flex align-items-start">
                                                <!-- Left Part -->
                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="OrderNo">Buyurtma raqami</label>
                                                            @Html.TextBoxFor(model => model.OrderNo, new { @type = "text", @class = "form-control", @id = "OrderNo", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.OrderNo, "", new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="SupplierID">Ta`minotchi</label>
                                                            @Html.DropDownListFor(model => model.SupplierID, (SelectList)ViewBag.Supplier, "Ta'minotchini tanlang", new { @class = "form-control select2", id = "SupplierID", onchange = "refreshContractList()" })
                                                            @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="ContractID">Shartnoma raqami</label>
                                                            @Html.DropDownListFor(model => model.ContractID, (SelectList)ViewBag.PContract, "Shartnomani tanlang", new { @class = "form-control select2", @id = "ContractID" })
                                                            @Html.ValidationMessageFor(model => model.ContractID, "", new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-6 col-12 form-group position-relative has-icon-left">
                                                            <label for="dateInput">Buyurtma berilgan sanasi:</label>
                                                            @Html.TextBoxFor(model => model.IssuedDate, new { @class = "form-control", @id = "dateInput", @name = "Date", @placeholder = "Buyurtma berilgan sanasi", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.IssuedDate, "", new { @class = "text-danger" })
                                                            <div class="form-control-position mt-2">
                                                                <i class='bx bx-calendar'></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Right Part -->
                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="Currency">Valyuta<i class='bx bx-info-circle' data-toggle="tooltip" data-placement="right" title="Valyuta ma'lumotlarini sozlamalardan o'zgartiring"></i>:</label>
                                                            @Html.DropDownListFor(model => model.CurrencyID, ViewBag.currencies as SelectList, new { @class = "form-control select", id = "Currency" })
                                                            @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="Description">Qisqacha tavsifi</label>
                                                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", id = "Description" })
                                                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-6 col-12 form-group">
                                                <hr />
                                                <label>Buyurtma faylini yuklang</label>
                                                @Html.TextBoxFor(model => model.File, new { type = "file", @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.File, "", new { @class = "text-danger" })
                                                <hr />
                                            </div>
                                            <h4>Ehtiyot qismlar</h4>
                                            <div data-repeater-list="Parts">
                                                <div data-repeater-item>
                                                    <div class="row col-12 justify-content-between">
                                                        <input type="hidden" name="ID" />
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_PartID">Qismni tanlang</label>
                                                            @Html.DropDownList("PartID", (IEnumerable<SelectListItem>)ViewBag.partList, "", new { @class = "form-control select", id = "PartID" })
                                                            @Html.ValidationMessageFor(model => model.Parts[0].PartID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Unit">Birligi<i class='bx bx-info-circle' data-toggle="tooltip" data-placement="right" title="O'lchov birligi ma'lumotlarini sozlamalardan o'zgartiring"></i></label>
                                                            @Html.DropDownList("UnitID", (SelectList)ViewBag.units, new { @class = "form-control select", id = "UnitID" })
                                                            @Html.ValidationMessageFor(model => model.Parts[0].UnitID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_MOQ">MOQ</label>
                                                            <input type="number" name="MOQ" class="form-control Part_MOQ" id="Part_MOQ" disabled="disabled" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].MOQ, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Amount">Miqdori</label>
                                                            <input type="number" name="Amount" step="0.1" class="form-control Part_Amount" id="Part_Amount" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Amount, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Price">Narx</label>
                                                            <input type="number" name="Price" step="0.1" class="form-control Part_Price" id="Part_Price" disabled="disabled" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Price, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_TotalPrice">Umumiy Narxi</label>
                                                            <input type="number" name="Price" step="0.1" class="form-control Part_TotalPrice" id="Part_TotalPrice" disabled="disabled" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].TotalPrice, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group d-flex align-items-center pt-2">
                                                            <button data-repeater-delete type="button" class="btn btn-danger">O'chirish</button>
                                                        </div>
                                                    </div>
                                                    <hr>
                                                </div>
                                            </div>
                                            <button data-repeater-create type="button" class="btn btn-primary">Yangi qism qo'shish</button>

                                            <br />
                                            <ul class="list-group list-group-flush">
                                                <li class="list-group-item border-0 pb-0">
                                                    <button class="btn btn-primary btn-block subtotal-preview-btn" name="create" type="submit" value="Create">
                                                        <i class='bx bx-save'></i> Saqlash
                                                    </button>
                                                </li>
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        flatpickr("#dateInput", {
            dateFormat: "d.m.Y", // You can customize the date format
            // Optional: restricts the selection to today's date or later
            altInput: true, // Optional: creates an alternate input (more user-friendly)
            altFormat: "F j, Y", // Format displayed in alt input
            weekNumbers: true,
            showTodayButton: true,
            locale: "uz",
        });
    });
</script>
<script type="text/javascript">
    function refreshContractList() {
        const supplierID = $("#SupplierID").val();
        $.ajax({
            url: '@Url.Action("GetContractsBySupplier", "POrder")',
            type: 'GET',
            data: { supplierID: supplierID },
            success: function (data) {
                var contractDropdown = $("#ContractID");
                contractDropdown.empty();
                $.each(data, function (index, item) {
                    contractDropdown.append(new Option(item.Text, item.Value));
                });

                // Default shartnomani tanlab olamiz
                if (data.length > 0) {
                    contractDropdown.val(data[0].Value).trigger('change');
                }
            },
            error: function (xhr, status, error) {
                console.error("Error fetching contracts:", error);
            }
        });
    }
</script>
<script>
    $(document).ready(function () {
        // Event listener for ContractID change
        $('#ContractID').on('change', function () {
            var contractID = $(this).val();
            if (contractID) {
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("GetPartList", "POrder")',
                    type: 'GET',
                    headers: { 'RequestVerificationToken': token },
                    data: { contractID: contractID },
                    success: function (response) {
                        $('[data-repeater-list="Parts"]').empty();

                        response.forEach(function (item, index) {
                            var partOptions = '';
                            item.Parts.forEach(function (partOption) {
                                partOptions += `<option value="${partOption.ID}" ${partOption.ID === item.PartID ? 'selected' : ''}>${partOption.PNo}</option>`;
                            });

                            var unitOptions = '';
                            item.Units.forEach(function (unitOption) {
                                unitOptions += `<option value="${unitOption.ID}" ${unitOption.ID === item.UnitID ? 'selected' : ''}>${unitOption.ShortName}</option>`;
                            });

                            var newItem = `
                            <div data-repeater-item>
                                <div class="row justify-content-between">
                                    <input type="hidden" name="Parts[${index}].ID" value="${item.ID}" />

                                    <div class="col-md-2">
                                        <label>Qismni tanlang</label>
                                        <select name="Parts[${index}].PartID" class="form-control select">
                                            ${partOptions}
                                        </select>
                                    </div>

                                    <div class="col-md-2">
                                        <label>Birligi<i class='bx bx-info-circle' data-toggle="tooltip" data-placement="right" title="O'lchov ma'lumotlarini sozlamalardan o'zgartiring"></i></label>
                                        <select name="Parts[${index}].UnitID" class="form-control select">
                                            ${unitOptions}
                                        </select>
                                    </div>

                                    <div class="col-md-2">
                                        <label>MOQ</label>
                                        <input type="number" name="Parts[${index}].MOQ" value="${item.MOQ}" class="form-control" disabled />
                                    </div>
                                    <div class="col-md-2">
                                        <label>Miqdori</label>
                                        <input type="number" name="Parts[${index}].Amount" value="${item.Amount}" class="form-control Part_Amount" />
                                    </div>
                                    <div class="col-md-2">
                                        <label>Dona narxi</label>
                                        <input type="number" name="Parts[${index}].Price" value="${item.Price}" class="form-control Part_Price" step="0.01" disabled />
                                    </div>

                                    <div class="col-md-2">
                                        <label>Umumiy narxi</label>
                                        <input type="number" name="Parts[${index}].TotalPrice" value="${item.TotalPrice}" class="form-control Part_TotalPrice" step="0.01" disabled />
                                    </div>

                                    <div class="col-md-2">
                                        <button data-repeater-delete type="button" class="btn btn-danger">O'chirish</button>
                                    </div>
                                </div>
                                <hr>
                            </div>`;
                            $('[data-repeater-list="Parts"]').append(newItem);
                        });
                    },
                    error: function () {
                        alert('Qismlarni yuklashda muammo bor.');
                    }
                });
            }
        });

        // Dynamic calculation for TotalPrice
        $(document).on('input', '.Part_Amount, .Part_Price', function () {
            // Find the row of the input field
            const row = $(this).closest('[data-repeater-item]');

            // Get the price and quantity inputs within the same row
            const priceInput = row.find('.Part_Price');
            const quantityInput = row.find('.Part_Amount');
            const totalPriceInput = row.find('.Part_TotalPrice');

            // Parse the values as numbers and calculate the total price
            const price = parseFloat(priceInput.val()) || 0;
            const quantity = parseFloat(quantityInput.val()) || 0;
            const totalPrice = price * quantity;

            // Update the TotalPrice field
            totalPriceInput.val(totalPrice.toFixed(2)); // Adjust decimal places as needed
        });
    });
</script>

<script>
    document.addEventListener('input', function (event) {
        if (event.target.matches('.Part_Price') || event.target.matches('.Part_Amount')) {
            // Find the row of the input field
            const row = event.target.closest('[data-repeater-item]');

            // Get the price and quantity inputs within the same row
            const priceInput = row.querySelector('.Part_Price');
            const quantityInput = row.querySelector('.Part_Amount');
            const totalPriceInput = row.querySelector('.Part_TotalPrice');

            // Parse the values as numbers and calculate the total price
            const price = parseFloat(priceInput.value) || 0;
            const quantity = parseFloat(quantityInput.value) || 0;
            const totalPrice = price * quantity;

            // Update the TotalPrice field
            totalPriceInput.value = totalPrice.toFixed(2); // Adjust decimal places as needed
        }
    });
</script>