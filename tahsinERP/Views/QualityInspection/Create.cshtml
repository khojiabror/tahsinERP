@model tahsinERP.ViewModels.QualityInspectionViewModel
@{
    ViewBag.Title = "Yangi Sifat Nazorati";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Create", "QualityInspection", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/QualityInspection/Index">Sifat Nazorati</a>
                                        </li>
                                        <li class="breadcrumb-item active">Yangi Sifat Nazorati</li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="basic-select2">
                        <div class="row">
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            <div class="row">
                                                <div class="col-lg-12 col-md-6 mt-25">
                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                    <hr>
                                                    
                                                    <h6 class="invoice-to">Mahsulot *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.DropDownListFor(model => model.ProductID, ViewBag.Products as SelectList, "Mahsulotni tanlang", new { @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.ProductID, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">Tekshiruv sanasi *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.InspectionDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.InspectionDate, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">Tekshirilgan miqdor *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.QtyInspected, new { @class = "form-control", @type = "number", @step = "0.001", @min = "0.001", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.QtyInspected, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">Qabul qilingan miqdor *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.QtyAccepted, new { @class = "form-control", @type = "number", @step = "0.001", @min = "0", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.QtyAccepted, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">Rad etilgan miqdor *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.QtyRejected, new { @class = "form-control", @type = "number", @step = "0.001", @min = "0", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.QtyRejected, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">Nuqson turi</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.DropDownListFor(model => model.DefectTypeID, ViewBag.DefectTypes as SelectList, "Nuqson turini tanlang", new { @class = "form-control" })
                                                        @Html.ValidationMessageFor(model => model.DefectTypeID, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">Holat</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.DropDownListFor(model => model.StatusCode, new SelectList(new[] { "DRAFT", "APPROVED", "REJECTED" }, Model.StatusCode), new { @class = "form-control" })
                                                        @Html.ValidationMessageFor(model => model.StatusCode, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">Izohlar</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextAreaFor(model => model.Notes, new { @class = "form-control", @rows = "3" })
                                                        @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    @Html.HiddenFor(model => model.SOrderID)
                                                    @Html.HiddenFor(model => model.DeliveryScheduleID)
                                                    @Html.HiddenFor(model => model.ProductPlanDailyID)
                                                    @Html.HiddenFor(model => model.ProductionID)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="invoice-action">
                            <div class="row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary mr-1">
                                        <i class="bx bx-save"></i> Saqlash
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                                        <i class="bx bx-x"></i> Bekor qilish
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }

    <script>
        $(document).ready(function() {
            // Auto-calculate rejected qty
            $('#QtyInspected, #QtyAccepted').on('input', function() {
                var inspected = parseFloat($('#QtyInspected').val()) || 0;
                var accepted = parseFloat($('#QtyAccepted').val()) || 0;
                var rejected = inspected - accepted;
                $('#QtyRejected').val(rejected >= 0 ? rejected.toFixed(3) : 0);
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

