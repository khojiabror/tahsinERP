@model tahsinERP.ViewModels.QualityInspectionDailyViewModel
@{
    ViewBag.Title = "Yangi Sifat Nazorati";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Create", "QualityInspection", FormMethod.Post))
{
        @Html.AntiForgeryToken()
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/QualityInspection/Index">Sifat Nazorati</a>
                                        </li>
                                        <li class="breadcrumb-item active">Yangi Sifat Nazorati</li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="basic-select2">
                        <div class="row">
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            <div class="row">
                                                <div class="col-lg-12 col-md-6 mt-25">
                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                    <hr>

                                                    <div class="row mb-1">
                                                        <div class="col-md-6">
                                                            <h6 class="invoice-to">Fakt ishlab chiqarish sanasi</h6>
                                                            @Html.TextBoxFor(model => model.InspectionDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @readonly = "readonly" })
                                                        </div>
                                                        <div class="col-md-6">
                                                            <h6 class="invoice-to">Sanani tanlang va yuklash</h6>
                                                            <div class="d-flex">
                                                                <input type="date" id="inspection-date-picker" class="form-control" value="@Model.InspectionDate.ToString("yyyy-MM-dd")" />
                                                                <button type="button" id="inspection-date-load" class="btn btn-outline-primary ml-1">
                                                                    <i class="bx bx-refresh"></i> Yuklash
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    @if (Model.Items == null || !Model.Items.Any())
                                                    {
                                                        <div class="alert alert-warning">
                                                            @if (Model.ProductionRowCountForDay > 0)
                                                            {
                                                                <span>Bu kunda ishlab chiqarish yozuvlari bor, lekin barchasi allaqachon to'liq qabul qilingan (tekshiruv uchun qoldiq yo'q).</span>
                                                            }
                                                            else
                                                            {
                                                                <span>Tanlangan kalendar kuni uchun fakt ishlab chiqarish (ProductProduction) yozuvlari topilmadi yoki tugallangan mahsulot (IsFinishedGood) emas.</span>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="table-responsive">
                                                            <table class="table table-striped">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Mahsulot</th>
                                                                        <th>Ishlab chiqarildi</th>
                                                                        <th>Tekshirildi</th>
                                                                        <th>Qoldiq</th>
                                                                        <th>Qabul</th>
                                                                        <th>Rad</th>
                                                                        <th>Nuqson turi</th>
                                                                        <th>Izoh</th>
                                                                        <th></th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @for (int i = 0; i < Model.Items.Count; i++)
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                <div>@Model.Items[i].ProductNo</div>
                                                                                <small class="text-muted">@Model.Items[i].ProductName</small>
                                                                                @Html.HiddenFor(m => m.Items[i].ProductionID)
                                                                                @Html.HiddenFor(m => m.Items[i].ProductID)
                                                                                @Html.HiddenFor(m => m.Items[i].RemainingQty)
                                                                            </td>
                                                                            <td>@Model.Items[i].ProducedQty</td>
                                                                            <td>@Model.Items[i].AlreadyInspectedQty</td>
                                                                            <td>@Model.Items[i].RemainingQty</td>
                                                                            <td>
                                                                                @Html.TextBoxFor(m => m.Items[i].QtyAccepted, new { @class = "form-control qty-accepted", @type = "number", @step = "0.001", @min = "0", data_remaining = Model.Items[i].RemainingQty })
                                                                                <small class="text-muted">Qoldiq: @Model.Items[i].RemainingQty</small>
                                                                            </td>
                                                                            <td>
                                                                                @Html.TextBoxFor(m => m.Items[i].QtyRejected, new { @class = "form-control qty-rejected", @type = "number", @step = "0.001", @min = "0" })
                                                                            </td>
                                                                            <td>
                                                                                @Html.DropDownListFor(m => m.Items[i].DefectTypeID, ViewBag.DefectTypes as SelectList, "Tanlang", new { @class = "form-control" })
                                                                            </td>
                                                                            <td>
                                                                                @Html.TextBoxFor(m => m.Items[i].Notes, new { @class = "form-control" })
                                                                            </td>
                                                                            <td class="text-nowrap">
                                                                                <button type="button" class="btn btn-sm btn-outline-danger js-remove-row" title="Olib tashlash">
                                                                                    <i class="bx bx-x"></i>
                                                                                </button>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="invoice-action">
                            <div class="row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary mr-1">
                                        <i class="bx bx-save"></i> Saqlash
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                                        <i class="bx bx-x"></i> Bekor qilish
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
        </div>
    </div>
</div>
}

@section scripts {
    <script>
        (function() {
            function init() {
                if (typeof jQuery === 'undefined') {
                    setTimeout(init, 50);
                    return;
                }
                jQuery(document).ready(function ($) {
                    $('.qty-accepted').on('input', function () {
                        var remaining = parseFloat($(this).data('remaining')) || 0;
                        var accepted = parseFloat($(this).val()) || 0;
                        var rejected = remaining - accepted;
                        var rejectedInput = $(this).closest('tr').find('.qty-rejected');
                        if (rejectedInput.val() === '' || rejectedInput.val() === '0') {
                            rejectedInput.val(rejected >= 0 ? rejected.toFixed(3) : 0);
                        }
                    });

                    $(document).on('click', '.js-remove-row', function () {
                        var $tr = $(this).closest('tr');

                        // 0 qilib yuboramiz - controller bunday qatorni skip qiladi (inspectedQty <= 0)
                        $tr.find('.qty-accepted').val('0');
                        $tr.find('.qty-rejected').val('0');
                        $tr.find('select').val('');
                        $tr.find('input[type="text"]').val('');

                        // UI dan yashirish
                        $tr.hide();
                    });

                    $('#inspection-date-load').on('click', function () {
                        var dateValue = $('#inspection-date-picker').val();
                        if (dateValue) {
                            window.location = '@Url.Action("Create")' + '?date=' + dateValue;
                        }
                    });
                });
            }
            init();
        })();
    </script>
}

