@model List<tahsinERP.Models.QUALITY_INSPECTION>
@{
    ViewBag.Title = "Sifat Nazorati";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">Sifat Nazorati</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "QualityInspection")" class="btn btn-success bg-light invoice-create" role="button">
                                <i class="bx bx-plus"></i> Yangi Sifat Nazorati
                            </a>
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    }

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- Search and Filter -->
                                    <div class="users-list-filter px-1">
                                        <form method="get" action="@Url.Action("Index")">
                                            <div class="row border rounded py-2 mb-2">
                                                <div class="col-12 col-sm-6 col-lg-3">
                                                    <label>Qidirish</label>
                                                    <input type="text" name="searchTerm" class="form-control" value="@ViewBag.SearchTerm" placeholder="Mahsulot, izoh..." />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Mahsulot</label>
                                                    @Html.DropDownList("productID", ViewBag.Products as SelectList, "Barchasi", new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Holat</label>
                                                    @Html.DropDownList("statusCode", ViewBag.StatusCodes as SelectList, "Barchasi", new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Dan</label>
                                                    <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd") ?? "")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Gacha</label>
                                                    <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd") ?? "")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-1">
                                                    <label>&nbsp;</label>
                                                    <button type="submit" class="btn btn-primary btn-block">Qidirish</button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- datatable start -->
                                    <div class="card-datatable table-responsive">
                                        <table id="qualityInspectionTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Sana</th>
                                                    <th>Mahsulot</th>
                                                    <th>Tekshirilgan</th>
                                                    <th>Qabul qilingan</th>
                                                    <th>Rad etilgan</th>
                                                    <th>Holat</th>
                                                    <th>Amallar</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@item.InspectionDate.ToString("dd.MM.yyyy")</td>
                                                            <td>@(item.PRODUCT != null ? item.PRODUCT.PNo : item.ProductID.ToString())</td>
                                                            <td>@item.QtyInspected.ToString("N3")</td>
                                                            <td>@item.QtyAccepted.ToString("N3")</td>
                                                            <td>@item.QtyRejected.ToString("N3")</td>
                                                            <td>
                                                                @{ var statusText = item.StatusCode == "APPROVED" ? "Tasdiqlangan" : item.StatusCode == "REJECTED" ? "Rad etilgan" : item.StatusCode == "DRAFT" ? "Qoralama" : item.StatusCode ?? "-"; }
                                                                <span class="badge badge-@(item.StatusCode == "APPROVED" ? "success" : item.StatusCode == "REJECTED" ? "danger" : "warning")">
                                                                    @statusText
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-info" title="Batafsil">
                                                                    <i class="bx bx-show"></i> Batafsil
                                                                </a>
                                                                @if (changePermit && item.StatusCode != "APPROVED")
                                                                {
                                                                    <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-warning">
                                                                        <i class="bx bx-edit"></i>
                                                                    </a>
                                                                    <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-danger">
                                                                        <i class="bx bx-trash"></i>
                                                                    </a>
                                                                }
                                                                @if (item.StatusCode != "APPROVED")
                                                                {
                                                                    <a href="@Url.Action("Approve", new { id = item.ID })" class="btn btn-sm btn-success">
                                                                        <i class="bx bx-check"></i> Tasdiqlash
                                                                    </a>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
    @section Scripts {
        <script>
            $(document).ready(function () {
                $('#qualityInspectionTable').DataTable({
                    "language": {
                        "search": "Qidirish:",
                        "lengthMenu": "_MENU_ ta ko'rsatish",
                        "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                        "infoEmpty": "Yozuvlar yo'q",
                        "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                        "paginate": {
                            "first": "Birinchi",
                            "last": "Oxirgi",
                            "next": "Keyingi",
                            "previous": "Oldingi"
                        },
                        "zeroRecords": "Ma'lumot topilmadi"
                    },
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Barchasi"]],
                    "order": [[3, "desc"]],
                    "columnDefs": [
                        { "type": "date", "targets": 3 }
                    ],
                    "scrollX": true,
                    dom: 'lBfrtip',
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bx bxs-file-excel"></i> Excel',
                            titleAttr: 'Excelga yuklash',
                            className: 'btn btn-success mr-1',
                            filename: function () {
                                var now = new Date();
                                var dateStr = now.getFullYear() +
                                    String(now.getMonth() + 1).padStart(2, '0') +
                                    String(now.getDate()).padStart(2, '0') + '_' +
                                    String(now.getHours()).padStart(2, '0') +
                                    String(now.getMinutes()).padStart(2, '0') +
                                    String(now.getSeconds()).padStart(2, '0');
                                return 'Sifat nazorati_' + dateStr;
                            },
                            exportOptions: {
                                columns: ':visible',
                                format: {
                                    body: function (data, row, column, node) {
                                        return data.replace(/<[^>]*>/g, '').trim();
                                    }
                                }
                            }
                        },
                        {
                            extend: 'pdfHtml5',
                            text: '<i class="bx bxs-file-pdf"></i> PDF',
                            titleAttr: 'PDFga yuklash',
                            className: 'btn btn-danger',
                            filename: function () {
                                var now = new Date();
                                var dateStr = now.getFullYear() +
                                    String(now.getMonth() + 1).padStart(2, '0') +
                                    String(now.getDate()).padStart(2, '0') + '_' +
                                    String(now.getHours()).padStart(2, '0') +
                                    String(now.getMinutes()).padStart(2, '0') +
                                    String(now.getSeconds()).padStart(2, '0');
                                return 'Sifat nazorati_' + dateStr;
                            },
                            exportOptions: {
                                columns: ':visible',
                                format: {
                                    body: function (data, row, column, node) {
                                        return data.replace(/<[^>]*>/g, '').trim();
                                    }
                                }
                            },
                            orientation: 'landscape',
                            pageSize: 'A4',
                            title: 'Sifat nazorati',
                            customize: function (doc) {
                                doc.defaultStyle.fontSize = 9;
                                doc.styles.tableHeader.fontSize = 10;
                            }
                        }
                    ]
                });
            });
        </script>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

