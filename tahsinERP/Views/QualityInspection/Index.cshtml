@model List<tahsinERP.Models.QUALITY_INSPECTION>
@{
    ViewBag.Title = L.T("Mes_Qi_Title");
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool changePermit = ViewBag.ChangePermit as bool? ?? false;
}

<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">@L.T("Mes_Qi_Title")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "QualityInspection")" class="btn btn-success bg-light invoice-create" role="button">
                                <i class="bx bx-plus"></i> @L.T("Mes_Qi_New")
                            </a>
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    }

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- Search and Filter -->
                                    <div class="users-list-filter px-1">
                                        <form method="get" action="@Url.Action("Index")">
                                            <div class="row border rounded py-2 mb-2">
                                                <div class="col-12 col-sm-6 col-lg-3">
                                                    <label>@L.T("Search")</label>
                                                    <input type="text" name="searchTerm" class="form-control" value="@ViewBag.SearchTerm" placeholder="@L.T("Mes_Qi_SearchPlaceholder")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>@L.T("Mes_Product")</label>
                                                    @Html.DropDownList("productID", ViewBag.Products as SelectList, L.T("All"), new { @class = "select2 form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>@L.T("Status")</label>
                                                    @Html.DropDownList("statusCode", ViewBag.StatusCodes as SelectList, L.T("All"), new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>@L.T("Mes_From")</label>
                                                    <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd") ?? "")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>@L.T("Mes_To")</label>
                                                    <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd") ?? "")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-1">
                                                    <label>&nbsp;</label>
                                                    <button type="submit" class="btn btn-primary btn-block">@L.T("Search")</button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- datatable start -->
                                    <div class="card-datatable table-responsive">
                                        <table id="qualityInspectionTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Date")</th>
                                                    <th>@L.T("Mes_Product")</th>
                                                    <th>@L.T("Mes_Qi_InspectedCol")</th>
                                                    <th>@L.T("Mes_Qi_Accepted")</th>
                                                    <th>@L.T("Mes_Qi_Status_REJECTED")</th>
                                                    <th>@L.T("Status")</th>
                                                    <th>@L.T("Actions")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@item.InspectionDate.ToString("dd.MM.yyyy")</td>
                                                            <td>@(item.PRODUCT != null ? item.PRODUCT.PNo : item.ProductID.ToString())</td>
                                                            <td>@item.QtyInspected.ToString("N3")</td>
                                                            <td>@item.QtyAccepted.ToString("N3")</td>
                                                            <td>@item.QtyRejected.ToString("N3")</td>
                                                            <td>
                                                                @{ var statusText = item.StatusCode == "APPROVED" ? L.T("Mes_Qi_Status_APPROVED") : item.StatusCode == "REJECTED" ? L.T("Mes_Qi_Status_REJECTED") : item.StatusCode == "DRAFT" ? L.T("Mes_Qi_Status_DRAFT") : item.StatusCode ?? "-"; }
                                                                <span class="badge badge-@(item.StatusCode == "APPROVED" ? "success" : item.StatusCode == "REJECTED" ? "danger" : "warning")">
                                                                    @statusText
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-info" title="@L.T("Details")">
                                                                    <i class="bx bx-show"></i> @L.T("Details")
                                                                </a>
                                                                @if (changePermit && item.StatusCode != "APPROVED")
                                                                {
                                                                    using (Html.BeginForm("Delete", "QualityInspection", new { id = item.ID }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('" + L.Js("Mes_Qi_ConfirmDelete") + "');" }))
                                                                    {
                                                                        @Html.AntiForgeryToken()
                                                                        <button type="submit" class="btn btn-sm btn-danger" title="@L.T("Delete")"><i class="bx bx-trash"></i></button>
                                                                    }
                                                                    using (Html.BeginForm("Approve", "QualityInspection", new { id = item.ID }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('" + L.Js("Mes_Qi_ConfirmApprove") + "');" }))
                                                                    {
                                                                        @Html.AntiForgeryToken()
                                                                        <button type="submit" class="btn btn-sm btn-success"><i class="bx bx-check"></i> @L.T("Approve")</button>
                                                                    }
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
    @section Scripts {
        <script>
            $(document).ready(function () {
                $('#qualityInspectionTable').DataTable({
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "@L.Js("All")"]],
                    "order": [[3, "desc"]],
                    "columnDefs": [
                        { "type": "date", "targets": 3 }
                    ],
                    "scrollX": true,
                    dom: 'lBfrtip',
                    buttons: erpDataTable.buttons({ fileName: '@L.Js("Mes_Qi_Title")', pdfTitle: '@L.Js("Mes_Qi_Title")' })
                });
            });
        </script>
    }

