@model tahsinERP.Models.QUALITY_INSPECTION
@{
    ViewBag.Title = L.T("Mes_Qi_DetailsTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool changePermit = ViewBag.ChangePermit as bool? ?? false;
}

<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/QualityInspection/Index">@L.T("Mes_Qi_Title")</a>
                                    </li>
                                    <li class="breadcrumb-item active">@L.T("Mes_Info")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                <h4 class="text-primary">@L.T("Mes_Qi_DetailsTitle")</h4>
                                                <hr />
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <p><strong>@L.T("Mes_Product"):</strong> @(Model.PRODUCT?.PNo ?? Model.ProductID.ToString()) - @(Model.PRODUCT?.Name ?? "")</p>
                                                        <p><strong>@L.T("Mes_Qi_InspectionDate"):</strong> @Model.InspectionDate.ToString("dd.MM.yyyy")</p>
                                                        <p><strong>@L.T("Mes_Qi_QtyInspected"):</strong> @Model.QtyInspected.ToString("N3")</p>
                                                        <p><strong>@L.T("Mes_Qi_QtyAccepted"):</strong> <span class="text-success">@Model.QtyAccepted.ToString("N3")</span></p>
                                                        <p><strong>@L.T("Mes_Qi_QtyRejected"):</strong> <span class="text-danger">@Model.QtyRejected.ToString("N3")</span></p>
                                                        @{ var defectTypeDisplay = Model.DEFECT_TYPES != null && !string.IsNullOrEmpty(Model.DEFECT_TYPES.DefectType) ? Model.DEFECT_TYPES.DefectType : "-"; }
                                                        <p><strong>@L.T("Mes_Dt_Name"):</strong> @defectTypeDisplay</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        @{ var statusDisplay = Model.StatusCode == "APPROVED" ? L.T("Mes_Qi_Status_APPROVED") : Model.StatusCode == "REJECTED" ? L.T("Mes_Qi_Status_REJECTED") : Model.StatusCode == "DRAFT" ? L.T("Mes_Qi_Status_DRAFT") : Model.StatusCode ?? "-"; }
                                                        <p><strong>@L.T("Status"):</strong> 
                                                            <span class="badge badge-@(Model.StatusCode == "APPROVED" ? "success" : Model.StatusCode == "REJECTED" ? "danger" : "warning")">
                                                                @statusDisplay
                                                            </span>
                                                        </p>
                                                        @if (Model.ApprovalDate.HasValue)
                                                        {
                                                            <p><strong>@L.T("Mes_Qi_ApprovalDate"):</strong> @Model.ApprovalDate.Value.ToString("dd.MM.yyyy")</p>
                                                        }
                                                        @if (Model.S_ORDERS != null)
                                                        {
                                                            <p><strong>@L.T("Mes_Order"):</strong> 
                                                                <a href="@Url.Action("Details", "SOrder", new { id = Model.SOrderID })">@Model.S_ORDERS.OrderNo</a>
                                                            </p>
                                                        }
                                                        @if (Model.PRODUCT_PRODUCTION != null && Model.ProductionID > 0)
                                                        {
                                                            <p><strong>@L.T("Mes_Qi_Production"):</strong> 
                                                                <a href="@Url.Action("Details", "ProductProduction", new { id = Model.ProductionID })">ID: @Model.ProductionID</a>
                                                            </p>
                                                        }
                                                        @if (!string.IsNullOrEmpty(Model.Notes))
                                                        {
                                                            <p><strong>@L.T("Mes_Qi_Notes"):</strong> @Model.Notes</p>
                                                        }
                                                    </div>
                                                </div>
                                                <hr />
                                                <div class="row mt-3">
                                                    <div class="col-12">
                                                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                                                            <i class="bx bx-arrow-back"></i> @L.T("Back")
                                                        </a>
                                                        @if (changePermit && Model.StatusCode != "APPROVED")
                                                        {
                                                            using (Html.BeginForm("Delete", "QualityInspection", new { id = Model.ID }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('" + L.Js("Mes_Qi_ConfirmDelete") + "');" }))
                                                            {
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-danger"><i class="bx bx-trash"></i> @L.T("Delete")</button>
                                                            }
                                                            using (Html.BeginForm("Approve", "QualityInspection", new { id = Model.ID }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('" + L.Js("Mes_Qi_ConfirmApprove") + "');" }))
                                                            {
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-success"><i class="bx bx-check"></i> @L.T("Approve")</button>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
        </div>
    </div>
</div>

