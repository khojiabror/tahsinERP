@model tahsinERP.ViewModels.SOrderViewModel
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SOrder/Index">Buyurtmalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Buyurtma tahrirlash
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Edit", "SOrder", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form repeater-default", @id = "orderForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row">
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="OrderNo">Buyurtma raqami</label>
                                                    @Html.TextBoxFor(model => model.OrderNo, new { @type = "text", @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.OrderNo, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="CustomerID">Haridor</label>
                                                    @Html.DropDownListFor(model => model.CustomerID, (SelectList)ViewBag.Customers, new { @class = "form-control select2", @id = "CustomerID", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.CustomerID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="ContractID">Shartnoma raqami</label>
                                                    @Html.DropDownListFor(model => model.ContractID, (SelectList)ViewBag.SContract, new { @class = "form-control select2", @id = "ContractID" })
                                                    @Html.ValidationMessageFor(model => model.ContractID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="IssuedDate">Buyurtma berilgan sanasi</label>
                                                    @Html.TextBoxFor(model => model.IssuedDate, "{0:yyyy-MM-dd}", new { @id = "IssuedDate", @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.IssuedDate, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-12 col-12 form-group">
                                                    <label for="Description">Qisqacha tavsifi</label>
                                                    @Html.TextAreaFor(model => model.Description, new { @type = "text", @class = "form-control", @placeholder = "Qisqacha tavsif kiriting", @rows = "2" })
                                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <br />
                                            <h4>Buyurtma maxsulotlari</h4>
                                            <div data-repeater-list="Parts">
                                                @if (Model.Products != null && Model.Products.Any())
                                                {
                                                    foreach (var product in Model.Products)
                                                    {
                                                        <div data-repeater-item>
                                                            <div class="row justify-content-between">
                                                                <div class="col-md-2 col-sm-12 form-group">
                                                                    <label>Maxsulot</label>
                                                                    <select name="ProductID" class="form-control select2 product-select" required>
                                                                        <option value="">---Tanlang---</option>
                                                                        @foreach (var p in ((SelectList)ViewBag.ProductList))
                                                                        {
                                                                            <option value="@p.Value" @(p.Value == product.ProductID.ToString() ? "selected" : "")>@p.Text</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                                <div class="col-md-2 col-sm-12 form-group">
                                                                    <label>O'lchov birligi</label>
                                                                    <select name="UnitID" class="form-control select2 unit-select" required>
                                                                        <option value="">---Tanlang---</option>
                                                                        @foreach (var unit in ((SelectList)ViewBag.Units))
                                                                        {
                                                                            <option value="@unit.Value" @(unit.Value == product.UnitID.ToString() ? "selected" : "")>@unit.Text</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                                <div class="col-md-2 col-sm-12 form-group">
                                                                    <label>Miqdori</label>
                                                                    <input type="number" name="Amount" class="form-control product-amount" value="@product.Amount" step="0.01" min="0.01" required />
                                                                </div>
                                                                <div class="col-md-2 col-sm-12 form-group">
                                                                    <label>Birlik narxi</label>
                                                                    <input type="number" name="Price" class="form-control product-price" value="@product.Price" step="0.01" min="0" required />
                                                                </div>
                                                                <div class="col-md-1 col-sm-12 form-group d-flex align-items-center pt-2">
                                                                    <button data-repeater-delete type="button" class="btn btn-danger">O'chirish</button>
                                                                </div>
                                                            </div>
                                                            <hr>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div data-repeater-item>
                                                        <div class="row justify-content-between">
                                                            <div class="col-md-2 col-sm-12 form-group">
                                                                <label>Maxsulot</label>
                                                                <select name="ProductID" class="form-control select2 product-select" required>
                                                                    <option value="">---Tanlang---</option>
                                                                    @foreach (var product in ((SelectList)ViewBag.ProductList))
                                                                    {
                                                                        <option value="@product.Value">@product.Text</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="col-md-2 col-sm-12 form-group">
                                                                <label>O'lchov birligi</label>
                                                                <select name="UnitID" class="form-control select2 unit-select" required>
                                                                    <option value="">---Tanlang---</option>
                                                                    @foreach (var unit in ((SelectList)ViewBag.Units))
                                                                    {
                                                                        <option value="@unit.Value">@unit.Text</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="col-md-2 col-sm-12 form-group">
                                                                <label>Miqdori</label>
                                                                <input type="number" name="Amount" class="form-control product-amount" placeholder="Miqdori" step="0.01" min="0.01" required />
                                                            </div>
                                                            <div class="col-md-2 col-sm-12 form-group">
                                                                <label>Birlik narxi</label>
                                                                <input type="number" name="Price" class="form-control product-price" placeholder="Birlik narxi" step="0.01" min="0" required />
                                                            </div>
                                                            <div class="col-md-1 col-sm-12 form-group d-flex align-items-center pt-2">
                                                                <button data-repeater-delete type="button" class="btn btn-danger">O'chirish</button>
                                                            </div>
                                                        </div>
                                                        <hr>
                                                    </div>
                                                }
                                            </div>

                                            <button data-repeater-create type="button" class="btn btn-primary">Yangi maxsulot qo'shish</button>

                                            <ul class="list-group list-group-flush">
                                                <li class="list-group-item border-0 pb-0">
                                                    <button class="btn btn-primary btn-block subtotal-preview-btn" type="submit">
                                                        <i class='bx bx-save'></i>
                                                        Saqlash
                                                    </button>
                                                </li>
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            if (typeof flatpickr !== 'undefined') {
                flatpickr("#IssuedDate", {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "d.m.Y",
                    locale: "uz"
                });
            }

            window.contractProducts = null;

            $('#ContractID').on('change', function () {
                var contractId = $(this).val();
                if (contractId && contractId != '0' && contractId != '') {
                    loadContractProducts(contractId);
                } else {
                    window.contractProducts = null;
                }
            });

            $(document).on('change', '.product-select', function () {
                var $row = $(this).closest('[data-repeater-item]');
                var productId = $(this).val();
                var contractId = $('#ContractID').val();

                if (contractId && contractId != '0' && contractId != '' && productId && productId != '0' && productId != '') {
                    loadProductPriceFromContract(contractId, parseInt(productId), $row);
                }
            });

            function loadContractProducts(contractId) {
                $.ajax({
                    url: '@Url.Action("GetContractProducts", "SOrder")',
                    type: 'GET',
                    data: { contractId: contractId },
                    success: function (data) {
                        if (data && data.length > 0) {
                            window.contractProducts = data;
                        }
                    },
                    error: function () {
                        window.contractProducts = null;
                    }
                });
            }

            function loadProductPriceFromContract(contractId, productId, $row) {
                if (!window.contractProducts) {
                    loadContractProducts(contractId);
                    setTimeout(function () {
                        loadProductPriceFromContract(contractId, productId, $row);
                    }, 500);
                    return;
                }

                var contractProduct = window.contractProducts.find(function (cp) {
                    return parseInt(cp.ProductID) === productId;
                });

                if (contractProduct) {
                    var $priceInput = $row.find('.product-price');
                    var price = parseFloat(contractProduct.PiecePrice) || 0;
                    $priceInput.val(price);

                    if (contractProduct.UnitID) {
                        var $unitSelect = $row.find('.unit-select');
                        $unitSelect.val(contractProduct.UnitID);
                        if ($unitSelect.hasClass('select2')) {
                            $unitSelect.select2('destroy');
                            $unitSelect.select2();
                        }
                    }
                }
            }

            // Load contract products if contract is already selected
            var contractId = $('#ContractID').val();
            if (contractId && contractId != '0' && contractId != '') {
                loadContractProducts(contractId);
            }
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
