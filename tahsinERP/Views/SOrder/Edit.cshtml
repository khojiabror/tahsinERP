@model tahsinERP.ViewModels.SOrderViewModel
@{
    ViewBag.Title = L.T("Crm_EditOrder");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SOrder/Index">@L.T("Menu_Orders")</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SOrder/Details/@Model.ID">@L.T("Crm_OrdDetailsTitle")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Edit")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="order-edit-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Edit", "SOrder", FormMethod.Post, new { @id = "orderForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(model => model.ID)
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <h4 class="mb-2">@L.T("Crm_MainInfo")</h4>
                                            <div class="row">
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="OrderNo">@L.T("Crm_OrderNo") <span class="text-danger">*</span></label>
                                                    @Html.TextBoxFor(model => model.OrderNo, new { @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.OrderNo, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="IssuedDate">@L.T("Crm_OrderDate") <span class="text-danger">*</span></label>
                                                    @Html.TextBoxFor(model => model.IssuedDate, "{0:yyyy-MM-dd}", new { @id = "IssuedDate", @class = "form-control", @type = "date", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.IssuedDate, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="CustomerID">@L.T("Crm_Customer") <span class="text-danger">*</span></label>
                                                    @Html.DropDownListFor(model => model.CustomerID, (SelectList)ViewBag.Customers, new { @class = "form-control select2", @id = "CustomerID", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.CustomerID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="ContractID">@L.T("Crm_ContractNo") <span class="text-danger">*</span></label>
                                                    @Html.DropDownListFor(model => model.ContractID, (SelectList)ViewBag.SContract, new { @class = "form-control select2", @id = "ContractID", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.ContractID, "", new { @class = "text-danger" })
                                                    <small class="form-text text-muted">@L.T("Crm_OrdSelectContractHint")</small>
                                                </div>
                                                <div class="col-md-12 col-12 form-group">
                                                    <label for="Description">@L.T("Crm_OrdShortDescription")</label>
                                                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = "2" })
                                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <hr class="my-2" />

                                            <h4 class="mb-2">@L.T("Crm_ContractProducts")</h4>
                                            <div id="productsContainer">
                                                <div class="alert alert-info">
                                                    <i class="bx bx-info-circle"></i> @L.T("Crm_OrdQtyOnlyHint")
                                                </div>
                                                <div class="table-responsive">
                                                    <table id="productsTable" class="table table-bordered table-striped doc-lines">
                                                        <thead class="thead-light">
                                                            <tr>
                                                                <th width="5%">№</th>
                                                                <th width="15%">@L.T("Crm_ProductCode")</th>
                                                                <th width="25%">@L.T("Crm_ProductName")</th>
                                                                <th width="10%">@L.T("Crm_UnitOfMeasure")</th>
                                                                <th width="12%">@L.T("Crm_OrdContractQty")</th>
                                                                <th width="12%">@L.T("Crm_OrdUnitPriceVat")</th>
                                                                <th width="15%">@L.T("Crm_OrderQty") <span class="text-danger">*</span></th>
                                                                <th width="10%">@L.T("Crm_TotalWithVat")</th>
                                                                <th width="8%">@L.T("Delete")</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="productsTableBody">
                                                            @if (Model.ProductQuantities != null && Model.ProductQuantities.Any())
                                                            {
                                                                int index = 0;
                                                                foreach (var product in Model.ProductQuantities)
                                                                {
                                                                    <tr>
                                                                        <td>@(index + 1)</td>
                                                                        <td>@product.ProductPNo</td>
                                                                        <td>@product.ProductName</td>
                                                                        <td>@product.UnitName</td>
                                                                        <td class="text-right">@product.ContractAmount.ToString("N2")</td>
                                                                        <td class="text-right">@((product.PiecePrice * (1 + product.VatRate / 100m)).ToString("N2"))</td>
                                                                        <td>
                                                                            <input type="hidden" name="ProductQuantities[@index].ContractProductID" value="@product.ContractProductID" />
                                                                            <input type="hidden" name="ProductQuantities[@index].ProductID" value="@product.ProductID" />
                                                                            <input type="hidden" name="ProductQuantities[@index].PiecePrice" value="@tahsinERP.Services.Crm.CrmNumber.ForInput(product.PiecePrice)" />
                                                                            <input type="hidden" name="ProductQuantities[@index].UnitID" value="@product.UnitID" />
                                                                            <input type="hidden" name="ProductQuantities[@index].VatRate" value="@product.VatRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                                                                            <input type="number" 
                                                                                   name="ProductQuantities[@index].OrderQuantity" 
                                                                                   class="form-control order-quantity" 
                                                                                   value="@(product.OrderQuantity > 0 ? tahsinERP.Services.Crm.CrmNumber.ForInput(product.OrderQuantity) : "")" 
                                                                                   step="0.01" 
                                                                                   min="0.01" 
                                                                                   data-price="@tahsinERP.Services.Crm.CrmNumber.ForInput(product.PiecePrice)"
                                                                                   data-vat-rate="@product.VatRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                                                   required />
                                                                        </td>
                                                                        @{
                                                                            var lineBase = product.OrderQuantity * product.PiecePrice;
                                                                            var lineTotal = lineBase + (lineBase * product.VatRate / 100m);
                                                                        }
                                                                        <td class="text-right total-price">@lineTotal.ToString("N2")</td>
                                                                        <td class="text-center">
                                                                            <button type="button" class="btn btn-sm btn-outline-danger remove-product" title="@L.T("Delete")">
                                                                                <i class="bx bx-trash"></i>
                                                                            </button>
                                                                        </td>
                                                                    </tr>
                                                                    index++;
                                                                }
                                                            }
                                                        </tbody>
                                                        <tfoot>
                                                            <tr class="font-weight-bold">
                                                                <td colspan="7" class="text-right">@L.T("Crm_TotalAmount"):</td>
                                                                <td class="text-right" id="grandTotal">@(Model.Amount?.ToString("N2") ?? "0.00")</td>
                                                            </tr>
                                                        </tfoot>
                                                    </table>
                                                </div>
                                            </div>

                                            <div class="row mt-2">
                                                <div class="col-12">
                                                    <button type="submit" class="btn btn-primary btn-lg">
                                                        <i class="bx bx-save"></i> @L.T("Save")
                                                    </button>
                                                    <a href="@Url.Action("Details", new { id = Model.ID })" class="btn btn-secondary btn-lg">
                                                        <i class="bx bx-x"></i> @L.T("Cancel")
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section scripts {
        <script type="application/json" id="salesOrderFormConfig">@Html.Raw(Json.Encode(new {
            contractsUrl = Url.Action("GetContractsByCustomer", "SOrder"),
            productsUrl = Url.Action("GetContractProducts", "SOrder"),
            showStatus = false,
            handleErrors = false,
            resetContractsOnEmptyCustomer = false,
            emptyContractsOption = false,
            loadContractsOnInit = false,
            recalcOnInit = true,
            requireQuantity = false
        }))</script>
        <script src="@Url.Content("~/Scripts/crm/sales-order-form.js")"></script>
    }
}
