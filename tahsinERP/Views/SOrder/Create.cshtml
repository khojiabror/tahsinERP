@model tahsinERP.ViewModels.SOrderViewModel
@{
    ViewBag.Title = "Buyurtma yaratish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SOrder/Index">Buyurtmalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Buyurtma yaratish
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="order-create-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Create", "SOrder", FormMethod.Post, new { @id = "orderForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <h4 class="mb-2">Asosiy ma'lumotlar</h4>
                                            <div class="row">
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="OrderNo">Buyurtma raqami <span class="text-danger">*</span></label>
                                                    @Html.TextBoxFor(model => model.OrderNo, new { @class = "form-control", @placeholder = "Buyurtma raqamini kiriting", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.OrderNo, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="IssuedDate">Buyurtma sanasi <span class="text-danger">*</span></label>
                                                    @Html.TextBoxFor(model => model.IssuedDate, "{0:yyyy-MM-dd}", new { @id = "IssuedDate", @class = "form-control", @type = "date", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.IssuedDate, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="CustomerID">Haridor <span class="text-danger">*</span></label>
                                                    @Html.DropDownListFor(model => model.CustomerID, (SelectList)ViewBag.Customers, new { @class = "form-control select2", @id = "CustomerID", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.CustomerID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="ContractID">Shartnoma raqami <span class="text-danger">*</span></label>
                                                    @Html.DropDownListFor(model => model.ContractID, (SelectList)ViewBag.SContract, new { @class = "form-control select2", @id = "ContractID", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.ContractID, "", new { @class = "text-danger" })
                                                    <small class="form-text text-muted">Shartnoma tanlang, maxsulotlar avtomatik yuklanadi</small>
                                                </div>
                                                <div class="col-md-12 col-12 form-group">
                                                    <label for="Description">Qisqacha tavsifi</label>
                                                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @placeholder = "Qisqacha tavsif kiriting", @rows = "2" })
                                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <hr class="my-2" />

                                            <h4 class="mb-2">Shartnoma maxsulotlari</h4>
                                            <div id="productsContainer" style="display: none;">
                                                <div class="alert alert-info">
                                                    <i class="bx bx-info-circle"></i> Faqat buyurtma miqdorini kiriting. Narxlar shartnomadan avtomatik olinadi.
                                                </div>
                                                <div class="table-responsive">
                                                    <table id="productsTable" class="table table-bordered table-striped">
                                                        <thead class="thead-light">
                                                            <tr>
                                                                <th width="5%">№</th>
                                                                <th width="15%">Maxsulot kodi</th>
                                                                <th width="25%">Maxsulot nomi</th>
                                                                <th width="10%">O'lchov birligi</th>
                                                                <th width="12%">Shartnoma miqdori</th>
                                                                <th width="12%">Birlik narxi</th>
                                                                <th width="15%">Buyurtma miqdori <span class="text-danger">*</span></th>
                                                                <th width="10%">Jami</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="productsTableBody">
                                                            @if (Model.ProductQuantities != null && Model.ProductQuantities.Any())
                                                            {
                                                                int index = 0;
                                                                foreach (var product in Model.ProductQuantities)
                                                                {
                                                                    <tr>
                                                                        <td>@(index + 1)</td>
                                                                        <td>@product.ProductPNo</td>
                                                                        <td>@product.ProductName</td>
                                                                        <td>@product.UnitName</td>
                                                                        <td class="text-right">@product.ContractAmount.ToString("N2")</td>
                                                                        <td class="text-right">@product.PiecePrice.ToString("N2")</td>
                                                                        <td>
                                                                            <input type="hidden" name="ProductQuantities[@index].ContractProductID" value="@product.ContractProductID" />
                                                                            <input type="hidden" name="ProductQuantities[@index].ProductID" value="@product.ProductID" />
                                                                            <input type="hidden" name="ProductQuantities[@index].PiecePrice" value="@product.PiecePrice" />
                                                                            <input type="hidden" name="ProductQuantities[@index].UnitID" value="@product.UnitID" />
                                                                            <input type="number" 
                                                                                   name="ProductQuantities[@index].OrderQuantity" 
                                                                                   class="form-control order-quantity" 
                                                                                   value="@product.OrderQuantity.ToString("N2")" 
                                                                                   step="0.01" 
                                                                                   min="0.01" 
                                                                                   data-price="@product.PiecePrice"
                                                                                   required />
                                                                        </td>
                                                                        <td class="text-right total-price">0.00</td>
                                                                    </tr>
                                                                    index++;
                                                                }
                                                            }
                                                        </tbody>
                                                        <tfoot>
                                                            <tr class="font-weight-bold">
                                                                <td colspan="7" class="text-right">Jami summa:</td>
                                                                <td class="text-right" id="grandTotal">0.00</td>
                                                            </tr>
                                                        </tfoot>
                                                    </table>
                                                </div>
                                            </div>
                                            <div id="noProductsMessage" class="alert alert-warning" style="display: none;">
                                                <i class="bx bx-info-circle"></i> Shartnoma tanlang, maxsulotlar yuklanadi.
                                            </div>

                                            <div class="row mt-2">
                                                <div class="col-12">
                                                    <button type="submit" class="btn btn-primary btn-lg">
                                                        <i class="bx bx-save"></i> Saqlash va yetkazib berish rejasiga o'tish
                                                    </button>
                                                    <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                                                        <i class="bx bx-x"></i> Bekor qilish
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@section scripts {
    <script type="text/javascript">
        $(document).ready(function() {
            // Select2 ni ishga tushirish (agar mavjud bo'lsa)
            if (typeof $.fn.select2 !== 'undefined') {
                $('#CustomerID, #ContractID').select2({ width: '100%' });
            }

            // Xaridor o'zgarganda shartnomalarni yuklash
            $('#CustomerID').on('change', function() {
                var customerId = $(this).val();
                
                if (customerId && customerId != '0') {
                    loadContracts(customerId);
                } else {
                    $('#ContractID').empty().append('<option value="0">---Tanlang---</option>');
                    if (typeof $.fn.select2 !== 'undefined') {
                        $('#ContractID').select2('destroy').select2({ width: '100%' });
                    }
                    $('#productsContainer').hide();
                    $('#noProductsMessage').html('<i class="bx bx-info-circle"></i> Xaridor tanlang, keyin shartnoma tanlang.').show();
                }
            });

            // Shartnoma o'zgarganda mahsulotlarni yuklash
            $('#ContractID').on('change', function() {
                var contractId = $(this).val();
                
                if (contractId && contractId != '0') {
                    loadProducts(contractId);
                } else {
                    $('#productsContainer').hide();
                    $('#noProductsMessage').html('<i class="bx bx-info-circle"></i> Shartnoma tanlang, maxsulotlar yuklanadi.').show();
                }
            });

            // Shartnomalarni yuklash funksiyasi
            function loadContracts(customerId) {
                var $select = $('#ContractID');
                $select.prop('disabled', true).html('<option value="0">Yuklanmoqda...</option>');
                
                $.ajax({
                    url: '@Url.Action("GetContractsByCustomer", "SOrder")',
                    type: 'GET',
                    data: { customerId: customerId },
                    dataType: 'json',
                    success: function(data) {
                        $select.empty().append('<option value="0">---Tanlang---</option>');
                        
                        if (data && data.length > 0) {
                            $.each(data, function(i, contract) {
                                $select.append('<option value="' + contract.ID + '">' + contract.ContractNo + '</option>');
                            });
                        } else {
                            $select.append('<option value="0">Shartnomalar topilmadi</option>');
                        }
                        
                        if (typeof $.fn.select2 !== 'undefined') {
                            $select.select2('destroy').select2({ width: '100%' });
                        }
                        $select.prop('disabled', false);
                        
                        $('#productsContainer').hide();
                        $('#noProductsMessage').html('<i class="bx bx-info-circle"></i> Shartnoma tanlang, maxsulotlar yuklanadi.').show();
                    },
                    error: function() {
                        $select.empty().append('<option value="0">Xatolik yuz berdi</option>');
                        $select.prop('disabled', false);
                        alert('Shartnomalarni yuklashda xatolik yuz berdi.');
                    }
                });
            }

            // Mahsulotlarni yuklash funksiyasi
            function loadProducts(contractId) {
                $('#productsContainer').hide();
                $('#noProductsMessage').html('<i class="bx bx-loader bx-spin"></i> Maxsulotlar yuklanmoqda...').show();

                $.ajax({
                    url: '@Url.Action("GetContractProducts", "SOrder")',
                    type: 'GET',
                    data: { contractId: contractId },
                    dataType: 'json',
                    success: function(data) {
                        if (data && data.length > 0) {
                            var tbody = $('#productsTableBody');
                            tbody.empty();
                            
                            $.each(data, function(index, product) {
                                var row = '<tr>' +
                                    '<td>' + (index + 1) + '</td>' +
                                    '<td>' + (product.ProductPNo || '') + '</td>' +
                                    '<td>' + (product.ProductName || '') + '</td>' +
                                    '<td>' + (product.UnitName || '') + '</td>' +
                                    '<td class="text-right">' + parseFloat(product.ContractAmount || 0).toFixed(2) + '</td>' +
                                    '<td class="text-right">' + parseFloat(product.PiecePrice || 0).toFixed(2) + '</td>' +
                                    '<td>' +
                                    '<input type="hidden" name="ProductQuantities[' + index + '].ContractProductID" value="' + (product.ContractProductID || '') + '" />' +
                                    '<input type="hidden" name="ProductQuantities[' + index + '].ProductID" value="' + (product.ProductID || '') + '" />' +
                                    '<input type="hidden" name="ProductQuantities[' + index + '].PiecePrice" value="' + (product.PiecePrice || 0) + '" />' +
                                    '<input type="hidden" name="ProductQuantities[' + index + '].UnitID" value="' + (product.UnitID || '') + '" />' +
                                    '<input type="number" name="ProductQuantities[' + index + '].OrderQuantity" class="form-control order-quantity" value="0" step="0.01" min="0.01" data-price="' + (product.PiecePrice || 0) + '" required />' +
                                    '</td>' +
                                    '<td class="text-right total-price">0.00</td>' +
                                    '</tr>';
                                tbody.append(row);
                            });
                            
                            $('#productsContainer').show();
                            $('#noProductsMessage').hide();
                            calculateTotal();
                        } else {
                            $('#productsContainer').hide();
                            $('#noProductsMessage').html('<i class="bx bx-info-circle"></i> Bu shartnomada maxsulotlar topilmadi.').show();
                        }
                    },
                    error: function() {
                        $('#productsContainer').hide();
                        $('#noProductsMessage').html('<i class="bx bx-error"></i> Maxsulotlarni yuklashda xatolik yuz berdi.').show();
                    }
                });
            }

            // Jami summani hisoblash
            function calculateTotal() {
                var total = 0;
                $('.total-price').each(function() {
                    total += parseFloat($(this).text()) || 0;
                });
                $('#grandTotal').text(total.toFixed(2));
            }

            // Miqdor o'zgarganda jami summani yangilash
            $(document).on('input', '.order-quantity', function() {
                var $row = $(this).closest('tr');
                var qty = parseFloat($(this).val()) || 0;
                var price = parseFloat($(this).data('price')) || 0;
                $row.find('.total-price').text((qty * price).toFixed(2));
                calculateTotal();
            });

            // Form yuborishdan oldin tekshirish
            $('#orderForm').on('submit', function(e) {
                var hasQty = false;
                $('.order-quantity').each(function() {
                    if (parseFloat($(this).val()) > 0) {
                        hasQty = true;
                        return false;
                    }
                });
                
                if (!hasQty) {
                    e.preventDefault();
                    alert('Kamida bitta maxsulot uchun miqdor kiritish kerak!');
                    return false;
                }
            });

            // Sahifa yuklanganda, agar xaridor tanlangan bo'lsa shartnomalarni yuklash
            var initialCustomerId = $('#CustomerID').val();
            if (initialCustomerId && initialCustomerId != '0') {
                loadContracts(initialCustomerId);
            }
        });
    </script>
}
