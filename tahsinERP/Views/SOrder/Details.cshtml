@model tahsinERP.Models.S_ORDERS
@{
    ViewBag.Title = L.T("Details");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsPermittedForAction(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString(), true);

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SOrder">@L.T("Menu_Orders")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Crm_OrdDetailsTitle")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                @if (TempData["Success"] != null)
                                                {
                                                    <div class="alert alert-success" role="alert">@TempData["Success"]</div>
                                                }
                                                @if (TempData["ErrorMessage"] != null)
                                                {
                                                    <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
                                                }
                                                <h4 class="text-primary">@L.T("Crm_OrdDetailsTitle")</h4>
                                                <hr />
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <span><b>@L.T("Crm_OrderNo")</b>: @Html.DisplayFor(model => model.OrderNo)</span><br />
                                                        <span><b>@L.T("Crm_OrdIssuedDate")</b>: @Model.IssuedDate.ToString("dd.MM.yyyy")</span><br />
                                                        <span><b>@L.T("Crm_Client")</b>: 
                                                            @if (Model.CUSTOMER != null)
                                                            {
                                                                <a href="@Url.Action("Details", "Customer", new { id = Model.CustomerID })">@Model.CUSTOMER.Name</a>
                                                            }
                                                        </span><br />
                                                        <span><b>@L.T("Crm_Contract")</b>: 
                                                            @if (Model.S_CONTRACTS != null && Model.ContractID > 0)
                                                            {
                                                                <a href="@Url.Action("Details", "SContract", new { id = Model.ContractID })">@Model.S_CONTRACTS.ContractNo</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">-</span>
                                                            }
                                                        </span><br />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <span><b>@L.T("Amount")</b>: @(Model.Amount?.ToString("N2") ?? "0.00") @(Model.CURRENCy1?.Shortname ?? "")</span><br />
                                                        <span><b>@L.T("Currency")</b>: @(Model.CURRENCy1?.Shortname ?? "")</span><br />
                                                        <span><b>@L.T("Description")</b>: @Html.DisplayFor(model => model.Description)</span><br />
                                                    </div>
                                                </div>
                                                <hr />

                                                <!-- Navigation Links -->
                                                <div class="row mt-3">
                                                    <div class="col-12">
                                                        <h5 class="text-primary mb-3">@L.T("Crm_RelatedDocs")</h5>
                                                        <div class="btn-group" role="group">
                                                            <a href="@Url.Action("DeliverySchedule", "SOrder", new { orderID = Model.ID })" class="btn btn-outline-primary">
                                                                <i class="bx bx-calendar"></i> @L.T("Crm_OrdDeliverySchedule") (@(ViewBag.DeliveryScheduleCount ?? 0))
                                                            </a>
                                                            <a href="@Url.Action("Index", "SalesInvoices", new { orderID = Model.ID })" class="btn btn-outline-primary">
                                                                <i class="bx bx-receipt"></i> @L.T("Menu_Invoices") (@ViewBag.InvoicesCount)
                                                            </a>
                                                            @if (Model.S_CONTRACTS != null && Model.ContractID > 0)
                                                            {
                                                                <a href="@Url.Action("Details", "SContract", new { id = Model.ContractID })" class="btn btn-outline-primary">
                                                                    <i class="bx bx-file"></i> @L.T("Crm_Contract")
                                                                </a>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <hr>

                                        <!-- Order Products -->
                                        <section id="column-selectors">
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="card">
                                                        <div class="card-header">
                                                            <h4 class="card-title">@L.T("Crm_OrdOrderProducts")</h4>
                                                        </div>
                                                        <div class="card-content">
                                                            <div class="card-body card-dashboard">
                                                                <div class="table-responsive">
                                                                    <table class="table table-striped" style="width:100%">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>@L.T("Crm_ProductNo")</th>
                                                                                <th>@L.T("Crm_OrdPriceVat")</th>
                                                                                <th>@L.T("Quantity")</th>
                                                                                <th>@L.T("Crm_UnitOfMeasure")</th>
                                                                                <th>@L.T("Crm_TotalWithVat")</th>
                                                                                <th>MOQ</th>
                                                                                <th>@L.T("Crm_OrdDeliverySchedule")</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @{
                                                                                var productVatRates = ViewBag.ProductVatRates as Dictionary<int, decimal>;
                                                                            }
                                                                            @foreach (var item in Model.S_ORDER_PRODUCTS)
                                                                            {
                                                                                var scheduleSummary = ViewBag.ScheduleSummary as Dictionary<int, tahsinERP.ViewModels.ScheduleSummaryDto>;
                                                                                var summary = scheduleSummary != null && scheduleSummary.ContainsKey(item.ID) ? scheduleSummary[item.ID] : null;
                                                                                // Shartnoma QQS foizi; 0 bo'lsa narxlar QQSsiz ko'rsatiladi
                                                                                var vatRate = productVatRates != null && productVatRates.ContainsKey(item.ProductID) ? productVatRates[item.ProductID] : 0m;
                                                                                var priceWithVat = item.Price * (1 + vatRate / 100m);
                                                                                var lineTotalWithVat = item.TotalPrice * (1 + vatRate / 100m);
                                                                                <tr>
                                                                                    <td>
                                                                                        @if (item.PRODUCT != null)
                                                                                        {
                                                                                            <a href="@Url.Action("Details", "Product", new { id = item.ProductID })">@item.PRODUCT.PNo</a>
                                                                                        }
                                                                                    </td>
                                                                                    <td>@priceWithVat.ToString("N2")</td>
                                                                                    <td>@item.Amount.ToString("N2")</td>
                                                                                    <td>@(item.UNIT?.ShortName ?? "")</td>
                                                                                    <td>@lineTotalWithVat.ToString("N2")</td>
                                                                                    <td>@(item.MOQ?.ToString("N2") ?? "-")</td>
                                                                                    <td>
                                                                                        @if (summary != null)
                                                                                        {
                                                                                            <span class="badge badge-info">
                                                                                                @L.T("Crm_OrdPlanned"): @summary.TotalPlanned.ToString("N2")<br />
                                                                                                @L.T("Crm_OrdShipped"): @summary.TotalShipped.ToString("N2")
                                                                                            </span>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            if ((ViewBag.DeliveryScheduleCount ?? 0) > 0)
                                                                                            {
                                                                                                <a href="@Url.Action("DeliverySchedule", "SOrder", new { orderID = Model.ID })">@L.T("Crm_OrdPlan")</a>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <span class="text-muted">@L.T("Crm_OrdNoPlan")</span>
                                                                                            }
                                                                                        }
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
