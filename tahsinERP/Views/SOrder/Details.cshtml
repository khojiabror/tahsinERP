@model tahsinERP.Models.S_ORDERS
@{
    ViewBag.Title = "Batafsil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SOrder">Buyurtmalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Buyurtma ma'lumotlari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                <h4 class="text-primary">Buyurtma ma'lumotlari</h4>
                                                <hr />
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <span><b>Buyurtma raqami</b>: @Html.DisplayFor(model => model.OrderNo)</span><br />
                                                        <span><b>Tuzilgan sanasi</b>: @Model.IssuedDate.ToString("dd.MM.yyyy")</span><br />
                                                        <span><b>Mijoz</b>: 
                                                            @if (Model.CUSTOMER != null)
                                                            {
                                                                <a href="@Url.Action("Details", "Customer", new { id = Model.CustomerID })">@Model.CUSTOMER.Name</a>
                                                            }
                                                        </span><br />
                                                        <span><b>Shartnoma</b>: 
                                                            @if (Model.S_CONTRACTS != null && Model.ContractID > 0)
                                                            {
                                                                <a href="@Url.Action("Details", "SContract", new { id = Model.ContractID })">@Model.S_CONTRACTS.ContractNo</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">-</span>
                                                            }
                                                        </span><br />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <span><b>Summa</b>: @(Model.Amount?.ToString("N2") ?? "0.00") @(Model.CURRENCy1?.Shortname ?? "")</span><br />
                                                        <span><b>Valyuta</b>: @(Model.CURRENCy1?.Shortname ?? "")</span><br />
                                                        <span><b>Tavsif</b>: @Html.DisplayFor(model => model.Description)</span><br />
                                                    </div>
                                                </div>
                                                <hr />

                                                <!-- Navigation Links -->
                                                <div class="row mt-3">
                                                    <div class="col-12">
                                                        <h5 class="text-primary mb-3">Bog'liq hujjatlar</h5>
                                                        <div class="btn-group" role="group">
                                                            <a href="@Url.Action("DeliverySchedule", "SOrder", new { orderID = Model.ID })" class="btn btn-outline-primary">
                                                                <i class="bx bx-calendar"></i> Yetkazib berish rejasi (@(ViewBag.DeliveryScheduleCount ?? 0))
                                                            </a>
                                                            <a href="@Url.Action("Index", "SalesInvoices", new { orderID = Model.ID })" class="btn btn-outline-primary">
                                                                <i class="bx bx-receipt"></i> Invoyslar (@ViewBag.InvoicesCount)
                                                            </a>
                                                            @if (Model.S_CONTRACTS != null && Model.ContractID > 0)
                                                            {
                                                                <a href="@Url.Action("Details", "SContract", new { id = Model.ContractID })" class="btn btn-outline-primary">
                                                                    <i class="bx bx-file"></i> Shartnoma
                                                                </a>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <hr>

                                        <!-- Order Products -->
                                        <section id="column-selectors">
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="card">
                                                        <div class="card-header">
                                                            <h4 class="card-title">Buyurtma mahsulotlari</h4>
                                                        </div>
                                                        <div class="card-content">
                                                            <div class="card-body card-dashboard">
                                                                <div class="table-responsive">
                                                                    <table class="table table-striped" style="width:100%">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Mahsulot raqami</th>
                                                                                <th>Narx</th>
                                                                                <th>Miqdori</th>
                                                                                <th>O'lchov birligi</th>
                                                                                <th>Jami</th>
                                                                                <th>MOQ</th>
                                                                                <th>Yetkazib berish rejasi</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var item in Model.S_ORDER_PRODUCTS)
                                                                            {
                                                                                var scheduleSummary = ViewBag.ScheduleSummary as Dictionary<int, dynamic>;
                                                                                // Ensure we check the correct key - SOrderProductID should match S_ORDER_PRODUCTS.ID
                                                                                var summary = scheduleSummary != null && scheduleSummary.ContainsKey(item.ID) ? scheduleSummary[item.ID] : null;
                                                                                <tr>
                                                                                    <td>
                                                                                        @if (item.PRODUCT != null)
                                                                                        {
                                                                                            <a href="@Url.Action("Details", "Product", new { id = item.ProductID })">@item.PRODUCT.PNo</a>
                                                                                        }
                                                                                    </td>
                                                                                    <td>@item.Price.ToString("N2")</td>
                                                                                    <td>@item.Amount.ToString("N2")</td>
                                                                                    <td>@(item.UNIT?.ShortName ?? "")</td>
                                                                                    <td>@item.TotalPrice.ToString("N2")</td>
                                                                                    <td>@(item.MOQ?.ToString("N2") ?? "-")</td>
                                                                                    <td>
                                                                                        @if (summary != null)
                                                                                        {
                                                                                            <span class="badge badge-info">
                                                                                                Rejalashtirilgan: @summary.TotalPlanned.ToString("N2")<br />
                                                                                                Yetkazilgan: @summary.TotalShipped.ToString("N2")
                                                                                            </span>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            if ((ViewBag.DeliveryScheduleCount ?? 0) > 0)
                                                                                            {
                                                                                                <a href="@Url.Action("DeliverySchedule", "SOrder", new { orderID = Model.ID })">Reja</a>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <span class="text-muted">Reja yo'q</span>
                                                                                            }
                                                                                        }
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
