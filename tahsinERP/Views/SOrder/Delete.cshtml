@model tahsinERP.Models.S_ORDERS
@{
    ViewBag.Title = L.T("Crm_OrdDeleteTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SOrder/Index">@L.T("Menu_Orders")</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SOrder/Details/@Model.ID">@L.T("Crm_OrdDetailsTitle")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Delete")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-xl-11 col-md-8 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body pb-0 mx-25">
                                    <div class="alert alert-warning">
                                        <h4 class="alert-heading"><i class="bx bx-error"></i> @L.T("Crm_Attention")</h4>
                                        <p>@L.T("Crm_OrdDeleteConfirmText")</p>
                                    </div>

                                    <div class="row invoice-info">
                                        <div class="col-lg-12 col-md-6 mt-25">
                                            <h4 class="text-primary">@L.T("Crm_OrdDetailsTitle")</h4>
                                            <hr />
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <p><b>@L.T("Crm_OrderNo"):</b> @Model.OrderNo</p>
                                                    <p><b>@L.T("Crm_OrdIssuedDate"):</b> @Model.IssuedDate.ToString("dd.MM.yyyy")</p>
                                                    <p><b>@L.T("Crm_Client"):</b> 
                                                        @if (Model.CUSTOMER != null)
                                                        {
                                                            @Model.CUSTOMER.Name
                                                        }
                                                    </p>
                                                    <p><b>@L.T("Crm_Contract"):</b> 
                                                        @if (Model.S_CONTRACTS != null && Model.ContractID > 0)
                                                        {
                                                            @Model.S_CONTRACTS.ContractNo
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </p>
                                                </div>
                                                <div class="col-md-6">
                                                    <p><b>@L.T("Amount"):</b> @(Model.Amount?.ToString("N2") ?? "0.00") @(Model.CURRENCy1?.Shortname ?? "")</p>
                                                    <p><b>@L.T("Currency"):</b> @(Model.CURRENCy1?.Shortname ?? "")</p>
                                                    <p><b>@L.T("Description"):</b> @(Model.Description ?? "-")</p>
                                                </div>
                                            </div>
                                            <hr />
                                        </div>
                                    </div>

                                    @if (Model.S_ORDER_PRODUCTS != null && Model.S_ORDER_PRODUCTS.Any())
                                    {
                                        <section id="column-selectors">
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="card">
                                                        <div class="card-header">
                                                            <h4 class="card-title">@L.T("Crm_OrdOrderProductsCount", Model.S_ORDER_PRODUCTS.Count)</h4>
                                                        </div>
                                                        <div class="card-content">
                                                            <div class="card-body card-dashboard">
                                                                <div class="table-responsive">
                                                                    <table class="table table-striped" style="width:100%">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>@L.T("Crm_ProductCode")</th>
                                                                                <th>@L.T("Crm_ProductName")</th>
                                                                                <th>@L.T("Crm_OrdUnitPriceVat")</th>
                                                                                <th>@L.T("Crm_UnitOfMeasure")</th>
                                                                                <th>@L.T("Quantity")</th>
                                                                                <th>@L.T("Crm_TotalWithVat")</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @{
                                                                                var productVatRates = ViewBag.ProductVatRates as Dictionary<int, decimal>;
                                                                            }
                                                                            @foreach (var item in Model.S_ORDER_PRODUCTS)
                                                                            {
                                                                                // Shartnoma QQS foizi; 0 bo'lsa narxlar QQSsiz ko'rsatiladi
                                                                                var vatRate = productVatRates != null && productVatRates.ContainsKey(item.ProductID) ? productVatRates[item.ProductID] : 0m;
                                                                                var priceWithVat = item.Price * (1 + vatRate / 100m);
                                                                                var lineTotalWithVat = item.TotalPrice * (1 + vatRate / 100m);
                                                                                <tr>
                                                                                    <td>@(item.PRODUCT?.PNo ?? "-")</td>
                                                                                    <td>@(item.PRODUCT?.Name ?? "-")</td>
                                                                                    <td>@priceWithVat.ToString("N2")</td>
                                                                                    <td>@(item.UNIT?.ShortName ?? "-")</td>
                                                                                    <td>@item.Amount.ToString("N2")</td>
                                                                                    <td>@lineTotalWithVat.ToString("N2")</td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>
                                    }

                                    <ul class="list-group list-group-flush mt-3">
                                        <li class="list-group-item border-0 pb-0">
                                            @using (Html.BeginForm("Delete", "SOrder", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.HiddenFor(model => model.ID)
                                                <button class="btn btn-danger btn-block subtotal-preview-btn" type="submit" onclick="return confirm('@L.Js("Crm_OrdDeleteConfirmJs")')">
                                                    <i class='bx bx-trash'></i>
                                                    @L.T("Crm_YesDelete")
                                                </button>
                                                <a href="@Url.Action("Details", new { id = Model.ID })" class="btn btn-secondary btn-block mt-2">
                                                    <i class='bx bx-x'></i>
                                                    @L.T("Cancel")
                                                </a>
                                            }
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
