@model List<tahsinERP.Models.S_ORDERS>
@{
    ViewBag.Title = "Ro'yxat";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    bool changePermit = false;
    if (tahsinERP.Models.RoleHelper.IsPermittedForAction(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString(), true))
    {
        changePermit = true;
    }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Sotuv buyurtmalari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "SOrder")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi buyurtma
                            </a>
                        </div>
                    }

                    <!-- Filters -->
                    <div class="users-list-filter px-1">
                        @using (Html.BeginForm("Index", "SOrder", FormMethod.Get, new { @class = "form" }))
                        {
                            <div class="row border rounded py-2 mb-2">
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label>Qidirish</label>
                                    <input type="text" name="searchTerm" class="form-control" placeholder="Buyurtma raqami..." value="@ViewBag.SearchTerm" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Mijoz</label>
                                    @Html.DropDownList("customerID", ViewBag.Customers as SelectList, "Barchasi", new { @class = "form-control" })
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Shartnoma</label>
                                    @Html.DropDownList("contractID", ViewBag.Contracts as SelectList, "Barchasi", new { @class = "form-control" })
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Dan</label>
                                    <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Gacha</label>
                                    <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-1 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bx bx-search"></i> Qidirish
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="orderDataTable" data-crm-table data-lock-last="@(changePermit ? "true" : "false")" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Buyurtma raqami</th>
                                                    <th>Mijoz</th>
                                                    <th>Shartnoma</th>
                                                    <th>Sana</th>
                                                    <th>Summa</th>
                                                    <th>Valyuta</th>
                                                    @if (changePermit)
                                                    {
                                                        <th class="text-center">Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "SOrder", new { id = item.ID })" class="font-weight-bold">
                                                                    @item.OrderNo
                                                                </a>
                                                            </td>
                                                            <td>
                                                                @if (item.CUSTOMER != null)
                                                                {
                                                                    <a href="@Url.Action("Details", "Customer", new { id = item.CustomerID })" class="font-weight-bold">
                                                                        @(item.CUSTOMER.Name ?? "")
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (item.S_CONTRACTS != null && item.ContractID > 0)
                                                                {
                                                                    <a href="@Url.Action("Details", "SContract", new { id = item.ContractID })" class="font-weight-bold">
                                                                        @item.S_CONTRACTS.ContractNo
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            <td>@item.IssuedDate.ToString("dd.MM.yyyy")</td>
                                                            <td>@(item.Amount?.ToString("N2") ?? "0.00")</td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(item.CURRENCy1?.Shortname))
                                                                {
                                                                    <span class="badge badge-light-primary">@item.CURRENCy1.Shortname</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            @if (changePermit)
                                                            {
                                                                <td class="text-center">
                                                                    <a href="@Url.Action("Edit", "SOrder", new { id = item.ID })" 
                                                                       class="btn btn-sm btn-outline-primary" title="Tahrirlash">
                                                                        <i class="bx bx-edit"></i>
                                                                    </a>
                                                                    <a href="@Url.Action("Delete", "SOrder", new { id = item.ID })" 
                                                                       class="btn btn-sm btn-outline-danger" title="O'chirish">
                                                                        <i class="bx bx-trash"></i>
                                                                    </a>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    @Html.Partial("~/Views/SalesInvoices/_Pager.cshtml")
                                    <div class="text-right mt-1">
                                        <a class="btn btn-sm btn-success" href="@(Url.Action("ExportExcel", "SOrder") + Request.Url.Query)"><i class="bx bxs-file-excel"></i> Excel (barchasi)</a>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script src="@Url.Content("~/Scripts/crm/crm-page-table.js")"></script>
}
