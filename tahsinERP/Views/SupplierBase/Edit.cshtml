@model tahsinERP.Models.SUPPLIER_BASE
@{
    ViewBag.Title = L.T("Edit");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("Edit", "SupplierBase", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ID)
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/SupplierBase/Index">@L.T("Menu_Directory")</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            @L.T("Srm_EditNamed", Model.CompanyName)
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="basic-select2">
                        <div class="row">
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            <div class="row">
                                                <div class="col-lg-12 col-md-6 mt-25">
                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                    <hr>
                                                    <h6 class="invoice-to">@L.T("Srm_CompanyShop")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.CompanyName, new { @class = "form-control round", @placeholder = L.T("Srm_CompanyShopName") })
                                                        @Html.ValidationMessageFor(model => model.CompanyName, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Srm_ProductType")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.ProductType, new { @class = "form-control round", @placeholder = L.T("Srm_ProductType") })
                                                        @Html.ValidationMessageFor(model => model.ProductType, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Srm_State")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Country, new { @class = "form-control round", @placeholder = L.T("Srm_State") })
                                                        @Html.ValidationMessageFor(model => model.Country, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Srm_Province")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Province, new { @class = "form-control round", @placeholder = L.T("Srm_Province") })
                                                        @Html.ValidationMessageFor(model => model.Province, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Srm_Region")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Region, new { @class = "form-control round", @placeholder = L.T("Srm_Region") })
                                                        @Html.ValidationMessageFor(model => model.Region, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Srm_ContactShort")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.ContactPerson, new { @class = "form-control round", @placeholder = L.T("Srm_ContactPersonPh") })
                                                        @Html.ValidationMessageFor(model => model.ContactPerson, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Srm_Position")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Position, new { @class = "form-control round", @placeholder = L.T("Srm_Position") })
                                                        @Html.ValidationMessageFor(model => model.Position, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Phone")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Phone, new { @class = "form-control round", @placeholder = L.T("Srm_PhoneNumber") })
                                                        @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Comment")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextAreaFor(model => model.Comment, new { @class = "form-control round", @placeholder = L.T("Comment"), @rows = "3" })
                                                        @Html.ValidationMessageFor(model => model.Comment, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <ul class="list-group list-group-flush">
                                                        <li class="list-group-item border-0 pb-0">
                                                            <button class="btn btn-primary btn-block subtotal-preview-btn" name="edit" type="submit" value="Edit">
                                                                <i class='bx bx-save'></i>
                                                                @L.T("Save")
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                            <hr>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

