@model tahsinERP.Models.SUPPLIER_BASE
@{
    ViewBag.Title = L.T("Delete");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("Delete", "SupplierBase", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
        @Html.AntiForgeryToken()
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/SupplierBase">@L.T("Menu_Directory")</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            @L.T("Srm_DeleteNamed", Model.CompanyName)
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="invoice-edit-wrapper">
                        <div class="row">
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            <div class="row invoice-info">
                                                <div class="col-lg-12 col-md-6 mt-25">
                                                    <h4 class="text-primary">@L.T("Srm_Data")</h4>
                                                    <hr />
                                                    <span><b>@L.T("Srm_CompanyShop")</b>: @Html.DisplayFor(model => model.CompanyName, new { @class = "form-control" })</span>
                                                    <br />
                                                    <span><b>@L.T("Srm_ProductType")</b>: @Html.DisplayFor(model => model.ProductType, new { @class = "form-control" })</span>
                                                    <hr />
                                                    <section>
                                                        <div>
                                                            <h6 class="text-primary">@L.T("Srm_GeoInfo")</h6>
                                                            <span><b>@L.T("Srm_State")</b>: @Html.DisplayFor(model => model.Country, new { @class = "form-control" })</span>
                                                            <br />
                                                            <span><b>@L.T("Srm_Province")</b>: @Html.DisplayFor(model => model.Province, new { @class = "form-control" })</span>
                                                            <br />
                                                            <span><b>@L.T("Srm_Region")</b>: @Html.DisplayFor(model => model.Region, new { @class = "form-control" })</span>
                                                            <br />
                                                            <hr />
                                                        </div>
                                                    </section>
                                                    <h6 class="text-primary">@L.T("Srm_ForContact")</h6>
                                                    <span><b>@L.T("Srm_ContactShort")</b>: @Html.DisplayFor(model => model.ContactPerson, new { @class = "form-control" })</span>
                                                    <br />
                                                    <span><b>@L.T("Srm_Position")</b>: @Html.DisplayFor(model => model.Position, new { @class = "form-control" })</span>
                                                    <br />
                                                    <span><b>@L.T("Phone")</b>: @Html.DisplayFor(model => model.Phone, new { @class = "form-control" })</span>
                                                    <br />
                                                    <span><b>@L.T("Comment")</b>: @Html.DisplayFor(model => model.Comment, new { @class = "form-control" })</span>
                                                    <br />
                                                </div>
                                                <ul class="list-group list-group-flush">
                                                    <li class="list-group-item border-0 pb-0">
                                                        <button class="btn btn-danger bg-light btn-block subtotal-preview-btn" name="delete" type="submit" value="Delete" onclick="return confirm('@L.Js("Srm_ConfirmDeleteRecord")')">
                                                            <i class='bx bx-trash'></i>
                                                            @L.T("Delete")
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                            <hr>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

