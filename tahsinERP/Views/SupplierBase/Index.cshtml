@model List<tahsinERP.Models.SUPPLIER_BASE>
@{
    ViewBag.Title = L.T("Menu_Directory");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var productType = ViewBag.ProductType;
    bool changePermit = ViewBag.ChangePermit as bool? ?? false;
}

<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Menu_Directory")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <div class="invoice-create-btn mb-1">
                        @if (changePermit)
                        {
                            <a href="@Url.Action("Create", "SupplierBase")" class="btn btn-success bg-light invoice-create">
                                <i class="bx bx-plus"></i> @L.T("AddNew")
                            </a>
                        }
                    </div>

                    <div class="users-list-filter px-1">
                        <form method="get" action="@Url.Action("Index", "SupplierBase")">
                            <div class="row border rounded py-2 mb-2">
                                <div class="col-12 col-sm-12 col-lg-4">
                                    <label for="ProductType">@L.T("Srm_ActivityLabel")</label>
                                    <fieldset class="form-group">
                                        @Html.DropDownList("productType", ViewBag.ProductTypeList as SelectList, L.T("All"), new { @class = "form-control", @id = "productTypeFilter" })
                                    </fieldset>
                                </div>
                                <div class="col-12 col-sm-12 col-lg-4 d-flex align-items-center">
                                    <button type="submit" class="btn btn-secondary bg-light invoice-create">
                                        <i class="bx bx-refresh"></i> @L.T("Srm_RefreshList")
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="supplierBaseTable" class="table  table-striped table-bordered nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Srm_CompanyShop")</th>
                                                    <th>@L.T("Srm_ProductType")</th>
                                                    <th>@L.T("Srm_State")</th>
                                                    <th>@L.T("Srm_Province")</th>
                                                    <th>@L.T("Srm_Region")</th>
                                                    <th>@L.T("Srm_ContactShort")</th>
                                                    <th>@L.T("Srm_Position")</th>
                                                    <th>@L.T("Phone")</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>@L.T("Actions")</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "SupplierBase", new { id = item.ID })">@(item.CompanyName ?? "-")</a>
                                                            </td>
                                                            <td>@(item.ProductType ?? "-")</td>
                                                            <td>@(item.Country ?? "-")</td>
                                                            <td>@(item.Province ?? "-")</td>
                                                            <td>@(item.Region ?? "-")</td>
                                                            <td>@(item.ContactPerson ?? "-")</td>
                                                            <td>@(item.Position ?? "-")</td>
                                                            <td>@(item.Phone ?? "-")</td>
                                                            @if (changePermit)
                                                            {
                                                                <td>
                                                                    <div class="d-flex">
                                                                        <a href="@Url.Action("Edit", "SupplierBase", new { id = item.ID })" class="btn btn-sm btn-icon btn-outline-primary mr-1" title="@L.T("Edit")">
                                                                            <i class="bx bx-edit-alt"></i>
                                                                        </a>
                                                                        <button type="button" class="btn btn-sm btn-icon btn-outline-danger" onclick="deleteSupplierBase(@item.ID, '@(item.CompanyName ?? L.T("Srm_Record"))')" title="@L.T("Delete")">
                                                                            <i class="bx bx-trash"></i>
                                                                        </button>
                                                                    </div>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
    @section Scripts {
        <script>
            $(document).ready(function () {
                $('#supplierBaseTable').DataTable({
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "@L.Js("All")"]],
                    "order": [[3, "desc"]],
                    "columnDefs": [
                        { "type": "date", "targets": 3 }
                    ],
                    "scrollX": true,
                    dom: 'lBfrtip',
                    // Til va eksport tugmalari umumiy — assets/js/dt-defaults.js (SRM-D15)
                    buttons: erpDataTable.buttons({ fileName: '@L.Js("Srm_SuppliersFile")', title: '@L.Js("Srm_SuppliersFile")' })
                });
            });
        </script>
    }
