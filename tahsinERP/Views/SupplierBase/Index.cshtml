@model List<tahsinERP.Models.SUPPLIER_BASE>
@{
    ViewBag.Title = "Ma'lumotnoma";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var productType = ViewBag.ProductType;
    bool changePermit = ViewBag.ChangePermit as bool? ?? false;
}

<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Ma'lumotnoma
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <div class="invoice-create-btn mb-1">
                        @if (changePermit)
                        {
                            <a href="@Url.Action("Create", "SupplierBase")" class="btn btn-success bg-light invoice-create">
                                <i class="bx bx-plus"></i> Yangi qo'shish
                            </a>
                        }
                    </div>

                    <div class="users-list-filter px-1">
                        <form method="get" action="@Url.Action("Index", "SupplierBase")">
                            <div class="row border rounded py-2 mb-2">
                                <div class="col-12 col-sm-12 col-lg-4">
                                    <label for="ProductType">Faoliyati:</label>
                                    <fieldset class="form-group">
                                        @Html.DropDownList("productType", ViewBag.ProductTypeList as SelectList, "Barchasi", new { @class = "form-control", @id = "productTypeFilter" })
                                    </fieldset>
                                </div>
                                <div class="col-12 col-sm-12 col-lg-4 d-flex align-items-center">
                                    <button type="submit" class="btn btn-secondary bg-light invoice-create">
                                        <i class="bx bx-refresh"></i> Ro'yxatni yangilash
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="supplierBaseTable" class="table  table-striped table-bordered nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Korxona / Do'kon</th>
                                                    <th>Maxsulot turi</th>
                                                    <th>Davlat</th>
                                                    <th>Viloyat</th>
                                                    <th>Region</th>
                                                    <th>Aloqa uchun</th>
                                                    <th>Lavozimi</th>
                                                    <th>Telefon</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "SupplierBase", new { id = item.ID })">@(item.CompanyName ?? "-")</a>
                                                            </td>
                                                            <td>@(item.ProductType ?? "-")</td>
                                                            <td>@(item.Country ?? "-")</td>
                                                            <td>@(item.Province ?? "-")</td>
                                                            <td>@(item.Region ?? "-")</td>
                                                            <td>@(item.ContactPerson ?? "-")</td>
                                                            <td>@(item.Position ?? "-")</td>
                                                            <td>@(item.Phone ?? "-")</td>
                                                            @if (changePermit)
                                                            {
                                                                <td>
                                                                    <div class="d-flex">
                                                                        <a href="@Url.Action("Edit", "SupplierBase", new { id = item.ID })" class="btn btn-sm btn-icon btn-outline-primary mr-1" title="Tahrirlash">
                                                                            <i class="bx bx-edit-alt"></i>
                                                                        </a>
                                                                        <button type="button" class="btn btn-sm btn-icon btn-outline-danger" onclick="deleteSupplierBase(@item.ID, '@(item.CompanyName ?? "Yozuv")')" title="O'chirish">
                                                                            <i class="bx bx-trash"></i>
                                                                        </button>
                                                                    </div>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
    @section Scripts {
        <script>
            $(document).ready(function () {
                $('#supplierBaseTable').DataTable({
                    "language": {
                        "search": "Qidirish:",
                        "lengthMenu": "_MENU_ ta ko'rsatish",
                        "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                        "infoEmpty": "Yozuvlar yo'q",
                        "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                        "paginate": {
                            "first": "Birinchi",
                            "last": "Oxirgi",
                            "next": "Keyingi",
                            "previous": "Oldingi"
                        },
                        "zeroRecords": "Ma'lumot topilmadi"
                    },
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Barchasi"]],
                    "order": [[3, "desc"]],
                    "columnDefs": [
                        { "type": "date", "targets": 3 }
                    ],
                    "scrollX": true,
                    dom: 'lBfrtip',
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bx bxs-file-excel"></i> Excel',
                            titleAttr: 'Excelga yuklash',
                            className: 'btn btn-success mr-1',
                            filename: function () {
                                var now = new Date();
                                var dateStr = now.getFullYear() +
                                    String(now.getMonth() + 1).padStart(2, '0') +
                                    String(now.getDate()).padStart(2, '0') + '_' +
                                    String(now.getHours()).padStart(2, '0') +
                                    String(now.getMinutes()).padStart(2, '0') +
                                    String(now.getSeconds()).padStart(2, '0');
                                return 'Taminotchilar' + dateStr;
                            },
                            exportOptions: {
                                columns: ':visible',
                                format: {
                                    body: function (data, row, column, node) {
                                        return data.replace(/<[^>]*>/g, '').trim();
                                    }
                                }
                            }
                        },
                        {
                            extend: 'pdfHtml5',
                            text: '<i class="bx bxs-file-pdf"></i> PDF',
                            titleAttr: 'PDFga yuklash',
                            className: 'btn btn-danger',
                            filename: function () {
                                var now = new Date();
                                var dateStr = now.getFullYear() +
                                    String(now.getMonth() + 1).padStart(2, '0') +
                                    String(now.getDate()).padStart(2, '0') + '_' +
                                    String(now.getHours()).padStart(2, '0') +
                                    String(now.getMinutes()).padStart(2, '0') +
                                    String(now.getSeconds()).padStart(2, '0');
                                return 'Taminotchilar_' + dateStr;
                            },
                            exportOptions: {
                                columns: ':visible',
                                format: {
                                    body: function (data, row, column, node) {
                                        return data.replace(/<[^>]*>/g, '').trim();
                                    }
                                }
                            },
                            orientation: 'landscape',
                            pageSize: 'A4',
                            title: 'Taminotchilar',
                            customize: function (doc) {
                                doc.defaultStyle.fontSize = 9;
                                doc.styles.tableHeader.fontSize = 10;
                            }
                        }
                    ]
                });
            });
        </script>
    }
