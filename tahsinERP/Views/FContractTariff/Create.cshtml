@model tahsinERP.Models.F_CONTRACT_TARIFFS
@{
    ViewBag.Title = "Tarif yaratish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Create", "FContractTariff", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/FContractTariff/Index">Tariflar</a>
                                        </li>
                                        <li class="breadcrumb-item active">Yangi tarif</li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="row">
                                    <div class="col-md-4">
                                        <label>Shartnoma</label>
                                        @Html.DropDownListFor(model => model.ContractID, ViewBag.Contracts as SelectList, "Tanlang", new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-4">
                                        <label>Transport turi</label>
                                        @Html.DropDownListFor(model => model.TransportTypeID, ViewBag.TransportTypes as SelectList, "Tanlang", new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-4">
                                        <label>Valyuta</label>
                                        @Html.DropDownListFor(model => model.CurrencyID, ViewBag.Currencies as SelectList, "Tanlang", new { @class = "form-control" })
                                    </div>
                                </div>

                                <div class="row mt-1">
                                    <div class="col-md-3">
                                        <label>Qayerdan (Viloyat)</label>
                                        @Html.TextBoxFor(model => model.FromRegion, new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3">
                                        <label>Qayerdan (Shahar)</label>
                                        @Html.TextBoxFor(model => model.FromCity, new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3">
                                        <label>Qayerga (Viloyat)</label>
                                        @Html.TextBoxFor(model => model.ToRegion, new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3">
                                        <label>Qayerga (Shahar)</label>
                                        @Html.TextBoxFor(model => model.ToCity, new { @class = "form-control" })
                                    </div>
                                </div>

                                <div class="row mt-1">
                                    <div class="col-md-3">
                                        <label>@tahsinERP.Services.LogisticsTerms.TariffBasis</label>
                                        @Html.DropDownListFor(model => model.FreightBasis, new SelectList(new[]
                                        {
                                            new { Value = (byte)0, Text = "Mashina uchun" },
                                            new { Value = (byte)1, Text = "Ton uchun" },
                                            new { Value = (byte)2, Text = "KM uchun" },
                                            new { Value = (byte)3, Text = "Belgilangan narx" }
                                        }, "Value", "Text"), "Tanlang", new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3">
                                        <label>@tahsinERP.Services.LogisticsTerms.TariffRate</label>
                                        @Html.TextBoxFor(model => model.Rate, new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3">
                                        <label>Eng kam to'lov summasi</label>
                                        @Html.TextBoxFor(model => model.MinimumCharge, new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3">
                                        <label>Faol</label>
                                        @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-check-input" })
                                    </div>
                                </div>

                                <div class="row mt-1">
                                    <div class="col-md-12">
                                        <label>Izoh</label>
                                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = 2 })
                                    </div>
                                </div>

                                <div class="row mt-2">
                                    <div class="col-md-12">
                                        <button class="btn btn-primary" type="submit">
                                            <i class="bx bx-save"></i> Saqlash
                                        </button>
                                        <a href="@Url.Action("Index", "FContractTariff")" class="btn btn-outline-secondary ml-1">Bekor qilish</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
