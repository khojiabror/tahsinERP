@model List<tahsinERP.ViewModels.ContractTariffIndexItemViewModel>
@{
    ViewBag.Title = L.T("Log_Tariffs");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()); }

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/FContract/Index">@L.T("Log_Contracts")</a>
                                </li>
                                <li class="breadcrumb-item active">@L.T("Log_Tariffs")</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-body">
            <div class="card mb-2">
                <div class="card-body">
                    <form method="get" action="@Url.Action("Index", "FContractTariff")">
                        <div class="row">
                            <div class="col-md-4">
                                <label>@L.T("Log_Contract")</label>
                                @Html.DropDownList("contractId", ViewBag.Contracts as SelectList, L.T("All"), new { @class = "form-control" })
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">@L.T("Search")</button>
                            </div>
                            @if (changePermit)
                            {
                                <div class="col-md-6 d-flex align-items-end justify-content-end">
                                    <a href="@Url.Action("Create", "FContractTariff")" class="btn btn-success">
                                        <i class="bx bx-plus"></i> @L.T("Log_NewTariff")
                                    </a>
                                </div>
                            }
                        </div>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-content">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>@L.T("Log_Contract")</th>
                                        <th>@L.T("Log_TransportType")</th>
                                        <th>@L.T("Log_From")</th>
                                        <th>@L.T("Log_To")</th>
                                        <th>@L.T("Log_TariffBasis")</th>
                                        <th>@L.T("Log_TariffRate")</th>
                                        <th>@L.T("Currency")</th>
                                        <th>@L.T("Active")</th>
                                        @if (changePermit)
                                        {
                                            <th>@L.T("Actions")</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.ContractNo</td>
                                                <td>@item.TransportType</td>
                                                <td>@item.FromLocation</td>
                                                <td>@item.ToLocation</td>
                                                <td>@tahsinERP.Services.LogisticsEnums.FreightBasisText(item.FreightBasis)</td>
                                                <td>@item.Rate.ToString("N2")</td>
                                                <td>@item.Currency</td>
                                                <td>@(item.IsActive ? L.T("Yes") : L.T("No"))</td>
                                                @if (changePermit)
                                                {
                                                    <td>
                                                        <a href="@Url.Action("Details", "FContractTariff", new { id = item.ID })" class="btn btn-sm btn-outline-info" title="@L.T("View")"><i class="bx bx-show"></i></a>
                                                        <a href="@Url.Action("Edit", "FContractTariff", new { id = item.ID })" class="btn btn-sm btn-outline-success" title="@L.T("Edit")"><i class="bx bx-edit-alt"></i></a>
                                                        <a href="@Url.Action("Delete", "FContractTariff", new { id = item.ID })" class="btn btn-sm btn-outline-danger" title="@L.T("Delete")"><i class="bx bx-trash"></i></a>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="@(changePermit ? 9 : 8)" class="text-center">@L.T("Log_NoDataFound")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
