@model tahsinERP.Models.F_CONTRACT_TARIFFS
@using tahsinERP.Services
@* Shartnoma tarifi formasi — Create va Edit uchun bitta (LOG-D02). Ruxsat [Permission] filtrida tekshiriladi. *@
@{
    bool isEdit = Model != null && Model.ID > 0;
}
@using (Html.BeginForm(isEdit ? "Edit" : "Create", "FContractTariff", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    if (isEdit)
    {
        @Html.HiddenFor(model => model.ID)
    }
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/FContractTariff/Index">Tariflar</a>
                                    </li>
                                    <li class="breadcrumb-item active">@(isEdit ? "Tarif tahrirlash" : "Yangi tarif")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="row">
                                <div class="col-md-4">
                                    <label>Shartnoma</label>
                                    @Html.DropDownListFor(model => model.ContractID, ViewBag.Contracts as SelectList, "Tanlang", new { @class = "form-control" })
                                </div>
                                <div class="col-md-4">
                                    <label>Transport turi</label>
                                    @Html.DropDownListFor(model => model.TransportTypeID, ViewBag.TransportTypes as SelectList, "Tanlang", new { @class = "form-control" })
                                </div>
                                <div class="col-md-4">
                                    <label>Valyuta</label>
                                    @Html.DropDownListFor(model => model.CurrencyID, ViewBag.Currencies as SelectList, "Tanlang", new { @class = "form-control" })
                                </div>
                            </div>

                            <div class="row mt-1">
                                <div class="col-md-3">
                                    <label>Qayerdan (Viloyat)</label>
                                    @Html.TextBoxFor(model => model.FromRegion, new { @class = "form-control" })
                                </div>
                                <div class="col-md-3">
                                    <label>Qayerdan (Shahar)</label>
                                    @Html.TextBoxFor(model => model.FromCity, new { @class = "form-control" })
                                </div>
                                <div class="col-md-3">
                                    <label>Qayerga (Viloyat)</label>
                                    @Html.TextBoxFor(model => model.ToRegion, new { @class = "form-control" })
                                </div>
                                <div class="col-md-3">
                                    <label>Qayerga (Shahar)</label>
                                    @Html.TextBoxFor(model => model.ToCity, new { @class = "form-control" })
                                </div>
                            </div>

                            <div class="row mt-1">
                                <div class="col-md-3">
                                    <label>@LogisticsTerms.TariffBasis</label>
                                    @Html.DropDownListFor(model => model.FreightBasis, LogisticsEnums.FreightBasisList(), "Tanlang", new { @class = "form-control" })
                                </div>
                                <div class="col-md-3">
                                    <label>@LogisticsTerms.TariffRate</label>
                                    @Html.TextBoxFor(model => model.Rate, "{0:0.######}", new { @class = "form-control" })
                                </div>
                                <div class="col-md-3">
                                    <label>Eng kam to'lov summasi</label>
                                    @Html.TextBoxFor(model => model.MinimumCharge, "{0:0.######}", new { @class = "form-control" })
                                </div>
                                <div class="col-md-3">
                                    <label>Faol</label>
                                    @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-check-input" })
                                </div>
                            </div>

                            <div class="row mt-1">
                                <div class="col-md-12">
                                    <label>Izoh</label>
                                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = 2 })
                                </div>
                            </div>

                            <div class="row mt-2">
                                <div class="col-md-12">
                                    <button class="btn btn-primary" type="submit">
                                        <i class="bx bx-save"></i> Saqlash
                                    </button>
                                    <a href="@(isEdit ? Url.Action("Index", "FContractTariff", new { contractId = Model.ContractID }) : Url.Action("Index", "FContractTariff"))" class="btn btn-outline-secondary ml-1">Bekor qilish</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
