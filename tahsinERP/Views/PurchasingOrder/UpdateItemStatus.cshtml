@model List<tahsinERP.Models.PURCHASING_ORDER_ITEMS>

@{
    ViewBag.Title = "UpdateItemStatus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .progress-bar {
        background-color: #e0e0e0;
        border-radius: 10px;
        height: 30px;
        position: relative;
    }

    .element {
        background-color: #4caf50;
        height: 100%;
        line-height: 30px;
        text-align: center;
        color: white;
        border-radius: 5px;
        transition: width 1.5s;
    }
</style>

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item ">
                                    <a href="~/PurchasingOrder">Xarid buyurtmalari</a>
                                </li>
                                <li class="breadcrumb-item active">Xarid buyurtmalari statuslari</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-body">
            <section class="invoice-list-wrapper">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="myDataTable" class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Maxsulot nomi</th>
                                            <th>Bo'lim</th>
                                            <th>Miqdori</th>
                                            <th>Umumiy narxi</th>
                                            <th>Progress</th>
                                            <th>Izoh</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            using (Html.BeginForm("UpdateItemStatus", "PurchasingOrder", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                                var progressPercentage = item.Progress * 100;
                                                <tr>
                                                    <td><a href="~/PurchasingOrder/Details/@item.OrderID">@item.PURCHASING_ITEMS.ItemName</a></td>
                                                    <td>@item.PURCHASING_ORDERS.OrderedByDept</td>
                                                    <td>@item.Amount</td>
                                                    <td>@item.TotalPrice</td>
                                                    <td>
                                                        <div class="progress-bar">
                                                            <div class="element" style="width: @progressPercentage%;">@progressPercentage%</div>
                                                        </div>
                                                    </td>
                                                    @if (progressPercentage != 100)
                                                    {
                                                        <td>@Html.TextBox("comment", item.Comment, new { @class = "form-control", id = $"comment_{item.ID}", @required = "required" })</td>
                                                        <td>
                                                            <!-- Bitta umumiy shakl orqali tugmalar va comment qiymatlari jo'natiladi -->
                                                            @Html.Hidden("ID", item.ID)
                                                            @Html.Hidden("action", "") <!-- Action qiymati JS orqali yangilanadi -->

                                                            <button type="button" onclick="submitForm(@item.ID, 'approve')" style="border: none;">
                                                                Buyurtmani yopish
                                                            </button>

                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<script>
    function submitForm(itemId, actionValue) {
        // Action va comment qiymatlarini o'zgartirish
        document.getElementsByName("action")[0].value = actionValue;
        document.getElementsByName("ID")[0].value = itemId;

        // Izoh maydonidagi qiymatni olish
        var commentValue = document.getElementById(`comment_${itemId}`).value;
        document.getElementsByName("comment")[0].value = commentValue;

        // Shaklni yuborish
        document.forms[0].submit();
    }
</script>
