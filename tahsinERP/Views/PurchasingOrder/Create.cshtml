@model tahsinERP.ViewModels.PurchasingOrder.PurchasingOrderViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #file-upload-div {
        transition: background-color 1s ease;
    }

    .file-upload-success {
        background-color: lightgreen; /* or lightblue */
    }
</style>

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/PurchasingOrder/Index">Xarid Buyurtmalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Buyurtma yaratish
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Create", "PurchasingOrder", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form repeater-default" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row justify-content-around d-flex align-items-start">
                                                @* Left Part *@
                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="SupplierID">Buyurtma raqami(EDO)</label>
                                                            @Html.TextBoxFor(model => model.OrderCodeEDO, new { @type = "text", @class = "form-control", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.OrderCodeEDO, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label>Ma'sul xarid agenti:</label>
                                                            @Html.DropDownList("BuyerUserID", (SelectList)ViewBag.userList, "Buyerni tanlang:", new { @class = "form-control select", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.BuyerUserID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                        <label for="OrderNo">Valyuta</label>
                                                            @Html.DropDownListFor(model => model.CurrencyID, ViewBag.currencies as SelectList,new { @class = "form-control select2", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.OrderCode, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>

                                                @* Right Part *@
                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label>Buyurtma tasdiqlangan (EDO) sanasi</label>
                                                            @Html.TextBoxFor(model => model.ApprovedDTEDO, new { @class = "form-control pickadate-months-year round", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.ApprovedDTEDO, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="SupplierID">Buyurtma haqida batafsil</label>
                                                            @Html.TextAreaFor(model => model.Comment, new { @type = "text", @class = "form-control", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.Comment, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-6 col-12 form-group" id="file-upload-div">
                                                <hr />
                                                <label for="file-upload" class="form-label">Buyurtma faylini yuklang</label>
                                                <div class="custom-file">
                                                    @Html.TextBoxFor(model => model.File, new { type = "file", @class = "form-control", @id = "file-upload", accept = ".pdf,.doc,.docx,.xlsx" })
                                                    @Html.ValidationMessageFor(model => model.File, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="progress mt-3 d-none" id="upload-progress">
                                                    <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%;" id="progress-bar"></div>
                                                </div>
                                                <hr />
                                            </div>

                                            <div class="users-list-filter px-1">
                                                <div class="row border rounded py-2 mb-2">
                                                    <div class="col-12 col-sm-12 col-lg-4">
                                                        <label>Buyurtma beruvchi bo'lim</label>
                                                        @Html.TextBoxFor(model => model.OrderByDept, new { @type = "text", @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.OrderByDept, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-12 col-sm-12 col-lg-4">
                                                        <label>Buyurtma beruvchi xodim</label>
                                                        @Html.TextBoxFor(model => model.OrderByUser, new { @type = "text", @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.OrderByUser, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <br />
                                            <h4>Predmetlari:</h4>
                                            <div data-repeater-list="Parts">
                                                <div data-repeater-item>
                                                    <div class="row justify-content-between">
                                                        <input type="hidden" name="ID" />
                                                        <div class="col-md-2 col-sm-10 form-group">
                                                            <label for="Part_PartID">Predmetni tanlang:</label>
                                                            @Html.DropDownList("ItemID", (SelectList)ViewBag.itemList, new { @class = "form-control select", id = "ItemID", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.Parts[0].ItemID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Amount">Miqdori:</label>
                                                            <input type="number" name="Amount" class="form-control" id="Part_Amount" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Amount, "", new { @class = "text-danger", @type = "number", @required = "required" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Price">Taxminiy birlik narxi:</label>
                                                            <input type="number" name="Price" step="0.01" class="form-control" id="Part_Price" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Price, "", new { @class = "text-danger", @type = "number" })
                                                        </div>
                                                        <div class="col-md-1 col-sm-12 form-group d-flex align-items-center pt-2">
                                                            <button data-repeater-delete type="button" class="btn btn-danger">O'chirish</button>
                                                        </div>
                                                    </div>
                                                    <hr>
                                                </div>
                                            </div>
                                            <button data-repeater-create type="button" class="btn btn-primary">Yangi qism qo'shish</button>

                                            <ul class="list-group list-group-flush">
                                                <li class="list-group-item border-0 pb-0">
                                                    <button class="btn btn-primary btn-block subtotal-preview-btn" name="create" type="submit" value="Create">
                                                        <i class='bx bx-save'></i> Saqlash
                                                    </button>
                                                </li>
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
<script>
    document.getElementById('file-upload').addEventListener('change', function () {
        if (this.files && this.files.length > 0) {
            document.getElementById('file-upload-div').classList.add('file-upload-success');
        }
    });

</script>