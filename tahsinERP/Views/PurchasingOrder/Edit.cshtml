

@model  tahsinERP.ViewModels.PurchasingOrder.PurchasingOrderViewModel
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Edit", "PurchasingOrder", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item ">
                                            <a href="~/PurchasingOrder">Xarid Buyurtmalar</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            @Model.OrderCode raqamli buyurtmani taxrirlash
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <div class="row">
                        <div class="col-xl-12 col-md-8 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row justify-content-around d-flex align-items-start">
                                            @* Left Part *@
                                            <div class="col-lg-6 col-sm-12">
                                                <div class="row">
                                                    <div class="col-md-6 col-12 form-group">
                                                        <label for="SupplierID">Buyurtma raqami(EDO)</label>
                                                        @Html.TextBoxFor(model => model.OrderCodeEDO, new { @type = "text", @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.OrderCodeEDO, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-6 col-12 form-group">
                                                        <label>Ma'sul xarid agenti:</label>
                                                        @Html.DropDownList("BuyerUserID", (IEnumerable<SelectListItem>)ViewBag.userList, new { @class = "form-control select", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.BuyerUserID, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-6 col-12 form-group">
                                                        <label for="SupplierID">Buyurtma haqida batafsil</label>
                                                        @Html.TextAreaFor(model => model.Comment, new { @type = "text", @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.Comment, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            @* Right Part *@
                                            <div class="col-lg-6 col-sm-12">
                                                <div class="row">
                                                    <div class="col-md-6 col-12 form-group">
                                                        <label>Valyuta</label>
                                                        @Html.DropDownListFor(model => model.CurrencyID, ViewBag.currencies as SelectList, new { @class = "form-control select2" })
                                                        @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-6 col-12 form-group">
                                                        <label>Buyurtma tasdiqlangan (EDO) sanasi</label>
                                                        @Html.TextBoxFor(model => model.ApprovedDTEDO, new { @class = "form-control pickadate-months-year round", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.ApprovedDTEDO, "", new { @class = "text-danger" })
                                                        <div class="form-control-position mt-2">
                                                            <i class='bx bx-calendar'></i>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="users-list-filter px-1">
                                            <div class="row border rounded py-2 mb-2">
                                                <div class="col-12 col-sm-12 col-lg-4">
                                                    <label>Buyurtma beruvchi bo'lim</label>
                                                    @Html.TextBoxFor(model => model.OrderedByDept, new { @type = "text", @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.OrderedByDept, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-12 col-sm-12 col-lg-4">
                                                    <label>Buyurtma beruvchi xodim</label>
                                                    @Html.TextBoxFor(model => model.OrderedByUser, new { @type = "text", @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.OrderedByUser, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                            <section id="column-selectors">
                                                <div class="row">
                                                    <div class="col-12">
                                                        <div class="card">
                                                            <div class="card-header">
                                                                <h4 class="card-title">Buyurtma predmeti</h4>
                                                            </div>
                                                            <div class="card-content">
                                                                <div class="card-body card-dashboard">
                                                                    <div class="table-responsive">
                                                                        <table class="table table-striped dataex-html5-selectors" style="width:100%">
                                                                            <thead>
                                                                                <tr>
                                                                                    <th>Maxsulot nomi</th>
                                                                                    <th>Birlik narxi</th>
                                                                                    <th>Miqdori</th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                @for (int i = 0; i < Model.Parts.Count; i++)
                                                                                {
                                                                                    <tr>
                                                                                        <td>
                                                                                            <a href="~/PurchasingItem/Details/@Model.Parts[i].Item">@Model.Parts[i].Item.ItemName</a>
                                                                                            @Html.HiddenFor(model => model.Parts[i].ItemID)
                                                                                            @Html.HiddenFor(model => model.Parts[i].ID)
                                                                                        </td>
                                                                                        <td>
                                                                                            @Html.TextBoxFor(model => model.Parts[i].Price, new { @class = "form-control" })
                                                                                        </td>
                                                                                        <td>
                                                                                            @Html.TextBoxFor(model => model.Parts[i].Amount, new { @class = "form-control" })
                                                                                        </td>
                                                                                    </tr>
                                                                                }
                                                                            </tbody>
                                                                        </table>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </section>

                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item border-0 pb-0">
                                                <button class="btn btn-primary btn-block subtotal-preview-btn" name="edit" type="submit" value="Edit">
                                                    <i class='bx bx-save'></i>
                                                    Saqlash
                                                </button>
                                            </li>
                                        </ul>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

