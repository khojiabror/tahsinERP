@model List<tahsinERP.ViewModels.Purchasing.PurchasingStatusViewModel>

@{
    ViewBag.Title = "Status";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>

    .progress {
        background-color: #e0e0e0; /* Progress bar uchun bo'sh kulrang fon */
        border-radius: 10px;
        height: 20px;
    }

    .progress-bar {
        background-color: #4CAF50; /* To'lganda yashil rang */
        height: 20px;
        transition: width 1s ease-in-out; /* Silliq to'lish */
        color: white; /* Text rangi */
        line-height: 20px;
        min-width: 2%; /* Kamida 2% progress bar ko'rinishi */
    }

</style>

