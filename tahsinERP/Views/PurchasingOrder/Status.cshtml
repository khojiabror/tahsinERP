<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item ">
                                    Sahifalar
                                </li>
                                <li class="breadcrumb-item active">
                                    Xarid buyurtmalari statuslari
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="users-list-filter px-1">
            <form>
                <div class="row border rounded py-2 mb-2">
                    <div class="col-12 col-sm-12 col-lg-4">
                        <label>Ta'minotchisi</label>
                        <fieldset class="form-group">
                            @Html.DropDownList("supplierName", ViewBag.SupplierList as SelectList, "", new { @class = "form-control", id = "SupplierID", onchange = "refreshDataTable(); toggleButtons()" })
                        </fieldset>
                    </div>
                    <div class="col-12 col-sm-12 col-lg-4">
                        <label>Buyurtma</label>
                        <fieldset class="form-group">
                            @Html.DropDownList("orderNoEDO", ViewBag.PurchasingOrderList as SelectList, "", new { @class = "form-control", id = "OrderCodeEDO", onchange = "refreshdatatablesupplier()" })
                        </fieldset>
                    </div>
                    <div class="col-12 col-sm-12 col-lg-4 d-flex align-items-center">
                        <a href="~/PurchasingOrder/Status" class="btn btn-secondary bg-light invoice-create" role="button" aria-pressed="true">
                            Ro'yxatni yangilash
                        </a>
                    </div>
                </div>
            </form>
        </div>
        <div class="content-body">
            <!-- users list start -->
            <section class="invoice-list-wrapper">
                <div class="col-md-13 col-sm-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <!-- datatable start -->
                                <div class="table-responsive table-responsivetable-responsive">
                                    <table id="myDataTable" class="table table-striped table-bordered complex-headers" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th colspan="3" class="align-top">Buyurtma</th>
                                                <th colspan="3">Shartnoma</th>
                                                <th colspan="1">To'lov</th>
                                                <th colspan="2">Kirim</th>
                                            </tr>
                                            <tr>
                                                <th>Maxsulot nomi</th>
                                                <th>Bo'lim</th>
                                                <th>Miqdori</th>

                                                <th>Ta'minotchi</th>
                                                <th>Miqdori</th>
                                                <th>Status</th>

                                                <th>Status</th>

                                                <th>Miqdori</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td><a href="~/PurchasingOrder/Details/@item.OrderID">@item.ItemName</a></td>
                                                    <td>@item.OrderedByDept</td>
                                                    <td>@item.OrderAmount</td>

                                                    <td>@item.Supplier</td>
                                                    <td>@item.ContractAmount</td>
                                                    <td>
                                                        <div class="progress">
                                                            <div class="progress-bar" role="progressbar"
                                                                 style="width: @item.ContractAmountPercentage;"
                                                                 aria-valuenow="@item.ContractAmountPercentage"
                                                                 aria-valuemin="0" aria-valuemax="100">
                                                                @item.ContractAmountPercentage%
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="progress">
                                                            <div class="progress-bar" role="progressbar"
                                                                 style="width: @item.PaymentAmountPercentage;"
                                                                 aria-valuenow="@item.PaymentAmountPercentage"
                                                                 aria-valuemin="0" aria-valuemax="100">
                                                                @item.PaymentAmountPercentage%
                                                            </div>
                                                        </div>
                                                    </td>

                                                    <td>@item.IncomeAmount</td>
                                                    <td>
                                                        <div class="progress">
                                                            <div class="progress-bar" role="progressbar"
                                                                 style="width: @item.IncomeAmountPercentage;"
                                                                 aria-valuenow="@item.IncomeAmountPercentage"
                                                                 aria-valuemin="0" aria-valuemax="100">
                                                                @item.IncomeAmountPercentage%
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>

                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
@*}
    else
    {
        Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
    }*@
<script>
    document.addEventListener("DOMContentLoaded", function () {
        let bars = document.querySelectorAll('.progress-bar');
        bars.forEach(function (bar) {
            let width = bar.getAttribute('aria-valuenow');
            bar.style.width = '0%'; // Boshlanish qiymati 0%
            setTimeout(function () {
                bar.style.width = width + '%'; // Sekin to'lish
            }, 100); // 0.1 soniyadan keyin progress boshlanadi
        });
    });
</script>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>

    //////////////////////////
    // Function to update the progress bar for a specific order
    function updateProgressBar(orderID, progressElementId) {
        $.ajax({
            url: '/PurchasingOrder/GetProgressPercentage', // Point to your action
            type: 'GET',
            data: { ID: orderID }, // Pass the orderID to the controller
            success: function (response) {
                // Update the progress bar's width and text
                $('#' + progressElementId).css('width', response + '%');
                $('#' + progressElementId).text(response + '%');
            },
            error: function () {
                console.error('Failed to get progress percentage.');
            }
        });
    }
    $(document).ready(function () {
        $('tbody tr').each(function () {
            var orderID = $(this).find('td:nth-child(3) a').attr('href').split('/').pop(); // Extract ID from link
            var progressElementId = 'progress-element-' + orderID; // Make the ID for the progress bar

            // Call the function for each order
            updateProgressBar(orderID, progressElementId);
        });
    });

    function refreshDataTable() {
        var source = document.getElementById("OrderCodeEDO").value;
        var supplierID = document.getElementById("SupplierID").value;
        window.location.href = '@Url.Action("Status", "PurchasingOrder")?orderNoEDO=' + source + '&supplierName=' + supplierID;
    }

    function refreshdatatablesupplier() {
        var source = document.getElementById("OrderCodeEDO").value;
        var supplierID = document.getElementById("SupplierID").value;
        window.location.href = '@Url.Action("Status", "PurchasingOrder")?orderNoEDO=' + source + '&supplierName=' + supplierID;
    }

</script>