
@model  tahsinERP.Models.PURCHASING_ORDERS
@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item ">
                                        <a href="~/PurchasingOrder">Xarid Buyurtmalari</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @Model.OrderCode raqamli buyurtmani o'chirish
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-xl-12 col-md-8 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body pb-0 mx-25">
                                    <div class="row invoice-info">
                                        <div class="col-lg-12 col-md-6 mt-25">
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <h4 class="text-primary">Sotuv buyurtma  ma'lumotlari</h4>
                                            <hr />
                                            <span><b>Buyurtma raqami</b>: @Html.DisplayFor(model => model.OrderCode, new { @class = "form-control" })</span>
                                            <hr />
                                            <span><b>Buyurtma raqami EDO</b>: @Html.DisplayFor(model => model.OrderCodeEDO, new { @class = "form-control" })</span>
                                            <hr />
                                            <span><b>Yaratilgan sanasi</b>: @Model.CreatedDT.ToString("dd.MM.yyyy")</span>
                                            <hr />
                                            <span><b>Tasdiqlangan (EDO) sanasi</b>: @Model.ApprovedDTEDO.Value.ToString("dd.MM.yyyy")</span>
                                            <hr />
                                            <span><b>Izoh</b>: @Html.DisplayFor(model => model.Comment, new { @class = "form-control" }) </span>
                                            <hr />

                                            <span>
                                                <b>Status</b>:
                                                @if (Model.Status == "Jarayonda")
                                                {
                                                    <span class="form-control" style="background-color: yellow; color: black;">
                                                        @Html.DisplayFor(model => model.Status)
                                                    </span>
                                                }
                                                else if (Model.Status == "Yakunlandi")
                                                {
                                                    <span class="form-control" style="background-color: green; color: white;">
                                                        @Html.DisplayFor(model => model.Status)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="form-control" style="background-color: green; color: white;">
                                                        @Html.DisplayFor(model => model.Status)
                                                    </span>
                                                }
                                            </span>

                                            <hr />
                                            <span><b>Buyer </b>: @Html.DisplayFor(model => model.USER1.FullName, new { @class = "form-control" })</span>
                                            <hr />
                                            <span><b>qaysi Buyer tomonidan</b>: @Html.DisplayFor(model => model.USER.FullName, new { @class = "form-control" })</span>
                                            <hr />
                                        </div>
                                    </div>
                                    <section id="column-selectors">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="card">
                                                    <div class="card-header">
                                                        <h4 class="card-title">Shartnoma predmeti</h4>
                                                    </div>
                                                    <div class="card-content">
                                                        <div class="card-body card-dashboard">
                                                            <div class="table-responsive">
                                                                <table class="table table-striped dataex-html5-selectors" style="width:100%">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Item nomi</th>
                                                                            <th>Birlik narxi</th>
                                                                            <th>Narxi</th>
                                                                            <th>Miqdori</th>
                                                                            <th>Umumiy narx</th>
                                                                            <th>amallar</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var item in ViewBag.partList)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    <a href="~/PurchasingItem/Details/@item.ItemID">@item.PURCHASING_ITEMS.ItemName</a>
                                                                                </td>
                                                                                <td>@item.Price</td>
                                                                                <td>@item.Amount</td>
                                                                                <td>@item.TotalPrice @item.Currency</td>
                                                                                <td>
                                                                                    <!-- Delete button -->
                                                                                    <a href="~/PurchasingOrder/DeletePart/@item.ID" onclick="return confirm('Ushbu sotuv buyurtmani o`chirib yuborishga ishonchingiz komilmi?')">
                                                                                        <i class="bx bx-trash"></i>
                                                                                    </a>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item border-0 pb-0">
                                            @using (Html.BeginForm("Delete", "PurchasingOrder", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button class="btn btn-danger bg-light btn-block subtotal-preview-btn" name="delete" type="submit" value="Delete" onclick="return confirm('Ushbu sotuv buyurtmani o\'chirib yuborishga ishonchingiz komilmi?')">
                                                    <i class='bx bx-trash'></i>
                                                    O'chirish
                                                </button>
                                            }
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

