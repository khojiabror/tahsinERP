@model  tahsinERP.Models.PURCHASING_ORDERS
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item ">
                                        <a href="~/PurchasingOrder">Shartnomalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @Model.OrderCode buyurtma haqida batafsil ma'lumot
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-xl-12 col-md-8 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body pb-0 mx-25">
                                    <div class="row invoice-info">
                                        <div class="col-lg-12 col-md-6 mt-25">
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <h4 class="text-primary">Buyurtma  ma'lumotlari</h4>
                                            <hr />
                                            <span><b>Buyurtma raqami</b>: @Html.DisplayFor(model => model.OrderCode, new { @class = "form-control" })</span>
                                            <hr />
                                            <span><b>Buyurtma raqami EDO</b>: @Html.DisplayFor(model => model.OrderCodeEDO, new { @class = "form-control" })</span>
                                            <hr />
                                            <span><b>Yaratilgan sanasi</b>: @Html.DisplayFor(model => model.CreatedDT.Date.Date, new { @class = "form-control" })</span>
                                            <hr />
                                            <span><b>Tasdiqlangan (EDO) sanasi</b>: @Html.DisplayFor(model => model.ApprovedDTEDO.Date.Date, new { @class = "form-control" })</span>
                                            <hr />
                                            <span><b>Izoh</b>: @Html.DisplayFor(model => model.Comment, new { @class = "form-control" }) </span>
                                            <hr />
                                            <span><b>Status</b>: @Html.DisplayFor(model => model.Status, new { @class = "form-control" })</span>
                                            <hr />
                                            <span><b>Ijroga ma'sul xarid xodimi </b>: @Html.DisplayFor(model => model.USER1.FullName, new { @class = "form-control" })</span>
                                            <hr />
                                            <span><b>Kim tomonidan yuklandi</b>: @Html.DisplayFor(model => model.USER.FullName, new { @class = "form-control" })</span>
                                            <hr />
                                        </div>
                                    </div>
                                    <section id="column-selectors">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="card">
                                                    <div class="card-header">
                                                        <h4 class="card-title">Buyurtma predmeti</h4>
                                                    </div>
                                                    <div class="card-content">
                                                        <div class="card-body card-dashboard">
                                                            <div class="table-responsive">
                                                                <table class="table table-striped dataex-html5-selectors" style="width:100%">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Predmet nomi</th>
                                                                            <th>Birlik narxi</th>
                                                                            <th>Miqdori</th>
                                                                            <th>Umumiy narx</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var item in ViewBag.partList)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    <a href="~/PurchasingItem/Details/@item.ItemID">@item.PURCHASING_ITEMS.ItemName</a>
                                                                                </td>
                                                                                <td>@item.Price @item.Currency</td>
                                                                                <td>@item.Amount</td>
                                                                                <td>@item.TotalPrice @item.Currency</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

