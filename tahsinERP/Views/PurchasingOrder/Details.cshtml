@model  tahsinERP.Models.PURCHASING_ORDERS
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .progress-bar {
        background-color: #e0e0e0;
        border-radius: 10px;
        height: 30px;
        position: relative;
    }

    .element {
        background-color: #4caf50;
        height: 100%;
        line-height: 30px;
        text-align: center;
        color: white;
        border-radius: 5px;
        transition: width 1.5s;
    }
</style>

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item ">
                                        <a href="~/PurchasingOrder">Xarid buyurtmalari</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @Model.OrderCode buyurtma haqida batafsil ma'lumot
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-xl-11 col-md-10 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body pb-0 mx-25">
                                    <div class="row invoice-info">
                                        <div class="col-lg-12 col-md-6 mt-25">
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <h4 class="text-primary">Buyurtma  ma'lumotlari</h4>
                                            <br />
                                            <span>Buyurtma raqami EDO:<b> @Html.DisplayFor(model => model.OrderCodeEDO, new { @class = "form-control" })</b></span>
                                            <br />
                                            <span>Yaratilgan sanasi:<b> @Model.CreatedDT.ToString("dd.MM.yyyy")</b></span>
                                            <br />
                                            <span>Tasdiqlangan (EDO) sanasi:<b> @Model.ApprovedDTEDO.Value.ToString("dd.MM.yyyy")</b></span>
                                            <br />
                                            <span>Buyurtma beruvchi bo'lim:<b> @Html.DisplayFor(model => model.OrderedByDept, new { @class = "form-control" })</b></span>
                                            <br />
                                            <span>Buyurtma beruvchi xodim:<b> @Html.DisplayFor(model => model.OrderedByUser, new { @class = "form-control" })</b></span>
                                            <br />
                                            <span>Izoh:<b> @Html.DisplayFor(model => model.Comment, new { @class = "form-control" }) </b></span>
                                            <br />
                                            <hr />
                                            <span>Ijroga ma'sul xarid xodimi :<b> @Html.DisplayFor(model => model.USER1.FullName, new { @class = "form-control" })</b></span>
                                            <br />
                                            <span>Kim tomonidan yuklandi:<b> @Html.DisplayFor(model => model.USER.FullName, new { @class = "form-control" })</b></span>
                                            <hr />
                                                <b>Status</b>:
                                                <div class="progress-bar">
                                                    <div id="progress-element-@Model.ID" class="element" style="width: 0%;">0%</div>
                                                </div>
                                            <hr />

                                            <button id="downloadFileBtn" class="btn btn-outline-warning" onclick="downloadFile()">
                                                <i class='bx bx-save'></i> Original fayl yuklash
                                            </button>
                                            <div id="errorMessage" class="alert alert-danger" style="display: none;">
                                                Fayl yuklanmagan.
                                            </div>
                                        </div>
                                    </div>
                                    <section id="column-selectors">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="card">
                                                    <div class="card-header">
                                                        <h4 class="card-title">Buyurtma predmeti</h4>
                                                    </div>
                                                    <div class="card-content">
                                                        <div class="card-body card-dashboard">
                                                            <div class="table-responsive">
                                                                <table class="table table-striped dataex-html5-selectors" style="width:100%">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Predmet nomi</th>
                                                                            <th>Birlik narxi</th>
                                                                            <th>Miqdori</th>
                                                                            <th>Umumiy narx</th>
                                                                            <th>Status</th>
                                                                            <th>Izoh</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var item in ViewBag.partList)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    <a href="~/PurchasingItem/Details/@item.ItemID">@item.PURCHASING_ITEMS.ItemName</a>
                                                                                </td>
                                                                                <td>@item.Price @Model.CURRENCy.Shortname</td>
                                                                                <td>@item.Amount</td>
                                                                                <td>@item.TotalPrice @Model.CURRENCy.Shortname</td>
                                                                                @if (item.Status == true)
                                                                                {
                                                                                    <td><span class="badge badge-light-success">Tasdiqlangan</span></td>
                                                                                }
                                                                                else if (item.Status == false)
                                                                                {
                                                                                    <td><span class="badge badge-light-danger">Bekor qilingan</span></td>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <td><span class="badge badge-light-secondary">Jarayonda</span></td>
                                                                                }
                                                                                <td>@item.Comment</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>

                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script type="text/javascript">
    function downloadFile() {
        var PurchasingOrderID = @Model.ID; // Assuming Model.ID is the contract ID

        $.ajax({
            url: '@Url.Action("DownloadDoc", "PurchasingOrder")',
            type: 'GET',
            data: { PurchasingOrderID: PurchasingOrderID },
            success: function (response) {
                if (response.success === false) {
                    $('#errorMessage').text(response.message).show();
                } else {
                    window.location.href = '@Url.Action("DownloadDoc", "PurchasingOrder")' + "?PurchasingOrderID=" + PurchasingOrderID;
                }
            },
            error: function (xhr, status, error) {
                $('#errorMessage').text("Xatolik yuz berdi, fayl yuklanmadi.").show();
            }
        });
    }
    $(document).ready(function() {
        $('#downloadFileBtn').click(function(e) {
            e.preventDefault(); // Prevent default behavior

            var PurchasingOrderID = @Model.ID; // Get the contract ID dynamically

            $.ajax({
                url: '@Url.Action("DownloadDoc", "PurchasingOrder")',
                type: 'GET',
                data: { PurchasingOrderID: PurchasingOrderID },
                success: function(response) {
                    if (response.success === false) {
                        showAlert(response.message); // Show the alert if the file is not found
                    } else {
                        $('#alertMessage').hide(); // Hide the alert if the file exists
                        window.location.href = '@Url.Action("DownloadDoc", "PurchasingOrder")' + "?PurchasingOrderID=" + PurchasingOrderID;
                    }
                },
                error: function(xhr, status, error) {
                    showAlert("Xatolik yuz berdi, fayl yuklanmadi.");
                }
            });
        });
    });
</script>


<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        var orderID = '@Model.ID'; // Get the order ID from the model

        // Call the function to update the progress bar for this specific order
        updateProgressBar(orderID, 'progress-element-' + orderID);
    });

    // Function to update the progress bar for a specific order
    function updateProgressBar(orderID, progressElementId) {
        $.ajax({
            url: '/PurchasingOrder/GetProgressPercentage', // Call your action
            type: 'GET',
            data: { ID: orderID }, // Pass the order ID to the controller
            success: function (response) {
                // Update the progress bar's width and text
                $('#' + progressElementId).css('width', response + '%');
                $('#' + progressElementId).text(response + '%');
            },
            error: function () {
                console.error('Failed to get progress percentage.');
            }
        });
    }
</script>
