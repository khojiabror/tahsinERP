@model List<tahsinERP.Models.PURCHASING_ORDERS>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .progress-bar {
        background-color: #e0e0e0;
        border-radius: 5px;
        height: 20px;
        position: relative;
    }

    .element {
        background-color: #4caf50;
        height: 100%;
        line-height: 20px;
        text-align: center;
        color: white;
        border-radius: 5px;
        transition: width 1.5s;
    }
</style>
@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = false;
    if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
    {
        changePermit = true;
    }
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item ">
                                        Sahifalar
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Xarid buyurtmalari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <!-- users list start -->
                <section class="invoice-list-wrapper">
                    <div class="invoice-create-btn mb-1">
                        @if (changePermit)
                        {
                            <button type="button" class="btn btn-outline-success mr-1 mb-1" onclick="window.location.href='/PurchasingOrder/Create';">
                                <span class="align-middle ml-25">Buyurtma qo'shish</span>
                            </button>
                            <a href="@Url.Action("UploadWithExcel", "PurchasingOrder")" class="btn btn-outline-primary mr-1 mb-1" role="button" aria-pressed="true">
                                Buyurtmani Excel orqali qo'shish
                            </a>
                        }
                    </div>
                    @* <div class="users-list-filter px-1">
                            <form>
                                <div class="row border rounded py-2 mb-2">
                                    <div class="col-12 col-sm-12 col-lg-4">
                                        <label>Turi</label>
                                        <fieldset class="form-group">
                                            @Html.DropDownList("SourceID", ViewBag.SourceList as SelectList, new { @class = "form-control", onchange = "refreshDataTable()" })
                                        </fieldset>
                                    </div>
                                    <div class="col-12 col-sm-12 col-lg-4">
                                        <label>Ta'minotchisi</label>
                                        <fieldset class="form-group">
                                            @Html.DropDownList("SupplierID", ViewBag.SupplierList as SelectList, new { @class = "form-control", onchange = "refreshDataTable()" })
                                        </fieldset>
                                    </div>
                                    <div class="col-12 col-sm-12 col-lg-4 d-flex align-items-center">
                                        <a href="~/Part" class="btn btn-secondary bg-light invoice-create" role="button" aria-pressed="true">
                                            Ro'yxatni yangilash
                                        </a>
                                    </div>
                                </div>
                            </form>
                        </div>*@
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- datatable start -->
                                    <div class="table-responsive table-responsivetable-responsive">
                                        <table class="table invoice-data-table dt-responsive nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th></th>
                                                    <th></th>
                                                    <th>Buyurtma raqami(EDO)</th>
                                                    <th>Заявитель</th>
                                                    <th>Buyurtma holati</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td></td>
                                                        <td></td>
                                                        <td>
                                                            <a href="~/PurchasingOrder/Details/@item.ID">@item.OrderCodeEDO</a>
                                                        </td>
                                                        <td>@item.OrderedByDept</td>
                                                        <td>
                                                            <div class="progress-bar">
                                                                <div id="progress-element-@item.ID" class="element" style="width: 0%;">0%</div>
                                                            </div>
                                                        </td>
                                                        @if (changePermit)
                                                        {
                                                            <td>
                                                                <div>
                                                                    <a href="@Url.Action("Edit", "PurchasingOrder", new { id = item.ID })"><i class="bx bx-edit-alt"></i></a>
                                                                    <a href="@Url.Action("Delete", "PurchasingOrder", new { id = item.ID})"><i class="bx bx-trash"></i></a>
                                                                </div>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>

    //////////////////////////
    // Function to update the progress bar for a specific order
    function updateProgressBar(orderID, progressElementId) {
        $.ajax({
            url: '/PurchasingOrder/GetProgressPercentage', // Point to your action
            type: 'GET',
            data: { ID: orderID }, // Pass the orderID to the controller
            success: function (response) {
                // Update the progress bar's width and text
                $('#' + progressElementId).css('width', response + '%');
                $('#' + progressElementId).text(response + '%');
            },
            error: function () {
                console.error('Failed to get progress percentage.');
            }
        });
    }
    $(document).ready(function () {
        $('tbody tr').each(function () {
            var orderID = $(this).find('td:nth-child(3) a').attr('href').split('/').pop(); // Extract ID from link
            var progressElementId = 'progress-element-' + orderID; // Make the ID for the progress bar

            // Call the function for each order
            updateProgressBar(orderID, progressElementId);
        });
    });

</script>