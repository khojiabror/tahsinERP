@model tahsinERP.ViewModels.HR.KoreshokResultViewModel
@{
    Layout = null;
    ViewBag.Title = L.T("Hr_KorTitle");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: #eef7ef; }
        .shell { max-width: 1100px; margin: 24px auto; background: #fff; border-radius: 12px; box-shadow: 0 8px 25px rgba(0,0,0,.08); padding: 18px; }
        .title { font-weight: 800; color: #0f5132; }
        .meta { background: #f8fff8; border: 1px solid #d7f2df; border-radius: 10px; padding: 12px; }
        .tbl th { background: #198754; color: #fff; }
        .kpi { font-size: 1.15rem; font-weight: 700; }
    </style>
</head>
<body>
    <div class="shell" id="printArea">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="title h4 mb-0">@L.T("Hr_KorEmployeeTitle")</div>
            <div>
                <a class="btn btn-secondary btn-sm" href="@Url.Action("Index","Koreshok")">@L.T("Back")</a>
                <button class="btn btn-success btn-sm" onclick="window.print()">@L.T("Print")</button>
            </div>
        </div>
        <div class="meta mb-3">
            <div class="row">
                <div class="col-md-4"><b>@L.T("Hr_Employee"):</b> @Model.EmployeeName</div>
                <div class="col-md-2"><b>@L.T("Hr_Timesheet"):</b> @Model.TabNo</div>
                <div class="col-md-3"><b>@L.T("Hr_From"):</b> @Model.DateFrom.ToString("dd.MM.yyyy")</div>
                <div class="col-md-3"><b>@L.T("Hr_To"):</b> @Model.DateTo.ToString("dd.MM.yyyy")</div>
            </div>
        </div>

        <table class="table table-bordered tbl">
            <thead>
                <tr><th>@L.T("Hr_KorSection")</th><th>@L.T("Hr_Accrued")</th><th>@L.T("Hr_WorkedDays")</th><th>@L.T("Hr_WorkedHours")</th><th>@L.T("Hr_Paid")</th><th>@L.T("Hr_Balance")</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td>@L.T("Hr_KorHourlyPay")</td>
                    <td>@Model.HourlyCalculated.ToString("N2")</td>
                    <td>@Model.HourlyWorkedDays.ToString("N1")</td>
                    <td>@Model.HourlyWorkedHours.ToString("N2")</td>
                    <td>@Model.HourlyPaid.ToString("N2")</td>
                    <td>@Model.HourlyBalance.ToString("N2")</td>
                </tr>
                <tr>
                    <td>@L.T("Hr_KorPiecePay")</td>
                    <td>@Model.PieceCalculated.ToString("N2")</td>
                    <td>-</td>
                    <td>-</td>
                    <td>@Model.PiecePaid.ToString("N2")</td>
                    <td>@Model.PieceBalance.ToString("N2")</td>
                </tr>
            </tbody>
            <tfoot>
                <tr class="table-success">
                    <td><b>@L.T("Total")</b></td>
                    <td class="kpi">@Model.TotalCalculated.ToString("N2")</td>
                    <td>-</td>
                    <td>-</td>
                    <td class="kpi">@Model.TotalPaid.ToString("N2")</td>
                    <td class="kpi">@Model.TotalBalance.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>

        @if (Model.Notes.Any())
        {
            <div class="alert alert-warning">
                @foreach (var n in Model.Notes) { <div>- @n</div> }
            </div>
        }
    </div>
</body>
</html>
