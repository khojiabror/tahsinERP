@model List<tahsinERP.Models.CUSTOMER>
@{
    ViewBag.Title = L.T("Menu_List");
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    bool changePermit = false;
    if (tahsinERP.Models.RoleHelper.IsPermittedForAction(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString(), true))
    {
        changePermit = true;
    }
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>

                                    <li class="breadcrumb-item active">
                                        @L.T("Menu_Customers")
                                    </li>

                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <!-- users list start -->
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "Customer")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                @L.T("Crm_CustAdd")
                            </a>
                        </div>
                    }
                    @using (Html.BeginForm("Index", "Customer", FormMethod.Get, new { @class = "form" }))
                    {
                        <div class="row border rounded py-2 mb-2 mx-0">
                            <div class="col-12 col-md-6">
                                <input type="text" name="searchTerm" class="form-control" placeholder="@L.T("Crm_CustSearchPh")" value="@ViewBag.SearchTerm" />
                            </div>
                            <div class="col-6 col-md-3">
                                <button type="submit" class="btn btn-primary w-100"><i class="bx bx-search"></i> @L.T("Search")</button>
                            </div>
                            <div class="col-6 col-md-3">
                                <a class="btn btn-success w-100" href="@(Url.Action("ExportExcel", "Customer") + Request.Url.Query)"><i class="bx bxs-file-excel"></i> @L.T("Crm_ExcelAll")</a>
                            </div>
                        </div>
                    }
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="customerDataTable" data-crm-table data-lock-last="@(changePermit ? "true" : "false")" data-searching="false" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Crm_CustName")</th>
                                                    <th>@L.T("Crm_CustEmail")</th>
                                                    <th>DUNS</th>
                                                    <th>@L.T("Type")</th>
                                                    @if (changePermit)
                                                    {
                                                        <th class="text-center">@L.T("Actions")</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "Customer", new { id = item.ID })" class="font-weight-bold">
                                                                    @(item.Name ?? "")
                                                                </a>
                                                            </td>
                                                            <td>@(item.Email ?? "-")</td>
                                                            <td>@(item.DUNS ?? "-")</td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(item.Type))
                                                                {
                                                                    <span class="badge badge-light-info">@item.Type</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            @if (changePermit)
                                                            {
                                                                <td class="text-center">
                                                                    <a href="@Url.Action("Edit", "Customer", new { id = item.ID })" 
                                                                       class="btn btn-sm btn-outline-primary" title="@L.T("Edit")">
                                                                        <i class="bx bx-edit"></i>
                                                                    </a>
                                                                    <a href="@Url.Action("Delete", "Customer", new { id = item.ID })" 
                                                                       class="btn btn-sm btn-outline-danger" title="@L.T("Delete")">
                                                                        <i class="bx bx-trash"></i>
                                                                    </a>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    @Html.Partial("~/Views/SalesInvoices/_Pager.cshtml")
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script src="@Url.Content("~/Scripts/crm/crm-page-table.js")"></script>
}
