@model List<tahsinERP.Models.CUSTOMER>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = false;
    if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
    {
        changePermit = true;
    }
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>

                                    <li class="breadcrumb-item active">
                                        Haridorlar
                                    </li>

                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <!-- users list start -->
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "Customer")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                Yangi
                                Haridor qo'shish
                            </a>
                        </div>
                    }
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- Search and Filter -->
                                    <div class="users-list-filter px-1">
                                        <div class="row border rounded py-2 mb-2">
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <label>Qidirish</label>
                                                <input type="text" id="searchBox" class="form-control" placeholder="Haridor ismi, Email, DUNS..." />
                                            </div>
                                            <div class="col-12 col-sm-6 col-lg-2">
                                                <label>Sahifa o'lchami</label>
                                                <select id="pageSize" class="form-control">
                                                    <option value="10">10</option>
                                                    <option value="25" selected>25</option>
                                                    <option value="50">50</option>
                                                    <option value="100">100</option>
                                                    <option value="-1">Barchasi</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- datatable start -->
                                    <div class="card-datatable table-responsive">
                                        <table id="customerDataTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Haridor ismi</th>
                                                    <th>Elektron manzili</th>
                                                    <th>DUNS</th>
                                                    <th>Turi</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "Customer", new { id = item.ID })">@(item.Name ?? "")</a>
                                                            </td>
                                                            <td>@(item.Email ?? "")</td>
                                                            <td>@(item.DUNS ?? "")</td>
                                                            <td>@(item.Type ?? "")</td>
                                                            @if (changePermit)
                                                            {
                                                                <td>
                                                                    <div>
                                                                        <a href="@Url.Action("Edit", "Customer", new { id = item.ID })" title="Tahrirlash"><i class="bx bx-edit-alt"></i></a>
                                                                        <a href="@Url.Action("Delete", "Customer", new { id = item.ID })" title="O'chirish"><i class="bx bx-trash"></i></a>
                                                                    </div>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="@(changePermit ? 5 : 4)" class="text-center">Ma'lumot topilmadi</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <!-- datatable ends -->
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            // Initialize DataTable
            var tableConfig = {
                "language": {
                    "search": "Qidirish:",
                    "lengthMenu": "_MENU_ ta ko'rsatish",
                    "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    "infoEmpty": "Yozuvlar yo'q",
                    "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                    "paginate": {
                        "first": "Birinchi",
                        "last": "Oxirgi",
                        "next": "Keyingi",
                        "previous": "Oldingi"
                    },
                    "zeroRecords": "Ma'lumot topilmadi"
                },
                "pageLength": 25,
                "order": [[0, "asc"]]
            };

            @if (changePermit)
            {
                <text>
            tableConfig.columnDefs = [
                { "orderable": false, "targets": -1 }
            ];
                </text>
            }

            var table = $('#customerDataTable').DataTable(tableConfig);

            // Custom search box
            $('#searchBox').on('keyup', function() {
                table.search(this.value).draw();
            });

            // Page size change
            $('#pageSize').on('change', function() {
                var pageSize = $(this).val();
                if (pageSize === '-1') {
                    table.page.len(-1).draw();
                } else {
                    table.page.len(parseInt(pageSize)).draw();
                }
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}