@model tahsinERP.Models.Warehouse

@{
    ViewBag.Title = L.T("Wh_DeleteWarehouse");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller action'ida tekshiriladi (SRM-M05). *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Warehouse/Index">@L.T("Wh_CompanyWarehouses")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Wh_DeleteWarehouse")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-xl-9 col-md-8 col-12">
                        <div class="card">
                            <div class="card-header bg-danger">
                                <h4 class="card-title text-white">
                                    <i class="bx bx-error-circle"></i> @L.T("Wh_DeleteWarehouse")
                                </h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="alert alert-warning border-warning">
                                        <i class="bx bx-error-circle"></i>
                                        <strong>@L.T("Wh_Attention")</strong> @L.T("Wh_DeleteWarehouseWarning")
                                    </div>

                                    <div class="row">
                                        <div class="col-md-12">
                                            <dl class="row">
                                                <dt class="col-sm-4">@L.T("Wh_WarehouseNameColon")</dt>
                                                <dd class="col-sm-8">
                                                    <strong>@Html.DisplayFor(model => model.WHName)</strong>
                                                </dd>

                                                <dt class="col-sm-4">@L.T("Wh_DescriptionColon")</dt>
                                                <dd class="col-sm-8">
                                                    @(string.IsNullOrEmpty(Model.Description) ? "-" : Model.Description)
                                                </dd>

                                                <dt class="col-sm-4">@L.T("Wh_ShopColon")</dt>
                                                <dd class="col-sm-8">
                                                    @(Model.SHOP?.ShopName ?? "-")
                                                </dd>

                                                <dt class="col-sm-4">@L.T("Wh_MrpResponsibleColon")</dt>
                                                <dd class="col-sm-8">
                                                    @(Model.USER?.FullName ?? "-")
                                                </dd>
                                            </dl>
                                        </div>
                                    </div>

                                    <hr />

                                    @using (Html.BeginForm("Delete", "Warehouse", new { id = Model.ID }, FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(model => model.ID)

                                        <div class="form-actions d-flex justify-content-between">
                                            <a href="@Url.Action("Index", "Warehouse")" class="btn btn-secondary">
                                                <i class="bx bx-arrow-back"></i> @L.T("Cancel")
                                            </a>
                                            <button type="submit" class="btn btn-danger" onclick="return confirm('@L.Js("Wh_ConfirmDeleteWarehouse")');">
                                                <i class="bx bx-trash"></i> @L.T("Wh_YesDelete")
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
