@model List<tahsinERP.Models.Warehouse>

@{
    ViewBag.Title = L.T("Wh_CompanyWarehouses");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    bool changePermit = ViewBag.ChangePermit as bool? ?? false;
    bool dlocEnabled = ViewBag.DlocEnabled as bool? ?? false;
}
<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        @Html.Link(L.T("Wh_Pages"), "InventoryReports", "Dashboard")
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Wh_CompanyWarehouses")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bx bx-check-circle"></i> @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bx bx-error-circle"></i> @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }
                    
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "Warehouse")" class="btn btn-outline-success mr-1 mb-1">
                                <i class="bx bx-plus"></i>
                                <span class="align-middle ml-25">@L.T("Wh_AddWarehouse")</span>
                            </a>
                        </div>
                    }
                    
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="myDataTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Wh_WarehouseName")</th>
                                                    <th>@L.T("Description")</th>
                                                    <th>@L.T("Type")</th>
                                                    <th>@L.T("Wh_MrpResponsible")</th>
                                                    @if (dlocEnabled)
                                                    {
                                                        <th>DLOC</th>
                                                    }
                                                    @if (changePermit)
                                                    {
                                                        <th>@L.T("Actions")</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>
                                                            <a href="@Url.Action("Details", "Warehouse", new { id = item.ID })" class="text-primary">
                                                                <strong>@item.WHName</strong>
                                                            </a>
                                                        </td>
                                                        <td>@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                                                        <td>@tahsinERP.Services.Stock.WarehouseRoles.DisplayName(item.WarehouseType)</td>
                                                        <td>@(item.USER?.FullName ?? "-")</td>
                                                        @if (dlocEnabled)
                                                        {
                                                            <td>
                                                                <div class="d-inline-flex">
                                                                    <a href="@Url.Action("Index", "WarehouseLocations", new { warehouseId = item.ID })"
                                                                       class="btn btn-sm btn-icon btn-info mr-1"
                                                                       title="@L.T("Wh_DlocList")">
                                                                        <i class="bx bx-grid-alt"></i>
                                                                    </a>
                                                                    @if (changePermit)
                                                                    {
                                                                        <a href="@Url.Action("Create", "WarehouseLocations", new { warehouseId = item.ID })"
                                                                           class="btn btn-sm btn-icon btn-success"
                                                                           title="@L.T("Wh_AddDloc")">
                                                                            <i class="bx bx-plus"></i>
                                                                        </a>
                                                                    }
                                                                </div>
                                                            </td>
                                                        }
                                                        @if (changePermit)
                                                        {
                                                            <td>
                                                                <div class="d-inline-flex">
                                                                    <a href="@Url.Action("Edit", "Warehouse", new { id = item.ID })"
                                                                       class="btn btn-sm btn-icon btn-primary mr-1"
                                                                       title="@L.T("Edit")">
                                                                        <i class="bx bx-edit-alt"></i>
                                                                    </a>
                                                                    <a href="@Url.Action("Delete", "Warehouse", new { id = item.ID })"
                                                                       class="btn btn-sm btn-icon btn-danger"
                                                                       title="@L.T("Delete")">
                                                                        <i class="bx bx-trash"></i>
                                                                    </a>
                                                                </div>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            $('#myDataTable').DataTable({
                "order": [[0, "asc"]],
                "pageLength": 25,
                "responsive": true,
                dom: 'lBfrtip',
                buttons: erpDataTable.buttons({ small: true })
            });
        });
    </script>
