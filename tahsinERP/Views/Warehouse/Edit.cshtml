@model tahsinERP.Models.Warehouse
@{
    ViewBag.Title = L.T("Wh_EditWarehouse");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller action'ida tekshiriladi (SRM-M05). *@
@{
    using (Html.BeginForm("Edit", "Warehouse", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ID)
        
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/Warehouse/Index">@L.T("Wh_CompanyWarehouses")</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            @L.T("Wh_EditWarehouse")
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="basic-select2">
                        <div class="row">
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h4 class="card-title">@L.T("Wh_EditWarehouse")</h4>
                                    </div>
                                    <div class="card-content">
                                        <div class="card-body">
                                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                                            
                                            <div class="form-group">
                                                <label for="WHName">@L.T("Wh_WarehouseName") <span class="text-danger">*</span></label>
                                                @Html.TextBoxFor(model => model.WHName, new { @class = "form-control", @placeholder = L.T("Wh_WhNamePlaceholder"), @required = "required" })
                                                @Html.ValidationMessageFor(model => model.WHName, "", new { @class = "text-danger" })
                                            </div>
                                            
                                            <div class="form-group">
                                                <label for="Description">@L.T("Description")</label>
                                                @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @placeholder = L.T("Wh_WhDescPlaceholder"), @rows = "3" })
                                                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                            </div>
                                            
                                            
                                            <div class="form-group">
                                                <label for="WarehouseType">@L.T("Wh_WarehouseType")</label>
                                                @Html.DropDownListFor(model => model.WarehouseType, ViewBag.WarehouseTypes as SelectList, L.T("Wh_RegularWarehouseOpt"), new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.WarehouseType, "", new { @class = "text-danger" })
                                                <small class="text-muted">@L.T("Wh_WarehouseTypeHint")</small>
                                            </div>
                                            @if (ViewBag.ShowShop == true)
                                            {
                                                <div class="form-group" id="shopGroup">
                                                    <label for="ShopID">@L.T("Wh_ProductionShop")</label>
                                                    @Html.DropDownListFor(model => model.ShopID, ViewBag.ShopList as SelectList, L.T("Wh_SelectDashed"), new { @class = "form-control select2" })
                                                    @Html.ValidationMessageFor(model => model.ShopID, "", new { @class = "text-danger" })
                                                    <small class="text-muted">@L.T("Wh_ProductionShopHint")</small>
                                                </div>
                                            }
                                            @Html.Partial("_ManualIncomeField", Model)
                                            <div class="form-group">
                                                <label for="MRP">@L.T("Wh_MrpLiable") <span class="text-danger">*</span></label>
                                                @Html.DropDownListFor(model => model.MRP, ViewBag.MRPUsers as SelectList, L.T("Wh_SelectDashed"), new { @class = "form-control select2" })
                                                @Html.ValidationMessageFor(model => model.MRP, "", new { @class = "text-danger" })
                                                <small class="text-muted">@L.T("Wh_MrpHint")</small>
                                            </div>
                                            
                                            <div class="form-actions">
                                                <button type="submit" class="btn btn-primary">
                                                    <i class="bx bx-save"></i> @L.T("Save")
                                                </button>
                                                <a href="@Url.Action("Index", "Warehouse")" class="btn btn-light">
                                                    <i class="bx bx-x"></i> @L.T("Cancel")
                                                </a>
                                                <a href="@Url.Action("Details", "Warehouse", new { id = Model.ID })" class="btn btn-info">
                                                    <i class="bx bx-info-circle"></i> @L.T("Details")
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
    
}

@* jQuery layout oxirida yuklanadi — skript shu section orqali undan keyin *@
@section scripts {
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                placeholder: "@L.Js("Select")",
                allowClear: true
            });
            // Sex faqat ishlab chiqarish omboriga tegishli
            function toggleShop() {
                var isProd = $('#WarehouseType').val() === 'PRODUCTION';
                $('#shopGroup').toggle(isProd);
                if (!isProd) $('#ShopID').val('').trigger('change');
            }
            $('#WarehouseType').on('change', toggleShop);
            toggleShop();
            // "Standart" bandida ombor turi bo'yicha natija (Ha/Yo'q)
            var manualIncomeDefaults = @Html.Raw(Json.Encode(ViewBag.ManualIncomeDefaults));
            var $manualDefaultOpt = $('#AllowManualIncome option[value=""]');
            var manualDefaultText = $manualDefaultOpt.text();
            function updateManualIncomeDefault() {
                var on = manualIncomeDefaults[$('#WarehouseType').val() || ''] === true;
                $manualDefaultOpt.text(manualDefaultText + ': ' + (on ? '@L.Js("Js_Yes")' : '@L.Js("Js_No")'));
            }
            $('#WarehouseType').on('change', updateManualIncomeDefault);
            updateManualIncomeDefault();
        });
    </script>
}
