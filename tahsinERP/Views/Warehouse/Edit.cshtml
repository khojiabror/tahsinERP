@model tahsinERP.Models.Warehouse
@{
    ViewBag.Title = "Omborni tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller action'ida tekshiriladi (SRM-M05). *@
@{
    using (Html.BeginForm("Edit", "Warehouse", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ID)
        
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/Warehouse/Index">Korxona omborlari</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            Omborni tahrirlash
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="basic-select2">
                        <div class="row">
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h4 class="card-title">Omborni tahrirlash</h4>
                                    </div>
                                    <div class="card-content">
                                        <div class="card-body">
                                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                                            
                                            <div class="form-group">
                                                <label for="WHName">Ombor nomi <span class="text-danger">*</span></label>
                                                @Html.TextBoxFor(model => model.WHName, new { @class = "form-control", @placeholder = "Masalan: Ishlab chiqarish ombori", @required = "required" })
                                                @Html.ValidationMessageFor(model => model.WHName, "", new { @class = "text-danger" })
                                            </div>
                                            
                                            <div class="form-group">
                                                <label for="Description">Tavsif</label>
                                                @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @placeholder = "Ombor haqida qisqacha ma'lumot", @rows = "3" })
                                                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                            </div>
                                            
                                            <div class="form-group">
                                                <label for="ShopID">Sex</label>
                                                @Html.DropDownListFor(model => model.ShopID, ViewBag.ShopList as SelectList, "---Tanlang---", new { @class = "form-control select2"})
                                                @Html.ValidationMessageFor(model => model.ShopID, "", new { @class = "text-danger" })
                                            </div>
                                            
                                            <div class="form-group">
                                                <label for="MRP">MRP (Moddiy javobgar shaxs) <span class="text-danger">*</span></label>
                                                @Html.DropDownListFor(model => model.MRP, ViewBag.MRPUsers as SelectList, "---Tanlang---", new { @class = "form-control select2" })
                                                @Html.ValidationMessageFor(model => model.MRP, "", new { @class = "text-danger" })
                                                <small class="text-muted">Material Requirements Planning mas'ul shaxsi</small>
                                            </div>
                                            
                                            <div class="form-actions">
                                                <button type="submit" class="btn btn-primary">
                                                    <i class="bx bx-save"></i> Saqlash
                                                </button>
                                                <a href="@Url.Action("Index", "Warehouse")" class="btn btn-light">
                                                    <i class="bx bx-x"></i> Bekor qilish
                                                </a>
                                                <a href="@Url.Action("Details", "Warehouse", new { id = Model.ID })" class="btn btn-info">
                                                    <i class="bx bx-info-circle"></i> Batafsil
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
    
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                placeholder: "Tanlang",
                allowClear: true
            });
        });
    </script>
}
