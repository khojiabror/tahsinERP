@model tahsinERP.Models.HR_POSITIONS
@{
    ViewBag.Title = "Lavozim tafsilotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    @{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrPositions"); }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Lavozimlar</a></li>
                                    <li class="breadcrumb-item active">Tafsilotlar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">Kod:</dt>
                                <dd class="col-sm-9">@Model.Code</dd>

                                <dt class="col-sm-3">Nomi:</dt>
                                <dd class="col-sm-9">@Model.Name</dd>

                                <dt class="col-sm-3">Rahbariyat lavozimi:</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.IsManager ? "info" : "secondary")">
                                        @(Model.IsManager ? "Ha" : "Yo'q")
                                    </span>
                                </dd>

                                <dt class="col-sm-3">Holat:</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.IsActive ? "success" : "danger")">
                                        @(Model.IsActive ? "Faol" : "Nofaol")
                                    </span>
                                </dd>

                                <dt class="col-sm-3">Xodimlar soni:</dt>
                                <dd class="col-sm-9">@ViewBag.EmployeeCount</dd>

                                <dt class="col-sm-3">Shtat jadvalida:</dt>
                                <dd class="col-sm-9">@ViewBag.StaffingPlanCount</dd>

                                <dt class="col-sm-3">Yaratilgan:</dt>
                                <dd class="col-sm-9">@Model.CreatedDT.ToString("dd.MM.yyyy HH:mm")</dd>
                            </dl>

                            <div class="form-actions mt-3">
                                @if (changePermit)
                                {
                                    <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                                        <i class="bx bx-edit"></i> Tahrirlash
                                    </a>
                                }
                                <a href="@Url.Action("Index")" class="btn btn-secondary">Ro'yxatga qaytish</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

