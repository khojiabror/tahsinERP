@model List<tahsinERP.Models.HR_POSITIONS>
@{
    ViewBag.Title = L.T("Hr_Positions");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    @{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrPositions"); }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item active">@L.T("Hr_Positions")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @if (changePermit)
                {
                    <div class="invoice-create-btn mb-1">
                        <a href="@Url.Action("Create")" class="btn btn-success">
                            <i class="bx bx-plus"></i> @L.T("Hr_PositionAdd")
                        </a>
                    </div>
                }

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <form method="get" action="@Url.Action("Index")" class="mb-2">
                                <div class="row">
                                    <div class="col-md-3">
                                        <select name="isActive" class="form-control">
                                            <option value="">@L.T("All")</option>
                                            <option value="true" @(ViewBag.IsActive == true ? "selected" : "")>@L.T("Active")</option>
                                            <option value="false" @(ViewBag.IsActive == false ? "selected" : "")>@L.T("Inactive")</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <select name="isManager" class="form-control">
                                            <option value="">@L.T("All")</option>
                                            <option value="true" @(ViewBag.IsManager == true ? "selected" : "")>@L.T("Hr_Management")</option>
                                            <option value="false" @(ViewBag.IsManager == false ? "selected" : "")>@L.T("Hr_Regular")</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <button type="submit" class="btn btn-primary btn-block">@L.T("Filter")</button>
                                    </div>
                                </div>
                            </form>

                            <div class="table-responsive">
                                <table id="positionsTable" class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>@L.T("Code")</th>
                                            <th>@L.T("Name")</th>
                                            <th>@L.T("Hr_Management")</th>
                                            <th>@L.T("Status")</th>
                                            <th>@L.T("CreatedAt")</th>
                                            <th>@L.T("Actions")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.Code</td>
                                                <td>@item.Name</td>
                                                <td>
                                                    <span class="badge badge-@(item.IsManager ? "info" : "secondary")">
                                                        @(item.IsManager ? L.T("Yes") : L.T("No"))
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge badge-@(item.IsActive ? "success" : "danger")">
                                                        @(item.IsActive ? L.T("Active") : L.T("Inactive"))
                                                    </span>
                                                </td>
                                                <td>@item.CreatedDT.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-info">
                                                        <i class="bx bx-show"></i>
                                                    </a>
                                                    @if (changePermit)
                                                    {
                                                        <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-warning">
                                                            <i class="bx bx-edit"></i>
                                                        </a>
                                                        <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-danger" onclick="return confirm('@L.Js("Hr_PositionDelete")?');">
                                                            <i class="bx bx-trash"></i>
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('#positionsTable').DataTable({
                "pageLength": 25,
                "order": [[1, "asc"]]
            });
        });
    </script>

