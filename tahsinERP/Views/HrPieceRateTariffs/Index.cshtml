@model List<tahsinERP.Models.HR_PIECE_RATE_TARIFFS>
@{
    ViewBag.Title = L.T("Hr_PrTariffs");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    @{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrPieceRateTariffs"); }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "HrPieceRateTimesheets")">@L.T("Hr_PrTimesheet")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Hr_PrTariffs")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @if (changePermit)
                {
                    <div class="invoice-create-btn mb-1">
                        <a href="@Url.Action("Create")" class="btn btn-success">
                            <i class="bx bx-plus"></i> @L.T("Hr_PrTariffAddShort")
                        </a>
                    </div>
                }

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <form method="get" action="@Url.Action("Index")" class="mb-2">
                                <div class="row">
                                    <div class="col-md-3">
                                        @Html.DropDownList("productId", ViewBag.ProductID as SelectList, L.T("Hr_AllProducts"), new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.DropDownList("positionId", ViewBag.PositionID as SelectList, L.T("Hr_AllPositions"), new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-2">
                                        <select name="isActive" class="form-control">
                                            <option value="">@L.T("All")</option>
                                            <option value="true" @(ViewBag.IsActive == true ? "selected" : "")>@L.T("Active")</option>
                                            <option value="false" @(ViewBag.IsActive == false ? "selected" : "")>@L.T("Inactive")</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-primary btn-block">@L.T("Filter")</button>
                                    </div>
                                </div>
                            </form>

                            <div class="table-responsive">
                                <table id="tariffsTable" class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>@L.T("Hr_Product")</th>
                                            <th>@L.T("Hr_Position")</th>
                                            <th>@L.T("Hr_Operation")</th>
                                            <th>@L.T("Hr_PrRatePerUnit")</th>
                                            <th>@L.T("Hr_PrValidFrom")</th>
                                            <th>@L.T("Hr_PrValidTo")</th>
                                            <th>@L.T("Status")</th>
                                            <th>@L.T("CreatedAt")</th>
                                            <th>@L.T("Actions")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@(item.PRODUCT?.PNo ?? "-")</td>
                                                <td>@(item.HR_POSITIONS?.Name ?? L.T("Hr_AllPositions"))</td>
                                                <td>@(item.HR_PIECE_RATE_OPERATIONS?.Name ?? "-")</td>
                                                <td>@item.RatePerUnit.ToString("N4") @(item.CURRENCy?.Shortname ?? "")</td>
                                                <td>@item.EffectiveFrom.ToString("dd.MM.yyyy")</td>
                                                <td>@(item.EffectiveTo?.ToString("dd.MM.yyyy") ?? L.T("Hr_Unlimited"))</td>
                                                <td>
                                                    <span class="badge badge-@(item.IsActive ? "success" : "secondary")">
                                                        @(item.IsActive ? L.T("Active") : L.T("Inactive"))
                                                    </span>
                                                </td>
                                                <td>@item.CreatedDT.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-info">
                                                        <i class="bx bx-show"></i>
                                                    </a>
                                                    @if (changePermit)
                                                    {
                                                        <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-warning">
                                                            <i class="bx bx-edit"></i>
                                                        </a>
                                                        <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-danger" onclick="return confirm('@L.Js("Hr_PrTariffDeleteQ")');">
                                                            <i class="bx bx-trash"></i>
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('#tariffsTable').DataTable({
                "pageLength": 25,
                "order": [[6, "desc"]]
            });
        });
    </script>

