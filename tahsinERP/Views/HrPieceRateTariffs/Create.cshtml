@model tahsinERP.Models.HR_PIECE_RATE_TARIFFS
@{
    ViewBag.Title = "Ishbay tarif qo'shish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrPieceRateTariffs"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Ishbay tariflari</a></li>
                                    <li class="breadcrumb-item active">Qo'shish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @using (Html.BeginForm("Create", "HrPieceRateTariffs", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ProductID, "Maxsulot", new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.ProductID, ViewBag.ProductID as SelectList, "Maxsulotni tanlang", new { @class = "form-control", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.ProductID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.PositionID, "Lavozim", new { @class = "control-label" })
                                            <small class="text-muted">(Bo'sh qoldirilsa, barcha lavozimlar uchun)</small>
                                            @Html.DropDownListFor(model => model.PositionID, ViewBag.PositionID as SelectList, "Barcha lavozimlar", new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.PositionID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.OperationID, "Operatsiya", new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.OperationID, ViewBag.OperationID as SelectList, "Operatsiyani tanlang", new { @class = "form-control", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.OperationID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.CurrencyID, "Valyuta", new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.CurrencyID, ViewBag.CurrencyID as SelectList, "Valyutani tanlang", new { @class = "form-control", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.RatePerUnit, "Tarif (birlik uchun)", new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.TextBoxFor(model => model.RatePerUnit, new { @class = "form-control", @type = "number", @step = "0.0001", @min = "0", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.RatePerUnit, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.EffectiveFrom, "Amal qilishdan", new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.TextBoxFor(model => model.EffectiveFrom, new { @class = "form-control", @type = "date", @required = "required", @value = DateTime.Now.ToString("yyyy-MM-dd") })
                                            @Html.ValidationMessageFor(model => model.EffectiveFrom, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.EffectiveTo, "Amal qilishgacha", new { @class = "control-label" })
                                            <small class="text-muted">(Bo'sh qoldirilsa, cheksiz)</small>
                                            @Html.TextBoxFor(model => model.EffectiveTo, new { @class = "form-control", @type = "date" })
                                            @Html.ValidationMessageFor(model => model.EffectiveTo, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            <div class="checkbox checkbox-secondary">
                                                @Html.CheckBoxFor(model => model.IsActive, new { @id = "checkboxActive", @checked = "checked" })
                                                <label for="checkboxActive">Faol</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-save"></i> Saqlash
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">Bekor qilish</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

