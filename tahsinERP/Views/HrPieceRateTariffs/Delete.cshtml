@model tahsinERP.Models.HR_PIECE_RATE_TARIFFS
@{
    ViewBag.Title = L.T("Hr_PrTariffDelete");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_PrTariffs")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Delete")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="alert alert-warning">
                    <strong>@L.T("Hr_Attention")</strong> @L.T("Hr_PrTariffDeleteConfirm")
                </div>

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">@L.T("Hr_Product"):</dt>
                                <dd class="col-sm-9">@(Model.PRODUCT?.PNo ?? "-")</dd>

                                <dt class="col-sm-3">@L.T("Hr_Position"):</dt>
                                <dd class="col-sm-9">@(Model.HR_POSITIONS?.Name ?? L.T("Hr_AllPositions"))</dd>

                                <dt class="col-sm-3">@L.T("Hr_Operation"):</dt>
                                <dd class="col-sm-9">@(Model.HR_PIECE_RATE_OPERATIONS?.Name ?? "-")</dd>

                                <dt class="col-sm-3">@L.T("Currency"):</dt>
                                <dd class="col-sm-9">@(Model.CURRENCy?.Shortname ?? "-")</dd>

                                <dt class="col-sm-3">@L.T("Hr_PrRatePerUnit"):</dt>
                                <dd class="col-sm-9">@Model.RatePerUnit.ToString("N4") @(Model.CURRENCy?.Shortname ?? "")</dd>

                                <dt class="col-sm-3">@L.T("Hr_PrValidFrom"):</dt>
                                <dd class="col-sm-9">@Model.EffectiveFrom.ToString("dd.MM.yyyy")</dd>

                                <dt class="col-sm-3">@L.T("Hr_PrValidTo"):</dt>
                                <dd class="col-sm-9">@(Model.EffectiveTo?.ToString("dd.MM.yyyy") ?? L.T("Hr_Unlimited"))</dd>

                                <dt class="col-sm-3">@L.T("Status"):</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.IsActive ? "success" : "secondary")">
                                        @(Model.IsActive ? L.T("Active") : L.T("Inactive"))
                                    </span>
                                </dd>
                            </dl>

                            @using (Html.BeginForm("Delete", "HrPieceRateTariffs", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(model => model.ID)

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bx bx-trash"></i> @L.T("Delete")
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("Cancel")</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

