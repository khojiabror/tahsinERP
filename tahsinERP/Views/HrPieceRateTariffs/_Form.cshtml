@model tahsinERP.Models.HR_PIECE_RATE_TARIFFS
@* Create va Edit uchun umumiy forma (HRM-D13). ViewBag.IsEdit = true — tahrirlash. *@
@{
    bool isEdit = ViewBag.IsEdit == true;
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_PrTariffs")</a></li>
                                    <li class="breadcrumb-item active">@(isEdit ? L.T("Edit") : L.T("Add"))</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @using (Html.BeginForm(isEdit ? "Edit" : "Create", "HrPieceRateTariffs", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    if (isEdit)
                    {
                        @Html.HiddenFor(model => model.ID)
                    }
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ProductID, L.T("Hr_Product"), new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.ProductID, ViewBag.ProductID as SelectList, L.T("Hr_SelectProduct"), new { @class = "form-control", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.ProductID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.PositionID, L.T("Hr_Position"), new { @class = "control-label" })
                                            <small class="text-muted">(@L.T("Hr_PrEmptyAllPositions"))</small>
                                            @Html.DropDownListFor(model => model.PositionID, ViewBag.PositionID as SelectList, L.T("Hr_AllPositions"), new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.PositionID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.OperationID, L.T("Hr_Operation"), new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.OperationID, ViewBag.OperationID as SelectList, L.T("Hr_SelectOperation"), new { @class = "form-control", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.OperationID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.CurrencyID, L.T("Currency"), new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.CurrencyID, ViewBag.CurrencyID as SelectList, L.T("Hr_SelectCurrency"), new { @class = "form-control", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.RatePerUnit, L.T("Hr_PrRatePerUnit"), new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.TextBoxFor(model => model.RatePerUnit, new { @class = "form-control", @type = "number", @step = "0.0001", @min = "0", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.RatePerUnit, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.EffectiveFrom, L.T("Hr_PrValidFrom"), new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @if (isEdit)
                                            {
                                                @Html.TextBoxFor(model => model.EffectiveFrom, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @required = "required" })
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(model => model.EffectiveFrom, new { @class = "form-control", @type = "date", @required = "required", @value = DateTime.Now.ToString("yyyy-MM-dd") })
                                            }
                                            @Html.ValidationMessageFor(model => model.EffectiveFrom, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.EffectiveTo, L.T("Hr_PrValidTo"), new { @class = "control-label" })
                                            <small class="text-muted">(@L.T("Hr_PrEmptyUnlimited"))</small>
                                            @Html.TextBoxFor(model => model.EffectiveTo, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                                            @Html.ValidationMessageFor(model => model.EffectiveTo, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            <div class="checkbox checkbox-secondary">
                                                @if (isEdit)
                                                {
                                                    @Html.CheckBoxFor(model => model.IsActive, new { @id = "checkboxActive" })
                                                }
                                                else
                                                {
                                                    @Html.CheckBoxFor(model => model.IsActive, new { @id = "checkboxActive", @checked = "checked" })
                                                }
                                                <label for="checkboxActive">@L.T("Active")</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-save"></i> @L.T("Save")
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("Cancel")</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

