@model tahsinERP.Models.FIN_TRANSACTIONS
@using System.Collections.Generic
@using System.Web.Helpers

@{
    ViewBag.Title = "Tranzaksiyani tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinTransactions"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/FinTransactions">Tranzaksiyalar</a></li>
                                    <li class="breadcrumb-item active">Tahrirlash</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-md-10">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Tranzaksiyani tahrirlash</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="alert alert-info">
                                        <h5>Diqqat (majburiy tavsiya)</h5>
                                        <p>Material/Oylik/Avans to'lovlarida <strong>Kontragent turi</strong> va <strong>Kontragent</strong> ni to'ldiring. Kontragent ro'yxati tur bo'yicha avtomatik yuklanadi.</p>
                                    </div>

                                    @using (Html.BeginForm("Edit", "FinTransactions", FormMethod.Post, new { @class = "form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(m => m.ID)
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.TxnDate, "Sana *", new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.TxnDate, new { @class = "form-control", type = "date", required = "required", @Value = Model.TxnDate.ToString("yyyy-MM-dd") })
                                                    @Html.ValidationMessageFor(m => m.TxnDate, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.AccountID, "Hisob *", new { @class = "control-label" })
                                                    @Html.DropDownListFor(m => m.AccountID, ViewBag.AccountID as SelectList, "Tanlang...", new { @class = "form-control", required = "required" })
                                                    @Html.ValidationMessageFor(m => m.AccountID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.CategoryID, "Kategoriya *", new { @class = "control-label" })
                                                    @Html.DropDownListFor(m => m.CategoryID, ViewBag.CategoryID as SelectList, "Tanlang...", new { @class = "form-control", required = "required" })
                                                    @Html.ValidationMessageFor(m => m.CategoryID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.Direction, "Yo'nalish *", new { @class = "control-label" })
                                                    @Html.DropDownListFor(m => m.Direction, ViewBag.DirectionList as SelectList, "Tanlang...", new { @class = "form-control", required = "required" })
                                                    @Html.ValidationMessageFor(m => m.Direction, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.Amount, "Summa *", new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01", required = "required" })
                                                    @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.CurrencyID, "Valyuta *", new { @class = "control-label" })
                                                    @Html.DropDownListFor(m => m.CurrencyID, ViewBag.CurrencyID as SelectList, "Tanlang...", new { @class = "form-control", required = "required" })
                                                    @Html.ValidationMessageFor(m => m.CurrencyID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.CounterpartyType, "Kontragent turi", new { @class = "control-label" })
                                                    @Html.DropDownListFor(m => m.CounterpartyType, ViewBag.CounterpartyTypeList as SelectList, new { @class = "form-control", id = "CounterpartyType" })
                                                    <small class="text-muted">Tanlaganingizga qarab quyidagi ro'yxat yuklanadi.</small>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.CounterpartyID, "Kontragent", new { @class = "control-label" })
                                                    @Html.DropDownListFor(m => m.CounterpartyID,
                                                        Enumerable.Empty<SelectListItem>(),
                                                        "Avval kontragent turini tanlang",
                                                        new { @class = "form-control", id = "CounterpartyID" })
                                                    <small class="text-muted">Tanlangan ID saqlanadi (mapping uchun).</small>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row" id="supplierContractRow" style="display: none;">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="control-label" for="contractSelect">Shartnoma (xarid)</label>
                                                    <select id="contractSelect" class="form-control" disabled="disabled">
                                                        <option value="">---Ta'minotchini tanlang---</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.ContractNo, "Shartnoma raqami", new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.ContractNo, new { @class = "form-control", id = "ContractNo" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.CounterpartyName, "Kontragent nomi", new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.CounterpartyName, new { @class = "form-control" })
                                                    <small class="text-muted">Ixtiyoriy</small>
                                                </div>
                                            </div>
                                            <div class="col-md-6"></div>
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Purpose, "Maqsad", new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.Purpose, new { @class = "form-control" })
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="control-label">Manba hujjat turi</label>
                                                    @Html.DropDownList("SourceDocType", ViewBag.SourceDocTypeList as SelectList, new { @class = "form-control" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.SourceDocID, "Manba hujjat ID", new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.SourceDocID, new { @class = "form-control", type = "number", min = "0" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Comment, "Izoh", new { @class = "control-label" })
                                            @Html.TextAreaFor(m => m.Comment, new { @class = "form-control", rows = 3 })
                                        </div>

                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-primary">Saqlash</button>
                                            <a href="@Url.Action("Index")" class="btn btn-secondary">Bekor qilish</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@section scripts
{
    <script type="text/javascript">
        (function () {
            var counterpartiesUrl = '@Html.Raw(Url.Action("GetCounterparties", "FinTransactions"))';
            var contractsBySupplierUrl = '@Html.Raw(Url.Action("GetContractsBySupplier", "FinTransactions"))';
            var savedCounterpartyId = '@(Model.CounterpartyID.HasValue ? Model.CounterpartyID.Value.ToString() : "")';
            var initialContractNo = @Html.Raw(Json.Encode(Model.ContractNo ?? ""));
            var counterpartyLoadSeq = 0;

            function itemId(it) {
                if (!it) return '';
                return it.id != null ? it.id : it.Id;
            }
            function itemName(it) {
                if (!it) return '';
                return it.name != null ? it.name : it.Name;
            }

            function resetSupplierContracts() {
                var $row = $('#supplierContractRow');
                var $cs = $('#contractSelect');
                $row.hide();
                $cs.empty().append($('<option></option>').val('').text('---Tanlang---')).prop('disabled', true);
            }

            function loadContractsForSupplier(supplierId, selectContractNo) {
                resetSupplierContracts();
                if (!supplierId) return;
                $.ajax({
                    url: contractsBySupplierUrl,
                    type: 'GET',
                    data: { supplierId: supplierId },
                    traditional: true
                }).done(function (res) {
                    if (!res || !res.success || !res.data || !res.data.length) {
                        return;
                    }
                    var $cs = $('#contractSelect');
                    $cs.empty().append($('<option></option>').val('').text('---Tanlang---'));
                    $.each(res.data, function (i, c) {
                        var id = c.ID != null ? c.ID : c.id;
                        var no = c.ContractNo != null ? c.ContractNo : c.contractNo;
                        $cs.append($('<option></option>').val(id).text(no));
                    });
                    $cs.prop('disabled', false);
                    $('#supplierContractRow').show();
                    if (selectContractNo) {
                        var found = false;
                        $cs.find('option').each(function () {
                            if ($(this).text() === selectContractNo) {
                                $(this).prop('selected', true);
                                found = true;
                                return false;
                            }
                        });
                        if (found) {
                            $('#ContractNo').val(selectContractNo);
                        }
                    }
                });
            }

            function fillCounterpartyDropdown(restoreCounterpartyId) {
                var type = $('#CounterpartyType').val();
                var $cp = $('#CounterpartyID');
                var seq = ++counterpartyLoadSeq;
                $cp.empty();
                resetSupplierContracts();
                if (!restoreCounterpartyId) {
                    $('#ContractNo').val('');
                }

                if (!type) {
                    $cp.append($('<option></option>').val('').text('Avval kontragent turini tanlang'));
                    return;
                }

                $.ajax({
                    url: counterpartiesUrl,
                    type: 'GET',
                    data: { type: type },
                    traditional: true
                }).done(function (data) {
                    if (seq !== counterpartyLoadSeq) {
                        return;
                    }
                    $cp.empty();
                    $cp.append($('<option></option>').val('').text('Tanlang...'));
                    if (data && data.success && data.items && data.items.length) {
                        $.each(data.items, function (i, it) {
                            var id = itemId(it);
                            var name = itemName(it) || ('#' + id);
                            $cp.append($('<option></option>').val(id).text(name));
                        });
                    }
                    if (restoreCounterpartyId) {
                        $cp.val(restoreCounterpartyId);
                        if (type === '2' && restoreCounterpartyId) {
                            loadContractsForSupplier(restoreCounterpartyId, initialContractNo);
                        } else if (initialContractNo && $('#ContractNo').length) {
                            $('#ContractNo').val(initialContractNo);
                        }
                    }
                }).fail(function () {
                    if (seq !== counterpartyLoadSeq) {
                        return;
                    }
                    $cp.empty();
                    $cp.append($('<option></option>').val('').text('Yuklashda xatolik'));
                });
            }

            function bindCounterpartyUi() {
                var $type = $('#CounterpartyType');
                var $cp = $('#CounterpartyID');

                $type.off('change.finctr').on('change.finctr', function () {
                    fillCounterpartyDropdown(null);
                });

                $cp.off('change.finctr').on('change.finctr', function () {
                    var t = $type.val();
                    var id = $(this).val();
                    if (t === '2' && id) {
                        loadContractsForSupplier(id, null);
                    } else {
                        resetSupplierContracts();
                    }
                });

                $('#contractSelect').off('change.finctr').on('change.finctr', function () {
                    var txt = $('#contractSelect option:selected').text();
                    if (txt && txt.indexOf('---') !== 0) {
                        $('#ContractNo').val(txt);
                    }
                });

                if ($type.val()) {
                    fillCounterpartyDropdown(savedCounterpartyId || null);
                }
            }

            function initPage() {
                if (typeof jQuery === 'undefined') {
                    setTimeout(initPage, 50);
                    return;
                }
                // Select2 ishlatmaymiz: _Layout da ikkinchi jQuery yuklanishi + form-select2.js bilan
                // qayta init "No results found" va bo'sh dropdownlarga olib kelishi mumkin.
                bindCounterpartyUi();
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initPage);
            } else {
                initPage();
            }
        })();
    </script>
}
