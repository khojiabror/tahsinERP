@model tahsinERP.Models.FIN_TRANSACTIONS

@{
    ViewBag.Title = L.T("Fin_DeleteTx");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/FinTransactions">@L.T("Fin_Transactions")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Delete")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title text-danger">@L.T("Fin_DeleteTx")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @if (ViewBag.CannotDelete == true)
                                    {
                                        <div class="alert alert-danger">
                                            <h5>@L.T("Fin_Attention")</h5>
                                            <p>@L.T("Fin_TxAutoCreated1") <strong>@ViewBag.SourceDocType</strong> @L.T("Fin_TxAutoCreated2")</p>
                                            <p>@L.T("Fin_TxAutoCreatedHint")</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning">
                                            <h5>@L.T("Fin_Attention")</h5>
                                            <p>@L.T("Fin_TxDeleteConfirm")</p>
                                        </div>
                                    }
                                    
                                    <dl class="row">
                                        <dt class="col-sm-4">@L.T("Date"):</dt>
                                        <dd class="col-sm-8">@Model.TxnDate.ToString("dd.MM.yyyy")</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_Account"):</dt>
                                        <dd class="col-sm-8">@(Model.FIN_ACCOUNTS?.Name)</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Category"):</dt>
                                        <dd class="col-sm-8">@(Model.FIN_CATEGORIES?.Name)</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Amount"):</dt>
                                        <dd class="col-sm-8"><strong>@Model.Amount.ToString("N2") @(Model.CURRENCy?.Shortname)</strong></dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_Source"):</dt>
                                        <dd class="col-sm-8">@(Model.SourceDocType ?? L.T("Fin_Manual"))</dd>
                                    </dl>
                                    
                                    @if (ViewBag.CannotDelete != true)
                                    {
                                        using (Html.BeginForm("Delete", "FinTransactions", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", Model.ID)
                                            
                                            <div class="form-actions">
                                                <button type="submit" class="btn btn-danger">@L.T("Fin_YesDelete")</button>
                                                <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("Cancel")</a>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="form-actions">
                                            <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("Back")</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
