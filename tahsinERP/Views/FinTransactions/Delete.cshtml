@model tahsinERP.Models.FIN_TRANSACTIONS

@{
    ViewBag.Title = "Tranzaksiyani o'chirish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinTransactions"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/FinTransactions">Tranzaksiyalar</a></li>
                                    <li class="breadcrumb-item active">O'chirish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title text-danger">Tranzaksiyani o'chirish</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @if (ViewBag.CannotDelete == true)
                                    {
                                        <div class="alert alert-danger">
                                            <h5>Diqqat!</h5>
                                            <p>Bu tranzaksiya <strong>@ViewBag.SourceDocType</strong> hujjatidan avtomatik yaratilgan. Uni o'chirish mumkin emas.</p>
                                            <p>O'chirish uchun asosiy hujjatni o'chiring yoki bekor qiling.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning">
                                            <h5>Diqqat!</h5>
                                            <p>Ushbu tranzaksiyani o'chirishni tasdiqlaysizmi?</p>
                                        </div>
                                    }
                                    
                                    <dl class="row">
                                        <dt class="col-sm-4">Sana:</dt>
                                        <dd class="col-sm-8">@Model.TxnDate.ToString("dd.MM.yyyy")</dd>
                                        
                                        <dt class="col-sm-4">Hisob:</dt>
                                        <dd class="col-sm-8">@Model.FIN_ACCOUNTS?.Name</dd>
                                        
                                        <dt class="col-sm-4">Kategoriya:</dt>
                                        <dd class="col-sm-8">@Model.FIN_CATEGORIES?.Name</dd>
                                        
                                        <dt class="col-sm-4">Summa:</dt>
                                        <dd class="col-sm-8"><strong>@Model.Amount.ToString("N2") @Model.CURRENCy?.Shortname</strong></dd>
                                        
                                        <dt class="col-sm-4">Manba:</dt>
                                        <dd class="col-sm-8">@(Model.SourceDocType ?? "Qo'lda")</dd>
                                    </dl>
                                    
                                    @if (ViewBag.CannotDelete != true)
                                    {
                                        using (Html.BeginForm("Delete", "FinTransactions", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", Model.ID)
                                            
                                            <div class="form-actions">
                                                <button type="submit" class="btn btn-danger">Ha, o'chirish</button>
                                                <a href="@Url.Action("Index")" class="btn btn-secondary">Bekor qilish</a>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="form-actions">
                                            <a href="@Url.Action("Index")" class="btn btn-secondary">Orqaga</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
