@model tahsinERP.Models.FIN_TRANSACTIONS

@{
    ViewBag.Title = L.T("Fin_TxDetails");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinTransactions");
}

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/FinTransactions">@L.T("Fin_Transactions")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Fin_Details")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-md-10">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Fin_TxDetails")</h4>
                                @if (changePermit && tahsinERP.Services.Finance.FinSelectLists.IsUserEditable(Model.SourceDocType))
                                {
                                    <div class="heading-elements">
                                        <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-sm btn-primary">@L.T("Edit")</a>
                                        <a href="@Url.Action("Delete", new { id = Model.ID })" class="btn btn-sm btn-danger">@L.T("Delete")</a>
                                    </div>
                                }
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <dl class="row">
                                        <dt class="col-sm-4">@L.T("Date"):</dt>
                                        <dd class="col-sm-8">@Model.TxnDate.ToString("dd.MM.yyyy")</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_Account"):</dt>
                                        <dd class="col-sm-8">@(Model.FIN_ACCOUNTS != null ? $"{Model.FIN_ACCOUNTS.Name} ({Model.FIN_ACCOUNTS.Code})" : "-")</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Category"):</dt>
                                        <dd class="col-sm-8">@(Model.FIN_CATEGORIES != null ? Model.FIN_CATEGORIES.Name : "-")</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_Direction"):</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.Direction == 1)
                                            { <span class="badge badge-success">@L.T("Fin_Inflow")</span> }
                                            else
                                            { <span class="badge badge-danger">@L.T("Fin_Expense")</span> }
                                        </dd>
                                        
                                        <dt class="col-sm-4">@L.T("Amount"):</dt>
                                        <dd class="col-sm-8"><strong>@Model.Amount.ToString("N2") @(Model.CURRENCy != null ? Model.CURRENCy.Shortname : "")</strong></dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_Counterparty"):</dt>
                                        <dd class="col-sm-8">@(Model.CounterpartyName ?? "-")</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_Purpose"):</dt>
                                        <dd class="col-sm-8">@(Model.Purpose ?? "-")</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_SourceDoc"):</dt>
                                        <dd class="col-sm-8">
                                            @if (!string.IsNullOrEmpty(Model.SourceDocType) && Model.SourceDocID.HasValue)
                                            {
                                                <a href="@ViewBag.SourceDocLink" target="_blank">@Model.SourceDocType #@Model.SourceDocID</a>
                                            }
                                            else
                                            { <span>@L.T("Fin_EnteredManually")</span> }
                                        </dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_ContractNo"):</dt>
                                        <dd class="col-sm-8">@(Model.ContractNo ?? "-")</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Comment"):</dt>
                                        <dd class="col-sm-8">@(Model.Comment ?? "-")</dd>
                                        
                                        <dt class="col-sm-4">@L.T("CreatedAt"):</dt>
                                        <dd class="col-sm-8">@Model.CreatedDT.ToString("dd.MM.yyyy HH:mm")</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_CreatedByUser"):</dt>
                                        <dd class="col-sm-8">@(Model.USER != null ? Model.USER.FullName : "-")</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
