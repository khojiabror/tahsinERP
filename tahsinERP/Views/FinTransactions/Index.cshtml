@model List<tahsinERP.Models.FIN_TRANSACTIONS>

@{
    ViewBag.Title = "Moliya tranzaksiyalari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "FinTransactions"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinTransactions");
    
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">Moliya</li>
                                    <li class="breadcrumb-item active">Tranzaksiyalar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <button type="button" class="btn btn-outline-success mr-1 mb-1" onclick="window.location.href='/FinTransactions/Create';">
                                <span class="align-middle ml-25">Tranzaksiya qo'shish</span>
                            </button>
                            <a href="@Url.Action("ExportExcel", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, accountID = ViewBag.AccountID, categoryID = ViewBag.CategoryID })" class="btn btn-outline-info mr-1 mb-1">
                                <span class="align-middle ml-25">Excel ga eksport</span>
                            </a>
                        </div>
                    }
                    
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <form method="get" action="@Url.Action("Index")" class="mb-2">
                                    <div class="row">
                                        <div class="col-md-2">
                                            <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" placeholder="Dan" />
                                        </div>
                                        <div class="col-md-2">
                                            <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" placeholder="Gacha" />
                                        </div>
                                        <div class="col-md-2">
                                            @Html.DropDownList("accountID", ViewBag.AccountList as SelectList, "Barcha hisoblar", new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-2">
                                            @Html.DropDownList("categoryID", ViewBag.CategoryList as SelectList, "Barcha kategoriyalar", new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-2">
                                            @Html.DropDownList("direction", ViewBag.DirectionList as SelectList, new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-2">
                                            <input type="text" name="searchTerm" class="form-control" placeholder="Qidirish..." value="@ViewBag.SearchTerm" />
                                        </div>
                                    </div>
                                    <div class="row mt-1">
                                        <div class="col-md-2">
                                            @Html.DropDownList("counterpartyType", ViewBag.CounterpartyTypeList as SelectList, new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-2">
                                            @Html.DropDownList("sourceDocType", ViewBag.SourceDocTypeList as SelectList, new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-2">
                                            <button type="submit" class="btn btn-primary">Qidirish</button>
                                        </div>
                                    </div>
                                </form>
                                
                                <div class="table-responsive">
                                    <table id="transactionsTable" class="table table-striped table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Sana</th>
                                                <th>Hisob</th>
                                                <th>Kategoriya</th>
                                                <th>Yo'nalish</th>
                                                <th>Summa</th>
                                                <th>Valyuta</th>
                                                <th>Kontragent</th>
                                                <th>Maqsad</th>
                                                <th>Manba</th>
                                                @if (changePermit)
                                                {
                                                    <th>Amallar</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.TxnDate.ToString("dd.MM.yyyy")</td>
                                                    <td>@(item.FIN_ACCOUNTS != null ? item.FIN_ACCOUNTS.Name : "-")</td>
                                                    <td>@(item.FIN_CATEGORIES != null ? item.FIN_CATEGORIES.Name : "-")</td>
                                                    <td>
                                                        @if (item.Direction == 1)
                                                        { <span class="badge badge-success">Kirim</span> }
                                                        else
                                                        { <span class="badge badge-danger">Chiqim</span> }
                                                    </td>
                                                    <td>@item.Amount.ToString("N2")</td>
                                                    <td>@(item.CURRENCy != null ? item.CURRENCy.Shortname : "-")</td>
                                                    <td>@(item.CounterpartyName ?? "-")</td>
                                                    <td>@(item.Purpose ?? "-")</td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(item.SourceDocType) && item.SourceDocID.HasValue)
                                                        {
                                                            <a href="@Url.Action("Details", item.SourceDocType, new { id = item.SourceDocID })">@item.SourceDocType</a>
                                                        }
                                                        else
                                                        { <span>Qo'lda</span> }
                                                    </td>
                                                    @if (changePermit)
                                                    {
                                                        <td>
                                                            <a href="@Url.Action("Details", new { id = item.ID })"><i class="bx bx-show"></i></a>
                                                            @if (string.IsNullOrEmpty(item.SourceDocType) || item.SourceDocType == "Manual")
                                                            {
                                                                <a href="@Url.Action("Edit", new { id = item.ID })"><i class="bx bx-edit-alt"></i></a>
                                                                <a href="@Url.Action("Delete", new { id = item.ID })"><i class="bx bx-trash"></i></a>
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                
                                @if (ViewBag.TotalRecords > ViewBag.PageSize)
                                {
                                    <div class="d-flex justify-content-between mt-2">
                                        <div>Jami: @ViewBag.TotalRecords ta yozuv</div>
                                        <div>
                                            @if (ViewBag.CurrentPage > 1)
                                            {
                                                <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize })" class="btn btn-sm btn-outline-primary">Oldingi</a>
                                            }
                                            <span class="mx-2">Sahifa @ViewBag.CurrentPage</span>
                                            @if (ViewBag.CurrentPage * ViewBag.PageSize < ViewBag.TotalRecords)
                                            {
                                                <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize })" class="btn btn-sm btn-outline-primary">Keyingi</a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
