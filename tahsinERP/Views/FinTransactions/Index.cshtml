@{
    ViewBag.Title = L.T("Fin_FinanceTransactions");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinTransactions");
    var fromDate = (DateTime?)ViewBag.FromDate;
    var toDate = (DateTime?)ViewBag.ToDate;
    // Server tomonidagi filtrlar: DataTables so'rovi va Excel eksporti bir xil filtrdan foydalanadi
    var filter = new
    {
        fromDate = fromDate.HasValue ? fromDate.Value.ToString("yyyy-MM-dd") : null,
        toDate = toDate.HasValue ? toDate.Value.ToString("yyyy-MM-dd") : null,
        accountID = (int?)ViewBag.AccountID,
        categoryID = (int?)ViewBag.CategoryID,
        direction = (byte?)ViewBag.Direction,
        counterpartyType = (byte?)ViewBag.CounterpartyType,
        counterpartyID = (int?)ViewBag.CounterpartyID,
        sourceDocType = (string)ViewBag.SourceDocType,
        searchTerm = (string)ViewBag.SearchTerm
    };
}

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">@Html.Link(L.T("Menu_Finance"), "FinDashboard", "FinancialOverview")</li>
                                    <li class="breadcrumb-item active">@L.T("Fin_Transactions")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <div class="invoice-create-btn mb-1">
                        @if (changePermit)
                        {
                            <a href="@Url.Action("Create")" class="btn btn-success mr-1 mb-1">
                                <i class="bx bx-plus"></i> <span class="align-middle ml-25">@L.T("Fin_AddTx")</span>
                            </a>
                            <a href="@Url.Action("Import")" class="btn btn-warning mr-1 mb-1">
                                <i class="bx bx-upload"></i> <span class="align-middle ml-25">@L.T("Fin_ExcelImport")</span>
                            </a>
                        }
                        <a href="@Url.Action("ExportExcel", filter)" class="btn btn-info mr-1 mb-1">
                            <i class="bx bx-download"></i> <span class="align-middle ml-25">@L.T("ExportExcel")</span>
                        </a>
                    </div>

                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                @if (TempData["Success"] != null)
                                {
                                    <div class="alert alert-success">@TempData["Success"]</div>
                                }
                                @if (TempData["Error"] != null)
                                {
                                    <div class="alert alert-danger">@TempData["Error"]</div>
                                }

                                <form method="get" action="@Url.Action("Index")" class="mb-3" id="filterForm">
                                    @if (filter.counterpartyType.HasValue)
                                    {
                                        <input type="hidden" name="counterpartyType" value="@filter.counterpartyType" />
                                    }
                                    @if (filter.counterpartyID.HasValue)
                                    {
                                        <input type="hidden" name="counterpartyID" value="@filter.counterpartyID" />
                                    }
                                    @if (!string.IsNullOrEmpty(filter.sourceDocType))
                                    {
                                        <input type="hidden" name="sourceDocType" value="@filter.sourceDocType" />
                                    }
                                    @if (!string.IsNullOrEmpty(filter.searchTerm))
                                    {
                                        <input type="hidden" name="searchTerm" value="@filter.searchTerm" />
                                    }
                                    <div class="row">
                                        <div class="col-md-2">
                                            <label class="form-label small">@L.T("Fin_From")</label>
                                            <input type="date" name="fromDate" class="form-control form-control-sm" value="@filter.fromDate" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">@L.T("Fin_To")</label>
                                            <input type="date" name="toDate" class="form-control form-control-sm" value="@filter.toDate" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">@L.T("Fin_Account")</label>
                                            @Html.DropDownList("accountID", ViewBag.AccountList as SelectList, L.T("Fin_AllOption"), new { @class = "form-control form-control-sm" })
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">@L.T("Category")</label>
                                            @Html.DropDownList("categoryID", ViewBag.CategoryList as SelectList, L.T("Fin_AllOption"), new { @class = "form-control form-control-sm" })
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">@L.T("Fin_Direction")</label>
                                            @Html.DropDownList("direction", ViewBag.DirectionList as SelectList, new { @class = "form-control form-control-sm" })
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">&nbsp;</label>
                                            <button type="submit" class="btn btn-primary btn-sm btn-block">
                                                <i class="bx bx-filter"></i> @L.T("Fin_DoFilter")
                                            </button>
                                        </div>
                                    </div>
                                </form>

                                <div class="table-responsive">
                                    <table id="transactionsTable" class="table table-striped table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Date")</th>
                                                <th>@L.T("Fin_Account")</th>
                                                <th>@L.T("Category")</th>
                                                <th>@L.T("Fin_Direction")</th>
                                                <th>@L.T("Amount")</th>
                                                <th>@L.T("Currency")</th>
                                                <th>@L.T("Fin_Counterparty")</th>
                                                <th>@L.T("Fin_Purpose")</th>
                                                <th>@L.T("Actions")</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                var changePermit = @(changePermit ? "true" : "false");
                var filter = @Html.Raw(Json.Encode(filter));
                var detailsUrl = '@Url.Action("Details")';
                var editUrl = '@Url.Action("Edit")';
                var deleteUrl = '@Url.Action("Delete")';

                function esc(value) {
                    return $('<div>').text(value == null ? '' : String(value)).html();
                }

                function renderText(data, type) {
                    return type === 'display' ? esc(data) : data;
                }

                $('#transactionsTable').DataTable({
                    "processing": true,
                    "serverSide": true,
                    "searchDelay": 400,
                    "ajax": {
                        "url": '@Url.Action("IndexData")',
                        "data": function (d) {
                            $.each(filter, function (k, v) {
                                if (v !== null && v !== '') d[k] = v;
                            });
                        }
                    },
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, 1000], [10, 25, 50, 100, 1000]],
                    "order": [[0, "desc"]],
                    "columns": [
                        { "data": "date", "className": "text-center" },
                        { "data": "account", "render": renderText },
                        { "data": "category", "render": renderText },
                        {
                            "data": "direction", "className": "text-center",
                            "render": function (data) {
                                return data === 1
                                    ? '<span class="badge badge-success">@L.Js("Fin_Inflow")</span>'
                                    : '<span class="badge badge-danger">@L.Js("Fin_Expense")</span>';
                            }
                        },
                        { "data": "amount", "className": "text-right", "render": renderText },
                        { "data": "currency", "className": "text-center", "render": renderText },
                        { "data": "counterparty", "className": "text-center", "render": renderText },
                        { "data": "purpose", "className": "text-center", "render": renderText },
                        {
                            "data": null, "orderable": false, "className": "text-center",
                            "render": function (row) {
                                var id = encodeURIComponent(row.id);
                                var html = '<a href="' + detailsUrl + '/' + id + '" class="btn btn-sm btn-outline-info" title="@L.Js("View")"><i class="bx bx-show"></i></a> ';
                                if (changePermit && row.editable) {
                                    html += '<a href="' + editUrl + '/' + id + '" class="btn btn-sm btn-outline-primary" title="@L.Js("Edit")"><i class="bx bx-edit"></i></a> ';
                                    html += '<a href="' + deleteUrl + '/' + id + '" class="btn btn-sm btn-outline-danger" title="@L.Js("Delete")"><i class="bx bx-trash"></i></a>';
                                }
                                return html;
                            }
                        }
                    ],
                    "dom": '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                    "pagingType": "full_numbers",
                    "scrollX": true
                });
            });
        </script>
        <style>
            #transactionsTable_wrapper .dataTables_filter input {
                margin-left: 5px;
                padding: 5px;
                border: 1px solid #ddd;
                border-radius: 4px;
            }

            #transactionsTable_wrapper .dataTables_length select {
                margin: 0 5px;
                padding: 5px;
                border: 1px solid #ddd;
                border-radius: 4px;
            }
        </style>
    }
