@model List<tahsinERP.Models.FIN_TRANSACTIONS>

@{
    ViewBag.Title = "Moliya tranzaksiyalari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "FinTransactions"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinTransactions");
    
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">Moliya</li>
                                    <li class="breadcrumb-item active">Tranzaksiyalar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create")" class="btn btn-success mr-1 mb-1">
                                <i class="bx bx-plus"></i> <span class="align-middle ml-25">Tranzaksiya qo'shish</span>
                            </a>
                            <a href="@Url.Action("Import")" class="btn btn-warning mr-1 mb-1">
                                <i class="bx bx-upload"></i> <span class="align-middle ml-25">Excel dan import</span>
                            </a>
                            <a href="@Url.Action("ExportExcel", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, accountID = ViewBag.AccountID, categoryID = ViewBag.CategoryID })" class="btn btn-info mr-1 mb-1">
                                <i class="bx bx-download"></i> <span class="align-middle ml-25">Excel ga eksport</span>
                            </a>
                        </div>
                    }
                    
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <form method="get" action="@Url.Action("Index")" class="mb-3" id="filterForm">
                                    <div class="row">
                                        <div class="col-md-2">
                                            <label class="form-label small">Dan</label>
                                            <input type="date" name="fromDate" class="form-control form-control-sm" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">Gacha</label>
                                            <input type="date" name="toDate" class="form-control form-control-sm" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">Hisob</label>
                                            @Html.DropDownList("accountID", ViewBag.AccountList as SelectList, "Barcha", new { @class = "form-control form-control-sm" })
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">Kategoriya</label>
                                            @Html.DropDownList("categoryID", ViewBag.CategoryList as SelectList, "Barcha", new { @class = "form-control form-control-sm" })
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">Yo'nalish</label>
                                            @Html.DropDownList("direction", ViewBag.DirectionList as SelectList, new { @class = "form-control form-control-sm" })
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">&nbsp;</label>
                                            <button type="submit" class="btn btn-primary btn-sm btn-block">
                                                <i class="bx bx-filter"></i> Filtrlash
                                            </button>
                                        </div>
                                    </div>
                                </form>
                                
                                <div class="table-responsive">
                                    <table id="transactionsTable" class="table table-striped table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Sana</th>
                                                <th>Vaqt</th>
                                                <th>Hisob</th>
                                                <th>Kategoriya</th>
                                                <th>Yo'nalish</th>
                                                <th>Summa</th>
                                                <th>Valyuta</th>
                                                <th>Kontragent</th>
                                                <th>Maqsad</th>
                                                <th>Manba</th>
                                                @if (changePermit)
                                                {
                                                    <th>Amallar</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td data-order="@item.TxnDate.ToString("yyyy-MM-dd")" class="text-center">@item.TxnDate.ToString("dd.MM.yyyy")</td>
                                                    <td data-order="@item.TxnDate.ToString("HH:mm:ss")" class="text-center">@item.TxnDate.ToString("HH:mm")</td>
                                                    <td>@(item.FIN_ACCOUNTS != null ? item.FIN_ACCOUNTS.Name : "-")</td>
                                                    <td>@(item.FIN_CATEGORIES != null ? item.FIN_CATEGORIES.Name : "-")</td>
                                                    <td>
                                                        @if (item.Direction == 1)
                                                        { <span class="badge badge-success">Kirim</span> }
                                                        else
                                                        { <span class="badge badge-danger">Chiqim</span> }
                                                    </td>
                                                    <td class="text-right">@item.Amount.ToString("N2")</td>
                                                    <td class="text-center">@(item.CURRENCy != null ? item.CURRENCy.Shortname : "-")</td>
                                                    <td>@(item.CounterpartyName ?? "-")</td>
                                                    <td>@(item.Purpose ?? "-")</td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(item.SourceDocType) && item.SourceDocID.HasValue)
                                                        {
                                                            <a href="@Url.Action("Details", item.SourceDocType, new { id = item.SourceDocID })">@item.SourceDocType</a>
                                                        }
                                                        else
                                                        { <span>Qo'lda</span> }
                                                    </td>
                                                    @if (changePermit)
                                                    {
                                                        <td class="text-center">
                                                            <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-outline-info" title="Ko'rish">
                                                                <i class="bx bx-show"></i>
                                                            </a>
                                                            @if (string.IsNullOrEmpty(item.SourceDocType) || item.SourceDocType == "Manual")
                                                            {
                                                                <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-outline-primary" title="Tahrirlash">
                                                                    <i class="bx bx-edit"></i>
                                                                </a>
                                                                <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-outline-danger" title="O'chirish">
                                                                    <i class="bx bx-trash"></i>
                                                                </a>
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                // Define changePermit in JavaScript
                var changePermit = @(changePermit ? "true" : "false");
                
                // Destroy existing DataTable if it exists
                if ($.fn.DataTable.isDataTable('#transactionsTable')) {
                    $('#transactionsTable').DataTable().destroy();
                }
                
                var table = $('#transactionsTable').DataTable({
                    "language": {
                        "search": "Qidirish:",
                        "lengthMenu": "_MENU_ ta ko'rsatish",
                        "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                        "infoEmpty": "Yozuvlar yo'q",
                        "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                        "paginate": {
                            "first": "Birinchi",
                            "last": "Oxirgi",
                            "next": "Keyingi",
                            "previous": "Oldingi"
                        },
                        "zeroRecords": "Ma'lumot topilmadi"
                    },
                    "paging": true, // Pagination'ni faollashtirish
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]], // Remove -1 to keep pagination always active
                    "order": [[0, "desc"], [1, "desc"]], // Default: Sana va Vaqt bo'yicha teskari tartib
                    "columnDefs": [
                        { "className": "text-center", "targets": [0, 1, 2, 3, 4, 6, 7, 8, 9] }, // Center all except amount
                        { "className": "text-right", "targets": 5 }, // Right align amount
                        { "type": "date", "targets": 0 }, // Sana ustuni date type
                        { "type": "date", "targets": 1 }, // Vaqt ustuni date type
                        @if (changePermit)
                        {
                            <text>
                            { "orderable": false, "targets": -1, "className": "text-center" } // Amallar ustuni sorting'siz
                            </text>
                        }
                    ],
                    "dom": 'lBfrtip', // l=length, B=buttons, f=filter, r=processing, t=table, i=info, p=pagination
                    "pagingType": "full_numbers", // Page raqamlarini ko'rsatish (1, 2, 3...)
                    "processing": true,
                    "serverSide": false, // Client-side processing - all data loaded
                    "deferRender": true, // Performance optimization for large datasets
                    "scrollX": true, // Horizontal scroll for wide tables
                    "buttons": [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bx bxs-file-excel"></i> Excel',
                            titleAttr: 'Excelga yuklash',
                            className: 'btn btn-success mr-1',
                            filename: function () {
                                var now = new Date();
                                var dateStr = now.getFullYear() + 
                                    String(now.getMonth() + 1).padStart(2, '0') + 
                                    String(now.getDate()).padStart(2, '0') + '_' +
                                    String(now.getHours()).padStart(2, '0') + 
                                    String(now.getMinutes()).padStart(2, '0') + 
                                    String(now.getSeconds()).padStart(2, '0');
                                return 'FinTransactions_' + dateStr;
                            },
                            exportOptions: {
                                columns: changePermit ? ':not(:last-child)' : ':visible',
                                format: {
                                    body: function (data, row, column, node) {
                                        return data.replace(/<[^>]*>/g, '').trim();
                                    }
                                }
                            }
                        }
                    ]
                });
                
                // Force pagination to be visible on initial load
                setTimeout(function() {
                    var wrapper = $('#transactionsTable_wrapper');
                    if (wrapper.find('.dataTables_paginate').length > 0) {
                        wrapper.find('.dataTables_paginate').show().css('display', 'block');
                    }
                    if (wrapper.find('.dataTables_length').length > 0) {
                        wrapper.find('.dataTables_length').show().css('display', 'block');
                    }
                }, 200);
            });
        </script>
        <style>
            /* Ensure DataTable pagination is visible */
            #transactionsTable_wrapper .dataTables_paginate {
                display: block !important;
                visibility: visible !important;
            }
            #transactionsTable_wrapper .dataTables_length {
                display: block !important;
                visibility: visible !important;
            }
            #transactionsTable_wrapper .dataTables_info {
                display: block !important;
                visibility: visible !important;
            }
        </style>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
