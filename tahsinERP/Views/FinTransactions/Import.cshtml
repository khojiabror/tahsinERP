@{
    ViewBag.Title = "Tranzaksiyalarni Excel dan import qilish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">Moliya</li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Tranzaksiyalar</a></li>
                                    <li class="breadcrumb-item active">Excel dan import</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Tranzaksiyalarni Excel dan import qilish</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @if (ViewBag.Success != null)
                                    {
                                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                                            <strong>Muvaffaqiyat!</strong> @ViewBag.Success
                                            <button type="button" class="close" data-dismiss="alert">
                                                <span>&times;</span>
                                            </button>
                                        </div>
                                    }

                                    @if (ViewBag.Warning != null)
                                    {
                                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                            <strong>Ogohlantirish!</strong> @ViewBag.Warning
                                            <button type="button" class="close" data-dismiss="alert">
                                                <span>&times;</span>
                                            </button>
                                        </div>
                                    }

                                    @if (ViewBag.Error != null)
                                    {
                                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                            <strong>Xatolik!</strong> 
                                            <div style="white-space: pre-wrap; word-wrap: break-word; max-height: 300px; overflow-y: auto;">@ViewBag.Error</div>
                                            <button type="button" class="close" data-dismiss="alert">
                                                <span>&times;</span>
                                            </button>
                                        </div>
                                    }

                                    @if (ViewBag.Errors != null)
                                    {
                                        <div class="alert alert-info">
                                            <h5>Xatoliklar ro'yxati:</h5>
                                            <ul class="mb-0" style="max-height: 300px; overflow-y: auto;">
                                                @foreach (var error in (List<string>)ViewBag.Errors)
                                                {
                                                    <li style="word-wrap: break-word;">@error</li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="alert alert-info">
                                                <h5>Ko'rsatmalar:</h5>
                                                <ol>
                                                    <li>Avval shablon faylni yuklab oling</li>
                                                    <li>Shablon faylni to'ldiring (birinchi qator - misol, uni o'chirib tashlang)</li>
                                                    <li>To'ldirilgan faylni yuklang</li>
                                                </ol>
                                                <p class="mb-0"><strong>Eslatma:</strong> Hisob kodi, Kategoriya nomi va Valyuta qisqa nomi bazada mavjud bo'lishi kerak. Shablon faylda "Hisoblar", "Kategoriyalar" va "Valyutalar" varaqlarida mavjud qiymatlar ko'rsatilgan.</p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <a href="@Url.Action("DownloadTemplate")" class="btn btn-success btn-lg btn-block">
                                                <i class="bx bx-download"></i> Shablon faylni yuklab olish
                                            </a>
                                        </div>
                                        <div class="col-md-6">
                                            <form method="post" action="@Url.Action("Import")" enctype="multipart/form-data">
                                                @Html.AntiForgeryToken()
                                                <div class="form-group">
                                                    <label>Excel faylni tanlang (.xlsx):</label>
                                                    <input type="file" name="file" class="form-control" accept=".xlsx" required />
                                                </div>
                                                <button type="submit" class="btn btn-primary btn-lg btn-block">
                                                    <i class="bx bx-upload"></i> Faylni yuklash va import qilish
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-md-12">
                                            <h5>Shablon fayl ustunlari:</h5>
                                            <table class="table table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th>Ustun</th>
                                                        <th>Tavsif</th>
                                                        <th>Majburiy</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td>Sana (DD.MM.YYYY)</td>
                                                        <td>Tranzaksiya sanasi</td>
                                                        <td><span class="badge badge-danger">Ha</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>Vaqt (HH:mm)</td>
                                                        <td>Tranzaksiya vaqti</td>
                                                        <td><span class="badge badge-success">Yo'q</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>Hisob kodi</td>
                                                        <td>Hisob raqami (masalan: 9000)</td>
                                                        <td><span class="badge badge-danger">Ha</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>Kategoriya nomi</td>
                                                        <td>Kategoriya nomi (masalan: Sotuv)</td>
                                                        <td><span class="badge badge-danger">Ha</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>Yo'nalish</td>
                                                        <td>1 = Kirim, 2 = Chiqim</td>
                                                        <td><span class="badge badge-danger">Ha</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>Summa</td>
                                                        <td>Tranzaksiya summasi</td>
                                                        <td><span class="badge badge-danger">Ha</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>Valyuta qisqa nomi</td>
                                                        <td>Valyuta qisqa nomi (masalan: @(ViewBag.CurrencyShortname ?? "UZS"))</td>
                                                        <td><span class="badge badge-danger">Ha</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>Kontragent nomi</td>
                                                        <td>Kontragent nomi</td>
                                                        <td><span class="badge badge-success">Yo'q</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>Maqsad</td>
                                                        <td>Tranzaksiya maqsadi</td>
                                                        <td><span class="badge badge-success">Yo'q</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>Shartnoma raqami</td>
                                                        <td>Shartnoma raqami</td>
                                                        <td><span class="badge badge-success">Yo'q</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>Izoh</td>
                                                        <td>Qo'shimcha izoh</td>
                                                        <td><span class="badge badge-success">Yo'q</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>Miqdor</td>
                                                        <td>Miqdor (ixtiyoriy)</td>
                                                        <td><span class="badge badge-success">Yo'q</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>Narx birligi</td>
                                                        <td>Narx birligi (ixtiyoriy)</td>
                                                        <td><span class="badge badge-success">Yo'q</span></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
