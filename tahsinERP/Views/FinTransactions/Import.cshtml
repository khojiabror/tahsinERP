@{
    ViewBag.Title = L.T("Fin_TxImportTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">@Html.Link(L.T("Menu_Finance"), "FinDashboard", "FinancialOverview")</li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Fin_Transactions")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Fin_ExcelImport")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Fin_TxImportTitle")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @if (ViewBag.Success != null)
                                    {
                                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                                            <strong>@L.T("Fin_SuccessExcl")</strong> @ViewBag.Success
                                            <button type="button" class="close" data-dismiss="alert">
                                                <span>&times;</span>
                                            </button>
                                        </div>
                                    }

                                    @if (ViewBag.Warning != null)
                                    {
                                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                            <strong>@L.T("Fin_WarningExcl")</strong> @ViewBag.Warning
                                            <button type="button" class="close" data-dismiss="alert">
                                                <span>&times;</span>
                                            </button>
                                        </div>
                                    }

                                    @if (ViewBag.Error != null)
                                    {
                                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                            <strong>@L.T("Fin_ErrorExcl")</strong> 
                                            <div style="white-space: pre-wrap; word-wrap: break-word; max-height: 300px; overflow-y: auto;">@ViewBag.Error</div>
                                            <button type="button" class="close" data-dismiss="alert">
                                                <span>&times;</span>
                                            </button>
                                        </div>
                                    }

                                    @if (ViewBag.Errors != null)
                                    {
                                        <div class="alert alert-info">
                                            <h5>@L.T("Fin_ErrorList"):</h5>
                                            <ul class="mb-0" style="max-height: 300px; overflow-y: auto;">
                                                @foreach (var error in (List<string>)ViewBag.Errors)
                                                {
                                                    <li style="word-wrap: break-word;">@error</li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="alert alert-info">
                                                <h5>@L.T("Fin_Instructions"):</h5>
                                                <ol>
                                                    <li>@L.T("Fin_ImportStep1")</li>
                                                    <li>@L.T("Fin_ImportStep2")</li>
                                                    <li>@L.T("Fin_ImportStep3")</li>
                                                </ol>
                                                <p class="mb-0"><strong>@L.T("Note"):</strong> @L.T("Fin_ImportNote")</p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <a href="@Url.Action("DownloadTemplate")" class="btn btn-success btn-lg btn-block">
                                                <i class="bx bx-download"></i> @L.T("Fin_DownloadTemplate")
                                            </a>
                                        </div>
                                        <div class="col-md-6">
                                            <form method="post" action="@Url.Action("Import")" enctype="multipart/form-data">
                                                @Html.AntiForgeryToken()
                                                <div class="form-group">
                                                    <label>@L.T("Fin_SelectExcelFile"):</label>
                                                    <input type="file" name="file" class="form-control" accept=".xlsx" required />
                                                </div>
                                                <button type="submit" class="btn btn-primary btn-lg btn-block">
                                                    <i class="bx bx-upload"></i> @L.T("Fin_UploadAndImport")
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-md-12">
                                            <h5>@L.T("Fin_TemplateColumns"):</h5>
                                            <table class="table table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th>@L.T("Fin_Column")</th>
                                                        <th>@L.T("Description")</th>
                                                        <th>@L.T("Fin_Mandatory")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td>@L.T("Fin_ColDate")</td>
                                                        <td>@L.T("Fin_TxDate")</td>
                                                        <td><span class="badge badge-danger">@L.T("Yes")</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>@L.T("Fin_ColTime")</td>
                                                        <td>@L.T("Fin_TxTime")</td>
                                                        <td><span class="badge badge-success">@L.T("No")</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>@L.T("Fin_AccountCode")</td>
                                                        <td>@L.T("Fin_AccountCodeHint")</td>
                                                        <td><span class="badge badge-danger">@L.T("Yes")</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>@L.T("Fin_CategoryName")</td>
                                                        <td>@L.T("Fin_CategoryNameHint")</td>
                                                        <td><span class="badge badge-danger">@L.T("Yes")</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>@L.T("Fin_Direction")</td>
                                                        <td>1 = @L.T("Fin_Inflow"), 2 = @L.T("Fin_Expense")</td>
                                                        <td><span class="badge badge-danger">@L.T("Yes")</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>@L.T("Amount")</td>
                                                        <td>@L.T("Fin_TxAmount")</td>
                                                        <td><span class="badge badge-danger">@L.T("Yes")</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>@L.T("Fin_CurrencyShortName")</td>
                                                        <td>@L.T("Fin_CurrencyShortNameHint", (string)(ViewBag.CurrencyShortname ?? "UZS"))</td>
                                                        <td><span class="badge badge-danger">@L.T("Yes")</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>@L.T("Fin_CounterpartyName")</td>
                                                        <td>@L.T("Fin_CounterpartyName")</td>
                                                        <td><span class="badge badge-success">@L.T("No")</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>@L.T("Fin_Purpose")</td>
                                                        <td>@L.T("Fin_TxPurpose")</td>
                                                        <td><span class="badge badge-success">@L.T("No")</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>@L.T("Fin_ContractNo")</td>
                                                        <td>@L.T("Fin_ContractNo")</td>
                                                        <td><span class="badge badge-success">@L.T("No")</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>@L.T("Comment")</td>
                                                        <td>@L.T("Fin_AdditionalComment")</td>
                                                        <td><span class="badge badge-success">@L.T("No")</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>@L.T("Quantity")</td>
                                                        <td>@L.T("Quantity") (@L.T("Optional"))</td>
                                                        <td><span class="badge badge-success">@L.T("No")</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td>@L.T("Fin_UnitPrice")</td>
                                                        <td>@L.T("Fin_UnitPrice") (@L.T("Optional"))</td>
                                                        <td><span class="badge badge-success">@L.T("No")</span></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
