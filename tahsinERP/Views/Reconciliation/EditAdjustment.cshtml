@model tahsinERP.ViewModels.ReconciliationAdjustmentEditViewModel
@using tahsinERP.Models
@{
    ViewBag.Title = "Akt-sverki tuzatishi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var typeLabel = Model.ReconciliationType == "Supplier" ? "Ta'minotchi" : Model.ReconciliationType == "Customer" ? "Xaridor" : "Yuk tashuvchi";
    var backUrl = Model.ReconciliationType == "Supplier" ? Url.Action("Supplier", "Reconciliation", new { id = Model.CounterpartyId, contractId = Model.ContractId }) : Model.ReconciliationType == "Customer" ? Url.Action("Customer", "Reconciliation", new { id = Model.CounterpartyId, contractId = Model.ContractId }) : Url.Action("Forwarder", "Reconciliation", new { id = Model.CounterpartyId, contractId = Model.ContractId });
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <ol class="breadcrumb rounded-pill breadcrumb-divider">
                            <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                            <li class="breadcrumb-item"><a href="@backUrl">Akt-sverki</a></li>
                            <li class="breadcrumb-item active">Tuzatish</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-body">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title mb-0">Akt-sverki tuzatishi (@typeLabel)</h4>
                    <a href="@backUrl" class="btn btn-sm btn-secondary"><i class="bx bx-arrow-back"></i> Akt-sverkiga</a>
                </div>
                <div class="card-content">
                    <div class="card-body">
                        <div class="alert alert-info" role="alert">
                            <strong>Qoida:</strong> Har bir <strong>shartnoma</strong> bo'yicha <strong>joriy yilda (@Model.EntryYear)</strong> faqat <strong>bitta</strong> tuzatish yozuvi saqlanadi (shu yil uchun qayta tahrirlash mumkin).
                            Invoys va to'lovlardan keyingi farqni to'g'rilash uchun debet/kredit kiriting; keyingi yilda yangi yozuv ochiladi.
                        </div>

                        @if (Model.AdjustmentAlreadyExistsForYear)
                        {
                            <p class="text-muted small">Ushbu yil uchun yozuv mavjud — saqlash uni yangilaydi.</p>
                        }

                        <p><strong>Kontragent:</strong> @Model.CounterpartyName</p>
                        <p><strong>Shartnoma:</strong> @(string.IsNullOrEmpty(Model.ContractNo) ? ("№" + Model.ContractId) : ("№ " + Model.ContractNo))</p>

                        @using (Html.BeginForm("EditAdjustment", "Reconciliation", FormMethod.Post, new { @class = "mt-3" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.ReconciliationType)
                            @Html.HiddenFor(m => m.CounterpartyId)
                            @Html.HiddenFor(m => m.ContractId)
                            @Html.HiddenFor(m => m.EntryYear)

                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="form-group">
                                @Html.LabelFor(m => m.CutoffDate)
                                @Html.TextBoxFor(m => m.CutoffDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(m => m.CutoffDate, "", new { @class = "text-danger" })
                                <small class="form-text text-muted">Akt-sverki qoldiq sanasidan oldin yoki unga tushadigan tuzatish sana chegarasi.</small>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    @Html.LabelFor(m => m.Party1Debit)
                                    @Html.TextBoxFor(m => m.Party1Debit, new { @class = "form-control", type = "number", step = "0.01", min = "0" })
                                    @Html.ValidationMessageFor(m => m.Party1Debit, "", new { @class = "text-danger" })
                                </div>
                                <div class="form-group col-md-6">
                                    @Html.LabelFor(m => m.Party1Credit)
                                    @Html.TextBoxFor(m => m.Party1Credit, new { @class = "form-control", type = "number", step = "0.01", min = "0" })
                                    @Html.ValidationMessageFor(m => m.Party1Credit, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.Note)
                                @Html.TextAreaFor(m => m.Note, new { @class = "form-control", rows = 3, maxlength = 500 })
                            </div>

                            <button type="submit" class="btn btn-primary">Saqlash</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
