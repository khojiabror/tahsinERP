@model tahsinERP.ViewModels.ReconciliationViewModel
@using tahsinERP.Models
@{
    ViewBag.Title = L.T("Crm_RecAktSverki");
    Func<object, string> B = v => "<strong>" + Html.Encode(v) + "</strong>";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listUrl = Model.ReconciliationType == "Supplier" ? Url.Action("Index", "Supplier") : Model.ReconciliationType == "Customer" ? Url.Action("Index", "Customer") : Url.Action("Index", "Forwarder");
    var detailUrl = Model.ReconciliationType == "Supplier" ? Url.Action("Details", "Supplier", new { id = Model.CounterpartyId }) : Model.ReconciliationType == "Customer" ? Url.Action("Details", "Customer", new { Id = Model.CounterpartyId }) : Url.Action("Details", "Forwarder", new { id = Model.CounterpartyId });
    var contracts = Model.ContractsForParty ?? new List<tahsinERP.ViewModels.ReconciliationContractOption>();
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                <li class="breadcrumb-item"><a href="@listUrl">@(Model.ReconciliationType == "Supplier" ? L.T("Menu_Suppliers") : Model.ReconciliationType == "Customer" ? L.T("Menu_Customers") : L.T("Crm_RecForwarders"))</a></li>
                                <li class="breadcrumb-item"><a href="@detailUrl">@Model.Party2Name</a></li>
                                @if (Model.HasSelectedContract && !string.IsNullOrEmpty(Model.ContractNo))
                                {
                                    <li class="breadcrumb-item active">@L.T("Crm_RecAktSverki") — @Model.ContractNo</li>
                                }
                                else
                                {
                                    <li class="breadcrumb-item active">@L.T("Crm_RecAktSverki")</li>
                                }
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-body">
                @Html.Partial("~/Views/FinDashboard/_CurrencyWarning.cshtml")
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                    <h4 class="card-title mb-0">@L.T("Crm_RecAktSverki") @(Model.AllContracts ? L.T("Crm_RecAllContractsParen") : L.T("Crm_RecByContractParen"))</h4>
                    <div>
                        @if (User.Identity.IsAuthenticated && Model.HasSelectedContract && !Model.AllContracts && RoleHelper.IsChangePermitted(User.Identity.Name, Model.ReconciliationType == "Supplier" ? "Supplier" : Model.ReconciliationType == "Customer" ? "Customer" : "Forwarder"))
                        {
                            <a href="@Url.Action("EditAdjustment", "Reconciliation", new { type = Model.ReconciliationType, id = Model.CounterpartyId, contractId = Model.ContractId })" class="btn btn-sm btn-outline-warning mr-1"><i class="bx bx-edit-alt"></i> @L.T("Crm_RecAdjust")</a>
                        }
                        <a href="@detailUrl" class="btn btn-sm btn-secondary"><i class="bx bx-arrow-back"></i> @L.T("Back")</a>
                    </div>
                </div>
                <div class="card-content">
                    <div class="card-body">
                        <form method="get" action="@Url.Action(Model.ReconciliationType, "Reconciliation")" class="mb-4" id="aktSverkiFilterForm">
                            <input type="hidden" name="id" value="@Model.CounterpartyId" />
                            <div class="row">
                                <div class="col-md-4">
                                    <label>@L.T("Crm_Contract") <span class="text-danger">*</span></label>
                                    <select name="contractId" class="form-control" required onchange="document.getElementById('aktSverkiFilterForm').submit();">
                                        <option value="">@L.T("SelectPlaceholder")</option>
                                        <option value="@tahsinERP.ViewModels.ReconciliationContractOption.AllContractsId" @(Model.AllContracts ? "selected" : "")>— @L.T("Crm_RecAllContracts") —</option>
                                        @foreach (var c in contracts)
                                        {
                                            <option value="@c.Id" @(Model.ContractId == c.Id ? "selected" : "")>@c.ContractNo</option>
                                        }
                                    </select>
                                    @if (!contracts.Any())
                                    {
                                        <small class="text-danger">@L.T("Crm_RecNoActiveContracts")</small>
                                    }
                                </div>
                                <div class="col-md-4">
                                    <label>@L.T("Crm_RecBalanceDate")</label>
                                    <input type="date" name="asOfDate" class="form-control" value="@Model.AsOfDate.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-4">
                                    <label>&nbsp;</label>
                                    <button type="submit" class="btn btn-primary btn-block">@L.T("Refresh")</button>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-12 d-flex justify-content-md-end">
                                    <div id="aktSverkiExportButtons" class="text-md-right"></div>
                                </div>
                            </div>
                        </form>

                        @if (!Model.HasSelectedContract)
                        {
                            <div class="alert alert-warning">@Html.Raw(L.T("Crm_RecSelectContractHint"))</div>
                        }
                        @if (!string.IsNullOrEmpty(Model.UnattributedNote))
                        {
                            <div class="alert alert-info">@Model.UnattributedNote</div>
                        }

                        <div class="text-center mb-4">
                            <h5 class="text-primary">@L.T("Crm_RecTitleCaps")</h5>
                            <p class="mb-1">@L.T("Crm_RecSettlementDate") <strong>@Model.AsOfDate.ToString("dd.MM.yyyy")</strong></p>
                            <p class="mb-1">@L.T("Crm_RecDocDate") <strong>@Model.ReportDate</strong></p>
                            @if (Model.HasSelectedContract)
                            {
                                <p class="mb-1 text-muted">@Model.AgreementInfo</p>
                            }
                        </div>

                        @if (Model.HasSelectedContract)
                        {
                            <p class="mb-2">
                                @Html.Raw(L.T("Crm_RecIntro", B(Model.Party1Name), B(Model.Party2Name), B("№ " + Model.ContractNo), Html.Encode(Model.AsOfDate.ToString("dd.MM.yyyy"))))
                            </p>
                        }

                        <div class="table-responsive">
                            <table id="aktSverkiTable" class="table table-bordered table-sm" style="width:100%">
                                <thead>
                                    <tr class="table-primary">
                                        <th rowspan="2" style="vertical-align:middle">@L.T("Crm_RecContent")</th>
                                        <th colspan="2" class="text-center">@Model.Party1Name</th>
                                        <th colspan="2" class="text-center">@Model.Party2Name</th>
                                    </tr>
                                    <tr class="table-primary">
                                        <th class="text-center">@L.T("Crm_RecDebit")</th>
                                        <th class="text-center">@L.T("Crm_RecCredit")</th>
                                        <th class="text-center">@L.T("Crm_RecDebit")</th>
                                        <th class="text-center">@L.T("Crm_RecCredit")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.HasSelectedContract && Model.Rows != null)
                                    {
                                        foreach (var row in Model.Rows)
                                        {
                                            <tr class="@(row.IsBalanceRow ? "table-warning font-weight-bold" : row.IsAdjustmentRow ? "table-info" : "")">
                                                <td>@row.Content</td>
                                                <td class="text-right">@(row.Party1Debit > 0 ? row.Party1Debit.ToString("N2") : "")</td>
                                                <td class="text-right">@(row.Party1Credit > 0 ? row.Party1Credit.ToString("N2") : "")</td>
                                                <td class="text-right">@(row.Party2Debit > 0 ? row.Party2Debit.ToString("N2") : "")</td>
                                                <td class="text-right">@(row.Party2Credit > 0 ? row.Party2Credit.ToString("N2") : "")</td>
                                            </tr>
                                        }
                                    }
                                    @if (!Model.HasSelectedContract || Model.Rows == null || Model.Rows.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center">@(Model.HasSelectedContract ? L.T("Crm_RepNoData") : L.T("Crm_RecSelectContract"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (Model.HasSelectedContract)
                        {
                            <div class="mt-3">
                                @* Mijoz: ijobiy qoldiq — mijoz qarzdor. Ta'minotchi / yuk tashuvchi: ijobiy — korxona qarzdor, kontragent haqdor (mijoz bilan teskarisi). *@
                                @if (Model.ReconciliationType == "Customer")
                                {
                                    if (Model.FinalBalance > 0)
                                    {
                                        <p><strong>@L.T("Crm_RecFinalBalanceLabel")</strong> @L.T("Crm_RecFinalDebtor", Model.Party2Name, Model.FinalBalance.ToString("N2"))</p>
                                    }
                                    else if (Model.FinalBalance < 0)
                                    {
                                        <p><strong>@L.T("Crm_RecFinalBalanceLabel")</strong> @L.T("Crm_RecFinalDebtor", Model.Party1Name, Math.Abs(Model.FinalBalance).ToString("N2"))</p>
                                    }
                                    else
                                    {
                                        <p><strong>@L.T("Crm_RecFinalBalanceLabel")</strong> @L.T("Crm_RecSettled")</p>
                                    }
                                }
                                else
                                {
                                    @* Supplier yoki Forwarder *@
                                    if (Model.FinalBalance > 0)
                                    {
                                        <p><strong>@L.T("Crm_RecFinalBalanceLabel")</strong> @Html.Raw(L.T("Crm_RecFinalWeOwe", Html.Encode(Model.Party1Name), Html.Encode(Model.Party2Name), Html.Encode(Model.FinalBalance.ToString("N2"))))</p>
                                    }
                                    else if (Model.FinalBalance < 0)
                                    {
                                        <p><strong>@L.T("Crm_RecFinalBalanceLabel")</strong> @Html.Raw(L.T("Crm_RecFinalTheyOwe", Html.Encode(Model.Party2Name), Html.Encode(Model.Party1Name), Html.Encode(Math.Abs(Model.FinalBalance).ToString("N2"))))</p>
                                    }
                                    else
                                    {
                                        <p><strong>@L.T("Crm_RecFinalBalanceLabel")</strong> @L.T("Crm_RecSettled")</p>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @if (Model.HasSelectedContract && Model.Rows != null && Model.Rows.Count > 0)
    {
        <script>
            $(document).ready(function () {
                var partyName = @Html.Raw(Json.Encode(Model.Party2Name ?? L.T("Crm_RecFileName")));
                var cn = @Html.Raw(Json.Encode(Model.ContractNo ?? ""));
                var baseName = '@L.Js("Crm_RecFileName")_' + partyName.replace(/[^a-zA-Z0-9-_]/g, '_') + '_' + cn.replace(/[^a-zA-Z0-9-_]/g, '_');
                $('#aktSverkiTable').DataTable({
                    "pageLength": 50,
                    "order": [],
                    dom: 'lBfrtip',
                    buttons: erpDataTable.buttons({
                        fileName: baseName,
                        landscape: true,
                        small: true,
                        pdfOptions: {
                            title: null,
                            customize: function (doc) {
                                var asOf = '@Model.AsOfDate.ToString("dd.MM.yyyy")';
                                var reportDate = '@Model.ReportDate';
                                var party1 = @Html.Raw(Json.Encode(Model.Party1Name ?? ""));
                                var party2 = @Html.Raw(Json.Encode(Model.Party2Name ?? ""));
                                var contractNo = @Html.Raw(Json.Encode(Model.ContractNo ?? ""));
                                var agreement = @Html.Raw(Json.Encode(Model.AgreementInfo ?? ""));
                                var reconciliationType = '@Model.ReconciliationType';
                                var finalBalance = @Model.FinalBalance.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                var finalAbsText = '@Math.Abs(Model.FinalBalance).ToString("N2")';
                                var finalStatement = '';
                                var fmt = function (s, args) { return s.replace(/\{(\d+)\}/g, function (m, i) { return args[+i]; }); };
                                var finalLabel = '@L.Js("Crm_RecFinalBalanceLabel")' + ' ';

                                if (reconciliationType === 'Customer') {
                                    if (finalBalance > 0) {
                                        finalStatement = finalLabel + fmt('@L.Js("Crm_RecFinalDebtor")', [party2, finalAbsText]);
                                    } else if (finalBalance < 0) {
                                        finalStatement = finalLabel + fmt('@L.Js("Crm_RecFinalDebtor")', [party1, finalAbsText]);
                                    } else {
                                        finalStatement = finalLabel + '@L.Js("Crm_RecSettled")';
                                    }
                                } else {
                                    if (finalBalance > 0) {
                                        finalStatement = finalLabel + fmt('@L.Js("Crm_RecFinalOweShort")', [party1, party2, finalAbsText]);
                                    } else if (finalBalance < 0) {
                                        finalStatement = finalLabel + fmt('@L.Js("Crm_RecFinalOweShort")', [party2, party1, finalAbsText]);
                                    } else {
                                        finalStatement = finalLabel + '@L.Js("Crm_RecSettled")';
                                    }
                                }

                                doc.pageMargins = [18, 22, 18, 36];
                                doc.defaultStyle = { fontSize: 8.5, color: '#2f2f2f' };
                                doc.styles = doc.styles || {};
                                doc.styles.tableHeader = {
                                    fillColor: '#cfe0f8',
                                    color: '#22303f',
                                    bold: true,
                                    alignment: 'center',
                                    fontSize: 8.5
                                };
                                doc.styles.smallMuted = { fontSize: 8, color: '#6c757d' };
                                doc.styles.mainTitle = { bold: true, fontSize: 15, color: '#1f8b4c' };

                                // Auto-generated default title matnini olib tashlab, boshiga "ekrandagidek" sarlavha qo'shamiz.
                                if (doc.content && doc.content.length && typeof doc.content[0].text !== 'undefined') {
                                    doc.content.splice(0, 1);
                                }

                                doc.content.unshift(
                                    { text: '@L.Js("Crm_RecTitleCaps")', style: 'mainTitle', alignment: 'center', margin: [0, 0, 0, 3] },
                                    { text: '@L.Js("Crm_RecSettlementDate") ' + asOf, alignment: 'center', margin: [0, 0, 0, 1] },
                                    { text: '@L.Js("Crm_RecDocDate") ' + reportDate, alignment: 'center', margin: [0, 0, 0, 1] },
                                    agreement ? { text: agreement, style: 'smallMuted', alignment: 'center', margin: [0, 0, 0, 6] } : { text: '' },
                                    contractNo
                                        ? { text: fmt('@L.Js("Crm_RecPdfContractLine")', [party1, party2, contractNo]), margin: [0, 0, 0, 8] }
                                        : { text: '' }
                                );

                                var tableNode = doc.content.find(function (c) { return c.table; });
                                if (tableNode) {
                                    // Ekrandagi nisbatga yaqin ustun kengliklari
                                    tableNode.table.widths = ['44%', '14%', '14%', '14%', '14%'];
                                    tableNode.layout = {
                                        hLineWidth: function () { return 0.7; },
                                        vLineWidth: function () { return 0.7; },
                                        hLineColor: function () { return '#c6cfdb'; },
                                        vLineColor: function () { return '#c6cfdb'; },
                                        paddingLeft: function () { return 4; },
                                        paddingRight: function () { return 4; },
                                        paddingTop: function () { return 3; },
                                        paddingBottom: function () { return 3; }
                                    };
                                }

                                doc.content.push(
                                    { text: ' ', margin: [0, 4, 0, 0] },
                                    { text: finalStatement, bold: true, margin: [0, 2, 0, 0] }
                                );

                                doc.footer = function () {
                                    return {
                                        margin: [20, 0, 20, 10],
                                        columns: [
                                            { text: ' ', width: '*' },
                                            {
                                                text: 'www.schain.uz',
                                                link: 'https://www.schain.uz',
                                                color: '#2a6edb',
                                                alignment: 'right',
                                                decoration: 'underline'
                                            }
                                        ]
                                    };
                                };
                            }
                        }
                    })
                });
                $('#aktSverkiTable').DataTable().buttons().container().appendTo('#aktSverkiExportButtons');
            });
        </script>
    }
}
