@model List<tahsinERP.ViewModels.HR.HrPieceRateTimesheetIndexViewModel>
@{
    ViewBag.Title = L.T("Hr_PrTimesheet");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    @{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrPieceRateTimesheets"); }
    @{ bool approvePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrPieceRateTimesheets", "Approve"); }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item active">@L.T("Hr_PrTimesheet")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
                @if (TempData["Warning"] != null) { <div class="alert alert-warning">@TempData["Warning"]</div> }
                @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
                @if (changePermit)
                {
                    <div class="invoice-create-btn mb-1">
                        <a href="@Url.Action("CreateSimple")" class="btn btn-success">
                            <i class="bx bx-plus"></i> @L.T("Hr_PrEnterData")
                        </a>
                        <a href="@Url.Action("GridCreate")" class="btn btn-primary ml-1">
                            <i class="bx bx-table"></i> @L.T("Hr_PrEnterViaGrid")
                        </a>
                    </div>
                }

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <form method="get" action="@Url.Action("Index")" class="mb-2">
                                <div class="row">
                                    <div class="col-md-2">
                                        <input type="number" name="year" class="form-control" value="@ViewBag.Year" placeholder="@L.T("Hr_Year")" min="2000" max="2100" />
                                    </div>
                                    <div class="col-md-2">
                                        <select name="month" class="form-control" id="monthFilter">
                                            <option value="">@L.T("Hr_AllMonths")</option>
                                            @for (int i = 1; i <= 12; i++)
                                            {
                                                <option value="@i" @(ViewBag.Month != null && (int)ViewBag.Month == i ? "selected" : "")>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        @Html.DropDownList("orgUnitId", ViewBag.OrgUnitID as SelectList, L.T("Hr_AllOrgUnits"), new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-primary">@L.T("Filter")</button>
                                    </div>
                                </div>
                            </form>

                            <div class="table-responsive">
                                <table id="timesheetsTable" class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>@L.T("Hr_Year")</th>
                                            <th>@L.T("Hr_Month")</th>
                                            <th>@L.T("Hr_OrgUnit")</th>
                                            <th>@L.T("Status")</th>
                                            <th>@L.T("Hr_PrAccruedPay")</th>
                                            <th>@L.T("CreatedAt")</th>
                                            <th>@L.T("Hr_PayStatus_Approved")</th>
                                            <th>@L.T("Actions")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null)
                                        {
                                            foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.Year</td>
                                                    <td>@item.MonthName</td>
                                                    <td>@item.OrgUnitName</td>
                                                    <td>
                                                        <span class="badge badge-primary">
                                                            @L.T("Hr_EntriesCount", item.EntryCount)
                                                        </span>
                                                    </td>
                                                    <td>@item.CalculatedAmount.ToString("N2")</td>
                                                    <td>@item.CreatedDT.ToString("dd.MM.yyyy")</td>
                                                    <td>
                                                        @if (item.Status == "Approved" && item.ApprovedDT.HasValue)
                                                        {
                                                            <span class="badge badge-success">@item.ApprovedDT.Value.ToString("dd.MM.yyyy")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-warning">@L.T("Hr_NotApproved")</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (changePermit)
                                                        {
                                                            <a href="@Url.Action("GridEdit", new { year = item.Year, month = item.Month })" class="btn btn-sm btn-warning" title="@L.T("Hr_PrGridEditShort")">
                                                                <i class="bx bx-table"></i>
                                                            </a>
                                                        }
                                                        <a href="@Url.Action("Details", new { year = item.Year, month = item.Month, orgUnitId = item.OrgUnitID })" class="btn btn-sm btn-info">
                                                            <i class="bx bx-show"></i>
                                                        </a>
                                                        @if (approvePermit && item.Status != "Approved")
                                                        {
                                                            using (Html.BeginForm("Approve", "HrPieceRateTimesheets", FormMethod.Post, new { style = "display: inline-block;", onsubmit = "return confirm('" + L.Js("Hr_PrApproveConfirm") + "');" }))
                                                            {
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="year" value="@item.Year" />
                                                                <input type="hidden" name="month" value="@item.Month" />
                                                                <input type="hidden" name="orgUnitId" value="@item.OrgUnitID" />
                                                                <button type="submit" class="btn btn-sm btn-success">
                                                                    <i class="bx bx-check"></i>
                                                                </button>
                                                            }
                                                        }
                                                        @if (changePermit)
                                                        {
                                                            <a href="@Url.Action("DeleteEntries", new { year = item.Year, month = item.Month, orgUnitId = item.OrgUnitID })" class="btn btn-sm btn-danger" onclick="return confirm('@L.Js("Hr_PrDeleteEntriesQ")');">
                                                                <i class="bx bx-trash"></i>
                                                            </a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var table = $('#timesheetsTable').DataTable({
                "pageLength": 25,
                "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, '@L.Js("All")']],
                "order": [[0, "desc"], [1, "desc"]],
                "dom": "lBfrtip",
                buttons: erpDataTable.buttons({ small: true })
            });

            // Handle month filter change - reload page with new filter
            $('#monthFilter').on('change', function() {
                var month = $(this).val();
                var year = $('input[name="year"]').val();
                var orgUnitId = $('select[name="orgUnitId"]').val();
                
                var url = '@Url.Action("Index")' + '?year=' + year;
                if (month) {
                    url += '&month=' + month;
                }
                if (orgUnitId) {
                    url += '&orgUnitId=' + orgUnitId;
                }
                
                window.location.href = url;
            });
        });
    </script>

