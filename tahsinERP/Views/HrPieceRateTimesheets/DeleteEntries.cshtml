@{
    ViewBag.Title = "Ishbay ma'lumotlarni o'chirish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrPieceRateTimesheets"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Ishbay ma'lumotlarni o'chirish</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Ishbay tabel</a></li>
                                    <li class="breadcrumb-item active">O'chirish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="alert alert-warning">
                                <strong>Diqqat!</strong> Bu amalni bekor qilib bo'lmaydi. Barcha ishbay ma'lumotlar o'chib ketadi.
                            </div>

                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <strong>Oy:</strong> @ViewBag.MonthName @ViewBag.Year
                                </div>
                                <div class="col-md-6">
                                    <strong>Bo'lim:</strong> @ViewBag.OrgUnitName
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <strong>Yozuvlar soni:</strong> @ViewBag.EntryCount ta
                                </div>
                            </div>

                            @using (Html.BeginForm("DeleteEntries", "HrPieceRateTimesheets", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="year" value="@ViewBag.Year" />
                                <input type="hidden" name="month" value="@ViewBag.Month" />
                                <input type="hidden" name="orgUnitId" value="@ViewBag.OrgUnitId" />

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-danger" onclick="return confirm('Bu oy uchun barcha ishbay ma\'lumotlarni o\'chirishni tasdiqlaysizmi?');">
                                        <i class="bx bx-check"></i> Tasdiqlash
                                    </button>
                                    <a href="@Url.Action("Index", new { year = ViewBag.Year, month = ViewBag.Month, orgUnitId = ViewBag.OrgUnitId })" class="btn btn-secondary">
                                        <i class="bx bx-x"></i> Bekor qilish
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

