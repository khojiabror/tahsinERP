@{
    ViewBag.Title = L.T("Hr_PrDeleteEntries");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_PrTimesheet")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Delete")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="alert alert-warning">
                                <strong>@L.T("Hr_Attention")</strong> @L.T("Hr_PrDeleteEntriesWarn")
                            </div>

                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <strong>@L.T("Hr_Month"):</strong> @ViewBag.MonthName @ViewBag.Year
                                </div>
                                <div class="col-md-6">
                                    <strong>@L.T("Hr_OrgUnit"):</strong> @ViewBag.OrgUnitName
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <strong>@L.T("Hr_PrEntryCount"):</strong> @ViewBag.EntryCount
                                </div>
                            </div>

                            @using (Html.BeginForm("DeleteEntries", "HrPieceRateTimesheets", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="year" value="@ViewBag.Year" />
                                <input type="hidden" name="month" value="@ViewBag.Month" />
                                <input type="hidden" name="orgUnitId" value="@ViewBag.OrgUnitId" />

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-danger" onclick="return confirm('@L.Js("Hr_PrDeleteEntriesConfirm")');">
                                        <i class="bx bx-check"></i> @L.T("Confirm")
                                    </button>
                                    <a href="@Url.Action("Index", new { year = ViewBag.Year, month = ViewBag.Month, orgUnitId = ViewBag.OrgUnitId })" class="btn btn-secondary">
                                        <i class="bx bx-x"></i> @L.T("Cancel")
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

