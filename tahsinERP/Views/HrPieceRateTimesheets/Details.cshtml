@model List<tahsinERP.Models.HR_PIECE_RATE_WORK_ENTRIES>
@{
    ViewBag.Title = "Ishbay tabel tafsilotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "HrPieceRateTimesheets"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Ishbay tabel tafsilotlari - @ViewBag.MonthName @ViewBag.Year</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Ishbay tabel</a></li>
                                    <li class="breadcrumb-item active">Tafsilotlar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="mb-2">
                                <strong>Bo'lim:</strong> @ViewBag.OrgUnitName
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>№</th>
                                            <th>Sana</th>
                                            <th>Xodim</th>
                                            <th>Lavozim</th>
                                            <th>Maxsulot</th>
                                            <th>Operatsiya</th>
                                            <th>Miqdor</th>
                                            <th>Tarif</th>
                                            <th>Summa</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ 
                                            int rowNum = 1; 
                                            decimal totalAmount = 0;
                                            var db = new tahsinERP.Models.DBTHSNEntities();
                                        }
                                        @foreach (var entry in Model)
                                        {
                                            // Get tariff
                                            int? positionId = entry.HR_EMPLOYEES?.PositionID;
                                            var tariff = db.HR_PIECE_RATE_TARIFFS
                                                .Include(t => t.CURRENCy)
                                                .Where(t => t.ProductID == entry.ProductID &&
                                                           t.OperationID == entry.OperationID &&
                                                           t.IsActive &&
                                                           t.EffectiveFrom <= entry.WorkDate &&
                                                           (t.EffectiveTo == null || t.EffectiveTo >= entry.WorkDate) &&
                                                           (positionId.HasValue ? t.PositionID == positionId.Value : t.PositionID == null))
                                                .OrderByDescending(t => t.PositionID)
                                                .FirstOrDefault();

                                            if (tariff == null)
                                            {
                                                tariff = db.HR_PIECE_RATE_TARIFFS
                                                    .Include(t => t.CURRENCy)
                                                    .Where(t => t.ProductID == entry.ProductID &&
                                                               t.OperationID == entry.OperationID &&
                                                               t.PositionID == null &&
                                                               t.IsActive &&
                                                               t.EffectiveFrom <= entry.WorkDate &&
                                                               (t.EffectiveTo == null || t.EffectiveTo >= entry.WorkDate))
                                                    .FirstOrDefault();
                                            }

                                            decimal entryAmount = 0;
                                            if (tariff != null)
                                            {
                                                entryAmount = entry.Quantity * tariff.RatePerUnit;
                                                totalAmount += entryAmount;
                                            }

                                            <tr>
                                                <td>@rowNum</td>
                                                <td>@entry.WorkDate.ToString("dd.MM.yyyy")</td>
                                                <td>@(entry.HR_EMPLOYEES?.FullName ?? "-")</td>
                                                <td>@(entry.HR_EMPLOYEES?.HR_POSITIONS?.Name ?? "-")</td>
                                                <td>@(entry.PRODUCT?.PNo ?? "-")</td>
                                                <td>@(entry.HR_PIECE_RATE_OPERATIONS?.Name ?? "-")</td>
                                                <td>@entry.Quantity.ToString("N2")</td>
                                                <td>@(tariff != null ? tariff.RatePerUnit.ToString("N4") + " " + (tariff.CURRENCy?.Shortname ?? "") : "Tarif topilmadi")</td>
                                                <td>@entryAmount.ToString("N2")</td>
                                            </tr>
                                            rowNum++;
                                        }
                                        @{ db.Dispose(); }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th colspan="8" class="text-right">Jami:</th>
                                            <th>@totalAmount.ToString("N2")</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="form-actions mt-3">
                                <a href="@Url.Action("Index")" class="btn btn-secondary">Orqaga</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
