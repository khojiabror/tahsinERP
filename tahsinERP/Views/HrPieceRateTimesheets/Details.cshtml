@model List<tahsinERP.ViewModels.HR.HrPieceRateTimesheetDetailsViewModel>
@{
    ViewBag.Title = "Ishbay tabel tafsilotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "HrPieceRateTimesheets"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Ishbay tabel tafsilotlari - @ViewBag.MonthName @ViewBag.Year</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Ishbay tabel</a></li>
                                    <li class="breadcrumb-item active">Tafsilotlar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="mb-2">
                                <strong>Bo'lim:</strong> @ViewBag.OrgUnitName
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>№</th>
                                            <th>Sana</th>
                                            <th>Xodim</th>
                                            <th>Lavozim</th>
                                            <th>Maxsulot</th>
                                            <th>Operatsiya</th>
                                            <th>Miqdor</th>
                                            <th>Tarif</th>
                                            <th>Summa</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ 
                                            int rowNum = 1; 
                                            decimal totalAmount = 0;
                                        }
                                        @foreach (var item in Model)
                                        {
                                            totalAmount += item.EntryAmount;
                                            <tr>
                                                <td>@rowNum</td>
                                                <td>@item.Entry.WorkDate.ToString("dd.MM.yyyy")</td>
                                                <td>@(item.Entry.HR_EMPLOYEES?.FullName ?? "-")</td>
                                                <td>@(item.Entry.HR_EMPLOYEES?.HR_POSITIONS?.Name ?? "-")</td>
                                                <td>@(item.Entry.PRODUCT?.PNo ?? "-")</td>
                                                <td>@(item.Entry.HR_PIECE_RATE_OPERATIONS?.Name ?? "-")</td>
                                                <td>@item.Entry.Quantity.ToString("N2")</td>
                                                <td>@(item.Tariff != null ? item.Tariff.RatePerUnit.ToString("N4") + " " + (item.Tariff.CURRENCy?.Shortname ?? "") : "Tarif topilmadi")</td>
                                                <td>@item.EntryAmount.ToString("N2")</td>
                                            </tr>
                                            rowNum++;
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th colspan="8" class="text-right">Jami:</th>
                                            <th>@totalAmount.ToString("N2")</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="form-actions mt-3">
                                <a href="@Url.Action("Index")" class="btn btn-secondary">Orqaga</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
