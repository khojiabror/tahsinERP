@model List<tahsinERP.ViewModels.HR.HrPieceRateTimesheetDetailsViewModel>
@{
    ViewBag.Title = "Ishbay tabel tafsilotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "HrPieceRateTimesheets"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Ishbay tabel</a></li>
                                    <li class="breadcrumb-item active">Tafsilotlar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="mb-2 text-right">
                                <button type="button" class="btn btn-primary" onclick="printReport()"><i class="bx bx-printer"></i> Chop etish</button>
                                <button type="button" class="btn btn-danger" onclick="downloadPdf()"><i class="bx bxs-file-pdf"></i> PDF olish</button>
                            </div>
                            <div class="mb-2">
                                <strong>Bo'lim:</strong> @ViewBag.OrgUnitName
                            </div>
                            <div class="table-responsive" id="printArea" data-print-target="true">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>№</th>
                                            <th>Sana</th>
                                            <th>Xodim</th>
                                            <th>Lavozim</th>
                                            <th>Maxsulot</th>
                                            <th>Operatsiya</th>
                                            <th>Miqdor</th>
                                            <th>Tarif</th>
                                            <th>Summa</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ 
                                            int rowNum = 1; 
                                            decimal totalAmount = 0;
                                        }
                                        @foreach (var item in Model)
                                        {
                                            totalAmount += item.EntryAmount;
                                            <tr>
                                                <td>@rowNum</td>
                                                <td>@item.Entry.WorkDate.ToString("dd.MM.yyyy")</td>
                                                <td>@(item.Entry.HR_EMPLOYEES?.FullName ?? "-")</td>
                                                <td>@(item.Entry.HR_EMPLOYEES?.HR_POSITIONS?.Name ?? "-")</td>
                                                <td>@(item.Entry.PRODUCT?.PNo ?? "-")</td>
                                                <td>@(item.Entry.HR_PIECE_RATE_OPERATIONS?.Name ?? "-")</td>
                                                <td>@item.Entry.Quantity.ToString("N2")</td>
                                                <td>@(item.Tariff != null ? item.Tariff.RatePerUnit.ToString("N4") + " " + (item.Tariff.CURRENCy?.Shortname ?? "") : "Tarif topilmadi")</td>
                                                <td>@item.EntryAmount.ToString("N2")</td>
                                            </tr>
                                            rowNum++;
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th colspan="8" class="text-right">Jami:</th>
                                            <th>@totalAmount.ToString("N2")</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="form-actions mt-3">
                                <a href="@Url.Action("Index")" class="btn btn-secondary">Orqaga</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
<style media="print">
    @@page { size: A4 landscape; margin: 8mm; }
    body * { visibility: hidden; }
    #printArea, #printArea * { visibility: visible; }
    #printArea { position: absolute; left: 0; top: 0; width: 100%; }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
function printReport() {
    var el = document.getElementById('printArea');
    if (!el) { window.print(); return; }

    var popup = window.open('', '_blank', 'width=1200,height=900');
    if (!popup) { window.print(); return; }

    popup.document.write('<!DOCTYPE html><html><head><meta charset="utf-8"><title>Ishbay tabel chop etish</title><style>body{font-family:Arial,sans-serif;margin:10mm;color:#111}.table{border-collapse:collapse;width:100%;font-size:10px}.table th,.table td{border:1px solid #333;padding:4px 6px}.table thead th{background:#f5f5f5}@@page{size:A4 landscape;margin:8mm}</style></head><body>' + el.innerHTML + '</body></html>');
    popup.document.close();
    popup.focus();
    setTimeout(function () { popup.print(); popup.close(); }, 300);
}

function downloadPdf() {
    var element = document.getElementById('printArea');
    var opt = {
        margin: 5,
        filename: 'ishbay-tafsilot.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
    };
    html2pdf().set(opt).from(element).save();
}
</script>
