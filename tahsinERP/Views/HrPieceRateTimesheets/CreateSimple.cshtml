@{
    ViewBag.Title = "Ishbay tabel kiritish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrPieceRateTimesheets"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Ishbay tabel kiritish</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Ishbay tabel</a></li>
                                    <li class="breadcrumb-item active">Kiritish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            @using (Html.BeginForm("CreateSimple", "HrPieceRateTimesheets", FormMethod.Post, new { @class = "form" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="EmployeeID">Xodim <span class="text-danger">*</span></label>
                                            @Html.DropDownList("EmployeeID", ViewBag.EmployeeID as SelectList, "Xodimni tanlang", new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessage("EmployeeID", "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="ProductID">Maxsulot <span class="text-danger">*</span></label>
                                            @Html.DropDownList("ProductID", ViewBag.ProductID as SelectList, "Maxsulotni tanlang", new { @class = "form-control", required = "required", id = "ProductID" })
                                            @Html.ValidationMessage("ProductID", "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="OperationID">Ishbay operatsiyasi <span class="text-danger">*</span></label>
                                            @Html.DropDownList("OperationID", ViewBag.OperationID as SelectList, "Operatsiyani tanlang", new { @class = "form-control", required = "required", id = "OperationID" })
                                            @Html.ValidationMessage("OperationID", "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="TariffRate">Tarif (birlik uchun) <span class="text-danger">*</span></label>
                                            <input type="text" name="TariffRate" id="TariffRate" class="form-control" readonly />
                                            <small class="text-muted">Tarif maxsulot va operatsiyaga qarab avtomatik tortiladi</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="WorkDate">Sana <span class="text-danger">*</span></label>
                                            <input type="date" name="WorkDate" id="WorkDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                                            @Html.ValidationMessage("WorkDate", "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="Quantity">Miqdor (operatsiya miqdori) <span class="text-danger">*</span></label>
                                            <input type="number" name="Quantity" id="Quantity" class="form-control" step="0.0001" min="0" required />
                                            @Html.ValidationMessage("Quantity", "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-save"></i> Saqlash
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                                        <i class="bx bx-x"></i> Bekor qilish
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section scripts {
    <script type="text/javascript">
        (function($) {
            $(document).ready(function() {
                // Load tariff when product or operation changes
                $('#ProductID, #OperationID').on('change', function() {
                    loadTariff();
                });

                // Also load tariff when employee changes
                $('#EmployeeID').on('change', function() {
                    loadTariff();
                });

                function loadTariff() {
                    var productId = $('#ProductID').val();
                    var operationId = $('#OperationID').val();
                    var employeeId = $('#EmployeeID').val();

                    if (productId && operationId) {
                        $.ajax({
                            url: '@Url.Action("GetTariff", "HrPieceRateTimesheets")',
                            type: 'GET',
                            data: { productId: productId, operationId: operationId, employeeId: employeeId },
                            success: function(result) {
                                if (result && result.success && result.tariff) {
                                    var rate = parseFloat(result.tariff.ratePerUnit).toFixed(4);
                                    var currency = result.tariff.currencyShortname || '';
                                    $('#TariffRate').val(rate + (currency ? ' ' + currency : ''));
                                } else {
                                    $('#TariffRate').val('Tarif topilmadi');
                                }
                            },
                            error: function(xhr, status, error) {
                                console.error('Tarif yuklashda xatolik:', error);
                                $('#TariffRate').val('Xatolik yuz berdi');
                            }
                        });
                    } else {
                        $('#TariffRate').val('');
                    }
                }
            });
        })(jQuery);
    </script>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

