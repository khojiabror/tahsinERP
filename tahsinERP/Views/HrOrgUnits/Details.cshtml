@model tahsinERP.ViewModels.HR.HrOrgUnitViewModel
@{
    ViewBag.Title = L.T("Hr_OrgUnitDetails");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    @{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrOrgUnits"); }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_OrgStructure")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Hr_DetailsCrumb")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">@L.T("Code"):</dt>
                                <dd class="col-sm-9">@Model.Code</dd>

                                <dt class="col-sm-3">@L.T("Name"):</dt>
                                <dd class="col-sm-9">@Model.Name</dd>

                                <dt class="col-sm-3">@L.T("Hr_ParentOrgUnit"):</dt>
                                <dd class="col-sm-9">@(Model.ParentName ?? L.T("Hr_OrgRoot"))</dd>

                                <dt class="col-sm-3">@L.T("Hr_OrgLevel"):</dt>
                                <dd class="col-sm-9">@Model.LevelNo</dd>

                                <dt class="col-sm-3">@L.T("Hr_PlannedCount"):</dt>
                                <dd class="col-sm-9">@Model.PlannedHeadcount</dd>

                                <dt class="col-sm-3">@L.T("Hr_ActualCount"):</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.ActualHeadcount >= Model.PlannedHeadcount ? "success" : "warning")">
                                        @Model.ActualHeadcount
                                    </span>
                                </dd>

                                <dt class="col-sm-3">@L.T("Status"):</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.IsActive ? "success" : "danger")">
                                        @(Model.IsActive ? L.T("Active") : L.T("Inactive"))
                                    </span>
                                </dd>

                                <dt class="col-sm-3">@L.T("CreatedAt"):</dt>
                                <dd class="col-sm-9">@Model.CreatedDT.ToString("dd.MM.yyyy HH:mm")</dd>
                            </dl>

                            <hr />

                            <h5 class="mb-2">@L.T("Hr_OrgStaffPositions")</h5>
                            <p class="text-muted">
                                <strong>@L.T("Hr_OrgTotalStaffPositions"):</strong> @L.T("Hr_CountTa", Model.StaffingPlans.Count) | 
                                <strong>@L.T("Hr_Occupied"):</strong> @L.T("Hr_CountTa", Model.StaffingPlans.Sum(sp => sp.AssignedCount)) | 
                                <strong>@L.T("Hr_Vacant"):</strong> @L.T("Hr_CountTa", Model.StaffingPlans.Sum(sp => sp.PlannedHeadcount) - Model.StaffingPlans.Sum(sp => sp.AssignedCount))
                            </p>

                            <div class="table-responsive">
                                <table id="staffingTable" class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>@L.T("Hr_StaffPositionName")</th>
                                            <th>@L.T("Hr_Employee")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var plan in Model.StaffingPlans)
                                        {
                                            for (int i = 0; i < plan.PlannedHeadcount; i++)
                                            {
                                                <tr>
                                                    <td>@plan.PositionName</td>
                                                    <td>
                                                        @if (i < plan.AssignedEmployees.Count)
                                                        {
                                                            <span class="badge badge-success">@plan.AssignedEmployees[i]</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">@L.T("Hr_Vacant")</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="mt-2">
                                <strong>@L.T("Hr_ActiveEmployee"):</strong> <span class="badge badge-success">@L.T("Hr_CountTa", Model.StaffingPlans.Sum(sp => sp.AssignedCount))</span> | 
                                <strong>@L.T("Hr_Vacant"):</strong> <span class="badge badge-secondary">@L.T("Hr_CountTa", Model.StaffingPlans.Sum(sp => sp.PlannedHeadcount) - Model.StaffingPlans.Sum(sp => sp.AssignedCount))</span> | 
                                <strong>@L.T("Total"):</strong> <span class="badge badge-primary">@L.T("Hr_CountTa", Model.StaffingPlans.Sum(sp => sp.PlannedHeadcount))</span>
                            </div>

                            <div class="form-actions mt-3">
                                @if (changePermit)
                                {
                                    <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                                        <i class="bx bx-edit"></i> @L.T("Edit")
                                    </a>
                                }
                                <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("BackToList")</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('#staffingTable').DataTable({
                "pageLength": 25,
                "order": [[0, "asc"]]
            });
        });
    </script>

