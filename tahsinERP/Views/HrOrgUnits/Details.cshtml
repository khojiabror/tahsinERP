@model tahsinERP.ViewModels.HR.HrOrgUnitViewModel
@{
    ViewBag.Title = "Bo'lim tafsilotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    @{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrOrgUnits"); }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Tashkiliy tuzilma</a></li>
                                    <li class="breadcrumb-item active">Tafsilotlar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">Kod:</dt>
                                <dd class="col-sm-9">@Model.Code</dd>

                                <dt class="col-sm-3">Nomi:</dt>
                                <dd class="col-sm-9">@Model.Name</dd>

                                <dt class="col-sm-3">Ota bo'lim:</dt>
                                <dd class="col-sm-9">@(Model.ParentName ?? "Asosiy")</dd>

                                <dt class="col-sm-3">Daraja:</dt>
                                <dd class="col-sm-9">@Model.LevelNo</dd>

                                <dt class="col-sm-3">Rejalashtirilgan soni:</dt>
                                <dd class="col-sm-9">@Model.PlannedHeadcount</dd>

                                <dt class="col-sm-3">Faktik soni:</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.ActualHeadcount >= Model.PlannedHeadcount ? "success" : "warning")">
                                        @Model.ActualHeadcount
                                    </span>
                                </dd>

                                <dt class="col-sm-3">Holat:</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.IsActive ? "success" : "danger")">
                                        @(Model.IsActive ? "Faol" : "Nofaol")
                                    </span>
                                </dd>

                                <dt class="col-sm-3">Yaratilgan:</dt>
                                <dd class="col-sm-9">@Model.CreatedDT.ToString("dd.MM.yyyy HH:mm")</dd>
                            </dl>

                            <hr />

                            <h5 class="mb-2">Shtatlar</h5>
                            <p class="text-muted">
                                <strong>Jami shtatlar:</strong> @Model.StaffingPlans.Count ta | 
                                <strong>Egallangan:</strong> @Model.StaffingPlans.Sum(sp => sp.AssignedCount) ta | 
                                <strong>Vakant:</strong> @(Model.StaffingPlans.Sum(sp => sp.PlannedHeadcount) - Model.StaffingPlans.Sum(sp => sp.AssignedCount)) ta
                            </p>

                            <div class="table-responsive">
                                <table id="staffingTable" class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Shtat nomi</th>
                                            <th>Xodim</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var plan in Model.StaffingPlans)
                                        {
                                            for (int i = 0; i < plan.PlannedHeadcount; i++)
                                            {
                                                <tr>
                                                    <td>@plan.PositionName</td>
                                                    <td>
                                                        @if (i < plan.AssignedEmployees.Count)
                                                        {
                                                            <span class="badge badge-success">@plan.AssignedEmployees[i]</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Vakant</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="mt-2">
                                <strong>Faol xodim:</strong> <span class="badge badge-success">@Model.StaffingPlans.Sum(sp => sp.AssignedCount) ta</span> | 
                                <strong>Vakant:</strong> <span class="badge badge-secondary">@(Model.StaffingPlans.Sum(sp => sp.PlannedHeadcount) - Model.StaffingPlans.Sum(sp => sp.AssignedCount)) ta</span> | 
                                <strong>Jami:</strong> <span class="badge badge-primary">@Model.StaffingPlans.Sum(sp => sp.PlannedHeadcount) ta</span>
                            </div>

                            <div class="form-actions mt-3">
                                @if (changePermit)
                                {
                                    <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                                        <i class="bx bx-edit"></i> Tahrirlash
                                    </a>
                                }
                                <a href="@Url.Action("Index")" class="btn btn-secondary">Ro'yxatga qaytish</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('#staffingTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Russian.json"
                },
                "pageLength": 25,
                "order": [[0, "asc"]]
            });
        });
    </script>

