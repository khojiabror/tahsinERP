@model tahsinERP.Models.HR_ORG_UNITS
@* Create va Edit uchun umumiy forma (HRM-D13). ViewBag.IsEdit = true — tahrirlash. *@
@{
    bool isEdit = ViewBag.IsEdit == true;
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrOrgUnits"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Tashkiliy tuzilma</a></li>
                                    <li class="breadcrumb-item active">@(isEdit ? "Tahrirlash" : "Qo'shish")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @using (Html.BeginForm(isEdit ? "Edit" : "Create", "HrOrgUnits", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    if (isEdit)
                    {
                        @Html.HiddenFor(model => model.ID)
                        @Html.HiddenFor(model => model.LevelNo)
                        @Html.HiddenFor(model => model.SortOrder)
                        @Html.HiddenFor(model => model.CreatedDT)
                    }
                    else
                    {
                        @Html.HiddenFor(model => model.ParentID)
                    }
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Code, new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.TextBoxFor(model => model.Name, new { @class = "form-control", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ParentID, new { @class = "control-label" })
                                            @Html.DropDownListFor(model => model.ParentID, ViewBag.ParentID as SelectList, "Asosiy bo'lim", new { @class = "form-control select2" })
                                            @Html.ValidationMessageFor(model => model.ParentID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <div class="checkbox checkbox-secondary">
                                                @if (isEdit)
                                                {
                                                    @Html.CheckBoxFor(model => model.IsActive, new { @id = "checkboxActive" })
                                                }
                                                else
                                                {
                                                    @Html.CheckBoxFor(model => model.IsActive, new { @id = "checkboxActive", @checked = "checked" })
                                                }
                                                <label for="checkboxActive">Faol</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-save"></i> Saqlash
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">Bekor qilish</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('.select2').select2({ width: '100%' });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

