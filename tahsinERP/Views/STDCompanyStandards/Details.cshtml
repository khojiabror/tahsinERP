@model tahsinERP.ViewModels.STDCompanyStandardsDetailsViewModel
@{
    ViewBag.Title = "Standart batafsil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/STDCompanyStandards">Korxona Standartlari</a></li>
                                    <li class="breadcrumb-item active">@Model.StandardCode</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title"><i class="bx bx-info-circle mr-1"></i>Standart ma'lumotlari</h4>
                                @if (changePermit)
                                {
                                    <div class="card-header-right">
                                        <a href="@Url.Action("Edit", "STDCompanyStandards", new { id = Model.DocumentID })" class="btn btn-sm btn-primary">
                                            <i class="bx bx-edit"></i> Tahrirlash
                                        </a>
                                    </div>
                                }
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <dl class="row">
                                        <dt class="col-sm-4">Standart kodi:</dt>
                                        <dd class="col-sm-8"><strong>@Model.StandardCode</strong></dd>

                                        <dt class="col-sm-4">Soha:</dt>
                                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Area) ? "-" : Model.Area)</dd>

                                        <dt class="col-sm-4">Versiya:</dt>
                                        <dd class="col-sm-8">
                                            <span class="badge badge-light-info">v@(Model.VersionNo.ToString("F2"))</span>
                                        </dd>

                                        <dt class="col-sm-4">Eslatma:</dt>
                                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Notes) ? "-" : Model.Notes)</dd>

                                        <dt class="col-sm-4">Yaratilgan sana:</dt>
                                        <dd class="col-sm-8">@Model.CreatedDT.ToString("dd.MM.yyyy HH:mm")</dd>

                                        @if (Model.UpdatedDT.HasValue)
                                        {
                                            <dt class="col-sm-4">Yangilangan sana:</dt>
                                            <dd class="col-sm-8">@Model.UpdatedDT.Value.ToString("dd.MM.yyyy HH:mm")</dd>
                                        }
                                    </dl>

                                    @if (Model.HasDocumentFile)
                                    {
                                        <div class="mt-3">
                                            <a href="@Url.Action("DownloadFile", "STDCompanyStandards", new { fileId = Model.VersionHistory.FirstOrDefault()?.FileID })" 
                                               class="btn btn-success">
                                                <i class="bx bx-download"></i> Word hujjatini yuklash (.docx)
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Versiya tarixi -->
                        @if (Model.VersionHistory != null && Model.VersionHistory.Any())
                        {
                            <div class="card mt-2">
                                <div class="card-header">
                                    <h4 class="card-title"><i class="bx bx-history mr-1"></i>Versiya tarixi</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Versiya</th>
                                                        <th>Fayl nomi</th>
                                                        <th>Yaratilgan sana</th>
                                                        <th>Amallar</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var version in Model.VersionHistory)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="badge badge-light-info">v@(version.VersionDecimal.ToString("F2"))</span>
                                                            </td>
                                                            <td>@version.FileName</td>
                                                            <td>@version.CreatedDT.ToString("dd.MM.yyyy HH:mm")</td>
                                                            <td>
                                                                <a href="@Url.Action("DownloadFile", "STDCompanyStandards", new { fileId = version.FileID })" 
                                                                   class="btn btn-sm btn-outline-primary" title="Yuklash">
                                                                    <i class="bx bx-download"></i>
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-md-4">
                        <!-- Rasmlar -->
                        @if (Model.Images != null && Model.Images.Any())
                        {
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title"><i class="bx bx-image mr-1"></i>Hujjatdagi rasmlar</h4>
                                    <small class="text-muted">@Model.Images.Count ta rasm</small>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="row">
                                            @foreach (var image in Model.Images)
                                            {
                                                var imageUrl = Url.Action("GetImage", "STDCompanyStandards", new { fileId = image.FileID, index = image.Index });
                                                <div class="col-12 mb-3">
                                                    <div class="card border">
                                                        <div class="card-body p-2">
                                                            <img src="@imageUrl" 
                                                                 class="img-fluid rounded" 
                                                                 alt="@image.FileName"
                                                                 style="max-height: 200px; width: 100%; object-fit: contain; cursor: pointer;"
                                                                 onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22200%22%3E%3Crect fill=%22%23ddd%22 width=%22200%22 height=%22200%22/%3E%3Ctext fill=%22%23999%22 font-family=%22sans-serif%22 font-size=%2214%22 dy=%2210.5%22 x=%2250%25%22 y=%2250%25%22 text-anchor=%22middle%22%3ERasm yuklanmadi%3C/text%3E%3C/svg%3E';"
                                                                 onclick="showImageModal('@imageUrl', '@image.FileName')" />
                                                            <div class="mt-2">
                                                                <small class="text-muted d-block">@image.FileName</small>
                                                                <small class="text-muted">@((image.FileSizeBytes / 1024.0).ToString("F2")) KB</small>
                                                                <a href="@imageUrl" 
                                                                   class="btn btn-sm btn-outline-primary float-right" 
                                                                   download="@image.FileName">
                                                                    <i class="bx bx-download"></i>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card">
                                <div class="card-body text-center text-muted">
                                    <i class="bx bx-image" style="font-size: 48px;"></i>
                                    <p class="mt-2">Hujjatda rasmlar topilmadi</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Image Modal -->
    <div class="modal fade" id="imageModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="imageModalTitle">Rasm</h5>
                    <button type="button" class="close" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>
                <div class="modal-body text-center">
                    <img id="modalImage" src="" alt="" class="img-fluid" style="max-height: 70vh;">
                </div>
                <div class="modal-footer">
                    <a id="downloadImageLink" href="" class="btn btn-primary" download>
                        <i class="bx bx-download"></i> Yuklash
                    </a>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Yopish</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function showImageModal(imageUrl, imageName) {
            $('#modalImage').attr('src', imageUrl);
            $('#modalImage').attr('alt', imageName);
            $('#imageModalTitle').text(imageName);
            $('#downloadImageLink').attr('href', imageUrl);
            $('#downloadImageLink').attr('download', imageName);
            $('#imageModal').modal('show');
        }
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

