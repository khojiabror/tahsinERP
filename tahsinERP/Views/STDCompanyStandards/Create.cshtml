@model tahsinERP.ViewModels.STDCompanyStandardsCreateViewModel
@{
    ViewBag.Title = "Yangi standart qo'shish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/STDCompanyStandards">Korxona Standartlari</a></li>
                                    <li class="breadcrumb-item active">Yangi standart</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title"><i class="bx bx-plus-circle mr-1"></i>Yangi standart ma'lumotlari</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Create", "STDCompanyStandards", FormMethod.Post, new { id = "createForm" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="StandardCode">Standart kodi <span class="text-danger">*</span></label>
                                                    @Html.TextBoxFor(model => model.StandardCode, new { 
                                                        @class = "form-control", 
                                                        @placeholder = "Masalan: STD-001",
                                                        @required = "required",
                                                        @autofocus = "autofocus"
                                                    })
                                                    @Html.ValidationMessageFor(model => model.StandardCode, "", new { @class = "text-danger" })
                                                    <small class="form-text text-muted">Standart kodi takrorlanmasligi kerak</small>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="Area">Soha</label>
                                                    @Html.TextBoxFor(model => model.Area, new { 
                                                        @class = "form-control", 
                                                        @placeholder = "Masalan: Sifat nazorati, Xavfsizlik"
                                                    })
                                                    @Html.ValidationMessageFor(model => model.Area, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label for="Notes">Eslatma</label>
                                            @Html.TextAreaFor(model => model.Notes, new { 
                                                @class = "form-control", 
                                                @rows = "3",
                                                @placeholder = "Qo'shimcha ma'lumotlar..."
                                            })
                                            @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            <label>Hujjat kontenti <span class="text-danger">*</span></label>
                                            <div class="alert alert-info">
                                                <i class="bx bx-info-circle"></i>
                                                <strong>Eslatma:</strong> Quyida Word hujjatini tahrirlashingiz mumkin. Matn orasiga rasmlar qo'shishingiz mumkin.
                                            </div>
                                            
                                            <!-- Quill Editor -->
                                            <div id="editor-container" style="height: 600px; border: 1px solid #ddd; margin-top: 10px;">
                                                <!-- Toolbar -->
                                                <div id="quill-toolbar">
                                                    <span class="ql-formats">
                                                        <select class="ql-font"></select>
                                                        <select class="ql-size"></select>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button class="ql-bold"></button>
                                                        <button class="ql-italic"></button>
                                                        <button class="ql-underline"></button>
                                                        <button class="ql-strike"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <select class="ql-color"></select>
                                                        <select class="ql-background"></select>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button class="ql-script" value="sub"></button>
                                                        <button class="ql-script" value="super"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button class="ql-header" value="1"></button>
                                                        <button class="ql-header" value="2"></button>
                                                        <button class="ql-blockquote"></button>
                                                        <button class="ql-code-block"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button class="ql-list" value="ordered"></button>
                                                        <button class="ql-list" value="bullet"></button>
                                                        <button class="ql-indent" value="-1"></button>
                                                        <button class="ql-indent" value="+1"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <select class="ql-align"></select>
                                                        <select class="ql-direction"></select>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button class="ql-link"></button>
                                                        <button class="ql-image"></button>
                                                        <button class="ql-video"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button class="ql-clean"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        @{ var stdTemplates = ViewBag.Templates as System.Collections.Generic.List<tahsinERP.Services.Documents.DocTemplateListItem>; }
                                                        @if (stdTemplates != null && stdTemplates.Count > 1)
                                                        {
                                                            <select id="templateSelect" class="form-control form-control-sm d-inline-block" style="width: auto;" title="Shablon">
                                                                @foreach (var t in stdTemplates)
                                                                {
                                                                    <option value="@t.ID">@t.Name</option>
                                                                }
                                                            </select>
                                                        }
                                                        <button type="button" class="btn btn-sm btn-outline-primary" id="loadTemplateBtn" title="Shablonni muharrirga yuklash">
                                                            <i class="bx bx-file"></i> Shablon
                                                        </button>
                                                        <a href="@Url.Action("Index", "DocTemplates", new { docType = "COMPANYSTANDARD" })" class="btn btn-sm btn-outline-secondary" title="Shablonlar" target="_blank">
                                                            <i class="bx bx-cog"></i>
                                                        </a>
                                                        <button type="button" class="btn btn-sm btn-outline-success" id="loadDocxBtn" title="Word fayl yuklash">
                                                            <i class="bx bx-upload"></i> Word yuklash
                                                        </button>
                                                    </span>
                                                </div>
                                                <!-- Editor -->
                                                <div id="quill-editor" style="height: 550px;"></div>
                                            </div>
                                            
                                            <!-- Hidden field for document content -->
                                            @Html.HiddenFor(model => model.DocumentContent, new { id = "documentContent" })
                                        </div>

                                        <div class="form-group">
                                            <button type="submit" class="btn btn-primary" id="saveBtn">
                                                <i class="bx bx-save"></i> Saqlash
                                            </button>
                                            <a href="@Url.Action("Index", "STDCompanyStandards")" class="btn btn-outline-secondary">
                                                <i class="bx bx-x"></i> Bekor qilish
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quill.js CSS -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    
    <style>
        #quill-editor {
            background: white;
        }
        .ql-container {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 14px;
        }
        #quill-toolbar {
            border-bottom: 1px solid #ddd;
            background: #f8f9fa;
            padding: 8px;
        }
        #quill-toolbar .ql-formats {
            margin-right: 10px;
        }
        #quill-toolbar button {
            margin: 0 2px;
        }
    </style>
    
    @section scripts {
        <!-- Quill.js -->
        <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
        
        <!-- mammoth.js - .docx ni HTML ga konvertatsiya qilish -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
        
        <script>
        (function() {
            // jQuery yuklanishini kutish
            function waitForJQuery(callback) {
                if (typeof jQuery !== 'undefined' && typeof $ !== 'undefined') {
                    callback();
                } else {
                    setTimeout(function() {
                        waitForJQuery(callback);
                    }, 100);
                }
            }
            
            waitForJQuery(function() {
                $(document).ready(function () {
                    // Quill editor yaratish
                    var quill = new Quill('#quill-editor', {
                        modules: {
                            toolbar: '#quill-toolbar'
                        },
                        theme: 'snow',
                        placeholder: 'Hujjat kontentini kiriting...'
                    });

                    // Template yuklash
                    $('#loadTemplateBtn').on('click', function() {
                        loadTemplate();
                    });

                    // Word fayl yuklash
                    $('#loadDocxBtn').on('click', function() {
                        var fileInput = document.createElement('input');
                        fileInput.type = 'file';
                        fileInput.accept = '.docx';
                        fileInput.onchange = function(e) {
                            var file = e.target.files[0];
                            if (file) {
                                loadDocxFile(file);
                            }
                        };
                        fileInput.click();
                    });

                    function loadTemplate() {
                        $.ajax({
                            // Tanlangan shablon (bir nechta bo'lsa) — bazadan
                            url: '@Url.Action("GetTemplate", "STDCompanyStandards")' + ($('#templateSelect').length ? '?templateId=' + encodeURIComponent($('#templateSelect').val()) : ''),
                            type: 'GET',
                            xhrFields: {
                                responseType: 'blob'
                            },
                            success: function(blob) {
                                var reader = new FileReader();
                                reader.onload = function(e) {
                                    var arrayBuffer = e.target.result;
                                    // mammoth.js bilan .docx ni HTML ga konvertatsiya qilish
                                    // Formatlarni saqlash uchun styleMap va boshqa sozlamalar
                                    var options = {
                                        arrayBuffer: arrayBuffer,
                                        styleMap: [
                                            "p[style-name='Heading 1'] => h1:fresh",
                                            "p[style-name='Heading 2'] => h2:fresh",
                                            "p[style-name='Heading 3'] => h3:fresh",
                                            "p[style-name='Title'] => h1.title:fresh",
                                            "r[style-name='Strong'] => strong",
                                            "p[style-name='Quote'] => blockquote:fresh",
                                            "p[style-name='Intense Quote'] => blockquote.intense:fresh",
                                            "r[style-name='Emphasis'] => em",
                                            "r[style-name='Code'] => code"
                                        ],
                                        includeDefaultStyleMap: true,
                                        convertImage: mammoth.images.imgElement(function(image) {
                                            return image.read("base64").then(function(imageBuffer) {
                                                return {
                                                    src: "data:" + image.contentType + ";base64," + imageBuffer
                                                };
                                            });
                                        })
                                    };
                                    
                                    mammoth.convertToHtml(options)
                                        .then(function(result) {
                                            // HTML ni Quill ga yuklash
                                            var tempDiv = document.createElement('div');
                                            tempDiv.innerHTML = result.value;
                                            
                                            // Quill delta formatiga konvertatsiya qilish
                                            var delta = quill.clipboard.convert(tempDiv);
                                            quill.setContents(delta, 'silent');
                                            
                                            console.log('Template yuklandi');
                                        })
                                        .catch(function(error) {
                                            console.error('Template yuklashda xatolik:', error);
                                            alert('Template yuklashda xatolik yuz berdi');
                                        });
                                };
                                reader.readAsArrayBuffer(blob);
                            },
                            error: function() {
                                alert('Template fayl topilmadi. Bo\'sh hujjat bilan davom eting.');
                            }
                        });
                    }

                    function loadDocxFile(file) {
                        var reader = new FileReader();
                        reader.onload = function(e) {
                            var arrayBuffer = e.target.result;
                            // Formatlarni saqlash uchun styleMap va boshqa sozlamalar
                            var options = {
                                arrayBuffer: arrayBuffer,
                                styleMap: [
                                    "p[style-name='Heading 1'] => h1:fresh",
                                    "p[style-name='Heading 2'] => h2:fresh",
                                    "p[style-name='Heading 3'] => h3:fresh",
                                    "p[style-name='Title'] => h1.title:fresh",
                                    "r[style-name='Strong'] => strong",
                                    "p[style-name='Quote'] => blockquote:fresh",
                                    "p[style-name='Intense Quote'] => blockquote.intense:fresh",
                                    "r[style-name='Emphasis'] => em",
                                    "r[style-name='Code'] => code"
                                ],
                                includeDefaultStyleMap: true,
                                convertImage: mammoth.images.imgElement(function(image) {
                                    return image.read("base64").then(function(imageBuffer) {
                                        return {
                                            src: "data:" + image.contentType + ";base64," + imageBuffer
                                        };
                                    });
                                })
                            };
                            
                            mammoth.convertToHtml(options)
                                .then(function(result) {
                                    // HTML ni Quill ga yuklash
                                    var tempDiv = document.createElement('div');
                                    tempDiv.innerHTML = result.value;
                                    
                                    // Quill delta formatiga konvertatsiya qilish
                                    var delta = quill.clipboard.convert(tempDiv);
                                    quill.setContents(delta, 'silent');
                                    
                                    console.log('Word fayl yuklandi');
                                })
                                .catch(function(error) {
                                    console.error('Word fayl yuklashda xatolik:', error);
                                    alert('Word fayl yuklashda xatolik yuz berdi');
                                });
                        };
                        reader.readAsArrayBuffer(file);
                    }

                    // Rasm qo'shish (Quill.js built-in)
                    // Quill.js avtomatik rasm qo'shish funksiyasini qo'llab-quvvatlaydi

                    // Form submit - HTML ni .docx ga konvertatsiya qilish
                    $('#createForm').on('submit', function(e) {
                        e.preventDefault();
                        
                        // Quill content ni olish
                        var htmlContent = quill.root.innerHTML;
                        
                        if (!htmlContent || htmlContent.trim() === '<p><br></p>') {
                            alert('Iltimos, hujjat kontentini kiriting');
                            return false;
                        }

                        // HTML ni server-side .docx ga konvertatsiya qilish
                        // HTML ni to'g'ridan-to'g'ri yuboramiz, server-side konvertatsiya qiladi
                        try {
                            // HTML kontentni base64 ga o'tkazish (yoki to'g'ridan-to'g'ri HTML sifatida)
                            var base64 = btoa(unescape(encodeURIComponent(htmlContent)));
                            $('#documentContent').val(base64);
                            
                            // Form ni submit qilish
                            $('#createForm')[0].submit();
                        } catch (error) {
                            console.error('Hujjat yaratishda xatolik:', error);
                            alert('Hujjat yaratishda xatolik yuz berdi. Iltimos, qayta urinib ko\'ring.');
                        }
                    });
                });
            });
        })();
        </script>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
