@model tahsinERP.Models.STD_COMPANY_STANDARDS
@{
    ViewBag.Title = L.T("Doc_StdDelete");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/STDCompanyStandards">@L.T("Menu_CompanyStandards")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Delete")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title"><i class="bx bx-trash mr-1"></i>@L.T("Doc_StdDelete")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="alert alert-warning">
                                        <i class="bx bx-error-circle"></i>
                                        <strong>@L.T("Core_Attention")</strong> @L.T("Doc_StdDeleteWarning")
                                    </div>

                                    <h5>@L.T("Doc_StdWillBeDeleted")</h5>
                                    
                                    <dl class="row mt-3">
                                        <dt class="col-sm-4">@L.T("Doc_StdCodeColon")</dt>
                                        <dd class="col-sm-8"><strong>@Model.StandardCode</strong></dd>

                                        <dt class="col-sm-4">@L.T("Doc_FieldColon")</dt>
                                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Area) ? "-" : Model.Area)</dd>

                                        <dt class="col-sm-4">@L.T("Doc_VersionColon")</dt>
                                        <dd class="col-sm-8">
                                            <span class="badge badge-light-info">v@(Model.VersionNo)</span>
                                        </dd>

                                        <dt class="col-sm-4">@L.T("Core_NoteLabel")</dt>
                                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Notes) ? "-" : Model.Notes)</dd>
                                    </dl>

                                    @using (Html.BeginForm("Delete", "STDCompanyStandards", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(model => model.DocumentID)

                                        <div class="form-group mt-4">
                                            <button type="submit" class="btn btn-danger" onclick="return confirm('@L.Js("Doc_ConfirmDeleteIrreversible")');">
                                                <i class="bx bx-trash"></i> @L.T("Core_YesDelete")
                                            </button>
                                            <a href="@Url.Action("Details", "STDCompanyStandards", new { id = Model.DocumentID })" class="btn btn-outline-secondary">
                                                <i class="bx bx-x"></i> @L.T("Cancel")
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

