@model List<Dictionary<string, object>>
@{
    ViewBag.Title = L.T("Hr_ImportPreview");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_StaffingPlan")</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Import")">@L.T("Import")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Hr_Preview")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">@L.T("Hr_ImportedRows", Model.Count)</h4>
                    </div>
                    <div class="card-content">
                        <div class="card-body">
                            @using (Html.BeginForm("ImportConfirm", "HrStaffingPlan", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()

                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>№</th>
                                                <th>@L.T("Hr_TabNoShort")</th>
                                                <th>@L.T("Hr_FullName")</th>
                                                <th>@L.T("Hr_Position")</th>
                                                <th>@L.T("Hr_Salary")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Model.Count; i++)
                                            {
                                                var row = Model[i];
                                                <tr>
                                                    <td>@(i + 1)</td>
                                                    <td>@row["TabNo"]</td>
                                                    <td>@row["FullName"]</td>
                                                    <td>@row["Position"]</td>
                                                    <td>@row["BaseSalary"]</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="form-actions mt-3">
                                    <button type="submit" class="btn btn-success">
                                        <i class="bx bx-check"></i> @L.T("Hr_ConfirmAndSave")
                                    </button>
                                    <a href="@Url.Action("Import")" class="btn btn-secondary">
                                        <i class="bx bx-x"></i> @L.T("Cancel")
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

