@model tahsinERP.ViewModels.HR.HrStaffingPlanViewModel
@* Create va Edit uchun umumiy forma (HRM-D13). ViewBag.IsEdit = true — tahrirlash. *@
@{
    bool isEdit = ViewBag.IsEdit == true;
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_StaffingPlan")</a></li>
                                    <li class="breadcrumb-item active">@(isEdit ? L.T("Edit") : L.T("Add"))</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @using (Html.BeginForm(isEdit ? "Edit" : "Create", "HrStaffingPlan", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    if (isEdit)
                    {
                        @Html.HiddenFor(model => model.ID)
                    }
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.OrgUnitID, new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.OrgUnitID, ViewBag.OrgUnitID as SelectList, L.T("Hr_SelectOrgUnit"), new { @class = "form-control select2", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.OrgUnitID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.PositionID, new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.PositionID, ViewBag.PositionID as SelectList, L.T("Hr_SelectPosition"), new { @class = "form-control select2", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.PositionID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.SalaryGradeID, new { @class = "control-label" })
                                            @Html.DropDownListFor(model => model.SalaryGradeID, ViewBag.SalaryGradeID as SelectList, L.T("Hr_SelectSalaryGrade"), new { @class = "form-control select2" })
                                            @Html.ValidationMessageFor(model => model.SalaryGradeID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.PlannedHeadcount, new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.TextBoxFor(model => model.PlannedHeadcount, new { @class = "form-control", @type = "number", @step = "0.01", @min = "0", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.PlannedHeadcount, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>@L.T("Hr_PayType")</label>
                                            <div class="checkbox checkbox-secondary">
                                                @Html.CheckBoxFor(model => model.IsFixedSalary, new { @id = "checkboxFixed" })
                                                <label for="checkboxFixed">@L.T("Hr_PayFixedSalary")</label>
                                            </div>
                                            <div class="checkbox checkbox-secondary">
                                                @Html.CheckBoxFor(model => model.IsHourly, new { @id = "checkboxHourly" })
                                                <label for="checkboxHourly">@L.T("Hr_PayHourlyFull")</label>
                                            </div>
                                            <div class="checkbox checkbox-secondary">
                                                @Html.CheckBoxFor(model => model.IsPieceRate, new { @id = "checkboxPiece" })
                                                <label for="checkboxPiece">@L.T("Hr_PayPieceFull")</label>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.EffectiveFrom, new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.TextBoxFor(model => model.EffectiveFrom, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.EffectiveFrom, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.EffectiveTo, new { @class = "control-label" })
                                            @Html.TextBoxFor(model => model.EffectiveTo, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                                            @Html.ValidationMessageFor(model => model.EffectiveTo, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            <div class="checkbox checkbox-secondary">
                                                @if (isEdit)
                                                {
                                                    @Html.CheckBoxFor(model => model.IsActive, new { @id = "checkboxActive" })
                                                }
                                                else
                                                {
                                                    @Html.CheckBoxFor(model => model.IsActive, new { @id = "checkboxActive", @checked = "checked" })
                                                }
                                                <label for="checkboxActive">@L.T("Active")</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-save"></i> @L.T("Save")
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("Cancel")</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('.select2').select2({ width: '100%' });
        });
    </script>

