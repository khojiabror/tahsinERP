@model List<tahsinERP.ViewModels.HR.HrStaffingPlanViewModel>
@{
    ViewBag.Title = L.T("Hr_StaffingPlan");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    @{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrStaffingPlan"); }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item active">@L.T("Hr_StaffingPlan")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (changePermit)
                {
                    <div class="invoice-create-btn mb-1">
                        <a href="@Url.Action("Create")" class="btn btn-success">
                            <i class="bx bx-plus"></i> @L.T("Hr_SpAddPosition")
                        </a>
                        <a href="@Url.Action("GenerateFromEmployees")" class="btn btn-info">
                            <i class="bx bx-user-plus"></i> @L.T("Hr_SpFromEmployees")
                        </a>
                        <a href="@Url.Action("Import")" class="btn btn-warning">
                            <i class="bx bx-import"></i> @L.T("Hr_ImportFromExcel")
                        </a>
                    </div>
                }

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <form method="get" action="@Url.Action("Index")" class="mb-2">
                                <div class="row">
                                    <div class="col-md-3">
                                        @Html.DropDownList("orgUnitId", ViewBag.OrgUnitID as SelectList, L.T("Hr_AllOrgUnits"), new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.DropDownList("positionId", ViewBag.PositionID as SelectList, L.T("Hr_AllPositions"), new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-2">
                                        <select name="isActive" class="form-control">
                                            <option value="">@L.T("All")</option>
                                            <option value="true" @(ViewBag.IsActive == true ? "selected" : "")>@L.T("Active")</option>
                                            <option value="false" @(ViewBag.IsActive == false ? "selected" : "")>@L.T("Inactive")</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" class="btn btn-primary">@L.T("Filter")</button>
                                    </div>
                                </div>
                            </form>

                            <div class="table-responsive">
                                <table id="staffingPlanTable" class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>@L.T("Hr_OrgUnit")</th>
                                            <th>@L.T("Hr_Position")</th>
                                            <th>@L.T("Hr_SalaryGrade")</th>
                                            <th>@L.T("Hr_PlannedCount")</th>
                                            <th>@L.T("Hr_Actual")</th>
                                            <th>@L.T("Hr_PayType")</th>
                                            <th>@L.T("Hr_EffectiveFrom")</th>
                                            <th>@L.T("Actions")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.OrgUnitName</td>
                                                <td>@item.PositionName</td>
                                                <td>@(item.SalaryGradeName ?? "-")</td>
                                                <td>@item.PlannedHeadcount</td>
                                                <td>
                                                    <span class="badge badge-@(item.ActualHeadcount >= item.PlannedHeadcount ? "success" : "warning")">
                                                        @item.ActualHeadcount
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (item.IsFixedSalary)
                                                    {
                                                        <span class="badge badge-info">@L.T("Hr_PayFixed")</span>
                                                    }
                                                    @if (item.IsHourly)
                                                    {
                                                        <span class="badge badge-primary">@L.T("Hr_PayHourly")</span>
                                                    }
                                                    @if (item.IsPieceRate)
                                                    {
                                                        <span class="badge badge-secondary">@L.T("Hr_PayPiece")</span>
                                                    }
                                                </td>
                                                <td>@item.EffectiveFrom.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-info">
                                                        <i class="bx bx-show"></i>
                                                    </a>
                                                    @if (changePermit)
                                                    {
                                                        <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-warning">
                                                            <i class="bx bx-edit"></i>
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('#staffingPlanTable').DataTable({
                "pageLength": 25,
                "order": [[0, "asc"]]
            });
        });
    </script>

