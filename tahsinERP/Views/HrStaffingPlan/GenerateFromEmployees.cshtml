@model List<tahsinERP.ViewModels.HR.HrStaffingPlanViewModel>
@{
    ViewBag.Title = L.T("Hr_SpGenerateTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_StaffingPlan")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Hr_SpFromEmployees")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @using (Html.BeginForm("CreateFromProposals", "HrStaffingPlan", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <p class="text-muted">@L.T("Hr_SpProposals"):</p>

                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <input type="checkbox" id="selectAll" />
                                                </th>
                                                <th>@L.T("Hr_OrgUnit")</th>
                                                <th>@L.T("Hr_Position")</th>
                                                <th>@L.T("Hr_PlannedCount")</th>
                                                <th>@L.T("Hr_EffectiveFrom")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Model.Count; i++)
                                            {
                                                @Html.HiddenFor(m => m[i].OrgUnitID)
                                                @Html.HiddenFor(m => m[i].PositionID)
                                                @Html.HiddenFor(m => m[i].SalaryGradeID)
                                                @Html.HiddenFor(m => m[i].EffectiveFrom)
                                                <tr>
                                                    <td>
                                                        @Html.CheckBoxFor(m => m[i].IsActive, new { @class = "proposal-checkbox" })
                                                    </td>
                                                    <td>@Model[i].OrgUnitName</td>
                                                    <td>@Model[i].PositionName</td>
                                                    <td>
                                                        @Html.TextBoxFor(m => m[i].PlannedHeadcount, new { @class = "form-control form-control-sm", @type = "number", @step = "0.01", @min = "0", @value = "1" })
                                                    </td>
                                                    <td>@Model[i].EffectiveFrom.ToString("dd.MM.yyyy")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="form-actions mt-3">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-save"></i> @L.T("Hr_SpCreateSelected")
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("Cancel")</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('#selectAll').change(function() {
                $('.proposal-checkbox').prop('checked', $(this).prop('checked'));
            });
        });
    </script>

