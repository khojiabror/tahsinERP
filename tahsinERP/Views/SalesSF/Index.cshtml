@model List<tahsinERP.Models.SALES_SF_HEADERS>
@{
    ViewBag.Title = L.T("Menu_List");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsPermittedForAction(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString(), true);

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Crm_SfBreadcrumb")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <!-- Filters -->
                    <div class="users-list-filter px-1">
                        @using (Html.BeginForm("Index", "SalesSF", FormMethod.Get, new { @class = "form" }))
                        {
                            <div class="row border rounded py-2 mb-2">
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>@L.T("Search")</label>
                                    <input type="text" name="searchTerm" class="form-control" placeholder="@L.T("Crm_SfNumberPlaceholder")" value="@ViewBag.SearchTerm" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>@L.T("Crm_Client")</label>
                                    @Html.DropDownList("customerID", ViewBag.Customers as SelectList, L.T("All"), new { @class = "form-control" })
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>@L.T("Crm_SfInvoice")</label>
                                    @Html.DropDownList("invoiceID", ViewBag.Invoices as SelectList, L.T("All"), new { @class = "form-control" })
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>@L.T("Status")</label>
                                    <select name="statusCode" class="form-control">
                                        <option value="">@L.T("All")</option>
                                        <option value="DRAFT" @(ViewBag.StatusCode == "DRAFT" ? "selected" : "")>DRAFT</option>
                                        <option value="SENT" @(ViewBag.StatusCode == "SENT" ? "selected" : "")>SENT</option>
                                        <option value="ACCEPTED" @(ViewBag.StatusCode == "ACCEPTED" ? "selected" : "")>ACCEPTED</option>
                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bx bx-search"></i> @L.T("Search")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="row mb-2">
                                        <div class="col-md-6">
                                            <span class="text-muted">@L.T("Crm_SfTotalRecords", ViewBag.TotalItems)</span>
                                        </div>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table invoice-data-table dt-responsive nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Crm_SfNumber")</th>
                                                    <th>@L.T("Date")</th>
                                                    <th>@L.T("Crm_SfInvoice")</th>
                                                    <th>@L.T("Crm_Client")</th>
                                                    <th>@L.T("Status")</th>
                                                    <th>@L.T("Actions")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "SalesSF", new { id = item.ID })">@item.SFNumber</a>
                                                            </td>
                                                            <td>@item.SFDate.ToString("dd.MM.yyyy")</td>
                                                            <td>
                                                                @if (item.SALES_INVOICES != null)
                                                                {
                                                                    <a href="@Url.Action("Details", "SalesInvoices", new { id = item.InvoiceID })">@item.SALES_INVOICES.InvoiceNo</a>
                                                                }
                                                            </td>
                                                            <td>@item.CustomerINN</td>
                                                            <td>
                                                                <span class="badge badge-@(item.StatusCode == "ACCEPTED" ? "success" : item.StatusCode == "SENT" ? "info" : "warning")">
                                                                    @item.StatusCode
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <a href="@Url.Action("Details", "SalesSF", new { id = item.ID })" class="btn btn-sm btn-outline-info" title="@L.T("View")"><i class="bx bx-show"></i></a>
                                                                @if (changePermit && item.StatusCode != "SENT" && item.StatusCode != "ACCEPTED")
                                                                {
                                                                    <a href="@Url.Action("Edit", "SalesSF", new { id = item.ID })" class="btn btn-sm btn-outline-success" title="@L.T("Edit")"><i class="bx bx-edit-alt"></i></a>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="6" class="text-center">@L.T("NoData")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    @Html.Partial("~/Views/SalesInvoices/_Pager.cshtml")
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}

