@model tahsinERP.Models.SALES_SF_HEADERS
@{
    ViewBag.Title = "Generate SF from Invoice";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var invoice = ViewBag.Invoice as tahsinERP.Models.SALES_INVOICES;
    var invoiceLines = ViewBag.InvoiceLines as List<tahsinERP.Models.SALES_INVOICE_LINES>;
    var products = ViewBag.Products as Dictionary<int, tahsinERP.Models.PRODUCT>;
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SalesSF">SF</a>
                                    </li>
                                    @if (invoice != null)
                                    {
                                        <li class="breadcrumb-item">
                                            <a href="@Url.Action("Details", "SalesInvoices", new { id = invoice.ID })">Invoys @invoice.InvoiceNo</a>
                                        </li>
                                    }
                                    <li class="breadcrumb-item active">
                                        SF yaratish
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @if (invoice != null)
                                        {
                                            <div class="alert alert-info">
                                                <strong>Invoys:</strong> @invoice.InvoiceNo | 
                                                <strong>Sana:</strong> @invoice.InvoiceDate.ToString("dd.MM.yyyy") | 
                                                <strong>Summa:</strong> @invoice.TotalAmount.ToString("N2") @tahsinERP.Services.Crm.SalesLookups.CurrencyCode(invoice.CurrencyID)
                                            </div>
                                        }

                                        @using (Html.BeginForm("GenerateFromInvoice", "SalesSF", FormMethod.Post, new { @class = "form" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(m => m.InvoiceID)
                                            @Html.HiddenFor(m => m.CustomerID)

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>SF raqami *</label>
                                                        @Html.TextBoxFor(m => m.SFNumber, new { @class = "form-control", placeholder = "Bo'sh qoldiring — avtomatik (SF-yyyy-0001)" })
                                                        @Html.ValidationMessageFor(m => m.SFNumber, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>SF sanasi *</label>
                                                        @Html.TextBoxFor(m => m.SFDate, new { @class = "form-control", type = "date", required = "required", Value = Model.SFDate.ToString("yyyy-MM-dd") })
                                                        @Html.ValidationMessageFor(m => m.SFDate, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Ta'minotchi INN *</label>
                                                        @Html.TextBoxFor(m => m.SupplierINN, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.SupplierINN, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Mijoz INN *</label>
                                                        @Html.TextBoxFor(m => m.CustomerINN, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.CustomerINN, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <hr />
                                            <h5>SF qatorlari (Invoys qatorlaridan)</h5>

                                            <div class="table-responsive">
                                                <table class="table table-bordered" id="sfLinesTable">
                                                    <thead>
                                                        <tr>
                                                            <th>Mahsulot</th>
                                                            <th>Tavsif</th>
                                                            <th>Miqdor</th>
                                                            <th>Birlik narxi</th>
                                                            <th>QQS %</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (invoiceLines != null)
                                                        {
                                                            int index = 0;
                                                            foreach (var invoiceLine in invoiceLines)
                                                            {
                                                                var product = products != null && products.ContainsKey(invoiceLine.ProductID) ? products[invoiceLine.ProductID] : null;
                                                                <tr>
                                                                    <td>
                                                                        @if (product != null)
                                                                        {
                                                                            @product.PNo
                                                                        }
                                                                        <input type="hidden" name="lines[@index].ProductID" value="@invoiceLine.ProductID" />
                                                                        <input type="hidden" name="lines[@index].InvoiceLineID" value="@invoiceLine.ID" />
                                                                    </td>
                                                                    <td>
                                                                        <input type="text" name="lines[@index].Description" class="form-control" value="@(invoiceLine.Description ?? "")" />
                                                                    </td>
                                                                    <td>
                                                                        <input type="number" name="lines[@index].Qty" class="form-control" step="0.01" min="0" value="@invoiceLine.Qty" readonly />
                                                                    </td>
                                                                    <td>
                                                                        <input type="number" name="lines[@index].UnitPrice" class="form-control" step="0.01" min="0" value="@invoiceLine.UnitPrice" readonly />
                                                                    </td>
                                                                    <td>
                                                                        <input type="number" name="lines[@index].VATRate" class="form-control" step="0.01" min="0" max="100" value="@invoiceLine.VATRate" readonly />
                                                                    </td>
                                                                </tr>
                                                                index++;
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12">
                                                    <button type="submit" class="btn btn-primary">
                                                        <i class="bx bx-save"></i> SF yaratish
                                                    </button>
                                                    @if (invoice != null)
                                                    {
                                                        <a href="@Url.Action("Details", "SalesInvoices", new { id = invoice.ID })" class="btn btn-secondary">
                                                            Bekor qilish
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}

