@model tahsinERP.Models.SALES_SF_HEADERS
@{
    ViewBag.Title = "Edit SF";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SalesSF">SF</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="@Url.Action("Details", "SalesSF", new { id = Model.ID })">@Model.SFNumber</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Tahrirlash
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @if (Model.StatusCode == "SENT" || Model.StatusCode == "ACCEPTED")
                                        {
                                            <div class="alert alert-warning">
                                                <strong>Diqqat!</strong> Yuborilgan yoki qabul qilingan SF ni tahrirlash mumkin emas.
                                            </div>
                                        }

                                        @using (Html.BeginForm("Edit", "SalesSF", FormMethod.Post, new { @class = "form" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(m => m.ID)
                                            @Html.HiddenFor(m => m.InvoiceID)
                                            @Html.HiddenFor(m => m.CustomerID)

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>SF raqami *</label>
                                                        @Html.TextBoxFor(m => m.SFNumber, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.SFNumber, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>SF sanasi *</label>
                                                        @Html.TextBoxFor(m => m.SFDate, new { @class = "form-control", type = "date", required = "required", Value = Model.SFDate.ToString("yyyy-MM-dd") })
                                                        @Html.ValidationMessageFor(m => m.SFDate, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Ta'minotchi INN *</label>
                                                        @Html.TextBoxFor(m => m.SupplierINN, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.SupplierINN, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Mijoz INN *</label>
                                                        @Html.TextBoxFor(m => m.CustomerINN, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.CustomerINN, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Holati</label>
                                                        @Html.DropDownListFor(m => m.StatusCode, new SelectList(new[] { "DRAFT", "SENT", "ACCEPTED", "REJECTED" }, Model.StatusCode), new { @class = "form-control" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12">
                                                    <button type="submit" class="btn btn-primary" @(Model.StatusCode == "SENT" || Model.StatusCode == "ACCEPTED" ? "disabled" : "")>
                                                        <i class="bx bx-save"></i> Saqlash
                                                    </button>
                                                    <a href="@Url.Action("Details", "SalesSF", new { id = Model.ID })" class="btn btn-secondary">
                                                        Bekor qilish
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

