@model tahsinERP.Models.SALES_SF_HEADERS
@{
    ViewBag.Title = L.T("Crm_SfEditTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SalesSF">SF</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="@Url.Action("Details", "SalesSF", new { id = Model.ID })">@Model.SFNumber</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Edit")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @if (Model.StatusCode == "SENT" || Model.StatusCode == "ACCEPTED")
                                        {
                                            <div class="alert alert-warning">
                                                <strong>@L.T("Crm_Attention")</strong> @L.T("Crm_SfCannotEditSent").
                                            </div>
                                        }

                                        @using (Html.BeginForm("Edit", "SalesSF", FormMethod.Post, new { @class = "form" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
                                            @Html.HiddenFor(m => m.ID)
                                            @Html.HiddenFor(m => m.InvoiceID)
                                            @Html.HiddenFor(m => m.CustomerID)

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>@L.T("Crm_SfNumber") *</label>
                                                        @Html.TextBoxFor(m => m.SFNumber, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.SFNumber, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>@L.T("Crm_SfDate") *</label>
                                                        @Html.TextBoxFor(m => m.SFDate, new { @class = "form-control", type = "date", required = "required", Value = Model.SFDate.ToString("yyyy-MM-dd") })
                                                        @Html.ValidationMessageFor(m => m.SFDate, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>@L.T("Crm_SfSupplierInn") *</label>
                                                        @Html.TextBoxFor(m => m.SupplierINN, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.SupplierINN, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>@L.T("Crm_SfCustomerInn") *</label>
                                                        @Html.TextBoxFor(m => m.CustomerINN, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.CustomerINN, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>@L.T("Status")</label>
                                                        @Html.DropDownListFor(m => m.StatusCode, new SelectList(new[] { "DRAFT", "SENT", "ACCEPTED", "REJECTED" }, Model.StatusCode), new { @class = "form-control" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12">
                                                    <button type="submit" class="btn btn-primary" @(Model.StatusCode == "SENT" || Model.StatusCode == "ACCEPTED" ? "disabled" : "")>
                                                        <i class="bx bx-save"></i> @L.T("Save")
                                                    </button>
                                                    <a href="@Url.Action("Details", "SalesSF", new { id = Model.ID })" class="btn btn-secondary">
                                                        @L.T("Cancel")
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}

