@model tahsinERP.Models.SALES_SF_HEADERS
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var customer = ViewBag.Customer as tahsinERP.Models.CUSTOMER;
    var order = ViewBag.Order as tahsinERP.Models.S_ORDERS;
    var products = ViewBag.Products as Dictionary<int, tahsinERP.Models.PRODUCT>;
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SalesSF">SF</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        SF ma'lumotlari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                <h4 class="text-primary">SF ma'lumotlari</h4>
                                                <hr />
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <span><b>SF raqami</b>: @Html.DisplayFor(model => model.SFNumber)</span><br />
                                                        <span><b>SF sanasi</b>: @Model.SFDate.ToString("dd.MM.yyyy")</span><br />
                                                        <span><b>Mijoz INN</b>: @Html.DisplayFor(model => model.CustomerINN)</span><br />
                                                        <span><b>Ta'minotchi INN</b>: @Html.DisplayFor(model => model.SupplierINN)</span><br />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <span><b>Holati</b>: 
                                                            <span class="badge badge-@(Model.StatusCode == "ACCEPTED" ? "success" : Model.StatusCode == "SENT" ? "info" : "warning")">
                                                                @Model.StatusCode
                                                            </span>
                                                        </span><br />
                                                        <span><b>Yaratilgan</b>: @Model.CreatedDT.ToString("dd.MM.yyyy HH:mm")</span><br />
                                                    </div>
                                                </div>
                                                <hr />

                                                <!-- Navigation Links -->
                                                <div class="row mt-3">
                                                    <div class="col-12">
                                                        <h5 class="text-primary mb-3">Bog'liq hujjatlar</h5>
                                                        <div class="btn-group" role="group">
                                                            @if (Model.SALES_INVOICES != null)
                                                            {
                                                                <a href="@Url.Action("Details", "SalesInvoices", new { id = Model.InvoiceID })" class="btn btn-outline-primary">
                                                                    <i class="bx bx-receipt"></i> Invoys: @Model.SALES_INVOICES.InvoiceNo
                                                                </a>
                                                            }
                                                            @if (order != null)
                                                            {
                                                                <a href="@Url.Action("Details", "SOrder", new { id = order.ID })" class="btn btn-outline-primary">
                                                                    <i class="bx bx-list-ul"></i> Buyurtma: @order.OrderNo
                                                                </a>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <hr>

                                        <!-- SF Lines -->
                                        <section id="column-selectors">
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="card">
                                                        <div class="card-header">
                                                            <h4 class="card-title">SF qatorlari</h4>
                                                        </div>
                                                        <div class="card-content">
                                                            <div class="card-body card-dashboard">
                                                                <div class="table-responsive">
                                                                    <table class="table table-striped" style="width:100%">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>№</th>
                                                                                <th>Mahsulot</th>
                                                                                <th>Tavsif</th>
                                                                                <th>Miqdor</th>
                                                                                <th>Birlik narxi</th>
                                                                                <th>Qator summa</th>
                                                                                <th>QQS %</th>
                                                                                <th>QQS summa</th>
                                                                                <th>Jami</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var line in Model.SALES_SF_LINES.OrderBy(l => l.LineNo))
                                                                            {
                                                                                var product = products != null && products.ContainsKey(line.ProductID) ? products[line.ProductID] : null;
                                                                                <tr>
                                                                                    <td>@line.LineNo</td>
                                                                                    <td>
                                                                                        @if (product != null)
                                                                                        {
                                                                                            <a href="@Url.Action("Details", "Product", new { id = line.ProductID })">@product.PNo</a>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            @line.ProductID
                                                                                        }
                                                                                    </td>
                                                                                    <td>@(line.Description ?? "")</td>
                                                                                    <td>@line.Qty.ToString("N2")</td>
                                                                                    <td>@line.UnitPrice.ToString("N2")</td>
                                                                                    <td>@line.LineAmount.ToString("N2")</td>
                                                                                    <td>@line.VATRate.ToString("N2")%</td>
                                                                                    <td>@line.VATAmount.ToString("N2")</td>
                                                                                    <td>@line.TotalWithVAT.ToString("N2")</td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

