@model List<tahsinERP.Models.FIN_PL_PLANS>

@{
    ViewBag.Title = "P&L rejalar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinPlPlans");
}

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">Moliya</li>
                                    <li class="breadcrumb-item active">P&L rejalar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <button type="button" class="btn btn-outline-success mr-1 mb-1" onclick="window.location.href='/FinPlPlans/Create?year=@ViewBag.Year&month=@ViewBag.Month';">
                                <span class="align-middle ml-25">Reja qo'shish</span>
                            </button>
                            <a href="@Url.Action("BulkEdit", new { year = ViewBag.Year, month = ViewBag.Month })" class="btn btn-outline-info mr-1 mb-1">
                                <span class="align-middle ml-25">To'plamda tahrirlash</span>
                            </a>
                            <a href="@Url.Action("ExportExcel", new { year = ViewBag.Year, month = ViewBag.Month })" class="btn btn-outline-primary mr-1 mb-1">
                                <span class="align-middle ml-25">Excel ga eksport</span>
                            </a>
                        </div>
                    }
                    
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="plansTable" class="table table-striped table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Yil</th>
                                                <th>Oy</th>
                                                <th>Element</th>
                                                <th>Reja summasi</th>
                                                <th>Yaratilgan</th>
                                                @if (changePermit)
                                                {
                                                    <th>Amallar</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.Year</td>
                                                    <td>@(new DateTime(2000, item.Month, 1).ToString("MMMM"))</td>
                                                    <td>@item.FIN_PL_ITEMS?.Name</td>
                                                    <td>@item.AmountPlan.ToString("N2")</td>
                                                    <td>@item.CreatedDT.ToString("dd.MM.yyyy")</td>
                                                    @if (changePermit)
                                                    {
                                                        <td class="text-center">
                                                            <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-outline-info" title="Ko'rish">
                                                                <i class="bx bx-show"></i>
                                                            </a>
                                                            <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-outline-primary" title="Tahrirlash">
                                                                <i class="bx bx-edit"></i>
                                                            </a>
                                                            <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-outline-danger" title="O'chirish">
                                                                <i class="bx bx-trash"></i>
                                                            </a>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                var changePermit = @(changePermit ? "true" : "false");
                
                var columnDefs = [
                    { "className": "text-center", "targets": [0, 1, 2, 3, 4] }
                ];
                if (changePermit) {
                    columnDefs.push({ "orderable": false, "targets": -1, "className": "text-center" });
                }
                
                $('#plansTable').DataTable({
                    "language": {
                        "search": "Qidirish:",
                        "lengthMenu": "_MENU_ ta ko'rsatish",
                        "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                        "infoEmpty": "Yozuvlar yo'q",
                        "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                        "paginate": {
                            "first": "Birinchi",
                            "last": "Oxirgi",
                            "next": "Keyingi",
                            "previous": "Oldingi"
                        },
                        "zeroRecords": "Ma'lumot topilmadi"
                    },
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Barchasi"]],
                    "order": [[0, "desc"], [1, "desc"]],
                    "columnDefs": columnDefs,
                    "dom": 'lBfrtip',
                    "pagingType": "full_numbers",
                    "buttons": erpDataTable.buttons({ fileName: 'FinPlPlans', columns: changePermit ? ':not(:last-child)' : ':visible', pdf: false })
                });
            });
        </script>
    }
