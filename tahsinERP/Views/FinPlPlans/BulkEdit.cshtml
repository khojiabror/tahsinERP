@model List<tahsinERP.Controllers.Finance.BulkPlanItem>

@{
    ViewBag.Title = "P&L rejalarni to'plamda tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinPlPlans"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/FinPlPlans">P&L rejalar</a></li>
                                    <li class="breadcrumb-item active">To'plamda tahrirlash</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">P&L rejalarni to'plamda tahrirlash - @ViewBag.Year yil, @(new DateTime(2000, (int)(ViewBag.Month ?? 1), 1).ToString("MMMM")) oy</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <form method="get" action="@Url.Action("BulkEdit")" class="mb-3">
                                        <div class="row">
                                            <div class="col-md-2">
                                                @Html.DropDownList("year", ViewBag.YearList as SelectList, new { @class = "form-control" })
                                            </div>
                                            <div class="col-md-2">
                                                @Html.DropDownList("month", ViewBag.MonthList as SelectList, new { @class = "form-control" })
                                            </div>
                                            <div class="col-md-2">
                                                <button type="submit" class="btn btn-primary">Ko'rsatish</button>
                                            </div>
                                        </div>
                                    </form>
                                    
                                    @using (Html.BeginForm("BulkEdit", "FinPlPlans", FormMethod.Post, new { @class = "form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("year", (object)ViewBag.Year)
                                        @Html.Hidden("month", (object)ViewBag.Month)
                                        
                                        <div class="table-responsive">
                                            <table id="bulkPlansTable" class="table table-striped table-bordered" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>Kod</th>
                                                        <th>Element nomi</th>
                                                        <th>Reja summasi</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (int i = 0; i < Model.Count; i++)
                                                    {
                                                        <tr>
                                                            <td>@Model[i].ItemCode</td>
                                                            <td>@Model[i].ItemName</td>
                                                            <td>
                                                                @Html.HiddenFor(m => m[i].ItemID)
                                                                @Html.HiddenFor(m => m[i].ItemName)
                                                                @Html.HiddenFor(m => m[i].ItemCode)
                                                                @Html.TextBoxFor(m => m[i].AmountPlan, new { @class = "form-control", type = "number", step = "0.01" })
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        
                                        <div class="form-actions mt-3">
                                            <button type="submit" class="btn btn-primary">Saqlash</button>
                                            <a href="@Url.Action("Index", new { year = ViewBag.Year, month = ViewBag.Month })" class="btn btn-secondary">Bekor qilish</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
