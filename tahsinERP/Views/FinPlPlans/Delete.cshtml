@model tahsinERP.Models.FIN_PL_PLANS

@{
    ViewBag.Title = "P&L rejasini o'chirish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/FinPlPlans">P&L rejalar</a></li>
                                    <li class="breadcrumb-item active">O'chirish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title text-danger">P&L rejasini o'chirish</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="alert alert-warning">
                                        <h5>Diqqat!</h5>
                                        <p>Ushbu rejani o'chirishni tasdiqlaysizmi?</p>
                                    </div>
                                    
                                    <dl class="row">
                                        <dt class="col-sm-4">Yil:</dt>
                                        <dd class="col-sm-8">@Model.Year</dd>
                                        
                                        <dt class="col-sm-4">Oy:</dt>
                                        <dd class="col-sm-8">@(new DateTime(2000, Model.Month, 1).ToString("MMMM"))</dd>
                                        
                                        <dt class="col-sm-4">Element:</dt>
                                        <dd class="col-sm-8">@(Model.FIN_PL_ITEMS?.Name)</dd>
                                        
                                        <dt class="col-sm-4">Reja summasi:</dt>
                                        <dd class="col-sm-8">@Model.AmountPlan.ToString("N2")</dd>
                                    </dl>
                                    
                                    @using (Html.BeginForm("Delete", "FinPlPlans", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", Model.ID)
                                        
                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-danger">Ha, o'chirish</button>
                                            <a href="@Url.Action("Index", new { year = Model.Year, month = Model.Month })" class="btn btn-secondary">Bekor qilish</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
