@model tahsinERP.ViewModels.ProductPlanViewModel
@{
    ViewBag.Title = L.T("Mes_Plan_EditTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Edit", "ProductPlan", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ID)
        
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/ProductPlan/Index">@L.T("Mes_Plan_Title")</a>
                                        </li>
                                        <li class="breadcrumb-item active">@L.T("Edit")</li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="basic-select2">
                        <div class="row">
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            <div class="row">
                                                <div class="col-lg-12 col-md-6 mt-25">
                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                    <hr>
                                                    
                                                    <h6 class="invoice-to">@L.T("Mes_Product") *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.DropDownListFor(model => model.ProductID, ViewBag.Products as SelectList, L.T("Mes_Val_SelectProduct"), new { @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.ProductID, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">@L.T("Mes_Plan_PlanQtyTotal") *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.TotalQty, new { @class = "form-control", @type = "number", @step = "0.01", @min = "0.01", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.TotalQty, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">@L.T("Mes_Plan_StartDate") *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">@L.T("Mes_Plan_EndDate") *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">@L.T("Mes_Plan_SalesOrder") (@L.T("Optional"))</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.DropDownListFor(model => model.SalesOrderID, ViewBag.SalesOrders as SelectList, L.T("Mes_Plan_OptionalLink"), new { @class = "form-control select2" })
                                                        @Html.ValidationMessageFor(model => model.SalesOrderID, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <div class="alert alert-warning mt-2">
                                                        <i class="bx bx-info-circle"></i> 
                                                        @L.T("Mes_Plan_EditHint")
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="invoice-action">
                            <div class="row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary mr-1">
                                        <i class="bx bx-save"></i> @L.T("Save")
                                    </button>
                                    <a href="@Url.Action("Details", new { id = Model.ID })" class="btn btn-secondary">
                                        <i class="bx bx-x"></i> @L.T("Cancel")
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
