@model tahsinERP.Models.PRODUCTPLAN
@{
    ViewBag.Title = "Ishlab Chiqarish Rejasini O'chirish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/ProductPlan/Index">Ishlab Chiqarish Rejasi</a>
                                    </li>
                                    <li class="breadcrumb-item active">O'chirish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                <h4 class="text-danger">Ishlab Chiqarish Rejasini O'chirish</h4>
                                                <hr />
                                                <div class="alert alert-warning">
                                                    <i class="bx bx-error"></i> 
                                                    Siz haqiqatan ham ushbu rejani o'chirmoqchimisiz?
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <p><strong>Mahsulot:</strong> @(Model.PRODUCT?.PNo ?? Model.ProductID.ToString())</p>
                                                        <p><strong>Reja miqdori:</strong> @Model.Amount.ToString("N2")</p>
                                                        <p><strong>Boshlanish sanasi:</strong> @Model.StartDate.ToString("dd.MM.yyyy")</p>
                                                        <p><strong>Tugash sanasi:</strong> @Model.DueDate.ToString("dd.MM.yyyy")</p>
                                                        <p><strong>Savdo buyurtmasi:</strong> @(Model.S_ORDERS?.OrderNo ?? "-")</p>
                                                    </div>
                                                </div>
                                                <hr />
                                                @using (Html.BeginForm("Delete", "ProductPlan", new { id = Model.ID }, FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    
                                                    <div class="row mt-3">
                                                        <div class="col-12">
                                                            <button type="submit" class="btn btn-danger">
                                                                <i class="bx bx-trash"></i> Ha, o'chirish
                                                            </button>
                                                            <a href="@Url.Action("Details", new { id = Model.ID })" class="btn btn-secondary">
                                                                <i class="bx bx-x"></i> Bekor qilish
                                                            </a>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
