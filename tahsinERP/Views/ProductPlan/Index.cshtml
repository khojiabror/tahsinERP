@model tahsinERP.ViewModels.ProductPlanListViewModel
@{
    ViewBag.Title = "Ishlab Chiqarish Rejasi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">Ishlab Chiqarish Rejasi</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "ProductPlan")" class="btn btn-success bg-light invoice-create" role="button">
                                <i class="bx bx-plus"></i> Yangi Reja
                            </a>
                            <a href="@Url.Action("GridCreate", "ProductPlan")" class="btn btn-primary bg-light invoice-create ml-1" role="button">
                                <i class="bx bx-table"></i> Jadvalda kiritish
                            </a>
                            <a href="@Url.Action("GridEdit", "ProductPlan")" class="btn btn-warning bg-light invoice-create ml-1" role="button">
                                <i class="bx bx-edit-alt"></i> Jadvalda tahrirlash
                            </a>
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    }

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- Search and Filter -->
                                    <div class="users-list-filter px-1">
                                        <form method="get" action="@Url.Action("Index")">
                                            <div class="row border rounded py-2 mb-2">
                                                <div class="col-12 col-sm-6 col-lg-3">
                                                    <label>Mahsulot</label>
                                                    @Html.DropDownList("productID", ViewBag.Products as SelectList, "Barchasi", new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-3">
                                                    <label>Dan</label>
                                                    <input type="date" name="fromDate" class="form-control" value="@(Model.FromDate?.ToString("yyyy-MM-dd") ?? "")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-3">
                                                    <label>Gacha</label>
                                                    <input type="date" name="toDate" class="form-control" value="@(Model.ToDate?.ToString("yyyy-MM-dd") ?? "")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-3">
                                                    <label>&nbsp;</label>
                                                    <button type="submit" class="btn btn-primary btn-block">Qidirish</button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- datatable start -->
                                    <div class="card-datatable table-responsive">
                                        <table id="productPlanTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Mahsulot</th>
                                                    <th>Reja miqdori</th>
                                                    <th>Savdo buyurtmasi</th>
                                                    <th>Boshlanish sanasi</th>
                                                    <th>Tugash sanasi</th>
                                                    <th>Kunlar soni</th>
                                                    <th>Amallar</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.Plans != null && Model.Plans.Any())
                                                {
                                                    foreach (var item in Model.Plans)
                                                    {
                                                        var daysCount = (item.EndDate - item.StartDate).Days + 1;
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", new { id = item.ID })">
                                                                    @(item.Product?.PNo ?? item.ProductID.ToString())
                                                                </a>
                                                            </td>
                                                            <td>@item.TotalQty.ToString("N2")</td>
                                                            <td>@(string.IsNullOrWhiteSpace(item.SalesOrderNo) ? "-" : item.SalesOrderNo)</td>
                                                            <td>@item.StartDate.ToString("dd.MM.yyyy")</td>
                                                            <td>@item.EndDate.ToString("dd.MM.yyyy")</td>
                                                            <td>@daysCount</td>
                                                            <td>
                                                                <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-info">
                                                                    <i class="bx bx-show"></i>
                                                                </a>
                                                                @if (changePermit)
                                                                {
                                                                    <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-warning">
                                                                        <i class="bx bx-edit"></i>
                                                                    </a>
                                                                    <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-danger">
                                                                        <i class="bx bx-trash"></i>
                                                                    </a>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@section scripts {
    <script src="~/Scripts/app/erp-datatable.js"></script>
    <script>
        $(document).ready(function() {
            $('#productPlanTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Uzbek.json"
                },
                "order": [[2, "desc"]],
                "pageLength": 25,
                dom: 'lBfrtip',
                buttons: erpDataTable.buttons({ small: true })
            });
        });
    </script>
}
