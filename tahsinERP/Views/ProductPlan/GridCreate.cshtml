@model tahsinERP.ViewModels.ProductPlanGridEntryViewModel
@{
    ViewBag.Title = L.T("Mes_Plan_GridCreateTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-body">
            @if (TempData["Success"] != null) { <div class="alert alert-success">@Html.Raw(TempData["Success"])</div> }
            @if (TempData["Error"] != null) { <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div> }

            <div class="card mb-1">
                <div class="card-body">
                    <h4 class="mb-1">@L.T("Mes_Plan_GridCreateHeader")</h4>
                    <div class="form-row">
                        <div class="col-md-2">
                            <label>@L.T("Mes_Year")</label>
                            <input id="yearPick" type="number" class="form-control" value="@Model.Year" min="2000" max="2100" />
                        </div>
                        <div class="col-md-2">
                            <label>@L.T("Mes_Month")</label>
                            <select id="monthPick" class="form-control">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m" @(Model.Month == m ? "selected" : "")>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-primary" onclick="reloadByMonth()"><i class="bx bx-refresh"></i> @L.T("Mes_Plan_ApplyMonth")</button>
                        </div>
                    </div>
                </div>
            </div>

            @using (Html.BeginForm("GridCreate", "ProductPlan", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Year)
                @Html.HiddenFor(m => m.Month)

                <div class="table-responsive">
                    <table class="table table-bordered" id="gridTable">
                        <thead>
                            <tr class="thead-light">
                                <th>@L.T("Mes_Product")</th>
                                <th>@L.T("Mes_Plan_PlanQty")</th>
                                <th>@L.T("Mes_Plan_StartDate")</th>
                                <th>@L.T("Mes_Plan_EndDate")</th>
                                <th>@L.T("Mes_Plan_SalesOrder")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                <tr>
                                    <td>@Html.DropDownListFor(m => m.Rows[i].ProductID, ViewBag.Products as SelectList, L.T("Select"), new { @class = "form-control product" })</td>
                                    <td>@Html.TextBoxFor(m => m.Rows[i].TotalQty, new { @type = "number", step = "0.01", min = "0.01", @class = "form-control qty" })</td>
                                    <td>@Html.TextBoxFor(m => m.Rows[i].StartDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control" })</td>
                                    <td>@Html.TextBoxFor(m => m.Rows[i].EndDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control" })</td>
                                    <td>@Html.DropDownListFor(m => m.Rows[i].SalesOrderID, ViewBag.SalesOrders as SelectList, L.T("Mes_Plan_OptionalLink"), new { @class = "form-control salesOrder" })</td>
                                    <td><button type="button" class="btn btn-sm btn-outline-danger row-remove"><i class="bx bx-trash"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-1">
                    <button type="button" class="btn btn-outline-success" onclick="addRow()"><i class="bx bx-plus"></i> @L.T("Mes_Plan_AddRow")</button>
                </div>
                <div class="mt-2">
                    <button type="submit" class="btn btn-primary"><i class="bx bx-save"></i> @L.T("Save")</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("Back")</a>
                </div>
            }
        </div>
    </div>
</div>

<script>
    const productOptions = @Html.Raw(Json.Encode(string.Join("", (ViewBag.Products as SelectList).Select(x => "<option value='" + System.Web.HttpUtility.HtmlAttributeEncode(x.Value) + "'>" + System.Web.HttpUtility.HtmlEncode(x.Text) + "</option>"))));
    const salesOrderOptions = @Html.Raw(Json.Encode(string.Join("", (ViewBag.SalesOrders as SelectList).Select(x => "<option value='" + System.Web.HttpUtility.HtmlAttributeEncode(x.Value) + "'>" + System.Web.HttpUtility.HtmlEncode(x.Text) + "</option>"))));

    function reloadByMonth() {
        const y = document.getElementById('yearPick').value;
        const m = document.getElementById('monthPick').value;
        window.location.href = '@Url.Action("GridCreate")' + '?year=' + y + '&month=' + m;
    }

    function addRow() {
        const tbody = document.querySelector('#gridTable tbody');
        const idx = tbody.querySelectorAll('tr').length;
        const y = document.getElementById('yearPick').value;
        const m = document.getElementById('monthPick').value.toString().padStart(2, '0');
        const lastDay = new Date(parseInt(y), parseInt(m), 0).getDate().toString().padStart(2, '0');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><select name="Rows[${idx}].ProductID" class="form-control product"><option value="">@L.Js("Select")</option>${productOptions}</select></td>
            <td><input name="Rows[${idx}].TotalQty" type="number" step="0.01" min="0.01" class="form-control qty"/></td>
            <td><input name="Rows[${idx}].StartDate" type="date" class="form-control" value="${y}-${m}-01"/></td>
            <td><input name="Rows[${idx}].EndDate" type="date" class="form-control" value="${y}-${m}-${lastDay}"/></td>
            <td><select name="Rows[${idx}].SalesOrderID" class="form-control salesOrder"><option value="">@L.Js("Mes_Plan_OptionalLink")</option>${salesOrderOptions}</select></td>
            <td><button type="button" class="btn btn-sm btn-outline-danger row-remove"><i class="bx bx-trash"></i></button></td>`;
        tbody.appendChild(tr);
    }

    document.querySelector('#gridTable tbody').addEventListener('click', function (e) {
        var btn = e.target.closest('.row-remove');
        if (!btn) return;
        e.preventDefault();
        var tr = btn.closest('tr');
        if (tr) tr.remove();
    });
</script>
