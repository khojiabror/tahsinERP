@model tahsinERP.ViewModels.ProductPlanGridEntryViewModel
@{
    ViewBag.Title = "Rejani jadvalda tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-body">
            @if (TempData["Success"] != null) { <div class="alert alert-success">@Html.Raw(TempData["Success"])</div> }
            @if (TempData["Error"] != null) { <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div> }

            <div class="card mb-1">
                <div class="card-body">
                    <h4 class="mb-1">Ishlab chiqarish rejasini jadvalda tahrirlash</h4>
                    <div class="form-row">
                        <div class="col-md-2">
                            <label>Yil</label>
                            <input id="yearPick" type="number" class="form-control" value="@Model.Year" min="2000" max="2100" />
                        </div>
                        <div class="col-md-2">
                            <label>Oy</label>
                            <select id="monthPick" class="form-control">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m" @(Model.Month == m ? "selected" : "")>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-primary" onclick="reloadByMonth()"><i class="bx bx-refresh"></i> Oyni qo'llash</button>
                        </div>
                    </div>
                </div>
            </div>

            @using (Html.BeginForm("GridEdit", "ProductPlan", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Year)
                @Html.HiddenFor(m => m.Month)

                <div class="table-responsive">
                    <table class="table table-bordered" id="gridTable">
                        <thead>
                            <tr class="thead-light">
                                <th>Mahsulot</th>
                                <th>Reja miqdori</th>
                                <th>Boshlanish sanasi</th>
                                <th>Tugash sanasi</th>
                                <th>Savdo buyurtmasi</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                @Html.HiddenFor(m => m.Rows[i].PlanID)
                                <tr>
                                    <td>
                                        @Html.DropDownListFor(
                                            m => m.Rows[i].ProductID,
                                            new SelectList((ViewBag.Products as SelectList)?.Items, "ID", "PNo", Model.Rows[i].ProductID),
                                            "Tanlang",
                                            new { @class = "form-control product" })
                                    </td>
                                    <td>@Html.TextBoxFor(m => m.Rows[i].TotalQty, new { @type = "number", step = "0.01", min = "0.01", @class = "form-control qty" })</td>
                                    <td>@Html.TextBoxFor(m => m.Rows[i].StartDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control" })</td>
                                    <td>@Html.TextBoxFor(m => m.Rows[i].EndDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control" })</td>
                                    <td>
                                        @Html.DropDownListFor(
                                            m => m.Rows[i].SalesOrderID,
                                            new SelectList((ViewBag.SalesOrders as SelectList)?.Items, "ID", "Name", Model.Rows[i].SalesOrderID),
                                            "-- ixtiyoriy bog'lash --",
                                            new { @class = "form-control salesOrder" })
                                    </td>
                                    <td class="text-center">
                                        @if (Model.Rows[i].PlanID.HasValue)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="deleteGridPlan(@Model.Rows[i].PlanID.Value, @Model.Year, @Model.Month)">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger row-remove"><i class="bx bx-trash"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-1">
                    <button type="button" class="btn btn-outline-success" onclick="addRow()"><i class="bx bx-plus"></i> Yangi qator qo'shish</button>
                </div>
                <div class="mt-2">
                    <button type="submit" class="btn btn-primary"><i class="bx bx-save"></i> Saqlash</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Orqaga</a>
                </div>
            }
        </div>
    </div>
</div>

<script>
    const productOptions = `@Html.Raw(string.Join("", (ViewBag.Products as SelectList).Select(x => $"<option value='{x.Value}'>{x.Text}</option>")))`;
    const salesOrderOptions = `@Html.Raw(string.Join("", (ViewBag.SalesOrders as SelectList).Select(x => $"<option value='{x.Value}'>{x.Text}</option>")))`;

    function reloadByMonth() {
        const y = document.getElementById('yearPick').value;
        const m = document.getElementById('monthPick').value;
        window.location.href = '@Url.Action("GridEdit")' + '?year=' + y + '&month=' + m;
    }

    function addRow() {
        const tbody = document.querySelector('#gridTable tbody');
        const idx = tbody.querySelectorAll('tr').length;
        const y = document.getElementById('yearPick').value;
        const m = document.getElementById('monthPick').value.toString().padStart(2, '0');
        const lastDay = new Date(parseInt(y), parseInt(m), 0).getDate().toString().padStart(2, '0');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <input id="Rows_${idx}__PlanID" name="Rows[${idx}].PlanID" type="hidden" value="" />
            <td><select name="Rows[${idx}].ProductID" class="form-control product"><option value="">Tanlang</option>${productOptions}</select></td>
            <td><input name="Rows[${idx}].TotalQty" type="number" step="0.01" min="0.01" class="form-control qty"/></td>
            <td><input name="Rows[${idx}].StartDate" type="date" class="form-control" value="${y}-${m}-01"/></td>
            <td><input name="Rows[${idx}].EndDate" type="date" class="form-control" value="${y}-${m}-${lastDay}"/></td>
            <td><select name="Rows[${idx}].SalesOrderID" class="form-control salesOrder"><option value="">-- ixtiyoriy bog'lash --</option>${salesOrderOptions}</select></td>
            <td><button type="button" class="btn btn-sm btn-outline-danger row-remove"><i class="bx bx-trash"></i></button></td>`;
        tbody.appendChild(tr);
    }

    function deleteGridPlan(id, year, month) {
        if (!confirm("Reja o'chirilsinmi?")) return;
        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (!token) {
            alert("Token topilmadi");
            return;
        }
        var body = new URLSearchParams();
        body.append('id', id);
        body.append('year', year);
        body.append('month', month);
        body.append('__RequestVerificationToken', token.value);
        fetch('@Url.Action("DeleteGridRow", "ProductPlan")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
            body: body.toString(),
            credentials: 'same-origin'
        }).then(function (r) {
            if (r.ok || r.status === 302) window.location.reload();
            else alert("O'chirishda xatolik");
        }).catch(function () { alert("Tarmoq xatosi"); });
    }

    document.querySelector('#gridTable tbody').addEventListener('click', function (e) {
        var btn = e.target.closest('.row-remove');
        if (!btn) return;
        e.preventDefault();
        var tr = btn.closest('tr');
        if (tr) tr.remove();
    });
</script>
