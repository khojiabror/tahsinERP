@using tahsinERP.Services.Tasks
@model tahsinERP.ViewModels.TaskDashboardViewModel
@{
    ViewBag.Title = L.T("Menu_DashTasks");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Tasks">@L.T("Menu_Tasks")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Menu_Dashboard")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <!-- Filters -->
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <form method="get" action="@Url.Action("Index")" class="row">
                                    @if (ViewBag.IsAdminOrDeveloper == true)
                                    {
                                        <div class="col-md-6">
                                            <label>@L.T("Core_User")</label>
                                            @{
                                                var userSelectList = ViewBag.UserID as SelectList;
                                                var selectedUserId = ViewBag.SelectedUserID as int?;
                                            }
                                            <select name="userId" class="form-control" onchange="this.form.submit()">
                                                <option value="">@L.T("Core_AllUsers")</option>
                                                @if (userSelectList != null)
                                                {
                                                    foreach (var item in userSelectList)
                                                    {
                                                        <option value="@item.Value" @(selectedUserId.HasValue && selectedUserId.Value.ToString() == item.Value ? "selected" : "")>@item.Text</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-6">
                                            <label>@L.T("Core_User")</label>
                                            <select name="userId" class="form-control" disabled>
                                                @if (ViewBag.UserID != null)
                                                {
                                                    var userSelectList = ViewBag.UserID as SelectList;
                                                    foreach (var item in userSelectList)
                                                    {
                                                        <option value="@item.Value" selected>@item.Text</option>
                                                    }
                                                }
                                            </select>
                                            @Html.Hidden("userId", (object)ViewBag.CurrentUserID)
                                        </div>
                                    }
                                    <div class="col-md-6">
                                        <label>&nbsp;</label>
                                        <div>
                                            <a href="@Url.Action("Index", "Tasks")" class="btn btn-secondary">
                                                <i class="bx bx-list-ul"></i> @L.T("Task_AllTasks")
                                            </a>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Summary Cards -->
                <div class="row match-height">
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="bx bx-task primary font-large-2 float-left"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h3>@Model.UserTaskCount</h3>
                                            <span>@L.T("Task_TotalTasksFor", Model.UserName)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="bx bx-check-circle success font-large-2 float-left"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h3>@Model.UserDoneCount</h3>
                                            <span>@L.T("Js_Task_Done")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="bx bx-time-five warning font-large-2 float-left"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h3>@Model.UserInProgressCount</h3>
                                            <span>@L.T("Js_Task_InProgress")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="bx bx-list-ul info font-large-2 float-left"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h3>@Model.UserTodoCount</h3>
                                            <span>@L.T("Js_Task_Todo")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Additional Stats -->
                <div class="row match-height">
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="bx bx-calendar-x danger font-large-2 float-left"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h3>@Model.OverdueCount</h3>
                                            <span>@L.T("Js_Task_Overdue")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="bx bx-time info font-large-2 float-left"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h3>@Model.RecentTasksCount</h3>
                                            <span>@L.T("Task_Last7Days")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Charts Row -->
                <div class="row">
                    <!-- Status Pie Chart -->
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Task_ByStatusDist")</h4>
                            </div>
                            <div class="card-body">
                                <div id="statusPieChart" style="min-height: 350px;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Priority Chart -->
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Task_ByPriorityDist")</h4>
                            </div>
                            <div class="card-body">
                                <div id="priorityBarChart" style="min-height: 350px;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Priority Details Chart -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Task_ByPriorityStats")</h4>
                            </div>
                            <div class="card-body">
                                <div id="priorityStackedChart" style="min-height: 400px;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Overdue Tasks Chart -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Task_OverdueByProject")</h4>
                            </div>
                            <div class="card-body">
                                <div id="overdueTasksChart" style="min-height: 400px;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Employee Rating Chart -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Task_EmployeeRating")</h4>
                            </div>
                            <div class="card-body">
                                <div id="employeeRatingChart" style="min-height: 400px;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@section scripts
{
    <!-- ApexCharts Script -->
    <script src="~/app-assets/vendors/js/charts/apexcharts.min.js"></script>
    <!-- Grafik ma'lumotlari: server bir marta JSON qiladi, chizish Scripts/app/task-dashboard.js da (MNT-02) -->
    <script type="application/json" id="taskDashData">
        @Html.Raw(Json.Encode(new
        {
            statusLabels = Model.StatusStatistics.Select(x => x.StatusName + " (" + x.Count + ")"),
            statusSeries = Model.StatusStatistics.Select(x => x.Count),
            statusColors = Model.StatusStatistics.Select(x => TaskBadges.StatusColorByCode(x.StatusCode)),
            priorityCategories = Model.PriorityStatistics.Select(x => x.PriorityName),
            priorityColors = Model.PriorityStatistics.Select(x => TaskBadges.PriorityColorByCode(x.PriorityCode)),
            priorityTotal = Model.PriorityStatistics.Select(x => x.TotalCount),
            priorityDone = Model.PriorityStatistics.Select(x => x.DoneCount),
            priorityTodo = Model.PriorityStatistics.Select(x => x.TodoCount),
            priorityInProgress = Model.PriorityStatistics.Select(x => x.InProgressCount),
            overdueProjects = Model.OverdueTasksStatistics.Select(x => x.ProjectName),
            overdueCounts = Model.OverdueTasksStatistics.Select(x => x.OverdueCount),
            employeeNames = Model.EmployeeRatings.Select(x => x.FullName),
            employeeScores = Model.EmployeeRatings.Select(x => x.RatingScore),
            employeeOnTime = Model.EmployeeRatings.Select(x => x.OnTimeCompletedCount),
            employeeOverdue = Model.EmployeeRatings.Select(x => x.OverdueNotCompletedCount)
        }))
    </script>
    <script src="~/Scripts/app/task-dashboard.js"></script>
}
