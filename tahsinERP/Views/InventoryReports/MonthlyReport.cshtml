@model tahsinERP.ViewModels.WarehouseMonthlyReportViewModel
@{
    ViewBag.Title = L.T("Wh_Mr_Title");
    Layout = "~/Views/Shared/_Layout.cshtml";
    Func<object, string, decimal> getDecimal = (obj, propName) =>
    {
        if (obj == null || string.IsNullOrWhiteSpace(propName))
        {
            return 0m;
        }

        var prop = obj.GetType().GetProperty(propName);
        if (prop == null)
        {
            return 0m;
        }

        var raw = prop.GetValue(obj, null);
        if (raw == null)
        {
            return 0m;
        }

        try { return Convert.ToDecimal(raw); } catch { return 0m; }
    };
}
<style>
    @@media print {
        .no-print { display: none !important; }
        .print-only { display: block !important; }
        body { background: #fff !important; }
        body * { visibility: hidden; }
        #reportCard, #reportCard * { visibility: visible !important; }
        #reportCard { display: block !important; position: relative !important; left: 0 !important; top: 0 !important; width: 100% !important; color: #000 !important; }
        #reportCard table { color: #000 !important; }
        #reportCard th, #reportCard td { color: #000 !important; border-color: #333 !important; }
        .content-header, .navbar, .main-menu, .menu, footer, .breadcrumb, .sidenav-overlay, .drag-target { display: none !important; }
        .app-content, .content-wrapper, .content-body { padding: 0 !important; display: block !important; width: 100% !important; overflow: visible !important; }
        .card { border: none !important; box-shadow: none !important; }
        .card-body { padding: 1rem !important; }
    }
    @@media screen {
        .print-only { display: none; }
    }
    .report-title { font-size: 1.25rem; font-weight: 600; }
    .report-meta { font-size: 0.9rem; color: #555; }
    .signature-line { margin-top: 2rem; border-top: 1px solid #333; padding-top: 0.5rem; font-size: 0.9rem; }
    #monthlyReportTable th, #monthlyReportTable td { vertical-align: middle; }
    #monthlyReportTable .total-row { font-weight: 700; background-color: #f8f9fa; }
</style>

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row no-print">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="breadcrumb-wrapper col-12">
                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                        <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                        <li class="breadcrumb-item"><a href="~/InventoryReports/Dashboard">@L.T("Wh_Reports")</a></li>
                        <li class="breadcrumb-item active">@L.T("Menu_MonthlyReport")</li>
                    </ol>
                </div>
            </div>
        </div>

        <div class="content-body">
            <div class="card no-print">
                <div class="card-header">
                    <h4 class="card-title mb-0">@L.T("Wh_Mr_TitleMrp")</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("MonthlyReport", "InventoryReports", FormMethod.Get, new { @class = "form" }))
                    {
                        <div class="row">
                            <div class="col-md-2">
                                <label>@L.T("Wh_Mr_ViewMode")</label>
                                <select name="viewMode" class="form-control">
                                    <option value="quantity" @(Model.ViewMode == "quantity" ? "selected" : "")>@L.T("Wh_Mr_ByQty")</option>
                                    <option value="amount" @(Model.ViewMode == "amount" ? "selected" : "")>@L.T("Wh_Mr_ByAmount")</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label>@L.T("Wh_Warehouse")</label>
                                @Html.DropDownList("warehouseId", Model.Warehouses, new { @class = "form-control" })
                            </div>
                            <div class="col-md-2">
                                <label>@L.T("Wh_Month")</label>
                                @Html.DropDownList("month", Enumerable.Range(1, 12).Select(i => new SelectListItem { Text = L.T("Month_" + i), Value = i.ToString(), Selected = i == Model.Month }), new { @class = "form-control" })
                            </div>
                            <div class="col-md-2">
                                <label>@L.T("Wh_Year")</label>
                                <input type="number" name="year" class="form-control" value="@Model.Year" min="2020" max="2030" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary">@L.T("Wh_Mr_ShowReport")</button>
                            </div>
                            <div class="col-md-2 d-flex align-items-end justify-content-end">
                                <button type="button" class="btn btn-outline-secondary" onclick="window.print();"><i class="bx bx-printer"></i> @L.T("Print")</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card" id="reportCard">
                <div class="card-body">
                    <div class="text-center mb-4">
                        @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
                        {
                            <p class="report-meta mb-0">@Model.CompanyName</p>
                        }
                        <h5 class="report-title mt-2">@L.T("Wh_Mr_TitleUpper")</h5>
                        <p class="report-meta mb-0">@L.T("Wh_MonthColon") <strong>@Model.PeriodTitleUz</strong> (@Model.PeriodTitle)</p>
                        <p class="report-meta mb-0">@L.T("Wh_WarehouseColon") <strong>@(Model.SelectedWarehouseName ?? "—")</strong></p>
                        <p class="report-meta mb-0">@L.T("Wh_Mr_DocDateColon") <strong>@Model.ReportDate</strong></p>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-sm" id="monthlyReportTable" style="width:100%">
                            <thead>
                                <tr class="table-primary">
                                    <th style="width:40px">№</th>
                                    <th>@L.T("Code")</th>
                                    <th>@L.T("Wh_Product")</th>
                                    @if (Model.ViewMode != "amount")
                                    {
                                        <th>@L.T("Unit")</th>
                                    }
                                    <th class="text-right">@L.T("Wh_Mr_Opening")</th>
                                    <th class="text-right">@L.T("Wh_Mr_ViaInventory")</th>
                                    <th class="text-right">@L.T("Wh_Income")</th>
                                    <th class="text-right">@L.T("Wh_Expense")</th>
                                    <th class="text-right">@L.T("Wh_Mr_Closing")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Rows != null && Model.Rows.Count > 0)
                                {
                                    var num = 1;
                                    var byAmount = Model.ViewMode == "amount";
                                    foreach (var row in Model.Rows)
                                    {
                                        <tr>
                                            <td>@(num++)</td>
                                            <td>@row.ProductCode</td>
                                            <td>@row.ProductName</td>
                                            @if (!byAmount)
                                            {
                                                <td>@row.UnitName</td>
                                            }
                                            @if (byAmount)
                                            {
                                                <td class="text-right">@row.OpeningBalanceSum.ToString("N2")</td>
                                                <td class="text-right">@getDecimal(row, "AdjustmentSum").ToString("N2")</td>
                                                <td class="text-right">@row.IncomeSum.ToString("N2")</td>
                                                <td class="text-right">@row.ExpenseSum.ToString("N2")</td>
                                                <td class="text-right">@row.ClosingBalanceSum.ToString("N2")</td>
                                            }
                                            else
                                            {
                                                <td class="text-right">@row.OpeningBalance.ToString("N2")</td>
                                                <td class="text-right">@getDecimal(row, "AdjustmentQty").ToString("N2")</td>
                                                <td class="text-right">@row.IncomeQty.ToString("N2")</td>
                                                <td class="text-right">@row.ExpenseQty.ToString("N2")</td>
                                                <td class="text-right">@row.ClosingBalance.ToString("N2")</td>
                                            }
                                        </tr>
                                    }
                                    if (Model.Totals != null)
                                    {
                                        <tr class="total-row">
                                            <td colspan="@(byAmount ? 3 : 4)" class="text-right"><strong>@L.T("Wh_TotalUpper")</strong></td>
                                            @if (byAmount)
                                            {
                                                <td class="text-right">@Model.Totals.TotalOpeningSum.ToString("N2")</td>
                                                <td class="text-right">@getDecimal(Model.Totals, "TotalAdjustmentSum").ToString("N2")</td>
                                                <td class="text-right">@Model.Totals.TotalIncomeSum.ToString("N2")</td>
                                                <td class="text-right">@Model.Totals.TotalExpenseSum.ToString("N2")</td>
                                                <td class="text-right">@Model.Totals.TotalClosingSum.ToString("N2")</td>
                                            }
                                            else
                                            {
                                                <td class="text-right">@Model.Totals.TotalOpening.ToString("N2")</td>
                                                <td class="text-right">@getDecimal(Model.Totals, "TotalAdjustment").ToString("N2")</td>
                                                <td class="text-right">@Model.Totals.TotalIncome.ToString("N2")</td>
                                                <td class="text-right">@Model.Totals.TotalExpense.ToString("N2")</td>
                                                <td class="text-right">@Model.Totals.TotalClosing.ToString("N2")</td>
                                            }
                                        </tr>
                                    }
                                }
                                else
                                {
                                    var emptyColspan = Model.ViewMode == "amount" ? 8 : 9;
                                    <tr>
                                        <td colspan="@emptyColspan" class="text-center">@L.T("Wh_Mr_Empty")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.ViewMode == "amount" && Model.Rows != null && Model.Rows.Count > 0)
                    {
                        <p class="report-meta small mb-0">@L.T("Wh_Mr_AmountsNote")</p>
                    }

                    <div class="signature-line no-print">
                        <p class="mb-0">@L.T("Wh_Mr_SignatureLine")</p>
                        <p class="mb-0 text-muted small">@L.T("Wh_Mr_SignatureHint")</p>
                    </div>
                    <div class="signature-line print-only">
                        <p class="mb-0">@L.T("Wh_Mr_SignatureLine")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
