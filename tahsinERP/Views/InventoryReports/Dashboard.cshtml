@model tahsinERP.ViewModels.InventoryDashboardViewModel
@using System.Linq
@{
    ViewBag.Title = L.T("Wh_Db_Title");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller action'ida tekshiriladi (SRM-M05). *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Wh_Reports")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <!-- Filters -->
                    <div class="users-list-filter px-1">
                        @using (Html.BeginForm("Dashboard", "InventoryReports", FormMethod.Get, new { @class = "form" }))
                        {
                            <div class="row border rounded py-2 mb-2">
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>@L.T("Wh_Warehouse")</label>
                                    @Html.DropDownList("warehouseId", ViewBag.Warehouses as SelectList, L.T("All"), new { @class = "form-control" })
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>@L.T("Category")</label>
                                    @Html.DropDownList("categoryId", ViewBag.Categories as SelectList, L.T("All"), new { @class = "form-control" })
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>@L.T("Wh_From")</label>
                                    <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>@L.T("Wh_To")</label>
                                    <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>@L.T("Wh_Db_RunnerWindow")</label>
                                    <select name="runnerDays" class="form-control">
                                        <option value="30" @(ViewBag.RunnerDays == 30 ? "selected" : "")>30</option>
                                        <option value="60" @(ViewBag.RunnerDays == 60 ? "selected" : "")>60</option>
                                        <option value="90" @(ViewBag.RunnerDays == 90 ? "selected" : "")>90</option>
                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Top-N</label>
                                    <input type="number" name="runnerTopN" class="form-control" min="1" max="50" value="@(ViewBag.RunnerTopN ?? 10)" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>FIFO scope</label>
                                    <select name="fifoScope" class="form-control">
                                        <option value="all" @(ViewBag.FifoScope == "all" ? "selected" : "")>@L.T("Wh_Db_ScopeAll")</option>
                                        <option value="selected" @(ViewBag.FifoScope == "selected" ? "selected" : "")>@L.T("Wh_Db_ScopeSelected")</option>
                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>@L.T("Wh_ProductType")</label>
                                    <select name="productType" class="form-control">
                                        <option value="">@L.T("All")</option>
                                        <option value="finished" @(ViewBag.ProductType == "finished" ? "selected" : "")>@L.T("Wh_FinishedGood")</option>
                                        <option value="raw" @(ViewBag.ProductType == "raw" ? "selected" : "")>@L.T("Wh_RawMaterialOne")</option>
                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bx bx-search"></i> @L.T("Search")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    @if (ViewBag.FifoScopeWarning != null)
                    {
                        <div class="alert alert-warning">
                            @ViewBag.FifoScopeWarning
                        </div>
                    }

                    <div class="row">
                        <!-- High DOH Items -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title text-warning">@L.T("Wh_Db_HighDoh")@if ((ViewBag.HighDohTotal as int? ?? 0) > Model.HighDOHItems.Count) {<small class="text-muted"> — @L.T("Wh_Db_TopOf", Model.HighDOHItems.Count, (object)ViewBag.HighDohTotal)</small>}</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>@L.T("Wh_Product")</th>
                                                        <th>@L.T("Wh_Warehouse")</th>
                                                        <th>@L.T("Wh_Balance")</th>
                                                        <th>Planned DOH</th>
                                                        <th>Actual DOH</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.HighDOHItems != null && Model.HighDOHItems.Any())
                                                    {
                                                        foreach (var item in Model.HighDOHItems)
                                                        {
                                                            <tr>
                                                                <td>@item.ProductPNo - @item.ProductName</td>
                                                                <td>@item.WarehouseName</td>
                                                                <td>@item.CurrentStock.ToString("N2") @item.UnitName</td>
                                                                <td><strong>@(item.PlannedDOH?.ToString("N1") ?? "-")</strong></td>
                                                                <td>@(item.ActualDOH?.ToString("N1") ?? "-")</td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="5" class="text-center">@L.T("Wh_NoDataFound")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Low DOH Items -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title text-danger">@L.T("Wh_Db_LowDoh")@if ((ViewBag.LowDohTotal as int? ?? 0) > Model.LowDOHItems.Count) {<small class="text-muted"> — @L.T("Wh_Db_BottomOf", Model.LowDOHItems.Count, (object)ViewBag.LowDohTotal)</small>}</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>@L.T("Wh_Product")</th>
                                                        <th>@L.T("Wh_Warehouse")</th>
                                                        <th>@L.T("Wh_Balance")</th>
                                                        <th>Planned DOH</th>
                                                        <th>Actual DOH</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.LowDOHItems != null && Model.LowDOHItems.Any())
                                                    {
                                                        foreach (var item in Model.LowDOHItems)
                                                        {
                                                            <tr>
                                                                <td>@item.ProductPNo - @item.ProductName</td>
                                                                <td>@item.WarehouseName</td>
                                                                <td>@item.CurrentStock.ToString("N2") @item.UnitName</td>
                                                                <td><strong class="text-danger">@(item.PlannedDOH?.ToString("N1") ?? "-")</strong></td>
                                                                <td>@(item.ActualDOH?.ToString("N1") ?? "-")</td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="5" class="text-center">@L.T("Wh_NoDataFound")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title text-success">@L.T("Wh_Db_HighRunner", (object)ViewBag.RunnerDays)</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>@L.T("Wh_Product")</th>
                                                        <th>@L.T("Wh_Warehouse")</th>
                                                        <th>@L.T("Wh_Balance")</th>
                                                        <th>Avg/day</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.HighRunnerItems != null && Model.HighRunnerItems.Any())
                                                    {
                                                        foreach (var item in Model.HighRunnerItems)
                                                        {
                                                            <tr>
                                                                <td>@item.ProductPNo - @item.ProductName</td>
                                                                <td>@item.WarehouseName</td>
                                                                <td>@item.CurrentStock.ToString("N2") @item.UnitName</td>
                                                                <td>@item.AverageDailyConsumption.ToString("N2")</td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="4" class="text-center">@L.T("Wh_NoDataFound")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title text-muted">@L.T("Wh_Db_LowRunner", (object)ViewBag.RunnerDays)</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>@L.T("Wh_Product")</th>
                                                        <th>@L.T("Wh_Warehouse")</th>
                                                        <th>@L.T("Wh_Balance")</th>
                                                        <th>Avg/day</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.LowRunnerItems != null && Model.LowRunnerItems.Any())
                                                    {
                                                        foreach (var item in Model.LowRunnerItems)
                                                        {
                                                            <tr>
                                                                <td>@item.ProductPNo - @item.ProductName</td>
                                                                <td>@item.WarehouseName</td>
                                                                <td>@item.CurrentStock.ToString("N2") @item.UnitName</td>
                                                                <td>@item.AverageDailyConsumption.ToString("N2")</td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="4" class="text-center">@L.T("Wh_NoDataFound")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.FifoHeuristicAlerts != null && Model.FifoHeuristicAlerts.Any())
                    {
                        <div class="row mt-2">
                            <div class="col-12">
                                <div class="card border-warning">
                                    <div class="card-header bg-light">
                                        <h4 class="card-title text-warning mb-0"><i class="bx bx-error"></i> @L.T("Wh_Db_FifoAlerts")</h4>
                                        <small class="text-muted">@L.T("Wh_Db_FifoAlertsHint")</small>
                                    </div>
                                    <div class="card-content">
                                        <div class="card-body">
                                            <div class="table-responsive">
                                                <table id="fifoHeuristicTable" class="table table-striped table-bordered" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>@L.T("Wh_Product")</th>
                                                            <th>@L.T("Wh_Warehouse")</th>
                                                            <th>@L.T("Wh_Db_OldestIncome")</th>
                                                            <th>@L.T("Wh_Db_LatestExpense")</th>
                                                            <th>@L.T("Wh_Db_OldBatchRemaining")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in Model.FifoHeuristicAlerts)
                                                        {
                                                            <tr>
                                                                <td>@item.ProductPNo — @item.ProductName</td>
                                                                <td>@item.WarehouseName</td>
                                                                <td>@item.OldestIncomeDate.ToString("dd.MM.yyyy")</td>
                                                                <td>@item.LatestExpenseDate.ToString("dd.MM.yyyy")</td>
                                                                <td>@item.RemainingFromOldest.ToString("N2")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row mt-2">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title text-warning mb-0"><i class="bx bx-grid-alt"></i> DLOC MIN / MAX</h4>
                                    @if (Model.DlocBelowMinCount > 0 || Model.DlocNearMaxCount > 0)
                                    {
                                        <p class="small mb-0 mt-1">
                                            <span class="badge badge-warning">@L.T("Wh_Db_BelowMinCount", Model.DlocBelowMinCount)</span>
                                            <span class="badge badge-danger ml-1">@L.T("Wh_Db_NearMaxCount", Model.DlocNearMaxCount)</span>
                                        </p>
                                    }
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table id="dlocMinMaxTable" class="table table-striped table-bordered" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>@L.T("Wh_Warehouse")</th>
                                                        <th>DLOC</th>
                                                        <th>@L.T("Wh_CurrentStock")</th>
                                                        <th>Min</th>
                                                        <th>Max</th>
                                                        <th>@L.T("Wh_Dl_CapacityPct")</th>
                                                        <th>@L.T("Status")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.DlocAlerts != null && Model.DlocAlerts.Any())
                                                    {
                                                        foreach (var a in Model.DlocAlerts.OrderBy(x => x.WarehouseName).ThenBy(x => x.LocationCode))
                                                        {
                                                            var fillPct = a.MaxCapacity > 0 ? (double)(a.CurrentQty / a.MaxCapacity * 100m) : 0;
                                                            var rowClass = a.AlertType == "BELOW_MIN" ? "table-warning" : "table-danger";
                                                            <tr class="@rowClass">
                                                                <td>@a.WarehouseName</td>
                                                                <td><strong>@a.LocationCode</strong></td>
                                                                <td>@a.CurrentQty.ToString("N2")</td>
                                                                <td>@a.MinCapacity.ToString("N2")</td>
                                                                <td>@a.MaxCapacity.ToString("N2")</td>
                                                                <td>@(a.MaxCapacity > 0 ? fillPct.ToString("N0") + "%" : "—")</td>
                                                                <td>
                                                                    @if (a.AlertType == "BELOW_MIN") { <span class="badge badge-warning">@L.T("Wh_Db_BelowMin")</span> }
                                                                    else if (a.AlertType == "NEAR_MAX") { <span class="badge badge-danger">@L.T("Wh_Db_NearMax")</span> }
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr><td colspan="7" class="text-center text-muted">@L.T("Wh_Db_NoMinMaxViolations")</td></tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <!-- Stock Distribution by Category -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">@L.T("Wh_Db_StockByCategory")</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <canvas id="categoryChart" height="300"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Inbound/Outbound Trends -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">@L.T("Wh_Db_InOutTrend")</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <canvas id="trendChart" height="300"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Full Stock Table -->
                    <div class="row mt-2">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">@L.T("Wh_Db_AllProductsDoh")</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table id="dohTable" class="table zero-configuration dt-responsive nowrap" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>@L.T("Wh_ProductCode")</th>
                                                        <th>@L.T("Wh_ProductName")</th>
                                                        <th>@L.T("Category")</th>
                                                        <th>@L.T("Wh_Warehouse")</th>
                                                        <th>@L.T("Wh_CurrentStock")</th>
                                                        <th>Planned avg/day</th>
                                                        <th>Actual avg/day</th>
                                                        <th>Planned DOH</th>
                                                        <th>Actual DOH</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.StockItems != null && Model.StockItems.Any())
                                                    {
                                                        foreach (var item in Model.StockItems)
                                                        {
                                                            <tr>
                                                                <td>@item.ProductPNo</td>
                                                                <td>@item.ProductName</td>
                                                                <td>@item.CategoryName</td>
                                                                <td>@item.WarehouseName</td>
                                                                <td>@item.CurrentStock.ToString("N2") @item.UnitName</td>
                                                                <td>@item.PlannedAverageDailyConsumption.ToString("N2") @item.UnitName</td>
                                                                <td>@item.AverageDailyConsumption.ToString("N2") @item.UnitName</td>
                                                                <td>
                                                                    @if (item.PlannedDOH.HasValue)
                                                                    {
                                                                        if (item.PlannedDOH.Value < 30)
                                                                        {
                                                                            <span class="badge badge-danger">@item.PlannedDOH.Value.ToString("N1")</span>
                                                                        }
                                                                        else if (item.PlannedDOH.Value > 60)
                                                                        {
                                                                            <span class="badge badge-warning">@item.PlannedDOH.Value.ToString("N1")</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge badge-success">@item.PlannedDOH.Value.ToString("N1")</span>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted">-</span>
                                                                    }
                                                                </td>
                                                                <td>@(item.ActualDOH?.ToString("N1") ?? "-")</td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @* jQuery va DataTables _Layout'da (sahifa oxirida) yuklanadi — bu yerda qayta yuklash pluginlarni buzardi (SRM-P19).
       Skript DOMContentLoaded'da ishlaydi: o'sha paytda layout skriptlari allaqachon bajarilgan bo'ladi. *@
    <!-- Chart.js (versiya qotirilgan: "latest" yangi major chiqqanda dashboardni jimgina buzishi mumkin edi) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var $ = window.jQuery;
            // Initialize DataTable
            $('#dohTable').DataTable({
                "pageLength": 25,
                "order": [[7, "desc"]]
            });

            var dtLang = erpDataTable.language;
            if ($('#fifoHeuristicTable').length) {
                $('#fifoHeuristicTable').DataTable({ language: dtLang, pageLength: 25, order: [[2, 'desc']] });
            }
            if ($('#dlocMinMaxTable').length) {
                $('#dlocMinMaxTable').DataTable({ language: dtLang, pageLength: 25, order: [[0, 'asc'], [1, 'asc']] });
            }

            // Category Distribution Chart
            var categoryCtx = document.getElementById('categoryChart').getContext('2d');
            var categoryData = @Html.Raw(Json.Encode(Model.StockByCategory.Select(c => new { CategoryName = c.CategoryName, TotalStock = c.TotalStock })));

            new Chart(categoryCtx, {
                type: 'doughnut',
                data: {
                    labels: categoryData.map(c => c.CategoryName),
                    datasets: [{
                        data: categoryData.map(c => c.TotalStock),
                        backgroundColor: [
                            'rgba(115, 103, 240, 0.8)',
                            'rgba(40, 199, 111, 0.8)',
                            'rgba(255, 159, 64, 0.8)',
                            'rgba(234, 84, 85, 0.8)',
                            'rgba(0, 207, 232, 0.8)',
                            'rgba(255, 99, 132, 0.8)'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });

            // Trend Chart
            var trendCtx = document.getElementById('trendChart').getContext('2d');
            var inboundData = @Html.Raw(Json.Encode(Model.InboundTrends.Select(t => new { Date = t.Date.ToString("yyyy-MM-dd"), Amount = t.Amount })));
            var outboundData = @Html.Raw(Json.Encode(Model.OutboundTrends.Select(t => new { Date = t.Date.ToString("yyyy-MM-dd"), Amount = t.Amount })));

            // Group by date
            var dates = [...new Set([...inboundData.map(d => d.Date), ...outboundData.map(d => d.Date)])].sort();
            var inboundAmounts = dates.map(date => {
                var item = inboundData.find(d => d.Date === date);
                return item ? item.Amount : 0;
            });
            var outboundAmounts = dates.map(date => {
                var item = outboundData.find(d => d.Date === date);
                return item ? item.Amount : 0;
            });

            new Chart(trendCtx, {
                type: 'line',
                data: {
                    labels: dates,
                    datasets: [
                        {
                            label: '@L.Js("Wh_Income")',
                            data: inboundAmounts,
                            borderColor: 'rgba(40, 199, 111, 1)',
                            backgroundColor: 'rgba(40, 199, 111, 0.2)',
                            tension: 0.4
                        },
                        {
                            label: '@L.Js("Wh_Expense")',
                            data: outboundAmounts,
                            borderColor: 'rgba(234, 84, 85, 1)',
                            backgroundColor: 'rgba(234, 84, 85, 0.2)',
                            tension: 0.4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        });
    </script>
}
