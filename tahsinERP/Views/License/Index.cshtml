@model tahsinERP.ViewModels.LicenseIndexViewModel
@{
    ViewBag.Title = L.T("Hdr_License");
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var maxExpiry = Model.ExpiryDate.HasValue ? Model.ExpiryDate.Value.ToString("yyyy-MM-dd") : today;
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                            <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                            <li class="breadcrumb-item active">@L.T("Hdr_License")</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <!-- ==== HOLAT ==== -->
            <div class="row">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">@L.T("Core_LicCompanyStatus")</h4>
                        </div>
                        <div class="card-body">
                            @if (!Model.HasLicense)
                            {
                                <div class="alert alert-warning mb-0">@Model.StatusMessage</div>
                            }
                            else if (!Model.SignatureValid)
                            {
                                <div class="alert alert-danger mb-0"><b>@L.T("Core_LicInvalidKey")</b> @Model.StatusMessage</div>
                            }
                            else
                            {
                                if (!Model.IsValid || Model.ExpiringSoon)
                                {
                                    <div class="alert @(Model.IsValid || Model.InGrace ? "alert-warning" : "alert-danger")">@Model.StatusMessage</div>
                                }
                                <div class="row">
                                    <div class="col-md-4 mb-1">
                                        <small class="text-muted">@L.T("Status")</small><br />
                                        @if (Model.IsValid)
                                        {
                                            <span class="badge @(Model.ExpiringSoon ? "badge-warning" : "badge-success")">@L.T("Active")</span>
                                        }
                                        else if (Model.WrongInstallation)
                                        {
                                            <span class="badge badge-danger">@L.T("Core_LicOtherInstallation")</span>
                                        }
                                        else if (Model.ClockProblem != null)
                                        {
                                            <span class="badge badge-danger">@L.T("Core_LicBlockedClock")</span>
                                        }
                                        else if (Model.InGrace)
                                        {
                                            <span class="badge badge-warning">@L.T("Core_LicReadOnly")</span>
                                        }
                                        else if (Model.IsExpired)
                                        {
                                            <span class="badge badge-danger">@L.T("Core_LicExpired")</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">@L.T("Core_LicNotStarted")</span>
                                        }
                                    </div>
                                    <div class="col-md-4 mb-1">
                                        <small class="text-muted">@L.T("Core_LicPlan")</small><br /><b>@Model.Edition</b>
                                    </div>
                                    <div class="col-md-4 mb-1">
                                        <small class="text-muted">@L.T("Core_LicDaysLeft")</small><br />
                                        <b class="@(Model.DaysRemaining <= 15 ? "text-danger" : "")">@L.T("Core_DaysValue", Model.DaysRemaining)</b>
                                    </div>
                                    <div class="col-md-4 mb-1">
                                        <small class="text-muted">@L.T("Core_LicStart")</small><br />@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd.MM.yyyy") : "-")
                                    </div>
                                    <div class="col-md-4 mb-1">
                                        <small class="text-muted">@L.T("Core_LicEnd")</small><br />@(Model.ExpiryDate.HasValue ? Model.ExpiryDate.Value.ToString("dd.MM.yyyy") : "-")
                                    </div>
                                    <div class="col-md-4 mb-1">
                                        <small class="text-muted">@L.T("Core_LicSeatsUsedTotal")</small><br />
                                        <b>@Model.UsedSeats / @(Model.Unlimited ? "∞" : Model.MaxUsers.ToString())</b>
                                    </div>
                                    @if (Model.InGrace && Model.GraceUntil.HasValue)
                                    {
                                        <div class="col-md-4 mb-1">
                                            <small class="text-muted">@L.T("Core_LicReadOnlyMode")</small><br /><b class="text-danger">@L.T("Core_LicUntilDate", Model.GraceUntil.Value.ToString("dd.MM.yyyy"))</b>
                                        </div>
                                    }
                                    <div class="col-md-4 mb-1">
                                        <small class="text-muted">@L.T("Core_LicKeyFormat")</small><br />
                                        @if (Model.KeyVersion >= 2)
                                        {
                                            <span>@("v" + Model.KeyVersion) @L.T("Core_LicBoundToInstallation")</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning">v1 @L.T("Core_LicOldFormat")</span>
                                        }
                                    </div>
                                </div>
                            }

                            @if (Model.ClockProblem != null)
                            {
                                <div class="alert alert-danger mt-1 mb-0">
                                    <b>@L.T("Core_LicClockControl")</b> @Model.ClockProblem
                                </div>
                            }

                            <hr />
                            <small class="text-muted">@L.T("Core_LicInstallationIdHint")</small>
                            <div class="input-group input-group-sm mt-25">
                                <input type="text" id="installationId" class="form-control" readonly value="@Model.InstallationId" style="font-family:monospace;" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-outline-primary" onclick="var t=document.getElementById('installationId');t.select();try{navigator.clipboard.writeText(t.value);}catch(e){document.execCommand('copy');}this.innerText='@L.Js("Core_Copied")';">@L.T("Core_Copy")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ==== KALIT KIRITISH ==== -->
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header"><h4 class="card-title">@L.T("Core_LicActivateKey")</h4></div>
                        <div class="card-body">
                            @using (Html.BeginForm("Activate", "License", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <div class="form-group">
                                    <textarea name="licenseKey" class="form-control" rows="4" placeholder="@L.T("Core_LicPasteKey")" style="font-family:monospace;font-size:12px;"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary btn-block">@L.T("Core_LicActivate")</button>
                            }
                        </div>
                    </div>

                    <!-- ==== MARKAZIY PANEL ==== -->
                    @if (Model.PanelEnabled)
                    {
                        <div class="card">
                            <div class="card-header"><h4 class="card-title">@L.T("Core_LicCentralPanel")</h4></div>
                            <div class="card-body">
                                @if (Model.PanelConnected)
                                {
                                    <p class="mb-50"><span class="badge badge-success">@L.T("Core_LicConnected")</span> @L.T("Core_LicAutoRenew")</p>
                                }
                                else
                                {
                                    <p class="mb-50"><span class="badge badge-secondary">@L.T("Core_LicNotConnected")</span></p>
                                    using (Html.BeginForm("ConnectPanel", "License", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <div class="form-group mb-50">
                                            <input type="text" name="regToken" class="form-control" autocomplete="off" maxlength="200"
                                                   placeholder="@(Model.HasRegToken ? L.T("Core_LicTokenSaved") : L.T("Core_LicRegToken"))" style="font-family:monospace;" />
                                        </div>
                                        <button type="submit" class="btn btn-outline-primary btn-block">@L.T("Core_LicConnectPanel")</button>
                                    }
                                }
                                @using (Html.BeginForm("SyncNow", "License", FormMethod.Post, new { @class = "mt-50" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary btn-block">@L.T("Core_LicCheckNow")</button>
                                }
                                @if (Model.LastSyncUtc.HasValue)
                                {
                                    <small class="text-muted d-block mt-50">
                                        @L.T("Core_LicLastCheck") @Model.LastSyncUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")<br />@Model.LastSyncResult
                                    </small>
                                }
                                @if (Model.PanelConnected)
                                {
                                    <small class="text-muted d-block mt-50">
                                        @L.T("Core_LicOnlineCheck") @(Model.OnlineCheckRequired
                                            ? L.T("Core_LicOnlineRequired", Model.OfflineGraceDays ?? 30)
                                            : L.T("Core_LicOnlineOptional"))
                                    </small>
                                }
                                @if (!string.IsNullOrEmpty(Model.OnlineWarning))
                                {
                                    <div class="alert alert-warning mt-50 mb-0">@Model.OnlineWarning</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ==== SEAT (XODIMLAR) ==== -->
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">@L.T("Core_LicSeatManagement")</h4>
                    <span class="badge badge-light">@Model.UsedSeats / @(Model.Unlimited ? "∞" : Model.MaxUsers.ToString()) @L.T("Core_LicBusy")</span>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>@L.T("Core_Employee")</th>
                                    <th>@L.T("Username")</th>
                                    <th>@L.T("Core_LicSeat")</th>
                                    <th>@L.T("Core_LicTerm")</th>
                                    <th style="width:320px;">@L.T("Actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.Users)
                                {
                                    <tr>
                                        <td>@u.FullName</td>
                                        <td>@u.Uname</td>
                                        <td>
                                            @if (u.HasSeat && !u.SeatExpired)
                                            {
                                                <span class="badge badge-success">@L.T("Active")</span>
                                            }
                                            else if (u.HasSeat && u.SeatExpired)
                                            {
                                                <span class="badge badge-danger">@L.T("Core_LicSeatEnded")</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">@L.T("No")</span>
                                            }
                                        </td>
                                        <td>@(u.SeatExpiry.HasValue ? u.SeatExpiry.Value.ToString("dd.MM.yyyy") : "-")</td>
                                        <td>
                                            @if (!u.HasSeat)
                                            {
                                                using (Html.BeginForm("AssignSeat", "License", FormMethod.Post, new { @class = "form-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@u.UserID" />
                                                    <input type="date" name="expiryDate" class="form-control form-control-sm mr-1" value="@maxExpiry" max="@maxExpiry" />
                                                    <button type="submit" class="btn btn-sm btn-success">@L.T("Core_LicAssignSeat")</button>
                                                }
                                            }
                                            else
                                            {
                                                using (Html.BeginForm("ExtendSeat", "License", FormMethod.Post, new { @class = "form-inline d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userLicenseId" value="@u.UserLicenseID" />
                                                    <input type="date" name="newExpiry" class="form-control form-control-sm mr-1" value="@maxExpiry" max="@maxExpiry" />
                                                    <button type="submit" class="btn btn-sm btn-primary">@L.T("Core_LicExtend")</button>
                                                }
                                                using (Html.BeginForm("RevokeSeat", "License", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('" + HttpUtility.JavaScriptStringEncode(L.T("Core_LicConfirmRevoke")) + "');" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userLicenseId" value="@u.UserLicenseID" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L.T("Core_LicRevoke")</button>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ==== TARIX ==== -->
            <div class="card">
                <div class="card-header"><h4 class="card-title">@L.T("Core_LicHistory")</h4></div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr><th>#</th><th>Max</th><th>@L.T("Core_LicStart")</th><th>@L.T("Core_LicEnd")</th><th>@L.T("Core_LicPlan")</th><th>@L.T("Active")</th><th>@L.T("CreatedAt")</th><th>@L.T("Core_Who")</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model.History)
                                {
                                    <tr>
                                        <td>@h.ID</td>
                                        <td>@(h.MaxUsers == 0 ? "∞" : h.MaxUsers.ToString())</td>
                                        <td>@(h.StartDate.HasValue ? h.StartDate.Value.ToString("dd.MM.yyyy") : "-")</td>
                                        <td>@(h.ExpiryDate.HasValue ? h.ExpiryDate.Value.ToString("dd.MM.yyyy") : "-")</td>
                                        <td>@h.Edition</td>
                                        <td>@(h.IsActive ? "✅" : "")</td>
                                        <td>@h.CreatedAt.ToString("dd.MM.yyyy")</td>
                                        <td>@h.CreatedBy</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
