@{
    ViewBag.Title = "Paketingizda yo'q";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool canManage = ViewBag.CanManage != null && (bool)ViewBag.CanManage;
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-body">
            <div class="row justify-content-center mt-3">
                <div class="col-md-7">
                    <div class="card">
                        <div class="card-body text-center">
                            <i class="bx bx-package" style="font-size:64px;color:#ff9f43;"></i>
                            <h3 class="mt-1">Paketingizda yo'q — tarifni oshiring</h3>
                            <p class="text-muted mb-50">
                                <b>@ViewBag.ModuleName</b> moduli joriy <b>@ViewBag.EditionName</b> paketiga kirmaydi.
                            </p>
                            @if (ViewBag.IsAddOn == true)
                            {
                                <p class="text-muted">Bu modul paketlarga kirmaydi — alohida xizmat sifatida ulanadi.</p>
                            }
                            else
                            {
                                <p class="text-muted">Bu modul <b>@ViewBag.RequiredEdition</b> paketidan boshlab mavjud.</p>
                            }
                            @if (canManage)
                            {
                                <a href="@Url.Action("Index", "License")" class="btn btn-primary">Litsenziya va tarif</a>
                            }
                            else
                            {
                                <p><small class="text-muted">Tarifni oshirish uchun administratoringizga murojaat qiling.</small></p>
                            }
                            <a href="~/Home" class="btn btn-outline-secondary ml-50">Bosh sahifa</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
