@using tahsinERP.Services.Documents
@model List<DocTemplateListItem>
@{
    ViewBag.Title = L.T("Doc_DocTemplates");
    Layout = "~/Views/Shared/_Layout.cshtml";
    string docType = ViewBag.DocType;
    bool canChange = ViewBag.CanChange == true;
    var docTypes = (List<string>)ViewBag.DocTypes;
    var placeholders = (IReadOnlyList<PlaceholderInfo>)ViewBag.Placeholders;
    string backController = DocPlaceholders.OwnerController(docType);
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", backController)">@DocPlaceholders.TypeDisplayName(docType)</a></li>
                                <li class="breadcrumb-item active">@L.T("Doc_Templates")</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    @TempData["Warning"]
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
            }

            <ul class="nav nav-tabs mb-1">
                @foreach (var t in docTypes)
                {
                    <li class="nav-item">
                        <a class="nav-link @(t == docType ? "active" : "")" href="@Url.Action("Index", new { docType = t })">@DocPlaceholders.TypeDisplayName(t)</a>
                    </li>
                }
            </ul>

            <div class="row">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">@L.T("Doc_TypeTemplates", DocPlaceholders.TypeDisplayName(docType))</h4>
                        </div>
                        <div class="card-content">
                            <div class="card-body">
                                @if (!Model.Any())
                                {
                                    <div class="alert alert-info">
                                        @L.T("Doc_NoTemplateYet1") <a href="@Url.Action("Sample", new { docType })">@L.T("Doc_NoTemplateYetLink")</a> @L.T("Doc_NoTemplateYet2")
                                    </div>
                                    if (ViewBag.CanImportLegacy == true && canChange)
                                    {
                                        <a href="#" class="btn btn-outline-primary mb-1" data-post-url="@Url.Action("ImportLegacy")"
                                           data-confirm="@L.T("Doc_ConfirmMigrateTemplate")">
                                            <i class="bx bx-import"></i> @L.T("Doc_MigrateLegacyTemplate")
                                        </a>
                                    }
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Code")</th>
                                                    <th>@L.T("Name")</th>
                                                    <th>@L.T("Doc_File")</th>
                                                    <th>@L.T("Doc_Uploaded")</th>
                                                    <th>@L.T("Menu_Documents")</th>
                                                    <th>@L.T("Status")</th>
                                                    <th class="text-center">@L.T("Actions")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var t in Model)
                                                {
                                                    <tr class="@(t.IsActive ? "" : "text-muted")">
                                                        <td>@t.TemplateCode</td>
                                                        <td>@t.Name</td>
                                                        <td>@t.FileName</td>
                                                        <td>@t.CreatedDT.ToString("dd.MM.yyyy HH:mm")</td>
                                                        <td>@t.UsageCount</td>
                                                        <td>
                                                            <span class="badge @(t.IsActive ? "badge-success" : "badge-secondary")">@(t.IsActive ? "Faol" : "Arxivda")</span>
                                                        </td>
                                                        <td class="text-center text-nowrap">
                                                            <a href="@Url.Action("Download", new { id = t.ID })" class="btn btn-sm btn-outline-primary" title="@L.T("Download")"><i class="bx bx-download"></i></a>
                                                            @if (canChange)
                                                            {
                                                                <a href="#" class="btn btn-sm btn-outline-warning" title="@(t.IsActive ? "Arxivlash" : "Faollashtirish")"
                                                                   data-post-url="@Url.Action("ToggleActive", new { id = t.ID })"><i class="bx @(t.IsActive ? "bx-archive-in" : "bx-archive-out")"></i></a>
                                                                if (t.UsageCount == 0)
                                                                {
                                                                    <a href="#" class="btn btn-sm btn-outline-danger" title="@L.T("Delete")"
                                                                       data-post-url="@Url.Action("Delete", new { id = t.ID })" data-confirm="@L.T("Doc_ConfirmDeleteTemplate")"><i class="bx bx-trash"></i></a>
                                                                }
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <small class="text-muted">@L.T("Doc_TemplatesActiveHint")</small>
                                }
                            </div>
                        </div>
                    </div>

                    @if (placeholders.Any())
                    {
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Doc_TemplateFields")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <p>
                                        @Html.Raw(L.T("Doc_FieldsHelp1"))
                                        <code>@placeholders[0].Token</code>. @L.T("Doc_FieldsHelp2")
                                        @Html.Raw(L.T("Doc_FieldsHelp3"))
                                    </p>
                                    <table class="table table-sm table-striped">
                                        <thead><tr><th>@L.T("Doc_FieldCol")</th><th>@L.T("Doc_MeaningCol")</th><th>@L.T("Type")</th></tr></thead>
                                        <tbody>
                                            @foreach (var p in placeholders)
                                            {
                                                <tr>
                                                    <td><code>@p.Token</code></td>
                                                    <td>@p.Description</td>
                                                    <td>@(p.Kind == PlaceholderKind.RichText ? L.T("Doc_RichText") : p.Kind == PlaceholderKind.Table ? L.T("Doc_Table") : L.T("Doc_Text"))</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-lg-4">
                    @if (canChange)
                    {
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Doc_UploadNewTemplate")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Upload", "DocTemplates", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="docType" value="@docType" />
                                        <div class="form-group">
                                            <label>@L.T("Name")</label>
                                            <input type="text" name="name" class="form-control" maxlength="200" placeholder="Masalan: Asosiy blanka" />
                                        </div>
                                        <div class="form-group">
                                            <label>@L.T("Doc_WordFileDocx")</label>
                                            <input type="file" name="file" class="form-control-file" accept=".docx" required />
                                        </div>
                                        <div class="form-group form-check">
                                            <input type="checkbox" name="archiveOthers" value="true" class="form-check-input" id="archiveOthers" />
                                            <label class="form-check-label" for="archiveOthers">@L.T("Doc_ArchiveOtherActive")</label>
                                        </div>
                                        <button type="submit" class="btn btn-primary"><i class="bx bx-upload"></i> @L.T("Upload")</button>
                                    }
                                    <hr />
                                    <p class="mb-0">@L.T("Doc_UploadCheckHint")</p>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <a href="@Url.Action("Sample", new { docType })" class="btn btn-outline-success btn-block">
                                    <i class="bx bx-file"></i> @L.T("Doc_DownloadSample")
                                </a>
                                <small class="text-muted d-block mt-1">@L.T("Doc_SampleHint")</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
