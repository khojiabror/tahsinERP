@{
    ViewBag.Title = L.T("Log_LoadSimTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        @L.T("Menu_Logistics")
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Log_LoadSimTitle")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <div class="row">
                        <!-- Selection Panel -->
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">@L.T("Log_LoadParams")</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-5 col-sm-12 form-group">
                                                <label>@L.T("Log_Product")</label>
                                                <select id="productSelect" class="form-control" data-search-url="@Url.Action("SearchProducts", "TransportLoadSimulation")"></select>
                                            </div>
                                            <div class="col-md-5 col-sm-12 form-group">
                                                <label>@L.T("Log_TransportType")</label>
                                                <select id="transportSelect" class="form-control select2">
                                                    <option value="">---@L.T("Select")---</option>
                                                    @if (ViewBag.TransportTypes != null)
                                                    {
                                                        foreach (var transport in ViewBag.TransportTypes)
                                                        {
                                                            <option value="@transport.ID">
                                                                @transport.TransportType
                                                            </option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-2 col-sm-12 form-group d-flex align-items-end">
                                                <button type="button" id="simulateBtn" class="btn btn-primary btn-block">
                                                    <i class="bx bx-calculator"></i> @L.T("Log_Simulate")
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Results Panel -->
                        <div class="col-12" id="resultsPanel" style="display: none;">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">@L.T("Log_Results")</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="row">
                                            <!-- Product Info -->
                                            <div class="col-md-6 col-sm-12">
                                                <div class="card border-primary">
                                                    <div class="card-header bg-primary text-white">
                                                        <h5>@L.T("Log_ProductInfo")</h5>
                                                    </div>
                                                    <div class="card-body">
                                                        <p><strong>@L.T("Log_NameColon")</strong> <span id="productName"></span></p>
                                                        <p><strong>PNo:</strong> <span id="productPNo"></span></p>
                                                        <p><strong>@L.T("Log_DimensionsColon")</strong> 
                                                            <span id="productDimensions"></span> mm
                                                        </p>
                                                        <p><strong>@L.T("Log_VolumeColon")</strong> 
                                                            <span id="productVolume"></span> m³
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Transport Info -->
                                            <div class="col-md-6 col-sm-12">
                                                <div class="card border-info">
                                                    <div class="card-header bg-info text-white">
                                                        <h5>@L.T("Log_TransportInfo")</h5>
                                                    </div>
                                                    <div class="card-body">
                                                        <p><strong>@L.T("Log_NameColon")</strong> <span id="transportName"></span></p>
                                                        <p><strong>@L.T("Log_InnerDimensionsColon")</strong> 
                                                            <span id="transportDimensions"></span> mm
                                                        </p>
                                                        <p><strong>@L.T("Log_VolumeColon")</strong> 
                                                            <span id="transportVolume"></span> m³
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <hr />

                                        <!-- Calculation Results -->
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="card border-success">
                                                    <div class="card-header bg-success text-white">
                                                        <h5>@L.T("Log_CalcResults")</h5>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="row">
                                                            <div class="col-md-3 col-sm-6">
                                                                <p><strong>@L.T("Log_MaxQuantityColon")</strong></p>
                                                                <h3 class="text-primary" id="maxQuantity">0</h3>
                                                            </div>
                                                            <div class="col-md-3 col-sm-6">
                                                                <p><strong>@L.T("Log_BestOrientationColon")</strong></p>
                                                                <h4 class="text-info" id="bestOrientation">-</h4>
                                                            </div>
                                                            <div class="col-md-3 col-sm-6">
                                                                <p><strong>@L.T("Log_TotalVolumeColon")</strong></p>
                                                                <h4 class="text-success" id="totalCbm">0.000</h4>
                                                                <small>m³</small>
                                                            </div>
                                                            <div class="col-md-3 col-sm-6">
                                                                <p><strong>@L.T("Log_UtilizationColon")</strong></p>
                                                                <h4 id="utilizationPercent" class="utilization-badge">0.00%</h4>
                                                            </div>
                                                        </div>
                                                        <div class="row mt-2">
                                                            <div class="col-12">
                                                                <p><strong>@L.T("Log_LayoutColon")</strong> 
                                                                    <span id="layoutInfo"></span>
                                                                </p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- 3D Visualization -->
                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <div class="card">
                                                    <div class="card-header">
                                                        <h5>@L.T("Log_3dView")</h5>
                                                        <div class="card-header-actions">
                                                            <button type="button" id="toggleOrientationBtn" class="btn btn-sm btn-outline-secondary">
                                                                <i class="bx bx-refresh"></i> @L.T("Log_ShowAltOrientation")
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div class="card-body">
                                                        <div id="visualizationContainer" style="width: 100%; height: 600px; position: relative; border: 1px solid #ddd; background: #f5f5f5;">
                                                            <div id="threejsContainer" style="width: 100%; height: 100%;"></div>
                                                            <div id="loadingIndicator" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); display: none;">
                                                                <div class="spinner-border text-primary" role="status">
                                                                    <span class="sr-only">@L.T("Loading")</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mt-2">
                                                            <small class="text-muted">
                                                                <i class="bx bx-info-circle"></i> 
                                                                @L.T("Log_3dHint")
                                                            </small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <style>
        .utilization-badge {
            font-weight: bold;
        }
        #threejsContainer {
            border-radius: 4px;
        }
    </style>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@section scripts {
    <!-- Three.js (OrbitControls ishlatilmasdi — olib tashlandi, LOG-P15) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        (function ($) {
            'use strict';

            var calculateApiUrl = '@Url.Action("Calculate", "TransportLoadApi")';
            var scene, camera, renderer, controls, frameId = null;
            var sceneObjects = [];
            var currentData = null;
            var showingAlternative = false;

            function performSimulation(productId, transportId) {
                $('#loadingIndicator').show();
                $('#resultsPanel').hide();

                $.ajax({ url: calculateApiUrl, type: 'GET', data: { productId: productId, transportId: transportId } })
                    .done(function (response) {
                        $('#loadingIndicator').hide();
                        if (response && response.success) {
                            currentData = response.data;
                            showingAlternative = false;
                            displayResults(response.data);
                            $('#resultsPanel').show();
                            ensureThreeJS();
                            renderVisualization(response.data, false);
                        } else {
                            alert('@L.Js("Log_ErrorPrefix") ' + (response && response.error ? response.error : '@L.Js("Log_UnknownError")'));
                        }
                    })
                    .fail(function () {
                        $('#loadingIndicator').hide();
                        alert('@L.Js("Log_CalcError")');
                    });
            }

            function displayResults(data) {
                $('#productName').text(data.ProductName || '-');
                $('#productPNo').text(data.ProductPNo || '-');
                $('#productDimensions').text(
                    data.ProductLengthMm.toFixed(0) + ' × ' + data.ProductWidthMm.toFixed(0) + ' × ' + data.ProductHeightMm.toFixed(0));
                $('#productVolume').text(data.VolumePerUnitCbm.toFixed(6));

                $('#transportName').text(data.TransportTypeName || '-');
                $('#transportDimensions').text(
                    data.TransportLengthMm.toFixed(0) + ' × ' + data.TransportWidthMm.toFixed(0) + ' × ' + data.TransportHeightMm.toFixed(0));
                $('#transportVolume').text(data.TransportVolumeCbm.toFixed(6));

                $('#maxQuantity').text(data.MaxQuantity);
                $('#bestOrientation').text(data.BestOrientation);
                $('#totalCbm').text(data.TotalCbm.toFixed(6));

                var utilization = data.UtilizationPercent;
                var utilElement = $('#utilizationPercent');
                utilElement.text(utilization.toFixed(2) + '%')
                    .removeClass('text-success text-warning text-danger')
                    .addClass(utilization >= 80 ? 'text-success' : utilization >= 50 ? 'text-warning' : 'text-danger');

                $('#layoutInfo').text(
                    data.CountLength + ' × ' + data.CountWidth + ' × ' + data.CountHeight + ' (' + '@L.Js("Log_InOrientation")'.replace('{0}', data.BestOrientation) + ')');
            }

            // Sahna bir marta yaratiladi; har simulyatsiyada faqat obyektlar almashtiriladi (LOG-P12)
            function ensureThreeJS() {
                if (renderer) {
                    onWindowResize();
                    return;
                }
                var container = document.getElementById('threejsContainer');

                scene = new THREE.Scene();
                scene.background = new THREE.Color(0xf0f0f0);

                camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 10000);
                camera.position.set(2000, 2000, 2000);

                renderer = new THREE.WebGLRenderer({ antialias: true });
                renderer.setSize(container.clientWidth, container.clientHeight);
                container.innerHTML = '';
                container.appendChild(renderer.domElement);

                var isDragging = false, prev = { x: 0, y: 0 };
                var rotX = 0.6, rotY = 0.8, radius = 3000;

                renderer.domElement.addEventListener('mousedown', function (e) { isDragging = true; prev = { x: e.clientX, y: e.clientY }; });
                renderer.domElement.addEventListener('mousemove', function (e) {
                    if (!isDragging) return;
                    rotY += (e.clientX - prev.x) * 0.01;
                    rotX += (e.clientY - prev.y) * 0.01;
                    prev = { x: e.clientX, y: e.clientY };
                });
                window.addEventListener('mouseup', function () { isDragging = false; });
                renderer.domElement.addEventListener('wheel', function (e) {
                    e.preventDefault();
                    radius = Math.max(500, Math.min(8000, radius + e.deltaY * 10));
                });

                controls = {
                    target: { x: 0, y: 0, z: 0 },
                    setRadius: function (r) { radius = r; },
                    update: function () {
                        var current = camera.position.length();
                        var r = current + (radius - current) * 0.1;
                        camera.position.x = this.target.x + Math.sin(rotY) * Math.cos(rotX) * r;
                        camera.position.y = this.target.y + Math.sin(rotX) * r;
                        camera.position.z = this.target.z + Math.cos(rotY) * Math.cos(rotX) * r;
                        camera.lookAt(this.target.x, this.target.y, this.target.z);
                    }
                };

                scene.add(new THREE.AmbientLight(0xffffff, 0.6));
                var directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
                directionalLight.position.set(1000, 2000, 1000);
                scene.add(directionalLight);
                scene.add(new THREE.GridHelper(5000, 20, 0x888888, 0xcccccc));
                scene.add(new THREE.AxesHelper(1000));

                window.addEventListener('resize', onWindowResize, false);
                startAnimation();
            }

            function clearSceneObjects() {
                sceneObjects.forEach(function (obj) {
                    scene.remove(obj);
                    if (obj.geometry) obj.geometry.dispose();
                    if (obj.material) obj.material.dispose();
                });
                sceneObjects = [];
            }

            function renderVisualization(data, useAlternative) {
                if (!scene) return;
                clearSceneObjects();

                var countLength = useAlternative ? data.AlternativeCountLength : data.CountLength;
                var countWidth = useAlternative ? data.AlternativeCountWidth : data.CountWidth;
                var countHeight = data.CountHeight;
                var orientation = useAlternative ? data.AlternativeOrientation : data.BestOrientation;

                var maxDim = Math.max(data.TransportLengthMm, data.TransportWidthMm, data.TransportHeightMm);
                var scale = 2000 / maxDim;
                var tl = data.TransportLengthMm * scale, th = data.TransportHeightMm * scale, tw = data.TransportWidthMm * scale;

                var transport = new THREE.Mesh(
                    new THREE.BoxGeometry(tl, th, tw),
                    new THREE.MeshBasicMaterial({ color: 0x000000, wireframe: true, transparent: true, opacity: 0.3 }));
                transport.position.set(tl / 2, th / 2, tw / 2);
                scene.add(transport);
                sceneObjects.push(transport);

                var pl = data.ProductLengthMm * scale, pw = data.ProductWidthMm * scale, ph = data.ProductHeightMm * scale;
                var boxLength = orientation === 'LxW' ? pl : pw;
                var boxWidth = orientation === 'LxW' ? pw : pl;

                // Bitta InstancedMesh + umumiy material (avval har quti uchun Mesh + material nusxasi — minglab obyekt)
                var total = countLength * countWidth * countHeight;
                if (total > 0) {
                    var boxes = new THREE.InstancedMesh(
                        new THREE.BoxGeometry(boxLength, ph, boxWidth),
                        new THREE.MeshLambertMaterial({ color: 0x4CAF50, transparent: true, opacity: 0.7 }),
                        total);
                    var m = new THREE.Matrix4(), i = 0;
                    for (var x = 0; x < countLength; x++) {
                        for (var z = 0; z < countWidth; z++) {
                            for (var y = 0; y < countHeight; y++) {
                                m.makeTranslation(x * boxLength + boxLength / 2, y * ph + ph / 2, z * boxWidth + boxWidth / 2);
                                boxes.setMatrixAt(i++, m);
                            }
                        }
                    }
                    boxes.instanceMatrix.needsUpdate = true;
                    scene.add(boxes);
                    sceneObjects.push(boxes);
                }

                controls.target = { x: tl / 2, y: th / 2, z: tw / 2 };
                controls.setRadius(maxDim * scale * 2.6);
            }

            // Bitta animatsiya tsikli (avval har simulyatsiya yangi requestAnimationFrame tsiklini qo'shardi)
            function startAnimation() {
                if (frameId !== null) cancelAnimationFrame(frameId);
                (function loop() {
                    frameId = requestAnimationFrame(loop);
                    if (controls) controls.update();
                    renderer.render(scene, camera);
                })();
            }

            function onWindowResize() {
                var container = document.getElementById('threejsContainer');
                if (container && camera && renderer && container.clientWidth > 0) {
                    camera.aspect = container.clientWidth / container.clientHeight;
                    camera.updateProjectionMatrix();
                    renderer.setSize(container.clientWidth, container.clientHeight);
                }
            }

            $(function () {
                var productSelect = $('#productSelect');
                productSelect.select2({
                    width: '100%',
                    placeholder: '---@L.Js("Select")---',
                    minimumInputLength: 1,
                    ajax: {
                        url: productSelect.data('search-url'),
                        dataType: 'json',
                        delay: 250,
                        data: function (params) { return { q: params.term }; },
                        processResults: function (data) { return { results: data.results || [] }; }
                    }
                });

                // LOG-B11: bitta handler (avval jQuery click + btn.onclick — har bosishda 2 ta so'rov)
                $('#simulateBtn').on('click', function (e) {
                    e.preventDefault();
                    var productId = $('#productSelect').val();
                    var transportId = $('#transportSelect').val();
                    if (!productId || !transportId) {
                        alert('@L.Js("Log_SelectProductAndTransport")');
                        return;
                    }
                    performSimulation(productId, transportId);
                });

                $('#toggleOrientationBtn').on('click', function () {
                    if (currentData) {
                        showingAlternative = !showingAlternative;
                        renderVisualization(currentData, showingAlternative);
                    }
                });
            });
        })(jQuery);
    </script>
}
