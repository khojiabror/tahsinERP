@{
    ViewBag.Title = "Transport Load Simulation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        Logistika
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Transport yuklash simulyatsiyasi
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <div class="row">
                        <!-- Selection Panel -->
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">Yuklash parametrlari</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-5 col-sm-12 form-group">
                                                <label>Mahsulot</label>
                                                <select id="productSelect" class="form-control select2">
                                                    <option value="">---Tanlang---</option>
                                                    @if (ViewBag.Products != null)
                                                    {
                                                        foreach (var product in ViewBag.Products)
                                                        {
                                                            <option value="@product.ID" 
                                                                    data-length="@product.Length" 
                                                                    data-width="@product.Width" 
                                                                    data-height="@product.Height">
                                                                @product.PNo - @product.Name
                                                            </option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-5 col-sm-12 form-group">
                                                <label>Transport turi</label>
                                                <select id="transportSelect" class="form-control select2">
                                                    <option value="">---Tanlang---</option>
                                                    @if (ViewBag.TransportTypes != null)
                                                    {
                                                        foreach (var transport in ViewBag.TransportTypes)
                                                        {
                                                            <option value="@transport.ID" 
                                                                    data-length="@transport.IntLgth" 
                                                                    data-width="@transport.IntWdth" 
                                                                    data-height="@transport.IntHght">
                                                                @transport.TransportType
                                                            </option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-2 col-sm-12 form-group d-flex align-items-end">
                                                <button type="button" id="simulateBtn" class="btn btn-primary btn-block">
                                                    <i class="bx bx-calculator"></i> Simulyatsiya
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Results Panel -->
                        <div class="col-12" id="resultsPanel" style="display: none;">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">Natijalar</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="row">
                                            <!-- Product Info -->
                                            <div class="col-md-6 col-sm-12">
                                                <div class="card border-primary">
                                                    <div class="card-header bg-primary text-white">
                                                        <h5>Mahsulot ma'lumotlari</h5>
                                                    </div>
                                                    <div class="card-body">
                                                        <p><strong>Nomi:</strong> <span id="productName"></span></p>
                                                        <p><strong>PNo:</strong> <span id="productPNo"></span></p>
                                                        <p><strong>O'lchamlari:</strong> 
                                                            <span id="productDimensions"></span> mm
                                                        </p>
                                                        <p><strong>Hajmi:</strong> 
                                                            <span id="productVolume"></span> m³
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Transport Info -->
                                            <div class="col-md-6 col-sm-12">
                                                <div class="card border-info">
                                                    <div class="card-header bg-info text-white">
                                                        <h5>Transport ma'lumotlari</h5>
                                                    </div>
                                                    <div class="card-body">
                                                        <p><strong>Nomi:</strong> <span id="transportName"></span></p>
                                                        <p><strong>Ichki o'lchamlari:</strong> 
                                                            <span id="transportDimensions"></span> mm
                                                        </p>
                                                        <p><strong>Hajmi:</strong> 
                                                            <span id="transportVolume"></span> m³
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <hr />

                                        <!-- Calculation Results -->
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="card border-success">
                                                    <div class="card-header bg-success text-white">
                                                        <h5>Hisoblash natijalari</h5>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="row">
                                                            <div class="col-md-3 col-sm-6">
                                                                <p><strong>Maksimal miqdor:</strong></p>
                                                                <h3 class="text-primary" id="maxQuantity">0</h3>
                                                            </div>
                                                            <div class="col-md-3 col-sm-6">
                                                                <p><strong>Optimal orientatsiya:</strong></p>
                                                                <h4 class="text-info" id="bestOrientation">-</h4>
                                                            </div>
                                                            <div class="col-md-3 col-sm-6">
                                                                <p><strong>Jami hajm:</strong></p>
                                                                <h4 class="text-success" id="totalCbm">0.000</h4>
                                                                <small>m³</small>
                                                            </div>
                                                            <div class="col-md-3 col-sm-6">
                                                                <p><strong>Foydalanish:</strong></p>
                                                                <h4 id="utilizationPercent" class="utilization-badge">0.00%</h4>
                                                            </div>
                                                        </div>
                                                        <div class="row mt-2">
                                                            <div class="col-12">
                                                                <p><strong>Joylashtirish:</strong> 
                                                                    <span id="layoutInfo"></span>
                                                                </p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- 3D Visualization -->
                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <div class="card">
                                                    <div class="card-header">
                                                        <h5>3D Vizualizatsiya</h5>
                                                        <div class="card-header-actions">
                                                            <button type="button" id="toggleOrientationBtn" class="btn btn-sm btn-outline-secondary">
                                                                <i class="bx bx-refresh"></i> Alternativ orientatsiyani ko'rsatish
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div class="card-body">
                                                        <div id="visualizationContainer" style="width: 100%; height: 600px; position: relative; border: 1px solid #ddd; background: #f5f5f5;">
                                                            <div id="threejsContainer" style="width: 100%; height: 100%;"></div>
                                                            <div id="loadingIndicator" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); display: none;">
                                                                <div class="spinner-border text-primary" role="status">
                                                                    <span class="sr-only">Yuklanmoqda...</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mt-2">
                                                            <small class="text-muted">
                                                                <i class="bx bx-info-circle"></i> 
                                                                Sichqoncha bilan aylantirish, scroll bilan kattalashtirish/kichiklashtirish mumkin
                                                            </small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <!-- Three.js Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

    <script>
        // Global variables for Three.js
        var scene, camera, renderer, controls;
        var currentData = null;
        var showingAlternative = false;

        // Store AJAX URL from Razor
        var calculateApiUrl = '@Url.Action("Calculate", "TransportLoadApi")';
        if (!calculateApiUrl || calculateApiUrl === '') {
            calculateApiUrl = '/TransportLoadApi/Calculate';
        }

        // Define all functions globally FIRST (before initialization)
        window.performSimulation = function(productId, transportId) {
            console.log('Simulation started', { productId: productId, transportId: transportId });
            var $ = jQuery;
            
            $('#loadingIndicator').show();
            $('#resultsPanel').hide();

            console.log('AJAX URL:', calculateApiUrl);

            $.ajax({
                url: calculateApiUrl,
                type: 'GET',
                data: {
                    productId: productId,
                    transportId: transportId
                },
                success: function (response) {
                    console.log('AJAX Success:', response);
                    $('#loadingIndicator').hide();
                    if (response && response.success) {
                        currentData = response.data;
                        showingAlternative = false;
                        window.displayResults(response.data);
                        window.initializeThreeJS();
                        window.renderVisualization(response.data, false);
                        $('#resultsPanel').show();
                    } else {
                        var errorMsg = response && response.error ? response.error : 'Noma\'lum xatolik';
                        alert('Xatolik: ' + errorMsg);
                        console.error('Response error:', response);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('AJAX Error:', { xhr: xhr, status: status, error: error, responseText: xhr.responseText });
                    $('#loadingIndicator').hide();
                    var errorMessage = 'Xatolik yuz berdi: ' + error;
                    if (xhr.responseText) {
                        errorMessage += '\n\nJavob: ' + xhr.responseText.substring(0, 200);
                    }
                    alert(errorMessage);
                }
            });
        };

        window.displayResults = function(data) {
            var $ = jQuery;
            
            // Product info
            $('#productName').text(data.ProductName || '-');
            $('#productPNo').text(data.ProductPNo || '-');
            $('#productDimensions').text(
                data.ProductLengthMm.toFixed(0) + ' × ' +
                data.ProductWidthMm.toFixed(0) + ' × ' +
                data.ProductHeightMm.toFixed(0)
            );
            $('#productVolume').text(data.VolumePerUnitCbm.toFixed(6));

            // Transport info
            $('#transportName').text(data.TransportTypeName || '-');
            $('#transportDimensions').text(
                data.TransportLengthMm.toFixed(0) + ' × ' +
                data.TransportWidthMm.toFixed(0) + ' × ' +
                data.TransportHeightMm.toFixed(0)
            );
            $('#transportVolume').text(data.TransportVolumeCbm.toFixed(6));

            // Results
            $('#maxQuantity').text(data.MaxQuantity);
            $('#bestOrientation').text(data.BestOrientation);
            $('#totalCbm').text(data.TotalCbm.toFixed(6));
            
            const utilization = data.UtilizationPercent;
            $('#utilizationPercent').text(utilization.toFixed(2) + '%');
            
            // Color code utilization
            const utilElement = $('#utilizationPercent');
            utilElement.removeClass('text-success text-warning text-danger');
            if (utilization >= 80) {
                utilElement.addClass('text-success');
            } else if (utilization >= 50) {
                utilElement.addClass('text-warning');
            } else {
                utilElement.addClass('text-danger');
            }

            // Layout info
            $('#layoutInfo').text(
                data.CountLength + ' × ' + data.CountWidth + ' × ' + data.CountHeight + 
                ' (' + data.BestOrientation + ' orientatsiyada)'
            );
        };

        window.initializeThreeJS = function() {
            const container = document.getElementById('threejsContainer');
            
            // Clear previous scene if exists
            if (renderer) {
                renderer.dispose();
            }

            // Scene
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0xf0f0f0);

            // Camera
            const width = container.clientWidth;
            const height = container.clientHeight;
            camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 10000);
            camera.position.set(2000, 2000, 2000);
            camera.lookAt(0, 0, 0);

            // Renderer
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(width, height);
            renderer.shadowMap.enabled = true;
            container.innerHTML = '';
            container.appendChild(renderer.domElement);

            // Simple mouse controls
            let isDragging = false;
            let previousMousePosition = { x: 0, y: 0 };
            let targetRotationX = 0, targetRotationY = 0;
            let targetRadius = 3000;
            
            renderer.domElement.addEventListener('mousedown', function(e) {
                isDragging = true;
                previousMousePosition = { x: e.clientX, y: e.clientY };
            });
            
            renderer.domElement.addEventListener('mousemove', function(e) {
                if (isDragging) {
                    const deltaX = e.clientX - previousMousePosition.x;
                    const deltaY = e.clientY - previousMousePosition.y;
                    targetRotationY += deltaX * 0.01;
                    targetRotationX += deltaY * 0.01;
                    previousMousePosition = { x: e.clientX, y: e.clientY };
                }
            });
            
            renderer.domElement.addEventListener('mouseup', function() {
                isDragging = false;
            });
            
            renderer.domElement.addEventListener('wheel', function(e) {
                e.preventDefault();
                targetRadius += e.deltaY * 10;
                targetRadius = Math.max(500, Math.min(8000, targetRadius));
            });
            
            // Simple mouse controls
            controls = {
                target: { x: 0, y: 0, z: 0 },
                update: function() {
                    const currentRadius = camera.position.length();
                    const newRadius = currentRadius + (targetRadius - currentRadius) * 0.1;
                    
                    camera.position.x = Math.sin(targetRotationY) * Math.cos(targetRotationX) * newRadius;
                    camera.position.y = Math.sin(targetRotationX) * newRadius;
                    camera.position.z = Math.cos(targetRotationY) * Math.cos(targetRotationX) * newRadius;
                    camera.lookAt(this.target.x, this.target.y, this.target.z);
                }
            };

            // Lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);

            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(1000, 2000, 1000);
            directionalLight.castShadow = true;
            scene.add(directionalLight);

            // Grid helper
            const gridHelper = new THREE.GridHelper(5000, 20, 0x888888, 0xcccccc);
            scene.add(gridHelper);

            // Axes helper
            const axesHelper = new THREE.AxesHelper(1000);
            scene.add(axesHelper);

            // Handle window resize
            window.addEventListener('resize', window.onWindowResize, false);
        };

        window.renderVisualization = function(data, useAlternative) {
            if (!scene || !camera || !renderer) return;

            // Clear existing objects (except lights, grid, axes)
            const objectsToRemove = [];
            scene.traverse(function (object) {
                if (object.userData.isProduct || object.userData.isTransport) {
                    objectsToRemove.push(object);
                }
            });
            objectsToRemove.forEach(obj => {
                scene.remove(obj);
                if (obj.geometry) obj.geometry.dispose();
                if (obj.material) obj.material.dispose();
            });

            const result = useAlternative ? {
                CountLength: data.AlternativeCountLength,
                CountWidth: data.AlternativeCountWidth,
                CountHeight: data.CountHeight,
                BestOrientation: data.AlternativeOrientation
            } : {
                CountLength: data.CountLength,
                CountWidth: data.CountWidth,
                CountHeight: data.CountHeight,
                BestOrientation: data.BestOrientation
            };

            // Scale factor to fit in view
            const maxDim = Math.max(
                data.TransportLengthMm,
                data.TransportWidthMm,
                data.TransportHeightMm
            );
            const scale = 2000 / maxDim;

            // Transport container (wireframe)
            const transportGeometry = new THREE.BoxGeometry(
                data.TransportLengthMm * scale,
                data.TransportHeightMm * scale,
                data.TransportWidthMm * scale
            );
            const transportMaterial = new THREE.MeshBasicMaterial({
                color: 0x000000,
                wireframe: true,
                transparent: true,
                opacity: 0.3
            });
            const transport = new THREE.Mesh(transportGeometry, transportMaterial);
            transport.userData.isTransport = true;
            transport.position.set(
                data.TransportLengthMm * scale / 2,
                data.TransportHeightMm * scale / 2,
                data.TransportWidthMm * scale / 2
            );
            scene.add(transport);

            // Product boxes
            const productLength = data.ProductLengthMm * scale;
            const productWidth = data.ProductWidthMm * scale;
            const productHeight = data.ProductHeightMm * scale;

            // Determine actual product dimensions based on orientation
            let boxLength, boxWidth;
            if (result.BestOrientation === 'LxW') {
                boxLength = productLength;
                boxWidth = productWidth;
            } else {
                boxLength = productWidth;
                boxWidth = productLength;
            }

            const productGeometry = new THREE.BoxGeometry(boxLength, productHeight, boxWidth);
            const productMaterial = new THREE.MeshLambertMaterial({
                color: 0x4CAF50,
                transparent: true,
                opacity: 0.7
            });

            // Create product boxes in grid
            for (let x = 0; x < result.CountLength; x++) {
                for (let z = 0; z < result.CountWidth; z++) {
                    for (let y = 0; y < result.CountHeight; y++) {
                        const productBox = new THREE.Mesh(productGeometry, productMaterial.clone());
                        productBox.userData.isProduct = true;
                        productBox.position.set(
                            x * boxLength + boxLength / 2,
                            y * productHeight + productHeight / 2,
                            z * boxWidth + boxWidth / 2
                        );
                        productBox.castShadow = true;
                        productBox.receiveShadow = true;
                        scene.add(productBox);
                    }
                }
            }

            // Update camera to view the scene
            const centerX = data.TransportLengthMm * scale / 2;
            const centerY = data.TransportHeightMm * scale / 2;
            const centerZ = data.TransportWidthMm * scale / 2;
            
            camera.position.set(
                centerX + maxDim * scale * 1.5,
                centerY + maxDim * scale * 1.5,
                centerZ + maxDim * scale * 1.5
            );
            controls.target = { x: centerX, y: centerY, z: centerZ };
            controls.update();

            if (window.animate) window.animate();
        };

        window.animate = function() {
            requestAnimationFrame(window.animate);
            if (controls) {
                controls.update();
            }
            if (renderer && scene && camera) {
                renderer.render(scene, camera);
            }
        };

        window.onWindowResize = function() {
            const container = document.getElementById('threejsContainer');
            if (container && camera && renderer) {
                camera.aspect = container.clientWidth / container.clientHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(container.clientWidth, container.clientHeight);
            }
        };

        // Wait for jQuery to be available
        (function() {
            function initTransportLoadSimulation() {
                // Check if jQuery is available
                if (typeof jQuery === 'undefined') {
                    console.error('jQuery is not loaded! Retrying...');
                    setTimeout(initTransportLoadSimulation, 100);
                    return;
                }

                var $ = jQuery;
                console.log('Transport Load Simulation initialized');
                console.log('jQuery version:', $.fn.jquery);
                console.log('API URL:', calculateApiUrl);

                // Wait for DOM to be ready
                $(document).ready(function () {
                    console.log('Document ready - jQuery version:', $.fn.jquery);
                    console.log('Simulate button exists:', $('#simulateBtn').length > 0);
            
                    // Initialize Select2 if available
                    if (typeof $.fn.select2 !== 'undefined') {
                        $('#productSelect, #transportSelect').select2();
                    }

                    // Simulate button click - use direct event binding
                    $('#simulateBtn').off('click').on('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        console.log('Simulate button clicked');
                        
                        var productId = $('#productSelect').val();
                        var transportId = $('#transportSelect').val();

                        console.log('Selected values:', { productId: productId, transportId: transportId });

                        if (!productId || !transportId) {
                            alert('Iltimos, mahsulot va transport turini tanlang');
                            return false;
                        }

                        if (window.performSimulation) {
                            window.performSimulation(productId, transportId);
                        } else {
                            console.error('performSimulation function not available');
                        }
                        return false;
                    });

                    // Also try direct onclick as fallback
                    var btn = document.getElementById('simulateBtn');
                    if (btn) {
                        btn.onclick = function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                            console.log('Direct onclick handler triggered');
                            var productId = $('#productSelect').val();
                            var transportId = $('#transportSelect').val();

                            if (!productId || !transportId) {
                                alert('Iltimos, mahsulot va transport turini tanlang');
                                return false;
                            }

                            if (window.performSimulation) {
                                window.performSimulation(productId, transportId);
                            } else {
                                console.error('performSimulation function not available');
                            }
                            return false;
                        };
                    }

                    // Toggle orientation button
                    $('#toggleOrientationBtn').on('click', function () {
                        if (currentData && window.renderVisualization) {
                            showingAlternative = !showingAlternative;
                            window.renderVisualization(currentData, showingAlternative);
                        }
                    });
                });
            }

            // Start initialization when page loads
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initTransportLoadSimulation);
            } else {
                // DOM already loaded
                initTransportLoadSimulation();
            }
        })();
    </script>

    <style>
        .utilization-badge {
            font-weight: bold;
        }
        #threejsContainer {
            border-radius: 4px;
        }
    </style>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
