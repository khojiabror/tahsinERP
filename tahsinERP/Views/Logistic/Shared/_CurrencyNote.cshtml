@* LOG-B13: hisobot summalari so'mda (CBU kursi, hujjat sanasi). ViewBag.CurrencyCodes — davrdagi valyutalar,
   ViewBag.CurrencyWarning — kursi topilmagan hujjatlar (jamiga qo'shilmagan). *@
@{
    var codes = ViewBag.CurrencyCodes as IEnumerable<string>;
    string warning = ViewBag.CurrencyWarning as string;
}
@if (codes != null && codes.Count() > 1)
{
    <div class="alert alert-info no-print">
        @L.T("Log_MultiCurrencyNote", string.Join(", ", codes))
    </div>
}
@if (!string.IsNullOrEmpty(warning))
{
    <div class="alert alert-warning no-print">@warning</div>
}
