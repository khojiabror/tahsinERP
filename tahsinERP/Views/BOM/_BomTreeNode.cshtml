@model tahsinERP.ViewModels.BOM.BomTreeNodeViewModel

@{
    var isRoot = ViewBag.IsRoot ?? false;
    var nodeClass = isRoot ? "bom-node bom-node-root" : "bom-node bom-node-component";
    
    // Clear IsRoot flag for children
    ViewBag.IsRoot = false;
}

<li>
    <div style="display: flex; align-items: center; gap: 10px;">
        <!-- Image Box (separate from name box) -->
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="bom-image-box" style="width: 80px; height: 80px; border: 2px solid #ddd; border-radius: 5px; display: flex; align-items: center; justify-content: center; background: white; padding: 5px;">
                <img src="@Model.ImageUrl" alt="@(isRoot ? Model.ProductPno : Model.ProductName)" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
            </div>
        }
        else
        {
            <!-- Empty placeholder box when no image -->
            <div class="bom-image-box" style="width: 80px; height: 80px; border: 2px solid #ddd; border-radius: 5px; display: flex; align-items: center; justify-content: center; background: #f5f5f5; padding: 5px;">
                <span style="color: #999; font-size: 12px;">@L.T("Mes_NoImage")</span>
            </div>
        }
        
        <!-- Name/Product Box -->
        <div class="@nodeClass" style="flex: 1;">
            @if (isRoot)
            {
                <span>@Model.ProductPno</span>
            }
            else
            {
                <span>@Model.ProductName</span>
            }
            @if (Model.Quantity > 0)
            {
                <span class="bom-quantity">x @Model.Quantity.ToString("F2")@(!string.IsNullOrEmpty(Model.UnitShortname) ? " " + Model.UnitShortname : "")</span>
            }
        </div>
    </div>
    
    @if (Model.Children != null && Model.Children.Any())
    {
        <ul>
            @foreach (var child in Model.Children)
            {
                @Html.Partial("_BomTreeNode", child)
            }
        </ul>
    }
</li>
