@model tahsinERP.ViewModels.DiagnosisInputViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
    <title>tahsinERP Diagnosis</title>
    <link rel="apple-touch-icon" href="~/app-assets/images/ico/apple-touch-icon.png">
    <link rel="shortcut icon" type="image/x-icon" href="~/app-assets/images/ico/favicon.ico">
    <link href="https://fonts.googleapis.com/css?family=Rubik:300,400,500,600%7CIBM+Plex+Sans:300,400,500,600,700" rel="stylesheet">

    <!-- Vendor CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/vendors.min.css">
    <!-- Theme CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap-extended.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/colors.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/components.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/themes/semi-dark-layout.css">
    <!-- Page CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/core/menu/menu-types/vertical-menu.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css">

    <style>
        body {
            background-color: #ffffff;
            font-family: 'Rubik', 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        .diagnosis-main {
            max-width: 960px;
            margin: 2rem auto;
            padding: 0 1rem 3rem 1rem;
        }

        .diagnosis-main h1 {
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .diagnosis-main p.lead {
            color: #6E6B7B;
            margin-bottom: 1.5rem;
        }

        .diagnosis-main h5 {
            margin-top: 1.5rem;
        }

        .diagnosis-main .form-group label {
            display: block;
            text-transform: none;
            white-space: normal;
            word-break: break-word;
            letter-spacing: normal;
            line-height: 1.4;
            font-size: 0.95rem;
            margin-bottom: 0.25rem;
        }

        .diagnosis-main .section-title {
            margin-top: 2rem;
            margin-bottom: 0.75rem;
            font-weight: 600;
        }

        .diagnosis-main hr {
            margin: 1.5rem 0;
        }
    </style>
</head>
<body>
    <main class="diagnosis-main">
        <h1>tahsinERP Diagnosis</h1>
        <p class="lead">Hozirgi ish uslubingiz (qog'oz/Excel/oddiy accounting) bo'yicha qisqacha savollarga javob bering.</p>

        <h5 class="section-title">Mijoz ma'lumotlari va baholash savollari</h5>
        <p class="text-muted">
            Mijoz korxonasi haqida qisqacha ma'lumot kiriting. Jadval asosida moliya, supply chain, ombor, shaffoflik va qulaylik bo'yicha baho hisoblanadi.
        </p>

        <div class="row">
            <div class="col-lg-6 col-12">
                                @using (Html.BeginForm("Index", "Diagnosis", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    <h5 class="mb-1">1. Moliya</h5>
                                    <div class="form-group">
                                        <label for="ProfitMarginPercent">Foyda-zarar holati (taxminiy sof foyda marjasi, %)</label>
                                        @Html.TextBoxFor(m => m.ProfitMarginPercent, new { @class = "form-control", type = "number", step = "0.1", min = "0", max = "100" })
                                        <small class="form-text text-muted">Taxminiy sof foyda marjasi (%), masalan 15.</small>
                                        @Html.ValidationMessageFor(m => m.ProfitMarginPercent, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.CheckBoxFor(m => m.HasCashflowPlanning, new { id = "HasCashflowPlanning" })
                                        <label for="HasCashflowPlanning">Naqd pul oqimi rejalashtiriladi</label>
                                    </div>
                                    <div class="form-group">
                                        @Html.CheckBoxFor(m => m.HasBudgeting, new { id = "HasBudgeting" })
                                        <label for="HasBudgeting">Yillik byudjet va reja-fakt tahlili bor</label>
                                    </div>

                                    <hr />
                                    <h5 class="mb-1">2. Supply chain (ta'minot zanjiri)</h5>
                                    <div class="form-group">
                                        <label for="SuppliersCount">Faol yetkazib beruvchilar soni (asosiy)</label>
                                        @Html.TextBoxFor(m => m.SuppliersCount, new { @class = "form-control", type = "number", min = "0" })
                                        <small class="form-text text-muted">Faol ishlayotgan asosiy yetkazib beruvchilar soni.</small>
                                        @Html.ValidationMessageFor(m => m.SuppliersCount, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.CheckBoxFor(m => m.HasLeadTimeTracking, new { id = "HasLeadTimeTracking" })
                                        <label for="HasLeadTimeTracking">Lead time (buyurtma → yetkazib berish) kuzatiladi</label>
                                    </div>
                                    <div class="form-group">
                                        @Html.CheckBoxFor(m => m.HasIntegratedPurchasing, new { id = "HasIntegratedPurchasing" })
                                        <label for="HasIntegratedPurchasing">Xarid jarayoni tizimda boshqariladi</label>
                                    </div>

                                    <hr />
                                    <h5 class="mb-1">3. Ombor boshqaruvi</h5>
                                    <div class="form-group">
                                        @Html.CheckBoxFor(m => m.HasBOM, new { id = "HasBOM" })
                                        <label for="HasBOM">Murakkab mahsulotlar uchun BOM/resept yuritiladi</label>
                                    </div>
                                    <div class="form-group">
                                        <label for="InventoryCheckPerYear">Yiliga necha marta to'liq inventarizatsiya o'tkaziladi?</label>
                                        @Html.TextBoxFor(m => m.InventoryCheckPerYear, new { @class = "form-control", type = "number", min = "0" })
                                        <small class="form-text text-muted">Yiliga necha marta to'liq inventarizatsiya o'tkaziladi?</small>
                                        @Html.ValidationMessageFor(m => m.InventoryCheckPerYear, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.CheckBoxFor(m => m.CanSeeStockOnline, new { id = "CanSeeStockOnline" })
                                        <label for="CanSeeStockOnline">Real vaqtda qoldiqni tizimdan ko'rasiz</label>
                                    </div>

                                    <hr />
                                    <h5 class="mb-1">4. Shaffoflik va avtomatizatsiya</h5>
                                    <div class="form-group">
                                        @Html.CheckBoxFor(m => m.HasAutomaticReports, new { id = "HasAutomaticReports" })
                                        <label for="HasAutomaticReports">Asosiy hisobotlar avtomatik shakllanadi</label>
                                    </div>
                                    <div class="form-group">
                                        @Html.CheckBoxFor(m => m.CanSeeKPIsDashboard, new { id = "CanSeeKPIsDashboard" })
                                        <label for="CanSeeKPIsDashboard">KPI va ko'rsatkichlar uchun dashboard bor</label>
                                    </div>
                                    <div class="form-group">
                                        <label for="ProcessAutomationLevel">Jarayonlar avtomatizatsiya darajasi</label>
                                        @Html.EnumDropDownListFor(m => m.ProcessAutomationLevel, new { @class = "form-control" })
                                        <small class="form-text text-muted">
                                            FullyManual - hammasi qo'lda/Excel; PartiallyAutomated - qisman tizimda;
                                            MostlyAutomated - ko'p jarayonlar ERP orqali.
                                        </small>
                                    </div>

                                    <hr />
                                    <h5 class="mb-1">5. Qulaylik (usability)</h5>
                                    <div class="form-group">
                                        <label for="UsersCountUsingSystem">Tizim/uslubdan faol foydalanayotgan xodimlar soni</label>
                                        @Html.TextBoxFor(m => m.UsersCountUsingSystem, new { @class = "form-control", type = "number", min = "0" })
                                        @Html.ValidationMessageFor(m => m.UsersCountUsingSystem, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.CheckBoxFor(m => m.HasTrainingMaterials, new { id = "HasTrainingMaterials" })
                                        <label for="HasTrainingMaterials">Tizim bo'yicha trening/materiallar bor</label>
                                    </div>
                                    <div class="form-group">
                                        @Html.CheckBoxFor(m => m.UsersSatisfiedWithSystem, new { id = "UsersSatisfiedWithSystem" })
                                        <label for="UsersSatisfiedWithSystem">Xodimlar hozirgi tizim/uslubdan qoniqadi</label>
                                    </div>

                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-pulse"></i> Diagnosisni hisoblash
                                    </button>
                                }
            </div>

            <div class="col-lg-6 col-12">
                <div>
                    <h5 class="section-title">Natija (yulduzli baholash)</h5>
                    <p class="text-muted">
                        Mijoz ma'lumotlari asosida tahminiy baho. Keyinroq bu yerga AI tavsiyalarini ham ulab, matnli diagnoz qo'shish mumkin.
                    </p>

                                @if (Model.Result != null)
                                {
                                    <div class="table-responsive mb-2">
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Kategoria</th>
                                                    <th>Bahosi</th>
                                                    <th>Izoh</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>Moliya</td>
                                                    <td>
                                                        @for (int i = 0; i < Model.Result.FinanceStars; i++)
                                                        {
                                                            <i class="bx bxs-star text-warning"></i>
                                                        }
                                                        @for (int i = Model.Result.FinanceStars; i < 5; i++)
                                                        {
                                                            <i class="bx bx-star text-muted"></i>
                                                        }
                                                    </td>
                                                    <td>@Model.Result.FinanceLabel</td>
                                                </tr>
                                                <tr>
                                                    <td>Supply chain</td>
                                                    <td>
                                                        @for (int i = 0; i < Model.Result.SupplyChainStars; i++)
                                                        {
                                                            <i class="bx bxs-star text-warning"></i>
                                                        }
                                                        @for (int i = Model.Result.SupplyChainStars; i < 5; i++)
                                                        {
                                                            <i class="bx bx-star text-muted"></i>
                                                        }
                                                    </td>
                                                    <td>@Model.Result.SupplyChainLabel</td>
                                                </tr>
                                                <tr>
                                                    <td>Ombor boshqaruvi</td>
                                                    <td>
                                                        @for (int i = 0; i < Model.Result.InventoryStars; i++)
                                                        {
                                                            <i class="bx bxs-star text-warning"></i>
                                                        }
                                                        @for (int i = Model.Result.InventoryStars; i < 5; i++)
                                                        {
                                                            <i class="bx bx-star text-muted"></i>
                                                        }
                                                    </td>
                                                    <td>@Model.Result.InventoryLabel</td>
                                                </tr>
                                                <tr>
                                                    <td>Shaffoflik</td>
                                                    <td>
                                                        @for (int i = 0; i < Model.Result.TransparencyStars; i++)
                                                        {
                                                            <i class="bx bxs-star text-warning"></i>
                                                        }
                                                        @for (int i = Model.Result.TransparencyStars; i < 5; i++)
                                                        {
                                                            <i class="bx bx-star text-muted"></i>
                                                        }
                                                    </td>
                                                    <td>@Model.Result.TransparencyLabel</td>
                                                </tr>
                                                <tr>
                                                    <td>Avtomatizatsiya</td>
                                                    <td>
                                                        @for (int i = 0; i < Model.Result.AutomationStars; i++)
                                                        {
                                                            <i class="bx bxs-star text-warning"></i>
                                                        }
                                                        @for (int i = Model.Result.AutomationStars; i < 5; i++)
                                                        {
                                                            <i class="bx bx-star text-muted"></i>
                                                        }
                                                    </td>
                                                    <td>@Model.Result.AutomationLabel</td>
                                                </tr>
                                                <tr>
                                                    <td>Qulaylik (usability)</td>
                                                    <td>
                                                        @for (int i = 0; i < Model.Result.UsabilityStars; i++)
                                                        {
                                                            <i class="bx bxs-star text-warning"></i>
                                                        }
                                                        @for (int i = Model.Result.UsabilityStars; i < 5; i++)
                                                        {
                                                            <i class="bx bx-star text-muted"></i>
                                                        }
                                                    </td>
                                                    <td>@Model.Result.UsabilityLabel</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <hr />
                                    <h5 class="mt-2">Bloklar bo'yicha tahsinERP diagnozi</h5>
                                    <p class="text-muted">
                                        Quyida har bir yo'nalish bo'yicha hozirgi holat va tahsinERP modullari yordamida
                                        qanday natijalarga erishishingiz mumkinligi qisqacha tushuntirilgan:
                                    </p>
                                    <ul>
                                        <li><strong>Moliya</strong>: @Model.Result.FinanceNarrative</li>
                                        <li><strong>Supply chain</strong>: @Model.Result.SupplyChainNarrative</li>
                                        <li><strong>Ombor</strong>: @Model.Result.InventoryNarrative</li>
                                        <li><strong>Shaffoflik</strong>: @Model.Result.TransparencyNarrative</li>
                                        <li><strong>Avtomatizatsiya</strong>: @Model.Result.AutomationNarrative</li>
                                        <li><strong>Qulaylik</strong>: @Model.Result.UsabilityNarrative</li>
                                    </ul>

                                    <h5 class="mt-2">Tavsiya etilgan tahsinERP modullari</h5>
                                    <p class="text-muted mb-1">
                                        Har bir blok bo'yicha yulduz darajasiga qarab quyidagi modullar ayniqsa foydali bo'ladi:
                                    </p>
                                    <ul class="list-unstyled">
                                        <li><strong>Moliya</strong>: @Model.Result.FinanceRecommendedModules</li>
                                        <li><strong>Supply chain</strong>: @Model.Result.SupplyChainRecommendedModules</li>
                                        <li><strong>Ombor</strong>: @Model.Result.InventoryRecommendedModules</li>
                                        <li><strong>Shaffoflik</strong>: @Model.Result.TransparencyRecommendedModules</li>
                                        <li><strong>Avtomatizatsiya</strong>: @Model.Result.AutomationRecommendedModules</li>
                                        <li><strong>Qulaylik</strong>: @Model.Result.UsabilityRecommendedModules</li>
                                    </ul>

                                    <div class="alert alert-info mt-1" role="alert">
                                        <strong>Umumiy tavsiya:</strong>
                                        @Model.Result.OverallNarrative
                                        <br />
                                        <strong>TahsinERP modullari to'plami:</strong>
                                        @Model.Result.CombinedRecommendedModules
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">
                                        Avval chap tomondagi savollarni to'ldiring va "Diagnosisni hisoblash" tugmasini bosing.
                                        Shundan so'ng natija bu yerda yulduzli ko'rinishda chiqadi.
                                    </p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

