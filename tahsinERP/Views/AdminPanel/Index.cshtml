@model tahsinERP.ViewModels.AdminDashboardViewModel
@{
    ViewBag.Title = L.T("Menu_AdminPanel");
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        @*<div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                <li class="breadcrumb-item active">Admin Panel</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>*@

        <div class="content-body">
            <!-- Statistika kartochkalari -->
            <section id="statistics-cards">
                <div class="row">
                    <!-- Foydalanuvchilar -->
                    <div class="col-xl-3 col-md-6 col-sm-6">
                        <div class="card text-center">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="badge-circle badge-circle-lg badge-circle-light-primary mx-auto my-1">
                                        <i class="bx bx-user font-medium-5"></i>
                                    </div>
                                    <p class="text-muted mb-0">@L.T("Adm_Users")</p>
                                    <h2 class="mb-0">@Model.TotalUsers</h2>
                                    <small class="text-success">@L.T("Core_ActiveCount", Model.ActiveUsers)</small> |
                                    <small class="text-danger">@L.T("Core_InactiveCount", Model.InactiveUsers)</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Rollar -->
                    <div class="col-xl-3 col-md-6 col-sm-6">
                        <div class="card text-center">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="badge-circle badge-circle-lg badge-circle-light-success mx-auto my-1">
                                        <i class="bx bx-shield font-medium-5"></i>
                                    </div>
                                    <p class="text-muted mb-0">@L.T("Adm_Roles")</p>
                                    <h2 class="mb-0">@Model.TotalRoles</h2>
                                    <small class="text-muted">@L.T("Core_ModulesCount", Model.TotalPermissionModules)</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bugungi kirishlar -->
                    <div class="col-xl-3 col-md-6 col-sm-6">
                        <div class="card text-center">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="badge-circle badge-circle-lg badge-circle-light-warning mx-auto my-1">
                                        <i class="bx bx-log-in font-medium-5"></i>
                                    </div>
                                    <p class="text-muted mb-0">@L.T("Core_TodayEntries")</p>
                                    <h2 class="mb-0">@Model.TodayUserEntries</h2>
                                    <small class="text-muted">@L.T("Core_TotalWithValue", Model.TotalUserEntries)</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Loglar -->
                    <div class="col-xl-3 col-md-6 col-sm-6">
                        <div class="card text-center">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="badge-circle badge-circle-lg badge-circle-light-info mx-auto my-1">
                                        <i class="bx bx-file font-medium-5"></i>
                                    </div>
                                    <p class="text-muted mb-0">@L.T("Core_TodayLogs")</p>
                                    <h2 class="mb-0">@Model.TodayLogs</h2>
                                    <small class="text-muted">@L.T("Core_WeeklyWithValue", Model.ThisWeekLogs)</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <div class="row">
                <!-- Oxirgi kirishlar -->
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h4 class="card-title"><i class="bx bx-log-in mr-1"></i>@L.T("Core_RecentEntries")</h4>
                            <a href="~/UserEntries" class="btn btn-sm btn-outline-primary">@L.T("All")</a>
                        </div>
                        <div class="card-content">
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Core_User")</th>
                                                <th>IP</th>
                                                <th>@L.T("Date")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.RecentUserEntries != null && Model.RecentUserEntries.Any())
                                            {
                                                foreach (var entry in Model.RecentUserEntries)
                                                {
                                                    <tr>
                                                        <td>@(entry.USER?.FullName ?? L.T("Core_Unknown"))</td>
                                                        <td><code>@entry.IP</code></td>
                                                        <td>@entry.DateTime.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="3" class="text-center text-muted">@L.T("NoData")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Oxirgi loglar -->
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h4 class="card-title"><i class="bx bx-file mr-1"></i>@L.T("Core_RecentActions")</h4>
                            <a href="~/Log" class="btn btn-sm btn-outline-primary">@L.T("All")</a>
                        </div>
                        <div class="card-content">
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Core_User")</th>
                                                <th>@L.T("Core_Action")</th>
                                                <th>@L.T("Date")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.RecentLogs != null && Model.RecentLogs.Any())
                                            {
                                                foreach (var log in Model.RecentLogs)
                                                {
                                                    <tr>
                                                        <td>@(log.USER?.FullName ?? log.USER?.Uname ?? L.T("Core_Unknown"))</td>
                                                        <td>
                                                            <small>@log.ControllerName</small><br>
                                                            <span class="text-muted">@(log.ActionName?.Length > 50 ? log.ActionName.Substring(0, 50) + "..." : log.ActionName)</span>
                                                        </td>
                                                        <td>@log.DateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="3" class="text-center text-muted">@L.T("NoData")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Foydalanuvchilar ro'yxati -->
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h4 class="card-title"><i class="bx bx-user mr-1"></i>@L.T("Adm_Users")</h4>
                            <a href="~/User" class="btn btn-sm btn-outline-primary">@L.T("All")</a>
                        </div>
                        <div class="card-content">
                            <div class="card-body p-0">
                                <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Core_FullName")</th>
                                                <th>@L.T("Username")</th>
                                                <th>@L.T("Core_Role")</th>
                                                <th>@L.T("Status")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Users != null)
                                            {
                                                foreach (var user in Model.Users.Take(10))
                                                {
                                                    <tr>
                                                        <td>@user.FullName</td>
                                                        <td><code>@user.Uname</code></td>
                                                        <td>
                                                            @if (user.ROLES != null && user.ROLES.Any())
                                                            {
                                                                <span class="badge badge-light-primary">@user.ROLES.First().RName</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (user.IsActive)
                                                            {
                                                                <span class="badge badge-light-success">@L.T("Active")</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge badge-light-danger">@L.T("Inactive")</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Rollar va huquqlar -->
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h4 class="card-title"><i class="bx bx-shield mr-1"></i>@L.T("Core_RolesAndPermissions")</h4>
                            <a href="~/Permission" class="btn btn-sm btn-outline-primary">@L.T("Core_Manage")</a>
                        </div>
                        <div class="card-content">
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Core_RoleName")</th>
                                                <th class="text-center">@L.T("Core_PermissionsCount")</th>
                                                <th>@L.T("Actions")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Roles != null)
                                            {
                                                foreach (var role in Model.Roles)
                                                {
                                                    <tr>
                                                        <td>
                                                            <i class="bx bx-shield text-primary mr-1"></i>
                                                            <strong>@role.RName</strong>
                                                        </td>
                                                        <td class="text-center">
                                                            <span class="badge badge-light-info">
                                                                @L.T("Core_PermissionsCountValue", role.PERMISSIONS?.Count ?? 0)
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <a href="/Role/Permissions/@role.ID" 
                                                               class="btn btn-sm btn-outline-primary">
                                                                <i class="bx bx-edit"></i> @L.T("Edit")
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (tahsinERP.Models.RoleHelper.IsAdminOrDeveloper(User.Identity.Name))
            {
                string firmLang = tahsinERP.I18n.UiLanguage.FirmDefault();
                <!-- Firma standart tili -->
                <section id="ui-language">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title"><i class="bx bx-globe mr-1"></i>@L.T("DefaultLanguage")</h4>
                                </div>
                                <div class="card-body">
                                    @if (TempData["LangSaved"] != null)
                                    {
                                        <div class="alert alert-success mb-1">@L.T("Saved")</div>
                                    }
                                    @using (Html.BeginForm("SetDefaultLanguage", "AdminPanel", FormMethod.Post, new { @class = "form-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <select name="language" class="form-control mr-1 mb-1" aria-label="@L.T("DefaultLanguage")">
                                            @foreach (var lang in tahsinERP.Localization.Languages.All)
                                            {
                                                <option value="@lang" @(lang == firmLang ? "selected" : null)>@tahsinERP.Localization.Languages.NativeName(lang)</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-primary mb-1">@L.T("Save")</button>
                                    }
                                    <small class="text-muted d-block">@L.T("DefaultLanguage_Hint")</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            }

            <!-- Tezkor amallar -->
            <section id="quick-actions">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title"><i class="bx bx-zap mr-1"></i>@L.T("Core_QuickActions")</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-3 col-6 mb-2">
                                        <a href="~/User" class="btn btn-outline-primary btn-block">
                                            <i class="bx bx-user"></i> @L.T("Adm_Users")
                                        </a>
                                    </div>
                                    <div class="col-md-3 col-6 mb-2">
                                        <a href="~/Role" class="btn btn-outline-success btn-block">
                                            <i class="bx bx-shield"></i> @L.T("Adm_Roles")
                                        </a>
                                    </div>
                                    <div class="col-md-3 col-6 mb-2">
                                        <a href="~/PModule" class="btn btn-outline-warning btn-block">
                                            <i class="bx bx-lock"></i> @L.T("Adm_Permissions")
                                        </a>
                                    </div>
                                    <div class="col-md-3 col-6 mb-2">
                                        <a href="~/LastActions" class="btn btn-outline-info btn-block">
                                            <i class="bx bx-file"></i> @L.T("Core_Logs")
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
