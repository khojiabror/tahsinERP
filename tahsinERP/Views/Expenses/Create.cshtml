@model tahsinERP.ViewModels.ExpenseCreateViewModel
@using System.Collections.Generic
@{
    ViewBag.Title = "Yangi ombor chiqimi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var unitsList = ViewBag.Units as SelectList;
    var unitsData = new List<object>();

    if (unitsList != null)
    {
        foreach (SelectListItem item in unitsList)
        {
            unitsData.Add(new { Value = item.Value, Text = item.Text });
        }
    }
}

@* Ruxsat controller action'ida tekshiriladi (SRM-M05). *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Expenses/Index">Ombor chiqimlari</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Yangi chiqim
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                @if (ViewBag.NoWarehouseError != null)
                {
                    <div class="alert alert-danger" style="font-size:1.1rem; font-weight:600;">
                        @ViewBag.NoWarehouseError
                    </div>
                }
                else
                {
                    <section id="form-repeater-wrapper">
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body">
                                            @using (Html.BeginForm("Create", "Expenses", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form", @id = "expenseForm" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                                <div class="row">
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label for="DocNo">Hujjat raqami</label>
                                                        @Html.TextBoxFor(model => model.DocNo, new { @class = "form-control", @placeholder = "Avtomatik generatsiya qilinadi" })
                                                        @Html.ValidationMessageFor(model => model.DocNo, "", new { @class = "text-danger" })
                                                        <small class="text-muted">Bo'sh qoldirilsa, avtomatik generatsiya qilinadi</small>
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label for="IssueDateTime">Sana va vaqt</label>
                                                        @Html.TextBoxFor(model => model.IssueDateTime, "{0:yyyy-MM-ddTHH:mm}", new { @type = "datetime-local", @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.IssueDateTime, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label for="SenderWHID">Yuboruvchi ombor</label>
                                                        @Html.DropDownListFor(model => model.SenderWHID, ViewBag.SenderWarehouses as SelectList, "---Tanlang---", new { @class = "form-control select2", @id = "senderWarehouseSelect", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.SenderWHID, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <button type="button" class="btn btn-outline-primary mt-2" id="loadProductsBtn" style="display:none;">
                                                            <i class="bx bx-refresh"></i> Mavjud mahsulotlarni yuklash
                                                        </button>
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label for="ReceiverWhID">Qabul qiluvchi ombor</label>
                                                        @Html.DropDownListFor(model => model.ReceiverWhID, ViewBag.ReceiverWarehouses as SelectList, "---Tanlang---", new { @class = "form-control select2" })
                                                        @Html.ValidationMessageFor(model => model.ReceiverWhID, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label for="CurrencyID">Valyuta</label>
                                                        @Html.DropDownListFor(model => model.CurrencyID, ViewBag.Currencies as SelectList, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-6 col-12 form-group">
                                                        <label for="Description">Izoh</label>
                                                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = "2" })
                                                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-6 col-12 form-group">
                                                        <label for="expenseFile">Chiqim hujjati (PDF)</label>
                                                        <input type="file" name="expenseFile" id="expenseFile" class="form-control" accept=".pdf" />
                                                    </div>
                                                </div>

                                                <br />
                                                <h5>Chiqim mahsulotlari</h5>
                                                
                                                <div class="table-responsive">
                                                    <table id="expenseProductsTable" class="table table-bordered">
                                                        <thead>
                                                            <tr>
                                                                <th>Mahsulot</th>
                                                                <th>Mahsulot nomi</th>
                                                                <th>Mavjud qoldiq</th>
                                                                <th>Chiqim miqdori</th>
                                                                <th>Birlik</th>
                                                                <th title="Saqlashda FIFO bo'yicha avtomatik hisoblanadi (QQSsiz)">Tannarx (FIFO)</th>
                                                                <th>Jami</th>
                                                                <th>Izoh</th>
                                                                <th>Amallar</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody></tbody>
                                                        <tfoot>
                                                            <tr>
                                                                <td colspan="6" class="text-right"><strong>Jami:</strong></td>
                                                                <td id="totalAmount" class="text-right"><strong>0.00</strong></td>
                                                                <td colspan="2"></td>
                                                            </tr>
                                                        </tfoot>
                                                    </table>
                                                </div>

                                                @Html.Partial("~/Views/Incomes/_DocFormActions.cshtml", "Expenses")
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>

    @section scripts {
        <script src="~/Scripts/srm/srm-doc-lines.js"></script>
        <script src="~/Scripts/srm/srm-doc-forms.js"></script>
        <script>
            (function ($) {
                $(document).ready(function () {
                    $('.select2').select2();

                    var productRowIndex = 0;
                    var availableProducts = [];
                    var units = @Html.Raw(Json.Encode(unitsData));

                    function escapeHtml(text) { return srmDocLines.escapeHtml(text); }

                    function buildProductOptions(selectedId) { return srmExpenseForm.productOptions(availableProducts, selectedId); }

                    function buildUnitOptions(selectedId) { return srmDocLines.unitOptions(units, selectedId); }

                    function syncProductFields($row) { srmExpenseForm.syncProduct($row); }

                    function refreshProductSelects() { srmExpenseForm.refreshProductSelects(buildProductOptions, syncProductFields); }

                    function loadAvailableProducts(warehouseId) {
                        var receiverWarehouseId = $('#ReceiverWhID').val();
                        return $.ajax({
                            url: '@Url.Action("GetAvailableProducts", "Expenses")',
                            type: 'POST',
                            data: { warehouseId: warehouseId, receiverWarehouseId: receiverWarehouseId }
                        }).done(function (response) {
                            if (response.success) {
                                availableProducts = response.data || [];
                                refreshProductSelects();
                            } else {
                                alert('Xatolik: ' + response.message);
                            }
                        }).fail(function () {
                            alert('Server xatoligi yuz berdi');
                        });
                    }

                    $('#senderWarehouseSelect').on('change', function () {
                        var warehouseId = $(this).val();
                        if (warehouseId) {
                            $('#loadProductsBtn').show();
                            loadAvailableProducts(warehouseId);
                        } else {
                            $('#loadProductsBtn').hide();
                            availableProducts = [];
                            refreshProductSelects();
                        }
                    });

                    $('#loadProductsBtn').click(function () {
                        var warehouseId = $('#senderWarehouseSelect').val();
                        if (!warehouseId) {
                            alert('Yuboruvchi omborni tanlang');
                            return;
                        }
                        loadAvailableProducts(warehouseId);
                    });

                    $('#addRowBtn').click(function () {
                        if (!availableProducts || availableProducts.length === 0) {
                            alert('Avval yuboruvchi omborni tanlang va mahsulotlarni yuklang.');
                            return;
                        }
                        addProductRow(null, '', '', 0, null, 0, 0, '');
                    });

                    // Lot tanlanmaydi: chiqim har doim sof FIFO (eng eski partiyadan) — serverda avtomatik (SRM-B13)
                    function addProductRow(productId, productPNo, productName, availableStock, unitId, piecePrice, totalPrice, comment) {
                        var row = '<tr data-row-index="' + productRowIndex + '">' +
                            '<td>' +
                                '<select name="ExpenseProducts[' + productRowIndex + '].ProductID" class="form-control product-select select2" required>' +
                                    buildProductOptions(productId) +
                                '</select>' +
                                '<input type="hidden" name="ExpenseProducts[' + productRowIndex + '].ProductPNo" class="product-pno" value="' + escapeHtml(productPNo || '') + '" />' +
                            '</td>' +
                            '<td>' +
                                '<input type="text" class="form-control product-name-display" value="' + escapeHtml(productName || '') + '" disabled />' +
                                '<input type="hidden" name="ExpenseProducts[' + productRowIndex + '].ProductName" class="product-name" value="' + escapeHtml(productName || '') + '" />' +
                            '</td>' +
                            '<td><input type="number" name="ExpenseProducts[' + productRowIndex + '].AvailableStock" class="form-control available-stock" value="' + (availableStock || 0) + '" readonly /></td>' +
                            '<td><input type="number" name="ExpenseProducts[' + productRowIndex + '].Amount" class="form-control amount-input" value="0" step="0.01" min="0" max="' + (availableStock || 0) + '" required /></td>' +
                            '<td>' +
                                '<select name="ExpenseProducts[' + productRowIndex + '].UnitID" class="form-control unit-select select2" required>' +
                                    buildUnitOptions(unitId) +
                                '</select>' +
                            '</td>' +
                            '<td><input type="number" name="ExpenseProducts[' + productRowIndex + '].PiecePrice" class="form-control price-input" value="' + (piecePrice || 0) + '" step="0.01" min="0" readonly title="Saqlashda FIFO tannarxi bilan hisoblanadi" /></td>' +
                            '<td><input type="number" name="ExpenseProducts[' + productRowIndex + '].TotalPrice" class="form-control total-price" value="0" readonly /></td>' +
                            '<td><input type="text" name="ExpenseProducts[' + productRowIndex + '].Comment" class="form-control" value="' + escapeHtml(comment || '') + '" /></td>' +
                            '<td><button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button></td>' +
                            '</tr>';

                        $('#expenseProductsTable tbody').append(row);
                        var $row = $('#expenseProductsTable tbody tr').last();

                        if (typeof $.fn.select2 !== 'undefined') {
                            $row.find('select.product-select').select2();
                            $row.find('select.unit-select').select2();
                        }

                        syncProductFields($row);
                        productRowIndex++;
                    }

                    $(document).on('click', '.remove-row', function () {
                        $(this).closest('tr').remove();
                        updateTotal();
                    });

                    $(document).on('change', '.product-select', function () {
                        var $row = $(this).closest('tr');
                        syncProductFields($row);
                    });

                    $(document).on('input', '.amount-input, .price-input', function () {
                        var $row = $(this).closest('tr');
                        var amount = parseFloat($row.find('.amount-input').val()) || 0;
                        var availableStock = parseFloat($row.find('.available-stock').val()) || 0;
                        var price = parseFloat($row.find('.price-input').val()) || 0;

                        if (amount > availableStock) {
                            alert('Chiqim miqdori mavjud qoldiqdan oshib ketdi!');
                            $row.find('.amount-input').val(availableStock);
                            amount = availableStock;
                        }

                        var total = amount * price;
                        $row.find('.total-price').val(total.toFixed(2));
                        updateTotal();
                    });

                    function updateTotal() { srmDocLines.updateTotal(); }

                    $('#expenseForm').submit(function (e) {
                        if ($('#expenseProductsTable tbody tr').length === 0) {
                            e.preventDefault();
                            alert('Kamida bitta mahsulot qo\'shilishi kerak');
                            return false;
                        }

                        var isValid = true;
                        $('#expenseProductsTable tbody tr').each(function () {
                            var amount = parseFloat($(this).find('.amount-input').val()) || 0;
                            var availableStock = parseFloat($(this).find('.available-stock').val()) || 0;

                            if (amount > availableStock) {
                                isValid = false;
                                alert('Chiqim miqdori mavjud qoldiqdan oshib ketdi!');
                            }
                        });

                        if (!isValid) {
                            e.preventDefault();
                            return false;
                        }
                    });
                });
            })(jQuery);
        </script>
    }
}
