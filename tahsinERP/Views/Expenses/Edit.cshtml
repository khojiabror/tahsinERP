@model tahsinERP.ViewModels.ExpenseEditViewModel
@{
    ViewBag.Title = "Chiqim hujjatini tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Expenses"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Expenses/Index">Ombor chiqimlari</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Tahrirlash
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @if (TempData["Error"] != null)
                                        {
                                            <div class="alert alert-danger">
                                                @TempData["Error"]
                                            </div>
                                        }

                                        @using (Html.BeginForm("Edit", "Expenses", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form", @id = "expenseForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(model => model.ID)
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row">
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="DocNo">Hujjat raqami</label>
                                                    @Html.TextBoxFor(model => model.DocNo, new { @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.DocNo, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="IssueDateTime">Sana va vaqt</label>
                                                    @Html.TextBoxFor(model => model.IssueDateTime, "{0:yyyy-MM-ddTHH:mm}", new { @type = "datetime-local", @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.IssueDateTime, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="SenderWHID">Yuboruvchi ombor</label>
                                                    @Html.DropDownListFor(model => model.SenderWHID, ViewBag.SenderWarehouses as SelectList, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.SenderWHID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="ReceiverWhID">Qabul qiluvchi ombor</label>
                                                    @Html.DropDownListFor(model => model.ReceiverWhID, ViewBag.ReceiverWarehouses as SelectList, "---Tanlang---", new { @class = "form-control select2" })
                                                    @Html.ValidationMessageFor(model => model.ReceiverWhID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="CurrencyID">Valyuta</label>
                                                    @Html.DropDownListFor(model => model.CurrencyID, ViewBag.Currencies as SelectList, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-9 col-12 form-group">
                                                    <label for="Description">Izoh</label>
                                                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = "2" })
                                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-6 col-12 form-group">
                                                    <label for="expenseFile">Yangi chiqim hujjati (PDF) - mavjud hujjat o'rniga qo'yiladi</label>
                                                    <input type="file" name="expenseFile" id="expenseFile" class="form-control" accept=".pdf" />
                                                </div>
                                            </div>

                                            <br />
                                            <h5>Chiqim mahsulotlari</h5>
                                            
                                            <div class="table-responsive">
                                                <table id="expenseProductsTable" class="table table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>Mahsulot ID</th>
                                                            <th>Mahsulot kodi</th>
                                                            <th>Mahsulot nomi</th>
                                                            <th>Chiqim miqdori</th>
                                                            <th>Birlik ID</th>
                                                            <th>Dona narxi</th>
                                                            <th>Jami</th>
                                                            <th>Izoh</th>
                                                            <th>Amallar</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (Model.ExpenseProducts != null)
                                                        {
                                                            for (int i = 0; i < Model.ExpenseProducts.Count; i++)
                                                            {
                                                                var product = Model.ExpenseProducts[i];
                                                                <tr data-row-index="@i">
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.ExpenseProducts[i].ProductID, new { @type = "number", @class = "form-control", @required = "required" })
                                                                        @Html.HiddenFor(m => m.ExpenseProducts[i].ID)
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.ExpenseProducts[i].ProductPNo, new { @class = "form-control", @readonly = "readonly" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.ExpenseProducts[i].ProductName, new { @class = "form-control", @readonly = "readonly" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.ExpenseProducts[i].Amount, new { @type = "number", @class = "form-control amount-input", @step = "0.01", @min = "0", @required = "required" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.ExpenseProducts[i].UnitID, new { @type = "number", @class = "form-control", @required = "required" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.ExpenseProducts[i].PiecePrice, new { @type = "number", @class = "form-control price-input", @step = "0.01", @min = "0" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.ExpenseProducts[i].TotalPrice, new { @type = "number", @class = "form-control total-price", @readonly = "readonly" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.ExpenseProducts[i].Comment, new { @class = "form-control" })
                                                                    </td>
                                                                    <td>
                                                                        <button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="6" class="text-right"><strong>Jami:</strong></td>
                                                            <td id="totalAmount" class="text-right"><strong>@(Model.TotalPrice?.ToString("N2") ?? "0.00")</strong></td>
                                                            <td colspan="2"></td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>

                                            <div class="row mt-2">
                                                <div class="col-12">
                                                    <button type="button" class="btn btn-outline-primary" id="addRowBtn">
                                                        <i class="bx bx-plus"></i> Qo'shish
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-12">
                                                    <button type="submit" class="btn btn-success">
                                                        <i class="bx bx-save"></i> Saqlash
                                                    </button>
                                                    <a href="@Url.Action("Index", "Expenses")" class="btn btn-secondary">
                                                        <i class="bx bx-x"></i> Bekor qilish
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $('.select2').select2();

            var productRowIndex = @(Model.ExpenseProducts?.Count ?? 0);

            // Calculate totals for existing rows
            $('.amount-input, .price-input').each(function () {
                var $row = $(this).closest('tr');
                var amount = parseFloat($row.find('.amount-input').val()) || 0;
                var price = parseFloat($row.find('.price-input').val()) || 0;
                var total = amount * price;
                $row.find('.total-price').val(total.toFixed(2));
            });
            updateTotal();

            $('#addRowBtn').click(function () {
                var row = '<tr data-row-index="' + productRowIndex + '">' +
                    '<td><input type="number" name="ExpenseProducts[' + productRowIndex + '].ProductID" class="form-control" required /></td>' +
                    '<td><input type="text" name="ExpenseProducts[' + productRowIndex + '].ProductPNo" class="form-control" readonly /></td>' +
                    '<td><input type="text" name="ExpenseProducts[' + productRowIndex + '].ProductName" class="form-control" readonly /></td>' +
                    '<td><input type="number" name="ExpenseProducts[' + productRowIndex + '].Amount" class="form-control amount-input" step="0.01" min="0" required /></td>' +
                    '<td><input type="number" name="ExpenseProducts[' + productRowIndex + '].UnitID" class="form-control" required /></td>' +
                    '<td><input type="number" name="ExpenseProducts[' + productRowIndex + '].PiecePrice" class="form-control price-input" step="0.01" min="0" /></td>' +
                    '<td><input type="number" name="ExpenseProducts[' + productRowIndex + '].TotalPrice" class="form-control total-price" readonly /></td>' +
                    '<td><input type="text" name="ExpenseProducts[' + productRowIndex + '].Comment" class="form-control" /></td>' +
                    '<td><button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button></td>' +
                    '<input type="hidden" name="ExpenseProducts[' + productRowIndex + '].ID" value="" />' +
                    '</tr>';

                $('#expenseProductsTable tbody').append(row);
                productRowIndex++;
            });

            $(document).on('click', '.remove-row', function () {
                $(this).closest('tr').remove();
                updateTotal();
            });

            $(document).on('input', '.amount-input, .price-input', function () {
                var $row = $(this).closest('tr');
                var amount = parseFloat($row.find('.amount-input').val()) || 0;
                var price = parseFloat($row.find('.price-input').val()) || 0;
                var total = amount * price;
                $row.find('.total-price').val(total.toFixed(2));
                updateTotal();
            });

            function updateTotal() {
                var total = 0;
                $('.total-price').each(function () {
                    total += parseFloat($(this).val()) || 0;
                });
                $('#totalAmount').text(total.toFixed(2));
            }
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
