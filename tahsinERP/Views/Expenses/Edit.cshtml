@model tahsinERP.ViewModels.ExpenseEditViewModel
@using System.Collections.Generic
@{
    ViewBag.Title = L.T("Wh_Exp_EditTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var unitsList = ViewBag.Units as SelectList;
    var unitsData = new List<object>();

    if (unitsList != null)
    {
        foreach (SelectListItem item in unitsList)
        {
            unitsData.Add(new { Value = item.Value, Text = item.Text });
        }
    }
}

@* Ruxsat controller action'ida tekshiriladi (SRM-M05). *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Expenses/Index">@L.T("Wh_ExpListTitle")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Edit")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @if (TempData["Error"] != null)
                                        {
                                            <div class="alert alert-danger">
                                                @TempData["Error"]
                                            </div>
                                        }

                                        @using (Html.BeginForm("Edit", "Expenses", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form", @id = "expenseForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(model => model.ID)
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row">
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="DocNo">@L.T("Wh_DocNo")</label>
                                                    @Html.TextBoxFor(model => model.DocNo, new { @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.DocNo, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="IssueDateTime">@L.T("Wh_DateTime")</label>
                                                    @Html.TextBoxFor(model => model.IssueDateTime, "{0:yyyy-MM-ddTHH:mm}", new { @type = "datetime-local", @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.IssueDateTime, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="SenderWHID">@L.T("Wh_SenderWarehouse")</label>
                                                    @Html.DropDownListFor(model => model.SenderWHID, ViewBag.SenderWarehouses as SelectList, L.T("Wh_SelectDashed"), new { @class = "form-control select2", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.SenderWHID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="ReceiverWhID">@L.T("Wh_ReceiverWarehouse")</label>
                                                    @Html.DropDownListFor(model => model.ReceiverWhID, ViewBag.ReceiverWarehouses as SelectList, L.T("Wh_SelectDashed"), new { @class = "form-control select2" })
                                                    @Html.ValidationMessageFor(model => model.ReceiverWhID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="CurrencyID">@L.T("Currency")</label>
                                                    @Html.DropDownListFor(model => model.CurrencyID, ViewBag.Currencies as SelectList, L.T("Wh_SelectDashed"), new { @class = "form-control select2", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-9 col-12 form-group">
                                                    <label for="Description">@L.T("Comment")</label>
                                                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = "2" })
                                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-6 col-12 form-group">
                                                    <label for="expenseFile">@L.T("Wh_Exp_NewDocPdf")</label>
                                                    <input type="file" name="expenseFile" id="expenseFile" class="form-control" accept=".pdf" />
                                                </div>
                                            </div>

                                            <br />
                                            <h5>@L.T("Wh_Exp_Products")</h5>
                                            
                                            <div class="table-responsive">
                                                <table id="expenseProductsTable" class="table table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>@L.T("Wh_Product")</th>
                                                            <th>@L.T("Wh_ProductName")</th>
                                                            <th>@L.T("Wh_AvailableStock")</th>
                                                            <th>@L.T("Wh_Exp_Qty")</th>
                                                            <th>@L.T("Unit")</th>
                                                            <th title="@L.T("Wh_Exp_FifoCostHint")">@L.T("Wh_Exp_FifoCost")</th>
                                                            <th>@L.T("Total")</th>
                                                            <th>@L.T("Comment")</th>
                                                            <th>@L.T("Actions")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (Model.ExpenseProducts != null)
                                                        {
                                                            for (int i = 0; i < Model.ExpenseProducts.Count; i++)
                                                            {
                                                                var product = Model.ExpenseProducts[i];
                                                                <tr data-row-index="@i">
                                                                    <td>
                                                                        <select name="ExpenseProducts[@i].ProductID" class="form-control product-select select2" required>
                                                                            <option value="@product.ProductID" selected>@product.ProductPNo - @product.ProductName</option>
                                                                        </select>
                                                                        @Html.HiddenFor(m => m.ExpenseProducts[i].ProductPNo, new { @class = "product-pno" })
                                                                        @Html.HiddenFor(m => m.ExpenseProducts[i].ID)
                                                                    </td>
                                                                    <td>
                                                                        <input type="text" class="form-control product-name-display" value="@product.ProductName" disabled />
                                                                        @Html.HiddenFor(m => m.ExpenseProducts[i].ProductName, new { @class = "product-name" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.ExpenseProducts[i].AvailableStock, "{0:0.######}", new { @type = "number", @class = "form-control available-stock", @readonly = "readonly" })
                                                                    </td>

                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.ExpenseProducts[i].Amount, "{0:0.######}", new { @type = "number", @class = "form-control amount-input", @step = "0.01", @min = "0", @required = "required" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.DropDownListFor(m => m.ExpenseProducts[i].UnitID, ViewBag.Units as SelectList, L.T("Wh_SelectDashed"), new { @class = "form-control unit-select select2", @required = "required" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.ExpenseProducts[i].PiecePrice, "{0:0.######}", new { @type = "number", @class = "form-control price-input", @step = "0.01", @min = "0", @readonly = "readonly", @title = L.T("Wh_Exp_FifoRecalcHint") })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.ExpenseProducts[i].TotalPrice, "{0:0.############}", new { @type = "number", @class = "form-control total-price", @readonly = "readonly" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.ExpenseProducts[i].Comment, new { @class = "form-control" })
                                                                    </td>
                                                                    <td>
                                                                        <button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="6" class="text-right"><strong>@L.T("Wh_TotalColon")</strong></td>
                                                            <td id="totalAmount" class="text-right"><strong>@(Model.TotalPrice?.ToString("N2") ?? "0.00")</strong></td>
                                                            <td colspan="2"></td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>

                                            @Html.Partial("~/Views/Incomes/_DocFormActions.cshtml", "Expenses")
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section scripts {
        <script src="~/Scripts/srm/srm-doc-lines.js"></script>
        <script src="~/Scripts/srm/srm-doc-forms.js"></script>
        <script>
            (function ($) {
                $(document).ready(function () {
                    $('.select2').select2();

                    var productRowIndex = @(Model.ExpenseProducts?.Count ?? 0);
                    var availableProducts = [];
                    var units = @Html.Raw(Json.Encode(unitsData));
                    var existingProducts = @Html.Raw(Json.Encode(Model.ExpenseProducts ?? new List<tahsinERP.ViewModels.ExpenseProductViewModel>()));

                    function escapeHtml(text) { return srmDocLines.escapeHtml(text); }

                    function buildProductOptions(selectedId) { return srmExpenseForm.productOptions(availableProducts, selectedId); }

                    function buildUnitOptions(selectedId) { return srmDocLines.unitOptions(units, selectedId); }

                    function mergeExistingProducts() {
                        existingProducts.forEach(function (product) {
                            var exists = availableProducts.some(function (p) { return p.ProductID == product.ProductID; });
                            if (!exists) {
                                availableProducts.push({
                                    ProductID: product.ProductID,
                                    ProductPNo: product.ProductPNo || '',
                                    ProductName: product.ProductName || '',
                                    AvailableStock: product.AvailableStock || 0,
                                    UnitID: product.UnitID || '',
                                    UnitName: product.UnitName || ''
                                });
                            }
                        });
                    }

                    function syncProductFields($row) { srmExpenseForm.syncProduct($row); }

                    function refreshProductSelects() { srmExpenseForm.refreshProductSelects(buildProductOptions, syncProductFields); }

                    // Lot tanlanmaydi: chiqim har doim sof FIFO (eng eski partiyadan) — serverda avtomatik (SRM-B13)
                    function loadAvailableProducts(warehouseId) {
                        return $.ajax({
                            url: '@Url.Action("GetAvailableProducts", "Expenses")',
                            type: 'POST',
                            data: { warehouseId: warehouseId, receiverWarehouseId: $('#ReceiverWhID').val() }
                        }).done(function (response) {
                            if (response.success) {
                                availableProducts = response.data || [];
                                mergeExistingProducts();
                                refreshProductSelects();
                            } else {
                                alert('@L.Js("Wh_ErrorPrefix") ' + response.message);
                            }
                        }).fail(function () {
                            alert('@L.Js("Wh_ServerErrorOccurred")');
                        });
                    }

                    // Calculate totals for existing rows
                    $('.amount-input, .price-input').each(function () {
                        var $row = $(this).closest('tr');
                        var amount = parseFloat($row.find('.amount-input').val()) || 0;
                        var price = parseFloat($row.find('.price-input').val()) || 0;
                        var total = amount * price;
                        $row.find('.total-price').val(total.toFixed(2));
                    });

                    updateTotal();

                    $('#senderWarehouseSelect').on('change', function () {
                        var warehouseId = $(this).val();
                        if (warehouseId) {
                            loadAvailableProducts(warehouseId);
                        } else {
                            availableProducts = [];
                            refreshProductSelects();
                        }
                    });

                    var initialWarehouseId = $('#senderWarehouseSelect').val();
                    if (initialWarehouseId) {
                        loadAvailableProducts(initialWarehouseId);
                    }

                    $('#addRowBtn').click(function () {
                        if (!availableProducts || availableProducts.length === 0) {
                            alert('@L.Js("Wh_Exp_SelectSenderFirst")');
                            return;
                        }
                        var row = '<tr data-row-index="' + productRowIndex + '">' +
                            '<td>' +
                                '<select name="ExpenseProducts[' + productRowIndex + '].ProductID" class="form-control product-select select2" required>' +
                                    buildProductOptions(null) +
                                '</select>' +
                                '<input type="hidden" name="ExpenseProducts[' + productRowIndex + '].ProductPNo" class="product-pno" value="" />' +
                            '</td>' +
                            '<td>' +
                                '<input type="text" class="form-control product-name-display" value="" disabled />' +
                                '<input type="hidden" name="ExpenseProducts[' + productRowIndex + '].ProductName" class="product-name" value="" />' +
                            '</td>' +
                            '<td><input type="number" name="ExpenseProducts[' + productRowIndex + '].AvailableStock" class="form-control available-stock" value="0" readonly /></td>' +

                            '<td><input type="number" name="ExpenseProducts[' + productRowIndex + '].Amount" class="form-control amount-input" step="0.01" min="0" required /></td>' +
                            '<td>' +
                                '<select name="ExpenseProducts[' + productRowIndex + '].UnitID" class="form-control unit-select select2" required>' +
                                    buildUnitOptions(null) +
                                '</select>' +
                            '</td>' +
                            '<td><input type="number" name="ExpenseProducts[' + productRowIndex + '].PiecePrice" class="form-control price-input" step="0.01" min="0" readonly title="@L.Js("Wh_Exp_FifoPriceHint")" /></td>' +
                            '<td><input type="number" name="ExpenseProducts[' + productRowIndex + '].TotalPrice" class="form-control total-price" readonly /></td>' +
                            '<td><input type="text" name="ExpenseProducts[' + productRowIndex + '].Comment" class="form-control" /></td>' +
                            '<td><button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button></td>' +
                            '<input type="hidden" name="ExpenseProducts[' + productRowIndex + '].ID" value="" />' +
                            '</tr>';

                        $('#expenseProductsTable tbody').append(row);
                        var $row = $('#expenseProductsTable tbody tr').last();

                        if (typeof $.fn.select2 !== 'undefined') {
                            $row.find('select.product-select').select2();
                            $row.find('select.unit-select').select2();
                        }

                        syncProductFields($row);
                        productRowIndex++;
                    });

                    $(document).on('click', '.remove-row', function () {
                        $(this).closest('tr').remove();
                        updateTotal();
                    });

                    $(document).on('change', '.product-select', function () {
                        var $row = $(this).closest('tr');
                        syncProductFields($row);
                    });

                    $(document).on('input', '.amount-input, .price-input', function () {
                        var $row = $(this).closest('tr');
                        var amount = parseFloat($row.find('.amount-input').val()) || 0;
                        var availableStock = parseFloat($row.find('.available-stock').val()) || 0;
                        var price = parseFloat($row.find('.price-input').val()) || 0;

                        if (amount > availableStock) {
                            alert('@L.Js("Wh_Exp_QtyExceedsStock")');
                            $row.find('.amount-input').val(availableStock);
                            amount = availableStock;
                        }

                        var total = amount * price;
                        $row.find('.total-price').val(total.toFixed(2));
                        updateTotal();
                    });

                    function updateTotal() { srmDocLines.updateTotal(); }
                });
            })(jQuery);
        </script>
    }
}
