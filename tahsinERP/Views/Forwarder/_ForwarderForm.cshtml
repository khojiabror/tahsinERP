@model tahsinERP.Models.FORWARDER
@* Yuk tashuvchi formasi — Create va Edit uchun bitta (LOG-D02). Ruxsat [Permission] filtrida tekshiriladi. *@
@{
    bool isEdit = Model != null && Model.ID > 0;
}
@using (Html.BeginForm(isEdit ? "Edit" : "Create", "Forwarder", FormMethod.Post))
{
    if (isEdit)
    {
        @Html.HiddenFor(model => model.ID)
    }
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Forwarder/Index">@L.T("Log_Forwarders")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @(isEdit ? L.T("Log_ForwarderEditTitle") : L.T("Log_NewForwarder"))
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="basic-select2">
                    <div class="row">
                        <div class="col-xl-9 col-md-8 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row">
                                            <div class="col-lg-12 col-md-6 mt-25">
                                                @Html.AntiForgeryToken()
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                <hr>
                                                
                                                <h4 class="text-primary">@L.T("Log_ForwarderName")</h4>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.ForwarderName, new { @class = "form-control round", @placeholder = L.T("Log_ForwarderName") })
                                                    @Html.ValidationMessageFor(model => model.ForwarderName, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">@L.T("Log_Director")</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.Director, new { @class = "form-control round", @placeholder = L.T("Log_Director") })
                                                    @Html.ValidationMessageFor(model => model.Director, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <br />
                                                <h6 class="invoice-to">@L.T("Log_ContactPerson")</h6>
                                                <fieldset class="form-group">
                                                    @Html.TextBoxFor(model => model.ContactPerson, new { @class = "form-control round", @placeholder = L.T("Log_ContactPerson") })
                                                    @Html.ValidationMessageFor(model => model.ContactPerson, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <br />
                                                <h6 class="invoice-to">@L.T("Log_ShortDescription")</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.Description, new { @class = "form-control round", @placeholder = L.T("Log_DescriptionPh") })
                                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                </fieldset>

                                                <ul class="list-group list-group-flush">
                                                    <li class="list-group-item border-0 pb-0">
                                                        <button class="btn btn-primary btn-block subtotal-preview-btn" type="submit">
                                                            <i class='bx bx-save'></i>
                                                            @L.T("Save")
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                        <hr>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
