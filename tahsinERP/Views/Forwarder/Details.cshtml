@model tahsinERP.ViewModels.ForwarderStatisticsViewModel
@{
    ViewBag.Title = L.T("Log_ForwarderDetailsTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()); }

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/Forwarder/Index">@L.T("Log_Forwarders")</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Log_ForwarderDetailsTitle")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            @Html.Partial("~/Views/Logistic/Shared/_CurrencyNote.cshtml")
            <div class="row">
                <!-- Forwarder Information -->
                <div class="col-xl-12 col-md-12 col-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h4 class="text-primary">@L.T("Log_ForwarderInfo")</h4>
                                    @if (changePermit)
                                    {
                                        <a href="@Url.Action("Edit", "Forwarder", new { id = Model.Forwarder.ID })" class="btn btn-sm btn-outline-primary">
                                            <i class="bx bx-edit"></i> @L.T("Edit")
                                        </a>
                                    }
                                </div>
                                <hr>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p><strong>@L.T("Log_ForwarderName"):</strong> @Model.Forwarder.ForwarderName</p>
                                        <p><strong>@L.T("Log_Director"):</strong> @(Model.Forwarder.Director ?? "")</p>
                                        <p><strong>@L.T("Log_ContactPerson"):</strong> @(Model.Forwarder.ContactPerson ?? "")</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>@L.T("Log_ShortDescription"):</strong></p>
                                        <p>@(Model.Forwarder.Description ?? "")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Statistics Cards -->
                <div class="col-xl-12 col-md-12 col-12 mt-2">
                    <div class="row">
                        <div class="col-xl-3 col-md-6 col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-0">@L.T("Log_TotalTrips")</h6>
                                            <h3 class="mb-0">@Model.TotalTrips</h3>
                                        </div>
                                        <div class="avatar bg-light-primary">
                                            <i class="bx bx-truck font-medium-5"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6 col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-0">@L.T("Log_TotalTonnage")</h6>
                                            <h3 class="mb-0">@Model.TotalTonnage.ToString("N2")</h3>
                                        </div>
                                        <div class="avatar bg-light-success">
                                            <i class="bx bx-package font-medium-5"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6 col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-0">@L.T("Log_TotalCost")</h6>
                                            <h3 class="mb-0">@Model.TotalCost.ToString("N2")</h3>
                                        </div>
                                        <div class="avatar bg-light-warning">
                                            <i class="bx bx-dollar font-medium-5"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6 col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-0">@L.T("Log_Debt")</h6>
                                            <h3 class="mb-0">@Model.UnpaidAmount.ToString("N2")</h3>
                                        </div>
                                        <div class="avatar bg-light-danger">
                                            <i class="bx bx-money font-medium-5"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Trip Breakdown -->
                <div class="col-xl-6 col-md-12 col-12 mt-2">
                    <div class="card">
                        <div class="card-header">
                            <h5>@L.T("Log_ByTrips")</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-4">
                                    <h4 class="text-info">@Model.InboundTrips</h4>
                                    <p class="mb-0">@L.T("Log_Dir_Inbound")</p>
                                </div>
                                <div class="col-4">
                                    <h4 class="text-success">@Model.OutboundTrips</h4>
                                    <p class="mb-0">@L.T("Log_Dir_Outbound")</p>
                                </div>
                                <div class="col-4">
                                    <h4 class="text-secondary">@Model.InternalTrips</h4>
                                    <p class="mb-0">@L.T("Log_Dir_Internal")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Performance Metrics -->
                <div class="col-xl-6 col-md-12 col-12 mt-2">
                    <div class="card">
                        <div class="card-header">
                            <h5>@L.T("Log_AverageMetrics")</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <tr>
                                    <td>@L.T("Log_Per1Km"):</td>
                                    <td><strong>@Model.AverageCostPerKm.ToString("N2")</strong></td>
                                </tr>
                                <tr>
                                    <td>@L.T("Log_Per1Ton"):</td>
                                    <td><strong>@Model.AverageCostPerTon.ToString("N2")</strong></td>
                                </tr>
                                <tr>
                                    <td>@L.T("Log_Per1Trip"):</td>
                                    <td><strong>@Model.AverageCostPerTrip.ToString("N2")</strong></td>
                                </tr>
                                <tr>
                                    <td>@L.T("Log_Per1Cbm"):</td>
                                    <td><strong>@Model.AverageCostPerCBM.ToString("N2")</strong></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- OTIF Performance -->
                @if (Model.TotalDeliveries > 0)
                {
                    <div class="col-xl-12 col-md-12 col-12 mt-2">
                        <div class="card">
                            <div class="card-header">
                                <h5>@L.T("Log_OtifIndicator")</h5>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-4">
                                        <h4 class="text-success">@Model.OnTimeDeliveries</h4>
                                        <p class="mb-0">@L.T("Log_OnTime")</p>
                                    </div>
                                    <div class="col-4">
                                        <h4 class="text-danger">@Model.LateDeliveries</h4>
                                        <p class="mb-0">@L.T("Log_Late")</p>
                                    </div>
                                    <div class="col-4">
                                        <h4 class="text-primary">@Model.OTIFPercentage.ToString("N1")%</h4>
                                        <p class="mb-0">@L.T("Log_OtifPercent")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Top Lanes -->
                @if (Model.TopLanes != null && Model.TopLanes.Any())
                {
                    <div class="col-xl-12 col-md-12 col-12 mt-2">
                        <div class="card">
                            <div class="card-header">
                                <h5>@L.T("Log_TopLanes")</h5>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Log_From")</th>
                                                <th>@L.T("Log_To")</th>
                                                <th>@L.T("Log_TripCount")</th>
                                                <th>@L.T("Log_TotalTonnage")</th>
                                                <th>@L.T("Log_TotalCost")</th>
                                                <th>@L.T("Log_Per1Ton")</th>
                                                <th>@L.T("Log_Per1Km")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var lane in Model.TopLanes)
                                            {
                                                <tr>
                                                    <td>@lane.FromLocation</td>
                                                    <td>@lane.ToLocation</td>
                                                    <td>@lane.TripCount</td>
                                                    <td>@lane.TotalTonnage.ToString("N2")</td>
                                                    <td>@lane.TotalCost.ToString("N2")</td>
                                                    <td>@lane.AvgCostPerTon.ToString("N2")</td>
                                                    <td>@lane.AvgCostPerKm.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Bog'liq hujjatlar -->
                <div class="col-xl-12 col-md-12 col-12 mt-2">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="text-primary">@L.T("Log_RelatedDocs")</h5>
                        </div>
                        <div class="card-body">
                            <a href="@Url.Action("Index", "FContract", new { forwarderID = Model.Forwarder.ID })" class="btn btn-outline-primary">
                                <i class="bx bx-file"></i> @L.T("Log_ContractsWithRecon")
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Active Contracts -->
                @if (Model.ActiveContracts != null && Model.ActiveContracts.Any())
                {
                    <div class="col-xl-6 col-md-12 col-12 mt-2">
                        <div class="card">
                            <div class="card-header">
                                <h5>@L.T("Log_ActiveContracts")</h5>
                            </div>
                            <div class="card-body">
                                <ul class="list-group">
                                    @foreach (var contract in Model.ActiveContracts)
                                    {
                                        <li class="list-group-item">
                                            <a href="@Url.Action("Details", "FContract", new { ID = contract.ID })">
                                                @contract.ContractNo
                                            </a>
                                            <span class="float-right">@contract.DueDate.ToString("dd.MM.yyyy")</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }

                <!-- Recent Yo'l varaqalari -->
                @if (Model.RecentWaybills != null && Model.RecentWaybills.Any())
                {
                    <div class="col-xl-6 col-md-12 col-12 mt-2">
                        <div class="card">
                            <div class="card-header">
                                <h5>@L.T("Log_RecentWaybills")</h5>
                            </div>
                            <div class="card-body">
                                <ul class="list-group">
                                    @foreach (var waybill in Model.RecentWaybills)
                                    {
                                        <li class="list-group-item">
                                            <a href="@Url.Action("Details", "Waybill", new { ID = waybill.ID })">
                                                @waybill.WaybillNo
                                            </a>
                                            <span class="float-right">@(waybill.IssueDate?.ToString("dd.MM.yyyy") ?? "")</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
