        <!-- Menu Active State Handler -->
        <script>
            $(document).ready(function () {
                var currentPath = window.location.pathname.toLowerCase();
                var currentController = '@(ViewContext?.RouteData?.Values["controller"]?.ToString() ?? "")'.toLowerCase();
                var currentAction = '@(ViewContext?.RouteData?.Values["action"]?.ToString() ?? "")'.toLowerCase();

                // Helper function to normalize URL
                function normalizeUrl(url) {
                    if (!url) return '';
                    url = url.toLowerCase().replace(/^~/, '').replace(/\/$/, '');
                    // Remove /index from end
                    if (url.endsWith('/index')) {
                        url = url.replace('/index', '');
                    }
                    return url;
                }

                // Helper function to check if URLs match - faqat to'liq segment match
                function urlsMatch(current, link) {
                    var normalizedLink = normalizeUrl(link);
                    var normalizedCurrent = normalizeUrl(current);

                    // Agar link bo'sh bo'lsa, match qilmaydi
                    if (!normalizedLink || normalizedLink === '') {
                        return false;
                    }

                    // 1. To'liq exact match (eng ustun)
                    if (normalizedCurrent === normalizedLink) {
                        return true;
                    }

                    // 2. Current path link bilan boshlanadi va keyin / yoki end bo'lsa
                    // Masalan: /TannarxAnalytics/Dashboard /Tannarx bilan match bo'lmasligi kerak
                    // Lekin /Tannarx /Tannarx bilan match bo'lishi kerak
                    if (normalizedCurrent.startsWith(normalizedLink + '/')) {
                        // Keyingi segment to'liq bo'lishi kerak
                        // Masalan: /TannarxAnalytics /Tannarx bilan match bo'lmasligi kerak
                        return true; // Agar / bilan ajratilgan bo'lsa, to'liq segment
                    }

                    // 3. Link current path bilan boshlanadi va keyin / yoki end bo'lsa
                    if (normalizedLink.startsWith(normalizedCurrent + '/')) {
                        return true; // Agar / bilan ajratilgan bo'lsa, to'liq segment
                    }

                    return false;
                }

                // Barcha menu linklarini tekshirish
                var foundMatch = false;
                $('#main-menu-navigation a').each(function () {
                    var $link = $(this);
                    var href = $link.attr('href');

                    if (href && urlsMatch(currentPath, href)) {
                        var $li = $link.closest('li');
                        $li.addClass('active');
                        foundMatch = true;

                        // Parent menu item'larni ham open qilish
                        var $parentUl = $li.closest('ul');
                        if ($parentUl.length > 0 && $parentUl.attr('class') === 'menu-content') {
                            var $parentLi = $parentUl.closest('li');
                            if ($parentLi.length > 0) {
                                $parentLi.addClass('open active');
                            }
                        }
                    }
                });

                // Agar hech qanday match topilmasa, controller nomiga qarab qidirish
                // Lekin faqat to'liq controller nomi bilan match bo'lishi kerak
                if (!foundMatch && currentController) {
                    $('#main-menu-navigation a').each(function () {
                        var $link = $(this);
                        var href = $link.attr('href') || '';
                        href = normalizeUrl(href);

                        // Faqat to'liq controller nomi bilan match
                        // Masalan: /TannarxAnalytics /Tannarx bilan match bo'lmasligi kerak
                        var controllerPath = '/' + currentController;
                        if (href === controllerPath ||
                            href === controllerPath + '/index' ||
                            href.startsWith(controllerPath + '/')) {
                            // Lekin keyingi segment to'liq bo'lishi kerak
                            var remainingPath = href.substring(controllerPath.length);
                            if (remainingPath === '' || remainingPath.startsWith('/')) {
                                var $li = $link.closest('li');
                                $li.addClass('active');

                                // Parent menu item'larni ham open qilish
                                var $parentUl = $li.closest('ul');
                                if ($parentUl.length > 0 && $parentUl.attr('class') === 'menu-content') {
                                    var $parentLi = $parentUl.closest('li');
                                    if ($parentLi.length > 0) {
                                        $parentLi.addClass('open active');
                                    }
                                }
                            }
                        }
                    });
                }
            });
        </script>
    }
    else
    {
        Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
    }
</body>
</html>
