    <!-- Custom Styles for iPack Branding - Green Theme -->
    <style>
        /* To'q yashil rang - iPack korxonasi rangi */
        :root {
            --ipack-green: #198754;
            --ipack-green-light: rgba(25, 135, 84, 0.15);
            --ipack-green-hover: #157347;
            --ipack-green-dark: #146c43;
        }

        /* tahsinERP yozuvini to'q yashil rangga o'zgartirish */
        .main-menu .navbar-header .navbar-brand .brand-text {
            color: var(--ipack-green) !important;
        }

        /* Active menu item text color - yashil rang */
        .main-menu.menu-light .navigation > li.active:not(.sidebar-group-active) > a {
            color: var(--ipack-green) !important;
        }

        .main-menu.menu-light .navigation > li ul .active > a {
            color: var(--ipack-green) !important;
        }

            /* Active menu item icon rangi - yashil */
            .main-menu.menu-light .navigation > li.active:not(.sidebar-group-active) > a i,
            .main-menu.menu-light .navigation > li.active:not(.sidebar-group-active) > a .menu-livicon,
            .main-menu.menu-light .navigation > li ul .active > a i,
            .main-menu.menu-light .navigation > li ul .active > a .menu-livicon {
                color: var(--ipack-green) !important;
            }

        /* Active menu item background - yashil rang bilan */
        .main-menu.menu-light .navigation > li.active:not(.sidebar-group-active) > a {
            background: var(--ipack-green-light) !important;
        }

        .main-menu.menu-light .navigation > li ul .active {
            background: var(--ipack-green-light) !important;
        }

