        <script>
            (function () {
                function getOrientationByElementSize(element) {
                    if (!element) return 'portrait';
                    var width = Math.max(element.scrollWidth || 0, element.offsetWidth || 0, element.clientWidth || 0);
                    var height = Math.max(element.scrollHeight || 0, element.offsetHeight || 0, element.clientHeight || 0);
                    return width > (height * 1.05) ? 'landscape' : 'portrait';
                }

                function resolvePrintTarget() {
                    return document.querySelector('[data-print-target="true"]')
                        || document.getElementById('printArea')
                        || document.querySelector('.invoice-edit-wrapper')
                        || document.querySelector('.content-body')
                        || document.body;
                }

                function applyDynamicPrintPageStyle() {
                    var target = resolvePrintTarget();
                    var orientation = getOrientationByElementSize(target);
                    var styleId = 'erp-print-page-style';
                    var styleNode = document.getElementById(styleId);

                    if (!styleNode) {
                        styleNode = document.createElement('style');
                        styleNode.id = styleId;
                        document.head.appendChild(styleNode);
                    }

                    styleNode.textContent =
                        '@@media print { @@page { size: A4 ' + orientation + '; margin: 10mm; } ' +
                        'body { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; } }';

                    return orientation;
                }

                window.erpExportHelpers = window.erpExportHelpers || {};
                window.erpExportHelpers.getOrientationByElementSize = getOrientationByElementSize;
                window.erpExportHelpers.applyDynamicPrintPageStyle = applyDynamicPrintPageStyle;

                if (window.matchMedia) {
                    var printMedia = window.matchMedia('print');
                    if (printMedia && printMedia.addEventListener) {
                        printMedia.addEventListener('change', function (event) {
                            if (event.matches) {
                                applyDynamicPrintPageStyle();
                            }
                        });
                    }
                }

                window.addEventListener('beforeprint', function () {
                    applyDynamicPrintPageStyle();
                });

                if (typeof window.print === 'function') {
                    var nativePrint = window.print;
                    window.print = function () {
                        applyDynamicPrintPageStyle();
                        return nativePrint.apply(window, arguments);
                    };
                }
            })();
        </script>
