@using tahsinERP.Models;
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
    <title>@ViewData["Title"] - tahsinERP</title>
    <link rel="apple-touch-icon" href="~/app-assets/images/ico/apple-touch-icon.png">
    <link rel="shortcut icon" type="image/x-icon" href="~/app-assets/images/ico/favicon.ico">
    <link href="https://fonts.googleapis.com/css?family=Rubik:300,400,500,600%7CIBM+Plex+Sans:300,400,500,600,700" rel="stylesheet">

    <!-- Vendor CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/vendors.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/tables/datatable/datatables.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/tables/datatable/responsive.bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/forms/select/select2.min.css">
    
    <!-- Theme CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap-extended.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/colors.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/components.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/themes/dark-layout.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/themes/semi-dark-layout.css">
    
    <!-- Page CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/core/menu/menu-types/vertical-menu.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/pages/app-invoice.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/app.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/flatpickr.css" />
</head>

<body class="vertical-layout vertical-menu-modern boxicon-layout no-card-shadow 2-columns navbar-sticky footer-static" data-open="click" data-menu="vertical-menu-modern" data-col="2-columns">
    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Layout"))
    {
        <!-- Header -->
        <div class="header-navbar-shadow"></div>
        <nav class="header-navbar main-header-navbar navbar-expand-lg navbar navbar-with-menu fixed-top">
            <div class="navbar-wrapper">
                <div class="navbar-container content">
                    <div class="navbar-collapse" id="navbar-mobile">
                        <div class="mr-auto float-left bookmark-wrapper d-flex align-items-center">
                            <ul class="nav navbar-nav">
                                <li class="nav-item mobile-menu d-xl-none mr-auto">
                                    <a class="nav-link nav-menu-main menu-toggle hidden-xs" href="#"><i class="ficon bx bx-menu"></i></a>
                                </li>
                            </ul>
                        </div>
                        <ul class="nav navbar-nav float-right">
                            <li class="dropdown dropdown-language nav-item">
                                <a class="dropdown-toggle nav-link" id="dropdown-flag" href="#" data-toggle="dropdown">
                                    <i class="flag-icon flag-icon-uz mr-50"></i><span class="selected-language">O'zbekcha</span>
                                </a>
                                <div class="dropdown-menu" aria-labelledby="dropdown-flag">
                                    <a class="dropdown-item" href="#" data-language="uz"><i class="flag-icon flag-icon-uz mr-50"></i>O'zbekcha</a>
                                    <a class="dropdown-item" href="#" data-language="ru"><i class="flag-icon flag-icon-ru mr-50"></i>Русский</a>
                                </div>
                            </li>
                            <li class="nav-item d-none d-lg-block">
                                <a class="nav-link nav-link-expand"><i class="ficon bx bx-fullscreen"></i></a>
                            </li>
                            <li class="dropdown dropdown-user nav-item">
                                <a class="dropdown-toggle nav-link dropdown-user-link" href="#" data-toggle="dropdown">
                                    <div class="user-nav d-sm-flex d-none">
                                        <span class="user-name">@RoleHelper.GetUserFullName(User.Identity.Name)</span>
                                        @{
                                            var userRoles = RoleHelper.GetUserRoles(User.Identity.Name);
                                            if (userRoles != null && userRoles.Length > 0)
                                            {
                                                <span class="user-status text-muted">@userRoles[0]</span>
                                            }
                                        }
                                    </div>
                                    @Html.Partial("_UserProfile")
                                </a>
                                <div class="dropdown-menu dropdown-menu-right pb-0">
                                    <a class="dropdown-item" href="@Url.Action("Settings", "Account", new { userName = User.Identity.Name })">
                                        <i class="bx bx-user mr-50"></i> Profil sozlamalari
                                    </a>
                                    <div class="dropdown-divider mb-0"></div>
                                    <a class="dropdown-item" href="~/Account/Logout">
                                        <i class="bx bx-power-off mr-50"></i> Tizimdan chiqish
                                    </a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Menu -->
        <div class="main-menu menu-fixed menu-light menu-accordion menu-shadow" data-scroll-to-active="true">
            <div class="navbar-header">
                <ul class="nav navbar-nav flex-row">
                    <li class="nav-item mr-auto">
                        <a class="navbar-brand" href="/Home">
                            <div class="brand-logo"><img class="logo" src="~/app-assets/images/logo/logo-32x32.png" /></div>
                            <h2 class="brand-text mb-0">tahsinERP</h2>
                        </a>
                    </li>
                    <li class="nav-item nav-toggle">
                        <a class="nav-link modern-nav-toggle pr-0" data-toggle="collapse">
                            <i class="bx bx-x d-block d-xl-none font-medium-4 primary toggle-icon"></i>
                            <i class="toggle-icon bx bx-disc font-medium-4 d-none d-xl-block collapse-toggle-icon primary" data-ticon="bx-disc"></i>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="shadow-bottom"></div>
            <div class="main-menu-content">
                <ul class="navigation navigation-main" id="main-menu-navigation" data-menu="menu-navigation">

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- SRM - Ta'minot zanjiri boshqaruvi -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Supplier"))
                    {
                        <li class="navigation-header"><span>Ta'minot (SRM)</span></li>
                        
                        <li class="nav-item">
                            <a href="~/Supplier"><i class="bx bxs-factory"></i><span class="menu-title">Ta'minotchilar</span></a>
                        </li>
                    }
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "PContract"))
                    {
                        <li class="nav-item">
                            <a href="~/PContract"><i class="bx bxs-book-bookmark"></i><span class="menu-title">Shartnomalar</span></a>
                        </li>
                    }
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "POrder"))
                    {
                        <li class="nav-item">
                            <a href="~/POrder"><i class="bx bxs-book"></i><span class="menu-title">Buyurtmalar</span></a>
                        </li>
                    }
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "PInvoice"))
                    {
                        <li class="nav-item">
                            <a href="~/PInvoice"><i class="bx bx-file"></i><span class="menu-title">Invoyslar</span></a>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Logistika -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Forwarder"))
                    {
                        <li class="navigation-header"><span>Logistika</span></li>
                        
                        <li class="nav-item">
                            <a href="#"><i class="bx bx-truck"></i><span class="menu-title">Yuk tashish</span></a>
                            <ul class="menu-content">
                                <li><a href="~/Forwarder/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Forwarderlar</span></a></li>
                                <li><a href="~/FContract/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Shartnomalar</span></a></li>
                                <li><a href="~/Waybill/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Yo'l varaqalari</span></a></li>
                                <li><a href="~/FTransportType/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Transport turlari</span></a></li>
                            </ul>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Omborxona -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "PartWRHSIndex"))
                    {
                        <li class="navigation-header"><span>Omborxona</span></li>
                        
                        <li class="nav-item">
                            <a href="#"><i class="bx bxs-home"></i><span class="menu-title">Ombor operatsiyalari</span></a>
                            <ul class="menu-content">
                                <li><a href="~/PartStock/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Qoldiq</span></a></li>
                                <li><a href="~/WhIncome/"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Kirim</span></a></li>
                                <li><a href="~/WhExpense/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Chiqim</span></a></li>
                                <li><a href="~/Partwrhs/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Ombor ma'lumotlari</span></a></li>
                            </ul>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Xarid bo'limi -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "PurchasingOrder"))
                    {
                        <li class="navigation-header"><span>Xarid</span></li>
                        
                        <li class="nav-item">
                            <a href="#"><i class="bx bxs-cart"></i><span class="menu-title">Xaridlar</span></a>
                            <ul class="menu-content">
                                <li><a href="/PurchasingOrder/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Buyurtmalar</span></a></li>
                                <li><a href="/PurchasingItem/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Maxsulotlar bazasi</span></a></li>
                                <li><a href="/PurchasingContract/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Shartnomalar</span></a></li>
                            </ul>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Moliya -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Payment"))
                    {
                        <li class="navigation-header"><span>Moliya</span></li>
                        
                        <li class="nav-item">
                            <a href="/POrderPayment/Index"><i class="bx bx-money"></i><span class="menu-title">To'lovlar</span></a>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Engineering -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "BOM") || RoleHelper.IsViewPermitted(User.Identity.Name, "NormCutting"))
                    {
                        <li class="navigation-header"><span>Engineering</span></li>
                        
                        <li class="nav-item">
                            <a href="#"><i class="bx bx-git-compare"></i><span class="menu-title">BOM</span></a>
                            <ul class="menu-content">
                                @if (RoleHelper.IsViewPermitted(User.Identity.Name, "BOM"))
                                {
                                    <li><a href="~/BOM?IsParentProduct=true"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">BOM ro'yxati</span></a></li>
                                }
                                @if (RoleHelper.IsViewPermitted(User.Identity.Name, "NormCutting"))
                                {
                                    <li><a href="~/NormCutting"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">NORM Kesish</span></a></li>
                                }
                            </ul>
                        </li>
                    }
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Product"))
                    {
                        <li class="nav-item">
                            <a href="#"><i class="bx bx-box"></i><span class="menu-title">Maxsulotlar</span></a>
                            <ul class="menu-content">
                                <li><a href="@Url.Action("Index", "Product")"><i class="bx bx-list-ul"></i><span class="menu-item">Barcha maxsulotlar</span></a></li>
                                <li><a href="@Url.Action("Index", "Product", new { typeFilter = "MAXSULOT" })"><i class="bx bx-package"></i><span class="menu-item">Tayyor maxsulot</span></a></li>
                                <li><a href="@Url.Action("Index", "Product", new { typeFilter = "YARIM_TAYYOR" })"><i class="bx bx-cog"></i><span class="menu-item">Yarim tayyor</span></a></li>
                                <li><a href="@Url.Action("Index", "Product", new { typeFilter = "XOMASHYO" })"><i class="bx bx-cube"></i><span class="menu-item">Xomashyo</span></a></li>
                            </ul>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Ishlab chiqarish rejasi -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "ProductPlan"))
                    {
                        <li class="navigation-header"><span>Ishlab chiqarish</span></li>
                        
                        <li class="nav-item">
                            <a href="~/ProductPlan/Index"><i class="bx bx-line-chart"></i><span class="menu-title">Rejalashtirish</span></a>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- CRM - Mijozlar bilan ishlash -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "SContract"))
                    {
                        <li class="navigation-header"><span>Sotuvlar (CRM)</span></li>
                        
                        <li class="nav-item">
                            <a href="~/Customer/Index"><i class="bx bxs-user-detail"></i><span class="menu-title">Xaridorlar</span></a>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Sozlamalar -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <li class="navigation-header"><span>Sozlamalar</span></li>
                    
                    <li class="nav-item">
                        <a href="#"><i class="bx bx-wrench"></i><span class="menu-title">Tizim sozlamalari</span></a>
                        <ul class="menu-content">
                            <li><a href="~/Company/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Korxona</span></a></li>
                            <li><a href="~/Unit/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">O'lchov birliklari</span></a></li>
                            <li><a href="~/Currency/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Valyutalar</span></a></li>
                        </ul>
                    </li>
                    
                    <li class="nav-item">
                        <a href="@Url.Action("Settings", "Account", new { userName = User.Identity.Name })">
                            <i class="bx bx-user-circle"></i><span class="menu-title">Profil sozlamalari</span>
                        </a>
                    </li>

                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "AdminPanel"))
                    {
                        <li class="nav-item">
                            <a href="~/AdminPanel"><i class="bx bx-cog"></i><span class="menu-title">Admin panel</span></a>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <!-- END: Main Menu -->

        <div>@RenderBody()</div>

        <div class="sidenav-overlay"></div>
        <div class="drag-target"></div>

        <!-- Footer -->
        <footer class="footer footer-static footer-light">
            <p class="clearfix mb-0">
                <span class="float-left d-inline-block">@DateTime.Now.Year &copy; tahsinERP</span>
            </p>
        </footer>

        <!-- Scripts -->
        @Scripts.Render("~/bundles/jquery")
        <script src="~/Scripts/bootstrap.bundle.js"></script>
        @RenderSection("scripts", required: false)

        <!-- Vendor JS -->
        <script src="~/app-assets/vendors/js/vendors.min.js"></script>
        <script src="~/app-assets/fonts/LivIconsEvo/js/LivIconsEvo.tools.js"></script>
        <script src="~/app-assets/fonts/LivIconsEvo/js/LivIconsEvo.defaults.js"></script>
        <script src="~/app-assets/fonts/LivIconsEvo/js/LivIconsEvo.min.js"></script>

        <!-- DataTables -->
        <script src="~/app-assets/vendors/js/tables/datatable/datatables.min.js"></script>
        <script src="~/app-assets/vendors/js/tables/datatable/dataTables.bootstrap4.min.js"></script>
        <script src="~/app-assets/vendors/js/tables/datatable/dataTables.responsive.min.js"></script>
        <script src="~/app-assets/vendors/js/tables/datatable/responsive.bootstrap.min.js"></script>
        
        <!-- Select2 -->
        <script src="~/app-assets/vendors/js/forms/select/select2.full.min.js"></script>

        <!-- Theme JS -->
        <script src="~/app-assets/js/scripts/configs/vertical-menu-light.js"></script>
        <script src="~/app-assets/js/core/app-menu.js"></script>
        <script src="~/app-assets/js/core/app.js"></script>
        <script src="~/app-assets/js/scripts/components.js"></script>
        <script src="~/app-assets/js/scripts/datatables/datatable.js"></script>
        <script src="~/app-assets/js/scripts/forms/select/form-select2.js"></script>

        <!-- Custom JS -->
        <script src="~/assets/js/jquery.min.js"></script>
        <script src="~/assets/js/app.js"></script>
        <script src="~/Scripts/flatpickr.js"></script>

        <!-- Repeater -->
        <script src="~/assets/js/jquery.repeater.min.js"></script>
        <script>
            var $j = jQuery.noConflict(true);
            $j(document).ready(function () {
                $j('.repeater-default').repeater({
                    show: function () {
                        $j(this).slideDown();
                        $(this).find('.select').each(function () {
                            if ($(this).hasClass("select2-hidden-accessible")) {
                                $(this).select2('destroy');
                                $(this).next('.select2').remove();
                            }
                            $(this).select2({ width: '100%' });
                        });
                    },
                    hide: function (deleteElement) {
                        if (confirm("O'chirishni tasdiqlaysizmi?")) {
                            $j(this).slideUp(deleteElement);
                        }
                    }
                });
                $('.select').select2({ width: '100%' });
            });
        </script>
    }
    else
    {
        Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
    }
</body>
</html>
