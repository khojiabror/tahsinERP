@using tahsinERP.Models;
@{
    // Korxona brendi (COMPANIES: Name, BrandColor, LogoImage) — bo'sh bo'lsa standart neytral rang
    var brand = tahsinERP.Services.Common.BrandingService.Current();
}
<!DOCTYPE html>
<html lang="@tahsinERP.Localization.Languages.HtmlLang(L.Lang)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
    <title>@ViewData["Title"] - tahsinERP</title>
    <script src="@tahsinERP.Helpers.AssetVersion.Url("~/assets/js/theme.js")"></script>
    <link rel="apple-touch-icon" href="@tahsinERP.Helpers.AssetVersion.Url("~/app-assets/images/ico/apple-touch-icon.png")">
    <link rel="shortcut icon" type="image/x-icon" href="@tahsinERP.Helpers.AssetVersion.Url("~/app-assets/images/ico/favicon.ico")">
    <link href="https://fonts.googleapis.com/css?family=Rubik:300,400,500,600%7CIBM+Plex+Sans:300,400,500,600,700" rel="stylesheet">

    <!-- Vendor CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/vendors.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/tables/datatable/datatables.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/tables/datatable/responsive.bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/forms/select/select2.min.css">

    <!-- Theme CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap-extended.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/colors.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/components.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/themes/semi-dark-layout.css">

    <!-- Page CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/core/menu/menu-types/vertical-menu.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/pages/app-invoice.min.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/app.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/flatpickr.css" />

    <!-- Asosiy rang (COMPANIES.BrandColor, Sozlamalar -> Korxona ma'lumotlari; standart — neytral indigo).
         Qoidalar: theme-accent.css (Frest shabloni), theme.css (ERP), theme-dark.css (tungi rejim). -->
    <style id="brand-vars">@Html.Raw(tahsinERP.Services.Common.BrandingService.RenderCssVariables(brand.Tokens))</style>
    <link rel="stylesheet" type="text/css" href="@tahsinERP.Helpers.AssetVersion.Url("~/assets/css/theme-accent.css")" />
    <link rel="stylesheet" type="text/css" href="@tahsinERP.Helpers.AssetVersion.Url("~/assets/css/theme-dark.css")" />
    <link rel="stylesheet" type="text/css" href="@tahsinERP.Helpers.AssetVersion.Url("~/assets/css/theme.css")" />
</head>

<body class="vertical-layout vertical-menu-modern boxicon-layout no-card-shadow 2-columns navbar-sticky footer-static" data-open="click" data-menu="vertical-menu-modern" data-col="2-columns">
    @if (!Request.IsAuthenticated || RoleHelper.IsViewPermitted(User.Identity.Name, "Layout"))
    {
        <!-- Header -->
        <div class="header-navbar-shadow"></div>
        <nav class="header-navbar main-header-navbar navbar-expand-lg navbar navbar-with-menu fixed-top">
            <div class="navbar-wrapper">
                <div class="navbar-container content">
                    <div class="navbar-collapse" id="navbar-mobile">
                        <div class="mr-auto float-left bookmark-wrapper d-flex align-items-center">
                            <ul class="nav navbar-nav">
                                <li class="nav-item mobile-menu d-xl-none mr-auto">
                                    <a class="nav-link nav-menu-main menu-toggle hidden-xs" href="#"><i class="ficon bx bx-menu"></i></a>
                                </li>
                            </ul>
                        </div>
                        <ul class="nav navbar-nav float-right">
                            @Html.Partial("_LanguageSwitch")
                            <li class="nav-item d-none d-lg-block">
                                <a class="nav-link nav-link-expand"><i class="ficon bx bx-fullscreen"></i></a>
                            </li>
                            @Html.Partial("~/Views/Shared/_ThemeSwitch.cshtml")
                            <li class="dropdown dropdown-user nav-item">
                                <a class="dropdown-toggle nav-link dropdown-user-link" href="#" data-toggle="dropdown">
                                    @Html.Partial("_HeaderUserName")
                                    @{
                                        // 60 soniya keshlanadi (avval har sahifada 3–4 ta so'rov)
                                        var badges = tahsinERP.Helpers.LayoutBadges.Get(User.Identity.Name);
                                        int userTaskCount = badges.OpenTasks;
                                        int pendingIncomeCount = badges.PendingIncomes;
                                        bool isMrpUser = badges.IsMrpUser;
                                    }
                                    <span class="position-relative d-inline-block">
                                        @Html.Partial("_UserProfile")
                                        @if (userTaskCount > 0 || pendingIncomeCount > 0)
                                        {
                                            <span class="user-alert-dot"></span>
                                        }
                                    </span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-right pb-0">
                                    <a class="dropdown-item" href="@Url.Action("Settings", "Account", new { area = "" })">
                                        <i class="bx bx-user mr-50"></i> @L.T("Hdr_ProfileSettings")
                                    </a>
                                    @if (RoleHelper.CanManageLicense(User.Identity.Name))
                                    {
                                        <a class="dropdown-item" href="@Url.Action("Index", "License", new { area = "" })">
                                            <i class="bx bx-key mr-50"></i> @L.T("Hdr_License")
                                        </a>
                                    }
                                    <a class="dropdown-item" href="~/Tasks?assigneeUserID=@tahsinERP.Controllers.UserHelper.GetUserId(User.Identity.Name)">
                                        <i class="bx bx-task mr-50"></i> @L.T("Hdr_Tasks")
                                        @if (userTaskCount > 0)
                                        {
                                            <span class="badge badge-danger badge-pill float-right">@userTaskCount</span>
                                        }
                                    </a>
                                    @if (isMrpUser)
                                    {
                                        <a class="dropdown-item" href="~/Incomes?status=0">
                                            <i class="bx bx-log-in-circle mr-50"></i> @L.T("Hdr_WarehouseIncome")
                                            @if (pendingIncomeCount > 0)
                                            {
                                                <span class="badge badge-danger badge-pill float-right">@pendingIncomeCount</span>
                                            }
                                        </a>
                                    }
                                    <div class="dropdown-divider mb-0"></div>
                                    <a class="dropdown-item" href="~/Account/Logout">
                                        <i class="bx bx-power-off mr-50"></i> @L.T("Hdr_Logout")
                                    </a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Menu -->
        <div class="main-menu menu-fixed menu-light menu-accordion menu-shadow" data-scroll-to-active="true">
            <div class="navbar-header">
                <ul class="nav navbar-nav flex-row">
                    <li class="nav-item mr-auto">
                        <a class="navbar-brand" href="/Home">
                            <div class="brand-logo"><img class="logo@(brand.HasLogo ? "" : " logo-tahsin")" src="@(brand.HasLogo ? Url.Action("Logo", "Branding", new { area = "", v = brand.LogoVersion }) : Url.Content("~/app-assets/images/logo/logo-32x32.png"))" alt="" /></div>
                            <h2 class="brand-text mb-0">tahsinERP</h2>
                        </a>
                    </li>
                    <li class="nav-item nav-toggle">
                        <a class="nav-link modern-nav-toggle pr-0" data-toggle="collapse">
                            <i class="bx bx-x d-block d-xl-none font-medium-4 primary toggle-icon"></i>
                            <i class="toggle-icon bx bx-disc font-medium-4 d-none d-xl-block collapse-toggle-icon primary" data-ticon="bx-disc"></i>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="shadow-bottom"></div>
            <div class="main-menu-content">
                <ul class="navigation navigation-main" id="main-menu-navigation" data-menu="menu-navigation">

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Dashboard - Barcha modullar dashboardlari -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <li class="nav-item">
                        <a href="~/Home"><i class="bx bx-home"></i><span class="menu-title">@L.T("Home")</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="#"><i class="bx bx-bar-chart-alt-2"></i><span class="menu-title">@L.T("Menu_Dashboard")</span></a>
                        <ul class="menu-content">
                            <li><a href="~/Home"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_DashGeneral")</span></a></li>
                            @if (RoleHelper.IsViewPermitted(User.Identity.Name, "FinDashboard"))
                            {
                                <li>
                                    <a href="#"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_DashFinance")</span></a>
                                    <ul class="menu-content">
                                        <li><a href="/FinDashboard/FinancialOverview"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_Overview")</span></a></li>
                                        <li><a href="/FinDashboard/Cashflow"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_CashFlow")</span></a></li>
                                        <li><a href="/FinDashboard/CategoryAnalytics"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_CategoryAnalysis")</span></a></li>
                                        <li><a href="/FinDashboard/AccountAnalytics"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_AccountAnalysis")</span></a></li>
                                        <li><a href="/FinDashboard/ExpenseAnalysis"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_ExpenseAnalysis")</span></a></li>
                                        <li><a href="/FinDashboard/IncomeAnalysis"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_IncomeAnalysis")</span></a></li>
                                        <li><a href="/FinDashboard/AccountBalances"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_AccountBalances")</span></a></li>
                                        <li><a href="/FinDashboard/PL"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_ProfitLoss")</span></a></li>
                                        <li><a href="/FinDashboard/EBITDA"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_Ebitda")</span></a></li>
                                        <li><a href="/FinDashboard/BalanceSheet"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_Balance")</span></a></li>
                                        <li><a href="/FinDashboard/LiabilitiesDashboard"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_DashObligations")</span></a></li>
                                        <li><a href="/FinDashboard/FinanceReportsHub"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_CoreFinReport")</span></a></li>
                                    </ul>
                                </li>
                            }
                            @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Tannarx"))
                            {
                                <li><a href="~/TannarxAnalytics/Dashboard"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_DashCost")</span></a></li>
                            }
                            @if (RoleHelper.IsViewPermitted(User.Identity.Name, "CRMDashboard") || RoleHelper.IsViewPermitted(User.Identity.Name, "SOrder") || RoleHelper.IsViewPermitted(User.Identity.Name, "SContract") || RoleHelper.IsViewPermitted(User.Identity.Name, "SalesInvoices"))
                            {
                                <li><a href="~/CRMDashboard"><i class="bx bx-bar-chart-alt-2"></i><span class="menu-item">@L.T("Menu_DashCrm")</span></a></li>
                            }
                            @if (RoleHelper.IsViewPermitted(User.Identity.Name, "LogisticsDashboard") || RoleHelper.IsViewPermitted(User.Identity.Name, "Forwarder"))
                            {
                                <li><a href="~/LogisticsDashboard"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_DashLogistics")</span></a></li>
                            }
                            @if (RoleHelper.IsViewPermitted(User.Identity.Name, "HrDashboard"))
                            {
                                <li><a href="~/HrDashboard"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_DashHr")</span></a></li>
                            }
                            @if (RoleHelper.IsViewPermitted(User.Identity.Name, "MESDashboard"))
                            {
                                <li><a href="~/MESDashboard/Dashboard"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_DashMes")</span></a></li>
                            }
                            @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Supplier"))
                            {
                                <li><a href="~/SRMDashboard"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_DashSrm")</span></a></li>
                            }
                            @if (RoleHelper.IsViewPermitted(User.Identity.Name, "InventoryReports"))
                            {
                                <li><a href="~/InventoryReports/Dashboard"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_DashWarehouse")</span></a></li>
                            }
                            @if (RoleHelper.IsViewPermitted(User.Identity.Name, "TaskDashboard"))
                            {
                                <li><a href="~/TaskDashboard"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_DashTasks")</span></a></li>
                            }
                        </ul>
                    </li>

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- SRM - Ta'minot zanjiri boshqaruvi (Moliya uslubida ixcham) -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->

                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Supplier") ||
                         RoleHelper.IsViewPermitted(User.Identity.Name, "PRequisitions") ||
                         RoleHelper.IsViewPermitted(User.Identity.Name, "PContracts") ||
                         RoleHelper.IsViewPermitted(User.Identity.Name, "POrders") ||
                         RoleHelper.IsViewPermitted(User.Identity.Name, "PInvoices") ||
                         RoleHelper.IsViewPermitted(User.Identity.Name, "PurchaseOrderTracking") ||
                         RoleHelper.IsViewPermitted(User.Identity.Name, "Tender"))
                    {
                        <li class="navigation-header"><span>@L.T("Menu_Srm")</span></li>

                        if (RoleHelper.IsViewPermitted(User.Identity.Name, "Supplier"))
                        {
                            <li class="nav-item">
                                <a href="#"><i class="bx bx-bar-chart-alt-2"></i><span class="menu-title">@L.T("Reports")</span></a>
                                <ul class="menu-content">
                                    <li><a href="~/SRMDashboard"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_DashSrm")</span></a></li>
                                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Reports"))
                                    {
                                        <li><a href="~/Reports/Coverage"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_Coverage")</span></a></li>
                                        <li><a href="~/Reports/ABCSegmentation"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">ABC / XYZ </span></a></li>
                                        <li><a href="~/Reports/SafetyStock"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_SafetyStock")</span></a></li>
                                    }
                                </ul>
                            </li>
                        }

                        if (RoleHelper.IsViewPermitted(User.Identity.Name, "Supplier"))
                        {
                            <li class="nav-item">
                                <a href="#"><i class="bx bxs-factory"></i><span class="menu-title">@L.T("Menu_Suppliers")</span></a>
                                <ul class="menu-content">
                                    <li><a href="~/Supplier"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_Suppliers")</span></a></li>
                                    <li><a href="~/SupplierBase"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_Directory")</span></a></li>
                                </ul>
                            </li>
                        }

                        if (RoleHelper.IsViewPermitted(User.Identity.Name, "PRequisitions") ||
                             RoleHelper.IsViewPermitted(User.Identity.Name, "PContracts") ||
                             RoleHelper.IsViewPermitted(User.Identity.Name, "POrders") ||
                             RoleHelper.IsViewPermitted(User.Identity.Name, "PInvoices"))
                        {
                            <li class="nav-item">
                                <a href="#"><i class="bx bxs-book-bookmark"></i><span class="menu-title">@L.T("Menu_PurchaseProcess")</span></a>
                                <ul class="menu-content">
                                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "PRequisitions"))
                                    {
                                        <li><a href="~/PRequisitions"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_PurchaseRequests")</span></a></li>
                                    }
                                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "PContracts"))
                                    {
                                        <li><a href="~/PContracts"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_PurchaseContracts")</span></a></li>
                                    }
                                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "POrders"))
                                    {
                                        <li><a href="~/POrders"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_PurchaseOrders")</span></a></li>
                                    }
                                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "PInvoices"))
                                    {
                                        <li><a href="~/PInvoices"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_PurchaseInvoices")</span></a></li>
                                    }
                                </ul>
                            </li>
                        }

                        if (RoleHelper.IsViewPermitted(User.Identity.Name, "PurchaseOrderTracking") || RoleHelper.IsViewPermitted(User.Identity.Name, "Tender"))
                        {
                            <li class="nav-item">
                                <a href="#"><i class="bx bx-tracking"></i><span class="menu-title">@L.T("Menu_TrackingTender")</span></a>
                                <ul class="menu-content">
                                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "PurchaseOrderTracking"))
                                    {
                                        <li><a href="~/PurchaseOrderTracking"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_OrderTracking")</span></a></li>
                                    }
                                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Tender"))
                                    {
                                        <li><a href="~/Tender"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@L.T("Menu_TenderCompare")</span></a></li>
                                    }
                                </ul>
                            </li>
                        }
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Distributsiya (Areas/Distribution) -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "DstHome", "Index"))
                    {
                        var dstMenu = new[]
                        {
                            new { C = "DstDashboard", K = "Dashboard" }, new { C = "DstReports", K = "Reports" },
                            new { C = "DstOrders", K = "Orders" }, new { C = "DstStock", K = "Stock" }, new { C = "DstInventory", K = "Inventory" },
                            new { C = "DstTransfers", K = "Transfers" }, new { C = "DstWriteOffs", K = "WriteOffs" }, new { C = "DstRegrades", K = "Regrades" },
                            new { C = "DstLandedCosts", K = "LandedCosts" }, new { C = "DstReorder", K = "Reorder" }, new { C = "DstPromotions", K = "Promotions" },
                            new { C = "DstPayments", K = "Payments" }, new { C = "DstDebts", K = "Debts" }, new { C = "DstReturns", K = "Returns" },
                            new { C = "DstField", K = "Field" }, new { C = "DstRoutes", K = "Routes" }, new { C = "DstIssues", K = "Issues" },
                            new { C = "DstTrips", K = "Trips" }, new { C = "DstVehicles", K = "Vehicles" }, new { C = "DstKpi", K = "Kpi" },
                            new { C = "DstCustomers", K = "Customers" }, new { C = "DstProducts", K = "Products" },
                            new { C = "DstPrices", K = "Prices" }, new { C = "DstTerritories", K = "Territories" },
                            new { C = "DstTeams", K = "Teams" }, new { C = "DstDictionaries", K = "Dictionaries" },
                            new { C = "DstSettings", K = "Settings" }, new { C = "DstImport", K = "Import" }, new { C = "DstAudit", K = "Audit" }
                        };
                        <li class="navigation-header"><span>@tahsinERP.Areas.Distribution.Services.DstLocalization.T("Module_Title")</span></li>
                        <li class="nav-item">
                            <a href="#"><i class="bx bx-cart-alt"></i><span class="menu-title">@tahsinERP.Areas.Distribution.Services.DstLocalization.T("Module_Title")</span></a>
                            <ul class="menu-content">
                                <li><a href="~/Distribution/DstHome"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@tahsinERP.Areas.Distribution.Services.DstLocalization.T("Home")</span></a></li>
                                @foreach (var m in dstMenu)
                                {
                                    if (RoleHelper.IsViewPermitted(User.Identity.Name, m.C, "Index"))
                                    {
                                        <li><a href="~/Distribution/@m.C"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@tahsinERP.Areas.Distribution.Services.DstLocalization.T(m.K)</span></a></li>
                                    }
                                }
                            </ul>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Sayt-katalog (Areas/Site, alohida xizmat) -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "SiteHome", "Index"))
                    {
                        var siteMenu = new[]
                        {
                            new { C = "SiteCatalog", K = "Site_Catalog" }, new { C = "SitePages", K = "Site_PagesBanners" },
                            new { C = "SiteLeads", K = "Site_Leads" }, new { C = "SiteSettings", K = "Settings" }
                        };
                        <li class="nav-item">
                            <a href="#"><i class="bx bx-globe"></i><span class="menu-title">@tahsinERP.Areas.Distribution.Services.DstLocalization.T("Site_Title")</span></a>
                            <ul class="menu-content">
                                <li><a href="~/Site/SiteHome"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@tahsinERP.Areas.Distribution.Services.DstLocalization.T("Site_Dashboard")</span></a></li>
                                @foreach (var m in siteMenu)
                                {
                                    if (RoleHelper.IsViewPermitted(User.Identity.Name, m.C, "Index"))
                                    {
                                        <li><a href="~/Site/@m.C"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">@tahsinERP.Areas.Distribution.Services.DstLocalization.T(m.K)</span></a></li>
                                    }
                                }
                            </ul>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Logistika -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Forwarder") ||
                         RoleHelper.IsViewPermitted(User.Identity.Name, "WaybillPayment"))
                    {
                        <li class="navigation-header"><span>@L.T("Menu_Logistics")</span></li>

                        <li class="nav-item">
                            <a href="#"><i class="bx bx-truck"></i><span class="menu-title">@L.T("Menu_Freight")</span></a>
