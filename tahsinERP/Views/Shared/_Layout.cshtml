                                $(this).select2('destroy');
                                $(this).next('.select2').remove();
                            }
                            $(this).select2({ width: '100%' });
                        });
                    },
                    hide: function (deleteElement) {
                        if (confirm(erpT("Js_ConfirmDelete"))) {
