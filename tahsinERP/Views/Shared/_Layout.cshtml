                            $(this).select2({ width: '100%' });
                        });
                    },
                    hide: function (deleteElement) {
                        if (confirm("O'chirishni tasdiqlaysizmi?")) {
                            $j(this).slideUp(deleteElement);
                        }
                    }
                });
                $('.select').select2({ width: '100%' });
            });
