@using tahsinERP.Models;
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
    <title>@ViewData["Title"] - tahsinERP</title>
    <link rel="apple-touch-icon" href="~/app-assets/images/ico/apple-touch-icon.png">
    <link rel="shortcut icon" type="image/x-icon" href="~/app-assets/images/ico/favicon.ico">
    <link href="https://fonts.googleapis.com/css?family=Rubik:300,400,500,600%7CIBM+Plex+Sans:300,400,500,600,700" rel="stylesheet">

    <!-- Vendor CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/vendors.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/tables/datatable/datatables.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/tables/datatable/responsive.bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/forms/select/select2.min.css">
    
    <!-- Theme CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap-extended.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/colors.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/components.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/themes/dark-layout.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/themes/semi-dark-layout.css">
    
    <!-- Page CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/core/menu/menu-types/vertical-menu.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/pages/app-invoice.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/app.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/flatpickr.css" />
    
    <!-- Custom Styles for iPack Branding - Green Theme -->
    <style>
        /* To'q yashil rang - iPack korxonasi rangi */
        :root {
            --ipack-green: #198754;
            --ipack-green-light: rgba(25, 135, 84, 0.15);
            --ipack-green-hover: #157347;
            --ipack-green-dark: #146c43;
        }
        
        /* tahsinERP yozuvini to'q yashil rangga o'zgartirish */
        .main-menu .navbar-header .navbar-brand .brand-text {
            color: var(--ipack-green) !important;
        }
        
        /* Active menu item text color - yashil rang */
        .main-menu.menu-light .navigation > li.active:not(.sidebar-group-active) > a {
            color: var(--ipack-green) !important;
        }
        
        .main-menu.menu-light .navigation > li ul .active > a {
            color: var(--ipack-green) !important;
        }
        
        /* Active menu item icon rangi - yashil */
        .main-menu.menu-light .navigation > li.active:not(.sidebar-group-active) > a i,
        .main-menu.menu-light .navigation > li.active:not(.sidebar-group-active) > a .menu-livicon,
        .main-menu.menu-light .navigation > li ul .active > a i,
        .main-menu.menu-light .navigation > li ul .active > a .menu-livicon {
            color: var(--ipack-green) !important;
        }
        
        /* Active menu item background - yashil rang bilan */
        .main-menu.menu-light .navigation > li.active:not(.sidebar-group-active) > a {
            background: var(--ipack-green-light) !important;
        }
        
        .main-menu.menu-light .navigation > li ul .active {
            background: var(--ipack-green-light) !important;
        }
        
        /* Buttonlar - yashil rang */
        .btn-primary,
        button.btn-primary,
        input[type="submit"].btn-primary,
        input[type="button"].btn-primary {
            background-color: var(--ipack-green) !important;
            border-color: var(--ipack-green-dark) !important;
            color: #fff !important;
        }
        
        .btn-primary:hover,
        .btn-primary.hover,
        button.btn-primary:hover,
        input[type="submit"].btn-primary:hover {
            background-color: var(--ipack-green-hover) !important;
            border-color: var(--ipack-green-dark) !important;
            color: #fff !important;
        }
        
        .btn-primary:focus,
        .btn-primary:active,
        .btn-primary.active,
        button.btn-primary:focus,
        button.btn-primary:active {
            background-color: var(--ipack-green-dark) !important;
            border-color: var(--ipack-green-dark) !important;
            color: #fff !important;
        }
        
        /* Outline buttons */
        .btn-outline-primary {
            border-color: var(--ipack-green) !important;
            color: var(--ipack-green) !important;
        }
        
        .btn-outline-primary:hover {
            background-color: var(--ipack-green) !important;
            color: #fff !important;
        }
        
        /* Primary color classes */
        .primary,
        .text-primary {
            color: var(--ipack-green) !important;
        }
        
        .bg-primary,
        .bg-rgba-primary {
            background-color: var(--ipack-green) !important;
        }
        
        .bg-rgba-primary {
            background: var(--ipack-green-light) !important;
        }
        
        /* Badges */
        .badge-primary,
        .badge.badge-primary {
            background-color: var(--ipack-green) !important;
        }
        
        .badge-light-primary,
        .badge.badge-light-primary {
            background-color: var(--ipack-green-light) !important;
            color: var(--ipack-green) !important;
        }
        
        /* Borders */
        .border-primary {
            border-color: var(--ipack-green) !important;
        }
        
        /* Active page elements */
        .card-header.bg-primary,
        .card-footer.bg-primary {
            background-color: var(--ipack-green) !important;
        }
        
        /* Summary boxes va boshqa primary elementlar */
        .bg-primary-light,
        .bg-light-primary {
            background-color: var(--ipack-green-light) !important;
            color: var(--ipack-green) !important;
        }
        
        /* Progress bars */
        .progress-bar.bg-primary {
            background-color: var(--ipack-green) !important;
        }
        
        /* Links */
        a.primary,
        a.text-primary {
            color: var(--ipack-green) !important;
        }
        
        a.primary:hover,
        a.text-primary:hover {
            color: var(--ipack-green-hover) !important;
        }
        
        /* Breadcrumb - Page Name (Rasmiy Maktublar va boshqalar) */
        .breadcrumb.breadcrumb-divider .breadcrumb-item.active {
            background-color: var(--ipack-green) !important;
            color: #FFFFFF !important;
        }
        
        .breadcrumb .breadcrumb-item.active {
            color: var(--ipack-green) !important;
        }
        
        /* Breadcrumb link hover */
        .breadcrumb-wrapper .breadcrumb .breadcrumb-item a:hover,
        .breadcrumb-wrapper .breadcrumb .breadcrumb-item a i:hover {
            color: var(--ipack-green) !important;
        }
        
        /* Breadcrumb rounded pill active */
        .breadcrumb.rounded-pill.breadcrumb-divider .breadcrumb-item.active {
            background-color: var(--ipack-green) !important;
            color: #FFFFFF !important;
        }
        
        /* Barcha linklar (a tag) - yashil rang */
        a:not(.btn):not(.breadcrumb-item.active):not(.nav-link.active):not(.dropdown-item.active) {
            color: var(--ipack-green) !important;
        }
        
        /* Link hover state */
        a:not(.btn):not(.breadcrumb-item.active):not(.nav-link.active):not(.dropdown-item.active):hover {
            color: var(--ipack-green-hover) !important;
        }
        
        /* Link visited state */
        a:not(.btn):not(.breadcrumb-item.active):not(.nav-link.active):not(.dropdown-item.active):visited {
            color: var(--ipack-green-dark) !important;
        }
        
        /* Table ichidagi linklar */
        table a,
        .table a,
        .dataTable a {
            color: var(--ipack-green) !important;
        }
        
        table a:hover,
        .table a:hover,
        .dataTable a:hover {
            color: var(--ipack-green-hover) !important;
        }
        
        /* Card ichidagi linklar */
        .card a:not(.btn) {
            color: var(--ipack-green) !important;
        }
        
        .card a:not(.btn):hover {
            color: var(--ipack-green-hover) !important;
        }
        
        /* Navigation linklar (menu ichida emas) */
        .content-body a:not(.btn):not(.breadcrumb-item):not(.nav-link) {
            color: var(--ipack-green) !important;
        }
        
        .content-body a:not(.btn):not(.breadcrumb-item):not(.nav-link):hover {
            color: var(--ipack-green-hover) !important;
        }
    </style>
</head>

<body class="vertical-layout vertical-menu-modern boxicon-layout no-card-shadow 2-columns navbar-sticky footer-static" data-open="click" data-menu="vertical-menu-modern" data-col="2-columns">
    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Layout"))
    {
        <!-- Header -->
        <div class="header-navbar-shadow"></div>
        <nav class="header-navbar main-header-navbar navbar-expand-lg navbar navbar-with-menu fixed-top">
            <div class="navbar-wrapper">
                <div class="navbar-container content">
                    <div class="navbar-collapse" id="navbar-mobile">
                        <div class="mr-auto float-left bookmark-wrapper d-flex align-items-center">
                            <ul class="nav navbar-nav">
                                <li class="nav-item mobile-menu d-xl-none mr-auto">
                                    <a class="nav-link nav-menu-main menu-toggle hidden-xs" href="#"><i class="ficon bx bx-menu"></i></a>
                                </li>
                            </ul>
                        </div>
                        <ul class="nav navbar-nav float-right">
                            <li class="dropdown dropdown-language nav-item">
                                <a class="dropdown-toggle nav-link" id="dropdown-flag" href="#" data-toggle="dropdown">
                                    <i class="flag-icon flag-icon-uz mr-50"></i><span class="selected-language">O'zbekcha</span>
                                </a>
                                <div class="dropdown-menu" aria-labelledby="dropdown-flag">
                                    <a class="dropdown-item" href="#" data-language="uz"><i class="flag-icon flag-icon-uz mr-50"></i>O'zbekcha</a>
                                    <a class="dropdown-item" href="#" data-language="ru"><i class="flag-icon flag-icon-ru mr-50"></i>Русский</a>
                                </div>
                            </li>
                            <li class="nav-item d-none d-lg-block">
                                <a class="nav-link nav-link-expand"><i class="ficon bx bx-fullscreen"></i></a>
                            </li>
                            <li class="dropdown dropdown-user nav-item">
                                <a class="dropdown-toggle nav-link dropdown-user-link" href="#" data-toggle="dropdown">
                                    <div class="user-nav d-sm-flex d-none">
                                        <span class="user-name">@RoleHelper.GetUserFullName(User.Identity.Name)</span>
                                        @{
                                            var userRoles = RoleHelper.GetUserRoles(User.Identity.Name);
                                            if (userRoles != null && userRoles.Length > 0)
                                            {
                                                <span class="user-status text-muted">@userRoles[0]</span>
                                            }
                                        }
                                    </div>
                                    @Html.Partial("_UserProfile")
                                </a>
                                <div class="dropdown-menu dropdown-menu-right pb-0">
                                    <a class="dropdown-item" href="@Url.Action("Settings", "Account", new { userName = User.Identity.Name })">
                                        <i class="bx bx-user mr-50"></i> Profil sozlamalari
                                    </a>
                                    @{
                                        int userTaskCount = 0;
                                        try
                                        {
                                            using (var db = new tahsinERP.Models.DBTHSNEntities())
                                            {
                                                var userId = tahsinERP.Controllers.UserHelper.GetUserId(User.Identity.Name);
                                                userTaskCount = db.APP_TASKS.Count(t => t.AssigneeUserID == userId && t.IsDeleted == false && 
                                                    (t.APP_TASK_STATUS_REF == null || t.APP_TASK_STATUS_REF.Code != "DONE"));
                                            }
                                        }
                                        catch { }
                                    }
                                    <a class="dropdown-item" href="~/Tasks?assigneeUserID=@tahsinERP.Controllers.UserHelper.GetUserId(User.Identity.Name)">
                                        <i class="bx bx-task mr-50"></i> Topshiriqlar
                                        @if (userTaskCount > 0)
                                        {
                                            <span class="badge badge-danger badge-pill float-right">@userTaskCount</span>
                                        }
                                    </a>
                                    <div class="dropdown-divider mb-0"></div>
                                    <a class="dropdown-item" href="~/Account/Logout">
                                        <i class="bx bx-power-off mr-50"></i> Tizimdan chiqish
                                    </a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Menu -->
        <div class="main-menu menu-fixed menu-light menu-accordion menu-shadow" data-scroll-to-active="true">
            <div class="navbar-header">
                <ul class="nav navbar-nav flex-row">
                    <li class="nav-item mr-auto">
                        <a class="navbar-brand" href="/Home">
                            <div class="brand-logo"><img class="logo" src="~/app-assets/images/logo/logo-32x32.png" /></div>
                            <h2 class="brand-text mb-0">tahsinERP</h2>
                        </a>
                    </li>
                    <li class="nav-item nav-toggle">
                        <a class="nav-link modern-nav-toggle pr-0" data-toggle="collapse">
                            <i class="bx bx-x d-block d-xl-none font-medium-4 primary toggle-icon"></i>
                            <i class="toggle-icon bx bx-disc font-medium-4 d-none d-xl-block collapse-toggle-icon primary" data-ticon="bx-disc"></i>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="shadow-bottom"></div>
            <div class="main-menu-content">
                <ul class="navigation navigation-main" id="main-menu-navigation" data-menu="menu-navigation">

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Dashboard - Barcha modullar dashboardlari -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <li class="nav-item">
                        <a href="~/Home"><i class="bx bx-home"></i><span class="menu-title">Bosh sahifa</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="#"><i class="bx bx-bar-chart-alt-2"></i><span class="menu-title">Dashboard</span></a>
                        <ul class="menu-content">
                            <li><a href="~/Home"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Umumiy Dashboard</span></a></li>
                            @if (RoleHelper.IsViewPermitted(User.Identity.Name, "FinDashboard"))
                            {
                                <li><a href="/FinDashboard/Cashflow"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Moliya Dashboard</span></a></li>
                            }
                            @if (RoleHelper.IsViewPermitted(User.Identity.Name, "HrDashboard"))
                            {
                                <li><a href="~/HrDashboard"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">HR Dashboard</span></a></li>
                            }
                            @if (RoleHelper.IsViewPermitted(User.Identity.Name, "MESDashboard"))
                            {
                                <li><a href="~/MESDashboard/Dashboard"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">MES Dashboard</span></a></li>
                            }
                            @if (RoleHelper.IsViewPermitted(User.Identity.Name, "InventoryReports"))
                            {
                                <li><a href="~/InventoryReports/Dashboard"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Ombor Dashboard</span></a></li>
                            }
                        </ul>
                    </li>

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- SRM - Ta'minot zanjiri boshqaruvi -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Supplier"))
                    {
                        <li class="navigation-header"><span>Ta'minot (SRM)</span></li>
                        
                        <li class="nav-item">
                            <a href="~/Supplier"><i class="bx bxs-factory"></i><span class="menu-title">Ta'minotchilar</span></a>
                        </li>
                    }
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "PContracts"))
                    {
                        <li class="nav-item">
                            <a href="~/PContracts"><i class="bx bxs-book-bookmark"></i><span class="menu-title">Xarid shartnomalari</span></a>
                        </li>
                    }
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "POrders"))
                    {
                        <li class="nav-item">
                            <a href="~/POrders"><i class="bx bxs-book"></i><span class="menu-title">Xarid buyurtmalari</span></a>
                        </li>
                    }
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "PInvoices"))
                    {
                        <li class="nav-item">
                            <a href="~/PInvoices"><i class="bx bx-file"></i><span class="menu-title">Xarid invoyslari</span></a>
                        </li>
                    }
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Tender"))
                    {
                        <li class="nav-item">
                            <a href="~/Tender"><i class="bx bx-bar-chart-alt-2"></i><span class="menu-title">Tender taqqoslash</span></a>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Logistika -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Forwarder"))
                    {
                        <li class="navigation-header"><span>Logistika</span></li>
                        
                        <li class="nav-item">
                            <a href="#"><i class="bx bx-truck"></i><span class="menu-title">Yuk tashish</span></a>
                            <ul class="menu-content">
                                <li><a href="~/Forwarder/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Tashuvchi kompaniyalar</span></a></li>
                                <li><a href="~/FContract/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Shartnomalar</span></a></li>
                                <li><a href="~/Waybill/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Yo'l varaqalari</span></a></li>
                                <li><a href="~/FTransportType/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Transport turlari</span></a></li>
                                <li><a href="~/TransportLoadSimulation"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Transport yuklash simulyatsiyasi</span></a></li>
                            </ul>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Omborxona -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Warehouse") || 
                         RoleHelper.IsViewPermitted(User.Identity.Name, "Incomes") ||
                         RoleHelper.IsViewPermitted(User.Identity.Name, "Expenses") ||
                         RoleHelper.IsViewPermitted(User.Identity.Name, "Inventory") ||
                         RoleHelper.IsViewPermitted(User.Identity.Name, "InventoryReports"))
                    {
                        <li class="navigation-header"><span>Omborxona</span></li>
                        
                        <li class="nav-item">
                            <a href="#"><i class="bx bxs-home"></i><span class="menu-title">Ombor operatsiyalari</span></a>
                            <ul class="menu-content">
                                @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Inventory"))
                                {
                                    <li><a href="~/Inventory"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Ombor qoldiqlari</span></a></li>
                                }
                                @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Incomes"))
                                {
                                    <li><a href="~/Incomes"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Ombor kirimlari</span></a></li>
                                }
                                @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Expenses"))
                                {
                                    <li><a href="~/Expenses"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Ombor chiqimlari</span></a></li>
                                }
                                @if (RoleHelper.IsViewPermitted(User.Identity.Name, "InventoryReports"))
                                {
                                    <li><a href="~/InventoryReports/Dashboard"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">DOH Dashboard</span></a></li>
                                }
                                @if (RoleHelper.IsViewPermitted(User.Identity.Name, "Warehouse"))
                                {
                                    <li><a href="~/Warehouse"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Omborlar</span></a></li>
                                }
                            </ul>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Xarid bo'limi -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "PurchasingOrder"))
                    {
                        <li class="navigation-header"><span>Xarid</span></li>
                        
                        <li class="nav-item">
                            <a href="#"><i class="bx bxs-cart"></i><span class="menu-title">Xaridlar</span></a>
                            <ul class="menu-content">
                                <li><a href="/PurchasingOrder/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Buyurtmalar</span></a></li>
                                <li><a href="/PurchasingItem/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Maxsulotlar bazasi</span></a></li>
                                <li><a href="/PurchasingContract/Index"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Shartnomalar</span></a></li>
                            </ul>
                        </li>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Moliya -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "FinAccounts") || 
                         RoleHelper.IsViewPermitted(User.Identity.Name, "FinTransactions") ||
                         RoleHelper.IsViewPermitted(User.Identity.Name, "FinDashboard") ||
                         RoleHelper.IsViewPermitted(User.Identity.Name, "Shareholder") ||
                         RoleHelper.IsViewPermitted(User.Identity.Name, "Payment"))
                    {
                        <li class="navigation-header"><span>Moliya</span></li>
                        
                        if (RoleHelper.IsViewPermitted(User.Identity.Name, "FinAccounts") || 
                             RoleHelper.IsViewPermitted(User.Identity.Name, "FinTransactions") ||
                             RoleHelper.IsViewPermitted(User.Identity.Name, "FinCategories"))
                        {
                            <li class="nav-item">
                                <a href="#"><i class="bx bx-wallet"></i><span class="menu-title">Moliya boshqaruvi</span></a>
                                <ul class="menu-content">
                                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "FinAccounts"))
                                    {
                                        <li><a href="/FinAccounts"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Hisoblar</span></a></li>
                                    }
                                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "FinTransactions"))
                                    {
                                        <li><a href="/FinTransactions"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Tranzaksiyalar</span></a></li>
                                    }
                                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "FinCategories"))
                                    {
                                        <li><a href="/FinCategories"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Kategoriyalar</span></a></li>
                                    }
                                    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "FinBalanceCategories"))
                                    {
                                        <li><a href="/FinBalanceCategories"><i class="bx bx-right-arrow-alt"></i><span class="menu-item">Balans kategoriyalari</span></a></li>
                                    }
