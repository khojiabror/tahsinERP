@using tahsinERP.Models;
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
    <title>@ViewData["Title"] - Admin Panel</title>
    <script src="@tahsinERP.Helpers.AssetVersion.Url("~/assets/js/theme.js")"></script>
    <link rel="apple-touch-icon" href="~/app-assets/images/ico/apple-touch-icon.png">
    <link rel="shortcut icon" type="image/x-icon" href="~/app-assets/images/ico/favicon.ico">
    <link href="https://fonts.googleapis.com/css?family=Rubik:300,400,500,600%7CIBM+Plex+Sans:300,400,500,600,700" rel="stylesheet">

    <!-- Vendor CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/vendors.min.css" />
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/tables/datatable/datatables.min.css" />
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/tables/datatable/responsive.bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/forms/select/select2.min.css" />
    
    <!-- Theme CSS -->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap-extended.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/colors.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/components.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/themes/semi-dark-layout.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/core/menu/menu-types/vertical-menu.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css">
    @* Asosiy rang va kunduzgi/tungi rejim — _Layout bilan bir xil (BrandingService, assets/css/theme*.css) *@
    <style id="brand-vars">@Html.Raw(tahsinERP.Services.Common.BrandingService.RenderCssVariables(tahsinERP.Services.Common.BrandingService.Current().Tokens))</style>
    <link rel="stylesheet" type="text/css" href="@tahsinERP.Helpers.AssetVersion.Url("~/assets/css/theme-accent.css")" />
    <link rel="stylesheet" type="text/css" href="@tahsinERP.Helpers.AssetVersion.Url("~/assets/css/theme-dark.css")" />
    <link rel="stylesheet" type="text/css" href="@tahsinERP.Helpers.AssetVersion.Url("~/assets/css/theme.css")" />
</head>
<body class="vertical-layout vertical-menu-modern semi-dark-layout 2-columns navbar-sticky footer-static" data-open="click" data-menu="vertical-menu-modern" data-layout="semi-dark-layout" data-col="2-columns">
    @if (RoleHelper.IsViewPermitted(User.Identity.Name, "AdminPanel"))
    {
        <!-- Header -->
        <div class="header-navbar-shadow"></div>
        <nav class="header-navbar main-header-navbar navbar-expand-lg navbar navbar-with-menu fixed-top">
            <div class="navbar-wrapper">
                <div class="navbar-container content">
                    <div class="navbar-collapse" id="navbar-mobile">
                        <div class="mr-auto float-left bookmark-wrapper d-flex align-items-center">
                            <ul class="nav navbar-nav">
                                <li class="nav-item mobile-menu d-xl-none mr-auto">
                                    <a class="nav-link nav-menu-main menu-toggle hidden-xs" href="#"><i class="ficon bx bx-menu"></i></a>
                                </li>
                            </ul>
                            <ul class="nav navbar-nav">
                                <li>
                                    <a href="~/Home" class="btn btn-sm btn-outline-light">
                                        <i class="bx bx-arrow-back"></i> Asosiy sahifaga
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <ul class="nav navbar-nav float-right">
                            <li class="nav-item d-none d-lg-block">
                                <a class="nav-link nav-link-expand"><i class="ficon bx bx-fullscreen"></i></a>
                            </li>
                            @Html.Partial("~/Views/Shared/_ThemeSwitch.cshtml")
                            <li class="dropdown dropdown-user nav-item">
                                <a class="dropdown-toggle nav-link dropdown-user-link" href="#" data-toggle="dropdown">
                                    @Html.Partial("_HeaderUserName")
                                    @Html.Partial("_UserProfile")
                                </a>
                                <div class="dropdown-menu dropdown-menu-right pb-0">
                                    <a class="dropdown-item" href="@Url.Action("Settings", "Account", new { area = "" })">
                                        <i class="bx bx-user mr-50"></i> Profil sozlamalari
                                    </a>
                                    <div class="dropdown-divider mb-0"></div>
                                    <a class="dropdown-item" href="~/Account/Logout">
                                        <i class="bx bx-power-off mr-50"></i> Tizimdan chiqish
                                    </a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Menu -->
        <div class="main-menu menu-fixed menu-dark menu-accordion menu-shadow" data-scroll-to-active="true">
            <div class="navbar-header">
                <ul class="nav navbar-nav flex-row">
                    <li class="nav-item mr-auto">
                        <a class="navbar-brand" href="/AdminPanel">
                            <div class="brand-logo"><img class="logo" src="~/app-assets/images/logo/logo-32x32.png.png" /></div>
                            <h6 style="color:white; margin-left:10px;">Admin Panel</h6>
                        </a>
                    </li>
                    <li class="nav-item nav-toggle">
                        <a class="nav-link modern-nav-toggle pr-0" data-toggle="collapse">
                            <i class="bx bx-x d-block d-xl-none font-medium-4 primary toggle-icon"></i>
                            <i class="toggle-icon bx bx-disc font-medium-4 d-none d-xl-block collapse-toggle-icon primary" data-ticon="bx-disc"></i>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="shadow-bottom"></div>
            <div class="main-menu-content">
                <ul class="navigation navigation-main" id="main-menu-navigation" data-menu="menu-navigation">
                    <li class="nav-item">
                        <a href="~/AdminPanel"><i class="bx bx-home"></i><span class="menu-title">Bosh sahifa</span></a>
                    </li>

                    <li class="navigation-header"><span>Foydalanuvchilar</span></li>
                    <li class="nav-item">
                        <a href="~/User"><i class="bx bx-user"></i><span class="menu-title">Foydalanuvchilar</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="~/License"><i class="bx bx-key"></i><span class="menu-title">Litsenziyalar</span></a>
                    </li>

                    <li class="navigation-header"><span>Huquqlar</span></li>
                    <li class="nav-item">
                        <a href="~/Role"><i class="bx bx-shield"></i><span class="menu-title">Rollar</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="~/PModule"><i class="bx bx-list-check"></i><span class="menu-title">Modullar</span></a>
                    </li>

                    <li class="navigation-header"><span>Monitoring</span></li>
                    <li class="nav-item">
                        <a href="~/Log"><i class="bx bx-file"></i><span class="menu-title">Tizim loglari</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="~/UserEntries"><i class="bx bxs-file-doc"></i><span class="menu-title">Tizimga kirishlar</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="~/DeletedRecords"><i class="bx bx-undo"></i><span class="menu-title">O'chirilganlar</span></a>
                    </li>
                </ul>
            </div>
        </div>

        <div hidden>@Html.AntiForgeryToken()</div>
        <div>@RenderBody()</div>
        @Html.Partial("_LicenseBanner")

        <div class="sidenav-overlay"></div>
        <div class="drag-target"></div>

        <!-- Footer -->
        <footer class="footer footer-static footer-light">
            <p class="clearfix mb-0">
                <span class="float-left d-inline-block">@DateTime.Now.Year &copy; tahsinERP - Admin Panel</span>
            </p>
        </footer>

        @* jQuery — vendors.min.js ichida (3.3.1); alohida ~/bundles/jquery (3.7.1) ikkinchi nusxa edi *@
        <script src="~/Scripts/csrf.js"></script>

        <!-- Vendor JS -->
        <script src="~/app-assets/vendors/js/vendors.min.js"></script>
        <script>
            // LivIcons (261 KB) ishlatilmaydi; app-menu.js chaqiradigan metodlar uchun bo'sh stublar
            (function ($) {
                ['addLiviconEvo', 'removeLiviconEvo', 'updateLiviconEvo', 'playLiviconEvo', 'stopLiviconEvo'].forEach(function (m) {
                    if (!$.fn[m]) { $.fn[m] = function () { return this; }; }
                });
            })(jQuery);
        </script>

        <!-- DataTables -->
        <script src="~/app-assets/vendors/js/tables/datatable/datatables.min.js"></script>
        <script src="~/app-assets/vendors/js/tables/datatable/dataTables.bootstrap4.min.js"></script>
        <script src="~/app-assets/vendors/js/tables/datatable/dataTables.responsive.min.js"></script>
        <script src="~/app-assets/vendors/js/tables/datatable/responsive.bootstrap.min.js"></script>
        
        <!-- DataTables Buttons -->
        <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">
        <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
        <script src="~/assets/js/lazy-pdfmake.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
        
        <!-- Select2 -->
        <script src="~/app-assets/vendors/js/forms/select/select2.full.min.js"></script>

        <!-- Theme JS -->
        <script src="~/app-assets/js/scripts/configs/vertical-menu-dark.js"></script>
        <script src="~/app-assets/js/core/app-menu.js"></script>
        <script src="~/app-assets/js/core/app.js"></script>
        <script src="~/app-assets/js/scripts/components.js"></script>
        <script src="~/app-assets/js/scripts/datatables/datatable.js"></script>
        <script src="~/app-assets/js/scripts/forms/select/form-select2.js"></script>
        <script src="~/Scripts/app/erp-datatable.js"></script>
        <script src="~/assets/js/dt-defaults.js"></script>
        @* Sahifa skriptlari jQuery/DataTables yuklangandan keyin (CORE-P09) *@
        @RenderSection("Scripts", required: false)
    }
    else
    {
        Response.Redirect(Url.Action("Index", "ViewNotAuthorized", new { area = "" }));
    }
</body>
</html>

