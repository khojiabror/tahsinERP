@model string
@*
    Foydalanuvchi kiritgan HTML'ni (Quill matni) XSS'siz ko'rsatish.
    Kontent sandbox iframe ichida chiqadi: "allow-scripts" berilmagani uchun undagi
    har qanday <script>/onerror va h.k. ishlamaydi. allow-same-origin faqat
    balandlikni avtomatik moslash uchun kerak (skriptsiz xavfsiz).
*@
@{
    var doc = "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>"
        + "body{margin:0;font-family:'IBM Plex Sans',Helvetica,Arial,sans-serif;font-size:14px;color:#475f7b;word-wrap:break-word}"
        + "p{margin:0 0 .5em}img{max-width:100%}table{border-collapse:collapse}td,th{border:1px solid #ccc;padding:4px}"
        + ".ql-align-center{text-align:center}.ql-align-right{text-align:right}.ql-align-justify{text-align:justify}"
        + "</style></head><body>" + (Model ?? "") + "</body></html>";
}
<iframe sandbox="allow-same-origin" srcdoc="@doc" style="width:100%;border:0;min-height:180px;"
        onload="try{this.style.height=(this.contentWindow.document.documentElement.scrollHeight+8)+'px';}catch(e){}"></iframe>
