@* Kunduzgi / tungi rejim tanlagichi (yuqori panel). Mantiq: assets/js/theme.js (data-theme-set, data-theme-icon). *@
<li class="dropdown nav-item dropdown-theme">
    <a class="dropdown-toggle nav-link" href="#" data-toggle="dropdown" title="@L.T("Theme_Title")" aria-label="@L.T("Theme_Label")">
        <i class="ficon bx bx-adjust" data-theme-icon></i>
    </a>
    <div class="dropdown-menu dropdown-menu-right">
        <a class="dropdown-item" href="#" data-theme-set="light"><i class="bx bx-sun mr-50"></i>@L.T("Theme_Light")</a>
        <a class="dropdown-item" href="#" data-theme-set="dark"><i class="bx bx-moon mr-50"></i>@L.T("Theme_Dark")</a>
        <a class="dropdown-item" href="#" data-theme-set="auto"><i class="bx bx-adjust mr-50"></i>@L.T("Theme_Auto")</a>
    </div>
</li>
