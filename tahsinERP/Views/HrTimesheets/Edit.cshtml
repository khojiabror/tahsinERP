@model tahsinERP.ViewModels.HR.HrTimesheetHeaderViewModel
@{
    ViewBag.Title = L.T("Hr_TsEdit");
    Layout = "~/Views/Shared/_Layout.cshtml";
    int daysInMonth = DateTime.DaysInMonth(Model.Year, Model.Month);
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_Timesheet")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Edit")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                @if (TempData["Info"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        @TempData["Info"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                @if (Model.Status != "Draft")
                {
                    <div class="alert alert-warning" role="alert">
                        @L.T("Hr_TsStatusIs") <strong>@(Model.Status == "Approved" ? L.T("Hr_PayStatus_Approved") : L.T("Hr_TsStatus_Closed"))</strong>. @Html.Raw(L.T("Hr_TsOnlyDraftEditable"))
                    </div>
                }

                @if (Model.Status == "Draft")
                {
                    using (Html.BeginForm("SaveTimesheet", "HrTimesheets", FormMethod.Post, new { id = "timesheetSaveForm", style = "display:none;" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="timesheetId" value="@Model.ID" />
                        <input type="hidden" name="gridJson" id="timesheetGridJson" />
                        <input type="hidden" name="fundHours" id="timesheetFundHoursHidden" />
                    }
                }

                <div class="row mb-2">
                    <div class="col-12">
                        <div class="btn-group" role="group">
                            @if (Model.Status == "Draft")
                            {
                                
                                <button type="button" class="btn btn-sm btn-success" data-toggle="modal" data-target="#addEmployeesModal">
                                    <i class="bx bx-user-plus"></i> @L.T("Hr_EmpAdd")
                                </button>
                                <button type="button" class="btn btn-sm btn-primary" onclick="saveTimesheetGrid(); return false;" title="@L.T("Hr_TsSaveAllCells")">
                                    <i class="bx bx-save"></i> @L.T("Save")
                                </button>
                            }
                            <a href="@Url.Action("Export", new { id = Model.ID })" class="btn btn-sm btn-success">
                                <i class="bx bx-export"></i> @L.T("ExportExcel")
                            </a>
                            <a href="@Url.Action("Preview", new { id = Model.ID })" class="btn btn-sm btn-info" target="_blank">
                                <i class="bx bx-show"></i> @L.T("Hr_Preview")
                            </a>
                        </div>
                        <span class="badge badge-@(Model.Status == "Approved" ? "success" : Model.Status == "Closed" ? "info" : "warning") ml-2">
                            @L.T("Status"): @(Model.Status == "Draft" ? L.T("Hr_PayStatus_Draft") : Model.Status == "Approved" ? L.T("Hr_PayStatus_Approved") : L.T("Hr_TsStatus_Closed"))
                        </span>
                    </div>
                </div>

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="row mb-1">
                                <div class="col-md-3">
                                    <label>@L.T("Hr_FundHours")</label>
                                    <input type="number"
                                           id="timesheetFundHours"
                                           class="form-control form-control-sm"
                                           value="@Model.FundHours.ToString("0.##")"
                                           min="1"
                                           max="744"
                                           step="0.01"
                                           @(Model.Status != "Draft" ? "readonly" : "") />
                                </div>
                            </div>
                            <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                                <table class="table table-bordered table-striped" id="timesheetGrid">
                                    <thead class="thead-light" style="position: sticky; top: 0; z-index: 10; background: white;">
                                        <tr>
                                            <th rowspan="2" class="freeze-col freeze-col-1" style="min-width: 30px;">
                                                <input type="checkbox" id="selectAll" title="@L.T("Hr_SelectAll")" />
                                            </th>
                                            <th rowspan="2" class="freeze-col freeze-col-2" style="min-width: 50px;">№</th>
                                            <th rowspan="2" class="freeze-col freeze-col-3" style="min-width: 80px;">@L.T("Hr_TabNoShort")</th>
                                            <th rowspan="2" class="freeze-col freeze-col-4" style="min-width: 200px;">@L.T("Hr_FullName")</th>
                                            <th rowspan="2" class="freeze-col freeze-col-5" style="min-width: 150px;">@L.T("Hr_Position")</th>
                                            <th colspan="@daysInMonth" style="text-align: center;">@L.T("Hr_MonthDays")</th>
                                            <th rowspan="2" style="min-width: 80px;">@L.T("Hr_WorkDays")</th>
                                            <th rowspan="2" style="min-width: 80px;">@L.T("Hr_WorkHours")</th>
                                            <th rowspan="2" style="min-width: 80px;">@L.T("Hr_Overtime")</th>
                                            <th rowspan="2" style="min-width: 80px;">@L.T("Hr_Absent")</th>
                                            @if (Model.Status == "Draft")
                                            {
                                                <th rowspan="2" style="min-width: 60px;">@L.T("Actions")</th>
                                            }
                                        </tr>
                                        <tr>
                                            @for (int day = 1; day <= daysInMonth; day++)
                                            {
                                                <th style="min-width: 50px; text-align: center;">@day</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int rowNum = 1; }
                                        @foreach (var line in Model.Lines)
                                        {
                                            <tr data-employee-id="@line.EmployeeID">
                                                <td class="freeze-col freeze-col-1">
                                                    <input type="checkbox" class="row-checkbox" data-employee-id="@line.EmployeeID" />
                                                </td>
                                                <td class="freeze-col freeze-col-2">@rowNum</td>
                                                <td class="freeze-col freeze-col-3">@line.EmployeeTabNo</td>
                                                <td class="freeze-col freeze-col-4">@line.EmployeeFullName</td>
                                                <td class="freeze-col freeze-col-5">@line.PositionName</td>
                                                @for (int day = 1; day <= daysInMonth; day++)
                                                {
                                                    var hours = tahsinERP.Services.HR.TimesheetLineAccessor.GetHours(line, day);
                                                    <td>
                                                        <input type="number" 
                                                               class="form-control form-control-sm day-hours" 
                                                               data-line-id="@line.ID" 
                                                               data-day="@day" 
                                                               data-employee-id="@line.EmployeeID"
                                                               value="@(hours?.ToString("F2") ?? "0")" 
                                                               step="0.25" 
                                                               min="0" 
                                                               max="24"
                                                               style="width: 60px; text-align: center;"
                                                               @(Model.Status != "Draft" ? "readonly" : "") />
                                                    </td>
                                                }
                                                <td class="total-days">@line.TotalWorkedDays.ToString("F1")</td>
                                                <td class="total-hours">@line.TotalWorkedHours.ToString("F2")</td>
                                                <td class="overtime-hours">@line.OvertimeHours.ToString("F2")</td>
                                                <td class="absent-days">@line.AbsentDays.ToString("F1")</td>
                                                @if (Model.Status == "Draft")
                                                {
                                                    <td style="text-align: center;">
                                                        @using (Html.BeginForm("DeleteLine", "HrTimesheets", FormMethod.Post, new { @class = "delete-line-form", style = "display: inline;" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            @Html.Hidden("lineId", line.ID)
                                                            <button type="submit" class="btn btn-sm btn-danger" 
                                                                    data-msg="@L.T("Hr_TsDeleteLineConfirm", line.EmployeeFullName)"
                                                                    onclick="return confirm(this.getAttribute('data-msg'));"
                                                                    title="@L.T("Delete")">
                                                                <i class="bx bx-trash"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                            rowNum++;
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="font-weight-bold table-light">
                                            <td colspan="@(5 + daysInMonth)" class="text-right">@L.T("Hr_TotalOvertimeHours"):</td>
                                            <td></td>
                                            <td></td>
                                            <td id="totalOvertimeHours">@Model.Lines.Sum(l => l.OvertimeHours).ToString("F2")</td>
                                            <td></td>
                                            @if (Model.Status == "Draft")
                                            {
                                                <td></td>
                                            }
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Status == "Draft")
    {
        <div class="modal fade" id="addEmployeesModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    @using (Html.BeginForm("AddEmployees", "HrTimesheets", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("timesheetId", Model.ID)
                        <div class="modal-header">
                            <h5 class="modal-title">@L.T("Hr_TsAddEmployees")</h5>
                            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                        </div>
                        <div class="modal-body">
                            <label>@L.T("Hr_EmployeesMulti")</label>
                            @Html.ListBox("employeeIds", ViewBag.AvailableEmployees as MultiSelectList, new { @class = "form-control employee-multi-select", @style = "min-height: 280px;" })
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">@L.T("Cancel")</button>
                            <button type="submit" class="btn btn-success"><i class="bx bx-user-plus"></i> @L.T("Add")</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <style>
        #timesheetGrid {
            font-size: 12px;
        }
        #timesheetGrid th {
            background-color: #f8f9fa;
            font-weight: bold;
        }
        #timesheetGrid .day-hours {
            padding: 2px 4px;
        }
        #timesheetGrid .day-hours:focus {
            background-color: #fff3cd;
        }
        #timesheetGrid tbody tr:hover {
            background-color: #f5f5f5;
        }
        #timesheetGrid .freeze-col {
            position: sticky;
            background: #fff;
            z-index: 5;
        }
        #timesheetGrid thead .freeze-col {
            z-index: 20;
            background: #f8f9fa;
        }
        #timesheetGrid .freeze-col-1 { left: 0; min-width: 30px; }
        #timesheetGrid .freeze-col-2 { left: 30px; min-width: 50px; }
        #timesheetGrid .freeze-col-3 { left: 80px; min-width: 80px; }
        #timesheetGrid .freeze-col-4 { left: 160px; min-width: 200px; }
        #timesheetGrid .freeze-col-5 { left: 360px; min-width: 150px; }
    </style>

@section Scripts
{
    <script>
        var timesheetId = @Model.ID;
        var daysInMonth = @daysInMonth;
        // HR sozlamalaridagi ish kalendari (HRM-B15): workingDays[d] — d-kun ish kunimi
        var workingDays = @Html.Raw(Json.Encode(Enumerable.Range(0, daysInMonth + 1).Select(d => d > 0 && tahsinERP.Services.HR.HrSettingsService.Current.IsWorkingDay(new DateTime(Model.Year, Model.Month, d)))));
        var dailyNorm = @(tahsinERP.Services.HR.HrSettingsService.Current.DailyNormHours.ToString(System.Globalization.CultureInfo.InvariantCulture));

        function saveTimesheetGrid() {
            var hours = [];
            $('.day-hours').each(function () {
                var $input = $(this);
                var v = parseFloat($input.val());
                if (isNaN(v)) v = 0;
                hours.push({
                    LineId: parseInt($input.data('line-id'), 10),
                    Day: parseInt($input.data('day'), 10),
                    Hours: v
                });
            });
            var payload = { Hours: hours };
            $('#timesheetGridJson').val(JSON.stringify(payload));
            $('#timesheetFundHoursHidden').val($('#timesheetFundHours').val());
            $('#timesheetSaveForm').submit();
        }

        $(document).ready(function() {
            // Handle hour input changes
            $('.employee-multi-select').select2({
                width: '100%',
                placeholder: '@L.Js("Hr_SelectEmployees")',
                allowClear: true,
                dropdownParent: $('#addEmployeesModal')
            });

            // Faqat 'change' — avval 'change blur' har katakdan o'tishda ham POST yuborardi (HRM-P05)
            $('.day-hours').on('change', function() {
                var $input = $(this);
                var lineId = $input.data('line-id');
                var day = $input.data('day');
                var hours = parseFloat($input.val()) || 0;

                if (hours < 0) hours = 0;
                if (hours > 24) hours = 24;
                $input.val(hours.toFixed(2));

                // Update via AJAX
                $.post('@Url.Action("UpdateLine")', {
                    lineId: lineId,
                    day: day,
                    hours: hours
                }, function(result) {
                    if (result.success) {
                        // Recalculate row totals
                        recalculateRow($input.closest('tr'));
                    } else {
                        alert('@L.Js("Error"): ' + result.message);
                    }
                });
            });

            // Select all checkbox
            $('#selectAll').on('change', function() {
                var isChecked = $(this).prop('checked');
                $('.row-checkbox').prop('checked', isChecked);
                $('#timesheetGrid tbody tr').toggleClass('table-active', isChecked);
            });

            // Individual checkbox change
            $('.row-checkbox').on('change', function() {
                $(this).closest('tr').toggleClass('table-active', $(this).prop('checked'));
                
                // Update select all checkbox
                var totalCheckboxes = $('.row-checkbox').length;
                var checkedCheckboxes = $('.row-checkbox:checked').length;
                $('#selectAll').prop('checked', totalCheckboxes === checkedCheckboxes);
            });

        });

        function recalculateRow($row) {
            var totalHours = 0;
            var workedDays = 0;
            var absentDays = 0;
            var overtimeHours = 0;

            $row.find('.day-hours').each(function() {
                var hours = parseFloat($(this).val()) || 0;
                var isWorking = workingDays[parseInt($(this).data('day'), 10)] === true;
                if (hours > 0) {
                    totalHours += hours;
                    workedDays += 1;
                    if (!isWorking) {
                        overtimeHours += hours;
                    } else if (hours > dailyNorm) {
                        overtimeHours += (hours - dailyNorm);
                    }
                } else if (isWorking) {
                    absentDays += 1;
                }
            });

            $row.find('.total-hours').text(totalHours.toFixed(2));
            $row.find('.total-days').text(workedDays.toFixed(1));
            $row.find('.overtime-hours').text(overtimeHours.toFixed(2));
            $row.find('.absent-days').text(absentDays.toFixed(1));
            refreshOvertimeTotal();
        }

        function refreshOvertimeTotal() {
            var total = 0;
            $('.overtime-hours').each(function() {
                total += parseFloat($(this).text()) || 0;
            });
            $('#totalOvertimeHours').text(total.toFixed(2));
        }

    </script>
}

