@model tahsinERP.ViewModels.HR.HrTimesheetHeaderViewModel
@{
    ViewBag.Title = "Tabelni tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int daysInMonth = DateTime.DaysInMonth(Model.Year, Model.Month);
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrTimesheets"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Tabel</a></li>
                                    <li class="breadcrumb-item active">Tahrirlash</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                @if (TempData["Info"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        @TempData["Info"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                @if (Model.Status != "Draft")
                {
                    <div class="alert alert-warning" role="alert">
                        Bu tabel holati <strong>@(Model.Status == "Approved" ? "Tasdiqlangan" : "Yopilgan")</strong>. Faqat <strong>Qoralama</strong> holatidagi tabelni tahrirlash mumkin.
                    </div>
                }

                @if (Model.Status == "Draft")
                {
                    using (Html.BeginForm("SaveTimesheet", "HrTimesheets", FormMethod.Post, new { id = "timesheetSaveForm", style = "display:none;" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="timesheetId" value="@Model.ID" />
                        <input type="hidden" name="gridJson" id="timesheetGridJson" />
                    }
                }

                <div class="row mb-2">
                    <div class="col-12">
                        <div class="btn-group" role="group">
                            @if (Model.Status == "Draft")
                            {
                                
                                <button type="button" class="btn btn-sm btn-success" data-toggle="modal" data-target="#addEmployeesModal">
                                    <i class="bx bx-user-plus"></i> Xodim qo'shish
                                </button>
                                <button type="button" class="btn btn-sm btn-primary" onclick="saveTimesheetGrid(); return false;" title="Barcha katakchalarni bazaga yozish">
                                    <i class="bx bx-save"></i> Saqlash
                                </button>
                            }
                            <a href="@Url.Action("Export", new { id = Model.ID })" class="btn btn-sm btn-success">
                                <i class="bx bx-export"></i> Excelga eksport
                            </a>
                            <a href="@Url.Action("Preview", new { id = Model.ID })" class="btn btn-sm btn-info" target="_blank">
                                <i class="bx bx-show"></i> Ko'rib chiqish
                            </a>
                        </div>
                        <span class="badge badge-@(Model.Status == "Approved" ? "success" : Model.Status == "Closed" ? "info" : "warning") ml-2">
                            Holat: @(Model.Status == "Draft" ? "Qoralama" : Model.Status == "Approved" ? "Tasdiqlangan" : "Yopilgan")
                        </span>
                    </div>
                </div>

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                                <table class="table table-bordered table-striped" id="timesheetGrid">
                                    <thead class="thead-light" style="position: sticky; top: 0; z-index: 10; background: white;">
                                        <tr>
                                            <th rowspan="2" class="freeze-col freeze-col-1" style="min-width: 30px;">
                                                <input type="checkbox" id="selectAll" title="Barchasini tanlash" />
                                            </th>
                                            <th rowspan="2" class="freeze-col freeze-col-2" style="min-width: 50px;">№</th>
                                            <th rowspan="2" class="freeze-col freeze-col-3" style="min-width: 80px;">Tab.№</th>
                                            <th rowspan="2" class="freeze-col freeze-col-4" style="min-width: 200px;">F.I.O.</th>
                                            <th rowspan="2" class="freeze-col freeze-col-5" style="min-width: 150px;">Lavozim</th>
                                            <th colspan="@daysInMonth" style="text-align: center;">Oy kunlari</th>
                                            <th rowspan="2" style="min-width: 80px;">Ish kunlari</th>
                                            <th rowspan="2" style="min-width: 80px;">Ish soatlari</th>
                                            <th rowspan="2" style="min-width: 80px;">Qo'shimcha</th>
                                            <th rowspan="2" style="min-width: 80px;">Qatnashmagan</th>
                                            @if (Model.Lines.Any(l => l.IsPieceRate))
                                            {
                                                <th rowspan="2" style="min-width: 150px;">Maxsulot</th>
                                                <th rowspan="2" style="min-width: 80px;">Jami miqdor</th>
                                            }
                                            @if (Model.Status == "Draft")
                                            {
                                                <th rowspan="2" style="min-width: 60px;">Amallar</th>
                                            }
                                        </tr>
                                        <tr>
                                            @for (int day = 1; day <= daysInMonth; day++)
                                            {
                                                <th style="min-width: 50px; text-align: center;">@day</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int rowNum = 1; }
                                        @foreach (var line in Model.Lines)
                                        {
                                            <tr data-employee-id="@line.EmployeeID">
                                                <td class="freeze-col freeze-col-1">
                                                    <input type="checkbox" class="row-checkbox" data-employee-id="@line.EmployeeID" />
                                                </td>
                                                <td class="freeze-col freeze-col-2">@rowNum</td>
                                                <td class="freeze-col freeze-col-3">@line.EmployeeTabNo</td>
                                                <td class="freeze-col freeze-col-4">@line.EmployeeFullName</td>
                                                <td class="freeze-col freeze-col-5">@line.PositionName</td>
                                                @for (int day = 1; day <= daysInMonth; day++)
                                                {
                                                    var propertyName = $"Day{day:D2}Hours";
                                                    var property = typeof(tahsinERP.ViewModels.HR.HrTimesheetLineViewModel).GetProperty(propertyName);
                                                    var hours = property?.GetValue(line) as decimal?;
                                                    <td>
                                                        <input type="number" 
                                                               class="form-control form-control-sm day-hours" 
                                                               data-line-id="@line.ID" 
                                                               data-day="@day" 
                                                               data-employee-id="@line.EmployeeID"
                                                               value="@(hours?.ToString("F2") ?? "0")" 
                                                               step="0.25" 
                                                               min="0" 
                                                               max="24"
                                                               style="width: 60px; text-align: center;"
                                                               @(Model.Status != "Draft" ? "readonly" : "") />
                                                        @if (line.IsPieceRate)
                                                        {
                                                            var quantityPropertyName = $"Day{day:D2}Quantity";
                                                            var quantityProperty = typeof(tahsinERP.ViewModels.HR.HrTimesheetLineViewModel).GetProperty(quantityPropertyName);
                                                            var quantity = quantityProperty?.GetValue(line) as decimal?;
                                                            <br />
                                                            <input type="number" 
                                                                   class="form-control form-control-sm day-quantity" 
                                                                   data-line-id="@line.ID" 
                                                                   data-day="@day"
                                                                   value="@(quantity?.ToString("F2") ?? "0")" 
                                                                   step="0.01" 
                                                                   min="0"
                                                                   placeholder="Miqdor"
                                                                   style="width: 60px; text-align: center; margin-top: 2px; font-size: 10px;"
                                                                   @(Model.Status != "Draft" ? "readonly" : "") />
                                                        }
                                                    </td>
                                                }
                                                <td class="total-days">@line.TotalWorkedDays.ToString("F1")</td>
                                                <td class="total-hours">@line.TotalWorkedHours.ToString("F2")</td>
                                                <td class="overtime-hours">@line.OvertimeHours.ToString("F2")</td>
                                                <td class="absent-days">@line.AbsentDays.ToString("F1")</td>
                                                @if (Model.Lines.Any(l => l.IsPieceRate))
                                                {
                                                    <td>
                                                        @if (line.IsPieceRate)
                                                        {
                                                            @Html.DropDownList("ProductID_" + line.ID, 
                                                                ViewBag.FinishedGoods as SelectList, 
                                                                "Maxsulotni tanlang", 
                                                                new { 
                                                                    @class = "form-control form-control-sm piece-rate-product", 
                                                                    @data_line_id = line.ID,
                                                                    @disabled = Model.Status != "Draft" ? "disabled" : null
                                                                })
                                                        }
                                                    </td>
                                                    <td class="total-quantity">@(line.TotalQuantity?.ToString("F2") ?? "0")</td>
                                                }
                                                @if (Model.Status == "Draft")
                                                {
                                                    <td style="text-align: center;">
                                                        @using (Html.BeginForm("DeleteLine", "HrTimesheets", FormMethod.Post, new { @class = "delete-line-form", style = "display: inline;" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            @Html.Hidden("lineId", line.ID)
                                                            <button type="submit" class="btn btn-sm btn-danger" 
                                                                    onclick="return confirm('@line.EmployeeFullName qatorini o\'chirishni xohlaysizmi? Bu amalni qaytarib bo\'lmaydi.');"
                                                                    title="O'chirish">
                                                                <i class="bx bx-trash"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                            rowNum++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    if (Model.Status == "Draft")
    {
        <div class="modal fade" id="addEmployeesModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    @using (Html.BeginForm("AddEmployees", "HrTimesheets", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("timesheetId", Model.ID)
                        <div class="modal-header">
                            <h5 class="modal-title">Tabelga xodim qo'shish</h5>
                            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                        </div>
                        <div class="modal-body">
                            <label>Xodimlar (bir nechta tanlash mumkin)</label>
                            @Html.ListBox("employeeIds", ViewBag.AvailableEmployees as MultiSelectList, new { @class = "form-control employee-multi-select", @style = "min-height: 280px;" })
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Bekor qilish</button>
                            <button type="submit" class="btn btn-success"><i class="bx bx-user-plus"></i> Qo'shish</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <style>
        #timesheetGrid {
            font-size: 12px;
        }
        #timesheetGrid th {
            background-color: #f8f9fa;
            font-weight: bold;
        }
        #timesheetGrid .day-hours {
            padding: 2px 4px;
        }
        #timesheetGrid .day-hours:focus {
            background-color: #fff3cd;
        }
        #timesheetGrid tbody tr:hover {
            background-color: #f5f5f5;
        }
        #timesheetGrid .freeze-col {
            position: sticky;
            background: #fff;
            z-index: 5;
        }
        #timesheetGrid thead .freeze-col {
            z-index: 20;
            background: #f8f9fa;
        }
        #timesheetGrid .freeze-col-1 { left: 0; min-width: 30px; }
        #timesheetGrid .freeze-col-2 { left: 30px; min-width: 50px; }
        #timesheetGrid .freeze-col-3 { left: 80px; min-width: 80px; }
        #timesheetGrid .freeze-col-4 { left: 160px; min-width: 200px; }
        #timesheetGrid .freeze-col-5 { left: 360px; min-width: 150px; }
    </style>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@section Scripts
{
    <script>
        var timesheetId = @Model.ID;
        var daysInMonth = @daysInMonth;

        function saveTimesheetGrid() {
            var hours = [];
            $('.day-hours').each(function () {
                var $input = $(this);
                var v = parseFloat($input.val());
                if (isNaN(v)) v = 0;
                hours.push({
                    LineId: parseInt($input.data('line-id'), 10),
                    Day: parseInt($input.data('day'), 10),
                    Hours: v
                });
            });
            var quantities = [];
            $('.day-quantity').each(function () {
                var $input = $(this);
                var v = parseFloat($input.val());
                if (isNaN(v)) v = 0;
                quantities.push({
                    LineId: parseInt($input.data('line-id'), 10),
                    Day: parseInt($input.data('day'), 10),
                    Quantity: v
                });
            });
            var products = [];
            $('.piece-rate-product').each(function () {
                var $sel = $(this);
                var pid = $sel.val();
                if (!pid) return;
                var lineId = $sel.data('line_id');
                if (lineId == null) lineId = $sel.attr('data-line_id');
                if (lineId == null) return;
                products.push({
                    LineId: parseInt(lineId, 10),
                    ProductId: parseInt(pid, 10)
                });
            });
            var payload = { Hours: hours, Quantities: quantities, Products: products };
            $('#timesheetGridJson').val(JSON.stringify(payload));
            $('#timesheetSaveForm').submit();
        }

        $(document).ready(function() {
            // Handle hour input changes
            $('.employee-multi-select').select2({
                width: '100%',
                placeholder: "Xodimlarni tanlang",
                allowClear: true,
                dropdownParent: $('#addEmployeesModal')
            });

            $('.day-hours').on('change blur', function() {
                var $input = $(this);
                var lineId = $input.data('line-id');
                var day = $input.data('day');
                var hours = parseFloat($input.val()) || 0;

                if (hours < 0) hours = 0;
                if (hours > 24) hours = 24;
                $input.val(hours.toFixed(2));

                // Update via AJAX
                $.post('@Url.Action("UpdateLine")', {
                    lineId: lineId,
                    day: day,
                    hours: hours
                }, function(result) {
                    if (result.success) {
                        // Recalculate row totals
                        recalculateRow($input.closest('tr'));
                    } else {
                        alert('Xatolik: ' + result.message);
                    }
                });
            });

            // Handle quantity input changes for piece-rate
            $('.day-quantity').on('change blur', function() {
                var $input = $(this);
                var lineId = $input.data('line-id');
                var day = $input.data('day');
                var quantity = parseFloat($input.val()) || 0;

                if (quantity < 0) quantity = 0;
                $input.val(quantity.toFixed(2));

                // Get product ID from dropdown
                var $row = $input.closest('tr');
                var productId = $row.find('.piece-rate-product').val();

                // Update via AJAX
                $.post('@Url.Action("UpdateQuantity")', {
                    lineId: lineId,
                    day: day,
                    quantity: quantity,
                    productId: productId
                }, function(result) {
                    if (result.success) {
                        // Recalculate row totals
                        recalculateRow($row);
                    } else {
                        alert('Xatolik: ' + result.message);
                    }
                });
            });

            // Handle product selection change for piece-rate
            $('.piece-rate-product').on('change', function() {
                var $select = $(this);
                var lineId = $select.data('line-id');
                var productId = $select.val();

                if (productId) {
                    // Update product ID for all days
                    $.post('@Url.Action("UpdateQuantity")', {
                        lineId: lineId,
                        day: 1,
                        quantity: null,
                        productId: productId
                    }, function(result) {
                        if (!result.success) {
                            alert('Xatolik: ' + result.message);
                        }
                    });
                }
            });

            // Select all checkbox
            $('#selectAll').on('change', function() {
                var isChecked = $(this).prop('checked');
                $('.row-checkbox').prop('checked', isChecked);
                $('#timesheetGrid tbody tr').toggleClass('table-active', isChecked);
            });

            // Individual checkbox change
            $('.row-checkbox').on('change', function() {
                $(this).closest('tr').toggleClass('table-active', $(this).prop('checked'));
                
                // Update select all checkbox
                var totalCheckboxes = $('.row-checkbox').length;
                var checkedCheckboxes = $('.row-checkbox:checked').length;
                $('#selectAll').prop('checked', totalCheckboxes === checkedCheckboxes);
            });

        });

        function recalculateRow($row) {
            var totalHours = 0;
            var workedDays = 0;
            var absentDays = 0;
            var overtimeHours = 0;
            var totalQuantity = 0;

            $row.find('.day-hours').each(function() {
                var hours = parseFloat($(this).val()) || 0;
                if (hours > 0) {
                    totalHours += hours;
                    workedDays += 1;
                    if (hours > 8) {
                        overtimeHours += (hours - 8);
                    }
                } else {
                    absentDays += 1;
                }
            });

            // Calculate total quantity for piece-rate
            $row.find('.day-quantity').each(function() {
                var quantity = parseFloat($(this).val()) || 0;
                if (quantity > 0) {
                    totalQuantity += quantity;
                }
            });

            $row.find('.total-hours').text(totalHours.toFixed(2));
            $row.find('.total-days').text(workedDays.toFixed(1));
            $row.find('.overtime-hours').text(overtimeHours.toFixed(2));
            $row.find('.absent-days').text(absentDays.toFixed(1));
            $row.find('.total-quantity').text(totalQuantity.toFixed(2));
        }

        function importFromProduction() {
            var selectedRows = $('#timesheetGrid tbody tr').filter(function() {
                return $(this).find('.row-checkbox').prop('checked');
            });
            
            if (selectedRows.length === 0) {
                alert('Iltimos, kamida bitta xodimni tanlang');
                return;
            }

            if (!confirm('Tanlangan xodimlar uchun ishlab chiqarish ma\'lumotlarini import qilishni xohlaysizmi?')) {
                return;
            }

            selectedRows.each(function() {
                var employeeId = $(this).data('employee-id');
                $.post('@Url.Action("ImportFromProduction")', {
                    timesheetId: timesheetId,
                    employeeId: employeeId,
                    year: @Model.Year,
                    month: @Model.Month
                }, function(result) {
                    if (result.success) {
                        location.reload();
                    } else {
                        alert('Xatolik: ' + result.message);
                    }
                });
            });
        }

        function showPieceRateModal() {
            alert('Ishbay ma\'lumotlarini kiritish funksiyasi ishlab chiqilmoqda');
        }

        function postBulkUpdate(employeeIds, day, hours) {
            return $.ajax({
                url: '@Url.Action("BulkUpdate")',
                type: 'POST',
                traditional: true,
                data: {
                    timesheetId: timesheetId,
                    employeeIds: employeeIds,
                    day: day,
                    hours: hours
                }
            });
        }

        function setDefaultHours(hours) {
            var selectedRows = $('#timesheetGrid tbody tr').filter(function() {
                return $(this).find('.row-checkbox').prop('checked');
            });
            
            if (selectedRows.length === 0) {
                alert('Qatorlarni tanlang (checkbox\'larni belgilang)');
                return;
            }

            if (confirm('Belgilanganlarga ' + hours + ' soat qo\'yish?')) {
                var employeeIds = [];
                selectedRows.each(function() {
                    employeeIds.push($(this).data('employee-id'));
                });

                var requests = [];
                for (var day = 1; day <= daysInMonth; day++) {
                    requests.push(postBulkUpdate(employeeIds, day, hours));
                }

                $.when.apply($, requests)
                    .done(function () { location.reload(); })
                    .fail(function (xhr) {
                        var msg = (xhr && xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : "Yangilashda xatolik";
                        alert(msg);
                    });
            }
        }

        function markWeekend() {
            var selectedRows = $('#timesheetGrid tbody tr').filter(function() {
                return $(this).find('.row-checkbox').prop('checked');
            });
            
            if (selectedRows.length === 0) {
                alert('Qatorlarni tanlang (checkbox\'larni belgilang)');
                return;
            }

            // Mark weekends (Saturday=6, Sunday=0)
            var year = @Model.Year;
            var month = @Model.Month;
            var employeeIds = [];
            selectedRows.each(function() {
                employeeIds.push($(this).data('employee-id'));
            });

            var requests = [];
            for (var day = 1; day <= daysInMonth; day++) {
                var date = new Date(year, month - 1, day);
                var dayOfWeek = date.getDay();
                if (dayOfWeek === 0 || dayOfWeek === 6) {
                    requests.push(postBulkUpdate(employeeIds, day, 0));
                }
            }
            if (requests.length === 0) {
                alert('Bu oyda dam olish kuni topilmadi');
                return;
            }

            $.when.apply($, requests)
                .done(function () { location.reload(); })
                .fail(function (xhr) {
                    var msg = (xhr && xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : "Yangilashda xatolik";
                    alert(msg);
                });
        }

    </script>
}

