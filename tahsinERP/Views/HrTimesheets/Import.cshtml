@{
    ViewBag.Title = "Exceldan tabel import qilish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Tabel</a></li>
                                    <li class="breadcrumb-item active">Import</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            @using (Html.BeginForm("UploadExcel", "HrTimesheets", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="form-group">
                                    <label>Yil</label>
                                    <input type="number" name="year" class="form-control" value="@DateTime.Now.Year" min="2000" max="2100" required />
                                    <small class="text-muted">List nomidan yil aniqlanmasa, bu yil ishlatiladi</small>
                                </div>

                                <div class="form-group">
                                    <label>Bo'lim (ixtiyoriy)</label>
                                    @Html.DropDownList("orgUnitId", ViewBag.OrgUnitID as SelectList, "Butun kompaniya", new { @class = "form-control select2" })
                                </div>

                                <div class="form-group">
                                    <label>Excel fayli <span class="text-danger">*</span></label>
                                    <input type="file" name="file" class="form-control" accept=".xlsx,.xls" required />
                                    <small class="text-muted">Format: Excel fayl bilan tabel (iPack - TABEL.xlsx). Fayl yuklangandan keyin listlarni tanlash oynasi ochiladi.</small>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-upload"></i> Faylni yuklash
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">Bekor qilish</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('.select2').select2({ width: '100%' });
        });
    </script>

