@{
    ViewBag.Title = L.T("Hr_TsSelectSheetTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_Timesheet")</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Import")">@L.T("Import")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Hr_TsSelectSheetCrumb")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            @using (Html.BeginForm("ImportFromSheet", "HrTimesheets", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()

                                <div class="form-group">
                                    <label>@L.T("Hr_TsSelectSheet") <span class="text-danger">*</span></label>
                                    @{
                                        var sheetNamesList = ViewBag.SheetNames as System.Web.Mvc.SelectList;
                                    }
                                    @if (sheetNamesList != null)
                                    {
                                        @Html.DropDownList("sheetName", sheetNamesList, L.T("Hr_TsSelectSheet"), new { @class = "form-control", required = "required" })
                                    }
                                    else
                                    {
                                        <select name="sheetName" class="form-control" required>
                                            <option value="">@L.T("Hr_TsSelectSheet")</option>
                                        </select>
                                        <div class="alert alert-warning mt-2">
                                            <i class="bx bx-error"></i> @L.T("Hr_TsNoSheets")
                                        </div>
                                    }
                                    <small class="text-muted">@L.T("Hr_TsSelectSheetHint")</small>
                                </div>

                                <input type="hidden" name="year" value="@ViewBag.Year" />
                                <input type="hidden" name="orgUnitId" value="@ViewBag.OrgUnitId" />
                                <input type="hidden" name="fileToken" value="@ViewBag.FileToken" />

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-import"></i> @L.T("Hr_DoImport")
                                    </button>
                                    <a href="@Url.Action("Import")" class="btn btn-secondary">@L.T("Back")</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

