@model List<tahsinERP.Models.HR_TIMESHEET_HEADERS>
@{
    ViewBag.Title = "Tabel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    @{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrTimesheets"); }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item active">Soatbay tabel</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (changePermit)
                {
                    <div class="invoice-create-btn mb-1">
                        <a href="@Url.Action("Create")" class="btn btn-success">
                            <i class="bx bx-plus"></i> Tabel yaratish
                        </a>
                        <a href="@Url.Action("Import")" class="btn btn-info">
                            <i class="bx bx-import"></i> Exceldan import
                        </a>
                        <a href="@Url.Action("Index", "HrSettings")" class="btn btn-outline-secondary" title="Ish kalendari va koeffitsientlar">
                            <i class="bx bx-cog"></i> Sozlamalar
                        </a>
                    </div>
                }

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <form method="get" action="@Url.Action("Index")" class="mb-2">
                                <div class="row">
                                    <div class="col-md-2">
                                        <input type="number" name="year" class="form-control" value="@ViewBag.Year" placeholder="Yil" min="2000" max="2100" />
                                    </div>
                                    <div class="col-md-2">
                                        <select name="month" class="form-control">
                                            <option value="">Barcha oylar</option>
                                            @for (int i = 1; i <= 12; i++)
                                            {
                                                <option value="@i" @(ViewBag.Month == i ? "selected" : "")>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        @Html.DropDownList("orgUnitId", ViewBag.OrgUnitID as SelectList, "Barcha bo'limlar", new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-2">
                                        <select name="status" class="form-control">
                                            <option value="">Barcha holatlar</option>
                                            <option value="Draft" @(ViewBag.Status == "Draft" ? "selected" : "")>Qoralama</option>
                                            <option value="Approved" @(ViewBag.Status == "Approved" ? "selected" : "")>Tasdiqlangan</option>
                                            <option value="Closed" @(ViewBag.Status == "Closed" ? "selected" : "")>Yopilgan</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <button type="submit" class="btn btn-primary">Filtr</button>
                                    </div>
                                </div>
                            </form>

                            <div class="table-responsive">
                                <table id="timesheetsTable" class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Yil</th>
                                            <th>Oy</th>
                                            <th>Bo'lim</th>
                                            <th>Holat</th>
                                            <th>Yaratilgan</th>
                                            <th>Tasdiqlangan</th>
                                            <th>Amallar</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.Year</td>
                                                <td>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.Month)</td>
                                                <td>@(item.HR_ORG_UNITS?.Name ?? "Butun kompaniya")</td>
                                                <td>
                                                    <span class="badge badge-@(item.Status == "Approved" ? "success" : item.Status == "Closed" ? "info" : "warning")">
                                                        @(item.Status == "Draft" ? "Qoralama" : item.Status == "Approved" ? "Tasdiqlangan" : "Yopilgan")
                                                    </span>
                                                </td>
                                                <td>@item.CreatedDT.ToString("dd.MM.yyyy")</td>
                                                <td>@(item.ApprovedDT?.ToString("dd.MM.yyyy") ?? "-")</td>
                                                <td>
                                                    <a href="@Url.Action("Preview", new { id = item.ID })" class="btn btn-sm btn-outline-info" target="_blank" title="Ko'rib chiqish">
                                                        <i class="bx bx-show"></i>
                                                    </a>
                                                    @if (item.Status == "Draft")
                                                    {
                                                        <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-info" title="Tahrirlash">
                                                            <i class="bx bx-edit"></i>
                                                        </a>
                                                    }
                                                    @if (changePermit && item.Status == "Draft")
                                                    {
                                                        <a href="#" data-post-url="@Url.Action("Approve", new { id = item.ID })" data-confirm="Tabelni tasdiqlash?" class="btn btn-sm btn-primary" title="Tasdiqlash">
                                                            <i class="bx bx-check"></i>
                                                        </a>
                                                    }
                                                    @if (changePermit && item.Status == "Approved")
                                                    {
                                                        <a href="#" data-post-url="@Url.Action("Close", new { id = item.ID })" data-confirm="Tabelni yopish?" class="btn btn-sm btn-secondary" title="Yopish">
                                                            <i class="bx bx-lock"></i>
                                                        </a>
                                                    }
                                                    @if (changePermit && item.Status == "Draft")
                                                    {
                                                        <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-danger" onclick="return confirm('Tabelni o\'chirish?');">
                                                            <i class="bx bx-trash"></i>
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('#timesheetsTable').DataTable({
                "language": {
                    "lengthMenu": "_MENU_ ta ko'rsatish",
                    "zeroRecords": "Yozuvlar topilmadi",
                    "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    "infoEmpty": "Yozuvlar yo'q",
                    "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                    "search": "Qidirish:",
                    "paginate": {
                        "first": "Birinchi",
                        "last": "Oxirgi",
                        "next": "Keyingi",
                        "previous": "Oldingi"
                    }
                },
                "pageLength": 25,
                "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Hammasi"]],
                "order": [[0, "desc"], [1, "desc"]],
                dom: 'lBfrtip',
                buttons: [
                    { extend: 'excelHtml5', text: '<i class="bx bxs-file-excel"></i> Excel', titleAttr: 'Excelga yuklash', className: 'btn btn-success btn-sm mr-1', exportOptions: { columns: ':visible', format: { body: function(d) { return (d||'').toString().replace(/<[^>]*>/g,'').trim(); } } } },
                    { extend: 'pdfHtml5', text: '<i class="bx bxs-file-pdf"></i> PDF', titleAttr: 'PDFga yuklash', className: 'btn btn-danger btn-sm', pageSize: 'A4', exportOptions: { columns: ':visible', format: { body: function(d) { return (d||'').toString().replace(/<[^>]*>/g,'').trim(); } } } }
                ]
            });
        });
    </script>

