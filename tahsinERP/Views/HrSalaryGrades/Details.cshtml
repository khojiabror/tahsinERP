@model tahsinERP.ViewModels.HR.HrSalaryGradeViewModel
@{
    ViewBag.Title = L.T("Hr_GradeDetails");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    @{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrSalaryGrades"); }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_SalaryGrades")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Hr_DetailsCrumb")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">@L.T("Code"):</dt>
                                <dd class="col-sm-9">@Model.GradeCode</dd>

                                <dt class="col-sm-3">@L.T("Name"):</dt>
                                <dd class="col-sm-9">@Model.Name</dd>

                                <dt class="col-sm-3">@L.T("Hr_MinSalary"):</dt>
                                <dd class="col-sm-9">@Model.MinSalary.ToString("N2")</dd>

                                <dt class="col-sm-3">@L.T("Hr_MaxSalary"):</dt>
                                <dd class="col-sm-9">@Model.MaxSalary.ToString("N2")</dd>

                                <dt class="col-sm-3">@L.T("Currency"):</dt>
                                <dd class="col-sm-9">@Model.CurrencyCode</dd>

                                <dt class="col-sm-3">@L.T("Hr_EffectiveFrom"):</dt>
                                <dd class="col-sm-9">@Model.EffectiveFrom.ToString("dd.MM.yyyy")</dd>

                                <dt class="col-sm-3">@L.T("Hr_EffectiveTo"):</dt>
                                <dd class="col-sm-9">@(Model.EffectiveTo?.ToString("dd.MM.yyyy") ?? "-")</dd>
                            </dl>

                            <div class="form-actions mt-3">
                                @if (changePermit)
                                {
                                    <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                                        <i class="bx bx-edit"></i> @L.T("Edit")
                                    </a>
                                }
                                <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("BackToList")</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

