@model tahsinERP.Models.CUSTOMER_BASE
@{
    ViewBag.Title = L.T("Details");
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool changePermit = ViewBag.ChangePermit as bool? ?? false;
}

<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/CustomerBase">@L.T("Menu_Directory")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Crm_CustDataOf", Model.CompanyName)
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Crm_CustData")</h4>
                                <div class="heading-elements">
                                    @if (changePermit)
                                    {
                                        <a href="@Url.Action("Edit", "CustomerBase", new { id = Model.ID })" class="btn btn-sm btn-warning">
                                            <i class="bx bx-edit-alt"></i> @L.T("Edit")
                                        </a>
                                    }
                                    <a href="@Url.Action("Index", "CustomerBase")" class="btn btn-sm btn-secondary">
                                        <i class="bx bx-arrow-back"></i> @L.T("Back")
                                    </a>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h5 class="text-primary">@L.T("Crm_MainInfo")</h5>
                                            <table class="table table-borderless">
                                                <tr>
                                                    <th width="40%">@L.T("Crm_CustCompanyShop"):</th>
                                                    <td><strong>@(Model.CompanyName ?? "-")</strong></td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Crm_CustProductType"):</th>
                                                    <td>@(Model.ProductType ?? "-")</td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col-md-6">
                                            <h5 class="text-primary">@L.T("Crm_CustGeoInfo")</h5>
                                            <table class="table table-borderless">
                                                <tr>
                                                    <th width="40%">@L.T("Crm_CustCountry"):</th>
                                                    <td>@(Model.Country ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Crm_CustProvince"):</th>
                                                    <td>@(Model.Province ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Crm_CustRegion"):</th>
                                                    <td>@(Model.Region ?? "-")</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <hr />

                                    <div class="row">
                                        <div class="col-md-6">
                                            <h5 class="text-primary">@L.T("Crm_CustContactInfo")</h5>
                                            <table class="table table-borderless">
                                                <tr>
                                                    <th width="40%">@L.T("Crm_CustContactPerson"):</th>
                                                    <td>@(Model.ContactPerson ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Crm_CustPosition"):</th>
                                                    <td>@(Model.Position ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Phone"):</th>
                                                    <td>@(Model.Phone ?? "-")</td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col-md-6">
                                            <h5 class="text-primary">@L.T("Crm_CustExtraInfo")</h5>
                                            <table class="table table-borderless">
                                                <tr>
                                                    <th width="40%">@L.T("Comment"):</th>
                                                    <td>@(Model.Comment ?? "-")</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
