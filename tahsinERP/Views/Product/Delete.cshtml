@model tahsinERP.Models.PRODUCT
@{
    ViewBag.Title = L.T("Delete");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Delete", "Product", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/Product">@L.T("Menu_Products")</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            @L.T("Prd_DeleteTitle", Model.PNo)
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="invoice-edit-wrapper">
                        <div class="row">
                            <div class="col-xl-12 col-md-12 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="alert alert-warning">
                                                <i class="bx bx-error-circle"></i>
                                                <strong>@L.T("Prd_Attention")</strong> @L.T("Prd_ConfirmDeleteProduct")
                                            </div>

                                            <h4 class="text-primary">@L.T("Prd_ProductInfo")</h4>
                                            <hr>

                                            <div class="row">
                                                <!-- Product Details - Left Column -->
                                                <div class="col-md-8">
                                                    <div class="row mb-2">
                                                        <div class="col-4"><b>@L.T("Prd_PNo"):</b></div>
                                                        <div class="col-8">@Model.PNo</div>
                                                    </div>
                                                    <div class="row mb-2">
                                                        <div class="col-4"><b>@L.T("Name"):</b></div>
                                                        <div class="col-8">@Model.Name</div>
                                                    </div>
                                                    <div class="row mb-2">
                                                        <div class="col-4"><b>@L.T("Type"):</b></div>
                                                        <div class="col-8">
                                                            @if (Model.IsFinishedGood == true)
                                                            {
                                                                <span class="badge badge-success">@L.T("Prd_TypeFinished")</span>
                                                            }
                                                            else if (Model.IsComponent == true)
                                                            {
                                                                <span class="badge badge-warning">@L.T("Prd_SemiFinishedProduct")</span>
                                                            }
                                                            else if (Model.IsRawMaterial == true)
                                                            {
                                                                <span class="badge badge-info">@L.T("Prd_TypeRaw")</span>
                                                            }
                                                            else
                                                            {
                                                                <span>-</span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <hr />
                                                    <div class="row mb-2">
                                                        <div class="col-4"><b>@L.T("Prd_Weight"):</b></div>
                                                        <div class="col-8">@(Model.Weight.HasValue ? Model.Weight.Value.ToString("0.######") + " kg" : "-")</div>
                                                    </div>
                                                    <div class="row mb-2">
                                                        <div class="col-4"><b>@L.T("Prd_Dimensions"):</b></div>
                                                        <div class="col-8">@(Model.Length?.ToString("0.######")) x @(Model.Width?.ToString("0.######")) x @(Model.Height?.ToString("0.######")) mm</div>
                                                    </div>
                                                    <div class="row mb-2">
                                                        <div class="col-4"><b>@L.T("Prd_VolumeCbm"):</b></div>
                                                        <div class="col-8">
                                                            @if (Model.Length.HasValue && Model.Width.HasValue && Model.Height.HasValue)
                                                            {
                                                                var cbm = (Model.Length.Value / 1000m) * (Model.Width.Value / 1000m) * (Model.Height.Value / 1000m);
                                                                @(cbm.ToString("F6") + " m³")
                                                            }
                                                            else
                                                            {
                                                                <text>-</text>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="row mb-2">
                                                        <div class="col-4"><b>@L.T("Prd_UnitOfMeasure"):</b></div>
                                                        <div class="col-8">@(Model.UNIT != null ? Model.UNIT.ShortName : "-")</div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(Model.Description))
                                                    {
                                                        <div class="row mb-2">
                                                            <div class="col-4"><b>@L.T("Prd_Description"):</b></div>
                                                            <div class="col-8">@Model.Description</div>
                                                        </div>
                                                    }
                                                </div>

                                                <!-- Product Image - Right Column -->
                                                <div class="col-md-4">
                                                    <div class="card border">
                                                        <div class="card-header">
                                                            <h5 class="card-title mb-0"><i class="bx bx-image"></i> @L.T("Prd_ProductImage")</h5>
                                                        </div>
                                                        <div class="card-body text-center">
                                                            @if (ViewBag.ProductImageUrl != null)
                                                            {
                                                                <img src="@ViewBag.ProductImageUrl" loading="lazy" alt="@Model.PNo" class="img-fluid" style="max-width: 100%; max-height: 200px; border-radius: 8px;" />
                                                            }
                                                            else
                                                            {
                                                                <div class="text-muted py-4">
                                                                    <i class="bx bx-image" style="font-size: 48px;"></i>
                                                                    <p class="mb-0">@L.T("Prd_NoImage")</p>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <hr>
                                            <div class="mb-2">
                                                <button class="btn btn-danger" type="submit">
                                                    <i class='bx bx-trash'></i> @L.T("Delete")
                                                </button>
                                                @Html.ActionLink(L.T("Cancel"), "Index", null, new { @class = "btn btn-outline-secondary" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
