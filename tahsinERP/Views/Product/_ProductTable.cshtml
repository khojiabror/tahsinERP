@model IEnumerable<tahsinERP.Models.PRODUCT>

@{
    bool changePermit = ViewBag.ChangePermit ?? false;

    // Helper function to get product type display name
    Func<tahsinERP.Models.PRODUCT, string> GetProductTypeDisplay = (product) =>
    {
        if (product.IsFinishedGood == true) return "Maxsulot";
        if (product.IsComponent == true) return "Yarim tayyor";
        if (product.IsRawMaterial == true) return "Xomashyo";
        return "-";
    };

    // Helper function to calculate CBM (cubic meters) from mm dimensions
    Func<tahsinERP.Models.PRODUCT, string> CalculateCBM = (product) =>
    {
        if (product.Length.HasValue && product.Width.HasValue && product.Height.HasValue)
        {
            // Convert mm to meters (divide by 1000) then multiply
            double cbm = (product.Length.Value / 1000.0) * (product.Width.Value / 1000.0) * (product.Height.Value / 1000.0);
            return cbm.ToString("F6") + " m³";
        }
        return "-";
    };
}

<table class="table table-striped table-bordered complex-headers">
    <thead>
        <tr>
            <th>Maxsulot raqami</th>
            <th>Nomi</th>
            <th>Turi</th>
            <th>O'lchov birligi</th>
            <th>Og'irligi</th>
            <th>O'lchamlari, mm (U×E×B)</th>
            <th>m³ (CBM)</th>
            @if (changePermit)
            {
                <th>Amallar</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        <a href="@Url.Action("Details", "Product", new { id = item.ID })">@item.PNo</a>
                    </td>
                    <td>@Html.DisplayFor(_ => item.Name)</td>
                    <td>
                        @{
                            var typeDisplay = GetProductTypeDisplay(item);
                            var badgeClass = item.IsFinishedGood == true ? "badge-success" :
                                             item.IsComponent == true ? "badge-warning" :
                                             item.IsRawMaterial == true ? "badge-info" : "badge-secondary";
                        }
                        <span class="badge @badgeClass">@typeDisplay</span>
                    </td>
                    <td>@(item.UNIT != null ? item.UNIT.ShortName : "")</td>
                    <td>@Html.DisplayFor(_ => item.Weight)</td>
                    <td>
                        @item.Length x @item.Width x @item.Height
                    </td>
                    <td>@CalculateCBM(item)</td>
                    @if (changePermit)
                    {
                        <td>
                            <a href="@Url.Action("Details", "Product", new { id = item.ID })" title="Ko'rish"><i class="bx bx-show"></i></a>
                            <a href="@Url.Action("Edit", "Product", new { id = item.ID })" title="Tahrirlash"><i class="bx bx-pencil"></i></a>
                            <a href="@Url.Action("Delete", "Product", new { id = item.ID })" title="O'chirish"><i class="bx bx-trash text-danger"></i></a>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center">Ma'lumot topilmadi</td>
            </tr>
        }
    </tbody>
</table>
