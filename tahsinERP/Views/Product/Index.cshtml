@model List<tahsinERP.Models.PRODUCT>

@{
    ViewBag.Title = L.T("Menu_Products");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = ViewBag.ChangePermit ?? tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        @L.T("Prd_Pages")
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Menu_Products")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <!-- users list start -->
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            @Html.ActionLink(L.T("Prd_NewProduct"), "Create", null, new { @class = "btn btn-outline-success mr-1 mb-1" })
                            <button type="button" class="btn btn-outline-primary mr-1 mb-1" id="exportButton" onclick="window.location.href='/Product/UploadWithExcel'">
                                <i class="bx bx-file"></i><span class="align-middle ml-25">@L.T("Prd_AddViaExcel")</span>
                            </button>
                        </div>
                    }
                    <div class="users-list-filter px-1">
                        <form>
                            <div class="row border rounded py-2 mb-2">
                                <div class="col-12 col-sm-12 col-lg-4">
                                    <label for="typeFilter">@L.T("Type")</label>
                                    @Html.DropDownList(
                                        "typeFilter",
                                        (SelectList)ViewBag.TypeFilterList,
                                        new { @id = "typeFilter", @class = "form-control" }
                                    )
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- datatable start -->
                                    <div id="productTableContainer" class="table-responsive">
                                        <table id="productDataTable" class="table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Prd_PNo")</th>
                                                    <th>@L.T("Type")</th>
                                                    <th>@L.T("Name")</th>
                                                    <th>@L.T("Prd_DimensionsMm")</th>
                                                    <th>@L.T("Prd_CbmHeader")</th>
                                                    <th>@L.T("Prd_UnitOfMeasure")</th>
                                                    <th>@L.T("Prd_Weight")</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>@L.T("Actions")</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    var typeCode = item.IsFinishedGood == true ? "MAXSULOT" :
                                                                   item.IsComponent == true ? "YARIM_TAYYOR" :
                                                                   item.IsRawMaterial == true ? "XOMASHYO" : "";
                                                    var typeDisplay = item.IsFinishedGood == true ? L.T("Prd_TypeFinished") :
                                                                      item.IsComponent == true ? L.T("Prd_TypeSemi") :
                                                                      item.IsRawMaterial == true ? L.T("Prd_TypeRaw") : "-";
                                                    var badgeClass = item.IsFinishedGood == true ? "badge-success" :
                                                                     item.IsComponent == true ? "badge-warning" :
                                                                     item.IsRawMaterial == true ? "badge-info" : "badge-secondary";
                                                    var cbm = (item.Length.HasValue && item.Width.HasValue && item.Height.HasValue)
                                                        ? ((item.Length.Value / 1000m) * (item.Width.Value / 1000m) * (item.Height.Value / 1000m)).ToString("F6") + " m³"
                                                        : "-";
                                                    <tr data-type="@typeCode">
                                                        <td><a href="@Url.Action("Details", "Product", new { id = item.ID })">@item.PNo</a></td>
                                                        <td><span class="badge @badgeClass">@typeDisplay</span></td>
                                                        <td>@item.Name</td>
                                                        <td>@(item.Length?.ToString("0.######")) x @(item.Width?.ToString("0.######")) x @(item.Height?.ToString("0.######"))</td>
                                                        <td>@cbm</td>
                                                        <td>@(item.UNIT != null ? item.UNIT.ShortName : "")</td>
                                                        <td>@(item.Weight?.ToString("0.######"))</td>
                                                        @if (changePermit)
                                                        {
                                                            <td>
                                                                <a href="@Url.Action("Details", "Product", new { id = item.ID })" class="btn btn-sm btn-outline-info" title="@L.T("View")"><i class="bx bx-show"></i></a>
                                                                <a href="@Url.Action("Edit", "Product", new { id = item.ID })" class="btn btn-sm btn-outline-success" title="@L.T("Edit")"><i class="bx bx-pencil"></i></a>
                                                                <a href="@Url.Action("Delete", "Product", new { id = item.ID })" class="btn btn-sm btn-outline-danger" title="@L.T("Delete")"><i class="bx bx-trash"></i></a>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <!-- datatable ends -->
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- users list ends -->
            </div>
        </div>
    </div>

    <script type="text/javascript">
        // Wait for document and all scripts to load
        document.addEventListener('DOMContentLoaded', function() {
            // Get initial filter from URL query parameter
            var urlParams = new URLSearchParams(window.location.search);
            var initialFilter = urlParams.get('typeFilter') || 'ALL';
            
            // Custom filter variable
            var typeFilterValue = initialFilter;

            // Set dropdown to match URL parameter
            var filterDropdown = document.getElementById('typeFilter');
            if (filterDropdown) {
                filterDropdown.value = initialFilter;
            }

            // Custom DataTables filter function
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                // Only apply to our specific table
                if (settings.nTable.id !== 'productDataTable') {
                    return true;
                }
                if (typeFilterValue === 'ALL') {
                    return true;
                }
                var row = settings.aoData[dataIndex].nTr;
                var rowType = row ? row.getAttribute('data-type') : '';
                return rowType === typeFilterValue;
            });

            // Initialize DataTable
            var table = $('#productDataTable').DataTable({
                "pageLength": 25,
                "order": [[0, "asc"]],
                dom: 'lBfrtip',
                buttons: erpDataTable.buttons({ small: true })
            });

            // Filter by type dropdown
            filterDropdown.addEventListener('change', function() {
                typeFilterValue = this.value;
                table.draw();
                
                // Update URL without reloading page
                var newUrl = window.location.pathname;
                if (this.value !== 'ALL') {
                    newUrl += '?typeFilter=' + this.value;
                }
                window.history.pushState({}, '', newUrl);
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}