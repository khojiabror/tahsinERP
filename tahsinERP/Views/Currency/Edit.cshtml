@model tahsinERP.Models.CURRENCy
@{
    ViewBag.Title = "Tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString()))
{
    using (Html.BeginForm("Edit", "Currency", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/Currency/Index">Valyuta birliklari</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            Birlikni tahrirlash
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <div class="row">
                        <!-- invoice view page -->
                        <div class="col-xl-9 col-md-8 col-12">
                            <div class="card">
                                <div class="card-content">

                                    <div class="card-body pb-0 mx-25">
                                        <div class="row">
                                            <h4 class="text-primary">Valyuta ma'lumotlarini tahrirlash</h4>

                                            <div class="col-lg-12 col-md-6 mt-25">
                                                @Html.AntiForgeryToken()
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                <hr>
                                                <h6 class="invoice-to">Nomi</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.Longname, new { @class = "form-control round" })
                                                    @Html.ValidationMessageFor(model => model.Longname, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">Qisqa nomi</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.Shortname, new { @class = "form-control round" })
                                                    @Html.ValidationMessageFor(model => model.Shortname, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">Batafsil</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control round" })
                                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                </fieldset>
                                            </div>
                                        </div>

                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item border-0 pb-0">
                                                <button class="btn btn-primary btn-block subtotal-preview-btn" name="edit" type="submit" value="Edit">
                                                    <i class='bx bx-save'></i>
                                                    Saqlash
                                                </button>
                                            </li>
                                        </ul>

                                        <hr>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
