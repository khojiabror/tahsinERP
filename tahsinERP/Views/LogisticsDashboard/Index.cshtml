@using tahsinERP.ViewModels
@{
    ViewBag.Title = L.T("Log_DashboardTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Log_DashboardTitle")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <!-- Filters -->
            @Html.Partial("~/Views/Logistic/Shared/_CurrencyNote.cshtml")
            <div class="card mb-2">
                <div class="card-body">
                    <form method="get" action="@Url.Action("Index", "LogisticsDashboard")">
                        <div class="row">
                            <div class="col-md-3">
                                <label>@L.T("Log_StartDate")</label>
                                <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                            </div>
                            <div class="col-md-3">
                                <label>@L.T("Log_EndDate")</label>
                                <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                            </div>
                            <div class="col-md-3">
                                <label>@L.T("Log_Forwarder")</label>
                                @Html.DropDownList("forwarderId", ViewBag.Forwarders as SelectList, L.T("All"), new { @class = "form-control" })
                            </div>
                            <div class="col-md-2">
                                <label>@L.T("Log_Direction")</label>
                                @Html.DropDownList("direction", ViewBag.Directions as SelectList, L.T("All"), new { @class = "form-control" })
                            </div>
                            <div class="col-md-1 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">@L.T("Search")</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- KPI Cards -->
            <div class="row">
                <div class="col-xl-3 col-md-6 col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-0">@L.T("Log_TotalCost")</h6>
                                    <h3 class="mb-0">@ViewBag.TotalCost.ToString("N2")</h3>
                                </div>
                                <div class="avatar bg-light-primary">
                                    <i class="bx bx-dollar font-medium-5"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-0">@L.T("Log_TotalTrips")</h6>
                                    <h3 class="mb-0">@ViewBag.TotalTrips</h3>
                                </div>
                                <div class="avatar bg-light-success">
                                    <i class="bx bx-truck font-medium-5"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-0">@L.T("Log_Per1Ton")</h6>
                                    <h3 class="mb-0">@ViewBag.CostPerTon.ToString("N2")</h3>
                                </div>
                                <div class="avatar bg-light-warning">
                                    <i class="bx bx-package font-medium-5"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-0">@L.T("Log_Debt")</h6>
                                    <h3 class="mb-0">@ViewBag.UnpaidAmount.ToString("N2")</h3>
                                </div>
                                <div class="avatar bg-light-danger">
                                    <i class="bx bx-money font-medium-5"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Direction Breakdown -->
            <div class="row mt-2">
                <div class="col-xl-4 col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h5>@L.T("Log_CostByDirection")</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-4">
                                    <h4 class="text-info">@ViewBag.InboundCost.ToString("N2")</h4>
                                    <p class="mb-0">@L.T("Log_Dir_Inbound")</p>
                                </div>
                                <div class="col-4">
                                    <h4 class="text-success">@ViewBag.OutboundCost.ToString("N2")</h4>
                                    <p class="mb-0">@L.T("Log_Dir_Outbound")</p>
                                </div>
                                <div class="col-4">
                                    <h4 class="text-secondary">@ViewBag.InternalCost.ToString("N2")</h4>
                                    <p class="mb-0">@L.T("Log_Dir_Internal")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h5>@L.T("Log_AverageMetrics")</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <tr>
                                    <td>@L.T("Log_Per1Km"):</td>
                                    <td><strong>@ViewBag.CostPerKm.ToString("N2")</strong></td>
                                </tr>
                                <tr>
                                    <td>@L.T("Log_Per1Trip"):</td>
                                    <td><strong>@ViewBag.CostPerTrip.ToString("N2")</strong></td>
                                </tr>
                                <tr>
                                    <td>@L.T("Log_Per1Cbm"):</td>
                                    <td><strong>@ViewBag.CostPerCBM.ToString("N2")</strong></td>
                                </tr>
                                <tr>
                                    <td>@L.T("Log_PercentOfSales"):</td>
                                    <td><strong>@ViewBag.LogisticsCostPercent.ToString("N2")%</strong></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h5>@L.T("Log_CargoStats")</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <tr>
                                    <td>@L.T("Log_TotalTonnage"):</td>
                                    <td><strong>@ViewBag.TotalTonnage.ToString("N2")</strong></td>
                                </tr>
                                <tr>
                                    <td>@L.T("Log_TotalCbm"):</td>
                                    <td><strong>@ViewBag.TotalCBM.ToString("N2")</strong></td>
                                </tr>
                                <tr>
                                    <td>@L.T("Log_TotalDistance"):</td>
                                    <td><strong>@ViewBag.TotalDistance.ToString("N2") @L.T("Log_UnitKm")</strong></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Forwarder Performance -->
            @{
                var forwarderStats = ViewBag.ForwarderStats as List<ForwarderComparisonViewModel>;
            }
            @if (forwarderStats != null && forwarderStats.Any())
            {
                <div class="row mt-2">
                    <div class="col-xl-12">
                        <div class="card">
                            <div class="card-header">
                                <h5>@L.T("Log_ForwarderRating")</h5>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Log_Forwarder")</th>
                                                <th>@L.T("Log_TripCount")</th>
                                                <th>@L.T("Log_TotalTonnage")</th>
                                                <th>@L.T("Log_TotalCost")</th>
                                                <th>@L.T("Log_Paid")</th>
                                                <th>@L.T("Log_Outstanding")</th>
                                                <th>@L.T("Log_Per1Ton")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var forwarder in forwarderStats)
                                            {
                                                <tr>
                                                    <td>@forwarder.ForwarderName</td>
                                                    <td>@forwarder.TripCount</td>
                                                    <td>@forwarder.TotalTonnage.ToString("N2")</td>
                                                    <td>@forwarder.TotalCost.ToString("N2")</td>
                                                    <td>@forwarder.TotalPaid.ToString("N2")</td>
                                                    <td>@((forwarder.TotalCost - forwarder.TotalPaid).ToString("N2"))</td>
                                                    <td>@((forwarder.TotalTonnage > 0 ? forwarder.TotalCost / forwarder.TotalTonnage : 0).ToString("N2"))</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Lane Performance -->
            @{
                var laneStats = ViewBag.LaneStats as List<LanePerformanceViewModel>;
            }
            @if (laneStats != null && laneStats.Any())
            {
                <div class="row mt-2">
                    <div class="col-xl-12">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5>@L.T("Log_TopLanes")</h5>
                                <a href="@Url.Action("LanePerformance", "LogisticsDashboard")" class="btn btn-sm btn-outline-primary">
                                    Batafsil
                                </a>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Log_From")</th>
                                                <th>@L.T("Log_To")</th>
                                                <th>@L.T("Log_Trips")</th>
                                                <th>@L.T("Log_Tonnage")</th>
                                                <th>@L.T("Log_TotalCost")</th>
                                                <th>@L.T("Log_Per1Ton")</th>
                                                <th>@L.T("Log_Per1Km")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var lane in laneStats)
                                            {
                                                <tr>
                                                    <td>@lane.FromLocation</td>
                                                    <td>@lane.ToLocation</td>
                                                    <td>@lane.TripCount</td>
                                                    <td>@lane.TotalTonnage.ToString("N2")</td>
                                                    <td>@lane.TotalCost.ToString("N2")</td>
                                                    <td>@lane.AvgCostPerTon.ToString("N2")</td>
                                                    <td>@lane.AvgCostPerKm.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Quick Links -->
            <div class="row mt-2">
                <div class="col-xl-12">
                    <div class="card">
                        <div class="card-header">
                            <h5>@L.T("Reports")</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <a href="@Url.Action("LanePerformance", "LogisticsDashboard")" class="btn btn-outline-primary btn-block">
                                        <i class="bx bx-map"></i> @L.T("Log_LanePerformance")
                                    </a>
                                </div>
                                <div class="col-md-4">
                                    <a href="@Url.Action("Reconciliation", "LogisticsDashboard")" class="btn btn-outline-warning btn-block">
                                        <i class="bx bx-check-circle"></i> @L.T("Log_ReconReport")
                                    </a>
                                </div>
                                <div class="col-md-4">
                                    <a href="@Url.Action("ForwarderComparison", "LogisticsDashboard")" class="btn btn-outline-info btn-block">
                                        <i class="bx bx-bar-chart"></i> @L.T("Log_ForwarderComparison")
                                    </a>
                                </div>
                                <div class="col-md-4 mt-1">
                                    <a href="@Url.Action("MonthlyReport", "LogisticsDashboard")" class="btn btn-outline-secondary btn-block">
                                        <i class="bx bx-calendar"></i> @L.T("Log_MonthlyReport")
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
