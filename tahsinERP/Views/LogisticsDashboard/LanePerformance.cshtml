@using tahsinERP.ViewModels
@{
    ViewBag.Title = "Lane Performance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/LogisticsDashboard">Logistika Dashboard</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Lane Performance
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card mb-2">
                    <div class="card-body">
                        <form method="get" action="@Url.Action("LanePerformance", "LogisticsDashboard")" class="row">
                            <div class="col-md-4">
                                <label>Boshlanish sanasi</label>
                                <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                            </div>
                            <div class="col-md-4">
                                <label>Tugash sanasi</label>
                                <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">Qidirish</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Qayerdan</th>
                                            <th>Qayerga</th>
                                            <th>Reyslar</th>
                                            <th>Tonnaj</th>
                                            <th>CBM</th>
                                            <th>Masofa</th>
                                            <th>Jami xarajat</th>
                                            <th>1 ton uchun</th>
                                            <th>1 km uchun</th>
                                            <th>Asosiy forwarder</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var lanePerformance = ViewBag.LanePerformance as List<LanePerformanceViewModel>;
                                        }
                                        @if (lanePerformance != null && lanePerformance.Any())
                                        {
                                            foreach (var lane in lanePerformance)
                                            {
                                                <tr>
                                                    <td>@lane.FromLocation</td>
                                                    <td>@lane.ToLocation</td>
                                                    <td>@lane.TripCount</td>
                                                    <td>@lane.TotalTonnage.ToString("N2")</td>
                                                    <td>@lane.TotalCBM.ToString("N2")</td>
                                                    <td>@lane.TotalDistance.ToString("N2")</td>
                                                    <td>@lane.TotalCost.ToString("N2")</td>
                                                    <td>@lane.AvgCostPerTon.ToString("N2")</td>
                                                    <td>@lane.AvgCostPerKm.ToString("N2")</td>
                                                    <td>@lane.MainForwarder</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="10" class="text-center">Ma'lumot topilmadi</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
