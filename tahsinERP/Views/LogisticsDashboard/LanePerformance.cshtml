@using tahsinERP.ViewModels
@{
    ViewBag.Title = L.T("Log_LanePerformance");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/LogisticsDashboard">@L.T("Log_DashboardTitle")</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Log_LanePerformance")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-body">
            @Html.Partial("~/Views/Logistic/Shared/_CurrencyNote.cshtml")
            <div class="card mb-2">
                <div class="card-body">
                    <form method="get" action="@Url.Action("LanePerformance", "LogisticsDashboard")" class="row">
                        <div class="col-md-4">
                            <label>@L.T("Log_StartDate")</label>
                            <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                        </div>
                        <div class="col-md-4">
                            <label>@L.T("Log_EndDate")</label>
                            <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">@L.T("Search")</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-content">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>@L.T("Log_From")</th>
                                        <th>@L.T("Log_To")</th>
                                        <th>@L.T("Log_Trips")</th>
                                        <th>@L.T("Log_Tonnage")</th>
                                        <th>CBM</th>
                                        <th>@L.T("Log_Distance")</th>
                                        <th>@L.T("Log_TotalCost")</th>
                                        <th>@L.T("Log_Per1Ton")</th>
                                        <th>@L.T("Log_Per1Km")</th>
                                        <th>@L.T("Log_MainForwarder")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var lanePerformance = ViewBag.LanePerformance as List<LanePerformanceViewModel>;
                                    }
                                    @if (lanePerformance != null && lanePerformance.Any())
                                    {
                                        foreach (var lane in lanePerformance)
                                        {
                                            <tr>
                                                <td>@lane.FromLocation</td>
                                                <td>@lane.ToLocation</td>
                                                <td>@lane.TripCount</td>
                                                <td>@lane.TotalTonnage.ToString("N2")</td>
                                                <td>@lane.TotalCBM.ToString("N2")</td>
                                                <td>@lane.TotalDistance.ToString("N2")</td>
                                                <td>@lane.TotalCost.ToString("N2")</td>
                                                <td>@lane.AvgCostPerTon.ToString("N2")</td>
                                                <td>@lane.AvgCostPerKm.ToString("N2")</td>
                                                <td>@lane.MainForwarder</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="10" class="text-center">@L.T("Log_NoDataFound")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
