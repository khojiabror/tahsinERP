@model tahsinERP.ViewModels.LogisticsMonthlyReportViewModel
@{
    ViewBag.Title = L.T("Log_MonthlyReportTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    @@media print {
        .no-print { display: none !important; }
        .print-only { display: block !important; }
        body { background: #fff !important; }
        body * { visibility: hidden; }
        #reportCard, #reportCard * { visibility: visible !important; }
        #reportCard { display: block !important; position: relative !important; left: 0 !important; top: 0 !important; width: 100% !important; color: #000 !important; }
    }
    @@media screen {
        .print-only { display: none; }
    }
    .report-title { font-size: 1.25rem; font-weight: 600; }
    .report-meta { font-size: 0.9rem; color: #555; }
    #monthlyReportTable th, #monthlyReportTable td { vertical-align: middle; }
    #monthlyReportTable .total-row { font-weight: 700; background-color: #f8f9fa; }
</style>

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row no-print">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="breadcrumb-wrapper col-12">
                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                        <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                        <li class="breadcrumb-item"><a href="~/LogisticsDashboard/Index">@L.T("Log_DashboardShort")</a></li>
                        <li class="breadcrumb-item active">@L.T("Log_MonthlyReport")</li>
                    </ol>
                </div>
            </div>
        </div>

        <div class="content-body">
                @Html.Partial("~/Views/Logistic/Shared/_CurrencyNote.cshtml")
            <div class="card no-print">
                <div class="card-header">
                    <h4 class="card-title mb-0">@L.T("Log_MonthlyReportTitle")</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("MonthlyReport", "LogisticsDashboard", FormMethod.Get, new { @class = "form" }))
                    {
                        <div class="row">
                            <div class="col-md-2">
                                <label>@L.T("Log_Month")</label>
                                @Html.DropDownList("month", Enumerable.Range(1, 12).Select(i => new SelectListItem { Text = L.T("Month_" + i), Value = i.ToString(), Selected = i == Model.Month }), new { @class = "form-control" })
                            </div>
                            <div class="col-md-2">
                                <label>@L.T("Log_Year")</label>
                                <input type="number" name="year" class="form-control" value="@Model.Year" min="2020" max="2030" />
                            </div>
                            <div class="col-md-4">
                                <label>@L.T("Log_Forwarder")</label>
                                @Html.DropDownList("forwarderId", Model.Forwarders, L.T("All"), new { @class = "form-control" })
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary">@L.T("Log_ShowReport")</button>
                            </div>
                            <div class="col-md-2 d-flex align-items-end justify-content-end">
                                <button type="button" class="btn btn-outline-secondary" onclick="window.print();"><i class="bx bx-printer"></i> @L.T("Print")</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card" id="reportCard">
                <div class="card-body">
                    <div class="text-center mb-4">
                        @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
                        {
                            <p class="report-meta mb-0">@Model.CompanyName</p>
                        }
                        <h5 class="report-title mt-2">@L.T("Log_MonthlyReportTitleUpper")</h5>
                        <p class="report-meta mb-0">@L.T("Log_Month"): <strong>@Model.PeriodTitleUz</strong> (@Model.PeriodTitle)</p>
                        <p class="report-meta mb-0">@L.T("Log_DocDate"): <strong>@Model.ReportDate</strong></p>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-sm" id="monthlyReportTable" style="width:100%">
                            <thead>
                                <tr class="table-primary">
                                    <th style="width:40px">№</th>
                                    <th>@L.T("Log_Forwarder")</th>
                                    <th class="text-right">@L.T("Log_TripCount")</th>
                                    <th class="text-right">@L.T("Log_OpeningDebt")</th>
                                    <th class="text-right">@L.T("Log_MonthCost")</th>
                                    <th class="text-right">@L.T("Log_MonthPayment")</th>
                                    <th class="text-right">@L.T("Log_ClosingDebt")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Rows != null && Model.Rows.Count > 0)
                                {
                                    var num = 1;
                                    foreach (var row in Model.Rows)
                                    {
                                        <tr>
                                            <td>@(num++)</td>
                                            <td>@row.ForwarderName</td>
                                            <td class="text-right">@row.TripsInMonth</td>
                                            <td class="text-right">@row.OpeningDebt.ToString("N2")</td>
                                            <td class="text-right">@row.FreightInMonth.ToString("N2")</td>
                                            <td class="text-right">@row.PaymentInMonth.ToString("N2")</td>
                                            <td class="text-right">@row.ClosingDebt.ToString("N2")</td>
                                        </tr>
                                    }
                                    <tr class="total-row">
                                        <td colspan="2" class="text-right"><strong>@L.T("Log_TotalUpper")</strong></td>
                                        <td class="text-right">@Model.Totals.TotalTrips</td>
                                        <td class="text-right">@Model.Totals.TotalOpeningDebt.ToString("N2")</td>
                                        <td class="text-right">@Model.Totals.TotalFreight.ToString("N2")</td>
                                        <td class="text-right">@Model.Totals.TotalPayment.ToString("N2")</td>
                                        <td class="text-right">@Model.Totals.TotalClosingDebt.ToString("N2")</td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center">@L.T("Log_NoMonthData")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
