@using tahsinERP.Services
@{
    ViewBag.Title = "Yo'l varaqasi Excel yuklash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/Waybill/Index">@LogisticsTerms.Waybills</a>
                                </li>
                                <li class="breadcrumb-item active">Excel orqali yuklash</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-body">
            <div class="row">
                <div class="col-xl-8 col-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <h4 class="card-title">Excel fayl yuklash</h4>
                                <p class="text-muted">
                                    Birinchi satrda ustun nomlari bo'lishi kerak. Majburiy ustunlar: <b>@LogisticsTerms.Waybill raqami (WaybillNo)</b>, <b>Sana (IssueDate)</b>, <b>Shartnoma (ContractID/ContractNo)</b>, <b>Transport turi (TransportTypeID/TransportType)</b>.
                                </p>

                                @if (ViewBag.Error != null)
                                {
                                    <div class="alert alert-danger">@ViewBag.Error</div>
                                }
                                @if (ViewBag.SuccessCount != null)
                                {
                                    <div class="alert alert-success">
                                        Yuklandi: @ViewBag.SuccessCount, O'tkazib yuborildi: @ViewBag.SkipCount
                                    </div>
                                }
                                @{
                                    var errorList = ViewBag.Errors as IEnumerable<string>;
                                }
                                @if (errorList != null && errorList.Any())
                                {
                                    <div class="alert alert-warning">
                                        <ul class="mb-0">
                                            @foreach (var err in errorList)
                                            {
                                                <li>@err</li>
                                            }
                                        </ul>
                                    </div>
                                }

                                <a class="btn btn-outline-primary mb-1" href="@Url.Action("DownloadTemplate", "WaybillImport")">
                                    <i class="bx bx-download"></i> Namuna faylni yuklab olish
                                </a>

                                @using (Html.BeginForm("UploadExcel", "WaybillImport", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <div class="form-group">
                                        <label>Excel fayl (.xlsx)</label>
                                        <input type="file" name="file" class="form-control" accept=".xlsx" required />
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-upload"></i> Yuklash
                                    </button>
                                    <a href="@Url.Action("Index", "Waybill")" class="btn btn-outline-secondary ml-1">Orqaga</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <h5>Excel ustunlari</h5>
                                <p class="text-muted">Quyidagi ustun nomlarini birinchi qatorga yozing.</p>
                                <ul class="mb-0">
                                    <li>@LogisticsTerms.Waybill raqami (WaybillNo) *</li>
                                    <li>Sana (IssueDate) *</li>
                                    <li>Yo'nalish (Direction: 0/1/2 yoki Kiruvchi/Chiquvchi/Ichki)</li>
                                    <li>@LogisticsTerms.Forwarder (ForwarderID yoki ForwarderName)</li>
                                    <li>Shartnoma (ContractID yoki ContractNo)</li>
                                    <li>Transport turi (TransportTypeID yoki TransportType)</li>
                                    <li>Qayerdan, Qayerga, Masofa (FromLocation, ToLocation, DistanceKm)</li>
                                    <li>Brut/Net vazn, CBM, Palletlar soni (GrWeight, NetWeight, CBM, PalletsCount)</li>
                                    <li>Tarif asosi (FreightBasis: 0/1/2/3 yoki Mashina uchun / Ton uchun / KM uchun / Belgilangan narx)</li>
                                    <li>Tarif stavkasi, summa va valyuta (Rate, Amount, CurrencyID yoki Currency) — bo'sh bo'lsa shartnoma tarifidan olinadi, summa tarif bo'yicha (eng kam to'lov bilan) hisoblanadi</li>
                                    <li>To'lovchi turi va ID (PayerType, PayerID)</li>
                                    <li>Bog'langan hujjatlar (InvoiceID, SalesInvoiceID, SalesOrderID, PurchaseOrderID, TTNKID)</li>
                                    <li>Mashina/treyler (TruckNo, TrailerNo, TruckModel, TrailerModel)</li>
                                    <li>Haydovchi (DriverName, DriverPINFL)</li>
                                    <li>Yetkazish sanalari (PlannedDeliveryDate, ActualDeliveryDate)</li>
                                    <li>Description, ManualCorrectionReason — stavka/asos/valyuta tarifdan farq qilsa yoki faol tarif bo'lmasa majburiy</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
