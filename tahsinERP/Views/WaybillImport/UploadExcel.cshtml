@using tahsinERP.Services
@{
    ViewBag.Title = L.T("Log_Imp_Title");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/Waybill/Index">@LogisticsTerms.Waybills</a>
                                </li>
                                <li class="breadcrumb-item active">@L.T("Log_UploadViaExcel")</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-body">
            <div class="row">
                <div class="col-xl-8 col-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <h4 class="card-title">@L.T("Log_Imp_UploadFile")</h4>
                                <p class="text-muted">
                                    @L.T("Log_Imp_HeaderHint") <b>@L.T("Log_WaybillNo") (WaybillNo)</b>, <b>@L.T("Date") (IssueDate)</b>, <b>@L.T("Log_Contract") (ContractID/ContractNo)</b>, <b>@L.T("Log_TransportType") (TransportTypeID/TransportType)</b>.
                                </p>

                                @if (ViewBag.Error != null)
                                {
                                    <div class="alert alert-danger">@ViewBag.Error</div>
                                }
                                @if (ViewBag.SuccessCount != null)
                                {
                                    <div class="alert alert-success">
                                        @L.T("Log_Imp_ResultSummary", (object)ViewBag.SuccessCount, (object)ViewBag.SkipCount)
                                    </div>
                                }
                                @{
                                    var errorList = ViewBag.Errors as IEnumerable<string>;
                                }
                                @if (errorList != null && errorList.Any())
                                {
                                    <div class="alert alert-warning">
                                        <ul class="mb-0">
                                            @foreach (var err in errorList)
                                            {
                                                <li>@err</li>
                                            }
                                        </ul>
                                    </div>
                                }

                                <a class="btn btn-outline-primary mb-1" href="@Url.Action("DownloadTemplate", "WaybillImport")">
                                    <i class="bx bx-download"></i> @L.T("Log_Imp_DownloadTemplate")
                                </a>

                                @using (Html.BeginForm("UploadExcel", "WaybillImport", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <div class="form-group">
                                        <label>@L.T("Log_Imp_ExcelFile")</label>
                                        <input type="file" name="file" class="form-control" accept=".xlsx" required />
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-upload"></i> @L.T("Upload")
                                    </button>
                                    <a href="@Url.Action("Index", "Waybill")" class="btn btn-outline-secondary ml-1">@L.T("Back")</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <h5>@L.T("Log_Imp_Columns")</h5>
                                <p class="text-muted">@L.T("Log_Imp_ColumnsHint")</p>
                                <ul class="mb-0">
                                    <li>@L.T("Log_WaybillNo") (WaybillNo) *</li>
                                    <li>@L.T("Date") (IssueDate) *</li>
                                    <li>@L.T("Log_Imp_ColDirection")</li>
                                    <li>@L.T("Log_Imp_ColForwarder")</li>
                                    <li>@L.T("Log_Imp_ColContract")</li>
                                    <li>@L.T("Log_Imp_ColTransport")</li>
                                    <li>@L.T("Log_Imp_ColRoute")</li>
                                    <li>@L.T("Log_Imp_ColCargo")</li>
                                    <li>@L.T("Log_Imp_ColBasis")</li>
                                    <li>@L.T("Log_Imp_ColRate")</li>
                                    <li>@L.T("Log_Imp_ColPayer")</li>
                                    <li>@L.T("Log_Imp_ColDocs")</li>
                                    <li>@L.T("Log_Imp_ColTruck")</li>
                                    <li>@L.T("Log_Imp_ColDriver")</li>
                                    <li>@L.T("Log_Imp_ColDelivery")</li>
                                    <li>@L.T("Log_Imp_ColReason")</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
