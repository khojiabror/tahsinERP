@model tahsinERP.ViewModels.Purchasing.PurchasingWhIncomeViewModel
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/PurchasingWhIncome/Index">Kirimlar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Kirim qilish
                                    </li>
                                    <li class="col-md-6 col-12 form-group ms-auto">
                                        <br /> ombor: <b>@Model.WHName</b>
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Create", "PurchasingWhIncome", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form repeater-default" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            // WRHS_InComes
                                            <div class="row justify-content-around d-flex align-items-start">
                                                @*Left Part*@
                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Shartnoma raqami</h6>
                                                            @Html.TextBoxFor(model => model.DocNo, new { @type = "text", @class = "form-control", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.DocNo, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Shartnomani tanlang</h6>
                                                            @Html.DropDownList("contract-dropdown", (SelectList)ViewBag.contracts, "Shartnomani tanlang", new { @class = "form-control select2", @id = "contract-dropdown", onchange = "getContractDetails()" })
                                                            @Html.ValidationMessageFor(model => model.ContractID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Miqdori</h6>
                                                            @Html.TextBoxFor(model => model.Amount, new { @class = "form-control", @required = "required", @id= "TotalAmount" })
                                                            @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Valyuta</h6>
                                                            @Html.TextBoxFor(model => model.Currency, new { @type = "text", @class = "form-control", @required = "required", @id="Currency" })
                                                            @Html.ValidationMessageFor(model => model.Currency, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>

                                                @*Right Part*@
                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Umumiy narx</h6>
                                                            @Html.TextBoxFor(model => model.TotalPrice, new { @type = "text", @class = "form-control", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.TotalPrice, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Batafsil ma'lumot</h6>
                                                            @Html.TextBoxFor(model => model.Description, new { @type = "text", @class = "form-control", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="form-group position-relative has-icon-left">
                                                            <label>Kiritilgan sanasi</label>
                                                            @Html.TextBoxFor(model => model.IssueDateTime, new { @class = "form-control pickadate-months-year round", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.IssueDateTime, "", new { @class = "text-danger" })
                                                            <div class="form-control-position mt-2">
                                                                <i class='bx bx-calendar'></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <br />
                                            </div>

                                            <h4>
                                                Maxsulotlar
                                            </h4>
                                            <div data-repeater-list="Items">
                                                <div data-repeater-item id="repeaterItem">
                                                    <div class="row justify-content-between">
                                                        <input type="hidden" name="ID" />
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_PartID">Maxsulotni tanlang</label>
                                                            @Html.DropDownList("ItemID", (SelectList)ViewBag.items, new { @class = "form-control select", @id = "select2", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.Items[0].ItemID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Unit">Birligi</label>
                                                            @Html.DropDownList("UnitID", (SelectList)ViewBag.units, new { @class = "form-control", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.Items[0].UnitID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Amount">Miqdori</label>
                                                            <input type="number" name="Amount" class="form-control" id="Part_Amount" />
                                                            @Html.ValidationMessageFor(model => model.Items[0].Amount, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_PiecePrice">Dona narx</label>
                                                            <input type="number" name="PiecePrice" step="0.01" class="form-control" id="Part_PiecePrice" />
                                                            @Html.ValidationMessageFor(model => model.Items[0].PiecePrice, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_TotalPrice">Umumiy narx</label>
                                                            <input type="number" name="TotalPrice" step="0.01" class="form-control" id="Part_TotalPrice" disabled="disabled" />
                                                            @Html.ValidationMessageFor(model => model.Items[0].TotalPrice, "", new { @class = "text-danger" })
                                                        </div>
                                                        @*
        <div class="col-md-2 col-sm-12 form-group">
            <label for="Part_MOQ">MOQ</label>
            <input type="number" name="MOQ" class="form-control" id="Part_MOQ" />
            @Html.ValidationMessageFor(model => model.Items[0].Comment, "", new { @class = "text-danger", @required = "required" })
        </div>*@
                                                        <div class="col-md-1 col-sm-12 form-group d-flex align-items-center pt-2">
                                                            <button data-repeater-delete type="button" class="btn btn-danger">O`chirish</button>
                                                        </div>
                                                    </div>
                                                    <hr>
                                                </div>
                                            </div>

                                            <button data-repeater-create type="button" class="btn btn-primary">Yangi maxsulot qo`shish</button>

                                            // Save button
                                            <ul class="list-group list-group-flush">
                                                <li class="list-group-item border-0 pb-0">
                                                    <button class="btn btn-primary btn-block subtotal-preview-btn" name="create" type="submit" value="Create">
                                                        <i class='bx bx-save'></i>
                                                        Saqlash
                                                    </button>
                                                </li>
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Trigger event when OrderID is changed
        $('#contract-dropdown').on('change', function () {
            console.log("Ishlopti")
            var contractId = $(this).val();
            if (contractId) {
                // Make an AJAX request to load items based on selected OrderID
                $.ajax({
                    url: '@Url.Action("GetContractItems", "PurchasingWhIncome")', // Ensure this action is in your controller
                    type: 'GET',
                    data: { contractId: contractId },
                    success: function (response) {
                        // Clear existing repeater items
                        $('[data-repeater-list="Items"]').empty();

                        // Populate the repeater with new items from response
                        response.forEach(function (item, index) {
                            // Append a new repeater item with the fetched data
                            var newItem = `
                                <div data-repeater-item id="repeaterItem">
                                    <div class="row justify-content-between">
                                        <input type="hidden" name="Items[${index}].ID" value="${item.ID}" />
                                        <input type="hidden" name="Items[${index}].ID" value="${item.ItemID}" />
                                        <div class="col-md-2 col-sm-12 form-group">
                                            <label for="Part_PartID">Predmetni tanlang</label>
                                            <input type="text" name="Items[${index}].ItemName" value="${item.ItemName}" class="form-control" />
                                        </div>
                                        <input type="hidden" name="Items[${index}].ID" value="${item.UnitID}" />
                                        <div class="col-md-2 col-sm-12 form-group">
                                            <label for="Part_Unit">Birligi</label>
                                            <input type="text" name="Items[${index}].UnitName" value="${item.ShortName}" class="form-control" />
                                        </div>
                                        <div class="col-md-2 col-sm-12 form-group">
                                            <label for="Part_Amount">Miqdori</label>
                                            <input type="number" name="Items[${index}].Amount" value="${item.Amount}" class="form-control" />
                                        </div>
                                        <div class="col-md-2 col-sm-12 form-group">
                                            <label for="Part_PiecePrice">Dona narxi</label>
                                            <input type="number" name="Items[${index}].PiecePrice" value="${item.Price}" class="form-control" step="0.01" />
                                        </div>
                                        <div class="col-md-2 col-sm-12 form-group">
                                            <label for="Part_TotalPrice">Umumiy narxi</label>
                                            <input type="number" name="Items[${index}].TotalPrice" value="${item.TotalPrice}" class="form-control" step="0.01" disabled="disabled" />
                                        </div>
                                        <div class="col-md-1 col-sm-12 form-group d-flex align-items-center pt-2">
                                            <button data-repeater-delete type="button" class="btn btn-danger">O'chirish</button>
                                        </div>
                                    </div>
                                    <hr>
                                </div>`;
                            $('[data-repeater-list="Items"]').append(newItem);
                        });

                    },
                    error: function () {
                        alert('Error loading order items.');
                    }
                });
            }
        });
    });

    function getContractDetails() {
        var contractID = $("#contract-dropdown").val();

        $.ajax({
            url: '@Url.Action("GetContractDetails", "PurchasingWhIncome")', // Ensure you have this action in your controller
            type: 'GET',
            data: { contractID: contractID },
            success: function (data) {
                if (data.success) {
                    var contract = data.data;
                    console.log(data);  // Ajax javobini tekshirish
                    if (data.success) {
                        var contract = data.data;
                        console.log(contract);  // Shu yerda console.log ishlaydi
                    }
                    // Valyutani yangilash
                    $("#Currency").val(contract.currency || '');

                    // Umumiy narxni yangilash
                    $("#TotalAmount").val(contract.totalAmount || '');
                    document.getElementById("amount").value = contract.amount;
                    document.getElementById("currency").value = contract.currency;
                } else {
                    console.error("Xatolik: " + data.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("Contract tafsilotlarini olishda xatolik:", error);
            }
        });
    }

</script>
