@model List<tahsinERP.Models.PURCHASING_WRHS_INCOMES>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = false;
    if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
    {
        changePermit = true;
    }
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        Sahifalar
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Xarid maxsulotlari Omborga kirim
                                    </li>
                                    <li class="col-md-6 col-12 form-group ms-auto">
                                        <br /> Ombor :  <b>@ViewBag.WHName</b>
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <div class="invoice-create-btn mb-1">
                                <a href="@Url.Action("Create", "PurchasingWhIncome")" class="btn btn-outline-success mr-1 mb-1" role="button" aria-pressed="true">
                                    Kirim
                                </a>
                                <a href="@Url.Action("Index", "ComingSoon")" class="btn btn-outline-primary mr-1 mb-1" role="button" aria-pressed="true">
                                    Excel orqali kirim
                                </a>
                                <a href="@Url.Action("Index", "ComingSoon")" class="btn btn-outline-warning mr-1 mb-1" role="button" aria-pressed="true">
                                    Akt rasmiylashtirish
                                </a>
                                <a href="@Url.Action("Index", "PurchasingWhExpense")" class="btn btn-outline-danger mr-1 mb-1" role="button" aria-pressed="true">
                                    Chiqimga o'tish
                                </a>
                            </div>
                        </div>
                    }
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive table-responsivetable-responsive">
                                        <table class="table invoice-data-table dt-responsive nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th></th>
                                                    <th></th>
                                                    <th>Hujjat raqami</th>
                                                    <th>Shartnoma raqami</th>
                                                    <th>Miqdori</th>
                                                    <th>Umumiy summasi</th>
                                                    <th>Qabul sanasi</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null)
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td></td>
                                                            <td></td>
                                                            <td>
                                                                <a href="~/PurchasingWhIncome/Details/@item.ID">@item.DocNo</a>
                                                            </td>
                                                            <td>
                                                                <a href="~/PurchasingContract/Details/@item.ContractID">@item.PURCHASING_CONTRACTS.ContractNo</a>
                                                            </td>
                                                            <td>@item.Amount</td>
                                                            <td>@item.TotalPrice @item.Currency</td>
                                                            <td>@item.IssueDateTime.ToString("dd.MM.yyyy")</td>
                                                            @if (changePermit)
                                                            {
                                                                <td>
                                                                    <div>
                                                                        <a href="@Url.Action("Edit", "PurchasingWhIncome", new { id = item.ID })"><i class="bx bx-edit-alt"></i></a>
                                                                        <a href="@Url.Action("Delete", "PurchasingWhIncome", new { id = item.ID })"><i class="bx bx-trash"></i></a>
                                                                    </div>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}