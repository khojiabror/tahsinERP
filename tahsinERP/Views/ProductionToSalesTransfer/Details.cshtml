@model tahsinERP.Models.EXPENS

@{
    ViewBag.Title = L.T("Wh_Pts_TransferInfo");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller action'ida tekshiriladi (SRM-M05). *@
@{
    var income = ViewBag.CorrespondingIncome as tahsinERP.Models.INCOME;
    
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/ProductionToSalesTransfer/Index">@L.T("Wh_Pts_Transfers")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Wh_Pts_TransferInfo")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">
                                    <i class="bx bx-transfer"></i> @L.T("Wh_Pts_TransferColon") @Model.DocNo
                                </h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h5 class="mb-2">@L.T("Wh_MainInfo")</h5>
                                            <dl class="row">
                                                <dt class="col-sm-4">@L.T("Wh_DocNoColon")</dt>
                                                <dd class="col-sm-8"><a href="@Url.Action("Details", "Expenses", new { id = Model.ID })">@Model.DocNo</a></dd>

                                                <dt class="col-sm-4">@L.T("Wh_Pts_ProductionWhColon")</dt>
                                                <dd class="col-sm-8">
                                                    <span class="badge badge-info">@(Model.Warehouse != null ? Model.Warehouse.WHName : "-")</span>
                                                </dd>

                                                <dt class="col-sm-4">@L.T("Wh_Pts_SalesWhColon")</dt>
                                                <dd class="col-sm-8">
                                                    <span class="badge badge-success">@(Model.Warehouse1 != null ? Model.Warehouse1.WHName : "-")</span>
                                                </dd>

                                                <dt class="col-sm-4">@L.T("Wh_DateTimeColon")</dt>
                                                <dd class="col-sm-8">@Model.IssueDateTime.ToString("dd.MM.yyyy HH:mm")</dd>

                                                <dt class="col-sm-4">@L.T("Wh_StatusColon")</dt>
                                                <dd class="col-sm-8">
                                                    @if (Model.SendStatus == true)
                                                    {
                                                        <span class="badge badge-success">@L.T("Wh_StSent")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-warning">@L.T("Wh_StPending")</span>
                                                    }
                                                </dd>

                                                @if (!string.IsNullOrEmpty(Model.Description))
                                                {
                                                    <dt class="col-sm-4">@L.T("Wh_CommentColon")</dt>
                                                    <dd class="col-sm-8">@Model.Description</dd>
                                                }
                                            </dl>
                                        </div>
                                        
                                        @if (income != null)
                                        {
                                            <div class="col-md-6">
                                                <h5 class="mb-2">@L.T("Wh_Pts_ReceiptDoc")</h5>
                                                <dl class="row">
                                                    <dt class="col-sm-4">@L.T("Wh_DocNoColon")</dt>
                                                    <dd class="col-sm-8"><a href="@Url.Action("Details", "Incomes", new { id = income.ID })">@income.DocNo</a></dd>

                                                    <dt class="col-sm-4">@L.T("Wh_Pts_ReceiptDateColon")</dt>
                                                    <dd class="col-sm-8">@income.IssueDateTime.ToString("dd.MM.yyyy HH:mm")</dd>

                                                    <dt class="col-sm-4">@L.T("Wh_StatusColon")</dt>
                                                    <dd class="col-sm-8">
                                                        @if (income.RecieveStatus == true)
                                                        {
                                                            <span class="badge badge-success">@L.T("Wh_StReceived")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-warning">@L.T("Wh_StPending")</span>
                                                        }
                                                    </dd>
                                                </dl>
                                            </div>
                                        }
                                    </div>
                                    
                                    <hr />
                                    
                                    <h5 class="mb-2">@L.T("Wh_Products")</h5>
                                    <div class="table-responsive">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Wh_ProductCode")</th>
                                                    <th>@L.T("Wh_ProductName")</th>
                                                    <th>@L.T("Quantity")</th>
                                                    <th>@L.T("Unit")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.EXPENSE_PRODUCTS != null && Model.EXPENSE_PRODUCTS.Any())
                                                {
                                                    foreach (var product in Model.EXPENSE_PRODUCTS)
                                                    {
                                                        var prod = product.PRODUCT;
                                                        var pNo = prod != null ? prod.PNo : product.ProductID.ToString();
                                                        var pName = prod != null ? prod.Name : "-";
                                                        var unitName = product.UNIT != null ? product.UNIT.ShortName : "-";
                                                        <tr>
                                                            <td>@pNo</td>
                                                            <td>@pName</td>
                                                            <td>@product.Amount.ToString("N2")</td>
                                                            <td>@unitName</td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="4" class="text-center text-muted">@L.T("Wh_ProductsNotFound")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    
                                    @{ var transferDocIds = ViewBag.DocIds as List<int> ?? new List<int>(); }
                                    @if (transferDocIds.Any())
                                    {
                                        <hr />
                                        <h5 class="mb-2">@L.T("Wh_LinkedDocs")</h5>
                                        <ul class="list-unstyled">
                                            @foreach (var docId in transferDocIds)
                                            {
                                                <li>
                                                    @* Avval mavjud bo'lmagan ProductionToSalesTransfer/DownloadDocument ga olib borardi (404) *@
                                                    <a href="@Url.Action("DownloadDoc", "Expenses", new { id = docId })" class="btn btn-sm btn-outline-primary">
                                                        <i class="bx bx-download"></i> @L.T("Wh_DownloadDoc")
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    
                                    <hr />
                                    
                                    <div class="d-flex justify-content-between">
                                        <a href="@Url.Action("Index", "ProductionToSalesTransfer")" class="btn btn-secondary">
                                            <i class="bx bx-arrow-back"></i> @L.T("Back")
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
