@model List<tahsinERP.Models.EXPENS>

@{
    ViewBag.Title = L.T("Wh_Pts_IndexTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller action'ida tekshiriladi (SRM-M05). *@
@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "ProductionToSalesTransfer");

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="#">@L.T("Wh_Warehouse")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Wh_Pts_Transfers")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bx bx-check-circle"></i> @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }
                    @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bx bx-error-circle"></i> @(TempData["Error"] ?? TempData["ErrorMessage"])
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }

                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "ProductionToSalesTransfer")" class="btn btn-outline-success mr-1 mb-1">
                                <i class="bx bx-transfer"></i>
                                <span class="align-middle ml-25">@L.T("Wh_Pts_NewTransfer")</span>
                            </a>
                        </div>
                    }

                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">@L.T("Wh_Pts_TransferList")</h4>
                        </div>
                        <div class="card-content">
                            <div class="card-body">
                                @using (Html.BeginForm("Index", "ProductionToSalesTransfer", FormMethod.Get))
                                {
                                    <div class="row mb-2">
                                        <div class="col-md-3">
                                            <label>@L.T("Wh_DateFromParen")</label>
                                            <input type="date" name="fromDate" value="@ViewBag.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Wh_DateToParen")</label>
                                            <input type="date" name="toDate" value="@ViewBag.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Wh_Product")</label>
                                            @Html.DropDownList("productID", ViewBag.Products as SelectList, L.T("Wh_AllProducts"), new { @class = "form-control select2" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>&nbsp;</label>
                                            <button type="submit" class="btn btn-primary btn-block">
                                                <i class="bx bx-search"></i> @L.T("Search")
                                            </button>
                                        </div>
                                    </div>
                                }

                                <div class="table-responsive">
                                    <table id="transfersTable" class="table table-striped table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Wh_DocNo")</th>
                                                <th>@L.T("Wh_Pts_ProductionWh")</th>
                                                <th>@L.T("Wh_Pts_SalesWh")</th>
                                                <th>@L.T("Wh_ProductCode")</th>
                                                <th>@L.T("Wh_TotalQty")</th>
                                                <th>@L.T("Date")</th>
                                                <th>@L.T("Status")</th>
                                                <th>@L.T("Actions")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                var products = item.EXPENSE_PRODUCTS != null ? item.EXPENSE_PRODUCTS.ToList() : new List<tahsinERP.Models.EXPENSE_PRODUCTS>();
                                                var totalQty = products.Sum(p => p.Amount);
                                                var productCount = products.Count;
                                                var pNo = productCount == 1 && products.Any() ? (products[0].PRODUCT != null ? products[0].PRODUCT.PNo : products[0].ProductID.ToString()) : (productCount > 1 ? L.T("Wh_Pts_ProductCount", productCount) : "-");
                                                <tr>
                                                    <td>
                                                        <a href="@Url.Action("Details", "ProductionToSalesTransfer", new { id = item.ID })" class="text-primary">
                                                            <strong>@item.DocNo</strong>
                                                        </a>
                                                    </td>
                                                    <td>@(item.Warehouse?.WHName ?? "-")</td>
                                                    <td>@(item.Warehouse1?.WHName ?? "-")</td>
                                                    <td>@pNo</td>
                                                    <td>@totalQty.ToString("N2")</td>
                                                    <td>@item.IssueDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                                    <td>
                                                        @if (item.SendStatus == true)
                                                        {
                                                            <span class="badge badge-success">@L.T("Wh_StSent")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-warning">@L.T("Wh_StPending")</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <a href="@Url.Action("Details", "ProductionToSalesTransfer", new { id = item.ID })"
                                                           class="btn btn-sm btn-icon btn-primary" title="@L.T("Details")">
                                                            <i class="bx bx-show"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
    @section Scripts {
        <script>
            $(document).ready(function () {
                $('.select2').select2({
                    placeholder: "@L.Js("Select")",
                    allowClear: true
                });

                $('#transfersTable').DataTable({
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "@L.Js("All")"]],
                    "order": [[3, "desc"]],
                    "columnDefs": [
                        { "type": "date", "targets": 3 }
                    ],
                    "scrollX": true,
                    dom: 'lBfrtip',
                    buttons: erpDataTable.buttons({ fileName: '@L.Js("Wh_Exp_FileName")', pdfTitle: '@L.Js("Wh_ExpListTitle")' })
                });
            });
        </script>
    }
}
