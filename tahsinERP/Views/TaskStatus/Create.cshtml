@model tahsinERP.Models.APP_TASK_STATUS_REF
@{
    ViewBag.Title = "Status qo'shish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Create", "TaskStatus", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/TaskStatus">Statuslar</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            Yangi Status qo'shish
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="basic-select2">
                        <div class="row">
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            <div class="row">
                                                <div class="col-lg-12 col-md-6 mt-25">
                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                    <hr>
                                                    <h6 class="invoice-to">Kod *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Code, new { @class = "form-control round", @required = "required", @placeholder = "Masalan: TODO, IN_PROGRESS, DONE" })
                                                        @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">Nomi *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control round", @required = "required", @placeholder = "Masalan: Rejada (to-do)" })
                                                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">SortOrder</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.SortOrder, new { @class = "form-control round", @type = "number", @value = "0" })
                                                        @Html.ValidationMessageFor(model => model.SortOrder, "", new { @class = "text-danger" })
                                                        <small class="text-muted">Agar 0 bo'lsa, avtomatik hisoblanadi</small>
                                                    </fieldset>
                                                    <h6 class="invoice-to">Rang</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        <input type="color" name="ColorHex" class="form-control round" style="height: 40px; max-width: 120px;" value="@(string.IsNullOrEmpty(Model?.ColorHex) ? "#6C757D" : Model.ColorHex)" />
                                                        <small class="text-muted">Badge va grafiklardagi rang</small>
                                                    </fieldset>
                                                    <h6 class="invoice-to">Yopilgan holat</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.CheckBoxFor(model => model.IsFinal)
                                                        @Html.LabelFor(model => model.IsFinal, "Yopilgan (bajarilgan yoki bekor) — muddati o'tgan hisoblanmaydi")
                                                    </fieldset>
                                                    <h6 class="invoice-to">Faol</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.CheckBoxFor(model => model.IsActive, new { @checked = "checked" })
                                                        @Html.LabelFor(model => model.IsActive, "Faol")
                                                    </fieldset>
                                                    <ul class="list-group list-group-flush">
                                                        <li class="list-group-item border-0 pb-0">
                                                            <button class="btn btn-primary btn-block subtotal-preview-btn" type="submit">
                                                                <i class='bx bx-save'></i>
                                                                Saqlash
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                            <hr>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
