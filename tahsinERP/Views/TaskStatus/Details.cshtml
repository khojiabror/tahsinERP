@model tahsinERP.Models.APP_TASK_STATUS_REF
@{
    ViewBag.Title = "Status ma'lumotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());
    
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/TaskStatus">Statuslar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @Model.Name
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                <h4 class="text-primary">Status Ma'lumotlari</h4>
                                                <hr />
                                                <p><b>Kod:</b> @Model.Code</p>
                                                <p><b>Nomi:</b> @Model.Name</p>
                                                <p><b>SortOrder:</b> @Model.SortOrder</p>
                                                <p><b>Faol:</b> 
                                                    @if (Model.IsActive)
                                                    {
                                                        <span class="badge badge-success">Faol</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-secondary">Nofaol</span>
                                                    }
                                                </p>
                                                <hr>
                                                @if (changePermit)
                                                {
                                                    <div class="row mt-3">
                                                        <div class="col-12">
                                                            <a href="@Url.Action("Edit", "TaskStatus", new { id = Model.ID })" class="btn btn-primary">
                                                                <i class="bx bx-edit-alt"></i> Tahrirlash
                                                            </a>
                                                            <a href="@Url.Action("Index", "TaskStatus")" class="btn btn-secondary">
                                                                <i class="bx bx-arrow-back"></i> Orqaga
                                                            </a>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
