@model List<tahsinERP.Models.PRODUCT_STOCKS>
@{
    ViewBag.Title = L.T("Wh_StockTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Wh_StockTitle")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <div class="row mb-2">
                        <div class="col-12 d-flex flex-wrap">
                            <a href="@Url.Action("Create", "Incomes")" class="btn btn-success mr-1 mb-1">
                                <i class="bx bx-log-in-circle"></i> @L.T("Wh_GoToIncome")
                            </a>
                            <a href="@Url.Action("Create", "Expenses")" class="btn btn-danger mr-1 mb-1">
                                <i class="bx bx-log-out-circle"></i> @L.T("Wh_GoToExpense")
                            </a>
                            <a href="@Url.Action("Adjust", "Inventory")" class="btn btn-warning mr-1 mb-1">
                                <i class="bx bx-edit"></i> @L.T("Wh_Inventory")
                            </a>
                            @if (ViewBag.DlocStockEnabled == true)
                            {
                                <a href="@Url.Action("IndexDloc", "Inventory")" class="btn btn-info mr-1 mb-1">
                                    <i class="bx bx-grid-alt"></i> @L.T("Wh_StockByLocation")
                                </a>
                                <a href="@Url.Action("AssignDloc", "Inventory")" class="btn btn-warning mb-1">
                                    <i class="bx bx-map-pin"></i> @L.T("Wh_AssignToDloc")
                                </a>
                            }
                        </div>
                    </div>
                    <!-- Filters -->
                    <div class="users-list-filter px-1">
                        @using (Html.BeginForm("Index", "Inventory", FormMethod.Get, new { @class = "form" }))
                        {
                            <div class="row border rounded py-2 mb-2">
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label>@L.T("Wh_Warehouse")</label>
                                    @Html.DropDownList("warehouseId", ViewBag.Warehouses as SelectList, L.T("All"), new { @class = "form-control" })
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label>@L.T("Category")</label>
                                    @Html.DropDownList("categoryId", ViewBag.Categories as SelectList, L.T("All"), new { @class = "form-control" })
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>@L.T("Wh_ProductType")</label>
                                    <select name="isFinishedGood" class="form-control">
                                        <option value="">@L.T("All")</option>
                                        <option value="true" @(ViewBag.IsFinishedGood == true ? "selected" : "")>@L.T("Wh_FinishedGood")</option>
                                        <option value="false" @(ViewBag.IsFinishedGood == false ? "selected" : "")>@L.T("Wh_RawMaterial")</option>
                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>@L.T("Wh_RawMaterial")</label>
                                    <select name="isRawMaterial" class="form-control">
                                        <option value="">@L.T("All")</option>
                                        <option value="true" @(ViewBag.IsRawMaterial == true ? "selected" : "")>@L.T("Wh_OnlyRawMaterial")</option>
                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bx bx-search"></i> @L.T("Search")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="inventoryTable" class="table table-striped table-bordered nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Wh_Warehouse")</th>
                                                    <th>@L.T("Wh_ProductCode")</th>
                                                    <th>@L.T("Wh_ProductName")</th>
                                                    <th>@L.T("Category")</th>
                                                    <th>@L.T("Quantity")</th>
                                                    <th>@L.T("Unit")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@(item.Warehouse?.WHName ?? "-")</td>
                                                            <td>@(item.PRODUCT?.PNo ?? "-")</td>
                                                            <td>@(item.PRODUCT?.Name ?? "-")</td>
                                                            <td>@(item.PRODUCT?.PRODUCT_CATEGORIES?.Name ?? "-")</td>
                                                            <td>@item.Amount.ToString("N2")</td>
                                                            <td>@(item.UNIT?.ShortName ?? "-")</td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                $('#inventoryTable').DataTable({
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "@L.Js("All")"]],
                    "order": [[3, "desc"]],
                    "columnDefs": [
                        { "type": "date", "targets": 3 }
                    ],
                    "scrollX": true,
                    dom: 'lBfrtip',
                    buttons: erpDataTable.buttons({ fileName: '@L.Js("Wh_StockFileName")', pdfTitle: '@L.Js("Wh_StockTitle")' })
                });
            });
        </script>
    }
