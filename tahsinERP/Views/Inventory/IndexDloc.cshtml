@model List<tahsinERP.Services.DlocFifo.InventoryDlocStockRow>
@{
    ViewBag.Title = L.T("Wh_Dl_Title");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Inventory")">@L.T("Wh_StockTitle")</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Wh_StockByLocation")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <section class="invoice-list-wrapper">
                <div class="row mb-2">
                    <div class="col-12 d-flex flex-wrap">
                        <a href="@Url.Action("Index", "Inventory")" class="btn btn-secondary mr-1 mb-1">
                            <i class="bx bx-arrow-back"></i> @L.T("Wh_TotalStock")
                        </a>
                        <a href="@Url.Action("Create", "Incomes")" class="btn btn-success mr-1 mb-1">
                            <i class="bx bx-log-in-circle"></i> @L.T("Wh_GoToIncome")
                        </a>
                        <a href="@Url.Action("Create", "Expenses")" class="btn btn-danger mr-1 mb-1">
                            <i class="bx bx-log-out-circle"></i> @L.T("Wh_GoToExpense")
                        </a>
                        <a href="@Url.Action("AssignDloc", "Inventory")" class="btn btn-warning mr-1 mb-1">
                            <i class="bx bx-map-pin"></i> @L.T("Wh_AssignToDloc")
                        </a>
                        <a href="@Url.Action("Index", "WarehouseLocations")" class="btn btn-outline-primary mb-1">
                            <i class="bx bx-grid-alt"></i> @L.T("Wh_DlocSettings")
                        </a>
                    </div>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                <div class="users-list-filter px-1">
                    @using (Html.BeginForm("IndexDloc", "Inventory", FormMethod.Get, new { @class = "form" }))
                    {
                        <div class="row border rounded py-2 mb-2">
                            <div class="col-12 col-sm-6 col-lg-3">
                                <label>@L.T("Wh_Warehouse")</label>
                                @Html.DropDownList("warehouseId", ViewBag.Warehouses as SelectList, L.T("All"), new { @class = "form-control" })
                            </div>
                            <div class="col-12 col-sm-6 col-lg-3">
                                <label>@L.T("Category")</label>
                                @Html.DropDownList("categoryId", ViewBag.Categories as SelectList, L.T("All"), new { @class = "form-control" })
                            </div>
                            <div class="col-12 col-sm-6 col-lg-2">
                                <label>@L.T("Wh_ProductType")</label>
                                <select name="isFinishedGood" class="form-control">
                                    <option value="">@L.T("All")</option>
                                    <option value="true" @(ViewBag.IsFinishedGood == true ? "selected" : "")>@L.T("Wh_FinishedGood")</option>
                                    <option value="false" @(ViewBag.IsFinishedGood == false ? "selected" : "")>@L.T("Wh_RawMaterial")</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-2">
                                <label>@L.T("Wh_RawMaterial")</label>
                                <select name="isRawMaterial" class="form-control">
                                    <option value="">@L.T("All")</option>
                                    <option value="true" @(ViewBag.IsRawMaterial == true ? "selected" : "")>@L.T("Wh_OnlyRawMaterial")</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bx bx-search"></i> @L.T("Search")
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-md-12 col-sm-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                @if (Model != null && Model.Any())
                                {
                                    <div class="table-responsive">
                                        <table id="inventoryDlocTable" class="table table-striped table-bordered nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Wh_Warehouse")</th>
                                                    <th>DLOC</th>
                                                    <th>@L.T("Wh_ProductCode")</th>
                                                    <th>@L.T("Wh_ProductName")</th>
                                                    <th>@L.T("Wh_Balance")</th>
                                                    <th>@L.T("Unit")</th>
                                                    <th>Min</th>
                                                    <th>Max</th>
                                                    <th>@L.T("Wh_Dl_CapacityPct")</th>
                                                    <th>@L.T("Wh_Dl_LotCount")</th>
                                                    <th>@L.T("Wh_Dl_EarliestIncome")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var r in Model)
                                                {
                                                    var fillPct = r.MaxCapacity > 0 ? (double)(r.QtyAvailable / r.MaxCapacity * 100m) : 0;
                                                    var rowClass = "";
                                                    if (r.MinCapacity > 0 && r.QtyAvailable < r.MinCapacity)
                                                    {
                                                        rowClass = "table-warning";
                                                    }
                                                    else if (r.MaxCapacity > 0 && r.QtyAvailable >= r.MaxCapacity * 0.9m)
                                                    {
                                                        rowClass = "table-danger";
                                                    }
                                                    <tr class="@rowClass">
                                                        <td>@r.WarehouseName</td>
                                                        <td><strong>@r.LocationCode</strong></td>
                                                        <td>@r.ProductPNo</td>
                                                        <td>@r.ProductName</td>
                                                        <td>@r.QtyAvailable.ToString("N2")</td>
                                                        <td>@(r.UnitName ?? "—")</td>
                                                        <td>@r.MinCapacity.ToString("N2")</td>
                                                        <td>@r.MaxCapacity.ToString("N2")</td>
                                                        <td>@(r.MaxCapacity > 0 ? fillPct.ToString("N0") + "%" : "—")</td>
                                                        <td>@r.LotCount</td>
                                                        <td>@(r.ReceivedDateTime.HasValue ? r.ReceivedDateTime.Value.ToString("dd.MM.yyyy HH:mm") : "—")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <p class="text-muted small mt-1 mb-0">
                                        <span class="badge badge-warning">@L.T("Wh_Dl_Yellow")</span> — @L.T("Wh_Dl_BelowMin")
                                        <span class="badge badge-danger">@L.T("Wh_Dl_Red")</span> — @L.T("Wh_Dl_NearMax")
                                    </p>
                                }
                                else
                                {
                                    <div class="alert alert-info mb-0">
                                        @Html.Raw(L.T("Wh_Dl_EmptyHint",
                                            "<a href=\"" + Url.Action("Index", "WarehouseLocations") + "\">" + HttpUtility.HtmlEncode(L.T("Wh_Dl_LocationsLink")) + "</a>",
                                            "<a href=\"" + Url.Action("Index", "Inventory") + "\">" + HttpUtility.HtmlEncode(L.T("Wh_Dl_HereLink")) + "</a>"))
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($('#inventoryDlocTable').length) {
                $('#inventoryDlocTable').DataTable({
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "@L.Js("All")"]],
                    "order": [[0, "asc"], [1, "asc"]],
                    "scrollX": true,
                    dom: 'lBfrtip',
                    buttons: erpDataTable.buttons({ fileName: '@L.Js("Wh_Dl_FileName")', pdfTitle: '@L.Js("Wh_Dl_PdfTitle")' })
                });
            }
        });
    </script>
}
