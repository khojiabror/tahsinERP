@model List<tahsinERP.Models.F_CONTRACTS>
@{
    ViewBag.Title = L.T("Log_Contracts");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()); }
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item ">
                                    @L.T("Log_Pages")
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Log_Contracts")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <!-- users list start -->
            <section class="invoice-list-wrapper">
                @if (changePermit)
                {
                    <div class="invoice-create-btn mb-1">
                        <button type="button" class="btn btn-outline-success mr-1 mb-1" onclick="window.location.href='/FContract/Create';">
                            <span class="align-middle ml-25">@L.T("Log_AddContract")</span>
                        </button>
                    </div>
                }
                <div class="col-md-12 col-sm-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <!-- datatable start -->
                                <div class="table-responsive table-responsivetable-responsive">
                                   
                                    <table id="myDataTable" class="table table-striped table-bordered complex-headers" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Log_NumberShort")</th>
                                                <th>@L.T("Log_ForwarderName")</th>
                                                <th>@L.T("Log_IssueDate")</th>
                                                <th>@L.T("Log_DueDate")</th>
                                                <th>@L.T("Amount")</th>
                                                <th>@L.T("Currency")</th>
                                                @if (changePermit)
                                                {
                                                    <th>@L.T("Actions")</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>    
                                                    <td>
                                                        <a href="~/FContract/Details/@item.ID">@item.ContractNo</a>
                                                    </td>
                                                    <td>
                                                        <a href="~/Forwarder/Details/@item.ForwarderID">@item.FORWARDER.ForwarderName</a>
                                                    </td>
                                                    <td>@item.IssueDate.ToString("dd.MM.yyyy")</td>
                                                    <td>@item.DueDate.ToString("dd.MM.yyyy")</td>
                                                    <td>@item.Amount.ToString("0.######")</td>
                                                    <td>@(item.CURRENCy?.Shortname ?? "")</td>
                                                    @if (changePermit)
                                                    {
                                                        <td>
                                                            <div>
                                                                <a href="@Url.Action("Edit", "FContract", new { id = item.ID })" class="btn btn-sm btn-outline-success" title="@L.T("Edit")"><i class="bx bx-edit-alt"></i></a>
                                                                <a href="@Url.Action("Delete", "FContract", new { id = item.ID})" class="btn btn-sm btn-outline-danger" title="@L.T("Delete")"><i class="bx bx-trash"></i></a>
                                                            </div>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <!-- datatable ends -->
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- users list ends -->
        </div>
    </div>
</div>
