@model tahsinERP.Models.F_CONTRACTS
@{
    ViewBag.Title = L.T("Log_ContractEditTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.Partial("_FContractForm", Model)

@section scripts {
<script>
    // LOG-B17: ikkala sana ham (avval bir xil id tufayli faqat birinchisi) va bitta ISO format
    flatpickr(".fcontract-date", {
        dateFormat: "Y-m-d",
        altInput: true,
        altFormat: "d.m.Y",
        weekNumbers: true,
        locale: "uz"
    });
</script>
}
