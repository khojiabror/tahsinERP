@model tahsinERP.Models.F_CONTRACTS
@using tahsinERP.Services
@* Ekspeditor shartnomasi formasi — Create va Edit uchun bitta (LOG-D02). Ruxsat [Permission] filtrida tekshiriladi. *@
@{
    bool isEdit = Model != null && Model.ID > 0;
}
@using (Html.BeginForm(isEdit ? "Edit" : "Create", "FContract", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    if (isEdit)
    {
        @Html.HiddenFor(model => model.ID)
    }
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/FContract/Index">Shartnomalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @(isEdit ? "Shartnomani tahrirlash" : "Yangi shartnoma qo'shish")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="basic-select2">
                    <div class="row">
                        <div class="col-xl-9 col-md-8 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row">
                                            <div class="col-lg-12 col-md-6 mt-25">
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                <hr>
                                                <h6 class="invoice-to">Shartnoma raqami</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.ContractNo, new { @class = "form-control round", @placeholder = "Shartnoma raqami" })
                                                    @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">@LogisticsTerms.Forwarder</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.DropDownListFor(model => model.ForwarderID, ViewBag.Forwarder as SelectList, new { @class = "form-control select2" })
                                                    @Html.ValidationMessageFor(model => model.ForwarderID, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">Tuzilgan sanasi</h6>
                                                <fieldset class="form-group position-relative has-icon-left">
                                                    @Html.TextBoxFor(model => model.IssueDate, "{0:yyyy-MM-dd}", new { @class = "form-control fcontract-date", @required = "required", @placeholder = "Shartnoma tuzilgan sanasi" })
                                                    @Html.ValidationMessageFor(model => model.IssueDate, "", new { @class = "text-danger" })
                                                    <div class="form-control-position">
                                                        <i class='bx bx-calendar'></i>
                                                    </div>
                                                </fieldset>
                                                <h6 class="invoice-to">Tugaydigan sana</h6>
                                                <fieldset class="form-group position-relative has-icon-left">
                                                    @Html.TextBoxFor(model => model.DueDate, "{0:yyyy-MM-dd}", new { @class = "form-control fcontract-date", @required = "required", @placeholder = "Shartnoma tugaydigan sanasi" })
                                                    @Html.ValidationMessageFor(model => model.DueDate, "", new { @class = "text-danger" })
                                                    <div class="form-control-position">
                                                        <i class='bx bx-calendar'></i>
                                                    </div>
                                                </fieldset>
                                                <h6 class="invoice-to">Miqdori</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.Amount, new { @class = "form-control round", @placeholder = "Summa" })
                                                    @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">Valyuta</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.DropDownListFor(model => model.CurrencyID, ViewBag.currencies as SelectList, new { @class = "form-control select2" })
                                                    @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">Batafsil ma`lumot</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control round", @placeholder = "Qisqacha malumot" })
                                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <ul class="list-group list-group-flush">
                                                    <li class="list-group-item border-0 pb-0">
                                                        <button class="btn btn-primary btn-block subtotal-preview-btn" type="submit">
                                                            <i class='bx bx-save'></i>
                                                            Saqlash
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                        <hr>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
