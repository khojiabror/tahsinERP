@model tahsinERP.Models.F_CONTRACTS

@{
    ViewBag.Title = L.T("Log_ContractDetailsTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/FContract/Index">@L.T("Log_Contracts")</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Log_ContractPage")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body pb-0 mx-25">
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 mt-25">

                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        <h4 class="text-primary">@L.T("Log_ContractInfo")</h4>
                                        @if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "Forwarder", "Details"))
                                        {
                                            <div class="mb-2">
                                                <a href="@Url.Action("Forwarder", "Reconciliation", new { id = Model.ForwarderID, contractId = Model.ID })" class="btn btn-sm btn-outline-primary">
                                                    <i class="bx bx-transfer-alt"></i> @L.T("Log_ReconThisContract")
                                                </a>
                                            </div>
                                        }
                                        <hr>

                                        <div class="row my-2 py-50">
                                            <div class="col-sm-12 col-12 order-2 order-sm-1">
                                                <span><b>@L.T("Log_ContractNo")</b>: @Html.DisplayFor(model => model.ContractNo, new { @class = "form-control" })</span>
                                                <hr />
                                                <span><b>@L.T("Log_Forwarder")</b>: @Html.DisplayFor(model => model.FORWARDER.ForwarderName, new { @class = "form-control" })</span>
                                                <hr />
                                                <span><b>@L.T("Log_SetDate")</b>:   @Model.IssueDate.ToString("dd.MM.yyyy")</span>
                                                <hr />
                                                <span><b>@L.T("Log_ValidUntil")</b>: @Model.DueDate.ToString("dd.MM.yyyy")</span>
                                                <hr />
                                                <span><b>@L.T("Log_AmountShort")</b>: @Html.DisplayFor(model => model.Amount, new { @class = "form-control" })</span>
                                                <hr />
                                                <span><b>@L.T("Currency")</b>: @Html.DisplayFor(model => model.CURRENCy.Shortname, new { @class = "form-control" })</span>
                                                <hr />
                                                <span><b>@L.T("Log_DetailedInfo")</b>: @Html.DisplayFor(model => model.Description, new { @class = "form-control" })</span>
                                                <hr />
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <h5 class="text-primary">@L.T("Log_Tariffs")</h5>
                                                    <a href="@Url.Action("Create", "FContractTariff", new { contractId = Model.ID })" class="btn btn-sm btn-outline-primary">
                                                        <i class="bx bx-plus"></i> @L.T("Log_AddTariff")
                                                    </a>
                                                </div>
                                                <div class="table-responsive mt-1">
                                                    <table class="table table-striped">
                                                        <thead>
                                                            <tr>
                                                                <th>@L.T("Log_TransportType")</th>
                                                                <th>@L.T("Log_From")</th>
                                                                <th>@L.T("Log_To")</th>
                                                                <th>@L.T("Log_TariffBasis")</th>
                                                                <th>@L.T("Log_TariffRate")</th>
                                                                <th>@L.T("Currency")</th>
                                                                <th>@L.T("Active")</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @if (Model.F_CONTRACT_TARIFFS != null && Model.F_CONTRACT_TARIFFS.Any())
                                                            {
                                                                foreach (var tariff in Model.F_CONTRACT_TARIFFS)
                                                                {
                                                                    <tr>
                                                                        <td>@(tariff.F_TRANSPORT_TYPES != null ? tariff.F_TRANSPORT_TYPES.TransportType : "")</td>
                                                                        <td>@(string.IsNullOrEmpty(tariff.FromCity) ? tariff.FromRegion : tariff.FromCity)</td>
                                                                        <td>@(string.IsNullOrEmpty(tariff.ToCity) ? tariff.ToRegion : tariff.ToCity)</td>
                                                                        <td>@tahsinERP.Services.LogisticsEnums.FreightBasisText(tariff.FreightBasis)</td>
                                                                        <td>@tariff.Rate.ToString("N2")</td>
                                                                        <td>@(tariff.CURRENCy != null ? tariff.CURRENCy.Shortname : "")</td>
                                                                        <td>@(tariff.IsActive ? L.T("Yes") : L.T("No"))</td>
                                                                    </tr>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <tr>
                                                                    <td colspan="7" class="text-center">@L.T("Log_NoTariffs")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <hr>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
