@model tahsinERP.ViewModels.HR.HrTimesheetHeaderViewModel
@{
    ViewBag.Title = L.T("Hr_Timesheet") + " - " + L.T("Print");
    Layout = "~/Views/Shared/_Layout.cshtml";
    int daysInMonth = DateTime.DaysInMonth(Model.Year, Model.Month);
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "HrTimesheets")">@L.T("Hr_Timesheet")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Print")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row mb-2">
                    <div class="col-12 text-right">
                        <button onclick="window.print()" class="btn btn-primary">
                            <i class="bx bx-printer"></i> @L.T("Print")
                        </button>
                        <a href="@Url.Action("Export", new { id = Model.ID })" class="btn btn-success">
                            <i class="bx bx-export"></i> @L.T("ExportExcel")
                        </a>
                    </div>
                </div>

                <div class="card" id="printArea" data-print-target="true">
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <h4>@L.T("Hr_RepTimesheetTitle")</h4>
                            <p>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) @L.T("Hr_YearN", Model.Year)</p>
                            @if (!string.IsNullOrEmpty(Model.OrgUnitName))
                            {
                                <p><strong>@L.T("Hr_OrgUnit"):</strong> @Model.OrgUnitName</p>
                            }
                            <p><strong>@L.T("Hr_FundHours"):</strong> @Model.FundHours.ToString("0.##")</p>
                        </div>

                        <div class="timesheet-table-wrapper">
                            <table class="table table-bordered timesheet-table">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="width: 30px;">№</th>
                                    <th rowspan="2" style="width: 60px;">@L.T("Hr_TabNoShort")</th>
                                    <th rowspan="2" style="width: 150px;">@L.T("Hr_FullName")</th>
                                    <th rowspan="2" style="width: 100px;">@L.T("Hr_Position")</th>
                                    <th colspan="@daysInMonth" style="text-align: center;">@L.T("Hr_MonthDays")</th>
                                    <th rowspan="2" style="width: 60px;">@L.T("Hr_WorkDays")</th>
                                    <th rowspan="2" style="width: 60px;">@L.T("Hr_WorkHours")</th>
                                    <th rowspan="2" style="width: 60px;">@L.T("Hr_Overtime")</th>
                                    <th rowspan="2" style="width: 60px;">@L.T("Hr_Absent")</th>
                                </tr>
                                <tr>
                                    @for (int day = 1; day <= daysInMonth; day++)
                                    {
                                        <th style="width: 30px; text-align: center;">@day</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rowNum = 1; }
                                @foreach (var line in Model.Lines.OrderBy(l => l.EmployeeTabNo))
                                {
                                    <tr>
                                        <td>@rowNum</td>
                                        <td>@line.EmployeeTabNo</td>
                                        <td>@line.EmployeeFullName</td>
                                        <td>@line.PositionName</td>
                                        @for (int day = 1; day <= daysInMonth; day++)
                                        {
                                            var hours = tahsinERP.Services.HR.TimesheetLineAccessor.GetHours(line, day);
                                            <td style="text-align: center;">@(hours?.ToString("F1") ?? "0")</td>
                                        }
                                        <td style="text-align: center;">@line.TotalWorkedDays.ToString("F1")</td>
                                        <td style="text-align: center;">@line.TotalWorkedHours.ToString("F2")</td>
                                        <td style="text-align: center;">@line.OvertimeHours.ToString("F2")</td>
                                        <td style="text-align: center;">@line.AbsentDays.ToString("F1")</td>
                                    </tr>
                                    rowNum++;
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="@(4 + daysInMonth + 2)" style="text-align:right;">@L.T("Hr_TotalOvertimeHours")</th>
                                    <th style="text-align:center;">@Model.Lines.Sum(l => l.OvertimeHours).ToString("F2")</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                            </table>
                        </div>

                        <div class="mt-4">
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>@L.T("Hr_CompiledBy"):</strong> _________________</p>
                                </div>
                                <div class="col-md-6 text-right">
                                    <p><strong>@L.T("Hr_ApprovedBy"):</strong> _________________</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .timesheet-table-wrapper {
            overflow: auto;
            max-height: calc(100vh - 280px);
            border: 1px solid #e5e7eb;
        }
        .timesheet-table {
            width: max-content;
            min-width: 100%;
            font-size: 10px;
        }
        .timesheet-table th,
        .timesheet-table td {
            white-space: nowrap;
            padding: 2px 4px;
        }
    </style>

    <style media="print">
        .content-header, .breadcrumb-wrapper, .btn, .content-overlay {
            display: none !important;
        }
        #printArea {
            border: none;
            box-shadow: none;
        }
        body {
            background: white;
        }
        .timesheet-table-wrapper {
            overflow: visible;
            max-height: none;
            border: none;
        }
        table {
            page-break-inside: auto;
        }
        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }
    </style>

