@model tahsinERP.Models.SHAREHOLDER_CONTRIBUTIONS

@{
    ViewBag.Title = "Hissa qo'shish";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var shareholder = ViewBag.Shareholder as tahsinERP.Models.SHAREHOLDER;
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Shareholder"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Shareholder">Aksiyadorlar</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Details", new { id = shareholder.ID })">@shareholder.FullName</a></li>
                                    <li class="breadcrumb-item active">Hissa qo'shish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Hissa qo'shish: @shareholder.FullName</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("AddContribution", "Shareholder", FormMethod.Post, new { @class = "form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(m => m.ShareholderID)
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.ContributionDate, "Sana *", new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.ContributionDate, new { @class = "form-control", type = "date", required = "required", @Value = Model.ContributionDate.ToString("yyyy-MM-dd") })
                                            @Html.ValidationMessageFor(m => m.ContributionDate, "", new { @class = "text-danger" })
                                        </div>
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Amount, "Summa *", new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01", required = "required" })
                                            @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger" })
                                        </div>
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.CurrencyID, "Valyuta *", new { @class = "control-label" })
                                            @Html.DropDownListFor(m => m.CurrencyID, ViewBag.CurrencyID as SelectList, "Tanlang...", new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(m => m.CurrencyID, "", new { @class = "text-danger" })
                                        </div>
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.ContributionType, "Hissa turi *", new { @class = "control-label" })
                                            @Html.DropDownListFor(m => m.ContributionType, ViewBag.ContributionTypeList as SelectList, "Tanlang...", new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(m => m.ContributionType, "", new { @class = "text-danger" })
                                        </div>
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Description, "Tavsif", new { @class = "control-label" })
                                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3 })
                                        </div>
                                        
                                        <div class="alert alert-info">
                                            <i class="bx bx-info-circle"></i> Naqd pul hissasi uchun avtomatik moliya tranzaksiyasi yaratiladi.
                                        </div>
                                        
                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-primary">Saqlash</button>
                                            <a href="@Url.Action("Details", new { id = shareholder.ID })" class="btn btn-secondary">Bekor qilish</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
