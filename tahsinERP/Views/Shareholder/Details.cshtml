@model tahsinERP.Models.SHAREHOLDER

@{
    ViewBag.Title = L.T("Fin_ShareholderDetails");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Shareholder");
    var contributions = ViewBag.Contributions as List<tahsinERP.Models.SHAREHOLDER_CONTRIBUTIONS> ?? new List<tahsinERP.Models.SHAREHOLDER_CONTRIBUTIONS>();
}

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Shareholder">@L.T("Fin_Shareholders")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Fin_Details")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                <div class="row">
                    <div class="col-md-10">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Fin_ShareholderDetails")</h4>
                                @if (changePermit)
                                {
                                    <div class="heading-elements">
                                        <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-sm btn-primary">@L.T("Edit")</a>
                                        <a href="@Url.Action("ManageSharePeriods", new { id = Model.ID })" class="btn btn-sm btn-info">@L.T("Fin_ManageShares")</a>
                                        <a href="@Url.Action("AddContribution", new { id = Model.ID })" class="btn btn-sm btn-success">@L.T("Fin_AddContribution")</a>
                                    </div>
                                }
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <dl class="row">
                                        <dt class="col-sm-4">@L.T("Fin_FullName"):</dt>
                                        <dd class="col-sm-8">@Model.FullName</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Phone"):</dt>
                                        <dd class="col-sm-8">@(Model.Phone ?? "-")</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_CurrentShare"):</dt>
                                        <dd class="col-sm-8"><strong>@ViewBag.CurrentSharePercent%</strong></dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_State"):</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.IsActive)
                                            { <span class="badge badge-success">@L.T("Active")</span> }
                                            else
                                            { <span class="badge badge-danger">@L.T("Inactive")</span> }
                                        </dd>
                                        
                                        <dt class="col-sm-4">@L.T("Comment"):</dt>
                                        <dd class="col-sm-8">@(Model.Notes ?? "-")</dd>
                                    </dl>
                                    
                                    <h5 class="mt-4">@L.T("Fin_Contributions"):</h5>
                                    @if (contributions.Any())
                                    {
                                        <div class="table-responsive mt-2">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>@L.T("Date")</th>
                                                        <th>@L.T("Amount")</th>
                                                        <th>@L.T("Currency")</th>
                                                        <th>@L.T("Type")</th>
                                                        <th>@L.T("Description")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var contrib in contributions)
                                                    {
                                                        <tr>
                                                            <td>@contrib.ContributionDate.ToString("dd.MM.yyyy")</td>
                                                            <td>@contrib.Amount.ToString("N2")</td>
                                                            <td>@(contrib.CURRENCy != null ? contrib.CURRENCy.Shortname : "-")</td>
                                                            <td>
                                                                @if (contrib.ContributionType == 1)
                                                                { <span class="badge badge-success">@L.T("Fin_Cash")</span> }
                                                                else if (contrib.ContributionType == 2)
                                                                { <span class="badge badge-info">@L.T("Fin_Goods")</span> }
                                                                else if (contrib.ContributionType == 3)
                                                                { <span class="badge badge-warning">@L.T("Fin_RawMaterials")</span> }
                                                                else if (contrib.ContributionType == 4)
                                                                { <span class="badge badge-primary">@L.T("Fin_FinishedProducts")</span> }
                                                                else
                                                                { <span class="badge badge-secondary">@L.T("Fin_Other")</span> }
                                                            </td>
                                                            <td>@(contrib.Description ?? "-")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">@L.T("Fin_NoContributions")</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
