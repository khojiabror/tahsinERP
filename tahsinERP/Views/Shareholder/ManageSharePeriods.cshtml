@{
    ViewBag.Title = L.T("Fin_ManageShares");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var shareholder = ViewBag.Shareholder as tahsinERP.Models.SHAREHOLDER;
    var periods = ViewBag.Periods as List<tahsinERP.Models.SHAREHOLDER_SHARE_PERIODS> ?? new List<tahsinERP.Models.SHAREHOLDER_SHARE_PERIODS>();
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Shareholder">@L.T("Fin_Shareholders")</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Details", new { id = shareholder.ID })">@shareholder.FullName</a></li>
                                    <li class="breadcrumb-item active">@L.T("Fin_ManageShares")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                <div class="row">
                    <div class="col-md-10">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Fin_ManageShares"): @shareholder.FullName</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <h5>@L.T("Fin_ExistingSharePeriods"):</h5>
                                    <div class="table-responsive mb-3">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Fin_From")</th>
                                                    <th>@L.T("Fin_To")</th>
                                                    <th>@L.T("Fin_SharePct")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var period in periods)
                                                {
                                                    <tr>
                                                        <td>@period.FromDate.ToString("dd.MM.yyyy")</td>
                                                        <td>@(period.ToDate?.ToString("dd.MM.yyyy") ?? L.T("Fin_UntilNow"))</td>
                                                        <td><strong>@period.SharePercent%</strong></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    
                                    <h5>@L.T("Fin_AddSharePeriod"):</h5>
                                    @using (Html.BeginForm("AddSharePeriod", "Shareholder", FormMethod.Post, new { @class = "form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("shareholderID", shareholder.ID)
                                        
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label class="control-label">@L.T("Fin_DateFrom") *</label>
                                                    <input type="date" name="fromDate" class="form-control" required />
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label class="control-label">@L.T("Fin_DateTo")</label>
                                                    <input type="date" name="toDate" class="form-control" />
                                                    <small class="text-muted">@L.T("Fin_EmptyMeansNow")</small>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label class="control-label">@L.T("Fin_SharePct") *</label>
                                                    <input type="number" name="sharePercent" class="form-control" step="0.01" min="0" max="100" required />
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label class="control-label">&nbsp;</label>
                                                    <button type="submit" class="btn btn-primary btn-block">@L.T("Add")</button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    
                                    <div class="mt-3">
                                        <a href="@Url.Action("Details", new { id = shareholder.ID })" class="btn btn-secondary">@L.T("Back")</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
