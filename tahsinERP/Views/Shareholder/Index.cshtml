@model List<tahsinERP.Models.SHAREHOLDER>

@{
    ViewBag.Title = L.T("Fin_Shareholders");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Shareholder");
}

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">@L.T("Menu_Finance")</li>
                                    <li class="breadcrumb-item active">@L.T("Fin_Shareholders")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <button type="button" class="btn btn-outline-success mr-1 mb-1" onclick="window.location.href='/Shareholder/Create';">
                                <span class="align-middle ml-25">@L.T("Fin_AddShareholder")</span>
                            </button>
                        </div>
                    }
                    
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="shareholdersTable" class="table table-striped table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Fin_FullName")</th>
                                                <th>@L.T("Phone")</th>
                                                <th>@L.T("Fin_State")</th>
                                                @if (changePermit)
                                                {
                                                    <th>@L.T("Actions")</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td><a href="@Url.Action("Details", new { id = item.ID })">@item.FullName</a></td>
                                                    <td>@(item.Phone ?? "-")</td>
                                                    <td>
                                                        @if (item.IsActive)
                                                        { <span class="badge badge-success">@L.T("Active")</span> }
                                                        else
                                                        { <span class="badge badge-danger">@L.T("Inactive")</span> }
                                                    </td>
                                                    @if (changePermit)
                                                    {
                                                        <td class="text-center">
                                                            <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-outline-info" title="@L.T("View")">
                                                                <i class="bx bx-show"></i>
                                                            </a>
                                                            <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-outline-primary" title="@L.T("Edit")">
                                                                <i class="bx bx-edit"></i>
                                                            </a>
                                                            <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-outline-danger" title="@L.T("Delete")">
                                                                <i class="bx bx-trash"></i>
                                                            </a>
                                                            <a href="@Url.Action("ManageSharePeriods", new { id = item.ID })" class="btn btn-sm btn-outline-warning" title="@L.T("Fin_ManageShares")">
                                                                <i class="bx bx-pie-chart"></i>
                                                            </a>
                                                            <a href="@Url.Action("AddContribution", new { id = item.ID })" class="btn btn-sm btn-outline-success" title="@L.T("Fin_AddContribution")">
                                                                <i class="bx bx-plus-circle"></i>
                                                            </a>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                var changePermit = @(changePermit ? "true" : "false");
                
                var columnDefs = [
                    { "className": "text-center", "targets": [0, 1, 2] }
                ];
                if (changePermit) {
                    columnDefs.push({ "orderable": false, "targets": -1, "className": "text-center" });
                }
                
                $('#shareholdersTable').DataTable({
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "@L.Js("All")"]],
                    "order": [[0, "asc"]],
                    "columnDefs": columnDefs,
                    "dom": 'lBfrtip',
                    "pagingType": "full_numbers",
                    "buttons": erpDataTable.buttons({ fileName: 'Shareholders', columns: changePermit ? ':not(:last-child)' : ':visible' })
                });
            });
        </script>
    }
