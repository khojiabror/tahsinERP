@model tahsinERP.Models.FIN_CATEGORIES

@{
    ViewBag.Title = L.T("Fin_AddCategoryTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/FinCategories">@L.T("Fin_Categories")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Fin_NewCategory")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Fin_AddCategoryTitle")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Create", "FinCategories", FormMethod.Post, new { @class = "form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Name, L.T("Name") + " *", new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                                        </div>
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Type, L.T("Type") + " *", new { @class = "control-label" })
                                            @Html.DropDownListFor(m => m.Type, ViewBag.TypeList as SelectList, L.T("Fin_SelectDots"), new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger" })
                                        </div>
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.ParentID, L.T("Fin_ParentCategory"), new { @class = "control-label" })
                                            @Html.DropDownListFor(m => m.ParentID, ViewBag.ParentID as SelectList, L.T("Fin_NoParentCategory"), new { @class = "form-control" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(m => m.AnalyticsGroup, L.T("Fin_AnalyticsGroup"), new { @class = "control-label" })
                                            @Html.DropDownListFor(m => m.AnalyticsGroup,
                                                new SelectList(tahsinERP.Services.Common.SystemCodes.FinAnalyticsGroup.All, "Key", "Value", Model.AnalyticsGroup),
                                                L.T("Fin_NotSetDash"), new { @class = "form-control" })
                                            <small class="form-text text-muted">@L.T("Fin_AnalyticsGroupHint")</small>
                                        </div>
                                        
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.SortOrder, L.T("Fin_SortOrder"), new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.SortOrder, new { @class = "form-control", type = "number", @Value = Model.SortOrder })
                                        </div>
                                        
                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-primary">@L.T("Save")</button>
                                            <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("Cancel")</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
