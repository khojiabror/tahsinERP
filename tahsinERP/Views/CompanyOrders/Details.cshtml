@model tahsinERP.Models.DOC_DOCUMENTS
@{
    ViewBag.Title = L.T("Doc_OrderDetails");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());
    var order = Model.ADM_COMPANY_ORDERS;
    var files = ViewBag.DocFiles as System.Collections.Generic.List<tahsinERP.Services.Documents.DocFileListItem>;

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Menu_CompanyOrders")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Doc_DetailsCrumb")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    @if (TempData["Success"] != null)
                                    {
                                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                                            @TempData["Success"]
                                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                                        </div>
                                    }
                                    @if (TempData["Warning"] != null)
                                    {
                                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                            @TempData["Warning"]
                                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                                        </div>
                                    }
                                    @if (TempData["ErrorMessage"] != null)
                                    {
                                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                            @TempData["ErrorMessage"]
                                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                                        </div>
                                    }
                                    @if (TempData["DownloadFileId"] != null)
                                    {
                                        @* Yaratilgan Word fayl darhol yuklab beriladi *@
                                        <script>
                                            window.addEventListener('load', function () {
                                                window.location.href = '@Url.Action("DownloadFile", new { fileId = TempData["DownloadFileId"] })';
                                            });
                                        </script>
                                    }
                                    <div class="row mb-2">
                                        <div class="col-md-6">
                                            <h4>Buyruq: @order.OrderNo</h4>
                                        </div>
                                        <div class="col-md-6 text-right">
                                            @if (changePermit)
                                            {
                                                <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                                                    <i class="bx bx-edit"></i> @L.T("Edit")
                                                </a>
                                                @* Shablon tanlab Word hujjat yaratish (shablonlar bazada — "Shablonlar" sahifasi) *@
                                                var templates = ViewBag.Templates as System.Collections.Generic.List<tahsinERP.Services.Documents.DocTemplateListItem>;
                                                if (templates != null && templates.Any())
                                                {
                                                    <form method="post" action="@Url.Action("GenerateDoc", "CompanyOrders", new { id = Model.ID })" class="d-inline-flex align-items-center ml-1">
                                                        @Html.AntiForgeryToken()
                                                        @if (templates.Count > 1)
                                                        {
                                                            <select name="templateId" class="form-control mr-1" style="width: auto;" title="@L.T("Doc_Template")">
                                                                @foreach (var t in templates)
                                                                {
                                                                    <option value="@t.ID">@t.Name</option>
                                                                }
                                                            </select>
                                                        }
                                                        else
                                                        {
                                                            <input type="hidden" name="templateId" value="@templates[0].ID" />
                                                        }
                                                        <button type="submit" class="btn btn-success" style="color: white;">
                                                            <i class="bx bx-file"></i> @L.T("Doc_CreateWordDoc")
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <a href="@Url.Action("Index", "DocTemplates", new { docType = "COMP_ORDER" })" class="btn btn-outline-success ml-1">
                                                        <i class="bx bx-upload"></i> @L.T("Doc_UploadTemplateFirst")
                                                    </a>
                                                }
                                                <a href="@Url.Action("Index", "DocTemplates", new { docType = "COMP_ORDER" })" class="btn btn-outline-secondary ml-1" title="@L.T("Doc_Templates")">
                                                    <i class="bx bx-cog"></i>
                                                </a>
                                            }
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <table class="table table-bordered">
                                                <tr>
                                                    <th>@L.T("Number")</th>
                                                    <td>@order.OrderNo</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Date")</th>
                                                    <td>@order.OrderDate.ToString("dd.MM.yyyy")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Type")</th>
                                                    <td>@order.OrderTypeCode</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Doc_Department")</th>
                                                    <td>@(Model.HR_ORG_UNITS?.Name ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Status")</th>
                                                    <td>
                                                        <span class="badge badge-@(Model.DOC_DOCUMENT_STATUS_REF?.Code == "APPROVED" ? "success" : Model.DOC_DOCUMENT_STATUS_REF?.Code == "CANCELLED" ? "danger" : Model.DOC_DOCUMENT_STATUS_REF?.Code == "FOR_APPROVAL" ? "warning" : "info")">
                                                            @(Model.DOC_DOCUMENT_STATUS_REF?.Name ?? "-")
                                                        </span>
                                                        @if (changePermit && Model.DOC_DOCUMENT_STATUS_REF?.Code != "APPROVED" && Model.DOC_DOCUMENT_STATUS_REF?.Code != "CANCELLED")
                                                        {
                                                            <div class="mt-2">
                                                                @if (Model.DOC_DOCUMENT_STATUS_REF?.Code == "DRAFT")
                                                                {
                                                                    <form method="post" action="@Url.Action("ChangeStatus", new { id = Model.ID })" style="display:inline;">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="statusCode" value="FOR_APPROVAL" />
                                                                        <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('@L.Js("Doc_ConfirmSendApproval")');">
                                                                            <i class="bx bx-send"></i> @L.T("Doc_SendForApproval")
                                                                        </button>
                                                                    </form>
                                                                    <form method="post" action="@Url.Action("ChangeStatus", new { id = Model.ID })" style="display:inline;">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="statusCode" value="APPROVED" />
                                                                        <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('@L.Js("Doc_ConfirmApproveDirect")');">
                                                                            <i class="bx bx-check"></i> @L.T("Approve")
                                                                        </button>
                                                                    </form>
                                                                }
                                                                @if (Model.DOC_DOCUMENT_STATUS_REF?.Code == "FOR_APPROVAL")
                                                                {
                                                                    <form method="post" action="@Url.Action("ChangeStatus", new { id = Model.ID })" style="display:inline;">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="statusCode" value="APPROVED" />
                                                                        <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('@L.Js("Doc_ConfirmApprove")');">
                                                                            <i class="bx bx-check"></i> @L.T("Approve")
                                                                        </button>
                                                                    </form>
                                                                }
                                                                <form method="post" action="@Url.Action("ChangeStatus", new { id = Model.ID })" style="display:inline;">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="statusCode" value="CANCELLED" />
                                                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('@L.Js("Doc_ConfirmReject")');">
                                                                        <i class="bx bx-x"></i> @L.T("Reject")
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        }
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Doc_Title")</th>
                                                    <td>@Model.Title</td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col-md-6">
                                            <h5>@L.T("Doc_Text")</h5>
                                            <div class="border p-3" style="min-height: 200px;">
                                                @Html.Partial("_SafeHtml", order.Notes?.Replace("\n", "<br/>") ?? "")
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <h5>@L.T("Doc_GeneratedDocs")</h5>
                                            @if (files != null && files.Any())
                                            {
                                                <table class="table">
                                                    <thead>
                                                        <tr>
                                                            <th>@L.T("Doc_Version")</th>
                                                            <th>@L.T("Doc_FileName")</th>
                                                            <th>@L.T("CreatedAt")</th>
                                                            <th>@L.T("Actions")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var file in files)
                                                        {
                                                            <tr>
                                                                <td>@file.VersionNo</td>
                                                                <td>@file.FileName</td>
                                                                <td>@file.CreatedDT.ToString("dd.MM.yyyy HH:mm")</td>
                                                                <td>
                                                                    <a href="@Url.Action("DownloadFile", new { fileId = file.ID })" class="btn btn-sm btn-primary" style="color: white !important;">
                                                                        <i class="bx bx-download"></i> @L.T("Download")
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                            else
                                            {
                                                <div class="alert alert-danger" role="alert">
                                                    <i class="bx bx-error"></i> <strong>@L.T("Doc_NoFile")</strong> - @L.T("Doc_OrderNoDocument")
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                                <i class="bx bx-arrow-back"></i> @L.T("Back")
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

