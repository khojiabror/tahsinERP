@model tahsinERP.ViewModels.CompanyOrderEditVm
@{
    ViewBag.Title = "Buyruqni Tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Kompaniya Buyruqlari</a></li>
                                    <li class="breadcrumb-item active">Tahrirlash</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Edit", "CompanyOrders", FormMethod.Post, new { @class = "form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(m => m.DocumentId)
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.OrderNo, new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.OrderNo, new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.OrderNo, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.OrderDate, new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.OrderDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                                                    @Html.ValidationMessageFor(m => m.OrderDate, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.OrderTypeCode, new { @class = "control-label" })
                                                    @Html.DropDownListFor(m => m.OrderTypeCode, Model.OrderTypes, "Tanlang", new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.OrderTypeCode, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.OrgUnitId, new { @class = "control-label" })
                                                    @Html.DropDownListFor(m => m.OrgUnitId, Model.OrgUnits, "Tanlang", new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.OrgUnitId, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Title, new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control", @id = "TopicInput" })
                                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label">Matn</label>
                                            <div class="text-right mb-1">
                                                <button type="button" class="btn btn-sm btn-info" id="btnSuggestText">
                                                    <i class="bx bx-bulb"></i> Matn taklif qilish
                                                </button>
                                            </div>
                                            <div id="order-body-toolbar">
                                                <span class="ql-formats">
                                                    <select class="ql-font"></select>
                                                    <select class="ql-size"></select>
                                                </span>
                                                <span class="ql-formats">
                                                    <button class="ql-bold"></button>
                                                    <button class="ql-italic"></button>
                                                    <button class="ql-underline"></button>
                                                    <button class="ql-strike"></button>
                                                </span>
                                                <span class="ql-formats">
                                                    <select class="ql-color"></select>
                                                    <select class="ql-background"></select>
                                                </span>
                                                <span class="ql-formats">
                                                    <button class="ql-header" value="1"></button>
                                                    <button class="ql-header" value="2"></button>
                                                </span>
                                                <span class="ql-formats">
                                                    <button class="ql-list" value="ordered"></button>
                                                    <button class="ql-list" value="bullet"></button>
                                                    <button class="ql-indent" value="-1"></button>
                                                    <button class="ql-indent" value="+1"></button>
                                                </span>
                                                <span class="ql-formats">
                                                    <select class="ql-align"></select>
                                                </span>
                                                <span class="ql-formats">
                                                    <button class="ql-link"></button>
                                                    <button class="ql-clean"></button>
                                                </span>
                                            </div>
                                            <div id="order-body-editor" style="height: 300px; background: white;"></div>
                                            @Html.HiddenFor(m => m.BodyText, new { @id = "BodyTextHidden" })
                                            @Html.ValidationMessageFor(m => m.BodyText, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="bx bx-save"></i> Saqlash
                                            </button>
                                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                                <i class="bx bx-x"></i> Bekor qilish
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@section scripts
{
    @if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
    {
        <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
        <style>
            #order-body-toolbar { border: 1px solid #ddd; border-bottom: none; background: #f8f9fa; }
            #order-body-editor { border: 1px solid #ddd; }
            .ql-editor { min-height: 250px; }
        </style>
        <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
        <script>
            function initOrderEditor() {
                if (typeof jQuery === 'undefined' || typeof window.Quill === 'undefined') {
                    setTimeout(initOrderEditor, 100);
                    return;
                }
                var $ = jQuery;
                $(document).ready(function () {
                    var quill = new Quill('#order-body-editor', {
                        modules: { toolbar: '#order-body-toolbar' },
                        theme: 'snow',
                        placeholder: 'Buyruq matnini kiriting...'
                    });

                    var initialBody = $('#BodyTextHidden').val();
                    if (initialBody && initialBody.trim() !== '') {
                        quill.clipboard.dangerouslyPasteHTML(initialBody);
                    }

                    $('form.form').on('submit', function () {
                        var html = quill.root.innerHTML;
                        if (quill.getText().trim() === '') { html = ''; }
                        $('#BodyTextHidden').val(html);
                    });

                    $('#btnSuggestText').click(function () {
                        var $btn = $(this);
                        var originalText = $btn.html();
                        $btn.prop('disabled', true).html('<i class="bx bx-loader-alt bx-spin"></i> Kutilmoqda...');

                        $.ajax({
                            url: '@Url.Action("SuggestText", "CompanyOrders")',
                            type: 'POST',
                            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                            data: {
                                orderTypeCode: $('#OrderTypeCode').val() || '',
                                orderDate: $('#OrderDate').val() || null,
                                orgUnitId: $('#OrgUnitId').val() || null,
                                topic: $('#TopicInput').val() || '',
                                employeeNames: []
                            },
                            success: function (response) {
                                if (response && response.success) {
                                    quill.setText(response.text || '');
                                } else {
                                    alert('Xatolik: ' + (response ? response.error : 'Noma\'lum xatolik'));
                                }
                            },
                            error: function (xhr, status, error) {
                                console.error('AJAX Error:', error, xhr.responseText);
                                var errorMsg = 'Xatolik yuz berdi';
                                if (xhr.responseJSON && xhr.responseJSON.error) { errorMsg = xhr.responseJSON.error; }
                                else if (xhr.responseText) { errorMsg = xhr.responseText; }
                                alert(errorMsg);
                            },
                            complete: function () {
                                $btn.prop('disabled', false).html(originalText);
                            }
                        });
                    });
                });
            }
            initOrderEditor();
        </script>
    }
}

