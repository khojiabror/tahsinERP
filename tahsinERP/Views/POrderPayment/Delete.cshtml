@model tahsinERP.Models.P_ORDER_PAYMENTS
@{
    ViewBag.Title = "O'chirish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Delete", "POrderPayment", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item ">
                                            <a href="~/POrderPayment">Buyurtma to'lovlari</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            Buyurtma to'lovini ni o'chirib yuborish
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <!-- app invoice View Page -->
                    <section class="invoice-edit-wrapper">
                        <div class="row">
                            <!-- invoice view page -->
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            <div class="row invoice-info">
                                                <div class="col-lg-12 col-md-6 mt-25">
                                                    <h4 class="text-primary">Xarid to'lovi ma'lumotlari</h4>
                                                    <hr />
                                                    <span><b>Ta'minotchi</b>: @Html.DisplayFor(model => model.SUPPLIER.Name, new { @class = "form-control" })</span>
                                                    <br />
                                                    <span><b>Miqdori</b>: @Html.DisplayFor(model => model.Payment_Amount, new { @class = "form-control" }) @Model.CURRENCy.Shortname</span>
                                                    <hr />
                                                    <span><b>Izoh</b>: @Html.DisplayFor(model => model.Comment, new { @class = "form-control" })</span>
                                                    <br />
                                                    <section>
                                                        <div>
                                                            <h6 class="text-primary">Buyurtma ma'lumotlari</h6>
                                                            <span><b>Buyurtma raqami</b>: @Html.DisplayFor(model => model.P_ORDERS.OrderNo, new { @class = "form-control" })</span>
                                                            <br />
                                                            <span>Buyurtma sanasi:<b> @Model.P_ORDERS.IssuedDate.ToString("dd.MM.yyyy")</b></span>
                                                            <br />
                                                        </div>
                                                    </section>
                                                </div>
                                                <ul class="list-group list-group-flush">
                                                    <li class="list-group-item border-0 pb-0">
                                                        <button class="btn btn-danger bg-light btn-block subtotal-preview-btn" name="delete" type="submit" value="Delete" onclick="return confirm('Ushbu Buyurtma to\'lovini o\'chirib yuborishga ishonchingiz komilmi?')">
                                                            <i class='bx bx-trash'></i>
                                                            O'chirish
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                            <hr>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}