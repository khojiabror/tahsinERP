@{
    ViewBag.Title = L.T("Crm_RepSalesReports");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                            <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                            <li class="breadcrumb-item"><a href="~/SOrder/Index">@L.T("Menu_Sales")</a></li>
                            <li class="breadcrumb-item active">@L.T("Reports")</li>
                        </ol>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <h4 class="mb-3">@L.T("Crm_RepSalesReports")</h4>
                        <p class="text-muted">@L.T("Crm_RepIndexIntro")</p>
                    </div>
                </div>
                <div class="row match-height">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <i class="bx bx-calendar font-large-2 text-primary mb-1"></i>
                                <h5 class="card-title">@L.T("Menu_MonthlySalesReport")</h5>
                                <p class="card-text text-muted small">@L.T("Crm_RepMonthlyDesc")</p>
                                <a href="@Url.Action("MonthlyReport")" class="btn btn-primary">@L.T("Crm_RepOpen")</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <i class="bx bx-user font-large-2 text-success mb-1"></i>
                                <h5 class="card-title">@L.T("Menu_SalesByCustomer")</h5>
                                <p class="card-text text-muted small">@L.T("Crm_RepByCustomerDesc")</p>
                                <a href="@Url.Action("SalesByCustomer")" class="btn btn-success">@L.T("Crm_RepOpen")</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <i class="bx bx-package font-large-2 text-info mb-1"></i>
                                <h5 class="card-title">@L.T("Menu_SalesByProduct")</h5>
                                <p class="card-text text-muted small">@L.T("Crm_RepByProductDesc")</p>
                                <a href="@Url.Action("SalesByProduct")" class="btn btn-info">@L.T("Crm_RepOpen")</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
