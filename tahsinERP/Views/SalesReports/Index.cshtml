@{
    ViewBag.Title = "Sotuv hisobotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "SalesReports") ||
     tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "SOrder") ||
     tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "SalesInvoices"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                            <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                            <li class="breadcrumb-item"><a href="~/SOrder/Index">Sotuvlar</a></li>
                            <li class="breadcrumb-item active">Hisobotlar</li>
                        </ol>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <h4 class="mb-3">Sotuv hisobotlari</h4>
                        <p class="text-muted">Ma'lumotlar mavjud buyurtma va invoyslar asosida hisoblanadi. Chop etish uchun har bir hisobot sahifasida «Chop etish» tugmasidan foydalaning.</p>
                    </div>
                </div>
                <div class="row match-height">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <i class="bx bx-calendar font-large-2 text-primary mb-1"></i>
                                <h5 class="card-title">Oylik savdo hisoboti</h5>
                                <p class="card-text text-muted small">Bir oy davomida har bir mahsulotdan qancha buyurtma qilindi va qanchasi sotildi (invoys). Savdo xodimi qo'l qo'yadi, rahbariyatga topshiradi.</p>
                                <a href="@Url.Action("MonthlyReport")" class="btn btn-primary">Ochish</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <i class="bx bx-user font-large-2 text-success mb-1"></i>
                                <h5 class="card-title">Mijoz bo'yicha sotuv</h5>
                                <p class="card-text text-muted small">Tanlangan davr bo'yicha xaridorlar kesimida buyurtma va sotuv (invoys) summasi.</p>
                                <a href="@Url.Action("SalesByCustomer")" class="btn btn-success">Ochish</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <i class="bx bx-package font-large-2 text-info mb-1"></i>
                                <h5 class="card-title">Mahsulot bo'yicha sotuv</h5>
                                <p class="card-text text-muted small">Tanlangan davr bo'yicha mahsulotlar kesimida buyurtma va sotuv, konversiya foizi.</p>
                                <a href="@Url.Action("SalesByProduct")" class="btn btn-info">Ochish</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
