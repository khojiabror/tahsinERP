@model tahsinERP.ViewModels.MonthlySalesReportViewModel
@{
    ViewBag.Title = "Oylik savdo hisoboti";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var year = ViewBag.Year as int? ?? DateTime.Now.Year;
    var month = ViewBag.Month as int? ?? DateTime.Now.Month;
    var months = ViewBag.Months as IEnumerable<SelectListItem>;
    var years = ViewBag.Years as IEnumerable<SelectListItem>;
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "SalesReports") ||
     tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "SOrder") ||
     tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "SalesInvoices"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                            <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                            <li class="breadcrumb-item"><a href="~/SalesReports">Sotuv hisobotlari</a></li>
                            <li class="breadcrumb-item active">Oylik savdo hisoboti</li>
                        </ol>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row mb-2 no-print">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <form method="get" action="@Url.Action("MonthlyReport")" class="row align-items-end">
                                    <div class="col-md-2">
                                        <label class="form-label">Yil</label>
                                        @if (years != null)
                                        {
                                            <select name="year" class="form-control">@foreach (var y in years) { <option value="@y.Value" selected="@y.Selected">@y.Text</option> }</select>
                                        }
                                        else
                                        {
                                            <input type="number" name="year" class="form-control" value="@year" min="2020" max="2030" />
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Oy</label>
                                        @if (months != null)
                                        {
                                            <select name="month" class="form-control">@foreach (var m in months) { <option value="@m.Value" selected="@m.Selected">@m.Text</option> }</select>
                                        }
                                        else
                                        {
                                            <input type="number" name="month" class="form-control" value="@month" min="1" max="12" />
                                        }
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-primary"><i class="bx bx-refresh"></i> Ko'rsatish</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-2 no-print">
                    <div class="col-12 text-right">
                        <button type="button" id="btnPrintReport" class="btn btn-primary">
                            <i class="bx bx-printer"></i> Chop etish
                        </button>
                    </div>
                </div>

                <div class="card" id="printArea" data-print-target="true">
                    <div class="card-body report-document">
                        <div class="report-header text-center mb-4">
                            <h5 class="mb-0 font-weight-bold">@(Model.CompanyName ?? "Tahsin ERP")</h5>
                            <h6 class="text-uppercase mt-2 mb-0" style="letter-spacing: 0.05em;">Oylik savdo hisoboti</h6>
                            <p class="mb-0 mt-1 text-muted">@Model.MonthName @Model.Year yil</p>
                            <p class="mb-0 small text-muted">Buyurtmalar: @Model.TotalOrderCount ta | Invoyslar: @Model.TotalInvoiceCount ta</p>
                        </div>

                        <table class="table table-bordered table-sm report-table">
                            <thead>
                                <tr class="table-light">
                                    <th style="width: 2%;">№</th>
                                    <th style="width: 10%;">Mahsulot kodi</th>
                                    <th style="width: 22%;">Mahsulot nomi</th>
                                    <th style="width: 6%;">O'lchov</th>
                                    <th style="width: 10%;" class="text-right">Buyurtma miqdori</th>
                                    <th style="width: 12%;" class="text-right">Buyurtma summa</th>
                                    <th style="width: 10%;" class="text-right">Sotilgan miqdor</th>
                                    <th style="width: 12%;" class="text-right">Sotuv summa</th>
                                    <th style="width: 8%;" class="text-right">Konversiya %</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int no = 1; }
                                @if (Model.Lines != null && Model.Lines.Any())
                                {
                                    foreach (var line in Model.Lines)
                                    {
                                        <tr>
                                            <td>@no</td>
                                            <td>@line.ProductCode</td>
                                            <td>@line.ProductName</td>
                                            <td>@line.UnitName</td>
                                            <td class="text-right">@line.OrderQty.ToString("N2")</td>
                                            <td class="text-right">@line.OrderAmount.ToString("N0")</td>
                                            <td class="text-right">@line.SoldQty.ToString("N2")</td>
                                            <td class="text-right">@line.SoldAmount.ToString("N0")</td>
                                            <td class="text-right">@line.ConversionPercent.ToString("N1")</td>
                                        </tr>
                                        no++;
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="9" class="text-center text-muted">Shu oy uchun ma'lumot topilmadi.</td></tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td colspan="4" class="text-right">JAMI:</td>
                                    <td class="text-right">@(Model.Lines?.Sum(l => l.OrderQty).ToString("N2") ?? "0")</td>
                                    <td class="text-right">@(Model.Lines?.Sum(l => l.OrderAmount).ToString("N0") ?? "0")</td>
                                    <td class="text-right">@(Model.Lines?.Sum(l => l.SoldQty).ToString("N2") ?? "0")</td>
                                    <td class="text-right">@(Model.Lines?.Sum(l => l.SoldAmount).ToString("N0") ?? "0")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="report-signatures mt-5 pt-4">
                            <div class="row">
                                <div class="col-6">
                                    <p class="mb-1"><strong>Savdo xodimi:</strong></p>
                                    <p class="mb-0" style="border-bottom: 1px solid #333; width: 220px; height: 24px;"></p>
                                    <p class="small text-muted mt-1">Qo'l qo'yildi</p>
                                </div>
                                <div class="col-6 text-right">
                                    <p class="mb-1"><strong>Rahbariyat:</strong></p>
                                    <p class="mb-0 d-inline-block text-right" style="border-bottom: 1px solid #333; width: 220px; height: 24px;"></p>
                                    <p class="small text-muted mt-1">Tasdiqlandi</p>
                                </div>
                            </div>
                            <p class="small text-muted mt-3 mb-0">Sana: @DateTime.Now.ToString("dd.MM.yyyy") | Hisobot dinamik ma'lumotlar asosida tuzildi.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var btn = document.getElementById('btnPrintReport');
            if (btn) {
                btn.addEventListener('click', function() {
                    var el = document.getElementById('printArea');
                    if (!el) { window.print(); return; }
                    var w = window.open('', '_blank');
                    w.document.write('<!DOCTYPE html><html><head><meta charset="utf-8"><title>Chop etish</title><style>body{font-family:Arial,sans-serif;margin:12px;background:#fff;color:#111}.report-table{font-size:10px;width:100%;border-collapse:collapse}.report-table th,.report-table td{border:1px solid #333;padding:4px 6px}.report-table thead th{background:#f5f5f5}.report-signatures .row{page-break-inside:avoid}@@media print{body{margin:0;padding:8px}}</style></head><body>' + el.innerHTML + '</body></html>');
                    w.document.close();
                    w.focus();
                    setTimeout(function() { w.print(); w.close(); }, 250);
                });
            }
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
