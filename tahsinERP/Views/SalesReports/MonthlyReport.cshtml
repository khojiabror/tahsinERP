@model tahsinERP.ViewModels.MonthlySalesReportViewModel
@{
    ViewBag.Title = L.T("Menu_MonthlySalesReport");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var year = ViewBag.Year as int? ?? DateTime.Now.Year;
    var month = ViewBag.Month as int? ?? DateTime.Now.Month;
    var months = ViewBag.Months as IEnumerable<SelectListItem>;
    var years = ViewBag.Years as IEnumerable<SelectListItem>;
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                            <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                            <li class="breadcrumb-item"><a href="~/SalesReports">@L.T("Crm_RepSalesReports")</a></li>
                            <li class="breadcrumb-item active">@L.T("Menu_MonthlySalesReport")</li>
                        </ol>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="alert alert-light border mb-1 py-50 no-print">@L.T("Crm_RepAmountsInUzsNote")</div>
                @if (ViewBag.CurrencyWarning != null)
                {
                    <div class="alert alert-warning mb-1 no-print">@ViewBag.CurrencyWarning</div>
                }
                <div class="row mb-2 no-print">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <form method="get" action="@Url.Action("MonthlyReport")" class="row align-items-end">
                                    <div class="col-md-2">
                                        <label class="form-label">@L.T("Crm_RepYear")</label>
                                        @if (years != null)
                                        {
                                            <select name="year" class="form-control">@foreach (var y in years) { <option value="@y.Value" selected="@y.Selected">@y.Text</option> }</select>
                                        }
                                        else
                                        {
                                            <input type="number" name="year" class="form-control" value="@year" min="2020" max="2030" />
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">@L.T("Crm_RepMonth")</label>
                                        @if (months != null)
                                        {
                                            <select name="month" class="form-control">@foreach (var m in months) { <option value="@m.Value" selected="@m.Selected">@m.Text</option> }</select>
                                        }
                                        else
                                        {
                                            <input type="number" name="month" class="form-control" value="@month" min="1" max="12" />
                                        }
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-primary"><i class="bx bx-refresh"></i> @L.T("Crm_RepShow")</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-2 no-print">
                    <div class="col-12 text-right">
                        <button type="button" id="btnPrintReport" data-print-area="printArea" class="btn btn-primary">
                            <i class="bx bx-printer"></i> @L.T("Print")
                        </button>
                    </div>
                </div>

                <div class="card" id="printArea" data-print-target="true">
                    <div class="card-body report-document">
                        <div class="report-header text-center mb-4">
                            <h5 class="mb-0 font-weight-bold">@(Model.CompanyName ?? "Tahsin ERP")</h5>
                            <h6 class="text-uppercase mt-2 mb-0" style="letter-spacing: 0.05em;">@L.T("Menu_MonthlySalesReport")</h6>
                            <p class="mb-0 mt-1 text-muted">@L.T("Crm_RepMonthYear", Model.MonthName, Model.Year)</p>
                            <p class="mb-0 small text-muted">@L.T("Crm_RepOrderInvoiceCounts", Model.TotalOrderCount, Model.TotalInvoiceCount)</p>
                        </div>

                        <table class="table table-bordered table-sm report-table">
                            <thead>
                                <tr class="table-light">
                                    <th style="width: 2%;">№</th>
                                    <th style="width: 10%;">@L.T("Crm_ProductCode")</th>
                                    <th style="width: 22%;">@L.T("Crm_ProductName")</th>
                                    <th style="width: 6%;">@L.T("Crm_RepUnit")</th>
                                    <th style="width: 10%;" class="text-right">@L.T("Crm_OrderQty")</th>
                                    <th style="width: 12%;" class="text-right">@L.T("Crm_RepOrderAmount")</th>
                                    <th style="width: 10%;" class="text-right">@L.T("Crm_RepSoldQty")</th>
                                    <th style="width: 12%;" class="text-right">@L.T("Crm_RepSalesAmount")</th>
                                    <th style="width: 8%;" class="text-right">@L.T("Crm_RepConversionPct")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int no = 1; }
                                @if (Model.Lines != null && Model.Lines.Any())
                                {
                                    foreach (var line in Model.Lines)
                                    {
                                        <tr>
                                            <td>@no</td>
                                            <td>@line.ProductCode</td>
                                            <td>@line.ProductName</td>
                                            <td>@line.UnitName</td>
                                            <td class="text-right">@line.OrderQty.ToString("N2")</td>
                                            <td class="text-right">@line.OrderAmount.ToString("N0")</td>
                                            <td class="text-right">@line.SoldQty.ToString("N2")</td>
                                            <td class="text-right">@line.SoldAmount.ToString("N0")</td>
                                            <td class="text-right">@line.ConversionPercent.ToString("N1")</td>
                                        </tr>
                                        no++;
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="9" class="text-center text-muted">@L.T("Crm_RepNoDataMonth")</td></tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td colspan="4" class="text-right">@L.T("Crm_RepTotalCaps")</td>
                                    <td class="text-right">@(Model.Lines?.Sum(l => l.OrderQty).ToString("N2") ?? "0")</td>
                                    <td class="text-right">@(Model.Lines?.Sum(l => l.OrderAmount).ToString("N0") ?? "0")</td>
                                    <td class="text-right">@(Model.Lines?.Sum(l => l.SoldQty).ToString("N2") ?? "0")</td>
                                    <td class="text-right">@(Model.Lines?.Sum(l => l.SoldAmount).ToString("N0") ?? "0")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="report-signatures mt-5 pt-4">
                            <div class="row">
                                <div class="col-6">
                                    <p class="mb-1"><strong>@L.T("Crm_RepSalesEmployee")</strong></p>
                                    <p class="mb-0" style="border-bottom: 1px solid #333; width: 220px; height: 24px;"></p>
                                    <p class="small text-muted mt-1">@L.T("Crm_RepSigned")</p>
                                </div>
                                <div class="col-6 text-right">
                                    <p class="mb-1"><strong>@L.T("Crm_RepManagement")</strong></p>
                                    <p class="mb-0 d-inline-block text-right" style="border-bottom: 1px solid #333; width: 220px; height: 24px;"></p>
                                    <p class="small text-muted mt-1">@L.T("Crm_RepApproved")</p>
                                </div>
                            </div>
                            <p class="small text-muted mt-3 mb-0">@L.T("Crm_RepDateLabel") @DateTime.Now.ToString("dd.MM.yyyy") | @L.T("Crm_RepDynamicNote")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="@Url.Content("~/Scripts/crm/print-area.js")"></script>
}
