@model tahsinERP.ViewModels.SalesByCustomerReportViewModel
@{
    ViewBag.Title = L.T("Menu_SalesByCustomer");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fromDate = ViewBag.FromDate as DateTime? ?? Model.FromDate;
    var toDate = ViewBag.ToDate as DateTime? ?? Model.ToDate;
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                            <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                            <li class="breadcrumb-item"><a href="~/SalesReports">@L.T("Crm_RepSalesReports")</a></li>
                            <li class="breadcrumb-item active">@L.T("Menu_SalesByCustomer")</li>
                        </ol>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="alert alert-light border mb-1 py-50 no-print">@L.T("Crm_RepAmountsInUzsNote")</div>
                @if (ViewBag.CurrencyWarning != null)
                {
                    <div class="alert alert-warning mb-1 no-print">@ViewBag.CurrencyWarning</div>
                }
                <div class="row mb-2 no-print">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <form method="get" action="@Url.Action("SalesByCustomer")" class="row align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label">@L.T("Crm_From")</label>
                                        <input type="date" name="fromDate" class="form-control" value="@fromDate.ToString("yyyy-MM-dd")" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">@L.T("Crm_To")</label>
                                        <input type="date" name="toDate" class="form-control" value="@toDate.ToString("yyyy-MM-dd")" />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-primary"><i class="bx bx-refresh"></i> @L.T("Crm_RepShow")</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-2 no-print">
                    <div class="col-12 text-right">
                        <button type="button" id="btnPrintReport" data-print-area="printArea" class="btn btn-primary"><i class="bx bx-printer"></i> @L.T("Print")</button>
                    </div>
                </div>

                <div class="card" id="printArea" data-print-target="true">
                    <div class="card-body report-document">
                        <div class="report-header text-center mb-4">
                            <h5 class="mb-0 font-weight-bold">@(Model.CompanyName ?? "Tahsin ERP")</h5>
                            <h6 class="text-uppercase mt-2 mb-0">@L.T("Crm_RepByCustomerTitle")</h6>
                            <p class="mb-0 mt-1 text-muted">@fromDate.ToString("dd.MM.yyyy") — @toDate.ToString("dd.MM.yyyy")</p>
                        </div>
                        <table class="table table-bordered table-sm report-table">
                            <thead>
                                <tr class="table-light">
                                    <th style="width: 3%;">№</th>
                                    <th>@L.T("Crm_Customer")</th>
                                    <th class="text-right" style="width: 10%;">@L.T("Crm_RepOrderCount")</th>
                                    <th class="text-right" style="width: 12%;">@L.T("Crm_RepOrderTotal")</th>
                                    <th class="text-right" style="width: 10%;">@L.T("Crm_RepInvoiceCount")</th>
                                    <th class="text-right" style="width: 12%;">@L.T("Crm_RepSalesTotal")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int no = 1; }
                                @if (Model.Lines != null && Model.Lines.Any())
                                {
                                    foreach (var line in Model.Lines)
                                    {
                                        <tr>
                                            <td>@no</td>
                                            <td>@line.CustomerName</td>
                                            <td class="text-right">@line.OrderCount</td>
                                            <td class="text-right">@line.TotalOrderAmount.ToString("N0")</td>
                                            <td class="text-right">@line.InvoiceCount</td>
                                            <td class="text-right">@line.TotalInvoiceAmount.ToString("N0")</td>
                                        </tr>
                                        no++;
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="6" class="text-center text-muted">@L.T("Crm_RepNoData")</td></tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light font-weight-bold">
                                    <td colspan="5" class="text-right">@L.T("Crm_RepTotalSalesCaps")</td>
                                    <td class="text-right">@Model.TotalAmount.ToString("N0")</td>
                                </tr>
                            </tfoot>
                        </table>
                        <p class="small text-muted mt-3 mb-0">@L.T("Crm_RepDateLabel") @DateTime.Now.ToString("dd.MM.yyyy")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="@Url.Content("~/Scripts/crm/print-area.js")"></script>
}
