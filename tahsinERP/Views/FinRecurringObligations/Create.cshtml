@model tahsinERP.Controllers.Finance.RecurringObligationViewModel
@{
    ViewBag.Title = "Doimiy harajat qo'shish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinDashboard"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Doimiy harajatlar</a></li>
                                    <li class="breadcrumb-item active">Yangi qo'shish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Doimiy harajat qo'shish (ijara, buxgalteriya va h.k.)</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Create", "FinRecurringObligations", FormMethod.Post, new { @class = "form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Name, "Nomi *", new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Masalan: Ijara haqi, Buxgalteriya xizmati", required = "required" })
                                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.MonthlyAmount, "Oylik summa *", new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.MonthlyAmount, new { @class = "form-control", type = "number", step = "0.01", required = "required" })
                                            @Html.ValidationMessageFor(m => m.MonthlyAmount, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.CurrencyID, "Valyuta", new { @class = "control-label" })
                                            @Html.DropDownListFor(m => m.CurrencyID, ViewBag.CurrencyID as SelectList, new { @class = "form-control" })
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.StartYear, "Boshlash yili", new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.StartYear, new { @class = "form-control", type = "number", min = "2020", max = "2030" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.StartMonth, "Boshlash oyi", new { @class = "control-label" })
                                                    @Html.DropDownListFor(m => m.StartMonth, Enumerable.Range(1, 12).Select(m => new SelectListItem { Value = m.ToString(), Text = new DateTime(2000, m, 1).ToString("MMMM") }), new { @class = "form-control" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.BalanceCategoryID, "Balans kategoriyasi (Passivlar)", new { @class = "control-label" })
                                            @Html.DropDownListFor(m => m.BalanceCategoryID, ViewBag.BalanceCategoryID as SelectList, "-Tanlamaslik (Doimiy harajatlar qarzi)", new { @class = "form-control" })
                                            <small class="form-text text-muted">Odatda "Doimiy harajatlar qarzi" ni tanlang (balansda shu ostida ko'rsatiladi).</small>
                                        </div>
                                        <div class="form-group">
                                            <div class="custom-control custom-checkbox">
                                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "custom-control-input" })
                                                @Html.LabelFor(m => m.IsActive, "Faol", new { @class = "custom-control-label" })
                                            </div>
                                        </div>
                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-primary">Saqlash</button>
                                            <a href="@Url.Action("Index")" class="btn btn-secondary">Bekor qilish</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
