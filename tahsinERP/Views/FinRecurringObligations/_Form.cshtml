@model tahsinERP.Controllers.Finance.RecurringObligationViewModel
@* Create/Edit umumiy forma maydonlari (FIN-D21). ViewData["IsCreate"] = true — yaratish. *@
@{
    var isCreate = ViewData["IsCreate"] as bool? ?? false;
}

<div class="form-group">
    @Html.LabelFor(m => m.Name, L.T("Name") + " *", new { @class = "control-label" })
    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = L.T("Fin_RecurringNamePh"), required = "required" })
    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
</div>
<div class="form-group">
    @Html.LabelFor(m => m.MonthlyAmount, L.T("Fin_MonthlyAmount") + " *", new { @class = "control-label" })
    @Html.TextBoxFor(m => m.MonthlyAmount, new { @class = "form-control", type = "number", step = "0.01", required = "required" })
    @Html.ValidationMessageFor(m => m.MonthlyAmount, "", new { @class = "text-danger" })
</div>
<div class="form-group">
    @Html.LabelFor(m => m.CurrencyID, L.T("Currency"), new { @class = "control-label" })
    @Html.DropDownListFor(m => m.CurrencyID, ViewBag.CurrencyID as SelectList, new { @class = "form-control" })
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            @Html.LabelFor(m => m.StartYear, L.T("Fin_StartYear"), new { @class = "control-label" })
            @Html.TextBoxFor(m => m.StartYear, new { @class = "form-control", type = "number", min = "2020", max = "2030" })
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            @Html.LabelFor(m => m.StartMonth, L.T("Fin_StartMonth"), new { @class = "control-label" })
            @Html.DropDownListFor(m => m.StartMonth, Enumerable.Range(1, 12).Select(m => new SelectListItem { Value = m.ToString(), Text = new DateTime(2000, m, 1).ToString("MMMM") }), new { @class = "form-control" })
        </div>
    </div>
</div>
<div class="form-group">
    @Html.LabelFor(m => m.BalanceCategoryID, L.T("Fin_BalanceCategoryLiabilities"), new { @class = "control-label" })
    @Html.DropDownListFor(m => m.BalanceCategoryID, ViewBag.BalanceCategoryID as SelectList, L.T("Fin_NoSelectRecurringDebt"), new { @class = "form-control" })
    <small class="form-text text-muted">@L.T("Fin_RecurringCatHint")</small>
</div>
<div class="form-group">
    <div class="custom-control custom-checkbox">
        @Html.CheckBoxFor(m => m.IsActive, new { @class = "custom-control-input" })
        @Html.LabelFor(m => m.IsActive, L.T("Active"), new { @class = "custom-control-label" })
    </div>
</div>
