@model List<tahsinERP.Controllers.Finance.RecurringObligationViewModel>
@{
    ViewBag.Title = "Doimiy harajatlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinDashboard");
}

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("BalanceSheet", "FinDashboard")">Moliya</a></li>
                                    <li class="breadcrumb-item active">Doimiy harajatlar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-warning">@ViewBag.Error</div>
                }
                <p class="text-muted">
                    Bu ro'yxatdagi harajatlar har oy balansda "Doimiy harajatlar qarzi" sifatida shakllanadi. To'lovni
                    <a href="@Url.Action("Index", "FinTransactions")">Tranzaksiyalar</a> orqali kiritganda <strong>Manba hujjat turi</strong> = <code>RecurringObligationPayment</code>, <strong>Manba hujjat ID</strong> = quyidagi majburiyat ID sini kiriting.
                </p>
                @if (changePermit)
                {
                    <div class="mb-1">
                        <a href="@Url.Action("Create")" class="btn btn-outline-success">Doimiy harajat qo'shish</a>
                        <a href="@Url.Action("BalanceSheet", "FinDashboard")" class="btn btn-outline-primary">Balans hisoboti</a>
                    </div>
                }
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Doimiy harajatlar (ijara, buxgalteriya va h.k.)</h4>
                    </div>
                    <div class="card-content">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Nomi</th>
                                            <th class="text-right">Oylik summa</th>
                                            <th>Valyuta</th>
                                            <th>Boshlash</th>
                                            <th>Balans kategoriyasi</th>
                                            <th>Faol</th>
                                            @if (changePermit) { <th>Amallar</th> }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                            foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.ID</td>
                                                    <td>@item.Name</td>
                                                    <td class="text-right">@item.MonthlyAmount.ToString("N2")</td>
                                                    <td>@(item.CurrencyShortname ?? "")</td>
                                                    <td>@item.StartYear-@item.StartMonth.ToString("D2")</td>
                                                    <td>@(item.BalanceCategoryName ?? "—")</td>
                                                    <td>@(item.IsActive ? "Ha" : "Yo'q")</td>
                                                    @if (changePermit)
                                                    {
                                                        <td>
                                                            @Html.ActionLink("Tahrirlash", "Edit", new { id = item.ID }, new { @class = "btn btn-sm btn-outline-primary" })
                                                            @using (Html.BeginForm("Delete", "FinRecurringObligations", new { id = item.ID }, FormMethod.Post, new { style = "display:inline", onsubmit = "return confirm('O\'chirishni xohlaysizmi?');" }))
                                                            {
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm btn-outline-danger">O'chirish</button>
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="@(changePermit ? 9 : 8)" class="text-center">Ma'lumot yo'q</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
