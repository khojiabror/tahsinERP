@model List<tahsinERP.Controllers.Finance.RecurringObligationViewModel>
@{
    ViewBag.Title = L.T("Fin_RecurringExpenses");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinRecurringObligations");
}

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("BalanceSheet", "FinDashboard")">@L.T("Menu_Finance")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Fin_RecurringExpenses")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-warning">@ViewBag.Error</div>
                }
                <p class="text-muted">
                    @L.T("Fin_RecurringInfo1")
                    <a href="@Url.Action("Index", "FinTransactions")">@L.T("Fin_Transactions")</a> @L.T("Fin_RecurringInfo2") <strong>@L.T("Fin_SourceDocType")</strong> = <code>RecurringObligationPayment</code>, <strong>@L.T("Fin_SourceDocId")</strong> = @L.T("Fin_RecurringInfo3")
                </p>
                @if (changePermit)
                {
                    <div class="mb-1">
                        <a href="@Url.Action("Create")" class="btn btn-outline-success">@L.T("Fin_AddRecurring")</a>
                        <a href="@Url.Action("BalanceSheet", "FinDashboard")" class="btn btn-outline-primary">@L.T("Fin_BalanceReport")</a>
                    </div>
                }
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">@L.T("Fin_RecurringExpensesLong")</h4>
                    </div>
                    <div class="card-content">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>@L.T("Name")</th>
                                            <th class="text-right">@L.T("Fin_MonthlyAmount")</th>
                                            <th>@L.T("Currency")</th>
                                            <th>@L.T("Fin_Start")</th>
                                            <th>@L.T("Fin_BalanceCategory")</th>
                                            <th>@L.T("Active")</th>
                                            @if (changePermit) { <th>Amallar</th> }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                            foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.ID</td>
                                                    <td>@item.Name</td>
                                                    <td class="text-right">@item.MonthlyAmount.ToString("N2")</td>
                                                    <td>@(item.CurrencyShortname ?? "")</td>
                                                    <td>@item.StartYear-@item.StartMonth.ToString("D2")</td>
                                                    <td>@(item.BalanceCategoryName ?? "—")</td>
                                                    <td>@(item.IsActive ? L.T("Yes") : L.T("No"))</td>
                                                    @if (changePermit)
                                                    {
                                                        <td>
                                                            @Html.ActionLink(L.T("Edit"), "Edit", new { id = item.ID }, new { @class = "btn btn-sm btn-outline-primary" })
                                                            @using (Html.BeginForm("Delete", "FinRecurringObligations", new { id = item.ID }, FormMethod.Post, new { style = "display:inline", onsubmit = "return confirm('" + L.Js("Fin_ConfirmDeleteQ") + "');" }))
                                                            {
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm btn-outline-danger">@L.T("Delete")</button>
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="@(changePermit ? 9 : 8)" class="text-center">@L.T("NoData")</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
