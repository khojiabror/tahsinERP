@model tahsinERP.ViewModels.Tannarx.TannarxDetailsViewModel

@{
    ViewBag.Title = L.T("Mes_Tan_DeleteTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Tannarx", "Delete"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Tannarx">@L.T("Mes_Tan_Title")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Delete")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="alert alert-warning">
                                        <h5>@L.T("Mes_Tan_Attention")</h5>
                                        <p>@L.T("Mes_Tan_DeleteConfirmText")</p>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-12">
                                            <table class="table table-bordered">
                                                <tr>
                                                    <th style="width: 200px;">@L.T("Mes_ProductNo")</th>
                                                    <td>@Model.ProductPNo</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_ProductName")</th>
                                                    <td>@Model.ProductName</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_Month")</th>
                                                    <td>@Model.MonthString</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <div class="alert alert-danger">
                                        <p><strong>@L.T("Mes_Tan_IrreversibleTitle")</strong></p>
                                        <p>@L.T("Mes_Tan_IrreversibleText")</p>
                                    </div>

                                    @using (Html.BeginForm("Delete", "Tannarx", FormMethod.Post, new { @class = "form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(m => m.ID)

                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-danger">
                                                <i class="bx bx-trash"></i> @L.T("Mes_YesDelete")
                                            </button>
                                            <a href="@Url.Action("Index", "Tannarx", new { year = Model.Year, month = Model.Month })" class="btn btn-secondary">
                                                <i class="bx bx-x"></i> @L.T("Cancel")
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
