@model tahsinERP.ViewModels.Tannarx.TannarxEditViewModel

@{
    ViewBag.Title = L.T("Mes_Tan_EditTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Tannarx", "Edit"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Tannarx">@L.T("Mes_Tan_Title")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Edit")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                <section class="invoice-list-wrapper">
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Edit", "Tannarx", FormMethod.Post, new { @class = "form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(m => m.ID)
                                        @Html.HiddenFor(m => m.ProductID)
                                        @Html.HiddenFor(m => m.Year)
                                        @Html.HiddenFor(m => m.Month)

                                        <div class="row">
                                            <div class="col-md-12">
                                                <h6 class="mb-2">@L.T("Mes_ProductInfo")</h6>
                                                <div class="form-group">
                                                    <label>@L.T("Mes_ProductNo"):</label>
                                                    <input type="text" class="form-control" value="@Model.ProductPNo" readonly />
                                                </div>
                                                <div class="form-group">
                                                    <label>@L.T("Mes_ProductName"):</label>
                                                    <input type="text" class="form-control" value="@Model.ProductName" readonly />
                                                </div>
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Month"):</label>
                                                    <input type="text" class="form-control" value="@Model.MonthString" readonly />
                                                </div>
                                            </div>
                                        </div>

                                        <hr />

                                        <div class="row">
                                            <div class="col-md-12">
                                                <h6 class="mb-2">@L.T("Mes_Tan_MaterialCosts")</h6>
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Tan_MaterialPrice"):</label>
                                                    <input type="text" class="form-control" value="@Model.MaterialPrice.ToString("N0") @L.Sum" readonly />
                                                </div>
                                                <div class="form-group">
                                                    <button type="submit" name="refreshMaterial" value="1" class="btn btn-outline-info btn-sm">
                                                        <i class="bx bx-refresh"></i> @L.T("Mes_Tan_RefreshMaterial")
                                                    </button>
                                                    <small class="form-text text-muted">@L.T("Mes_Tan_RefreshMaterialHint")</small>
                                                </div>
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Tan_MaterialTransport2"):</label>
                                                    <input type="text" class="form-control" value="@Model.MaterialTransportCost.ToString("N0") @L.Sum" readonly />
                                                </div>
                                            </div>
                                        </div>

                                        <hr />

                                        <div class="row">
                                            <div class="col-md-12">
                                                <h6 class="mb-2">@L.T("Mes_Tan_LaborAndExpenses")</h6>
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.LaborCost, new { @class = "form-label" })
                                                    @Html.TextBoxFor(m => m.LaborCost, new { @class = "form-control", @type = "number", @step = "0.01" })
                                                    @Html.ValidationMessageFor(m => m.LaborCost, "", new { @class = "text-danger" })
                                                    <small class="form-text text-muted">@L.T("Mes_Tan_LaborHint")</small>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.TaxAndBankPercent, new { @class = "form-label" })
                                                    @Html.TextBoxFor(m => m.TaxAndBankPercent, new { @class = "form-control", @type = "number", @step = "0.01" })
                                                    @Html.ValidationMessageFor(m => m.TaxAndBankPercent, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Tan_TaxBankB") (@L.Sum):</label>
                                                    <input type="text" class="form-control" value="@Model.TaxAndBank.ToString("N0") @L.Sum" readonly />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.AdministrativeExpensesPercent, new { @class = "form-label" })
                                                    @Html.TextBoxFor(m => m.AdministrativeExpensesPercent, new { @class = "form-control", @type = "number", @step = "0.01" })
                                                    @Html.ValidationMessageFor(m => m.AdministrativeExpensesPercent, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Tan_AdminC") (@L.Sum):</label>
                                                    <input type="text" class="form-control" value="@Model.AdministrativeExpenses.ToString("N0") @L.Sum" readonly />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.OtherExpensesPercent, new { @class = "form-label" })
                                                    @Html.TextBoxFor(m => m.OtherExpensesPercent, new { @class = "form-control", @type = "number", @step = "0.01" })
                                                    @Html.ValidationMessageFor(m => m.OtherExpensesPercent, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Tan_OtherD") (@L.Sum):</label>
                                                    <input type="text" class="form-control" value="@Model.OtherExpenses.ToString("N0") @L.Sum" readonly />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.ProfitPercent, new { @class = "form-label" })
                                                    @Html.TextBoxFor(m => m.ProfitPercent, new { @class = "form-control", @type = "number", @step = "0.01" })
                                                    @Html.ValidationMessageFor(m => m.ProfitPercent, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Tan_ProfitE") (@L.Sum):</label>
                                                    <input type="text" class="form-control" value="@Model.Profit.ToString("N0") @L.Sum" readonly />
                                                </div>
                                            </div>
                                        </div>

                                        <hr />

                                        <div class="row">
                                            <div class="col-md-12">
                                                <h6 class="mb-2">@L.T("Mes_Tan_ExwPrices")</h6>
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Tan_SalesExwNoVat"):</label>
                                                    <input type="text" class="form-control" value="@Model.SalesPriceEXWWithoutVAT.ToString("N0") @L.Sum" readonly />
                                                </div>
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Tan_SalesExwVat"):</label>
                                                    <input type="text" class="form-control" value="@Model.SalesPriceEXWWithVAT.ToString("N0") @L.Sum" readonly />
                                                </div>
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.SetPriceEXWWithVAT, new { @class = "form-label" })
                                                    @Html.TextBoxFor(m => m.SetPriceEXWWithVAT, new { @class = "form-control", @type = "number", @step = "0.01" })
                                                    @Html.ValidationMessageFor(m => m.SetPriceEXWWithVAT, "", new { @class = "text-danger" })
                                                    <small class="form-text text-muted">@L.T("Mes_Tan_SuggestedPriceHint")</small>
                                                </div>
                                            </div>
                                        </div>

                                        <hr />

                                        <div class="row">
                                            <div class="col-md-12">
                                                <h6 class="mb-2">@L.T("Mes_Tan_FinishedTransport")</h6>
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.FinishedProductTransportCost, new { @class = "form-label" })
                                                    @Html.TextBoxFor(m => m.FinishedProductTransportCost, new { @class = "form-control", @type = "number", @step = "0.01" })
                                                    @Html.ValidationMessageFor(m => m.FinishedProductTransportCost, "", new { @class = "text-danger" })
                                                    <small class="form-text text-muted">@L.T("Mes_Tan_TransportHint")</small>
                                                </div>
                                            </div>
                                        </div>

                                        <hr />

                                        <div class="row">
                                            <div class="col-md-12">
                                                <h6 class="mb-2">@L.T("Mes_Tan_CipPrices")</h6>
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Tan_SalesCipNoVat"):</label>
                                                    <input type="text" class="form-control" value="@Model.SalesPriceCIPWithoutVAT.ToString("N0") @L.Sum" readonly />
                                                </div>
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Tan_SalesCipVat"):</label>
                                                    <input type="text" class="form-control" value="@Model.SalesPriceCIPWithVAT.ToString("N0") @L.Sum" readonly />
                                                </div>
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.SetPriceCIPWithVAT, new { @class = "form-label" })
                                                    @Html.TextBoxFor(m => m.SetPriceCIPWithVAT, new { @class = "form-control", @type = "number", @step = "0.01" })
                                                    @Html.ValidationMessageFor(m => m.SetPriceCIPWithVAT, "", new { @class = "text-danger" })
                                                    <small class="form-text text-muted">@L.T("Mes_Tan_SuggestedPriceHint")</small>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="bx bx-save"></i> @L.T("Save")
                                            </button>
                                            <a href="@Url.Action("Index", "Tannarx", new { year = Model.Year, month = Model.Month })" class="btn btn-secondary">
                                                <i class="bx bx-x"></i> @L.T("Cancel")
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
