@model IEnumerable<tahsinERP.ViewModels.Tannarx.TannarxIndexViewModel>

@{
    ViewBag.Title = L.T("Mes_Tan_Title");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #tannarxTable th:first-child,
    #tannarxTable td:first-child {
        position: sticky;
        left: 0;
        z-index: 3;
        background: #fff;
        min-width: 140px;
    }

    #tannarxTable thead th:first-child {
        z-index: 4;
        background: #f2f4f4;
    }
</style>

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "Tannarx"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Tannarx", "Create");

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Tannarx">@L.T("Mes_Tan_Title")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Mes_List")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @if (TempData["Info"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        @TempData["Info"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                <section class="invoice-list-wrapper">
                    <div class="users-list-filter px-1">
                        <form id="filterForm" method="get" action="@Url.Action("Index", "Tannarx")">
                            <div class="row border rounded py-2 mb-2">
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label for="yearFilter">@L.T("Mes_Year")</label>
                                    @Html.DropDownList(
                                        "year",
                                        (SelectList)ViewBag.Years,
                                        new { @id = "yearFilter", @class = "form-control" }
                                    )
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label for="monthFilter">@L.T("Mes_Month")</label>
                                    @Html.DropDownList(
                                        "month",
                                        (SelectList)ViewBag.Months,
                                        new { @id = "monthFilter", @class = "form-control" }
                                    )
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label for="productFilter">@L.T("Mes_Product")</label>
                                    @Html.DropDownList(
                                        "productID",
                                        (SelectList)ViewBag.Products,
                                        L.T("All"),
                                        new { @id = "productFilter", @class = "form-control" }
                                    )
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-search"></i> @L.T("Filter")
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-bordered table-hover" id="tannarxTable">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th>@L.T("Mes_Tan_ProductId")</th>
                                                    <th>@L.T("Type")</th>
                                                    <th>@L.T("Mes_Tan_Dimensions")</th>
                                                    <th>@L.T("Mes_Month")</th>
                                                    <th>@L.T("Mes_Tan_MaterialPrice")</th>
                                                    <th>@L.T("Mes_Tan_MaterialTransportPlanned")</th>
                                                    <th style="background-color: #fff3cd;">@L.T("Mes_Tan_ColLabor")</th>
                                                    <th style="background-color: #fff3cd;">@L.T("Mes_Tan_ColTaxBank")</th>
                                                    <th style="background-color: #fff3cd;">@L.T("Mes_Tan_ColAdmin")</th>
                                                    <th style="background-color: #fff3cd;">@L.T("Mes_Tan_ColOther")</th>
                                                    <th style="background-color: #fff3cd;">@L.T("Mes_Tan_ColProfit")</th>
                                                    <th style="background-color: #ffe5cc;">@L.T("Mes_Tan_SalesExwNoVat")</th>
                                                    <th style="background-color: #ffe5cc;">@L.T("Mes_Tan_SalesExwVat")</th>
                                                    <th style="background-color: #ffe5cc;">@L.T("Mes_Tan_SetExwVat")</th>
                                                    <th style="background-color: #ffe5cc;">@L.T("Mes_Tan_FinishedTransportPlanned")</th>
                                                    <th style="background-color: #cce5ff;">@L.T("Mes_Tan_SalesCipNoVat")</th>
                                                    <th style="background-color: #cce5ff;">@L.T("Mes_Tan_SalesCipVat")</th>
                                                    <th style="background-color: #cce5ff;">@L.T("Mes_Tan_SetCipVat")</th>
                                                    <th class="text-center">@L.T("Actions")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@item.ProductPNo</td>
                                                            <td>@item.ProductType</td>
                                                            <td>@item.Dimensions</td>
                                                            <td>@item.MonthString</td>
                                                            <td>@item.MaterialPrice.ToString("N0") @L.Sum</td>
                                                            <td>@item.MaterialTransportCost.ToString("N0") @L.Sum</td>
                                                            <td>@item.LaborCost.ToString("N0") @L.Sum</td>
                                                            <td>@item.TaxAndBank.ToString("N0") @L.Sum</td>
                                                            <td>@item.AdministrativeExpenses.ToString("N0") @L.Sum</td>
                                                            <td>@item.OtherExpenses.ToString("N0") @L.Sum</td>
                                                            <td>@item.Profit.ToString("N0") @L.Sum</td>
                                                            <td>@item.SalesPriceEXWWithoutVAT.ToString("N0") @L.Sum</td>
                                                            <td>@item.SalesPriceEXWWithVAT.ToString("N0") @L.Sum</td>
                                                            <td>@(item.SetPriceEXWWithVAT?.ToString("N0") ?? "-") @L.Sum</td>
                                                            <td>@(item.FinishedProductTransportCost?.ToString("N0") ?? "-") @L.Sum</td>
                                                            <td>@item.SalesPriceCIPWithoutVAT.ToString("N0") @L.Sum</td>
                                                            <td>@item.SalesPriceCIPWithVAT.ToString("N0") @L.Sum</td>
                                                            <td>@(item.SetPriceCIPWithVAT?.ToString("N0") ?? "-") @L.Sum</td>
                                                            <td class="text-center">
                                                                <a href="@Url.Action("Details", "Tannarx", new { id = item.ID })" class="btn btn-sm btn-outline-info" title="@L.T("View")">
                                                                    <i class="bx bx-show"></i>
                                                                </a>
                                                                @if (changePermit)
                                                                {
                                                                    <a href="@Url.Action("Edit", "Tannarx", new { id = item.ID })" class="btn btn-sm btn-outline-primary" title="@L.T("Edit")">
                                                                        <i class="bx bx-pencil"></i>
                                                                    </a>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="mt-3 text-center">
                                        @if (ViewBag.ShowGenerateButton == true)
                                        {
                                            using (Html.BeginForm("Generate", "Tannarx", FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="year" value="@ViewBag.Year" />
                                                <input type="hidden" name="month" value="@ViewBag.Month" />
                                                <button type="submit" class="btn btn-success">
                                                    <i class="bx bx-plus"></i> @L.T("Mes_Tan_Generate")
                                                </button>
                                            }
                                        }
                                        <p class="text-muted mt-2 text-center mb-0">
                                            <small>
                                                @L.T("Mes_Tan_CountsLine", (object)ViewBag.FinishedGoodsWithNormsCount, (object)ViewBag.TannarxCount, (object)ViewBag.MissingTannarxCount)
                                            </small>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        // Wait for document and all scripts to load
        document.addEventListener('DOMContentLoaded', function() {
            // Use jQuery since noConflict(true) is called in _Layout.cshtml
            if (typeof jQuery === 'undefined') {
                console.error('jQuery is not loaded');
                return;
            }

            // Initialize DataTable
            var table = jQuery('#tannarxTable').DataTable({
                "language": jQuery.extend({}, erpDataTable.language, { "emptyTable": '@L.Js("Mes_Tan_EmptyTable")' }),
                "pageLength": 25,
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": -1 }
                ],
                "scrollX": true,
                "dom": "lBfrtip",
                "buttons": erpDataTable.buttons({ small: true, landscape: true })
            });

            // Filter change handlers - submit form on change
            jQuery('#yearFilter, #monthFilter, #productFilter').on('change', function () {
                jQuery('#filterForm').submit();
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
