@model tahsinERP.ViewModels.Tannarx.TannarxDetailsViewModel

@{
    ViewBag.Title = L.T("Mes_Tan_DetailsTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "Tannarx"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Tannarx", "Edit");
    bool deletePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Tannarx", "Delete");

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Tannarx">@L.T("Mes_Tan_Title")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Details")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="row mb-2">
                                        <div class="col-md-12 text-right">
                                            @if (changePermit)
                                            {
                                                <a href="@Url.Action("Edit", "Tannarx", new { id = Model.ID })" class="btn btn-primary">
                                                    <i class="bx bx-pencil"></i> @L.T("Edit")
                                                </a>
                                            }
                                            @if (deletePermit)
                                            {
                                                <a href="@Url.Action("Delete", "Tannarx", new { id = Model.ID })" class="btn btn-danger">
                                                    <i class="bx bx-trash"></i> @L.T("Delete")
                                                </a>
                                            }
                                            <a href="@Url.Action("Index", "Tannarx", new { year = Model.Year, month = Model.Month })" class="btn btn-secondary">
                                                <i class="bx bx-arrow-back"></i> @L.T("Back")
                                            </a>
                                        </div>
                                    </div>

                                    <hr />

                                    <div class="row">
                                        <div class="col-md-12">
                                            <h6 class="mb-2">@L.T("Mes_ProductInfo")</h6>
                                            <table class="table table-bordered">
                                                <tr>
                                                    <th style="width: 200px;">@L.T("Mes_ProductNo")</th>
                                                    <td>@Model.ProductPNo</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_ProductName")</th>
                                                    <td>@Model.ProductName</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Type")</th>
                                                    <td>@Model.ProductType</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_Tan_Dimensions")</th>
                                                    <td>@Model.Dimensions</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_Month")</th>
                                                    <td>@Model.MonthString</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <hr />

                                    <div class="row">
                                        <div class="col-md-12">
                                            <h6 class="mb-2">@L.T("Mes_Tan_MaterialCosts")</h6>
                                            <table class="table table-bordered">
                                                <tr>
                                                    <th style="width: 200px;">@L.T("Mes_Tan_MaterialPrice")</th>
                                                    <td>@Model.MaterialPrice.ToString("N0") @L.Sum</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_Tan_MaterialTransport2")</th>
                                                    <td>@Model.MaterialTransportCost.ToString("N0") @L.Sum</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <hr />

                                    <div class="row">
                                        <div class="col-md-12">
                                            <h6 class="mb-2">@L.T("Mes_Tan_LaborAndExpenses")</h6>
                                            <table class="table table-bordered">
                                                <tr>
                                                    <th style="width: 200px;">@L.T("Mes_Tan_LaborA")</th>
                                                    <td>@Model.LaborCost.ToString("N0") @L.Sum</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_Tan_TaxBankB") (@(Model.TaxAndBankPercent?.ToString("N2") ?? "0")%)</th>
                                                    <td>@Model.TaxAndBank.ToString("N0") @L.Sum</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_Tan_AdminC") (@(Model.AdministrativeExpensesPercent?.ToString("N2") ?? "0")%)</th>
                                                    <td>@Model.AdministrativeExpenses.ToString("N0") @L.Sum</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_Tan_OtherD") (@(Model.OtherExpensesPercent?.ToString("N2") ?? "0")%)</th>
                                                    <td>@Model.OtherExpenses.ToString("N0") @L.Sum</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_Tan_ProfitE") (@(Model.ProfitPercent?.ToString("N2") ?? "0")%)</th>
                                                    <td>@Model.Profit.ToString("N0") @L.Sum</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <hr />

                                    <div class="row">
                                        <div class="col-md-12">
                                            <h6 class="mb-2">@L.T("Mes_Tan_ExwPrices")</h6>
                                            <table class="table table-bordered">
                                                <tr>
                                                    <th style="width: 200px;">@L.T("Mes_Tan_SalesExwNoVat")</th>
                                                    <td>@Model.SalesPriceEXWWithoutVAT.ToString("N0") @L.Sum</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_Tan_SalesExwVat")</th>
                                                    <td>@Model.SalesPriceEXWWithVAT.ToString("N0") @L.Sum</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_Tan_SetExwVat")</th>
                                                    <td>@(Model.SetPriceEXWWithVAT?.ToString("N0") ?? "-") @L.Sum</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <hr />

                                    <div class="row">
                                        <div class="col-md-12">
                                            <h6 class="mb-2">@L.T("Mes_Tan_FinishedTransport")</h6>
                                            <table class="table table-bordered">
                                                <tr>
                                                    <th style="width: 200px;">@L.T("Mes_Tan_FinishedTransportPrice")</th>
                                                    <td>@(Model.FinishedProductTransportCost?.ToString("N0") ?? "-") @L.Sum</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <hr />

                                    <div class="row">
                                        <div class="col-md-12">
                                            <h6 class="mb-2">@L.T("Mes_Tan_CipPrices")</h6>
                                            <table class="table table-bordered">
                                                <tr>
                                                    <th style="width: 200px;">@L.T("Mes_Tan_SalesCipNoVat")</th>
                                                    <td>@Model.SalesPriceCIPWithoutVAT.ToString("N0") @L.Sum</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_Tan_SalesCipVat")</th>
                                                    <td>@Model.SalesPriceCIPWithVAT.ToString("N0") @L.Sum</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_Tan_SetCipVat")</th>
                                                    <td>@(Model.SetPriceCIPWithVAT?.ToString("N0") ?? "-") @L.Sum</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <hr />

                                    <div class="row">
                                        <div class="col-md-12">
                                            <h6 class="mb-2">@L.T("Mes_Tan_AuditInfo")</h6>
                                            <table class="table table-bordered">
                                                <tr>
                                                    <th style="width: 200px;">@L.T("Mes_Tan_CreatedByUser")</th>
                                                    <td>@Model.CreatedBy</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Mes_Tan_CreatedAt")</th>
                                                    <td>@Model.CreatedDT.ToString("dd.MM.yyyy HH:mm")</td>
                                                </tr>
                                                @if (!string.IsNullOrEmpty(Model.ModifiedBy))
                                                {
                                                    <tr>
                                                        <th>@L.T("Mes_Tan_ModifiedByUser")</th>
                                                        <td>@Model.ModifiedBy</td>
                                                    </tr>
                                                    <tr>
                                                        <th>@L.T("Mes_Tan_ModifiedAt")</th>
                                                        <td>@(Model.ModifiedDT?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                                                    </tr>
                                                }
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
