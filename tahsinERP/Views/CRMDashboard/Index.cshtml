@model tahsinERP.ViewModels.CRMDashboardViewModel
@{
    ViewBag.Title = L.T("Menu_DashCrm");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fromDate = ViewBag.FromDate as DateTime?;
    var toDate = ViewBag.ToDate as DateTime?;
    Func<decimal, string> fmtSom = v => string.Format("{0:N2}", v).Replace(",", " ").Replace(".", ",") + " " + L.Sum;
    var totalReceivable = Model.CustomerReceivables != null ? Model.CustomerReceivables.Sum(x => x.ReceivableAmount) : 0m;
    // Grafik ma'lumotlari JSON konfiguratsiyada (Scripts/crm/crm-dashboard.js) — XSS/qo'shtirnoq xavfsiz (CRM-S05)
    Func<IEnumerable<tahsinERP.ViewModels.CRMChartPoint>, object> chartJson = pts => new
    {
        labels = (pts ?? Enumerable.Empty<tahsinERP.ViewModels.CRMChartPoint>()).Select(x => x.Label).ToList(),
        series = (pts ?? Enumerable.Empty<tahsinERP.ViewModels.CRMChartPoint>()).Select(x => x.NumericValue).ToList()
    };
    var topCustomers = Model.TopCustomersByOrderAmount ?? new List<tahsinERP.ViewModels.CRMCustomerOrderSum>();
    var dashboardConfig = new
    {
        contractsByMonth = chartJson(Model.ContractsByMonth),
        ordersByMonth = chartJson(Model.OrdersByMonth),
        orderFulfillment = chartJson(Model.OrderFulfillmentStatus),
        contractStatus = chartJson(Model.ContractCompletionStatus),
        topCustomers = new
        {
            labels = topCustomers.Select(x => x.CustomerName ?? "").ToList(),
            series = topCustomers.Select(x => (double)x.TotalAmount).ToList()
        }
    };
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/SOrder/Index">@L.T("Menu_Sales")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Menu_DashCrm")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="alert alert-light border mb-1 py-50">
                    <i class="bx bx-info-circle"></i> @L.T("Crm_DashAllInSum") (<a href="@Url.Action("Index", "CurrencyRates")">@L.T("Crm_DashCurrencyRatesLink")</a>).
                </div>
                @if (ViewBag.CurrencyWarning != null)
                {
                    <div class="alert alert-warning mb-1"><i class="bx bx-error"></i> @ViewBag.CurrencyWarning</div>
                }
                <!-- Filtr -->
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <form method="get" action="@Url.Action("Index")" class="row align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label">@L.T("Crm_From")</label>
                                        <input type="date" name="fromDate" class="form-control" value="@(fromDate?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">@L.T("Crm_To")</label>
                                        <input type="date" name="toDate" class="form-control" value="@(toDate?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-primary"><i class="bx bx-filter-alt"></i> @L.T("Filter")</button>
                                    </div>
                                    <div class="col-md-2">
                                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">@L.T("Reset")</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KPI kartalar -->
                <div class="row match-height">
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card border-left-primary">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-end">
                                        <div>
                                            <p class="mb-0 text-muted">@L.T("Crm_DashTotalContracts")</p>
                                            <h3 class="font-weight-bolder mb-0">@Model.TotalContracts</h3>
                                            <small class="text-muted">@L.T("Amount"): @Model.ContractsTotalAmount.ToString("N0")</small>
                                        </div>
                                        <div class="avatar bg-rgba-primary p-50 m-0">
                                            <div class="avatar-content"><i class="bx bx-file font-medium-3 text-primary"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card border-left-danger">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-end">
                                        <div>
                                            <p class="mb-0 text-muted">@L.T("Crm_DashContractsOverdue")</p>
                                            <h3 class="font-weight-bolder mb-0 text-danger">@Model.ContractsOverdue</h3>
                                            <small class="text-muted">@L.T("Crm_DashCompleted"): @Model.ContractsCompleted</small>
                                        </div>
                                        <div class="avatar bg-rgba-danger p-50 m-0">
                                            <div class="avatar-content"><i class="bx bx-calendar-x font-medium-3 text-danger"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card border-left-success">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-end">
                                        <div>
                                            <p class="mb-0 text-muted">@L.T("Crm_DashTotalOrders")</p>
                                            <h3 class="font-weight-bolder mb-0">@Model.TotalOrders</h3>
                                            <small class="text-muted">@L.T("Crm_DashWithoutInvoice"): <span class="text-warning">@Model.OrdersWithoutInvoice</span></small>
                                        </div>
                                        <div class="avatar bg-rgba-success p-50 m-0">
                                            <div class="avatar-content"><i class="bx bx-cart font-medium-3 text-success"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card border-left-warning">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-end">
                                        <div>
                                            <p class="mb-0 text-muted">@L.T("Crm_DashDeliveryOverdue")</p>
                                            <h3 class="font-weight-bolder mb-0 text-warning">@Model.OrdersDeliveryOverdue</h3>
                                            <small class="text-muted">@L.T("Crm_DashTotalInvoices"): @Model.TotalInvoices</small>
                                        </div>
                                        <div class="avatar bg-rgba-warning p-50 m-0">
                                            <div class="avatar-content"><i class="bx bx-time-five font-medium-3 text-warning"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row match-height">
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-end">
                                        <div>
                                            <p class="mb-0 text-muted">@L.T("Crm_DashInvoicesOverdueKpi")</p>
                                            <h3 class="font-weight-bolder mb-0">@Model.TotalInvoices <small class="text-danger">(@Model.InvoicesOverdue)</small></h3>
                                            <small class="text-muted">@L.T("Total"): @Model.InvoicesTotalAmount.ToString("N0")</small>
                                        </div>
                                        <div class="avatar bg-rgba-info p-50 m-0">
                                            <div class="avatar-content"><i class="bx bx-receipt font-medium-3 text-info"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-end">
                                        <div>
                                            <p class="mb-0 text-muted">@L.T("Menu_Customers")</p>
                                            <h3 class="font-weight-bolder mb-0">@Model.TotalCustomers</h3>
                                            <small class="text-muted">@L.T("Crm_DashOrdersThisYear"): @Model.CustomersWithOrdersThisYear</small>
                                        </div>
                                        <div class="avatar bg-rgba-secondary p-50 m-0">
                                            <div class="avatar-content"><i class="bx bx-user font-medium-3 text-secondary"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Grafiklar -->
                <div class="row">
                    <div class="col-lg-6 col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Crm_DashContractsByMonth")</h4>
                            </div>
                            <div class="card-body">
                                <div id="contractsByMonthChart" style="min-height: 320px;"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Crm_DashOrdersByMonth")</h4>
                            </div>
                            <div class="card-body">
                                <div id="ordersByMonthChart" style="min-height: 320px;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-6 col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Crm_DashOrderFulfillment")</h4>
                            </div>
                            <div class="card-body">
                                <div id="orderFulfillmentChart" style="min-height: 320px;"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Crm_DashContractStatus")</h4>
                            </div>
                            <div class="card-body">
                                <div id="contractStatusChart" style="min-height: 320px;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Crm_DashTopCustomers")</h4>
                            </div>
                            <div class="card-body">
                                <div id="topCustomersChart" style="min-height: 350px;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h4 class="card-title mb-0">@L.T("Crm_DashReceivables")</h4>
                                <div class="text-danger font-weight-bold">@L.T("Total"): @fmtSom(totalReceivable)</div>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table id="tblCustomerReceivables" class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width:70%">@L.T("Crm_DashCompanyContract")</th>
                                                <th class="text-right">@L.T("Crm_DashReceivable")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.CustomerReceivables != null && Model.CustomerReceivables.Any())
                                            {
                                                foreach (var r in Model.CustomerReceivables)
                                                {
                                                    <tr class="receivable-customer-row" data-customer="@r.CustomerId" style="cursor:pointer;">
                                                        <td class="font-weight-bold text-primary">
                                                            <i class="bx bx-chevron-right mr-25 receivable-toggle-icon"></i>
                                                            @r.CustomerName
                                                        </td>
                                                        <td class="text-right text-danger font-weight-bold">@fmtSom(r.ReceivableAmount)</td>
                                                    </tr>
                                                    foreach (var c in r.Contracts)
                                                    {
                                                        <tr class="receivable-contract-row d-none" data-parent="@r.CustomerId">
                                                            <td class="pl-3 text-muted">
                                                                <i class="bx bx-subdirectory-right mr-25"></i>
                                                                @if (c.ContractId.HasValue)
                                                                {
                                                                    <a href="@Url.Action("Details", "SContract", new { id = c.ContractId.Value })">@c.ContractNo</a>
                                                                }
                                                                else
                                                                {
                                                                    @c.ContractNo
                                                                }
                                                            </td>
                                                            <td class="text-right text-danger">@fmtSom(c.ReceivableAmount)</td>
                                                        </tr>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="2" class="text-center text-muted">@L.T("Crm_DashNoReceivables")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hisobot jadvallari -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h4 class="card-title mb-0">@L.T("Crm_DashOrdersWithoutInvoice")</h4>
                                <a href="~/SOrder/Index" class="btn btn-sm btn-outline-primary">@L.T("Crm_DashAllOrders")</a>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table id="tblOrdersWithoutInvoice" class="table table-hover mb-0 crm-dashboard-datatable">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Crm_OrderNo")</th>
                                                <th>@L.T("Crm_Customer")</th>
                                                <th>@L.T("Date")</th>
                                                <th>@L.T("Amount")</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.OrdersWithoutInvoiceList != null && Model.OrdersWithoutInvoiceList.Any())
                                            {
                                                foreach (var o in Model.OrdersWithoutInvoiceList)
                                                {
                                                    <tr>
                                                        <td>@o.OrderNo</td>
                                                        <td>@o.CustomerName</td>
                                                        <td>@o.IssuedDate.ToString("dd.MM.yyyy")</td>
                                                        <td>@(o.Amount?.ToString("N0") ?? "") @o.CurrencyCode</td>
                                                        <td><a href="@Url.Action("Create", "SalesInvoices", new { orderID = o.OrderId })" class="btn btn-sm btn-success">@L.T("Crm_CreateInvoice")</a></td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="5" class="text-center text-muted">@L.T("NoData")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-6 col-12">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h4 class="card-title mb-0">@L.T("Crm_DashOverdueContracts")</h4>
                                <a href="~/SContract/Index" class="btn btn-sm btn-outline-secondary">@L.T("Menu_Contracts")</a>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Crm_DashContractNo")</th>
                                                <th>@L.T("Crm_Customer")</th>
                                                <th>@L.T("Crm_DueDate")</th>
                                                <th>@L.T("Crm_DashDelayDays")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.ContractsOverdueList != null && Model.ContractsOverdueList.Any())
                                            {
                                                foreach (var c in Model.ContractsOverdueList)
                                                {
                                                    <tr>
                                                        <td>@c.ContractNo</td>
                                                        <td>@c.CustomerName</td>
                                                        <td>@c.DueDate.ToString("dd.MM.yyyy")</td>
                                                        <td><span class="badge badge-danger">@c.DaysOverdue</span></td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="4" class="text-center text-muted">@L.T("No")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-12">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h4 class="card-title mb-0">@L.T("Crm_DashDeliveryOverdue")</h4>
                                <a href="~/SOrder/Index" class="btn btn-sm btn-outline-secondary">@L.T("Menu_Orders")</a>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table id="tblDeliveryOverdue" class="table table-hover mb-0 crm-dashboard-datatable">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Crm_Order")</th>
                                                <th>@L.T("Crm_Product")</th>
                                                <th>@L.T("Crm_DashPlanDate")</th>
                                                <th>@L.T("Crm_DashShipped")</th>
                                                <th>@L.T("Crm_DashDelay")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.DeliveryOverdueList != null && Model.DeliveryOverdueList.Any())
                                            {
                                                foreach (var d in Model.DeliveryOverdueList)
                                                {
                                                    <tr>
                                                        <td>@d.OrderNo</td>
                                                        <td>@d.ProductName</td>
                                                        <td>@d.DeliveryDate.ToString("dd.MM.yyyy")</td>
                                                        <td>@d.QtyShipped / @d.QtyPlanned</td>
                                                        <td><span class="badge badge-warning">@L.T("Crm_DaysN", d.DaysOverdue)</span></td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="5" class="text-center text-muted">@L.T("No")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h4 class="card-title mb-0">@L.T("Crm_DashOverdueInvoices")</h4>
                                <a href="~/SalesInvoices/Index" class="btn btn-sm btn-outline-secondary">@L.T("Menu_Invoices")</a>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table id="tblInvoicesOverdue" class="table table-hover mb-0 crm-dashboard-datatable">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Crm_DashInvoiceNo")</th>
                                                <th>@L.T("Crm_Customer")</th>
                                                <th>@L.T("Crm_PaymentDue")</th>
                                                <th>@L.T("Crm_DashDelayDays")</th>
                                                <th>@L.T("Amount") (@L.Sum)</th>
                                                <th>@L.T("Crm_DashPaid")</th>
                                                <th>@L.T("Crm_DashBalance")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.InvoicesOverdueList != null && Model.InvoicesOverdueList.Any())
                                            {
                                                foreach (var i in Model.InvoicesOverdueList)
                                                {
                                                    <tr>
                                                        <td>@i.InvoiceNo</td>
                                                        <td>@i.CustomerName</td>
                                                        <td>@(i.DueDate?.ToString("dd.MM.yyyy") ?? "")</td>
                                                        <td><span class="badge badge-danger">@i.DaysOverdue</span></td>
                                                        <td>@i.TotalAmount.ToString("N0")</td>
                                                        <td>@i.PaidAmount.ToString("N0")</td>
                                                        <td class="font-weight-bold">@i.RemainingAmount.ToString("N0")</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="7" class="text-center text-muted">@L.T("No")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        #tblCustomerReceivables td:first-child {
            white-space: normal;
            word-break: break-word;
        }
        #tblCustomerReceivables td:last-child,
        #tblCustomerReceivables th:last-child {
            white-space: nowrap;
        }
    </style>

    @section scripts
    {
        <script src="~/app-assets/vendors/js/charts/apexcharts.min.js"></script>
        <script type="application/json" id="crmDashboardConfig">@Html.Raw(Json.Encode(dashboardConfig))</script>
        <script src="@Url.Content("~/Scripts/crm/crm-dashboard.js")"></script>
    }
}
