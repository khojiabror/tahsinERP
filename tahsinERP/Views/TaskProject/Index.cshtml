@model List<tahsinERP.Models.APP_TASK_PROJECTS>
@{
    ViewBag.Title = "Task Loyihalar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = false;
    if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
    {
        changePermit = true;
    }
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Tasks">Tasks</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="#">Task Sozlamalari</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Loyihalar
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    }
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "TaskProject")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Loyiha qo'shish
                            </a>
                        </div>
                    }
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="projectDataTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Kod</th>
                                                    <th>Nomi</th>
                                                    <th>Faol</th>
                                                    <th>Yaratilgan sana</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "TaskProject", new { id = item.ID })">@item.Code</a>
                                                            </td>
                                                            <td>@item.Name</td>
                                                            <td>
                                                                @if (item.IsActive)
                                                                {
                                                                    <span class="badge badge-success">Faol</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge badge-secondary">Nofaol</span>
                                                                }
                                                            </td>
                                                            <td>@item.CreatedDT.ToString("yyyy-MM-dd")</td>
                                                            @if (changePermit)
                                                            {
                                                                <td>
                                                                    <div>
                                                                        <a href="@Url.Action("Edit", "TaskProject", new { id = item.ID })" class="btn btn-sm btn-outline-success" title="Tahrirlash"><i class="bx bx-edit-alt"></i></a>
                                                                        <a href="@Url.Action("Delete", "TaskProject", new { id = item.ID })" class="btn btn-sm btn-outline-danger" title="O'chirish" onclick="return confirm('Bu loyihani o\'chirishni xohlaysizmi?');"><i class="bx bx-trash"></i></a>
                                                                    </div>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="@(changePermit ? 5 : 4)" class="text-center">Ma'lumot topilmadi</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('#projectDataTable').DataTable({
                "language": {
                    "search": "Qidirish:",
                    "lengthMenu": "_MENU_ ta ko'rsatish",
                    "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    "infoEmpty": "Yozuvlar yo'q",
                    "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                    "paginate": {
                        "first": "Birinchi",
                        "last": "Oxirgi",
                        "next": "Keyingi",
                        "previous": "Oldingi"
                    },
                    "zeroRecords": "Ma'lumot topilmadi"
                },
                "pageLength": 25,
                "order": [[1, "asc"]]
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
