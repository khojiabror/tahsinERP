@using tahsinERP.Services.Tasks
@model tahsinERP.Models.APP_TASK_PROJECTS
@using System.Linq
@{
    ViewBag.Title = "Loyiha ma'lumotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());
    
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/TaskProject">Loyihalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @Model.Name
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                <h4 class="text-primary">Loyiha Ma'lumotlari</h4>
                                                <hr />
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <p class="mb-1"><b class="text-dark">Kod:</b> <span class="text-dark">@Model.Code</span></p>
                                                        <p class="mb-1"><b class="text-dark">Nomi:</b> <span class="text-dark">@Model.Name</span></p>
                                                        <p class="mb-1"><b class="text-dark">Yaratilgan sana:</b> <span class="text-dark">@Model.CreatedDT.ToString("yyyy-MM-dd HH:mm")</span></p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <p class="mb-1"><b class="text-dark">Faol:</b> 
                                                            @if (Model.IsActive)
                                                            {
                                                                <span class="badge badge-light-success">Faol</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge badge-light-secondary">Nofaol</span>
                                                            }
                                                        </p>
                                                    </div>
                                                </div>
                                                <hr>
                                                @if (changePermit)
                                                {
                                                    <div class="row mt-3">
                                                        <div class="col-12">
                                                            <a href="@Url.Action("Edit", "TaskProject", new { id = Model.ID })" class="btn btn-outline-primary">
                                                                <i class="bx bx-edit-alt"></i> Tahrirlash
                                                            </a>
                                                            <a href="@Url.Action("Index", "TaskProject")" class="btn btn-outline-secondary">
                                                                <i class="bx bx-arrow-back"></i> Orqaga
                                                            </a>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tasks Datatable -->
                    <div class="row mt-2">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">Loyihaga biriktirilgan vazifalar</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table id="projectTasksTable" class="table table-striped table-bordered" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>Kod</th>
                                                        <th>Sarlavha</th>
                                                        <th>Mas'ul</th>
                                                        <th>Prioritet</th>
                                                        <th>Status</th>
                                                        <th>Yaratilgan</th>
                                                        <th>Muddati</th>
                                                        <th class="text-center">Amallar</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (ViewBag.Tasks != null)
                                                    {
                                                        var tasks = ViewBag.Tasks as List<tahsinERP.ViewModels.TaskViewModel>;
                                                        if (tasks != null && tasks.Any())
                                                        {
                                                            foreach (var task in tasks)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        <a href="@Url.Action("Details", "Tasks", new { id = task.ID })">@(task.KeyCode ?? task.ID.ToString())</a>
                                                                    </td>
                                                                    <td>@(task.Title ?? "")</td>
                                                                    <td>@(task.AssigneeFullName ?? "-")</td>
                                                                    <td>
                                                                        @Html.TaskPriorityBadge(task.PriorityID, "")
                                                                    </td>
                                                                    <td>
                                                                        @Html.TaskStatusBadge(task.StatusID, "")
                                                                    </td>
                                                                    <td>@task.CreatedDT.ToString("yyyy-MM-dd")</td>
                                                                    <td>
                                                                        @if (task.DueDate.HasValue)
                                                                        {
                                                                            <span class="@(TaskBadges.IsOverdue(task.DueDate, task.StatusID) ? "text-danger" : "")">
                                                                                @task.DueDate.Value.ToString("yyyy-MM-dd")
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>-</span>
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        <a href="@Url.Action("Details", "Tasks", new { id = task.ID })" class="btn btn-sm btn-outline-primary" title="Ko'rish">
                                                                            <i class="bx bx-show"></i>
                                                                        </a>
                                                                        @if (changePermit)
                                                                        {
                                                                            <a href="@Url.Action("Edit", "Tasks", new { id = task.ID })" class="btn btn-sm btn-outline-warning" title="Tahrirlash">
                                                                                <i class="bx bx-edit"></i>
                                                                            </a>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <tr>
                                                                <td colspan="8" class="text-center">Vazifalar topilmadi</td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="8" class="text-center">Vazifalar topilmadi</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer">
                                    @if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Tasks", "Create"))
                                    {
                                        <a href="@Url.Action("Create", "Tasks", new { projectID = Model.ID })" class="btn btn-success">
                                            <i class="bx bx-plus"></i> Yangi vazifa qo'shish
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@section scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.DataTable) {
                $('#projectTasksTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Uzbek.json",
                        "lengthMenu": "Har sahifada _MENU_ ta yozuv ko'rsatish",
                        "zeroRecords": "Hech qanday yozuv topilmadi",
                        "info": "_START_ dan _END_ gacha, jami _TOTAL_ ta yozuv",
                        "infoEmpty": "Yozuvlar yo'q",
                        "infoFiltered": "(_MAX_ ta yozuvdan filtrlangan)",
                        "search": "Qidirish:",
                        "paginate": {
                            "first": "Birinchi",
                            "last": "Oxirgi",
                            "next": "Keyingi",
                            "previous": "Oldingi"
                        }
                    },
                    "order": [[5, "desc"]],
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Barchasi"]],
                    "paging": true,
                    "pagingType": "full_numbers",
                    "info": true,
                    "searching": true,
                    "responsive": true,
                    "processing": true,
                    "dom": '<"top"lf>rt<"bottom"ip><"clear">'
                });
            } else {
                console.error("DataTables library is not loaded");
            }
        });
    </script>
}
