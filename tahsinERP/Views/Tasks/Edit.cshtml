@model tahsinERP.ViewModels.TaskViewModel
@{
    ViewBag.Title = "Edit Task";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    // Check if user is Admin or Developer
    var userRoles = tahsinERP.Models.RoleHelper.GetUserRoles(User.Identity.Name);
    bool isAdminOrDeveloper = userRoles != null && userRoles.Any(r => 
        r.Equals("Admin", StringComparison.OrdinalIgnoreCase) || 
        r.Equals("Developer", StringComparison.OrdinalIgnoreCase));
    using (Html.BeginForm("Edit", "Tasks", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ID)
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/Tasks">Tasks</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            Task tahrirlash
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="basic-select2">
                        <div class="row">
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            <div class="row">
                                                <div class="col-lg-12 col-md-6 mt-25">
                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                    <hr>
                                                    <h6 class="invoice-to">Key Code</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.DisplayFor(model => model.KeyCode, new { @class = "form-control round" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">Title *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Title, new { @class = "form-control round", @placeholder = "Task Title", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">Description</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control round", @placeholder = "Task Description", @rows = "5" })
                                                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">Status *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.DropDownListFor(model => model.StatusID, (SelectList)ViewBag.StatusID, "Select Status", new { @class = "form-control round", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.StatusID, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">Priority *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.DropDownListFor(model => model.PriorityID, (SelectList)ViewBag.PriorityID, "Select Priority", new { @class = "form-control round", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.PriorityID, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    @if (isAdminOrDeveloper)
                                                    {
                                                        <h6 class="invoice-to">Assignee</h6>
                                                        <fieldset class="invoice-address form-group">
                                                            @Html.DropDownListFor(model => model.AssigneeUserID, (SelectList)ViewBag.AssigneeUserID, "Unassigned", new { @class = "form-control round" })
                                                            @Html.ValidationMessageFor(model => model.AssigneeUserID, "", new { @class = "text-danger" })
                                                        </fieldset>
                                                    }
                                                    else
                                                    {
                                                        @Html.HiddenFor(model => model.AssigneeUserID)
                                                    }
                                                    <h6 class="invoice-to">Project</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.DropDownListFor(model => model.ProjectID, (SelectList)ViewBag.ProjectID, "No Project", new { @class = "form-control round" })
                                                        @Html.ValidationMessageFor(model => model.ProjectID, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">Due Date</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @if (Model.DueDate.HasValue)
                                                        {
                                                            @Html.TextBoxFor(model => model.DueDate, new { @class = "form-control round", @type = "date", @Value = Model.DueDate.Value.ToString("yyyy-MM-dd") })
                                                        }
                                                        else
                                                        {
                                                            @Html.TextBoxFor(model => model.DueDate, new { @class = "form-control round", @type = "date" })
                                                        }
                                                        @Html.ValidationMessageFor(model => model.DueDate, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <ul class="list-group list-group-flush">
                                                        <li class="list-group-item border-0 pb-0">
                                                            <button class="btn btn-primary btn-block subtotal-preview-btn" type="submit">
                                                                <i class='bx bx-save'></i>
                                                                Saqlash
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                            <hr>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
