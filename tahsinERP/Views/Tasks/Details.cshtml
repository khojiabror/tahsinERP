@using tahsinERP.Services.Tasks
@model tahsinERP.ViewModels.TaskViewModel
@{
    ViewBag.Title = "Vazifa ma'lumotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());
    
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Tasks">Vazifalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @Model.KeyCode - @Model.Title
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                <h4 class="text-primary">Vazifa Ma'lumotlari</h4>
                                                <hr />
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <p><b>Kod:</b> @(Model.KeyCode ?? "-")</p>
                                                        <p><b>Sarlavha:</b> @(Model.Title ?? "-")</p>
                                                        <p><b>Tavsif:</b></p>
                                                        <p>@(Model.Description ?? "-")</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <p><b>Status:</b> 
                                                            @Html.TaskStatusBadge(Model.StatusID, "-")
                                                        </p>
                                                        <p><b>Prioritet:</b> 
                                                            @Html.TaskPriorityBadge(Model.PriorityID, "-")
                                                        </p>
                                                        <p><b>Mas'ul:</b> @(Model.AssigneeFullName ?? "Tayinlanmagan")</p>
                                                        <p><b>Hisobot beruvchi:</b> @(Model.ReporterFullName ?? "-")</p>
                                                        <p><b>Loyiha:</b> 
                                                            @if (Model.ProjectID.HasValue)
                                                            {
                                                                <a href="@Url.Action("Details", "TaskProject", new { id = Model.ProjectID.Value })" class="text-primary font-weight-bold">
                                                                    @(Model.ProjectName ?? "Loyiha yo'q")
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <span>Loyiha yo'q</span>
                                                            }
                                                        </p>
                                                        <p><b>Yaratilgan:</b> @Model.CreatedDT.ToString("yyyy-MM-dd HH:mm")</p>
                                                        @if (Model.UpdatedDT.HasValue)
                                                        {
                                                            <p><b>Yangilangan:</b> @Model.UpdatedDT.Value.ToString("yyyy-MM-dd HH:mm")</p>
                                                        }
                                                        <p><b>Muddati:</b> 
                                                            @if (Model.DueDate.HasValue)
                                                            {
                                                                <span class="@(tahsinERP.Services.Tasks.TaskBadges.IsOverdue(Model.DueDate, Model.StatusID) ? "text-danger font-weight-bold" : "")">
                                                                    @Model.DueDate.Value.ToString("yyyy-MM-dd")
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span>-</span>
                                                            }
                                                        </p>
                                                        <p><b>Bajaruvchi izohi:</b></p>
                                                        @if (!string.IsNullOrWhiteSpace(Model.UserComment))
                                                        {
                                                            <div class="border rounded p-2 bg-light" style="white-space: pre-wrap;">@Model.UserComment</div>
                                                        }
                                                        else
                                                        {
                                                            <p class="text-muted font-italic">Izoh yo'q</p>
                                                        }
                                                    </div>
                                                </div>
                                                <hr>
                                                
                                                <div class="row mt-3">
                                                    <div class="col-12">
                                                        <a href="@Url.Action("ChangeStatus", "TaskChangeStatus", new { id = Model.ID })" class="btn btn-warning">
                                                            <i class="bx bx-sync"></i> Status o'zgartirish
                                                        </a>
                                                        @if (changePermit)
                                                        {
                                                            <a href="@Url.Action("Edit", "Tasks", new { id = Model.ID })" class="btn btn-primary">
                                                                <i class="bx bx-edit-alt"></i> Tahrirlash
                                                            </a>
                                                        }
                                                        <a href="@Url.Action("Index", "Tasks")" class="btn btn-secondary">
                                                            <i class="bx bx-arrow-back"></i> Orqaga
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
