@model tahsinERP.ViewModels.TaskViewModel
@{
    ViewBag.Title = "Task Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());
    
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Tasks">Tasks</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @Model.KeyCode - @Model.Title
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                <h4 class="text-primary">Task Ma'lumotlari</h4>
                                                <hr />
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <p><b>Key Code:</b> @(Model.KeyCode ?? "-")</p>
                                                        <p><b>Title:</b> @(Model.Title ?? "-")</p>
                                                        <p><b>Description:</b></p>
                                                        <p>@(Model.Description ?? "-")</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <p><b>Status:</b> 
                                                            <span class="badge badge-@(Model.StatusName?.ToLower() == "done" ? "success" : Model.StatusName?.ToLower() == "in_progress" ? "primary" : "secondary")">
                                                                @(Model.StatusName ?? "-")
                                                            </span>
                                                        </p>
                                                        <p><b>Priority:</b> 
                                                            <span class="badge badge-@(Model.PriorityName?.ToLower() == "critical" ? "danger" : Model.PriorityName?.ToLower() == "high" ? "warning" : "info")">
                                                                @(Model.PriorityName ?? "-")
                                                            </span>
                                                        </p>
                                                        <p><b>Assignee:</b> @(Model.AssigneeFullName ?? "Unassigned")</p>
                                                        <p><b>Reporter:</b> @(Model.ReporterFullName ?? "-")</p>
                                                        <p><b>Project:</b> @(Model.ProjectName ?? "No Project")</p>
                                                        <p><b>Created:</b> @Model.CreatedDT.ToString("yyyy-MM-dd HH:mm")</p>
                                                        @if (Model.UpdatedDT.HasValue)
                                                        {
                                                            <p><b>Updated:</b> @Model.UpdatedDT.Value.ToString("yyyy-MM-dd HH:mm")</p>
                                                        }
                                                        <p><b>Due Date:</b> 
                                                            @if (Model.DueDate.HasValue)
                                                            {
                                                                <span class="@(Model.DueDate.Value < DateTime.Now && Model.StatusName?.ToLower() != "done" ? "text-danger" : "")">
                                                                    @Model.DueDate.Value.ToString("yyyy-MM-dd")
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span>-</span>
                                                            }
                                                        </p>
                                                    </div>
                                                </div>
                                                <hr>
                                                
                                                @if (changePermit)
                                                {
                                                    <div class="row mt-3">
                                                        <div class="col-12">
                                                            <a href="@Url.Action("Edit", "Tasks", new { id = Model.ID })" class="btn btn-primary">
                                                                <i class="bx bx-edit-alt"></i> Edit
                                                            </a>
                                                            <a href="@Url.Action("Index", "Tasks")" class="btn btn-secondary">
                                                                <i class="bx bx-arrow-back"></i> Back to List
                                                            </a>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
