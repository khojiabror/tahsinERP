@model List<tahsinERP.ViewModels.TaskViewModel>
@{
    ViewBag.Title = "Tasks";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = false;
    if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
    {
        changePermit = true;
    }
    
    // Check if user is Admin or Developer
    var userRoles = tahsinERP.Models.RoleHelper.GetUserRoles(User.Identity.Name);
    bool isAdminOrDeveloper = userRoles != null && userRoles.Any(r => 
        r.Equals("Admin", StringComparison.OrdinalIgnoreCase) || 
        r.Equals("Developer", StringComparison.OrdinalIgnoreCase));
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Tasks / Vazifalar
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "Tasks")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi Task qo'shish
                            </a>
                        </div>
                    }
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- Search and Filter -->
                                    <div class="users-list-filter px-1">
                                        <form method="get" action="@Url.Action("Index", "Tasks")" id="filterForm">
                                            <div class="row border rounded py-2 mb-2">
                                                <div class="col-12 col-sm-6 col-lg-3">
                                                    <label>Qidirish</label>
                                                    <input type="text" name="searchTerm" class="form-control" placeholder="Title, Description, Key..." value="@ViewBag.SearchTerm" />
                                                </div>
                                                @if (isAdminOrDeveloper)
                                                {
                                                    <div class="col-12 col-sm-6 col-lg-2">
                                                        <label>Assignee</label>
                                                        @Html.DropDownList("assigneeUserID", (SelectList)ViewBag.AssigneeUserID, "All", new { @class = "form-control" })
                                                    </div>
                                                }
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Status</label>
                                                    @Html.DropDownList("statusID", (SelectList)ViewBag.StatusID, "All", new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Priority</label>
                                                    @Html.DropDownList("priorityID", (SelectList)ViewBag.PriorityID, "All", new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Due Date From</label>
                                                    <input type="date" name="dueDateFrom" class="form-control" value="@(ViewBag.DueDateFrom != null ? ((DateTime)ViewBag.DueDateFrom).ToString("yyyy-MM-dd") : "")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Due Date To</label>
                                                    <input type="date" name="dueDateTo" class="form-control" value="@(ViewBag.DueDateTo != null ? ((DateTime)ViewBag.DueDateTo).ToString("yyyy-MM-dd") : "")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-3 mt-2">
                                                    <button type="submit" class="btn btn-primary">Filter</button>
                                                    <a href="@Url.Action("Index", "Tasks")" class="btn btn-secondary">Clear</a>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                    
                                    <!-- datatable start -->
                                    <div class="card-datatable table-responsive">
                                        <table id="tasksDataTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Key</th>
                                                    <th>Title</th>
                                                    <th>Assignee</th>
                                                    <th>Priority</th>
                                                    <th>Status</th>
                                                    <th>Created</th>
                                                    <th>Due Date</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>Actions</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "Tasks", new { id = item.ID })">@(item.KeyCode ?? item.ID.ToString())</a>
                                                            </td>
                                                            <td>@(item.Title ?? "")</td>
                                                            <td>@(item.AssigneeFullName ?? "-")</td>
                                                            <td>
                                                                <span class="badge badge-@(item.PriorityName?.ToLower() == "critical" ? "danger" : item.PriorityName?.ToLower() == "high" ? "warning" : "info")">
                                                                    @(item.PriorityName ?? "")
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <span class="badge badge-@(item.StatusName?.ToLower() == "done" ? "success" : item.StatusName?.ToLower() == "in_progress" ? "primary" : "secondary")">
                                                                    @(item.StatusName ?? "")
                                                                </span>
                                                            </td>
                                                            <td>@item.CreatedDT.ToString("yyyy-MM-dd")</td>
                                                            <td>
                                                                @if (item.DueDate.HasValue)
                                                                {
                                                                    <span class="@(item.DueDate.Value < DateTime.Now && item.StatusName?.ToLower() != "done" ? "text-danger" : "")">
                                                                        @item.DueDate.Value.ToString("yyyy-MM-dd")
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span>-</span>
                                                                }
                                                            </td>
                                                            @if (changePermit)
                                                            {
                                                                <td>
                                                                    <div>
                                                                        <a href="@Url.Action("Edit", "Tasks", new { id = item.ID })" title="Edit"><i class="bx bx-edit-alt"></i></a>
                                                                        <a href="@Url.Action("Delete", "Tasks", new { id = item.ID })" title="Delete" onclick="return confirm('Are you sure you want to delete this task?');"><i class="bx bx-trash"></i></a>
                                                                    </div>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="@(changePermit ? 8 : 7)" class="text-center">No tasks found</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <!-- datatable ends -->
                                    
                                    <!-- Pagination -->
                                    @if (ViewBag.TotalPages > 1)
                                    {
                                        <div class="row mt-2">
                                            <div class="col-12">
                                                <nav>
                                                    <ul class="pagination justify-content-center">
                                                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                                        {
                                                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                                                <a class="page-link" href="@Url.Action("Index", "Tasks", new { page = i, pageSize = ViewBag.PageSize, searchTerm = ViewBag.SearchTerm, assigneeUserID = ViewBag.AssigneeUserID_Selected, statusID = ViewBag.StatusID_Selected, priorityID = ViewBag.PriorityID_Selected, dueDateFrom = ViewBag.DueDateFrom, dueDateTo = ViewBag.DueDateTo, sortOrder = ViewBag.SortOrder })">@i</a>
                                                            </li>
                                                        }
                                                    </ul>
                                                </nav>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            var table = $('#tasksDataTable').DataTable({
                "language": {
                    "search": "Search:",
                    "lengthMenu": "Show _MENU_ entries",
                    "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                    "infoEmpty": "No entries",
                    "infoFiltered": "(filtered from _MAX_ total entries)",
                    "paginate": {
                        "first": "First",
                        "last": "Last",
                        "next": "Next",
                        "previous": "Previous"
                    },
                    "zeroRecords": "No matching records found"
                },
                "pageLength": @ViewBag.PageSize,
                "order": [[5, "desc"]]
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
