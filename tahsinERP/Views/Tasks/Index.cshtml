@{
    ViewBag.Title = "Tasks";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = false;
    if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
    {
        changePermit = true;
    }
    
    bool isAdminOrDeveloper = tahsinERP.Models.RoleHelper.IsAdminOrDeveloper(User.Identity.Name);
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Tasks / Vazifalar
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "Tasks")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi Task qo'shish
                            </a>
                        </div>
                    }
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- Search and Filter -->
                                    <div class="users-list-filter px-1">
                                        <form method="get" action="@Url.Action("Index", "Tasks")" id="filterForm">
                                            <input type="hidden" name="showOverdue" id="showOverdue" value="@(ViewBag.ShowOverdue ? "true" : "")" />
                                            <div class="row border rounded py-2 mb-2">
                                                @if (isAdminOrDeveloper)
                                                {
                                                    <div class="col-12 col-sm-6 col-lg-3">
                                                        <label>Assignee</label>
                                                        @Html.DropDownList("assigneeUserID", (SelectList)ViewBag.AssigneeUserID, "All", new { @class = "form-control" })
                                                    </div>
                                                }
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Status</label>
                                                    @Html.DropDownList("statusID", (SelectList)ViewBag.StatusID, "Barchasi", new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Prioritet</label>
                                                    @Html.DropDownList("priorityID", (SelectList)ViewBag.PriorityID, "Barchasi", new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Muddati (dan)</label>
                                                    <input type="date" name="dueDateFrom" class="form-control" value="@(ViewBag.DueDateFrom != null ? ((DateTime)ViewBag.DueDateFrom).ToString("yyyy-MM-dd") : "")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Muddati (gacha)</label>
                                                    <input type="date" name="dueDateTo" class="form-control" value="@(ViewBag.DueDateTo != null ? ((DateTime)ViewBag.DueDateTo).ToString("yyyy-MM-dd") : "")" />
                                                </div>
                                                <div class="col-12 mt-2">
                                                    <button type="submit" class="btn btn-primary">
                                                        <i class="bx bx-filter"></i> Filtrlash
                                                    </button>
                                                    <button type="button" id="btnOverdue" class="btn @(ViewBag.ShowOverdue ? "btn-danger" : "btn-outline-danger")">
                                                        <i class="bx bx-calendar-x"></i> Muddatidan o'tgan
                                                    </button>
                                                    <button type="button" id="btnClear" class="btn btn-secondary">
                                                        <i class="bx bx-x"></i> Tozalash
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- datatable start -->
                                    <div class="card-datatable table-responsive">
                                        <table id="tasksDataTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Kod</th>
                                                    <th>Sarlavha</th>
                                                    <th>Mas'ul</th>
                                                    <th>Prioritet</th>
                                                    <th>Status</th>
                                                    <th>Yaratilgan</th>
                                                    <th>Muddati</th>
                                                    <th class="text-center">Amallar</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                    <!-- datatable ends -->
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>


    <script src="~/Scripts/srm/srm-server-table.js"></script>
    <script>
        $(document).ready(function () {
            // Server-side (TSK-P10): qidiruv, saralash, sahifalash va Excel eksport butun filtr natijasiga ishlaydi
            var detailsUrl = '@Url.Action("Details", "Tasks")/';
            var statusUrl = '@Url.Action("ChangeStatus", "TaskChangeStatus")/';
            var editUrl = '@Url.Action("Edit", "Tasks")/';
            var deleteUrl = '@Url.Action("Delete", "Tasks")/';
            var changePermit = @(changePermit ? "true" : "false");

            function badge(text, cls, style) {
                if (!text) return '';
                return '<span class="badge ' + cls + '"' + (style ? ' style="' + srmEsc(style) + '"' : '') + '>' + srmEsc(text) + '</span>';
            }
            function colorStyle(c) { return c ? 'background-color: ' + c + ' !important; border-color: ' + c + ' !important;' : ''; }

            var table = srmServerTable('#tasksDataTable', {
                dataUrl: '@Url.Action("IndexData", "Tasks")',
                exportUrl: '@Url.Action("ExportExcel", "Tasks")',
                filterForm: '#filterForm',
                order: [[5, 'desc']],
                columns: [
                    { data: 'code', render: function (v, t, r) { return '<a href="' + detailsUrl + r.id + '">' + srmEsc(v) + '</a>'; } },
                    { data: 'title', render: function (v) { return srmEsc(v); } },
                    { data: 'assignee', orderable: false, render: function (v) { return srmEsc(v); } },
                    { data: 'priority', render: function (v, t, r) { return badge(v, 'badge-danger', colorStyle(r.priorityStyle)); } },
                    { data: 'status', render: function (v, t, r) { return badge(v, r.statusClass, r.statusStyle); } },
                    { data: 'created' },
                    { data: 'due', render: function (v, t, r) { return v ? '<span class="' + (r.overdue ? 'text-danger' : '') + '">' + v + '</span>' : '<span>-</span>'; } },
                    {
                        data: null, orderable: false, className: 'text-center', render: function (v, t, r) {
                            var html = '<a href="' + detailsUrl + r.id + '" class="btn btn-sm btn-outline-primary" title="Ko&#39;rish"><i class="bx bx-show"></i></a> '
                                + '<a href="' + statusUrl + r.id + '" class="btn btn-sm btn-outline-info" title="Status o&#39;zgartirish"><i class="bx bx-sync"></i></a> ';
                            if (changePermit) {
                                html += '<a href="' + editUrl + r.id + '" class="btn btn-sm btn-outline-warning" title="Tahrirlash"><i class="bx bx-edit"></i></a> '
                                    + '<a href="#" data-post-url="' + deleteUrl + r.id + '" data-confirm="O&#39;chirishni tasdiqlaysizmi?" class="btn btn-sm btn-outline-danger" title="O&#39;chirish"><i class="bx bx-trash"></i></a>';
                            }
                            return html;
                        }
                    }
                ]
            });

            var initialSearch = @Html.Raw(Json.Encode((string)ViewBag.SearchTerm ?? ""));
            if (initialSearch) table.search(initialSearch).draw();

            $('#filterForm').on('submit', function (e) { e.preventDefault(); table.ajax.reload(); });
            $('#btnOverdue').on('click', function () {
                var on = $('#showOverdue').val() !== 'true';
                $('#showOverdue').val(on ? 'true' : '');
                $(this).toggleClass('btn-danger', on).toggleClass('btn-outline-danger', !on);
                table.ajax.reload();
            });
            $('#btnClear').on('click', function () {
                var form = $('#filterForm');
                form.find('select').val('');
                form.find('input[type=date]').val('');
                $('#showOverdue').val('');
                $('#btnOverdue').removeClass('btn-danger').addClass('btn-outline-danger');
                table.search('').ajax.reload();
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
