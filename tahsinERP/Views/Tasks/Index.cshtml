@model List<tahsinERP.ViewModels.TaskViewModel>
@{
    ViewBag.Title = "Tasks";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = false;
    if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
    {
        changePermit = true;
    }
    
    // Check if user is Admin or Developer
    var userRoles = tahsinERP.Models.RoleHelper.GetUserRoles(User.Identity.Name);
    bool isAdminOrDeveloper = userRoles != null && userRoles.Any(r => 
        r.Equals("Admin", StringComparison.OrdinalIgnoreCase) || 
        r.Equals("Developer", StringComparison.OrdinalIgnoreCase));
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Tasks / Vazifalar
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "Tasks")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi Task qo'shish
                            </a>
                        </div>
                    }
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- Search and Filter -->
                                    <div class="users-list-filter px-1">
                                        <form method="get" action="@Url.Action("Index", "Tasks")" id="filterForm">
                                            <div class="row border rounded py-2 mb-2">
                                                <div class="col-12 col-sm-6 col-lg-3">
                                                    <label>Qidirish</label>
                                                    <input type="text" name="searchTerm" class="form-control" placeholder="Title, Description, Key..." value="@ViewBag.SearchTerm" />
                                                </div>
                                                @if (isAdminOrDeveloper)
                                                {
                                                    <div class="col-12 col-sm-6 col-lg-2">
                                                        <label>Assignee</label>
                                                        @Html.DropDownList("assigneeUserID", (SelectList)ViewBag.AssigneeUserID, "All", new { @class = "form-control" })
                                                    </div>
                                                }
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Status</label>
                                                    @Html.DropDownList("statusID", (SelectList)ViewBag.StatusID, "Barchasi", new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Prioritet</label>
                                                    @Html.DropDownList("priorityID", (SelectList)ViewBag.PriorityID, "Barchasi", new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Muddati (dan)</label>
                                                    <input type="date" name="dueDateFrom" class="form-control" value="@(ViewBag.DueDateFrom != null ? ((DateTime)ViewBag.DueDateFrom).ToString("yyyy-MM-dd") : "")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Muddati (gacha)</label>
                                                    <input type="date" name="dueDateTo" class="form-control" value="@(ViewBag.DueDateTo != null ? ((DateTime)ViewBag.DueDateTo).ToString("yyyy-MM-dd") : "")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-3 mt-2">
                                                    <button type="submit" class="btn btn-primary">
                                                        <i class="bx bx-filter"></i> Filtrlash
                                                    </button>
                                                    <a href="@Url.Action("Index", "Tasks", new { showOverdue = true })" class="btn btn-danger">
                                                        <i class="bx bx-calendar-x"></i> Muddatidan o'tgan
                                                    </a>
                                                    <a href="@Url.Action("Index", "Tasks")" class="btn btn-secondary">
                                                        <i class="bx bx-x"></i> Tozalash
                                                    </a>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                    
                                    <!-- datatable start -->
                                    <div class="card-datatable table-responsive">
                                        <table id="tasksDataTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Kod</th>
                                                    <th>Sarlavha</th>
                                                    <th>Mas'ul</th>
                                                    <th>Prioritet</th>
                                                    <th>Status</th>
                                                    <th>Yaratilgan</th>
                                                    <th>Muddati</th>
                                                    <th class="text-center">Amallar</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "Tasks", new { id = item.ID })">@(item.KeyCode ?? item.ID.ToString())</a>
                                                            </td>
                                                            <td>@(item.Title ?? "")</td>
                                                            <td>@(item.AssigneeFullName ?? "-")</td>
                                                            <td>
                                                                @{
                                                                    string priorityBadgeClass = "badge-danger";
                                                                    string priorityStyle = "";
                                                                    string priorityNameLower = item.PriorityName?.ToLower() ?? "";
                                                                    if (priorityNameLower.Contains("juda muhim") || priorityNameLower.Contains("critical"))
                                                                    {
                                                                        priorityBadgeClass = "badge-danger";
                                                                        priorityStyle = "background-color: #DC3545 !important; border-color: #DC3545 !important;";
                                                                    }
                                                                    else if (priorityNameLower.Contains("muhim") || priorityNameLower.Contains("high"))
                                                                    {
                                                                        priorityBadgeClass = "badge-danger";
                                                                        priorityStyle = "background-color: #FF6666 !important; border-color: #FF6666 !important;";
                                                                    }
                                                                    else if (priorityNameLower.Contains("normal") || priorityNameLower.Contains("medium"))
                                                                    {
                                                                        priorityBadgeClass = "badge-danger";
                                                                        priorityStyle = "background-color: #FFCCCC !important; border-color: #FFCCCC !important;";
                                                                    }
                                                                }
                                                                <span class="badge @priorityBadgeClass" style="@priorityStyle">@(item.PriorityName ?? "")</span>
                                                            </td>
                                                            <td>
                                                                @{
                                                                    string statusBadgeClass = "badge-secondary";
                                                                    string statusStyle = "";
                                                                    string statusNameLower = item.StatusName?.ToLower() ?? "";
                                                                    if (statusNameLower.Contains("bajarildi") || statusNameLower.Contains("done"))
                                                                    {
                                                                        statusBadgeClass = "badge-success";
                                                                        statusStyle = "background-color: #28A745 !important; border-color: #28A745 !important;";
                                                                    }
                                                                    else if (statusNameLower.Contains("jarayonda") || statusNameLower.Contains("in_progress") || statusNameLower.Contains("in progress"))
                                                                    {
                                                                        statusBadgeClass = "badge-warning";
                                                                        statusStyle = "background-color: #FFC107 !important; border-color: #FFC107 !important;";
                                                                    }
                                                                    else if (statusNameLower.Contains("bekor") || statusNameLower.Contains("cancelled") || statusNameLower.Contains("cancel"))
                                                                    {
                                                                        statusBadgeClass = "badge-danger";
                                                                        statusStyle = "background-color: #DC3545 !important; border-color: #DC3545 !important;";
                                                                    }
                                                                    else if (statusNameLower.Contains("rejada") || statusNameLower.Contains("todo") || statusNameLower.Contains("planned"))
                                                                    {
                                                                        statusBadgeClass = "badge-secondary";
                                                                        statusStyle = "background-color: #6C757D !important; border-color: #6C757D !important;";
                                                                    }
                                                                }
                                                                <span class="badge @statusBadgeClass" style="@statusStyle">@(item.StatusName ?? "")</span>
                                                            </td>
                                                            <td>@item.CreatedDT.ToString("yyyy-MM-dd")</td>
                                                            <td>
                                                                @if (item.DueDate.HasValue)
                                                                {
                                                                    <span class="@(item.DueDate.Value < DateTime.Now && item.StatusName?.ToLower() != "done" ? "text-danger" : "")">
                                                                        @item.DueDate.Value.ToString("yyyy-MM-dd")
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span>-</span>
                                                                }
                                                            </td>
                                                            <td class="text-center">
                                                                <a href="@Url.Action("Details", "Tasks", new { id = item.ID })" class="btn btn-sm btn-outline-primary" title="Ko'rish">
                                                                    <i class="bx bx-show"></i>
                                                                </a>
                                                                <a href="@Url.Action("ChangeStatus", "TaskChangeStatus", new { id = item.ID })" class="btn btn-sm btn-outline-info" title="Status o'zgartirish">
                                                                    <i class="bx bx-sync"></i>
                                                                </a>
                                                                @if (changePermit)
                                                                {
                                                                    <a href="@Url.Action("Edit", "Tasks", new { id = item.ID })" class="btn btn-sm btn-outline-warning" title="Tahrirlash">
                                                                        <i class="bx bx-edit"></i>
                                                                    </a>
                                                                    <a href="@Url.Action("Delete", "Tasks", new { id = item.ID })" class="btn btn-sm btn-outline-danger" title="O'chirish" onclick="return confirm('O\'chirishni tasdiqlaysizmi?');">
                                                                        <i class="bx bx-trash"></i>
                                                                    </a>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="8" class="text-center">Vazifalar topilmadi</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <!-- datatable ends -->
                                    
                                    <!-- Pagination -->
                                    @if (ViewBag.TotalPages > 1)
                                    {
                                        <div class="row mt-2">
                                            <div class="col-12">
                                                <nav>
                                                    <ul class="pagination justify-content-center">
                                                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                                        {
                                                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                                                <a class="page-link" href="@Url.Action("Index", "Tasks", new { page = i, pageSize = ViewBag.PageSize, searchTerm = ViewBag.SearchTerm, assigneeUserID = ViewBag.AssigneeUserID_Selected, statusID = ViewBag.StatusID_Selected, priorityID = ViewBag.PriorityID_Selected, dueDateFrom = ViewBag.DueDateFrom, dueDateTo = ViewBag.DueDateTo, sortOrder = ViewBag.SortOrder })">@i</a>
                                                            </li>
                                                        }
                                                    </ul>
                                                </nav>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <!-- DataTables Buttons CSS and JS -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css">
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>

    <script>
        $(document).ready(function() {
            var table = $('#tasksDataTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Uzbek.json",
                    "lengthMenu": "Har sahifada _MENU_ ta yozuv ko'rsatish",
                    "zeroRecords": "Hech qanday yozuv topilmadi",
                    "info": "_START_ dan _END_ gacha, jami _TOTAL_ ta yozuv",
                    "infoEmpty": "Yozuvlar yo'q",
                    "infoFiltered": "(_MAX_ ta yozuvdan filtrlangan)",
                    "search": "Qidirish:",
                    "paginate": {
                        "first": "Birinchi",
                        "last": "Oxirgi",
                        "next": "Keyingi",
                        "previous": "Oldingi"
                    }
                },
                "pageLength": @ViewBag.PageSize,
                "order": [[5, "desc"]],
                "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Barchasi"]],
                "paging": true,
                "pagingType": "full_numbers",
                "info": true,
                "searching": true,
                "responsive": true,
                "processing": true,
                "dom": 'lBfrtip',
                "buttons": [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bx bxs-file-excel"></i> Excel',
                        titleAttr: 'Excelga yuklash',
                        className: 'btn btn-success mr-1',
                        filename: function () {
                            var now = new Date();
                            var dateStr = now.getFullYear() + 
                                String(now.getMonth() + 1).padStart(2, '0') + 
                                String(now.getDate()).padStart(2, '0') + '_' +
                                String(now.getHours()).padStart(2, '0') + 
                                String(now.getMinutes()).padStart(2, '0') + 
                                String(now.getSeconds()).padStart(2, '0');
                            return 'Vazifalar_' + dateStr;
                        },
                        exportOptions: {
                            columns: ':visible',
                            format: {
                                body: function (data, row, column, node) {
                                    return data.replace(/<[^>]*>/g, '').trim();
                                }
                            }
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bx bxs-file-pdf"></i> PDF',
                        titleAttr: 'PDFga yuklash',
                        className: 'btn btn-danger',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        filename: function () {
                            var now = new Date();
                            var dateStr = now.getFullYear() + 
                                String(now.getMonth() + 1).padStart(2, '0') + 
                                String(now.getDate()).padStart(2, '0') + '_' +
                                String(now.getHours()).padStart(2, '0') + 
                                String(now.getMinutes()).padStart(2, '0') + 
                                String(now.getSeconds()).padStart(2, '0');
                            return 'Vazifalar_' + dateStr;
                        },
                        exportOptions: {
                            columns: ':visible',
                            format: {
                                body: function (data, row, column, node) {
                                    return data.replace(/<[^>]*>/g, '').trim();
                                }
                            }
                        },
                        title: 'Vazifalar ro\'yxati',
                        customize: function (doc) {
                            doc.defaultStyle.fontSize = 9;
                            doc.styles.tableHeader.fontSize = 10;
                        }
                    }
                ]
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
