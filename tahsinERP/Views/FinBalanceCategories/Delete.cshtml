@model tahsinERP.Models.FIN_BALANCE_CATEGORIES

@{
    ViewBag.Title = L.T("Fin_DeleteBalanceCategory");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/FinBalanceCategories">@L.T("Fin_BalanceCategories")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Delete")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title text-danger">@L.T("Fin_DeleteBalanceCategory")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="alert alert-warning">
                                        <h5>@L.T("Fin_Attention")</h5>
                                        <p>@L.T("Fin_CategoryDeleteConfirm")</p>
                                        @if (ViewBag.HasChildren)
                                        {
                                            <p class="text-danger"><strong>@L.T("Fin_CategoryHasChildren")</strong></p>
                                        }
                                        @if (ViewBag.HasSnapshots)
                                        {
                                            <p class="text-danger"><strong>@L.T("Fin_CategoryHasSnapshots")</strong></p>
                                        }
                                    </div>
                                    
                                    <dl class="row">
                                        <dt class="col-sm-4">@L.T("Name"):</dt>
                                        <dd class="col-sm-8">@Model.Name</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Type"):</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.Type == 1)
                                            { <span class="badge badge-primary">@L.T("Fin_Asset")</span> }
                                            else if (Model.Type == 2)
                                            { <span class="badge badge-warning">@L.T("Fin_Liability")</span> }
                                            else
                                            { <span class="badge badge-info">@L.T("Fin_Equity")</span> }
                                        </dd>
                                    </dl>
                                    
                                    @using (Html.BeginForm("Delete", "FinBalanceCategories", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", Model.ID)
                                        
                                        <div class="form-actions">
                                            @if (tahsinERP.Services.Common.SystemCodes.IsSystem(Model.SystemCode))
                                            {
                                                <div class="alert alert-danger"><i class="bx bx-lock"></i> @tahsinERP.Services.Common.SystemCodes.DeleteForbiddenMessage</div>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-danger">@L.T("Fin_YesDelete")</button>
                                            }
                                            <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("Cancel")</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
