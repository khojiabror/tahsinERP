@model tahsinERP.Controllers.DiagnosisAISettingsViewModel
@{
    ViewBag.Title = "Diagnosis Page AI settings";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                <li class="breadcrumb-item active">Diagnosis Page AI settings</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-body">
            <section>
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title"><i class="bx bx-brain mr-1"></i>Diagnosis Page AI settings</h4>
                                <p class="mb-0 text-muted">
                                    Bu yerda diagnosis sahifasi uchun AI ga yuboriladigan asosiy prompt matnlarini ko'rasiz.
                                    Keyinroq xohlasangiz, shu struktura bo'yicha DB orqali saqlanadigan dinamik sozlamaga kengaytirish mumkin.
                                </p>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label for="SystemPrompt">1. System prompt (AI roli)</label>
                                    <textarea id="SystemPrompt" class="form-control" rows="2" readonly>@Model.SystemPrompt</textarea>
                                    <small class="form-text text-muted">
                                        AI'ga kim ekanini va qanday rolni bajarishini tushuntiradigan matn.
                                    </small>
                                </div>

                                <div class="form-group">
                                    <label for="ModulesPromptIntro">2. Modullar haqida kirish matni</label>
                                    <textarea id="ModulesPromptIntro" class="form-control" rows="2" readonly>@Model.ModulesPromptIntro</textarea>
                                    <small class="form-text text-muted">
                                        TahsinERP modullari ro'yxati va ularning foydasi haqida qisqacha kirish.
                                    </small>
                                </div>

                                <div class="form-group">
                                    <label for="UserInputInstruction">3. Foydalanuvchi ma'lumotlari bo'yicha ko'rsatma</label>
                                    <textarea id="UserInputInstruction" class="form-control" rows="3" readonly>@Model.UserInputInstruction</textarea>
                                    <small class="form-text text-muted">
                                        Foydalanuvchi kiritgan ma'lumotlar asosida AI qanday natija (muammolar va modullar bo'yicha tavsiya) chiqarishi kerakligini ko'rsatadigan matn.
                                    </small>
                                </div>

                                <hr />
                                <p class="text-muted mb-0">
                                    Hozircha bu sahifa faqat konsepsiya va matnlarni markazlashgan holda ko'rsatish uchun.
                                    Kelajakda shu joyga <strong>saqlash</strong> funksiyasi, model nomi, API kaliti va boshqa AI sozlamalarini ham qo'shish mumkin.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

