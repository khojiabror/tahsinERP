@{
    ViewBag.Title = "Foyda va zarar hisoboti";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var plData = ViewBag.PLData as List<tahsinERP.Controllers.Finance.PLItemData> ?? new List<tahsinERP.Controllers.Finance.PLItemData>();
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "FinDashboard"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">Moliya</li>
                                    <li class="breadcrumb-item active">Foyda va zarar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Foyda va zarar hisoboti</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <form method="get" action="@Url.Action("PL")" class="mb-3">
                                        <div class="row">
                                            <div class="col-md-2">
                                                @Html.DropDownList("year", ViewBag.YearList as SelectList, new { @class = "form-control" })
                                            </div>
                                            <div class="col-md-2">
                                                @Html.DropDownList("month", ViewBag.MonthList as SelectList, new { @class = "form-control" })
                                            </div>
                                            <div class="col-md-2">
                                                <button type="submit" class="btn btn-primary">Ko'rsatish</button>
                                            </div>
                                        </div>
                                    </form>
                                    
                                    <div class="table-responsive">
                                        <table class="table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Element</th>
                                                    <th class="text-right">Haqiqiy</th>
                                                    <th class="text-right">Reja</th>
                                                    <th class="text-right">Farq</th>
                                                    <th class="text-right">Farq %</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in plData)
                                                {
                                                    var varianceClass = item.Variance >= 0 ? "text-success" : "text-danger";
                                                    var variancePercentClass = item.VariancePercent >= 0 ? "text-success" : "text-danger";
                                                    
                                                    <tr>
                                                        <td><strong>@item.Item.Name</strong></td>
                                                        <td class="text-right">@item.Actual.ToString("N2")</td>
                                                        <td class="text-right">@item.Plan.ToString("N2")</td>
                                                        <td class="text-right @varianceClass">@item.Variance.ToString("N2")</td>
                                                        <td class="text-right @variancePercentClass">@item.VariancePercent.ToString("N2")%</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
