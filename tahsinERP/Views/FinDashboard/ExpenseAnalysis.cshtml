@{
    ViewBag.Title = "Chiqimlar tahlili";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "FinDashboard"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">Dashboard</li>
                                    <li class="breadcrumb-item">Moliya Dashboard</li>
                                    <li class="breadcrumb-item active">Chiqimlar tahlili</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Chiqimlar tahlili</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <form method="get" action="@Url.Action("ExpenseAnalysis")" class="mb-3">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label class="control-label">Dan sana:</label>
                                                <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="control-label">Gacha sana:</label>
                                                <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="control-label">&nbsp;</label>
                                                <button type="submit" class="btn btn-primary btn-block">Ko'rsatish</button>
                                            </div>
                                        </div>
                                    </form>

                                    <div class="row mb-3">
                                        <div class="col-md-12">
                                            <div class="stat-card stat-card-outflow">
                                                <div class="stat-card-body">
                                                    <div class="stat-card-title">Jami chiqim</div>
                                                    <div class="stat-card-value">@ViewBag.TotalExpense.ToString("N2")</div>
                                                    <div class="stat-card-currency">@(ViewBag.CurrencyShortname ?? "UZS")</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>Chiqimlar bo'yicha kategoriyalar (Pie Chart)</h5>
                                                </div>
                                                <div class="card-body">
                                                    <canvas id="expenseCategoryPieChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>Chiqimlar bo'yicha hisoblar (Pie Chart)</h5>
                                                </div>
                                                <div class="card-body">
                                                    <canvas id="expenseAccountPieChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-2">
                                        <div class="col-md-12">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>Oylik chiqimlar trendi</h5>
                                                </div>
                                                <div class="card-body">
                                                    <canvas id="monthlyExpenseChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-2">
                                        <div class="col-md-12">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>Chiqimlar jadvali</h5>
                                                </div>
                                                <div class="card-body">
                                                    <div class="table-responsive">
                                                        <table id="expenseTable" class="table table-striped table-bordered" style="width:100%">
                                                            <thead>
                                                                <tr>
                                                                    <th class="text-center">Nº</th>
                                                                    <th>Kategoriya</th>
                                                                    <th class="text-right">Summa</th>
                                                                    <th class="text-right">Foiz</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @if (ViewBag.ExpenseByCategory != null)
                                                                {
                                                                    var expenseData = ViewBag.ExpenseByCategory as List<tahsinERP.Controllers.Finance.ExpenseByCategoryData>;
                                                                    if (expenseData != null)
                                                                    {
                                                                        int index = 1;
                                                                        foreach (var item in expenseData)
                                                                        {
                                                                            <tr>
                                                                                <td class="text-center">@index</td>
                                                                                <td>@(item.CategoryName ?? "-")</td>
                                                                                <td class="text-right">@item.Amount.ToString("N2") @(ViewBag.CurrencyShortname ?? "UZS")</td>
                                                                                <td class="text-right">@item.Percentage.ToString("N2")%</td>
                                                                            </tr>
                                                                            index++;
                                                                        }
                                                                    }
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .stat-card {
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: none;
            overflow: hidden;
        }
        .stat-card-outflow {
            background: linear-gradient(135deg, #ea5455 0%, #d43f3f 100%);
            color: white;
        }
        .stat-card-body {
            padding: 1.5rem;
            text-align: center;
        }
        .stat-card-title {
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            opacity: 0.95;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .stat-card-value {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
            line-height: 1.2;
        }
        .stat-card-currency {
            font-size: 0.85rem;
            font-weight: 500;
            opacity: 0.9;
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Expense by Category Pie Chart
        var expenseCategoryData = @Html.Raw(Json.Encode(ViewBag.ExpenseByCategory));
        var categoryLabels = expenseCategoryData.map(function(item) { return item.CategoryName; });
        var categoryAmounts = expenseCategoryData.map(function(item) { return item.Amount; });

        var categoryPieCtx = document.getElementById('expenseCategoryPieChart').getContext('2d');
        new Chart(categoryPieCtx, {
            type: 'pie',
            data: {
                labels: categoryLabels,
                datasets: [{
                    data: categoryAmounts,
                    backgroundColor: [
                        'rgba(234, 84, 85, 0.8)',
                        'rgba(255, 159, 64, 0.8)',
                        'rgba(255, 205, 86, 0.8)',
                        'rgba(75, 192, 192, 0.8)',
                        'rgba(54, 162, 235, 0.8)',
                        'rgba(153, 102, 255, 0.8)',
                        'rgba(201, 203, 207, 0.8)',
                        'rgba(255, 99, 132, 0.8)'
                    ]
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'right'
                    }
                }
            }
        });

        // Expense by Account Pie Chart
        var expenseAccountData = @Html.Raw(Json.Encode(ViewBag.ExpenseByAccount));
        var accountLabels = expenseAccountData.map(function(item) { return item.AccountName; });
        var accountAmounts = expenseAccountData.map(function(item) { return item.Amount; });

        var accountPieCtx = document.getElementById('expenseAccountPieChart').getContext('2d');
        new Chart(accountPieCtx, {
            type: 'pie',
            data: {
                labels: accountLabels,
                datasets: [{
                    data: accountAmounts,
                    backgroundColor: [
                        'rgba(234, 84, 85, 0.8)',
                        'rgba(255, 159, 64, 0.8)',
                        'rgba(255, 205, 86, 0.8)',
                        'rgba(75, 192, 192, 0.8)',
                        'rgba(54, 162, 235, 0.8)',
                        'rgba(153, 102, 255, 0.8)',
                        'rgba(201, 203, 207, 0.8)',
                        'rgba(255, 99, 132, 0.8)'
                    ]
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'right'
                    }
                }
            }
        });

        // Monthly Expense Trend
        var monthlyExpenseData = @Html.Raw(Json.Encode(ViewBag.MonthlyExpense));
        var monthlyPeriods = monthlyExpenseData.map(function(item) { return item.Period; });
        var monthlyAmounts = monthlyExpenseData.map(function(item) { return item.Amount; });

        var monthlyCtx = document.getElementById('monthlyExpenseChart').getContext('2d');
        new Chart(monthlyCtx, {
            type: 'line',
            data: {
                labels: monthlyPeriods,
                datasets: [{
                    label: 'Chiqimlar',
                    data: monthlyAmounts,
                    borderColor: 'rgb(234, 84, 85)',
                    backgroundColor: 'rgba(234, 84, 85, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // Initialize DataTable
        $(document).ready(function() {
            $('#expenseTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Uzbek.json"
                },
                "order": [[2, "desc"]], // Sort by Amount column
                "pageLength": 25,
                "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Barchasi"]],
                "columnDefs": [
                    { "orderable": true, "targets": [0, 1, 2, 3] },
                    { "type": "num", "targets": [0] },
                    { "type": "num-fmt", "targets": [2, 3] }
                ]
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
