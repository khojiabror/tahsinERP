@{
    ViewBag.Title = (string)ViewBag.Heading;
    Layout = "~/Views/Shared/_Layout.cshtml";
    // FIN-D19: aktivlar (BalanceSheetAssetDetails) va passivlar (BalanceSheetLiabilityDetails) uchun bitta sahifa
    var isLiability = ViewBag.IsLiability as bool? ?? false;
    var totals = isLiability ? ViewBag.Totals as tahsinERP.ViewModels.Finance.BalanceTotals : null;
    var details = ViewBag.Details as List<tahsinERP.ViewModels.Finance.BalanceCategoryDetailData> ?? new List<tahsinERP.ViewModels.Finance.BalanceCategoryDetailData>();
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">@Html.Link(L.T("Menu_Finance"), "FinDashboard", "FinancialOverview")</li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("BalanceSheet", new { asOfDate = ViewBag.AsOfDate != null ? ((DateTime)ViewBag.AsOfDate).ToString("yyyy-MM-dd") : null })">@L.T("Menu_Balance")</a></li>
                                    <li class="breadcrumb-item active">@ViewBag.Heading</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                @Html.Partial("~/Views/FinDashboard/_CurrencyWarning.cshtml")
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">
                                    @ViewBag.Heading - @(ViewBag.AsOfDate != null ? ((DateTime)ViewBag.AsOfDate).ToString("dd.MM.yyyy") : DateTime.Now.ToString("dd.MM.yyyy"))
                                </h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="mb-2">
                                        <strong>@ViewBag.TotalLabel</strong>
                                        @{
                                            // Passivda majburiyatlar musbat; jami = aktiv (taqsimlanmagan foyda bilan) — balans tengligi
                                            var totalDisplay = totals != null
                                                ? totals.PassiveTotal
                                                : details.Sum(d => isLiability ? tahsinERP.Services.Finance.BalanceSheetService.PassiveDisplayAmount(d.Category, d.Amount) : d.Amount);
                                        }
                                        <span class="ml-1">@totalDisplay.ToString("N2")</span>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Category")</th>
                                                    <th>@L.T("Fin_CalculationMethod")</th>
                                                    <th>@L.T("Comment")</th>
                                                    <th class="text-right">@L.T("Fin_TxCount")</th>
                                                    <th class="text-right">@L.T("Fin_Added")</th>
                                                    <th class="text-right">@L.T("Fin_Subtracted")</th>
                                                    <th class="text-right">@L.T("Amount")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in details)
                                                {
                                                    var displayAmount = isLiability
                                                        ? tahsinERP.Services.Finance.BalanceSheetService.PassiveDisplayAmount(item.Category, item.Amount)
                                                        : item.Amount;
                                                    <tr>
                                                        <td>
                                                            @item.Category.Name
                                                            <button type="button"
                                                                    class="btn btn-sm btn-link p-0 ml-1 js-move-info"
                                                                    data-category-id="@item.Category.ID"
                                                                    data-category-name="@item.Category.Name"
                                                                    title="@L.T("Fin_AddedSubtractedDocs")">
                                                                <i class="bx bx-info-circle"></i>
                                                            </button>
                                                        </td>
                                                        <td>@item.CalculationTypeName</td>
                                                        <td>@item.Explanation</td>
                                                        <td class="text-right">@item.TransactionCount</td>
                                                        <td class="text-right">@item.AddedAmount.ToString("N2")</td>
                                                        <td class="text-right">@item.SubtractedAmount.ToString("N2")</td>
                                                        <td class="text-right">@displayAmount.ToString("N2")</td>
                                                    </tr>
                                                }
                                                @if (totals != null)
                                                {
                                                    <tr>
                                                        <td>@L.T("Fin_RetainedEarningsCalc")</td>
                                                        <td>@L.T("Fin_Balancing")</td>
                                                        <td>@L.T("Fin_RetainedEarningsFormula", totals.Assets.ToString("N2"), totals.Liabilities.ToString("N2"), totals.Equity.ToString("N2"))</td>
                                                        <td></td>
                                                        <td></td>
                                                        <td></td>
                                                        <td class="text-right">@totals.RetainedEarnings.ToString("N2")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="modal fade" id="movementModal" tabindex="-1" role="dialog" aria-hidden="true">
                                        <div class="modal-dialog modal-lg" role="document">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">@L.T("Fin_CategoryMovements")</h5>
                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="modal-body">
                                                    <div id="movementLoading" class="text-muted">@L.T("Loading")</div>
                                                    <div id="movementBody" style="display:none;">
                                                        <div id="movementBreakdownWrap" style="display:none;" class="mb-3">
                                                            <h6>@L.T("Fin_CalcWarehousePrice")</h6>
                                                            <p class="small text-muted mb-1" id="movementWarehouseNote"></p>
                                                            <div class="table-responsive">
                                                                <table class="table table-sm table-bordered" id="tblBreakdown">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>@L.T("Code")</th>
                                                                            <th>@L.T("Fin_Product")</th>
                                                                            <th class="text-right">@L.T("Quantity")</th>
                                                                            <th>@L.T("Unit")</th>
                                                                            <th class="text-right">@L.T("Fin_UnitPrice")</th>
                                                                            <th class="text-right">@L.T("Amount")</th>
                                                                            <th>@L.T("Comment")</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody></tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                        <div id="movementTxnWrap">
                                                            <h6>@L.T("Fin_Added") (Top 20)</h6>
                                                            <div class="table-responsive mb-2">
                                                                <table class="table table-sm table-bordered" id="tblAdded">
                                                                    <thead><tr><th>@L.T("Date")</th><th>@L.T("Fin_Document")</th><th>@L.T("Comment")</th><th class="text-right">@L.T("Amount")</th></tr></thead>
                                                                    <tbody></tbody>
                                                                </table>
                                                            </div>
                                                            <h6>@L.T("Fin_Subtracted") (Top 20)</h6>
                                                            <div class="table-responsive">
                                                                <table class="table table-sm table-bordered" id="tblSubtracted">
                                                                    <thead><tr><th>@L.T("Date")</th><th>@L.T("Fin_Document")</th><th>@L.T("Comment")</th><th class="text-right">@L.T("Amount")</th></tr></thead>
                                                                    <tbody></tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

@section scripts
{
    <script type="text/javascript">
        (function () {
            function fmtDate(v) {
                if (v == null || v === '') return '';
                if (typeof v === 'string' && v.indexOf('/Date(') === 0) {
                    var m = /^\/Date\((-?\d+)(?:[+-]\d+)?\)\//.exec(v);
                    if (m) {
                        var d0 = new Date(parseInt(m[1], 10));
                        if (!isNaN(d0.getTime())) return d0.toLocaleDateString('en-GB');
                    }
                }
                var d = new Date(v);
                if (isNaN(d.getTime())) return typeof v === 'string' ? v : '';
                return d.toLocaleDateString('en-GB');
            }
            function esc(v) {
                if (v === null || v === undefined) return '';
                return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
            }
            function fmtNum(v) {
                var n = Number(v || 0);
                return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
            function fillRows(tbody, rows) {
                tbody.innerHTML = '';
                if (!rows || !rows.length) {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">@L.Js("NoData")</td></tr>';
                    return;
                }
                rows.forEach(function (r) {
                    var tr = document.createElement('tr');
                    var rowDate = r.date !== undefined && r.date !== null ? r.date : r.Date;
                    tr.innerHTML = '<td>' + esc(fmtDate(rowDate)) + '</td><td>' + esc(r.doc || r.Doc || '') + '</td><td>' + esc(r.note || r.Note || '') + '</td><td class="text-right">' + fmtNum(r.amount !== undefined ? r.amount : r.Amount) + '</td>';
                    tbody.appendChild(tr);
                });
            }
            function fillBreakdown(tbody, rows) {
                tbody.innerHTML = '';
                if (!rows || !rows.length) {
                    tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">@L.Js("NoData")</td></tr>';
                    return;
                }
                rows.forEach(function (r) {
                    var code = r.ProductCode != null && r.ProductCode !== undefined ? r.ProductCode : (r.productCode || '');
                    var name = r.ProductName != null && r.ProductName !== undefined ? r.ProductName : (r.productName || '');
                    var qty = r.Qty !== undefined && r.Qty !== null ? r.Qty : (r.qty !== undefined ? r.qty : 0);
                    var unit = r.Unit != null && r.Unit !== undefined ? r.Unit : (r.unit || '');
                    var unitPrice = r.UnitPrice !== undefined ? r.UnitPrice : r.unitPrice;
                    var lineTotal = r.LineTotal !== undefined ? r.LineTotal : r.lineTotal;
                    var note = r.Note != null && r.Note !== undefined ? r.Note : (r.note || '');
                    var tr = document.createElement('tr');
                    var up = unitPrice != null && unitPrice !== undefined ? fmtNum(unitPrice) : '—';
                    if (!code && !name && note) {
                        tr.innerHTML = '<td colspan="7" class="text-muted">' + esc(note) + '</td>';
                    } else {
                        tr.innerHTML = '<td>' + esc(code) + '</td><td>' + esc(name) + '</td><td class="text-right">' + fmtNum(qty) + '</td><td>' + esc(unit) + '</td><td class="text-right">' + up + '</td><td class="text-right">' + fmtNum(lineTotal) + '</td><td><small>' + esc(note) + '</small></td>';
                    }
                    tbody.appendChild(tr);
                });
            }
            document.querySelectorAll('.js-move-info').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var categoryId = btn.getAttribute('data-category-id');
                    var asOf = '@(ViewBag.AsOfDate != null ? ((DateTime)ViewBag.AsOfDate).ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))';
                    document.querySelector('#movementModal .modal-title').textContent = (btn.getAttribute('data-category-name') || '') + ' - @L.Js("Fin_MovementsLower")';
                    document.getElementById('movementLoading').style.display = 'block';
                    document.getElementById('movementBody').style.display = 'none';
                    $('#movementModal').modal('show');
                    fetch('@Url.Action("BalanceCategoryMovements", "FinDashboard")' + '?categoryId=' + encodeURIComponent(categoryId) + '&asOfDate=' + encodeURIComponent(asOf))
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            document.getElementById('movementLoading').style.display = 'none';
                            document.getElementById('movementBody').style.display = 'block';
                            var br = document.getElementById('movementBreakdownWrap');
                            var tx = document.getElementById('movementTxnWrap');
                            var whNote = document.getElementById('movementWarehouseNote');
                            if (!data || !data.success) {
                                br.style.display = 'none';
                                tx.style.display = 'block';
                                whNote.textContent = '';
                                document.querySelector('#tblAdded tbody').innerHTML = '<tr><td colspan="4" class="text-danger">@L.Js("Fin_LoadErrorShort")</td></tr>';
                                document.querySelector('#tblSubtracted tbody').innerHTML = '<tr><td colspan="4" class="text-danger">@L.Js("Fin_LoadErrorShort")</td></tr>';
                                return;
                            }
                            if (data.breakdownMode) {
                                br.style.display = 'block';
                                tx.style.display = 'none';
                                whNote.textContent = data.warehouseName ? ('@L.Js("Fin_Warehouse"): ' + data.warehouseName) : '';
                                fillBreakdown(document.querySelector('#tblBreakdown tbody'), data.breakdown || []);
                            } else {
                                br.style.display = 'none';
                                tx.style.display = 'block';
                                whNote.textContent = '';
                                fillRows(document.querySelector('#tblAdded tbody'), data.added);
                                fillRows(document.querySelector('#tblSubtracted tbody'), data.subtracted);
                            }
                        })
                        .catch(function () {
                            document.getElementById('movementLoading').style.display = 'none';
                            document.getElementById('movementBody').style.display = 'block';
                            document.getElementById('movementBreakdownWrap').style.display = 'none';
                            document.getElementById('movementTxnWrap').style.display = 'block';
                            document.getElementById('movementWarehouseNote').textContent = '';
                            document.querySelector('#tblAdded tbody').innerHTML = '<tr><td colspan="4" class="text-danger">@L.Js("Fin_LoadErrorShort")</td></tr>';
                            document.querySelector('#tblSubtracted tbody').innerHTML = '<tr><td colspan="4" class="text-danger">@L.Js("Fin_LoadErrorShort")</td></tr>';
                        });
                });
            });
        })();
    </script>
}
