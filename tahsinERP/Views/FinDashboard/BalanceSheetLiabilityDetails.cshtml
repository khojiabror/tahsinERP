@{
    ViewBag.Title = "Passivlar va Kapital Tafsiloti";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var details = ViewBag.LiabilityDetails as List<tahsinERP.Controllers.Finance.BalanceCategoryDetailData> ?? new List<tahsinERP.Controllers.Finance.BalanceCategoryDetailData>();
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "FinDashboard"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">Moliya</li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("BalanceSheet", new { asOfDate = ViewBag.AsOfDate != null ? ((DateTime)ViewBag.AsOfDate).ToString("yyyy-MM-dd") : null })">Balans</a></li>
                                    <li class="breadcrumb-item active">Passivlar va Kapital Tafsiloti</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">
                                    Passivlar va Kapital Tafsiloti - @(ViewBag.AsOfDate != null ? ((DateTime)ViewBag.AsOfDate).ToString("dd.MM.yyyy") : DateTime.Now.ToString("dd.MM.yyyy"))
                                </h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="mb-2">
                                        <strong>Jami passivlar va kapital:</strong>
                                        @{
                                            var totalDisplay = details.Sum(d =>
                                                d.Category.Type == 2 ? -Math.Abs(d.Amount) : d.Amount);
                                        }
                                        <span class="ml-1">@totalDisplay.ToString("N2")</span>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th>Kategoriya</th>
                                                    <th>Hisoblash usuli</th>
                                                    <th>Izoh</th>
                                                    <th class="text-right">Transaction soni</th>
                                                    <th class="text-right">Qo'shilgan</th>
                                                    <th class="text-right">Ayrilgan</th>
                                                    <th class="text-right">Summa</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in details)
                                                {
                                                    var displayAmount = item.Category.Type == 2
                                                        ? -Math.Abs(item.Amount)
                                                        : item.Amount;
                                                    <tr>
                                                        <td>
                                                            @item.Category.Name
                                                            <button type="button"
                                                                    class="btn btn-sm btn-link p-0 ml-1 js-move-info"
                                                                    data-category-id="@item.Category.ID"
                                                                    data-category-name="@item.Category.Name"
                                                                    title="Qo'shilgan/ayrilgan hujjatlar">
                                                                <i class="bx bx-info-circle"></i>
                                                            </button>
                                                        </td>
                                                        <td>@item.CalculationTypeName</td>
                                                        <td>@item.Explanation</td>
                                                        <td class="text-right">@item.TransactionCount</td>
                                                        <td class="text-right">@item.AddedAmount.ToString("N2")</td>
                                                        <td class="text-right">@item.SubtractedAmount.ToString("N2")</td>
                                                        <td class="text-right">@displayAmount.ToString("N2")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="modal fade" id="movementModal" tabindex="-1" role="dialog" aria-hidden="true">
                                        <div class="modal-dialog modal-lg" role="document">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Kategoriya harakatlari</h5>
                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="modal-body">
                                                    <div id="movementLoading" class="text-muted">Yuklanmoqda...</div>
                                                    <div id="movementBody" style="display:none;">
                                                        <h6>Qo'shilgan (Top 20)</h6>
                                                        <div class="table-responsive mb-2">
                                                            <table class="table table-sm table-bordered" id="tblAdded">
                                                                <thead><tr><th>Sana</th><th>Hujjat</th><th>Izoh</th><th class="text-right">Summa</th></tr></thead>
                                                                <tbody></tbody>
                                                            </table>
                                                        </div>
                                                        <h6>Ayrilgan (Top 20)</h6>
                                                        <div class="table-responsive">
                                                            <table class="table table-sm table-bordered" id="tblSubtracted">
                                                                <thead><tr><th>Sana</th><th>Hujjat</th><th>Izoh</th><th class="text-right">Summa</th></tr></thead>
                                                                <tbody></tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@section scripts
{
    <script type="text/javascript">
        (function () {
            function fmtDate(v) {
                if (!v) return '';
                var d = new Date(v);
                if (isNaN(d)) return v;
                return d.toLocaleDateString('en-GB');
            }
            function fmtNum(v) {
                var n = Number(v || 0);
                return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
            function fillRows(tbody, rows) {
                tbody.innerHTML = '';
                if (!rows || !rows.length) {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">Ma\'lumot yo\'q</td></tr>';
                    return;
                }
                rows.forEach(function (r) {
                    var tr = document.createElement('tr');
                    tr.innerHTML = '<td>' + fmtDate(r.date) + '</td><td>' + (r.doc || '') + '</td><td>' + (r.note || '') + '</td><td class="text-right">' + fmtNum(r.amount) + '</td>';
                    tbody.appendChild(tr);
                });
            }
            document.querySelectorAll('.js-move-info').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var categoryId = btn.getAttribute('data-category-id');
                    var asOf = '@(ViewBag.AsOfDate != null ? ((DateTime)ViewBag.AsOfDate).ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))';
                    document.querySelector('#movementModal .modal-title').textContent = (btn.getAttribute('data-category-name') || '') + ' - harakatlar';
                    document.getElementById('movementLoading').style.display = 'block';
                    document.getElementById('movementBody').style.display = 'none';
                    $('#movementModal').modal('show');
                    fetch('@Url.Action("BalanceCategoryMovements", "FinDashboard")' + '?categoryId=' + encodeURIComponent(categoryId) + '&asOfDate=' + encodeURIComponent(asOf))
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            document.getElementById('movementLoading').style.display = 'none';
                            document.getElementById('movementBody').style.display = 'block';
                            if (!data || !data.success) {
                                document.querySelector('#tblAdded tbody').innerHTML = '<tr><td colspan="4" class="text-danger">Yuklashda xato</td></tr>';
                                document.querySelector('#tblSubtracted tbody').innerHTML = '<tr><td colspan="4" class="text-danger">Yuklashda xato</td></tr>';
                                return;
                            }
                            fillRows(document.querySelector('#tblAdded tbody'), data.added);
                            fillRows(document.querySelector('#tblSubtracted tbody'), data.subtracted);
                        })
                        .catch(function () {
                            document.getElementById('movementLoading').style.display = 'none';
                            document.getElementById('movementBody').style.display = 'block';
                            document.querySelector('#tblAdded tbody').innerHTML = '<tr><td colspan="4" class="text-danger">Yuklashda xato</td></tr>';
                            document.querySelector('#tblSubtracted tbody').innerHTML = '<tr><td colspan="4" class="text-danger">Yuklashda xato</td></tr>';
                        });
                });
            });
        })();
    </script>
}
