@{
    ViewBag.Title = L.T("Menu_Balance");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var balanceData = ViewBag.BalanceData as List<tahsinERP.ViewModels.Finance.BalanceCategoryData> ?? new List<tahsinERP.ViewModels.Finance.BalanceCategoryData>();
    var totals = ViewBag.Totals as tahsinERP.ViewModels.Finance.BalanceTotals;
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">@L.T("Menu_Finance")</li>
                                    <li class="breadcrumb-item active">@L.T("Menu_Balance")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                @Html.Partial("~/Views/FinDashboard/_CurrencyWarning.cshtml")
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Menu_Balance") - @(ViewBag.AsOfDate != null ? ((DateTime)ViewBag.AsOfDate).ToString("dd.MM.yyyy") : DateTime.Now.ToString("dd.MM.yyyy"))</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <form method="get" action="@Url.Action("BalanceSheet")" class="mb-3">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <label class="control-label">@L.T("Date"):</label>
                                                <input type="date" name="asOfDate" class="form-control" value="@(ViewBag.AsOfDate?.ToString("yyyy-MM-dd"))" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="control-label">&nbsp;</label>
                                                <button type="submit" class="btn btn-primary btn-block">@L.T("Fin_Show")</button>
                                            </div>
                                        </div>
                                    </form>
                                    
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h5>@L.T("Fin_Assets")</h5>
                                            <div class="table-responsive">
                                                <table class="table table-striped">
                                                    <thead>
                                                        <tr>
                                                            <th>@L.T("Category")</th>
                                                            <th class="text-right">@L.T("Amount")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in balanceData.Where(b => b.IsAssetColumn))
                                                        {
                                                            <tr>
                                                                <td>@item.Category.Name</td>
                                                                <td class="text-right">@item.Amount.ToString("N2")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <th>@L.T("Fin_TotalAssets"):</th>
                                                            <th class="text-right">
                                                                <a style="text-decoration: underline;"
                                                                   href="@Url.Action("BalanceSheetAssetDetails", new { asOfDate = ViewBag.AsOfDate != null ? ((DateTime)ViewBag.AsOfDate).ToString("yyyy-MM-dd") : null })">
                                                                    @balanceData.Where(b => b.IsAssetColumn).Sum(b => b.Amount).ToString("N2")
                                                                </a>
                                                            </th>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <h5>@L.T("Fin_LiabilitiesAndEquity")</h5>
                                            <div class="table-responsive">
                                                <table class="table table-striped">
                                                    <thead>
                                                        <tr>
                                                            <th>@L.T("Category")</th>
                                                            <th class="text-right">@L.T("Amount")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in balanceData.Where(b => !b.IsAssetColumn))
                                                        {
                                                            @* Majburiyatlar musbat (kredit qoldig'i), kapital o'z belgisida *@
                                                            var displayAmount = tahsinERP.Services.Finance.BalanceSheetService.PassiveDisplayAmount(item.Category, item.Amount);
                                                            <tr>
                                                                <td>@item.Category.Name</td>
                                                                <td class="text-right">@displayAmount.ToString("N2")</td>
                                                            </tr>
                                                        }
                                                        @if (totals != null)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    @L.T("Fin_RetainedEarningsCalc")
                                                                    <small class="d-block text-muted">@L.T("Fin_RetainedEarningsHint")</small>
                                                                </td>
                                                                <td class="text-right">@totals.RetainedEarnings.ToString("N2")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <th>@L.T("Fin_TotalLiabilitiesAndEquity"):</th>
                                                            <th class="text-right">
                                                                @{
                                                                    var totalDisplay = totals != null
                                                                        ? totals.PassiveTotal
                                                                        : balanceData.Where(b => !b.IsAssetColumn).Sum(b => tahsinERP.Services.Finance.BalanceSheetService.PassiveDisplayAmount(b.Category, b.Amount));
                                                                }
                                                                <a style="text-decoration: underline;"
                                                                   href="@Url.Action("BalanceSheetLiabilityDetails", new { asOfDate = ViewBag.AsOfDate != null ? ((DateTime)ViewBag.AsOfDate).ToString("yyyy-MM-dd") : null })">
                                                                    @totalDisplay.ToString("N2")
                                                                </a>
                                                            </th>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                                @if (totals != null)
                                                {
                                                    <p class="small text-muted mt-1 mb-0">@L.T("Fin_BalanceEquation", totals.Assets.ToString("N2"), totals.Liabilities.ToString("N2"), totals.Equity.ToString("N2"), totals.RetainedEarnings.ToString("N2"))</p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
