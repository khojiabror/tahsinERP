@{
    ViewBag.Title = "Majburiyatlar dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var passiveStats = ViewBag.PassiveBalanceStats as List<tahsinERP.ViewModels.Finance.BalanceCategoryDetailData> ?? new List<tahsinERP.ViewModels.Finance.BalanceCategoryDetailData>();
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">Dashboard</li>
                                    <li class="breadcrumb-item">Moliya Dashboard</li>
                                    <li class="breadcrumb-item active">Majburiyatlar dashboard</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <form method="get" action="@Url.Action("LiabilitiesDashboard")" class="mb-3">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="control-label">Dan sana:</label>
                            <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="control-label">Gacha sana:</label>
                            <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="control-label">&nbsp;</label>
                            <button type="submit" class="btn btn-primary btn-block">Ko'rsatish</button>
                        </div>
                    </div>
                </form>

                <!-- Summary Cards -->
                <div class="row mb-3">
                    @if (passiveStats.Count > 0)
                    {
                        foreach (var item in passiveStats)
                        {
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <div class="stat-card stat-card-generic">
                                    <div class="stat-card-body">
                                        <div class="stat-card-title">@item.Category.Name</div>
                                        <div class="stat-card-value">@item.Amount.ToString("N2")</div>
                                        <div class="stat-card-currency">@(ViewBag.CurrencyShortname ?? "UZS")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Payables Section -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Ta'minotchilardan qarzlar (Payables)</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>Ta'minotchilar bo'yicha (Pie Chart)</h5>
                                                </div>
                                                <div class="card-body">
                                                    <canvas id="payablesBySupplierChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>Oylik trend</h5>
                                                </div>
                                                <div class="card-body">
                                                    <canvas id="monthlyPayablesChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-2">
                                        <div class="col-md-12">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>Payables account qoldiqlari</h5>
                                                </div>
                                                <div class="card-body">
                                                    <div class="table-responsive">
                                                        <table id="payablesAccountsTable" class="table table-striped table-bordered" style="width:100%">
                                                            <thead>
                                                                <tr>
                                                                    <th class="text-center">Nº</th>
                                                                    <th class="text-center">Hisob raqam</th>
                                                                    <th>Hisob nomi</th>
                                                                    <th class="text-right" style="background-color: #e3f2fd;">Kirim</th>
                                                                    <th class="text-right" style="background-color: #ffebee;">Chiqim</th>
                                                                    <th class="text-right" style="background-color: #e8f5e9; font-weight: bold;">Qoldiq</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @if (ViewBag.PayablesAccountBalances != null)
                                                                {
                                                                    var balances = ViewBag.PayablesAccountBalances as List<tahsinERP.ViewModels.Finance.AccountBalanceData>;
                                                                    if (balances != null)
                                                                    {
                                                                        int index = 1;
                                                                        foreach (var item in balances)
                                                                        {
                                                                            var qoldiqClass = item.Qoldiq >= 0 ? "text-success" : "text-danger";
                                                                            var currency = item.CurrencyShortname ?? "UZS";
                                                                            <tr>
                                                                                <td class="text-center">@index</td>
                                                                                <td class="text-center">@(item.AccountCode ?? "-")</td>
                                                                                <td>@(item.AccountName ?? "-")</td>
                                                                                <td class="text-right" style="background-color: #e3f2fd;">
                                                                                    @item.Kirim.ToString("N2") @currency
                                                                                </td>
                                                                                <td class="text-right" style="background-color: #ffebee;">
                                                                                    @item.Chiqim.ToString("N2") @currency
                                                                                </td>
                                                                                <td class="text-right" style="background-color: #e8f5e9; font-weight: bold;">
                                                                                    <span class="@qoldiqClass">@item.Qoldiq.ToString("N2") @currency</span>
                                                                                </td>
                                                                            </tr>
                                                                            index++;
                                                                        }
                                                                    }
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payroll Liabilities Trend -->
                <div class="row mt-2">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Oyliklardan qarzimiz (Trend)</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <canvas id="monthlyPayrollLiabilityChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Receivables Section -->
                <div class="row mt-2">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Xaridorlardan haqlarimiz (Receivables)</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>Xaridorlar bo'yicha (Pie Chart)</h5>
                                                </div>
                                                <div class="card-body">
                                                    <canvas id="receivablesByCustomerChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>Oylik trend</h5>
                                                </div>
                                                <div class="card-body">
                                                    <canvas id="monthlyReceivablesChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-2">
                                        <div class="col-md-12">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>Receivables account qoldiqlari</h5>
                                                </div>
                                                <div class="card-body">
                                                    <div class="table-responsive">
                                                        <table id="receivablesAccountsTable" class="table table-striped table-bordered" style="width:100%">
                                                            <thead>
                                                                <tr>
                                                                    <th class="text-center">Nº</th>
                                                                    <th class="text-center">Hisob raqam</th>
                                                                    <th>Hisob nomi</th>
                                                                    <th class="text-right" style="background-color: #e3f2fd;">Kirim</th>
                                                                    <th class="text-right" style="background-color: #ffebee;">Chiqim</th>
                                                                    <th class="text-right" style="background-color: #e8f5e9; font-weight: bold;">Qoldiq</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @if (ViewBag.ReceivablesAccountBalances != null)
                                                                {
                                                                    var balances = ViewBag.ReceivablesAccountBalances as List<tahsinERP.ViewModels.Finance.AccountBalanceData>;
                                                                    if (balances != null)
                                                                    {
                                                                        int index = 1;
                                                                        foreach (var item in balances)
                                                                        {
                                                                            var qoldiqClass = item.Qoldiq >= 0 ? "text-success" : "text-danger";
                                                                            var currency = item.CurrencyShortname ?? "UZS";
                                                                            <tr>
                                                                                <td class="text-center">@index</td>
                                                                                <td class="text-center">@(item.AccountCode ?? "-")</td>
                                                                                <td>@(item.AccountName ?? "-")</td>
                                                                                <td class="text-right" style="background-color: #e3f2fd;">
                                                                                    @item.Kirim.ToString("N2") @currency
                                                                                </td>
                                                                                <td class="text-right" style="background-color: #ffebee;">
                                                                                    @item.Chiqim.ToString("N2") @currency
                                                                                </td>
                                                                                <td class="text-right" style="background-color: #e8f5e9; font-weight: bold;">
                                                                                    <span class="@qoldiqClass">@item.Qoldiq.ToString("N2") @currency</span>
                                                                                </td>
                                                                            </tr>
                                                                            index++;
                                                                        }
                                                                    }
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .stat-card {
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: none;
            overflow: hidden;
        }
        .stat-card-payables {
            background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
            color: white;
        }
        .stat-card-receivables {
            background: linear-gradient(135deg, #2196f3 0%, #1976d2 100%);
            color: white;
        }
        .stat-card-payroll {
            background: linear-gradient(135deg, #8e24aa 0%, #5e35b1 100%);
            color: white;
        }
        .stat-card-generic {
            background: linear-gradient(135deg, #546e7a 0%, #37474f 100%);
            color: white;
        }
        .stat-card-body {
            padding: 1.5rem;
            text-align: center;
        }
        .stat-card-title {
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            opacity: 0.95;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .stat-card-value {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
            line-height: 1.2;
        }
        .stat-card-currency {
            font-size: 0.85rem;
            font-weight: 500;
            opacity: 0.9;
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Payables by Supplier Pie Chart
            var payablesBySupplierData = @Html.Raw(Json.Encode(ViewBag.PayablesBySupplier));
            if (payablesBySupplierData && payablesBySupplierData.length > 0) {
                var supplierLabels = payablesBySupplierData.map(function(item) { return item.SupplierName; });
                var supplierAmounts = payablesBySupplierData.map(function(item) { return item.Amount; });

                var payablesPieCtx = document.getElementById('payablesBySupplierChart').getContext('2d');
                new Chart(payablesPieCtx, {
                    type: 'pie',
                    data: {
                        labels: supplierLabels,
                        datasets: [{
                            data: supplierAmounts,
                            backgroundColor: [
                                'rgba(255, 152, 0, 0.8)',
                                'rgba(255, 193, 7, 0.8)',
                                'rgba(255, 235, 59, 0.8)',
                                'rgba(255, 87, 34, 0.8)',
                                'rgba(244, 67, 54, 0.8)',
                                'rgba(156, 39, 176, 0.8)',
                                'rgba(103, 58, 183, 0.8)',
                                'rgba(63, 81, 181, 0.8)'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                position: 'right'
                            }
                        }
                    }
                });
            }

            // Receivables by Customer Pie Chart
            var receivablesByCustomerData = @Html.Raw(Json.Encode(ViewBag.ReceivablesByCustomer));
            if (receivablesByCustomerData && receivablesByCustomerData.length > 0) {
                var customerLabels = receivablesByCustomerData.map(function(item) { return item.CustomerName; });
                var customerAmounts = receivablesByCustomerData.map(function(item) { return item.Amount; });

                var receivablesPieCtx = document.getElementById('receivablesByCustomerChart').getContext('2d');
                new Chart(receivablesPieCtx, {
                    type: 'pie',
                    data: {
                        labels: customerLabels,
                        datasets: [{
                            data: customerAmounts,
                            backgroundColor: [
                                'rgba(33, 150, 243, 0.8)',
                                'rgba(3, 169, 244, 0.8)',
                                'rgba(0, 188, 212, 0.8)',
                                'rgba(0, 150, 136, 0.8)',
                                'rgba(76, 175, 80, 0.8)',
                                'rgba(139, 195, 74, 0.8)',
                                'rgba(205, 220, 57, 0.8)',
                                'rgba(255, 235, 59, 0.8)'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                position: 'right'
                            }
                        }
                    }
                });
            }

            // Monthly Payables Trend
            var monthlyPayablesData = @Html.Raw(Json.Encode(ViewBag.MonthlyPayables));
            if (monthlyPayablesData && monthlyPayablesData.length > 0) {
                var payablesPeriods = monthlyPayablesData.map(function(item) { return item.Period; });
                var payablesAmounts = monthlyPayablesData.map(function(item) { return item.Amount; });

                var monthlyPayablesCtx = document.getElementById('monthlyPayablesChart').getContext('2d');
                new Chart(monthlyPayablesCtx, {
                    type: 'line',
                    data: {
                        labels: payablesPeriods,
                        datasets: [{
                            label: 'Ta\'minotchilardan qarzlar',
                            data: payablesAmounts,
                            borderColor: 'rgb(255, 152, 0)',
                            backgroundColor: 'rgba(255, 152, 0, 0.1)',
                            tension: 0.4,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            }

            // Monthly Receivables Trend
            var monthlyReceivablesData = @Html.Raw(Json.Encode(ViewBag.MonthlyReceivables));
            if (monthlyReceivablesData && monthlyReceivablesData.length > 0) {
                var receivablesPeriods = monthlyReceivablesData.map(function(item) { return item.Period; });
                var receivablesAmounts = monthlyReceivablesData.map(function(item) { return item.Amount; });

                var monthlyReceivablesCtx = document.getElementById('monthlyReceivablesChart').getContext('2d');
                new Chart(monthlyReceivablesCtx, {
                    type: 'line',
                    data: {
                        labels: receivablesPeriods,
                        datasets: [{
                            label: 'Xaridorlardan haqlarimiz',
                            data: receivablesAmounts,
                            borderColor: 'rgb(33, 150, 243)',
                            backgroundColor: 'rgba(33, 150, 243, 0.1)',
                            tension: 0.4,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            }

            // Monthly Payroll Liability Trend
            var monthlyPayrollLiabilityData = @Html.Raw(Json.Encode(ViewBag.MonthlyPayrollLiability));
            if (monthlyPayrollLiabilityData && monthlyPayrollLiabilityData.length > 0) {
                var payrollPeriods = monthlyPayrollLiabilityData.map(function(item) { return item.Period; });
                var payrollAmounts = monthlyPayrollLiabilityData.map(function(item) { return item.Amount; });

                var monthlyPayrollLiabilityCtx = document.getElementById('monthlyPayrollLiabilityChart').getContext('2d');
                new Chart(monthlyPayrollLiabilityCtx, {
                    type: 'line',
                    data: {
                        labels: payrollPeriods,
                        datasets: [{
                            label: 'Oyliklardan qarzimiz',
                            data: payrollAmounts,
                            borderColor: 'rgb(142, 36, 170)',
                            backgroundColor: 'rgba(142, 36, 170, 0.1)',
                            tension: 0.4,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            }

            // Initialize DataTables (only if jQuery + DataTables are available)
            if (window.jQuery && $.fn && $.fn.DataTable) {
                $('#payablesAccountsTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Uzbek.json"
                    },
                    "order": [[5, "desc"]],
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Barchasi"]]
                });

                $('#receivablesAccountsTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Uzbek.json"
                    },
                    "order": [[5, "desc"]],
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Barchasi"]]
                });
            }
        });
    </script>

