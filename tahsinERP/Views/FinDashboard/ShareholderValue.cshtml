@{
    ViewBag.Title = "Kompaniya qiymati";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var shareholderValues = ViewBag.ShareholderValues as List<tahsinERP.Controllers.Finance.ShareholderValueData> ?? new List<tahsinERP.Controllers.Finance.ShareholderValueData>();
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "Shareholder"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">Moliya</li>
                                    <li class="breadcrumb-item active">Kompaniya qiymati</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Kompaniya qiymati - @ViewBag.AsOfDate?.ToString("dd.MM.yyyy")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <form method="get" action="@Url.Action("ShareholderValue")" class="mb-3">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <label class="control-label">Sana:</label>
                                                <input type="date" name="asOfDate" class="form-control" value="@(ViewBag.AsOfDate?.ToString("yyyy-MM-dd"))" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="control-label">&nbsp;</label>
                                                <button type="submit" class="btn btn-primary btn-block">Ko'rsatish</button>
                                            </div>
                                        </div>
                                    </form>
                                    
                                    <div class="row mb-3">
                                        <div class="col-md-12">
                                            <div class="card bg-primary text-white">
                                                <div class="card-body text-center">
                                                    <h3 style="color:white;">Jami kompaniya qiymati</h3>
                                                    <h2 style="color:white;">@ViewBag.CompanyValue.ToString("N2")</h2>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="table-responsive">
                                        <table class="table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Aksiyador</th>
                                                    <th class="text-right">Ulush %</th>
                                                    <th class="text-right">Qiymati</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var shValue in shareholderValues)
                                                {
                                                    <tr>
                                                        <td>@shValue.Shareholder.FullName</td>
                                                        <td class="text-right">@shValue.SharePercent%</td>
                                                        <td class="text-right"><strong>@shValue.Value.ToString("N2")</strong></td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <th>Jami:</th>
                                                    <th class="text-right">@shareholderValues.Sum(s => s.SharePercent)%</th>
                                                    <th class="text-right">@shareholderValues.Sum(s => s.Value).ToString("N2")</th>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
