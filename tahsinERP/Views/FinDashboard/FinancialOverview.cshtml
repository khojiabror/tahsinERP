@{
    ViewBag.Title = L.T("Fin_OverviewTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">@L.T("Menu_Dashboard")</li>
                                    <li class="breadcrumb-item">@L.T("Menu_DashFinance")</li>
                                    <li class="breadcrumb-item active">@L.T("Menu_Overview")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                @Html.Partial("~/Views/FinDashboard/_CurrencyWarning.cshtml")
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Fin_OverviewTitle")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <form method="get" action="@Url.Action("FinancialOverview")" class="mb-3">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label class="control-label">@L.T("Fin_DateFrom"):</label>
                                                <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="control-label">@L.T("Fin_DateTo"):</label>
                                                <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="control-label">&nbsp;</label>
                                                <button type="submit" class="btn btn-primary btn-block">@L.T("Fin_Show")</button>
                                            </div>
                                        </div>
                                    </form>

                                    <!-- Summary Cards -->
                                    <div class="row mb-3">
                                        <div class="col-md-3">
                                            <div class="stat-card stat-card-inflow">
                                                <div class="stat-card-body">
                                                    <div class="stat-card-title">@L.T("Fin_TotalIncome")</div>
                                                    <div class="stat-card-value">@ViewBag.TotalIncome.ToString("N2")</div>
                                                    <div class="stat-card-currency">@(ViewBag.CurrencyShortname ?? "UZS")</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="stat-card stat-card-outflow">
                                                <div class="stat-card-body">
                                                    <div class="stat-card-title">@L.T("Fin_TotalExpense")</div>
                                                    <div class="stat-card-value">@ViewBag.TotalExpense.ToString("N2")</div>
                                                    <div class="stat-card-currency">@(ViewBag.CurrencyShortname ?? "UZS")</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="stat-card stat-card-net">
                                                <div class="stat-card-body">
                                                    <div class="stat-card-title">@L.T("Fin_NetCashflow")</div>
                                                    <div class="stat-card-value">@ViewBag.NetCashflow.ToString("N2")</div>
                                                    <div class="stat-card-currency">@(ViewBag.CurrencyShortname ?? "UZS")</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="stat-card stat-card-balance">
                                                <div class="stat-card-body">
                                                    <div class="stat-card-title">@L.T("Fin_CurrentBalance")</div>
                                                    <div class="stat-card-value">@((ViewBag.CashBalance + ViewBag.BankBalance).ToString("N2"))</div>
                                                    <div class="stat-card-currency">@(ViewBag.CurrencyShortname ?? "UZS")</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>@L.T("Fin_MonthlyTrend")</h5>
                                                </div>
                                                <div class="card-body">
                                                    <canvas id="monthlyTrendChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>@L.T("Fin_TopExpenseCategories")</h5>
                                                </div>
                                                <div class="card-body">
                                                    <canvas id="topExpenseChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-2">
                                        <div class="col-md-6">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>@L.T("Fin_TopIncomeCategories")</h5>
                                                </div>
                                                <div class="card-body">
                                                    <canvas id="topIncomeChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5>@L.T("Fin_BalanceDetails")</h5>
                                                </div>
                                                <div class="card-body">
                                                    <table class="table table-striped">
                                                        <tr>
                                                            <td><strong>@L.T("Fin_CashBalance"):</strong></td>
                                                            <td class="text-right">@ViewBag.CashBalance.ToString("N2") @(ViewBag.CurrencyShortname ?? "UZS")</td>
                                                        </tr>
                                                        <tr>
                                                            <td><strong>@L.T("Fin_BankBalance"):</strong></td>
                                                            <td class="text-right">@ViewBag.BankBalance.ToString("N2") @(ViewBag.CurrencyShortname ?? "UZS")</td>
                                                        </tr>
                                                        <tr>
                                                            <td><strong>@L.T("Fin_TotalBalance"):</strong></td>
                                                            <td class="text-right"><strong>@((ViewBag.CashBalance + ViewBag.BankBalance).ToString("N2")) @(ViewBag.CurrencyShortname ?? "UZS")</strong></td>
                                                        </tr>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <link href="~/Content/fin-dashboard.css" rel="stylesheet" />
    <style>
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15); }
    </style>

    @Html.Partial("_ChartJs")
    <script>
        // Monthly Trend Chart
        var monthlyData = @Html.Raw(Json.Encode(ViewBag.MonthlyData));
        var monthlyPeriods = monthlyData.map(function(item) { return item.Period; });
        var monthlyIncome = monthlyData.map(function(item) { return item.Income; });
        var monthlyExpense = monthlyData.map(function(item) { return item.Expense; });

        var monthlyCtx = document.getElementById('monthlyTrendChart').getContext('2d');
        new Chart(monthlyCtx, {
            type: 'line',
            data: {
                labels: monthlyPeriods,
                datasets: [{
                    label: '@L.Js("Fin_Inflow")',
                    data: monthlyIncome,
                    borderColor: 'rgb(40, 199, 111)',
                    backgroundColor: 'rgba(40, 199, 111, 0.1)',
                    tension: 0.4
                }, {
                    label: '@L.Js("Fin_Expense")',
                    data: monthlyExpense,
                    borderColor: 'rgb(234, 84, 85)',
                    backgroundColor: 'rgba(234, 84, 85, 0.1)',
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // Top Expense Categories Chart
        var topExpenseData = @Html.Raw(Json.Encode(ViewBag.TopExpenseCategories));
        var expenseLabels = topExpenseData.map(function(item) { return item.CategoryName; });
        var expenseAmounts = topExpenseData.map(function(item) { return item.Amount; });

        var expenseCtx = document.getElementById('topExpenseChart').getContext('2d');
        new Chart(expenseCtx, {
            type: 'bar',
            data: {
                labels: expenseLabels,
                datasets: [{
                    label: '@L.Js("Fin_Expense")',
                    data: expenseAmounts,
                    backgroundColor: 'rgba(234, 84, 85, 0.8)',
                    borderColor: 'rgb(234, 84, 85)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // Top Income Categories Chart
        var topIncomeData = @Html.Raw(Json.Encode(ViewBag.TopIncomeCategories));
        var incomeLabels = topIncomeData.map(function(item) { return item.CategoryName; });
        var incomeAmounts = topIncomeData.map(function(item) { return item.Amount; });

        var incomeCtx = document.getElementById('topIncomeChart').getContext('2d');
        new Chart(incomeCtx, {
            type: 'bar',
            data: {
                labels: incomeLabels,
                datasets: [{
                    label: '@L.Js("Fin_Inflow")',
                    data: incomeAmounts,
                    backgroundColor: 'rgba(40, 199, 111, 0.8)',
                    borderColor: 'rgb(40, 199, 111)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
