@model IEnumerable<string>
@{
    ViewBag.Title = L.T("Core_PmDefaultsTitle");
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/PModule">@L.T("Core_PmModules")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Core_PmDefaults")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                <section class="invoice-list-wrapper">
                    <div class="invoice-create-btn mb-1">
                        <a href="@Url.Action("Index", "PModule")" class="btn btn-outline-secondary">
                            <i class="bx bx-arrow-back"></i> @L.T("Back")
                        </a>
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- Controls -->
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <input type="text" id="searchBox" class="form-control form-control-sm" placeholder="@L.T("SearchPlaceholder")" style="width: 100%; max-width: 300px; display: inline-block;">
                                        </div>
                                        <div class="col-md-6 text-right">
                                            <select id="pageSize" class="form-control form-control-sm d-inline-block" style="width: 120px;">
                                                <option value="10">10</option>
                                                <option value="25" selected>25</option>
                                                <option value="50">50</option>
                                                <option value="100">100</option>
                                                <option value="-1">@L.T("All")</option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Table -->
                                    <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                                        <table class="table table-striped table-bordered table-hover" id="missingControllerTable">
                                            <thead class="thead-light sticky-top">
                                                <tr>
                                                    <th>Controller</th>
                                                    @if (changePermit)
                                                    {
                                                        <th class="text-center">@L.T("Actions")</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody id="tableBody">
                                                @foreach (var controller in Model)
                                                {
                                                    <tr class="data-row">
                                                        <td><code class="small">@controller</code></td>
                                                        @if (changePermit)
                                                        {
                                                            <td class="text-center">
                                                                @using (Html.BeginForm("CreateDefaultModules", "PModule", FormMethod.Post, new { @class = "d-inline" }))
                                                                {
                                                                    @Html.AntiForgeryToken()
                                                                    @Html.Hidden("controllerName", controller)
                                                                    <button type="submit" class="btn btn-sm btn-warning" title="@L.T("Core_PmCreateDefaults")">
                                                                        <i class="bx bx-plus-circle"></i> @L.T("Create")
                                                                    </button>
                                                                }
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- Pagination -->
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <div id="paginationInfo" class="text-muted"></div>
                                        </div>
                                        <div class="col-md-6">
                                            <nav>
                                                <ul class="pagination justify-content-end mb-0" id="pagination"></ul>
                                            </nav>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <style>
        .data-row {
            display: table-row;
        }
        .data-row.hidden {
            display: none;
        }
        #missingControllerTable thead th {
            position: sticky;
            top: 0;
            background-color: #f8f9fa;
            z-index: 10;
        }
        .pagination .page-link {
            cursor: pointer;
        }
        .pagination .page-item.active .page-link {
            background-color: var(--accent);
            border-color: var(--accent);
        }
        #searchBox {
            border-radius: 0.25rem;
        }
    </style>

    <script>
        (function() {
            var currentPage = 1;
            var pageSize = 25;
            var allRows = [];
            var filteredRows = [];

            function init() {
                allRows = Array.from(document.querySelectorAll('.data-row'));
                filteredRows = allRows;
                updatePageSize();
                renderTable();
                setupEventListeners();
            }

            function setupEventListeners() {
                document.getElementById('searchBox').addEventListener('input', function() {
                    var searchTerm = this.value.toLowerCase();
                    filteredRows = allRows.filter(function(row) {
                        var text = row.textContent.toLowerCase();
                        return text.indexOf(searchTerm) > -1;
                    });
                    currentPage = 1;
                    renderTable();
                });

                document.getElementById('pageSize').addEventListener('change', function() {
                    pageSize = parseInt(this.value);
                    if (pageSize === -1) pageSize = filteredRows.length;
                    currentPage = 1;
                    renderTable();
                });
            }

            function updatePageSize() {
                var select = document.getElementById('pageSize');
                var value = select.value;
                if (value === '-1') {
                    pageSize = filteredRows.length;
                } else {
                    pageSize = parseInt(value);
                }
            }

            function renderTable() {
                updatePageSize();
                var total = filteredRows.length;
                var totalPages = Math.ceil(total / pageSize);
                if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                var start = (currentPage - 1) * pageSize;
                var end = start + pageSize;

                allRows.forEach(function(row) {
                    row.classList.add('hidden');
                });

                filteredRows.slice(start, end).forEach(function(row) {
                    row.classList.remove('hidden');
                });

                updatePagination(total, totalPages);
                updateInfo(total, start, end);
            }

            function updatePagination(total, totalPages) {
                var pagination = document.getElementById('pagination');
                pagination.innerHTML = '';

                if (totalPages <= 1) return;

                var prev = document.createElement('li');
                prev.className = 'page-item' + (currentPage === 1 ? ' disabled' : '');
                var prevLink = document.createElement('a');
                prevLink.className = 'page-link';
                prevLink.href = '#';
                prevLink.textContent = erpT('Dt_Previous');
                prevLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (currentPage > 1) {
                        currentPage--;
                        renderTable();
                    }
                    return false;
                });
                prev.appendChild(prevLink);
                pagination.appendChild(prev);

                var dotsAdded = false;
                for (var i = 1; i <= totalPages; i++) {
                    if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                        dotsAdded = false;
                        var li = document.createElement('li');
                        li.className = 'page-item' + (i === currentPage ? ' active' : '');
                        var link = document.createElement('a');
                        link.className = 'page-link';
                        link.href = '#';
                        link.textContent = i;
                        link.setAttribute('data-page', i);
                        link.addEventListener('click', (function(pageNum) {
                            return function(e) {
                                e.preventDefault();
                                e.stopPropagation();
                                currentPage = pageNum;
                                renderTable();
                                return false;
                            };
                        })(i));
                        li.appendChild(link);
                        pagination.appendChild(li);
                    } else if (!dotsAdded && (i === currentPage - 3 || i === currentPage + 3)) {
                        dotsAdded = true;
                        var dots = document.createElement('li');
                        dots.className = 'page-item disabled';
                        dots.innerHTML = '<span class="page-link">...</span>';
                        pagination.appendChild(dots);
                    }
                }

                var next = document.createElement('li');
                next.className = 'page-item' + (currentPage === totalPages ? ' disabled' : '');
                var nextLink = document.createElement('a');
                nextLink.className = 'page-link';
                nextLink.href = '#';
                nextLink.textContent = erpT('Dt_Next');
                nextLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (currentPage < totalPages) {
                        currentPage++;
                        renderTable();
                    }
                    return false;
                });
                next.appendChild(nextLink);
                pagination.appendChild(next);
            }

            function updateInfo(total, start, end) {
                var info = document.getElementById('paginationInfo');
                if (total === 0) {
                    info.textContent = erpT('Dt_InfoEmpty');
                } else {
                    info.textContent = erpT('Dt_Info').replace('_TOTAL_', total).replace('_START_', start + 1).replace('_END_', Math.min(end, total));
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
