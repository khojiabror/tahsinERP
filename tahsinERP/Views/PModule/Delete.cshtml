@model tahsinERP.ViewModels.PermissionModuleViewModel
@{
    ViewBag.Title = "Modulni o'chirish";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/PModule">Ruxsat modullari</a></li>
                                    <li class="breadcrumb-item active">@Model.Module</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row">
                    <div class="col-md-8 col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title"><i class="bx bx-trash mr-1"></i>Modulni o'chirish</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="alert alert-warning">
                                        <i class="bx bx-error-circle"></i>
                                        <strong>Diqqat!</strong> Siz ushbu modulni o'chirishni xohlaysizmi?
                                    </div>

                                    <div class="form-group">
                                        <label><strong>Modul nomi:</strong></label>
                                        <p class="form-control-plaintext">@Model.Module</p>
                                    </div>

                                    <div class="form-group">
                                        <label><strong>Controller:</strong></label>
                                        <p class="form-control-plaintext"><code>@Model.Controller</code></p>
                                    </div>

                                    <div class="form-group">
                                        <label><strong>Action:</strong></label>
                                        <p class="form-control-plaintext"><code>@Model.Action</code></p>
                                    </div>

                                    @if (!string.IsNullOrEmpty(Model.Parametr))
                                    {
                                        <div class="form-group">
                                            <label><strong>Parametr:</strong></label>
                                            <p class="form-control-plaintext">@Model.Parametr</p>
                                        </div>
                                    }

                                    <div class="form-group">
                                        <label><strong>Rollar:</strong></label>
                                        <p class="form-control-plaintext">
                                            @if (!string.IsNullOrEmpty(Model.RoleNames))
                                            {
                                                foreach (var role in Model.RoleNames.Split(',').Select(r => r.Trim()))
                                                {
                                                    <span class="badge badge-light-primary mr-1">@role</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">Rollar yo'q</span>
                                            }
                                        </p>
                                    </div>

                                    @if (ViewBag.PermissionsCount != null && (int)ViewBag.PermissionsCount > 0)
                                    {
                                        <div class="alert alert-info">
                                            <i class="bx bx-info-circle"></i>
                                            Bu modulga biriktirilgan <strong>@ViewBag.PermissionsCount</strong> ta permission mavjud. 
                                            Modul o'chirilganda, barcha permissionlar ham o'chiriladi.
                                        </div>
                                    }

                                    @using (Html.BeginForm("Delete", "PModule", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(model => model.ID)

                                        <div class="form-group">
                                            <button type="submit" class="btn btn-danger">
                                                <i class="bx bx-trash"></i> Ha, o'chirish
                                            </button>
                                            <a href="@Url.Action("Index", "PModule")" class="btn btn-outline-secondary">
                                                <i class="bx bx-x"></i> Bekor qilish
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
