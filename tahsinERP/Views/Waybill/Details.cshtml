@model tahsinERP.Models.F_WAYBILLS
@using tahsinERP.Services
@{
    ViewBag.Title = L.T("Log_WaybillDetailsTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currencyShortname = Model.CURRENCy?.Shortname ?? "";
    var totalPaid = (ViewBag.TotalPaid as decimal?) ?? 0;
    var outstanding = (ViewBag.Outstanding as decimal?) ?? 0;
    var paymentStatus = (ViewBag.PaymentStatus as string) ?? L.T("Log_PayStatus_Unpaid");
    var payments = ViewBag.Payments as IEnumerable<tahsinERP.Models.F_WAYBILL_PAYMENTS>;
    var hasPayments = false;
    if (payments != null)
    {
        foreach (var _p in payments)
        {
            hasPayments = true;
            break;
        }
    }
    var paymentStatusCode = ViewBag.PaymentStatusCode as tahsinERP.Services.WaybillPaymentStatus? ?? tahsinERP.Services.WaybillPaymentStatus.Unpaid;
    var statusClass = paymentStatusCode == tahsinERP.Services.WaybillPaymentStatus.Paid ? "success" : paymentStatusCode == tahsinERP.Services.WaybillPaymentStatus.Partial ? "warning" : "danger";
}
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/Waybill/Index">@LogisticsTerms.Waybills</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Log_WaybillDetailsTitle")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-lg-8 col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h4 class="text-primary mb-0">@L.T("Log_WaybillInfo")</h4>
                                <span class="badge badge-light-primary">@Model.WaybillNo</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-borderless table-sm mb-0">
                                    <tr><td style="width:220px"><b>@L.T("Date")</b></td><td>@(Model.IssueDate?.ToString("dd.MM.yyyy") ?? "")</td></tr>
                                    <tr><td><b>@LogisticsTerms.Forwarder</b></td><td>@(Model.FORWARDER?.ForwarderName ?? Model.F_CONTRACTS?.FORWARDER?.ForwarderName ?? "")</td></tr>
                                    <tr><td><b>@L.T("Log_Contract")</b></td><td>@(Model.F_CONTRACTS?.ContractNo ?? "")</td></tr>
                                    <tr><td><b>@L.T("Log_TransportType")</b></td><td>@(Model.F_TRANSPORT_TYPES?.TransportType ?? "")</td></tr>
                                    <tr><td><b>@L.T("Log_Route")</b></td><td>@(Model.FromLocation ?? "") → @(Model.ToLocation ?? "")</td></tr>
                                    <tr><td><b>@L.T("Log_DriverTruck")</b></td><td>@(Model.DriverName ?? "-") / @(Model.TruckNo ?? "-")</td></tr>
                                    <tr><td><b>@L.T("Log_Distance")</b></td><td>@(Model.DistanceKm?.ToString("N2") ?? "0") @L.T("Log_UnitKm")</td></tr>
                                    <tr><td><b>@L.T("Log_WeightCbm")</b></td><td>@(Model.GrWeight?.ToString("N2") ?? "0") @L.T("Log_UnitTon") / @(Model.CBM?.ToString("N2") ?? "0")</td></tr>
                                    <tr><td><b>@L.T("Comment")</b></td><td>@(Model.Description ?? "-")</td></tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="mb-1">@L.T("Log_PaymentStatus")</h5>
                            <div class="mb-1">
                                <span class="badge badge-@statusClass" style="font-size: 0.95rem;">@paymentStatus</span>
                            </div>
                            <div class="d-flex justify-content-between mb-50">
                                <span>@L.T("Log_TotalAmount")</span>
                                <b>@((Model.Amount ?? 0).ToString("N2")) @currencyShortname</b>
                            </div>
                            <div class="d-flex justify-content-between mb-50">
                                <span>@L.T("Log_Paid")</span>
                                <b class="text-success">@totalPaid.ToString("N2") @currencyShortname</b>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>@L.T("Log_Outstanding")</span>
                                <b class="text-danger">@outstanding.ToString("N2") @currencyShortname</b>
                            </div>
                            <div class="progress progress-bar-@statusClass" style="height: 8px;">
                                @{
                                    var amount = Model.Amount ?? 0;
                                    var ratio = amount <= 0 ? 0 : Math.Min(100, Math.Max(0, (totalPaid / amount) * 100));
                                }
                                <div class="progress-bar bg-@statusClass" role="progressbar" style="width:@ratio.ToString("N0")%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <h6 class="mb-1">@L.T("Log_Delivery")</h6>
                            <div class="d-flex justify-content-between mb-50">
                                <span>@L.T("Log_Planned")</span>
                                <b>@(Model.PlannedDeliveryDate?.ToString("dd.MM.yyyy") ?? "-")</b>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>@L.T("Log_Actual")</span>
                                <b>@(Model.ActualDeliveryDate?.ToString("dd.MM.yyyy") ?? "-")</b>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h5 class="mb-0">@L.T("Log_LinkedPayments")</h5>
                                <a href="@Url.Action("Create", "WaybillPayment")" class="btn btn-sm btn-outline-primary">
                                    <i class="bx bx-plus"></i> @L.T("Log_AddPayment")
                                </a>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>@L.T("Date")</th>
                                            <th>@L.T("Amount")</th>
                                            <th>@L.T("Currency")</th>
                                            <th>@LogisticsTerms.Forwarder</th>
                                            <th>@L.T("Comment")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (hasPayments)
                                        {
                                            foreach (var p in payments)
                                            {
                                                <tr>
                                                    <td><a href="@Url.Action("Details", "WaybillPayment", new { id = p.ID })">@p.ID</a></td>
                                                    <td>@(p.PaymentDate?.ToString("dd.MM.yyyy") ?? "")</td>
                                                    <td>@p.Payment_Amount.ToString("N2")</td>
                                                    <td>@(p.CURRENCy != null ? p.CURRENCy.Shortname : currencyShortname)</td>
                                                    <td>@(p.FORWARDER != null ? p.FORWARDER.ForwarderName : "")</td>
                                                    <td>@(p.Comment ?? "")</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="6" class="text-center text-muted">@L.T("Log_PaymentsNotFound")</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </div>
    </div>
