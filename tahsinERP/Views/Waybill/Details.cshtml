@model tahsinERP.Models.F_WAYBILLS
@{
    ViewBag.Title = "Waybill tafsilotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Waybill/Index">Yo'l varaqalari</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Waybill tafsilotlari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-xl-12 col-md-12 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body pb-0 mx-25">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <h4 class="text-primary mb-0">Waybill ma'lumotlari</h4>
                                                <span class="badge badge-light">@Html.DisplayFor(model => model.WaybillNo)</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <table class="table table-sm">
                                                <tr><td><b>Sana</b></td><td>@(Model.IssueDate?.ToString("dd.MM.yyyy") ?? "")</td></tr>
                                                <tr><td><b>Forwarder</b></td><td>@(Model.FORWARDER?.ForwarderName ?? Model.F_CONTRACTS?.FORWARDER?.ForwarderName ?? "")</td></tr>
                                                <tr><td><b>Shartnoma</b></td><td>@(Model.F_CONTRACTS?.ContractNo ?? "")</td></tr>
                                                <tr><td><b>Transport turi</b></td><td>@(Model.F_TRANSPORT_TYPES?.TransportType ?? "")</td></tr>
                                                <tr><td><b>Qayerdan</b></td><td>@(Model.FromLocation ?? "")</td></tr>
                                                <tr><td><b>Qayerga</b></td><td>@(Model.ToLocation ?? "")</td></tr>
                                                <tr><td><b>Masofa (km)</b></td><td>@(Model.DistanceKm?.ToString("N2") ?? "")</td></tr>
                                                <tr><td><b>Tarif</b></td><td>@(Model.Rate?.ToString("N2") ?? "")</td></tr>
                                            </table>
                                        </div>
                                        <div class="col-md-6">
                                            <table class="table table-sm">
                                                <tr><td><b>Brut vazn</b></td><td>@(Model.GrWeight?.ToString("N2") ?? "")</td></tr>
                                                <tr><td><b>Net vazn</b></td><td>@(Model.NetWeight?.ToString("N2") ?? "")</td></tr>
                                                <tr><td><b>CBM</b></td><td>@(Model.CBM?.ToString("N2") ?? "")</td></tr>
                                                <tr><td><b>Pallet</b></td><td>@(Model.PalletsCount?.ToString() ?? "")</td></tr>
                                                <tr><td><b>Jami summa</b></td><td>@(Model.Amount?.ToString("N2") ?? "") @Model.CURRENCy?.Shortname</td></tr>
                                                <tr><td><b>Haydovchi</b></td><td>@(Model.DriverName ?? "")</td></tr>
                                                <tr><td><b>Mashina</b></td><td>@(Model.TruckNo ?? "")</td></tr>
                                                <tr><td><b>To'lov</b></td><td>Jami @ViewBag.TotalPaid?.ToString("N2") / Qoldiq @ViewBag.Outstanding?.ToString("N2")</td></tr>
                                            </table>
                                        </div>
                                        <div class="col-12">
                                            <table class="table table-sm">
                                                <tr><td><b>Planned Delivery</b></td><td>@(Model.PlannedDeliveryDate?.ToString("dd.MM.yyyy") ?? "")</td></tr>
                                                <tr><td><b>Actual Delivery</b></td><td>@(Model.ActualDeliveryDate?.ToString("dd.MM.yyyy") ?? "")</td></tr>
                                                <tr><td><b>Izoh</b></td><td>@(Model.Description ?? "")</td></tr>
                                            </table>
                                        </div>
                                    </div>
                                    <hr>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}