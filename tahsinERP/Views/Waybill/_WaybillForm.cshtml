@model tahsinERP.ViewModels.WaybillCreateViewModel
@using tahsinERP.Services
@* Yo'l varaqasi formasi — Create va Edit uchun bitta (LOG-D02). JS: ~/Scripts/app/waybill-form.js *@
@{
    bool isEdit = Model != null && Model.ID.HasValue;
}
@using (Html.BeginForm(isEdit ? "Edit" : "Create", "Waybill", FormMethod.Post, new
{
    id = "waybillForm",
    data_tariffs_url = Url.Action("GetTariffsByContract", "WaybillLookup"),
    data_invoice_url = Url.Action("GetDataFromInvoice", "WaybillLookup"),
    data_search_url = Url.Action("SearchDocuments", "WaybillLookup"),
    data_selected_tariff = Model.TariffID,
    data_edit = isEdit ? "true" : "false"
}))
{
    @Html.AntiForgeryToken()
    if (isEdit)
    {
        @Html.HiddenFor(model => model.ID)
        @Html.HiddenFor(model => model.OriginalTariffID)
    }
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Waybill/Index">@LogisticsTerms.Waybills</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @(isEdit ? L.T("Log_WaybillEditTitle") : L.T("Log_NewWaybill"))
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-xl-12 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body pb-0 mx-25">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                    <div class="mb-1">
                                        <h5 class="text-primary mb-0">@L.T("Log_MainInfo")</h5>
                                        <small class="text-muted">@L.T("Log_MainInfoHint")</small>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <label>@L.T("Log_WaybillNo")</label>
                                            @Html.TextBoxFor(model => model.WaybillNo, new { @class = "form-control", @placeholder = "TB_0001" })
                                            @Html.ValidationMessageFor(model => model.WaybillNo, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Date")</label>
                                            @Html.TextBoxFor(model => model.IssueDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                                            @Html.ValidationMessageFor(model => model.IssueDate, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Log_Direction")</label>
                                            @Html.DropDownListFor(model => model.Direction, LogisticsEnums.DirectionList(), L.T("Select"), new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@LogisticsTerms.Forwarder</label>
                                            @Html.DropDownListFor(model => model.ForwarderID, Model.Forwarders, L.T("Select"), new { @class = "form-control select2" })
                                        </div>
                                    </div>

                                    <hr />
                                    <div class="mb-1">
                                        <h5 class="text-primary mb-0">@L.T("Log_ContractTransport")</h5>
                                        <small class="text-muted">@L.T("Log_ContractTransportHint")</small>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <label>@L.T("Log_Contract")</label>
                                            @Html.DropDownListFor(model => model.ContractID, Model.Contracts, L.T("Select"), new { @class = "form-control select2", @id = "contractSelect" })
                                            @Html.ValidationMessageFor(model => model.ContractID, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-4">
                                            <label>@L.T("Log_TransportType")</label>
                                            @Html.DropDownListFor(model => model.TransportTypeID, Model.TransportTypes, L.T("Select"), new { @class = "form-control select2", @id = "transportTypeSelect" })
                                            @Html.ValidationMessageFor(model => model.TransportTypeID, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-4">
                                            <label>@L.T("Currency")</label>
                                            @Html.DropDownListFor(model => model.CurrencyID, Model.Currencies, L.T("Select"), new { @class = "form-control", @id = "currencySelect" })
                                        </div>
                                    </div>

                                    <div class="row mt-1">
                                        <div class="col-md-6">
                                            <label>@L.T("Log_Tariff")</label>
                                            @Html.DropDownListFor(model => model.TariffID, Model.Tariffs ?? new List<SelectListItem>(), L.T("Select"), new { @class = "form-control select2", @id = "tariffSelect" })
                                            @Html.ValidationMessageFor(model => model.TariffID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="mb-1 mt-1">
                                        <h5 class="text-primary mb-0">@L.T("Log_Route")</h5>
                                        <small class="text-muted">@L.T("Log_RouteHint")</small>
                                    </div>
                                    <div class="mb-1 mt-1">
                                        <h5 class="text-primary mb-0">@L.T("Log_CargoParams")</h5>
                                        <small class="text-muted">@L.T("Log_CargoParamsHint")</small>
                                    </div>
                                    <div class="row mt-1">
                                        <div class="col-md-4">
                                            <label>@L.T("Log_From")</label>
                                            @Html.TextBoxFor(model => model.FromLocation, new { @class = "form-control", @placeholder = L.T("Address") })
                                        </div>
                                        <div class="col-md-4">
                                            <label>@L.T("Log_To")</label>
                                            @Html.TextBoxFor(model => model.ToLocation, new { @class = "form-control", @placeholder = L.T("Address") })
                                        </div>
                                        <div class="col-md-4">
                                            <label>@L.T("Log_DistanceKm")</label>
                                            @Html.TextBoxFor(model => model.DistanceKm, "{0:0.######}", new { @class = "form-control", @placeholder = "0.00" })
                                        </div>
                                    </div>

                                    <div class="row mt-1">
                                        <div class="col-md-3">
                                            <label>@L.T("Log_GrossWeightTon")</label>
                                            @Html.TextBoxFor(model => model.GrWeight, "{0:0.######}", new { @class = "form-control", @placeholder = "0.00" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Log_NetWeightTon")</label>
                                            @Html.TextBoxFor(model => model.NetWeight, "{0:0.######}", new { @class = "form-control", @placeholder = "0.00" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>CBM</label>
                                            @Html.TextBoxFor(model => model.CBM, "{0:0.######}", new { @class = "form-control", @placeholder = "0.00" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Log_PalletsCount")</label>
                                            @Html.TextBoxFor(model => model.PalletsCount, new { @class = "form-control", @placeholder = "0" })
                                        </div>
                                    </div>

                                    <hr />
                                    <div class="mb-1">
                                        <h5 class="text-primary mb-0">@L.T("Log_TariffAmount")</h5>
                                        <small class="text-muted">@L.T("Log_TariffAmountHint")</small>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <label>@LogisticsTerms.TariffBasis</label>
                                            @Html.DropDownListFor(model => model.FreightBasis, LogisticsEnums.FreightBasisList(), L.T("Select"), new { @class = "form-control", @id = "freightBasisSelect" })
                                        </div>
                                        <div class="col-md-4">
                                            <label>@LogisticsTerms.TariffRate</label>
                                            @Html.TextBoxFor(model => model.Rate, "{0:0.######}", new { @class = "form-control", @placeholder = "0.00", @id = "rateInput" })
                                        </div>
                                        <div class="col-md-4">
                                            <label>@L.T("Log_TotalAmount")</label>
                                            @Html.TextBoxFor(model => model.Amount, "{0:0.######}", new { @class = "form-control", @placeholder = "0.00", @id = "amountInput" })
                                        </div>
                                    </div>

                                    <div class="row mt-1">
                                        <div class="col-md-4">
                                            <label>@L.T("Log_Payer")</label>
                                            @Html.DropDownListFor(model => model.PayerType, LogisticsEnums.PayerTypeList(), L.T("Select"), new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-4">
                                            <label>@L.T("Log_PayerId")</label>
                                            @Html.TextBoxFor(model => model.PayerID, new { @class = "form-control", @placeholder = "ID" })
                                        </div>
                                        <div class="col-md-4">
                                            <label>TTNK</label>
                                            @Html.DropDownListFor(model => model.TTNKID, Model.TTNKs, L.T("Select"), new { @class = "form-control waybill-doc-select", data_doc_type = "ttnk" })
                                        </div>
                                    </div>

                                    <hr />
                                    <div class="mb-1">
                                        <h5 class="text-primary mb-0">@L.T("Log_LinkedDocs")</h5>
                                        <small class="text-muted">@L.T("Log_LinkedDocsHint")</small>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <label>@L.T("Log_PurchaseInvoice")</label>
                                            @Html.DropDownListFor(model => model.InvoiceID, Model.PurchaseInvoices, L.T("Select"), new { @class = "form-control waybill-doc-select", @id = "purchaseInvoiceSelect", data_doc_type = "pinvoice" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Log_SalesInvoice")</label>
                                            @Html.DropDownListFor(model => model.SalesInvoiceID, Model.SalesInvoices, L.T("Select"), new { @class = "form-control waybill-doc-select", @id = "salesInvoiceSelect", data_doc_type = "sinvoice" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Log_SalesOrder")</label>
                                            @Html.DropDownListFor(model => model.SalesOrderID, Model.SalesOrders, L.T("Select"), new { @class = "form-control waybill-doc-select", data_doc_type = "sorder" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Log_PurchaseOrder")</label>
                                            @Html.DropDownListFor(model => model.PurchaseOrderID, Model.PurchaseOrders, L.T("Select"), new { @class = "form-control waybill-doc-select", data_doc_type = "porder" })
                                        </div>
                                    </div>

                                    <hr />
                                    <div class="mb-1">
                                        <h5 class="text-primary mb-0">@L.T("Log_TransportDriver")</h5>
                                        <small class="text-muted">@L.T("Log_TransportDriverHint")</small>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <label>@L.T("Log_TruckNo")</label>
                                            @Html.TextBoxFor(model => model.TruckNo, new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Log_TrailerNo")</label>
                                            @Html.TextBoxFor(model => model.TrailerNo, new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Log_TruckModel")</label>
                                            @Html.TextBoxFor(model => model.TruckModel, new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Log_TrailerModel")</label>
                                            @Html.TextBoxFor(model => model.TrailerModel, new { @class = "form-control" })
                                        </div>
                                    </div>

                                    <div class="row mt-1">
                                        <div class="col-md-4">
                                            <label>@L.T("Log_Driver")</label>
                                            @Html.TextBoxFor(model => model.DriverName, new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-4">
                                            <label>PINFL</label>
                                            @Html.TextBoxFor(model => model.DriverPINFL, new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-4">
                                            <label>@L.T("Log_PlannedDelivery")</label>
                                            @Html.TextBoxFor(model => model.PlannedDeliveryDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                                        </div>
                                    </div>

                                    <div class="row mt-1">
                                        <div class="col-md-4">
                                            <label>@L.T("Log_ActualDelivery")</label>
                                            @Html.TextBoxFor(model => model.ActualDeliveryDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                                        </div>
                                        <div class="col-md-8">
                                            <label>@L.T("Comment")</label>
                                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = 2 })
                                        </div>
                                    </div>

                                    <div class="row mt-1">
                                        <div class="col-md-12">
                                            <label>@L.T("Log_ManualCorrectionReason")</label>
                                            @Html.TextAreaFor(model => model.ManualCorrectionReason, new { @class = "form-control", @rows = 2 })
                                        </div>
                                    </div>

                                    <div class="row mt-2">
                                        <div class="col-md-12">
                                            <button class="btn btn-primary" type="submit">
                                                <i class="bx bx-save"></i> @L.T("Save")
                                            </button>
                                            <a href="@Url.Action("Index", "Waybill")" class="btn btn-outline-secondary ml-1">@L.T("Cancel")</a>
                                        </div>
                                    </div>
                                    <hr />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
