@model tahsinERP.Models.F_WAYBILLS
@using tahsinERP.Services
@{
    ViewBag.Title = L.T("Log_WaybillDeleteTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item ">
                                    <a href="~/Waybill/Index">@LogisticsTerms.Waybills</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Log_WaybillDeleteCrumb", Model.WaybillNo)
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-xl-9 col-md-8 col-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body pb-0 mx-25">
                                <div class="row invoice-info">
                                    <div class="col-lg-12 col-md-6 mt-25">
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                        <h4 class="text-primary">@L.T("Log_WaybillInfo")</h4>
                                        <hr />
                                        <span><b>@L.T("Log_WaybillNo")</b>: @Html.DisplayFor(model => model.WaybillNo)</span>
                                        <hr />
                                        <span><b>@L.T("Date")</b>: @(Model.IssueDate?.ToString("dd.MM.yyyy") ?? "")</span>
                                        <hr />
                                        <span><b>@LogisticsTerms.Forwarder</b>: @(Model.FORWARDER?.ForwarderName ?? Model.F_CONTRACTS?.FORWARDER?.ForwarderName ?? "")</span>
                                        <hr />
                                        <span><b>@L.T("Log_Contract")</b>: @(Model.F_CONTRACTS?.ContractNo ?? "")</span>
                                        <hr />
                                        <span><b>@L.T("Log_TransportType")</b>: @(Model.F_TRANSPORT_TYPES?.TransportType ?? "")</span>
                                        <hr />
                                        <span><b>@L.T("Log_From")</b>: @(Model.FromLocation ?? "")</span>
                                        <hr />
                                        <span><b>@L.T("Log_To")</b>: @(Model.ToLocation ?? "")</span>
                                        <hr />
                                    </div>
                                </div>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item border-0 pb-0">
                                        @using (Html.BeginForm("Delete", "Waybill", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-danger bg-light btn-block subtotal-preview-btn" name="delete" type="submit" value="Delete" onclick="return confirm('@L.Js("Log_ConfirmDeleteWaybill")')">
                                                <i class='bx bx-trash'></i>
                                                @L.T("Delete")
                                            </button>
                                        }
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

