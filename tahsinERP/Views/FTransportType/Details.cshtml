@model  tahsinERP.Models.F_TRANSPORT_TYPES
@{
    ViewBag.Title = L.T("Log_TransportTypeDetailsTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item ">
                                    <a href="~/FTransportType/Index">@L.T("Log_TransportTypes")</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Log_TransportTypeInfoCrumb", Model.TransportType)
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body pb-0 mx-25">
                                <div class="row invoice-info">
                                    <div class="col-lg-12 col-md-12 mt-25">
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                        <h4 class="text-primary">@L.T("Log_TransportTypeInfo")</h4>
                                        <br />
                                        <hr />
                                        <span><b>@L.T("Log_TransportType")</b>: @Html.DisplayFor(model => model.TransportType)</span>
                                        <br />
                                        <hr />
                                        <span><b>@L.T("Log_UnitOfMeasure")</b>: @Html.DisplayFor(model => model.UNIT.UnitName)</span>
                                        <br />
                                        <hr />
                                        <span><b>@L.T("Log_TransportWeightKg")</b>: @(Model.TransportWeight?.ToString("0.######"))</span>
                                        <br />
                                        <hr />
                                        <span><b>@L.T("Log_MaxLiftKg")</b>: @(Model.CapableOfLifting?.ToString("0.######"))</span>
                                        <br />
                                        <br />
                                        <div class="row">
                                            <div class="col-12 col-md-12">
                                                <div class="card mb-3">
                                                    <div class="card-body">
                                                        <h4 class="card-title text-primary">@L.T("Log_External")</h4>
                                                        <hr />
                                                        <span><b>@L.T("Log_Length")</b>: @Model.ExtLgth.ToString("0.######") mm</span>
                                                        <br />
                                                        <hr />
                                                        <span><b>@L.T("Log_Width")</b>: @Model.ExtWdth.ToString("0.######") mm</span>
                                                        <br />
                                                        <hr />
                                                        <span><b>@L.T("Log_Height")</b>: @Model.ExtHght.ToString("0.######") mm</span>
                                                        <br />
                                                        <hr />
                                                        <span><b>@L.T("Log_ExtVolume")</b>: @(ViewBag.ExternalCBM != null ? ((double)ViewBag.ExternalCBM).ToString("N2") + " m³" : "-")</span>
                                                        <br />
                                                          <hr />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-12 col-md-12">
                                                <div class="card mb-3">
                                                    <div class="card-body">
                                                        <h4 class="card-title text-primary">@L.T("Log_Internal")</h4>
                                                        <hr />
                                                        <span><b>@L.T("Log_Length")</b>: @Model.IntLgth.ToString("0.######") mm</span>
                                                        <br />
                                                        <hr />
                                                        <span><b>@L.T("Log_Width")</b>: @Model.IntWdth.ToString("0.######") mm</span>
                                                        <br />
                                                        <hr />
                                                        <span><b>@L.T("Log_Height")</b>: @Model.IntHght.ToString("0.######") mm</span>
                                                        <br />
                                                        <hr />
                                                        @* LOG-B10: hajm va palletlar mm o'lchamlardan (TransportLoadCalculator) *@
                                                        <span><b>@L.T("Log_IntVolume")</b>: @(ViewBag.CBMCapacity != null ? ((double)ViewBag.CBMCapacity).ToString("N2") + " m³" : "-")</span>
                                                        <br />
                                                        <hr />
                                                        <span><b>@L.T("Log_PalletsOneLayer")</b>: @(ViewBag.PalletCount ?? "-")</span>
                                                        <br />
                                                        <hr />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

