@model tahsinERP.ViewModels.JobDescEditViewModel
@{
    ViewBag.Title = "Lavozim yo'riqnomasini tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/JobDesc">Job Descriptions</a></li>
                                    <li class="breadcrumb-item active">Tahrirlash</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title"><i class="bx bx-edit mr-1"></i>Lavozim yo'riqnomasi ma'lumotlarini tahrirlash</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Edit", "JobDesc", FormMethod.Post, new { id = "editForm" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(model => model.DocumentID)
                                        @Html.HiddenFor(model => model.NewVersionNo)
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="JobDescriptionCode">Lavozim kodi <span class="text-danger">*</span></label>
                                                    @Html.TextBoxFor(model => model.JobDescriptionCode, new { 
                                                        @class = "form-control", 
                                                        @required = "required"
                                                    })
                                                    @Html.ValidationMessageFor(model => model.JobDescriptionCode, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="JobTitle">Lavozim nomi</label>
                                                    @Html.TextBoxFor(model => model.JobTitle, new { 
                                                        @class = "form-control"
                                                    })
                                                    @Html.ValidationMessageFor(model => model.JobTitle, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Joriy versiya</label>
                                                    <input type="text" class="form-control" value="v@(Model.CurrentVersionNo.ToString("F2"))" disabled />
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Yangi versiya <span class="text-danger">*</span></label>
                                                    <input type="text" class="form-control" value="v@(Model.NewVersionNo.ToString("F2"))" disabled />
                                                    <small class="form-text text-muted">Har safar tahrirlashda versiya avtomatik oshadi (v@(Model.CurrentVersionNo.ToString("F2")) + 0.01 = v@(Model.NewVersionNo.ToString("F2")))</small>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label for="Department">Bo'lim</label>
                                                    @Html.TextBoxFor(model => model.Department, new { 
                                                        @class = "form-control"
                                                    })
                                                    @Html.ValidationMessageFor(model => model.Department, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="HRJobDescriptionID">HR Lavozimga bog'lash</label>
                                                    @Html.DropDownListFor(model => model.HRJobDescriptionID, ViewBag.HRJobDescriptions as SelectList, "-- Tanlash --", new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.HRJobDescriptionID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label for="Notes">Eslatma</label>
                                            @Html.TextAreaFor(model => model.Notes, new { 
                                                @class = "form-control", 
                                                @rows = "3"
                                            })
                                            @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            <label>Hujjat kontenti <span class="text-danger">*</span></label>
                                            <div class="alert alert-info">
                                                <i class="bx bx-info-circle"></i>
                                                <strong>Eslatma:</strong> Quyida Word hujjatini tahrirlashingiz mumkin. Matn orasiga rasmlar qo'shishingiz mumkin.
                                            </div>
                                            
                                            <!-- Quill Editor -->
                                            <div id="editor-container" style="height: 600px; border: 1px solid #ddd; margin-top: 10px;">
                                                <!-- Toolbar -->
                                                <div id="quill-toolbar">
                                                    <span class="ql-formats">
                                                        <select class="ql-font"></select>
                                                        <select class="ql-size"></select>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button class="ql-bold"></button>
                                                        <button class="ql-italic"></button>
                                                        <button class="ql-underline"></button>
                                                        <button class="ql-strike"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <select class="ql-color"></select>
                                                        <select class="ql-background"></select>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button class="ql-script" value="sub"></button>
                                                        <button class="ql-script" value="super"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button class="ql-header" value="1"></button>
                                                        <button class="ql-header" value="2"></button>
                                                        <button class="ql-blockquote"></button>
                                                        <button class="ql-code-block"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button class="ql-list" value="ordered"></button>
                                                        <button class="ql-list" value="bullet"></button>
                                                        <button class="ql-indent" value="-1"></button>
                                                        <button class="ql-indent" value="+1"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <select class="ql-align"></select>
                                                        <select class="ql-direction"></select>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button class="ql-link"></button>
                                                        <button class="ql-image"></button>
                                                        <button class="ql-video"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button class="ql-clean"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button type="button" class="btn btn-sm btn-outline-primary" id="loadCurrentDocxBtn" title="Joriy versiyani yuklash">
                                                            <i class="bx bx-file"></i> Joriy versiya
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-success" id="loadDocxBtn" title="Word fayl yuklash">
                                                            <i class="bx bx-upload"></i> Word yuklash
                                                        </button>
                                                    </span>
                                                </div>
                                                <!-- Editor -->
                                                <div id="quill-editor" style="height: 550px;"></div>
                                            </div>
                                            
                                            <!-- Hidden field for document content -->
                                            @Html.HiddenFor(model => model.DocumentContent, new { id = "documentContent" })
                                        </div>

                                        <div class="form-group" style="margin-top: 20px;">
                                            <button type="submit" class="btn btn-primary" id="saveBtn">
                                                <i class="bx bx-save"></i> Saqlash (Yangi versiya yaratish)
                                            </button>
                                            <a href="@Url.Action("Details", "JobDesc", new { id = Model.DocumentID })" class="btn btn-outline-secondary">
                                                <i class="bx bx-x"></i> Bekor qilish
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quill.js CSS -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    
    <style>
        #quill-editor {
            background: white;
        }
        .ql-container {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 14px;
        }
        #quill-toolbar {
            border-bottom: 1px solid #ddd;
            background: #f8f9fa;
            padding: 8px;
        }
        #quill-toolbar .ql-formats {
            margin-right: 10px;
        }
        #quill-toolbar button {
            margin: 0 2px;
        }
    </style>
    
    @section scripts {
        <!-- Quill.js -->
        <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
        
        <!-- mammoth.js - .docx ni HTML ga konvertatsiya qilish -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
        
        <script>
        (function() {
            // jQuery yuklanishini kutish
            function waitForJQuery(callback) {
                if (typeof jQuery !== 'undefined' && typeof $ !== 'undefined') {
                    callback();
                } else {
                    setTimeout(function() {
                        waitForJQuery(callback);
                    }, 100);
                }
            }
            
            waitForJQuery(function() {
                $(document).ready(function () {
                    var quill = new Quill('#quill-editor', {
                        modules: {
                            toolbar: '#quill-toolbar'
                        },
                        theme: 'snow',
                        placeholder: 'Hujjat kontentini kiriting...'
                    });

                    // Joriy versiyani yuklash
                    $('#loadCurrentDocxBtn').on('click', function() {
                        @if (ViewBag.DocumentFileId != null)
                        {
                            <text>
                            loadDocxFromUrl('@Url.Action("DownloadFile", "JobDesc", new { fileId = ViewBag.DocumentFileId })');
                            </text>
                        }
                        else
                        {
                            <text>
                            alert('Joriy versiya fayli topilmadi');
                            </text>
                        }
                    });

                    // Word fayl yuklash
                    $('#loadDocxBtn').on('click', function() {
                        var fileInput = document.createElement('input');
                        fileInput.type = 'file';
                        fileInput.accept = '.docx';
                        fileInput.onchange = function(e) {
                            var file = e.target.files[0];
                            if (file) {
                                loadDocxFile(file);
                            }
                        };
                        fileInput.click();
                    });

                    function loadDocxFromUrl(url) {
                        $.ajax({
                            url: url,
                            type: 'GET',
                            xhrFields: {
                                responseType: 'blob'
                            },
                            success: function(blob) {
                                var reader = new FileReader();
                                reader.onload = function(e) {
                                    var arrayBuffer = e.target.result;
                                    var options = {
                                        arrayBuffer: arrayBuffer,
                                        styleMap: [
                                            "p[style-name='Heading 1'] => h1:fresh",
                                            "p[style-name='Heading 2'] => h2:fresh",
                                            "p[style-name='Heading 3'] => h3:fresh",
                                            "p[style-name='Title'] => h1.title:fresh",
                                            "r[style-name='Strong'] => strong",
                                            "p[style-name='Quote'] => blockquote:fresh",
                                            "p[style-name='Intense Quote'] => blockquote.intense:fresh",
                                            "r[style-name='Emphasis'] => em",
                                            "r[style-name='Code'] => code"
                                        ],
                                        includeDefaultStyleMap: true,
                                        convertImage: mammoth.images.imgElement(function(image) {
                                            return image.read("base64").then(function(imageBuffer) {
                                                return {
                                                    src: "data:" + image.contentType + ";base64," + imageBuffer
                                                };
                                            });
                                        })
                                    };
                                    
                                    mammoth.convertToHtml(options)
                                        .then(function(result) {
                                            var tempDiv = document.createElement('div');
                                            tempDiv.innerHTML = result.value;
                                            var delta = quill.clipboard.convert(tempDiv);
                                            quill.setContents(delta, 'silent');
                                            console.log('Joriy versiya yuklandi');
                                            alert('Joriy versiya muvaffaqiyatli yuklandi!');
                                        })
                                        .catch(function(error) {
                                            console.error('Fayl yuklashda xatolik:', error);
                                            alert('Fayl yuklashda xatolik yuz berdi');
                                        });
                                };
                                reader.readAsArrayBuffer(blob);
                            },
                            error: function(xhr, status, error) {
                                console.error('Fayl yuklashda xatolik:', error);
                                alert('Fayl yuklashda xatolik yuz berdi');
                            }
                        });
                    }

                    function loadDocxFile(file) {
                        var reader = new FileReader();
                        reader.onload = function(e) {
                            var arrayBuffer = e.target.result;
                            var options = {
                                arrayBuffer: arrayBuffer,
                                styleMap: [
                                    "p[style-name='Heading 1'] => h1:fresh",
                                    "p[style-name='Heading 2'] => h2:fresh",
                                    "p[style-name='Heading 3'] => h3:fresh",
                                    "p[style-name='Title'] => h1.title:fresh",
                                    "r[style-name='Strong'] => strong",
                                    "p[style-name='Quote'] => blockquote:fresh",
                                    "p[style-name='Intense Quote'] => blockquote.intense:fresh",
                                    "r[style-name='Emphasis'] => em",
                                    "r[style-name='Code'] => code"
                                ],
                                includeDefaultStyleMap: true,
                                convertImage: mammoth.images.imgElement(function(image) {
                                    return image.read("base64").then(function(imageBuffer) {
                                        return {
                                            src: "data:" + image.contentType + ";base64," + imageBuffer
                                        };
                                    });
                                })
                            };
                            
                            mammoth.convertToHtml(options)
                                .then(function(result) {
                                    var tempDiv = document.createElement('div');
                                    tempDiv.innerHTML = result.value;
                                    var delta = quill.clipboard.convert(tempDiv);
                                    quill.setContents(delta, 'silent');
                                    console.log('Word fayl yuklandi');
                                    alert('Word fayl muvaffaqiyatli yuklandi!');
                                })
                                .catch(function(error) {
                                    console.error('Word fayl yuklashda xatolik:', error);
                                    alert('Word fayl yuklashda xatolik yuz berdi: ' + error.message);
                                });
                        };
                        reader.readAsArrayBuffer(file);
                    }

                    // Mavjud kontentni yuklash (agar mavjud bo'lsa)
                    @if (!string.IsNullOrEmpty(Model.DocumentContent))
                    {
                        <text>
                        try {
                            var existingContent = @Html.Raw(new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(Model.DocumentContent));
                            if (existingContent && existingContent !== '') {
                                quill.root.innerHTML = existingContent;
                                $('#documentContent').val(existingContent);
                            }
                        } catch(e) {
                            console.error('Error loading existing content:', e);
                        }
                        </text>
                    }

                    // Editor o'zgarganda HTML ni hidden fieldga saqlash
                    quill.on('text-change', function() {
                        var html = quill.root.innerHTML;
                        $('#documentContent').val(html);
                    });

                    // Form submit
                    $('#editForm').on('submit', function(e) {
                        // HTML kontentni saqlash
                        var html = quill.root.innerHTML;
                        $('#documentContent').val(html);

                        if (!html || html.trim() === '' || html.trim() === '<p><br></p>') {
                            e.preventDefault();
                            alert('Iltimos, hujjat kontentini kiriting');
                            return false;
                        }

                        // Saqlash tugmasini o'chirish (double submit oldini olish)
                        $('#saveBtn').prop('disabled', true).html('<i class="bx bx-loader-alt bx-spin"></i> Saqlanmoqda...');
                    });
                });
            });
        })();
        </script>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

