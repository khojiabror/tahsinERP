@model tahsinERP.ViewModels.JobDescCreateViewModel
@{
    ViewBag.Title = L.T("Hr_JdAdd");
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.IsEdit = false;
    // Umumiy forma tahrir modelida ishlaydi; Create POST faqat shu maydonlarni bog'laydi
    var formModel = new tahsinERP.ViewModels.JobDescEditViewModel
    {
        JobDescriptionCode = Model?.JobDescriptionCode,
        JobTitle = Model?.JobTitle,
        Department = Model?.Department,
        Notes = Model?.Notes,
        DocumentContent = Model?.DocumentContent,
        HRJobDescriptionID = Model?.HRJobDescriptionID
    };
}
@Html.Partial("_Form", formModel)
@section scripts {
    @Html.Partial("_FormScripts", formModel)
}
