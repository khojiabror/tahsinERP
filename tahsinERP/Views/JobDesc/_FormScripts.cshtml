@model tahsinERP.ViewModels.JobDescEditViewModel
@* JobDesc Create/Edit skriptlari — umumiy ~/Scripts/app/docx-editor.js (STD bilan bir xil muharrir, dublikat #15/#20). *@
@{
    bool isEdit = ViewBag.IsEdit == true;
    string loadUrl = !isEdit
        ? Url.Action("GetTemplate", "JobDesc")
        : (ViewBag.DocumentFileId != null ? Url.Action("DownloadFile", "JobDesc", new { fileId = ViewBag.DocumentFileId }) : null);
}
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
<script src="~/Scripts/app/docx-editor.js"></script>
<script>
    $(function () {
        var loadUrl = @Html.Raw(Json.Encode(loadUrl));
        initDocxEditor({
            form: '#jobDescForm',
            hidden: '#documentContent',
            saveBtn: '#saveBtn',
            encode: 'html',
            // Edit: server .docx'ni HTML'ga aylantirib beradi; validatsiya xatosida — yuborilgan matn
            initialHtml: @Html.Raw(Json.Encode(Model.DocumentContent ?? "")),
            notify: true,
            buttons: [{ selector: '#loadCurrentDocxBtn', url: function () { return loadUrl; }, missing: 'Joriy versiya fayli topilmadi' }],
            fileButton: '#loadDocxBtn'
        });
    });
</script>
