@model tahsinERP.ViewModels.JobDescDetailsViewModel
@{
    ViewBag.Title = "Lavozim yo'riqnomasi batafsil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    @{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()); }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/JobDesc">Job Descriptions</a></li>
                                    <li class="breadcrumb-item active">@Model.JobDescriptionCode</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title"><i class="bx bx-info-circle mr-1"></i>Lavozim yo'riqnomasi ma'lumotlari</h4>
                                @if (changePermit)
                                {
                                    <div class="card-header-right">
                                        <a href="@Url.Action("Edit", "JobDesc", new { id = Model.DocumentID })" class="btn btn-sm btn-primary">
                                            <i class="bx bx-edit"></i> Tahrirlash
                                        </a>
                                    </div>
                                }
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <dl class="row">
                                        <dt class="col-sm-4">Lavozim kodi:</dt>
                                        <dd class="col-sm-8"><strong>@Model.JobDescriptionCode</strong></dd>

                                        <dt class="col-sm-4">Lavozim nomi:</dt>
                                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.JobTitle) ? "-" : Model.JobTitle)</dd>

                                        <dt class="col-sm-4">Bo'lim:</dt>
                                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Department) ? "-" : Model.Department)</dd>

                                        <dt class="col-sm-4">Versiya:</dt>
                                        <dd class="col-sm-8">
                                            <span class="badge badge-light-info">v@(Model.VersionNo.ToString("F2"))</span>
                                        </dd>

                                        @if (Model.HRJobDescriptionID.HasValue)
                                        {
                                            <dt class="col-sm-4">HR Lavozim:</dt>
                                            <dd class="col-sm-8">
                                                @if (!string.IsNullOrEmpty(Model.HRJobDescriptionTitle))
                                                {
                                                    <a href="#" title="@Model.HRJobDescriptionTitle">@Model.HRJobDescriptionTitle</a>
                                                }
                                                else
                                                {
                                                    <span>ID: @Model.HRJobDescriptionID</span>
                                                }
                                            </dd>
                                        }

                                        <dt class="col-sm-4">Eslatma:</dt>
                                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Notes) ? "-" : Model.Notes)</dd>

                                        <dt class="col-sm-4">Yaratilgan sana:</dt>
                                        <dd class="col-sm-8">@Model.CreatedDT.ToString("dd.MM.yyyy HH:mm")</dd>

                                        @if (Model.UpdatedDT.HasValue)
                                        {
                                            <dt class="col-sm-4">Yangilangan sana:</dt>
                                            <dd class="col-sm-8">@Model.UpdatedDT.Value.ToString("dd.MM.yyyy HH:mm")</dd>
                                        }
                                    </dl>

                                    @if (Model.HasDocumentFile && Model.VersionHistory != null && Model.VersionHistory.Any())
                                    {
                                        <div class="mt-3">
                                            <a href="@Url.Action("DownloadFile", "JobDesc", new { fileId = Model.VersionHistory.FirstOrDefault()?.FileID })" 
                                               class="btn btn-success">
                                                <i class="bx bx-download"></i> Word hujjatini yuklash (.docx)
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Versiya tarixi -->
                        @if (Model.VersionHistory != null && Model.VersionHistory.Any())
                        {
                            <div class="card mt-2">
                                <div class="card-header">
                                    <h4 class="card-title"><i class="bx bx-history mr-1"></i>Versiya tarixi</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Versiya</th>
                                                        <th>Fayl nomi</th>
                                                        <th>Yaratilgan sana</th>
                                                        <th>Amallar</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var version in Model.VersionHistory)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="badge badge-light-info">v@(version.VersionDecimal.ToString("F2"))</span>
                                                            </td>
                                                            <td>@version.FileName</td>
                                                            <td>@version.CreatedDT.ToString("dd.MM.yyyy HH:mm")</td>
                                                            <td>
                                                                <a href="@Url.Action("DownloadFile", "JobDesc", new { fileId = version.FileID })" 
                                                                   class="btn btn-sm btn-outline-primary" title="Yuklash">
                                                                    <i class="bx bx-download"></i>
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

