@model List<tahsinERP.ViewModels.HR.HrEmployeeViewModel>
@{
    ViewBag.Title = "Xodimlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    @{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrEmployees"); }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item active">Xodimlar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (changePermit)
                {
                    <div class="invoice-create-btn mb-1">
                        <a href="@Url.Action("Create")" class="btn btn-success">
                            <i class="bx bx-plus"></i> Xodim qo'shish
                        </a>
                    </div>
                }

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <form method="get" action="@Url.Action("Index")" class="mb-2">
                                <div class="row">
                                    <div class="col-md-3">
                                        @Html.DropDownList("orgUnitId", ViewBag.OrgUnitID as SelectList, "Barcha bo'limlar", new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.DropDownList("positionId", ViewBag.PositionID as SelectList, "Barcha lavozimlar", new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3">
                                        <select name="status" class="form-control">
                                            <option value="">Hammasi</option>
                                            <option value="Active" @(ViewBag.Status == "Active" ? "selected" : "")>Faol</option>
                                            <option value="InActive" @(ViewBag.Status == "InActive" ? "selected" : "")>Nofaol</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <button type="submit" class="btn btn-primary btn-block">Filtr</button>
                                    </div>
                                </div>
                            </form>

                            <div class="table-responsive">
                                <table id="employeesTable" class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Tab.№</th>
                                            <th>F.I.O.</th>
                                            <th>Bo'lim</th>
                                            <th>Lavozim</th>
                                            <th>Qabul qilingan sana</th>
                                            <th>Holat</th>
                                            <th>Amallar</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.TabNo</td>
                                                <td>@item.FullName</td>
                                                <td>@(item.OrgUnitName ?? "-")</td>
                                                <td>@(item.PositionName ?? "-")</td>
                                                <td>@(item.EmploymentDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                                                <td>
                                                    <span class="badge badge-@(item.IsActive ? "success" : "danger")">
                                                        @(item.IsActive ? "Faol" : "Nofaol")
                                                    </span>
                                                </td>
                                                <td>
                                                    <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-info">
                                                        <i class="bx bx-show"></i>
                                                    </a>
                                                    @if (changePermit)
                                                    {
                                                        <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-warning">
                                                            <i class="bx bx-edit"></i>
                                                        </a>
                                                        <a href="@Url.Action("Transfer", new { id = item.ID })" class="btn btn-sm btn-primary" title="Boshqa lavozimga o'tkazish">
                                                            <i class="bx bx-transfer"></i>
                                                        </a>
                                                        <a href="@Url.Action("Dismiss", new { id = item.ID })" class="btn btn-sm btn-danger" title="Mehnat shartnomasini bekor qilish">
                                                            <i class="bx bx-x"></i>
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Scripts/app/erp-datatable.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            $('#employeesTable').DataTable({
                "language": {
                    "lengthMenu": "_MENU_ ta ko'rsatish",
                    "zeroRecords": "Yozuvlar topilmadi",
                    "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    "infoEmpty": "Yozuvlar yo'q",
                    "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                    "search": "Qidirish:",
                    "paginate": {
                        "first": "Birinchi",
                        "last": "Oxirgi",
                        "next": "Keyingi",
                        "previous": "Oldingi"
                    }
                },
                "pageLength": 25,
                "order": [[0, "asc"]],
                dom: 'lBfrtip',
                buttons: erpDataTable.buttons({ small: true })
            });
        });
    </script>

