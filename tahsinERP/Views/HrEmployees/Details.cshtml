@model tahsinERP.ViewModels.HR.HrEmployeeViewModel
@{
    ViewBag.Title = L.T("Hr_EmpDetails");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    @{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrEmployees"); }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_Employees")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Hr_DetailsCrumb")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">@L.T("Hr_TabNumber"):</dt>
                                <dd class="col-sm-9">@Model.TabNo</dd>

                                <dt class="col-sm-3">@L.T("Hr_FullName"):</dt>
                                <dd class="col-sm-9">@Model.FullName</dd>

                                <dt class="col-sm-3">@L.T("Hr_OrgUnit"):</dt>
                                <dd class="col-sm-9">@(Model.OrgUnitName ?? "-")</dd>

                                <dt class="col-sm-3">@L.T("Hr_Position"):</dt>
                                <dd class="col-sm-9">@(Model.PositionName ?? "-")</dd>

                                <dt class="col-sm-3">@L.T("Hr_BaseSalary"):</dt>
                                <dd class="col-sm-9">@(Model.BaseSalary?.ToString("N2") ?? "-")</dd>

                                <dt class="col-sm-3">@L.T("Hr_MaterialRespAllowance"):</dt>
                                <dd class="col-sm-9">@((Model.MaterialResponsibilityPercent ?? 0).ToString("N2")) %</dd>

                                <dt class="col-sm-3">@L.T("Hr_SpecialAllowance"):</dt>
                                <dd class="col-sm-9">@((Model.SpecialAllowancePercent ?? 0).ToString("N2")) %</dd>

                                <dt class="col-sm-3">@L.T("Hr_SalaryGrade"):</dt>
                                <dd class="col-sm-9">@(Model.SalaryGradeName ?? "-")</dd>

                                <dt class="col-sm-3">@L.T("Hr_EmpStartInPosition"):</dt>
                                <dd class="col-sm-9">@(Model.EmploymentDate?.ToString("dd.MM.yyyy") ?? "-")</dd>

                                <dt class="col-sm-3">@L.T("Hr_EmpDismissedFromPosition"):</dt>
                                <dd class="col-sm-9">@(Model.DismissalDate?.ToString("dd.MM.yyyy") ?? "-")</dd>

                                <dt class="col-sm-3">@L.T("Hr_EmpCurrentStatus"):</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.IsActive ? "success" : "danger")">
                                        @(Model.IsActive ? L.T("Hr_EmpWorking") : L.T("Hr_EmpLeft"))
                                    </span>
                                </dd>
                            </dl>

                            <hr />

                            <h5 class="mb-2">@L.T("Hr_EmpHistory")</h5>
                            @if (changePermit)
                            {
                                <div class="mb-1">
                                    <button type="button" class="btn btn-sm btn-primary" data-toggle="modal" data-target="#addTenureModal">
                                        <i class="bx bx-plus"></i> @L.T("Hr_EmpAddTenure")
                                    </button>
                                </div>
                            }
                            @if (ViewBag.History != null)
                            {
                                var history = ViewBag.History as List<tahsinERP.ViewModels.HR.HrEmployeeHistoryViewModel>;
                                if (history != null && history.Any())
                                {
                                    <div class="table-responsive">
                                        <table id="historyTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Hr_OrgUnit")</th>
                                                    <th>@L.T("Hr_Position")</th>
                                                    <th>@L.T("Hr_EmpHiredDate")</th>
                                                    <th>@L.T("Hr_EmpLeftDate")</th>
                                                    <th>@L.T("Hr_Reason")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in history)
                                                {
                                                    <tr>
                                                        <td>@(item.FromOrgUnitName ?? "-")</td>
                                                        <td>@(item.FromPositionName ?? "-")</td>
                                                        <td>@(item.EffectiveDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                                                        <td>@(item.IsCurrentRow ? L.T("Hr_UntilToday") : (item.EffectiveDateTo?.ToString("dd.MM.yyyy") ?? "-"))</td>
                                                        <td>@(item.Reason ?? "-")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">@L.T("Hr_EmpNoHistory")</p>
                                }
                            }
                            else
                            {
                                <p class="text-muted">@L.T("Hr_EmpNoHistory")</p>
                            }

                            <div class="form-actions mt-3">
                                @if (changePermit)
                                {
                                    <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                                        <i class="bx bx-edit"></i> @L.T("Edit")
                                    </a>
                                }
                                <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("BackToList")</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (changePermit)
    {
        <div class="modal fade" id="addTenureModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    @using (Html.BeginForm("AddTenure", "HrEmployees", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="employeeId" value="@Model.ID" />
                        <div class="modal-header">
                            <h5 class="modal-title">@L.T("Hr_EmpAddTenureTitle")</h5>
                            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                        </div>
                        <div class="modal-body">
                            <div class="form-group">
                                <label>@L.T("Hr_OrgUnit") <span class="text-danger">*</span></label>
                                @Html.DropDownList("fromOrgUnitId", ViewBag.HistoryOrgUnitID as SelectList, L.T("Hr_SelectOrgUnit"), new { @class = "form-control", required = "required" })
                            </div>
                            <div class="form-group">
                                <label>@L.T("Hr_Position") <span class="text-danger">*</span></label>
                                @Html.DropDownList("fromPositionId", ViewBag.HistoryPositionID as SelectList, L.T("Hr_SelectPosition"), new { @class = "form-control", required = "required" })
                            </div>
                            <div class="form-group">
                                <label>@L.T("Hr_StartDate") <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" name="effectiveDateFrom" required />
                            </div>
                            <div class="form-group">
                                <label>@L.T("Hr_EndDateOptional")</label>
                                <input type="date" class="form-control" name="effectiveDateTo" />
                                <small class="text-muted">@L.T("Hr_EmpEndDateHint")</small>
                            </div>
                            <div class="form-group">
                                <label>@L.T("Hr_Reason")</label>
                                <textarea class="form-control" name="reason" rows="2" placeholder="@L.T("Hr_EmpTenureReasonPh")"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">@L.T("Cancel")</button>
                            <button type="submit" class="btn btn-primary">@L.T("Save")</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <script>
        $(document).ready(function() {
            if ($('#historyTable').length) {
                $('#historyTable').DataTable({
                    "pageLength": 10,
                    "order": [[2, "asc"], [3, "asc"]]
                });
            }
        });
    </script>

