@model tahsinERP.ViewModels.HR.HrEmployeeViewModel
@{
    ViewBag.Title = "Xodim tafsilotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "HrEmployees"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrEmployees");

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Xodim tafsilotlari</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Xodimlar</a></li>
                                    <li class="breadcrumb-item active">Tafsilotlar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">Tabelliy raqam:</dt>
                                <dd class="col-sm-9">@Model.TabNo</dd>

                                <dt class="col-sm-3">F.I.O.:</dt>
                                <dd class="col-sm-9">@Model.FullName</dd>

                                <dt class="col-sm-3">Bo'lim:</dt>
                                <dd class="col-sm-9">@(Model.OrgUnitName ?? "-")</dd>

                                <dt class="col-sm-3">Lavozim:</dt>
                                <dd class="col-sm-9">@(Model.PositionName ?? "-")</dd>

                                <dt class="col-sm-3">Asosiy maosh:</dt>
                                <dd class="col-sm-9">@(Model.BaseSalary?.ToString("N2") ?? "-")</dd>

                                <dt class="col-sm-3">Tarif tarmog'i:</dt>
                                <dd class="col-sm-9">@(Model.SalaryGradeName ?? "-")</dd>

                                <dt class="col-sm-3">Qabul qilingan sana:</dt>
                                <dd class="col-sm-9">@(Model.EmploymentDate?.ToString("dd.MM.yyyy") ?? "-")</dd>

                                <dt class="col-sm-3">Ishdan bo'shatilgan sana:</dt>
                                <dd class="col-sm-9">@(Model.DismissalDate?.ToString("dd.MM.yyyy") ?? "-")</dd>

                                <dt class="col-sm-3">Holat:</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.IsActive ? "success" : "danger")">
                                        @(Model.IsActive ? "Faol" : "Nofaol")
                                    </span>
                                </dd>
                            </dl>

                            <hr />

                            <h5 class="mb-2">Xodim tarixi</h5>
                            @{
                                var history = ViewBag.History as List<dynamic>;
                            }
                            @if (history != null && history.Any())
                            {
                                <div class="table-responsive">
                                    <table id="historyTable" class="table table-striped table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Amal turi</th>
                                                <th>Eski bo'lim</th>
                                                <th>Eski lavozim</th>
                                                <th>Yangi bo'lim</th>
                                                <th>Yangi lavozim</th>
                                                <th>Sana</th>
                                                <th>Sabab</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in history)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="badge badge-@(item.ActionType == "Transfer" ? "info" : "danger")">
                                                            @(item.ActionType == "Transfer" ? "Transfer" : "Ishdan bo'shatish")
                                                        </span>
                                                    </td>
                                                    <td>@item.FromOrgUnitName</td>
                                                    <td>@item.FromPositionName</td>
                                                    <td>@(item.ActionType == "Transfer" ? item.ToOrgUnitName : "-")</td>
                                                    <td>@(item.ActionType == "Transfer" ? item.ToPositionName : "-")</td>
                                                    <td>@(((DateTime)item.EffectiveDate).ToString("dd.MM.yyyy"))</td>
                                                    <td>@(item.Reason ?? "-")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">Xodim tarixi bo'yicha ma'lumotlar mavjud emas.</p>
                            }

                            <div class="form-actions mt-3">
                                @if (changePermit)
                                {
                                    <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                                        <i class="bx bx-edit"></i> Tahrirlash
                                    </a>
                                }
                                <a href="@Url.Action("Index")" class="btn btn-secondary">Ro'yxatga qaytish</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            if ($('#historyTable').length) {
                $('#historyTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Russian.json"
                    },
                    "pageLength": 10,
                    "order": [[5, "desc"]]
                });
            }
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

