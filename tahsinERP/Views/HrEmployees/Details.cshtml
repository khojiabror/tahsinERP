@model tahsinERP.ViewModels.HR.HrEmployeeViewModel
@{
    ViewBag.Title = "Xodim tafsilotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "HrEmployees"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrEmployees");

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Xodimlar</a></li>
                                    <li class="breadcrumb-item active">Tafsilotlar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">Tabelliy raqam:</dt>
                                <dd class="col-sm-9">@Model.TabNo</dd>

                                <dt class="col-sm-3">F.I.O.:</dt>
                                <dd class="col-sm-9">@Model.FullName</dd>

                                <dt class="col-sm-3">Bo'lim:</dt>
                                <dd class="col-sm-9">@(Model.OrgUnitName ?? "-")</dd>

                                <dt class="col-sm-3">Lavozim:</dt>
                                <dd class="col-sm-9">@(Model.PositionName ?? "-")</dd>

                                <dt class="col-sm-3">Asosiy maosh:</dt>
                                <dd class="col-sm-9">@(Model.BaseSalary?.ToString("N2") ?? "-")</dd>

                                <dt class="col-sm-3">Moddiy javobgarlik ustamasi:</dt>
                                <dd class="col-sm-9">@((Model.MaterialResponsibilityPercent ?? 0).ToString("N2")) %</dd>

                                <dt class="col-sm-3">Maxsus ustama:</dt>
                                <dd class="col-sm-9">@((Model.SpecialAllowancePercent ?? 0).ToString("N2")) %</dd>

                                <dt class="col-sm-3">Tarif tarmog'i:</dt>
                                <dd class="col-sm-9">@(Model.SalaryGradeName ?? "-")</dd>

                                <dt class="col-sm-3">Ushbu lavozimda ish boshlagan sana:</dt>
                                <dd class="col-sm-9">@(Model.EmploymentDate?.ToString("dd.MM.yyyy") ?? "-")</dd>

                                <dt class="col-sm-3">Lavozimdan bo'shatilgan sana:</dt>
                                <dd class="col-sm-9">@(Model.DismissalDate?.ToString("dd.MM.yyyy") ?? "-")</dd>

                                <dt class="col-sm-3">Hozirdagi status:</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.IsActive ? "success" : "danger")">
                                        @(Model.IsActive ? "Ishlaydi" : "Ishdan ketgan")
                                    </span>
                                </dd>
                            </dl>

                            <hr />

                            <h5 class="mb-2">Xodim tarixi</h5>
                            @if (changePermit)
                            {
                                <div class="mb-1">
                                    <button type="button" class="btn btn-sm btn-primary" data-toggle="modal" data-target="#addTenureModal">
                                        <i class="bx bx-plus"></i> Staj qo'shish
                                    </button>
                                </div>
                            }
                            @if (ViewBag.History != null)
                            {
                                var history = ViewBag.History as List<tahsinERP.ViewModels.HR.HrEmployeeHistoryViewModel>;
                                if (history != null && history.Any())
                                {
                                    <div class="table-responsive">
                                        <table id="historyTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Bo'lim</th>
                                                    <th>Lavozim</th>
                                                    <th>Ishga kirgan sana</th>
                                                    <th>Ishdan chiqqan sana</th>
                                                    <th>Sabab</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in history)
                                                {
                                                    <tr>
                                                        <td>@(item.FromOrgUnitName ?? "-")</td>
                                                        <td>@(item.FromPositionName ?? "-")</td>
                                                        <td>@(item.EffectiveDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                                                        <td>@(item.IsCurrentRow ? "shu kungacha" : (item.EffectiveDateTo?.ToString("dd.MM.yyyy") ?? "-"))</td>
                                                        <td>@(item.Reason ?? "-")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">Xodim tarixi bo'yicha ma'lumotlar mavjud emas.</p>
                                }
                            }
                            else
                            {
                                <p class="text-muted">Xodim tarixi bo'yicha ma'lumotlar mavjud emas.</p>
                            }

                            <div class="form-actions mt-3">
                                @if (changePermit)
                                {
                                    <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                                        <i class="bx bx-edit"></i> Tahrirlash
                                    </a>
                                }
                                <a href="@Url.Action("Index")" class="btn btn-secondary">Ro'yxatga qaytish</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    if (changePermit)
    {
        <div class="modal fade" id="addTenureModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    @using (Html.BeginForm("AddTenure", "HrEmployees", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="employeeId" value="@Model.ID" />
                        <div class="modal-header">
                            <h5 class="modal-title">Ko'rsatilmayotgan staj davrini qo'shish</h5>
                            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                        </div>
                        <div class="modal-body">
                            <div class="form-group">
                                <label>Bo'lim <span class="text-danger">*</span></label>
                                @Html.DropDownList("fromOrgUnitId", ViewBag.HistoryOrgUnitID as SelectList, "Bo'limni tanlang", new { @class = "form-control", required = "required" })
                            </div>
                            <div class="form-group">
                                <label>Lavozim <span class="text-danger">*</span></label>
                                @Html.DropDownList("fromPositionId", ViewBag.HistoryPositionID as SelectList, "Lavozimni tanlang", new { @class = "form-control", required = "required" })
                            </div>
                            <div class="form-group">
                                <label>Boshlanish sanasi <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" name="effectiveDateFrom" required />
                            </div>
                            <div class="form-group">
                                <label>Tugash sanasi (ixtiyoriy)</label>
                                <input type="date" class="form-control" name="effectiveDateTo" />
                                <small class="text-muted">Bo'sh qoldirilsa "shu kungacha" deb olinadi.</small>
                            </div>
                            <div class="form-group">
                                <label>Sabab</label>
                                <textarea class="form-control" name="reason" rows="2" placeholder="Masalan: arxivdagi davrni tiklash"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Bekor qilish</button>
                            <button type="submit" class="btn btn-primary">Saqlash</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <script>
        $(document).ready(function() {
            if ($('#historyTable').length) {
                $('#historyTable').DataTable({
                    "language": {
                        "lengthMenu": "_MENU_ ta ko'rsatish",
                        "zeroRecords": "Yozuvlar topilmadi",
                        "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                        "infoEmpty": "Yozuvlar yo'q",
                        "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                        "search": "Qidirish:",
                        "paginate": {
                            "first": "Birinchi",
                            "last": "Oxirgi",
                            "next": "Keyingi",
                            "previous": "Oldingi"
                        }
                    },
                    "pageLength": 10,
                    "order": [[2, "asc"], [3, "asc"]]
                });
            }
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

