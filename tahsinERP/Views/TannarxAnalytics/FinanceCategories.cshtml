@model tahsinERP.ViewModels.Tannarx.TannarxFinanceCategoryMapViewModel

@{
    ViewBag.Title = L.T("Mes_TanA_FinCatTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "Tannarx"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Tannarx", "Edit");
    int? backYear = ViewBag.Year;
    int? backMonth = ViewBag.Month;

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Tannarx">@L.T("Mes_Tan_Title")</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("MonthSources", "TannarxAnalytics", new { year = backYear, month = backMonth })">@L.T("Mes_TanA_MonthSourcesTitle")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Mes_TanA_FinCategories")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">@L.T("Mes_TanA_FinCatHeader")</h4>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small">
                            @L.T("Mes_TanA_FinCatHelp1")
                            @L.T("Mes_TanA_FinCatHelp2")
                            @L.T("Mes_TanA_FinCatHelp3")
                        </p>
                        @if (!Model.TableExists)
                        {
                            <div class="alert alert-info small">@L.T("Mes_TanA_FinCatNoTable")</div>
                        }

                        @using (Html.BeginForm("FinanceCategories", "TannarxAnalytics", new { year = backYear, month = backMonth }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th>@L.T("Category")</th>
                                            <th class="text-right">@L.T("Mes_TanA_Transactions")</th>
                                            <th style="min-width:220px">@L.T("Mes_TanA_CostGroup")</th>
                                            <th>@L.T("Mes_TanA_IfAuto")</th>
                                            <th>@L.T("Mes_TanA_InEffect")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model.Rows)
                                        {
                                            var current = r.ManualBucket.HasValue ? r.ManualBucket.Value.ToString() : "";
                                            <tr class="@(r.IsActive ? "" : "text-muted")">
                                                <td>
                                                    @if (r.ParentName != null)
                                                    {
                                                        <span class="text-muted small">@r.ParentName ›</span>
                                                    }
                                                    @r.Name
                                                    @if (!r.IsActive)
                                                    {
                                                        <span class="badge badge-light-secondary">@L.T("Mes_TanA_InactiveLower")</span>
                                                    }
                                                </td>
                                                <td class="text-right">@r.TransactionCount</td>
                                                <td>
                                                    <select name="bucket_@r.CategoryID" class="form-control form-control-sm" @(changePermit ? "" : "disabled")>
                                                        @foreach (var o in tahsinERP.ViewModels.Tannarx.TannarxFinanceCategoryMapViewModel.Options)
                                                        {
                                                            <option value="@o.Key" @(o.Key == current ? "selected" : "")>@L.T(o.Value)</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td class="small">@r.AutoBucket <span class="text-muted">(@r.AutoReason)</span></td>
                                                <td class="small font-weight-bold">@r.EffectiveBucket</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            if (changePermit)
                            {
                                <button type="submit" class="btn btn-primary mt-2"><i class="bx bx-save"></i> @L.T("Save")</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
