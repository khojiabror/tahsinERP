@model tahsinERP.ViewModels.Tannarx.TannarxAnalyticsReportViewModel

@{
    ViewBag.Title = "Tannarx tahlili — maxsulot tafsilotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var monthNames = new[] { "", "Yanvar", "Fevral", "Mart", "Aprel", "May", "Iyun", "Iyul", "Avgust", "Sentabr", "Oktabr", "Noyabr", "Dekabr" };
    var periodText = (Model.Month >= 1 && Model.Month <= 12 && Model.Year.HasValue)
        ? $"{monthNames[Model.Month.Value]}-{Model.Year}"
        : (Model.Year.HasValue ? Model.Year.ToString() : "");
    var profitDiff = Model.ActualProfit - Model.PlannedProfit;
    decimal? profitVarPct = null;
    if (Model.PlannedProfit != 0)
    {
        profitVarPct = (profitDiff / Math.Abs(Model.PlannedProfit)) * 100m;
    }
    var exwNoVatVar = Model.ActualEXWWithoutVAT - Model.PlannedEXWWithoutVAT;
    var cipNoVatVar = Model.ActualCIPWithoutVAT - Model.PlannedCIPWithoutVAT;
    var taxVar = Model.ActualTaxAndBank - Model.PlannedTaxAndBank;
    var otherVar = Model.ActualOtherExpenses - Model.PlannedOtherExpenses;
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "Tannarx"))
{
    <div class="app-content content tannarx-analytics-page">
        <div class="content-overlay tannarx-no-pointer"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Tannarx">Tannarx</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "TannarxAnalytics")">Tahlil</a></li>
                                    <li class="breadcrumb-item active">Tafsilotlar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row mb-2 no-print">
                    <div class="col-12 text-right">
                        <button type="button" id="btnTannarxPrint" class="btn btn-primary">
                            <i class="bx bx-printer"></i> Chop etish
                        </button>
                        <a href="@Url.Action("Report", "TannarxAnalytics", new { year = Model.Year, month = Model.Month, productID = Model.ProductID })"
                           class="btn btn-secondary">
                            <i class="bx bx-arrow-back"></i> Orqaga
                        </a>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="card tannarx-detail-card border-0 shadow-sm" id="printArea">
                            <div class="card-header tannarx-detail-card-header border-bottom-0 pb-0">
                                <h4 class="card-title mb-1">Tannarx — reja va fakt</h4>
                                <p class="mb-0 text-muted small">
                                    <strong>@Model.ProductPNo</strong> — @Model.ProductName
                                    @if (!string.IsNullOrEmpty(periodText))
                                    {
                                        <span> · @periodText</span>
                                    }
                                </p>
                            </div>
                            <div class="card-content">
                                <div class="card-body pt-2">

                                    <h6 class="tannarx-section-title mb-2">Material xarajatlari</h6>
                                    <div class="table-responsive mb-3">
                                        <table class="table table-bordered table-hover table-sm mb-0 tannarx-metric-table tannarx-print-table">
                                            <thead>
                                                <tr>
                                                    <th>Xarajat turi</th>
                                                    <th class="text-right">Reja</th>
                                                    <th class="text-right">Fakt</th>
                                                    <th class="text-right">Farq</th>
                                                    <th class="text-right">Farq %</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>Material narxi</td>
                                                    <td class="text-right">@Model.PlannedMaterialPrice.ToString("N0")</td>
                                                    <td class="text-right @PdCostAct(Model.ActualMaterialPrice, Model.PlannedMaterialPrice)">@Model.ActualMaterialPrice.ToString("N0")</td>
                                                    <td class="text-right @PdCostVar(Model.MaterialPriceVariance)">@Model.MaterialPriceVariance.ToString("N0")</td>
                                                    <td class="text-right @PdCostVarPct(Model.MaterialPriceVariancePercent)">@Model.MaterialPriceVariancePercent.ToString("N2")%</td>
                                                </tr>
                                                <tr>
                                                    <td>Material tashuvi</td>
                                                    <td class="text-right">@Model.PlannedMaterialTransportCost.ToString("N0")</td>
                                                    <td class="text-right @PdCostAct(Model.ActualMaterialTransportCost, Model.PlannedMaterialTransportCost)">@Model.ActualMaterialTransportCost.ToString("N0")</td>
                                                    <td class="text-right @PdCostVar(Model.MaterialTransportVariance)">@Model.MaterialTransportVariance.ToString("N0")</td>
                                                    <td class="text-right @PdCostVarPct(Model.MaterialTransportVariancePercent)">@Model.MaterialTransportVariancePercent.ToString("N2")%</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="small font-weight-bold text-muted mb-1">Fakt material narxi hisob izohi</label>
                                        <textarea class="form-control tannarx-material-note" rows="8" readonly>@(string.IsNullOrWhiteSpace(Model.ActualMaterialCalculationNote) ? "Hisob izohi mavjud emas." : Model.ActualMaterialCalculationNote)</textarea>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="small font-weight-bold text-muted mb-1">Material tashuvi hisob izohi</label>
                                        <textarea class="form-control tannarx-material-note" rows="7" readonly>@(string.IsNullOrWhiteSpace(Model.ActualMaterialTransportCalculationNote) ? "Hisob izohi mavjud emas." : Model.ActualMaterialTransportCalculationNote)</textarea>
                                    </div>

                                    <h6 class="tannarx-section-title mb-2">Ish haqi va xarajatlar</h6>
                                    <div class="table-responsive mb-3">
                                        <table class="table table-bordered table-hover table-sm mb-0 tannarx-metric-table tannarx-print-table">
                                            <thead>
                                                <tr>
                                                    <th>Xarajat turi</th>
                                                    <th class="text-right">Reja</th>
                                                    <th class="text-right">Fakt</th>
                                                    <th class="text-right">Farq</th>
                                                    <th class="text-right">Farq %</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>A — Ish haqi</td>
                                                    <td class="text-right">@Model.PlannedLaborCost.ToString("N0")</td>
                                                    <td class="text-right @PdCostAct(Model.ActualLaborCost, Model.PlannedLaborCost)">@Model.ActualLaborCost.ToString("N0")</td>
                                                    <td class="text-right @PdCostVar(Model.LaborCostVariance)">@Model.LaborCostVariance.ToString("N0")</td>
                                                    <td class="text-right @PdCostVarPct(Model.LaborCostVariancePercent)">@Model.LaborCostVariancePercent.ToString("N2")%</td>
                                                </tr>
                                                <tr>
                                                    <td>B — Soliq va bank</td>
                                                    <td class="text-right">@Model.PlannedTaxAndBank.ToString("N0")</td>
                                                    <td class="text-right @PdCostAct(Model.ActualTaxAndBank, Model.PlannedTaxAndBank)">@Model.ActualTaxAndBank.ToString("N0")</td>
                                                    <td class="text-right @PdCostVar(taxVar)">@taxVar.ToString("N0")</td>
                                                    <td class="text-right @PdCostVarPct(PdPct(taxVar, Model.PlannedTaxAndBank))">@PdPctStr(taxVar, Model.PlannedTaxAndBank)</td>
                                                </tr>
                                                <tr>
                                                    <td>C — Administrativ</td>
                                                    <td class="text-right">@Model.PlannedAdministrativeExpenses.ToString("N0")</td>
                                                    <td class="text-right @PdCostAct(Model.ActualAdministrativeExpenses, Model.PlannedAdministrativeExpenses)">@Model.ActualAdministrativeExpenses.ToString("N0")</td>
                                                    <td class="text-right @PdCostVar(Model.AdminExpensesVariance)">@Model.AdminExpensesVariance.ToString("N0")</td>
                                                    <td class="text-right @PdCostVarPct(Model.AdminExpensesVariancePercent)">@Model.AdminExpensesVariancePercent.ToString("N2")%</td>
                                                </tr>
                                                <tr>
                                                    <td>D — Boshqa</td>
                                                    <td class="text-right">@Model.PlannedOtherExpenses.ToString("N0")</td>
                                                    <td class="text-right @PdCostAct(Model.ActualOtherExpenses, Model.PlannedOtherExpenses)">@Model.ActualOtherExpenses.ToString("N0")</td>
                                                    <td class="text-right @PdCostVar(otherVar)">@otherVar.ToString("N0")</td>
                                                    <td class="text-right @PdCostVarPct(PdPct(otherVar, Model.PlannedOtherExpenses))">@PdPctStr(otherVar, Model.PlannedOtherExpenses)</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="small font-weight-bold text-muted mb-1">Ish haqi va xarajatlar (Finance) hisob izohi</label>
                                        <textarea class="form-control tannarx-material-note" rows="8" readonly>@(string.IsNullOrWhiteSpace(Model.ActualOverheadCalculationNote) ? "Hisob izohi mavjud emas." : Model.ActualOverheadCalculationNote)</textarea>
                                    </div>

                                    <h6 class="tannarx-section-title mb-2">EXW narxlari</h6>
                                    <div class="table-responsive mb-3">
                                        <table class="table table-bordered table-hover table-sm mb-0 tannarx-metric-table tannarx-print-table">
                                            <thead>
                                                <tr>
                                                    <th>Narx turi</th>
                                                    <th class="text-right">Reja</th>
                                                    <th class="text-right">Fakt</th>
                                                    <th class="text-right">Farq</th>
                                                    <th class="text-right">Farq %</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>EXW QQSsiz</td>
                                                    <td class="text-right">@Model.PlannedEXWWithoutVAT.ToString("N0")</td>
                                                    <td class="text-right @PdPriceAct(Model.ActualEXWWithoutVAT, Model.PlannedEXWWithoutVAT)">@Model.ActualEXWWithoutVAT.ToString("N0")</td>
                                                    <td class="text-right @PdPriceVar(exwNoVatVar)">@exwNoVatVar.ToString("N0")</td>
                                                    <td class="text-right @PdPriceVarPct(PdPct(exwNoVatVar, Model.PlannedEXWWithoutVAT))">@PdPctStr(exwNoVatVar, Model.PlannedEXWWithoutVAT)</td>
                                                </tr>
                                                <tr>
                                                    <td>EXW QQS bilan</td>
                                                    <td class="text-right">@Model.PlannedSetPriceEXWWithVAT.ToString("N0")</td>
                                                    <td class="text-right @PdPriceAct(Model.ActualEXWWithVAT, Model.PlannedSetPriceEXWWithVAT)">@Model.ActualEXWWithVAT.ToString("N0")</td>
                                                    <td class="text-right @PdPriceVar(Model.EXWVariance)">@Model.EXWVariance.ToString("N0")</td>
                                                    <td class="text-right @PdPriceVarPct(Model.EXWVariancePercent)">@Model.EXWVariancePercent.ToString("N2")%</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    @{
                                        var exwTips = new System.Collections.Generic.List<string>();
                                        if (Model.ActualMaterialPrice > Model.PlannedMaterialPrice)
                                        {
                                            exwTips.Add("material sarf harajati rejadagi normadan oshib ketdi, kamaytirish ustida bosh qotiring");
                                        }
                                        if (Model.ActualMaterialTransportCost > Model.PlannedMaterialTransportCost)
                                        {
                                            exwTips.Add("material tashuvi harajati rejadan oshib ketdi, logistika xarajatini optimallashtiring");
                                        }
                                        if (Model.ActualLaborCost > Model.PlannedLaborCost)
                                        {
                                            exwTips.Add("ish haqi harajati rejadan oshib ketdi, mehnat samaradorligini oshiring");
                                        }
                                        if (Model.ActualTaxAndBank > Model.PlannedTaxAndBank)
                                        {
                                            exwTips.Add("soliq yoki bank xizmati harajati rejadan oshib ketdi, stavka va to'lovlarni qayta ko'rib chiqing");
                                        }
                                        if (Model.ActualAdministrativeExpenses > Model.PlannedAdministrativeExpenses)
                                        {
                                            exwTips.Add("administrativ harajat rejadan oshib ketdi, ichki xarajatlarni qisqartiring");
                                        }
                                        if (Model.ActualOtherExpenses > Model.PlannedOtherExpenses)
                                        {
                                            exwTips.Add("boshqa harajatlar rejadan oshib ketdi, sababini aniqlab cheklang");
                                        }
                                        if (Model.ActualEXWWithoutVAT > Model.PlannedEXWWithoutVAT || Model.ActualEXWWithVAT > Model.PlannedSetPriceEXWWithVAT)
                                        {
                                            exwTips.Add("EXW narxi rejadan baland chiqdi, yuqoridagi oshgan bandlarni kamaytirish ustida ishlang");
                                        }
                                    }
                                    @if (exwTips.Any())
                                    {
                                        <div class="alert alert-warning py-1 px-2 mb-3">
                                            <i class="bx bx-info-circle"></i> Tip:
                                            <ul class="mb-0 mt-1 pl-2">
                                                @foreach (var msg in exwTips.Distinct())
                                                {
                                                    <li>@msg</li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    <h6 class="tannarx-section-title mb-2">Tayyor mahsulot tashuvi</h6>
                                    <div class="table-responsive mb-3">
                                        <table class="table table-bordered table-hover table-sm mb-0 tannarx-metric-table tannarx-print-table">
                                            <thead>
                                                <tr>
                                                    <th>Ko‘rsatkich</th>
                                                    <th class="text-right">Reja</th>
                                                    <th class="text-right">Fakt</th>
                                                    <th class="text-right">Farq</th>
                                                    <th class="text-right">Farq %</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>Yetkazib berish (birlik)</td>
                                                    <td class="text-right">@Model.PlannedFinishedProductTransportCost.ToString("N0")</td>
                                                    <td class="text-right @PdCostAct(Model.ActualFinishedProductTransportCost, Model.PlannedFinishedProductTransportCost)">@Model.ActualFinishedProductTransportCost.ToString("N0")</td>
                                                    <td class="text-right @PdCostVar(Model.FinishedProductTransportVariance)">@Model.FinishedProductTransportVariance.ToString("N0")</td>
                                                    <td class="text-right @PdCostVarPct(Model.FinishedProductTransportVariancePercent)">@Model.FinishedProductTransportVariancePercent.ToString("N2")%</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="small font-weight-bold text-muted mb-1">Tayyor mahsulot tashuvi hisob izohi</label>
                                        <textarea class="form-control tannarx-material-note" rows="7" readonly>@(string.IsNullOrWhiteSpace(Model.ActualFinishedTransportCalculationNote) ? "Hisob izohi mavjud emas." : Model.ActualFinishedTransportCalculationNote)</textarea>
                                    </div>

                                    <h6 class="tannarx-section-title mb-2">CIP narxlari</h6>
                                    <div class="table-responsive mb-3">
                                        <table class="table table-bordered table-hover table-sm mb-0 tannarx-metric-table tannarx-print-table">
                                            <thead>
                                                <tr>
                                                    <th>Narx turi</th>
                                                    <th class="text-right">Reja</th>
                                                    <th class="text-right">Fakt</th>
                                                    <th class="text-right">Farq</th>
                                                    <th class="text-right">Farq %</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>CIP QQSsiz</td>
                                                    <td class="text-right">@Model.PlannedCIPWithoutVAT.ToString("N0")</td>
                                                    <td class="text-right @PdPriceAct(Model.ActualCIPWithoutVAT, Model.PlannedCIPWithoutVAT)">@Model.ActualCIPWithoutVAT.ToString("N0")</td>
                                                    <td class="text-right @PdPriceVar(cipNoVatVar)">@cipNoVatVar.ToString("N0")</td>
                                                    <td class="text-right @PdPriceVarPct(PdPct(cipNoVatVar, Model.PlannedCIPWithoutVAT))">@PdPctStr(cipNoVatVar, Model.PlannedCIPWithoutVAT)</td>
                                                </tr>
                                                <tr>
                                                    <td>CIP QQS bilan</td>
                                                    <td class="text-right">@Model.PlannedSetPriceCIPWithVAT.ToString("N0")</td>
                                                    <td class="text-right @PdPriceAct(Model.ActualCIPWithVAT, Model.PlannedSetPriceCIPWithVAT)">@Model.ActualCIPWithVAT.ToString("N0")</td>
                                                    <td class="text-right @PdPriceVar(Model.CIPVariance)">@Model.CIPVariance.ToString("N0")</td>
                                                    <td class="text-right @PdPriceVarPct(Model.CIPVariancePercent)">@Model.CIPVariancePercent.ToString("N2")%</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    @{
                                        var cipTips = new System.Collections.Generic.List<string>();
                                        if (Model.ActualFinishedProductTransportCost > Model.PlannedFinishedProductTransportCost)
                                        {
                                            cipTips.Add("tayyor mahsulot tashuvi rejadan oshib ketdi, yetkazib berish xarajatini optimallashtiring");
                                        }
                                        if (Model.ActualCIPWithoutVAT > Model.PlannedCIPWithoutVAT || Model.ActualCIPWithVAT > Model.PlannedSetPriceCIPWithVAT)
                                        {
                                            cipTips.Add("CIP narxi rejadan baland chiqdi, EXW va tashuv harajatlarini kamaytirish ustida ishlang");
                                        }
                                    }
                                    @if (cipTips.Any())
                                    {
                                        <div class="alert alert-warning py-1 px-2 mb-3">
                                            <i class="bx bx-info-circle"></i> Tip:
                                            <ul class="mb-0 mt-1 pl-2">
                                                @foreach (var msg in cipTips.Distinct())
                                                {
                                                    <li>@msg</li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    <h6 class="tannarx-section-title mb-2 mt-1">E — Foyda</h6>
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-hover table-sm mb-0 tannarx-metric-table tannarx-print-table tannarx-profit-table">
                                            <thead>
                                                <tr>
                                                    <th>Ko‘rsatkich</th>
                                                    <th class="text-right">Reja</th>
                                                    <th class="text-right">Fakt</th>
                                                    <th class="text-right">Farq</th>
                                                    <th class="text-right">Farq %</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>Reja / fakt foyda</td>
                                                    <td class="text-right">@Model.PlannedProfit.ToString("N0")</td>
                                                    <td class="text-right font-weight-bold @PdPriceAct(Model.ActualProfit, Model.PlannedProfit)">@Model.ActualProfit.ToString("N0")</td>
                                                    <td class="text-right @PdPriceVar(profitDiff)">@profitDiff.ToString("N0")</td>
                                                    <td class="text-right @PdPriceVarPct(profitVarPct ?? 0)">@(profitVarPct.HasValue ? profitVarPct.Value.ToString("N2") + "%" : "—")</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <p class="text-muted small mb-0 mt-2">
                                        Reja narxi (EXW QQS bilan): <strong>@Model.PlannedSetPriceEXWWithVAT.ToString("N0")</strong> so‘m
                                    </p>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .tannarx-detail-card-header { background: linear-gradient(135deg, #f8fafc 0%, #eef2f7 100%); border-radius: 0.5rem 0.5rem 0 0; }
        .tannarx-section-title { font-weight: 600; color: #364152; border-left: 4px solid #696cff; padding-left: 0.5rem; }
        .tannarx-metric-table thead th {
            background: #f1f3f9;
            color: #4b5563;
            font-weight: 600;
            font-size: 0.8125rem;
            border-color: #e2e8f0;
        }
        .tannarx-metric-table tbody td { border-color: #e8ecf4; }
        .tannarx-profit-table tbody tr { background: linear-gradient(180deg, #fafbff 0%, #fff 100%); }
        .tannarx-material-note { font-size: 12px; line-height: 1.35; background: #f8fafc; }
        /* Tema content-overlay ba'zan tugmani bosishni bloklaydi */
        .tannarx-no-pointer.content-overlay { pointer-events: none !important; }

        /* Chop etishda blank page bo'lmasligi uchun: faqat print area ko'rsatiladi */
        @@media print {
            body * { visibility: hidden !important; }
            #printArea, #printArea * { visibility: visible !important; }
            #printArea {
                position: absolute !important;
                left: 0 !important;
                top: 0 !important;
                width: 100% !important;
                border: none !important;
                box-shadow: none !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .no-print { display: none !important; }
        }
    </style>

    @* Chop etish: ~/Content/tannarx-print-tables.css — tema margin + jadval andozasi *@
    <link href="@Url.Content("~/Content/tannarx-print-tables.css")" rel="stylesheet" type="text/css" media="print" />

    <script>
        (function () {
            function printTannarxProductDetails() {
                try {
                    var content = document.getElementById('printArea');
                    if (!content) {
                        alert('Chop etish kontenti topilmadi (#printArea).');
                        return;
                    }

                    var printWindow = window.open('', '_blank', 'width=1200,height=900');
                    if (!printWindow) {
                        alert('Chop etish oynasi ochilmadi. Brauzer popup bloklagan bo\'lishi mumkin.');
                        return;
                    }

                    // Print uchun izoh textarea larni oddiy text blokka aylantiramiz
                    var printRoot = content.cloneNode(true);
                    var noteAreas = printRoot.querySelectorAll('textarea');
                    noteAreas.forEach(function (ta) {
                        var textBlock = document.createElement('div');
                        textBlock.className = 'print-note-text';
                        textBlock.textContent = ta.value || ta.textContent || '';
                        ta.parentNode.replaceChild(textBlock, ta);
                    });

                    var html = '<!doctype html><html><head><meta charset="utf-8">' +
                        '<title>Tannarx chop etish</title>' +
                        '<style>' +
                        'body{font-family:Arial,sans-serif;margin:12px;color:#000;}' +
                        'h4,h6{margin:8px 0;}' +
                        'table{width:100%;border-collapse:collapse;font-size:12px;margin-bottom:10px;}' +
                        'th,td{border:1px solid #444;padding:6px;vertical-align:middle;}' +
                        'th{background:#eef2f7;}' +
                        '.text-right{text-align:right;}' +
                        '.text-success{color:#0d6e3f;font-weight:700;}' +
                        '.text-danger{color:#b02a37;font-weight:700;}' +
                        '.text-muted{color:#555;}' +
                        '.tannarx-section-title{font-weight:700;border-left:3px solid #333;padding-left:6px;}' +
                        '.print-note-text{white-space:pre-wrap;word-break:break-word;width:100%;border:1px solid #444;padding:8px;font-size:12px;line-height:1.4;margin:0;}' +
                        '.no-print{display:none !important;}' +
                        '</style></head><body>' +
                        printRoot.outerHTML +
                        '</body></html>';

                    printWindow.document.open();
                    printWindow.document.write(html);
                    printWindow.document.close();

                    printWindow.onload = function () {
                        printWindow.focus();
                        printWindow.print();
                        printWindow.close();
                    };
                } catch (ex) {
                    console.warn('Chop etish:', ex);
                }
            }
            document.addEventListener('DOMContentLoaded', function () {
                var btn = document.getElementById('btnTannarxPrint');
                if (btn) {
                    btn.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        printTannarxProductDetails();
                    });
                }
            });
        })();
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@functions
{
    // Xarajat: fakt rejadan past — yaxshi (yashil), baland — yomon (qizil).
    string PdCostAct(decimal actual, decimal planned)
    {
        if (actual < planned) return "text-success font-weight-bold";
        if (actual > planned) return "text-danger font-weight-bold";
        return "";
    }

    // Bir xil qoida: fakt < reja => yashil, fakt > reja => qizil.
    string PdPriceAct(decimal actual, decimal planned)
    {
        if (actual < planned) return "text-success font-weight-bold";
        if (actual > planned) return "text-danger font-weight-bold";
        return "";
    }

    string PdCostVar(decimal variance)
    {
        if (variance < 0) return "text-success";
        if (variance > 0) return "text-danger";
        return "text-muted";
    }

    string PdCostVarPct(decimal variancePct)
    {
        if (variancePct < 0) return "text-success";
        if (variancePct > 0) return "text-danger";
        return "text-muted";
    }

    string PdPriceVar(decimal variance)
    {
        if (variance > 0) return "text-success";
        if (variance < 0) return "text-danger";
        return "text-muted";
    }

    string PdPriceVarPct(decimal variancePct)
    {
        if (variancePct > 0) return "text-success";
        if (variancePct < 0) return "text-danger";
        return "text-muted";
    }

    decimal PdPct(decimal diff, decimal planned)
    {
        if (planned == 0) return 0;
        return (diff / Math.Abs(planned)) * 100m;
    }

    string PdPctStr(decimal diff, decimal planned)
    {
        if (planned == 0) return "—";
        return PdPct(diff, planned).ToString("N2") + "%";
    }
}
