@model tahsinERP.ViewModels.Tannarx.TannarxMonthSourcesViewModel

@{
    ViewBag.Title = L.T("Mes_TanA_MonthSourcesTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@functions {
    // Engine Bucket qiymatlari (kodda solishtiriladi) — faqat ko'rsatish uchun tarjima
    private static string BucketText(string bucket)
    {
        switch (bucket)
        {
            case "Material (PATH3)": return L.T("Mes_Tan_Bucket_Material");
            case "B — Soliq va bank": return L.T("Mes_Tan_Bucket_TaxBank");
            case "D — Boshqa": return L.T("Mes_Tan_Bucket_Other");
            case "Chiqarildi": return L.T("Mes_TanA_Bucket_Excluded");
            default: return bucket;
        }
    }
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "Tannarx"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Tannarx", "Edit");

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Tannarx">@L.T("Mes_Tan_Title")</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "TannarxAnalytics", new { year = Model.Year, month = Model.Month })">@L.T("Mes_TanA_Analysis")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Mes_TanA_MonthSourcesTitle")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <form id="sourcesFilter" method="get" action="@Url.Action("MonthSources", "TannarxAnalytics")">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <label>@L.T("Mes_Year")</label>
                                            @Html.DropDownList("year", (SelectList)ViewBag.Years, new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Mes_Month")</label>
                                            @Html.DropDownList("month", (SelectList)ViewBag.Months, new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-6 d-flex align-items-end">
                                            <button type="submit" class="btn btn-primary mr-1"><i class="bx bx-search"></i> @L.T("Mes_Show")</button>
                                            @if (changePermit)
                                            {
                                                <button type="submit" form="updateActualForm" class="btn btn-success">
                                                    <i class="bx bx-refresh"></i> @L.T("Mes_TanA_WriteToCost")
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </form>
                                @if (changePermit)
                                {
                                    using (Html.BeginForm("UpdateActualCosts", "TannarxAnalytics", FormMethod.Post, new { id = "updateActualForm" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="year" value="@Model.Year" />
                                        <input type="hidden" name="month" value="@Model.Month" />
                                        <input type="hidden" name="returnTo" value="Dashboard" />
                                    }
                                }
                                <p class="text-muted small mb-0 mt-1">
                                    @Model.MonthString @Model.Year: @L.T("Mes_TanA_AllProducedQty") — <b>@Model.MonthProducedQty.ToString("N2")</b> @L.T("Mes_TanA_PcsEnd")
                                    @L.T("Currency"): @(Model.BaseCurrencyCode ?? L.T("Mes_TanA_AllCurrenciesNoUzs")). @L.T("Mes_TanA_ReadOnlyHint")
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                @foreach (var w in Model.Warnings)
                {
                    <div class="alert alert-warning mb-1">@w</div>
                }

                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header"><h4 class="card-title">@L.T("Mes_TanA_ElementsHeader")</h4></div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm mb-0">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Mes_TanA_Element")</th>
                                                <th>@L.T("Mes_TanA_Source")</th>
                                                <th class="text-right">@L.T("Mes_TanA_InSource")</th>
                                                <th class="text-right">@L.T("Mes_TanA_AllocatedToCost")</th>
                                                <th class="text-right">@L.T("Mes_TanA_Unallocated")</th>
                                                <th>@L.T("Comment")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var e in Model.Elements)
                                            {
                                                var un = e.Unallocated;
                                                <tr>
                                                    <td>@e.Element</td>
                                                    <td>@e.Source</td>
                                                    <td class="text-right">@(e.SourceTotal.HasValue ? e.SourceTotal.Value.ToString("N0") : "—")</td>
                                                    <td class="text-right font-weight-bold">@e.AllocatedTotal.ToString("N0")</td>
                                                    <td class="text-right @(un.HasValue && Math.Abs(un.Value) >= 1 ? "text-warning" : "")">@(un.HasValue ? un.Value.ToString("N0") : "—")</td>
                                                    <td class="small text-muted">@e.Note</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Mes_TanA_ProductsActualPerUnit")</h4>
                                <div class="small text-muted">
                                    @foreach (var kv in Model.MaterialPathCounts)
                                    {
                                        <span class="badge badge-light-primary mr-1">@kv.Key: @kv.Value</span>
                                    }
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover table-sm mb-0">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Mes_Product")</th>
                                                <th class="text-right">@L.T("Mes_TanA_ProducedShort")</th>
                                                <th>@L.T("Mes_TanA_MaterialAlgorithm")</th>
                                                <th class="text-right">@L.T("Mes_Materials")</th>
                                                <th class="text-right">@L.T("Mes_TanA_MatTransportShort")</th>
                                                <th class="text-right">@L.T("Mes_TanA_ColLaborA")</th>
                                                <th class="text-right">@L.T("Mes_TanA_ColTaxBankB")</th>
                                                <th class="text-right">@L.T("Mes_TanA_ColAdminC")</th>
                                                <th class="text-right">@L.T("Mes_TanA_ColOtherD")</th>
                                                <th class="text-right">@L.T("Mes_TanA_TotalCost")</th>
                                                <th class="text-right">@L.T("Mes_TanA_FgTransportShort")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var p in Model.Products)
                                            {
                                                <tr class="@(p.ProducedQty <= 0 ? "text-muted" : "")">
                                                    <td>
                                                        <a href="@Url.Action("ProductDetails", "TannarxAnalytics", new { productID = p.ProductID, year = Model.Year, month = Model.Month })">@p.ProductPNo</a>
                                                        <div class="small">@p.ProductName</div>
                                                    </td>
                                                    <td class="text-right">@p.ProducedQty.ToString("N0")</td>
                                                    <td class="small" title="@p.PathAttempts">
                                                        @if (p.ProducedQty <= 0)
                                                        {
                                                            <span>@L.T("Mes_TanA_NotProduced")</span>
                                                        }
                                                        else
                                                        {
                                                            <b>@p.MaterialPath</b> <span>@p.MaterialMethod</span>
                                                        }
                                                    </td>
                                                    <td class="text-right">@p.Material.ToString("N0")</td>
                                                    <td class="text-right">@p.MaterialTransport.ToString("N0")</td>
                                                    <td class="text-right">@p.Labor.ToString("N0")</td>
                                                    <td class="text-right">@p.TaxBank.ToString("N0")</td>
                                                    <td class="text-right">@p.Admin.ToString("N0")</td>
                                                    <td class="text-right">@p.Other.ToString("N0")</td>
                                                    <td class="text-right font-weight-bold">@p.TotalCostPerUnit.ToString("N0")</td>
                                                    <td class="text-right">@p.FinishedTransport.ToString("N0")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <p class="small text-muted mb-0 mt-1">@L.T("Mes_TanA_AlgorithmHoverHint")</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h4 class="card-title">@L.T("Mes_TanA_FinCategoriesMonth")</h4>
                                <a href="@Url.Action("FinanceCategories", "TannarxAnalytics", new { year = Model.Year, month = Model.Month })" class="btn btn-sm btn-outline-primary">
                                    <i class="bx bx-cog"></i> @L.T("Mes_TanA_ConfigureGroups")
                                </a>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm mb-0">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Category")</th>
                                                <th>@L.T("Mes_TanA_Where")</th>
                                                <th>@L.T("Mes_TanA_Reason")</th>
                                                <th class="text-right">@L.T("Mes_TanA_Transactions")</th>
                                                <th class="text-right">@L.T("Mes_TanA_AmountNet")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!Model.FinanceLines.Any())
                                            {
                                                <tr><td colspan="5" class="text-center text-muted">@L.T("Mes_TanA_NoExpenseTxns")</td></tr>
                                            }
                                            @foreach (var f in Model.FinanceLines)
                                            {
                                                <tr class="@(f.Included ? "" : "text-muted")">
                                                    <td>@f.CategoryName</td>
                                                    <td>@(f.Included ? BucketText(f.Bucket) : L.T("Mes_TanA_Bucket_Excluded"))</td>
                                                    <td class="small">@f.Reason</td>
                                                    <td class="text-right">@f.TransactionCount</td>
                                                    <td class="text-right">@f.Amount.ToString("N0")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.ProducedWithoutTannarx.Any())
                {
                    <div class="row">
                        <div class="col-12">
                            <div class="card border-warning">
                                <div class="card-header"><h4 class="card-title text-warning">@L.T("Mes_TanA_ProducedNoCostRow")</h4></div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm mb-0">
                                            <thead><tr><th>@L.T("Mes_Product")</th><th>@L.T("Name")</th><th class="text-right">@L.T("Mes_Produced")</th></tr></thead>
                                            <tbody>
                                                @foreach (var p in Model.ProducedWithoutTannarx)
                                                {
                                                    <tr><td>@p.ProductPNo</td><td>@p.ProductName</td><td class="text-right">@p.ProducedQty.ToString("N0")</td></tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
