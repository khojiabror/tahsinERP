@model tahsinERP.ViewModels.Tannarx.TannarxAnalyticsReportListViewModel

@{
    ViewBag.Title = "Tannarx Analytics Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "Tannarx"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Tannarx Analytics Report</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Tannarx">Tannarx</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "TannarxAnalytics")">Analytics</a></li>
                                    <li class="breadcrumb-item active">Hisobot</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <!-- Filters -->
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <form id="filterForm" method="get" action="@Url.Action("Report", "TannarxAnalytics")">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <label>Yil</label>
                                            @Html.DropDownList("year", (SelectList)ViewBag.Years, "Barchasi", new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>Oy</label>
                                            @Html.DropDownList("month", (SelectList)ViewBag.Months, "Barchasi", new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>Maxsulot</label>
                                            @Html.DropDownList("productID", (SelectList)ViewBag.Products, "Barchasi", new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-3 d-flex align-items-end">
                                            <button type="submit" class="btn btn-primary btn-block">
                                                <i class="bx bx-search"></i> Filtrlash
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Summary -->
                @if (Model.Summary != null)
                {
                    <div class="row mb-2">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">Umumiy Xulosa</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <p class="mb-0 text-muted">Jami Maxsulotlar</p>
                                                <h3 class="font-weight-bolder">@Model.Summary.TotalProducts</h3>
                                            </div>
                                            <div class="col-md-3">
                                                <p class="mb-0 text-muted">Actual Ma'lumotli</p>
                                                <h3 class="font-weight-bolder">@Model.Summary.ProductsWithActualData</h3>
                                            </div>
                                            <div class="col-md-3">
                                                <p class="mb-0 text-muted">Jami Variance</p>
                                                <h3 class="font-weight-bolder" style="color: @(Model.Summary.TotalVariance >= 0 ? "#dc3545" : "#198754");">
                                                    @Model.Summary.TotalVariancePercent.ToString("N2")%
                                                </h3>
                                            </div>
                                            <div class="col-md-3">
                                                <p class="mb-0 text-muted">O'rtacha Variance</p>
                                                <h3 class="font-weight-bolder" style="color: @(Model.Summary.AverageVariancePercent >= 0 ? "#dc3545" : "#198754");">
                                                    @Model.Summary.AverageVariancePercent.ToString("N2")%
                                                </h3>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Report Table -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-bordered table-hover" id="analyticsReportTable">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th>Maxsulot</th>
                                                    <th>Oy</th>
                                                    <th colspan="2" class="text-center" style="background-color: #fff3cd;">Material</th>
                                                    <th colspan="2" class="text-center" style="background-color: #fff3cd;">Ish Haqi</th>
                                                    <th colspan="2" class="text-center" style="background-color: #ffe5cc;">EXW Narxi</th>
                                                    <th colspan="2" class="text-center" style="background-color: #cce5ff;">CIP Narxi</th>
                                                    <th class="text-center">Amallar</th>
                                                </tr>
                                                <tr>
                                                    <th></th>
                                                    <th></th>
                                                    <th>Planned</th>
                                                    <th>Actual</th>
                                                    <th>Planned</th>
                                                    <th>Actual</th>
                                                    <th>Planned</th>
                                                    <th>Actual</th>
                                                    <th>Planned</th>
                                                    <th>Actual</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.Reports != null && Model.Reports.Any())
                                                {
                                                    foreach (var report in Model.Reports)
                                                    {
                                                        var monthName = GetMonthName(report.Month ?? 0);
                                                        <tr>
                                                            <td>
                                                                <strong>@report.ProductPNo</strong><br />
                                                                <small>@report.ProductName</small>
                                                            </td>
                                                            <td>@(report.Month.HasValue ? $"{monthName}-{report.Year}" : "-")</td>
                                                            <td>@report.PlannedMaterialPrice.ToString("N0")</td>
                                                            <td class="@(report.MaterialPriceVariance >= 0 ? "text-danger" : "text-success")">
                                                                @report.ActualMaterialPrice.ToString("N0")
                                                                @if (report.MaterialPriceVariancePercent != 0)
                                                                {
                                                                    <br /><small>(@report.MaterialPriceVariancePercent.ToString("N1")%)</small>
                                                                }
                                                            </td>
                                                            <td>@report.PlannedLaborCost.ToString("N0")</td>
                                                            <td class="@(report.LaborCostVariance >= 0 ? "text-danger" : "text-success")">
                                                                @report.ActualLaborCost.ToString("N0")
                                                                @if (report.LaborCostVariancePercent != 0)
                                                                {
                                                                    <br /><small>(@report.LaborCostVariancePercent.ToString("N1")%)</small>
                                                                }
                                                            </td>
                                                            <td>@report.PlannedSetPriceEXWWithVAT.ToString("N0")</td>
                                                            <td class="@(report.EXWVariance >= 0 ? "text-danger" : "text-success")">
                                                                @report.ActualEXWWithVAT.ToString("N0")
                                                                @if (report.EXWVariancePercent != 0)
                                                                {
                                                                    <br /><small>(@report.EXWVariancePercent.ToString("N1")%)</small>
                                                                }
                                                            </td>
                                                            <td>@report.PlannedSetPriceCIPWithVAT.ToString("N0")</td>
                                                            <td class="@(report.CIPVariance >= 0 ? "text-danger" : "text-success")">
                                                                @report.ActualCIPWithVAT.ToString("N0")
                                                                @if (report.CIPVariancePercent != 0)
                                                                {
                                                                    <br /><small>(@report.CIPVariancePercent.ToString("N1")%)</small>
                                                                }
                                                            </td>
                                                            <td class="text-center">
                                                                <a href="@Url.Action("ProductDetails", "TannarxAnalytics", new { productID = report.ProductID, year = report.Year, month = report.Month })" 
                                                                   class="btn btn-sm btn-outline-info" title="Batafsil">
                                                                    <i class="bx bx-show"></i>
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="11" class="text-center text-muted">Ma'lumot topilmadi</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof jQuery === 'undefined') {
                console.error('jQuery is not loaded');
                return;
            }

            var table = jQuery('#analyticsReportTable').DataTable({
                "language": {
                    "search": "Qidirish:",
                    "lengthMenu": "_MENU_ ta ko'rsatish",
                    "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    "infoEmpty": "Yozuvlar yo'q",
                    "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                    "paginate": {
                        "first": "Birinchi",
                        "last": "Oxirgi",
                        "next": "Keyingi",
                        "previous": "Oldingi"
                    },
                    "zeroRecords": "Ma'lumot topilmadi"
                },
                "pageLength": 25,
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": -1 }
                ],
                "scrollX": true
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@functions {
    private string GetMonthName(int month)
    {
        var monthNames = new Dictionary<int, string>
        {
            { 1, "Yanvar" }, { 2, "Fevral" }, { 3, "Mart" },
            { 4, "Aprel" }, { 5, "May" }, { 6, "Iyun" },
            { 7, "Iyul" }, { 8, "Avgust" }, { 9, "Sentabr" },
            { 10, "Oktabr" }, { 11, "Noyabr" }, { 12, "Dekabr" }
        };
        return monthNames.ContainsKey(month) ? monthNames[month] : month.ToString();
    }
}
