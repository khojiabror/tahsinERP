@model tahsinERP.ViewModels.Tannarx.TannarxAnalyticsReportListViewModel

@{
    ViewBag.Title = L.T("Mes_TanA_ReportTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "Tannarx"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Tannarx", "Edit");
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Tannarx">@L.T("Mes_Tan_Title")</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "TannarxAnalytics")">@L.T("Mes_TanA_Analysis")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Mes_TanA_Report")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning" role="alert" style="white-space:pre-line">@TempData["Warning"]</div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                <!-- Filters -->
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <form id="filterForm" method="get" action="@Url.Action("Report", "TannarxAnalytics")">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <label>@L.T("Mes_Year")</label>
                                            @Html.DropDownList("year", (SelectList)ViewBag.Years, L.T("All"), new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Mes_Month")</label>
                                            @Html.DropDownList("month", (SelectList)ViewBag.Months, L.T("All"), new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-3">
                                            <label>@L.T("Mes_Product")</label>
                                            @Html.DropDownList("productID", (SelectList)ViewBag.Products, L.T("All"), new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-3 d-flex align-items-end">
                                            <button type="submit" class="btn btn-primary btn-block">
                                                <i class="bx bx-search"></i> @L.T("Filter")
                                            </button>
                                        </div>
                                    </div>
                                </form>
                                @if (changePermit)
                                {
                                    using (Html.BeginForm("UpdateActualCosts", "TannarxAnalytics", FormMethod.Post, new { @class = "mt-2" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        if (Model.Year.HasValue)
                                        {
                                            <input type="hidden" name="year" value="@Model.Year.Value" />
                                        }
                                        if (Model.Month.HasValue)
                                        {
                                            <input type="hidden" name="month" value="@Model.Month.Value" />
                                        }
                                        if (ViewBag.ProductID != null)
                                        {
                                            <input type="hidden" name="productID" value="@ViewBag.ProductID" />
                                        }
                                        <input type="hidden" name="returnTo" value="Report" />
                                        <button type="submit" class="btn btn-success">
                                            <i class="bx bx-refresh"></i> @L.T("Mes_TanA_UpdateActualBtn")
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Summary -->
                @if (Model.Summary != null)
                {
                    <div class="row mb-2">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">@L.T("Mes_TanA_Summary")</h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <p class="mb-0 text-muted">@L.T("Mes_TanA_TotalProducts")</p>
                                                <h3 class="font-weight-bolder">@Model.Summary.TotalProducts</h3>
                                            </div>
                                            <div class="col-md-3">
                                                <p class="mb-0 text-muted">@L.T("Mes_TanA_WithActualData")</p>
                                                <h3 class="font-weight-bolder">@Model.Summary.ProductsWithActualData</h3>
                                            </div>
                                            <div class="col-md-3">
                                                <p class="mb-0 text-muted">@L.T("Mes_TanA_TotalVariance")</p>
                                                <h3 class="font-weight-bolder" style="color: @(Model.Summary.TotalVariance >= 0 ? "#dc3545" : "#198754");">
                                                    @Model.Summary.TotalVariancePercent.ToString("N2")%
                                                </h3>
                                            </div>
                                            <div class="col-md-3">
                                                <p class="mb-0 text-muted">@L.T("Mes_TanA_AvgVariance")</p>
                                                <h3 class="font-weight-bolder" style="color: @(Model.Summary.AverageVariancePercent >= 0 ? "#dc3545" : "#198754");">
                                                    @Model.Summary.AverageVariancePercent.ToString("N2")%
                                                </h3>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Report Table -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-bordered table-hover" id="analyticsReportTable">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th>@L.T("Mes_Product")</th>
                                                    <th>@L.T("Mes_Month")</th>
                                                    <th colspan="2" class="text-center" style="background-color: #fff3cd;">@L.T("Mes_Materials")</th>
                                                    <th colspan="2" class="text-center" style="background-color: #fff3cd;">@L.T("Mes_TanA_Labor")</th>
                                                    <th colspan="2" class="text-center" style="background-color: #ffe5cc;">@L.T("Mes_TanA_ExwPrice")</th>
                                                    <th colspan="2" class="text-center" style="background-color: #cce5ff;">@L.T("Mes_TanA_CipPrice")</th>
                                                    <th class="text-center">@L.T("Actions")</th>
                                                </tr>
                                                <tr>
                                                    <th></th>
                                                    <th></th>
                                                    <th>@L.T("Mes_Plan")</th>
                                                    <th>@L.T("Mes_Actual")</th>
                                                    <th>@L.T("Mes_Plan")</th>
                                                    <th>@L.T("Mes_Actual")</th>
                                                    <th>@L.T("Mes_Plan")</th>
                                                    <th>@L.T("Mes_Actual")</th>
                                                    <th>@L.T("Mes_Plan")</th>
                                                    <th>@L.T("Mes_Actual")</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.Reports != null && Model.Reports.Any())
                                                {
                                                    foreach (var report in Model.Reports)
                                                    {
                                                        var monthName = GetMonthName(report.Month ?? 0);
                                                        <tr>
                                                            <td>
                                                                <strong>@report.ProductPNo</strong><br />
                                                                <small>@report.ProductName</small>
                                                            </td>
                                                            <td>@(report.Month.HasValue ? $"{monthName}-{report.Year}" : "-")</td>
                                                            <td>@report.PlannedMaterialPrice.ToString("N0")</td>
                                                            <td class="@(report.MaterialPriceVariance >= 0 ? "text-danger" : "text-success")">
                                                                @report.ActualMaterialPrice.ToString("N0")
                                                                @if (report.MaterialPriceVariancePercent != 0)
                                                                {
                                                                    <br /><small>(@report.MaterialPriceVariancePercent.ToString("N1")%)</small>
                                                                }
                                                            </td>
                                                            <td>@report.PlannedLaborCost.ToString("N0")</td>
                                                            <td class="@(report.LaborCostVariance >= 0 ? "text-danger" : "text-success")">
                                                                @report.ActualLaborCost.ToString("N0")
                                                                @if (report.LaborCostVariancePercent != 0)
                                                                {
                                                                    <br /><small>(@report.LaborCostVariancePercent.ToString("N1")%)</small>
                                                                }
                                                            </td>
                                                            <td>@report.PlannedSetPriceEXWWithVAT.ToString("N0")</td>
                                                            <td class="@(report.ActualEXWWithVAT < report.PlannedSetPriceEXWWithVAT ? "text-success" : (report.ActualEXWWithVAT > report.PlannedSetPriceEXWWithVAT ? "text-danger" : ""))">
                                                                @report.ActualEXWWithVAT.ToString("N0")
                                                                @if (report.EXWVariancePercent != 0)
                                                                {
                                                                    <br /><small>(@report.EXWVariancePercent.ToString("N1")%)</small>
                                                                }
                                                            </td>
                                                            <td>@report.PlannedSetPriceCIPWithVAT.ToString("N0")</td>
                                                            <td class="@(report.ActualCIPWithVAT < report.PlannedSetPriceCIPWithVAT ? "text-success" : (report.ActualCIPWithVAT > report.PlannedSetPriceCIPWithVAT ? "text-danger" : ""))">
                                                                @report.ActualCIPWithVAT.ToString("N0")
                                                                @if (report.CIPVariancePercent != 0)
                                                                {
                                                                    <br /><small>(@report.CIPVariancePercent.ToString("N1")%)</small>
                                                                }
                                                            </td>
                                                            <td class="text-center">
                                                                <a href="@Url.Action("ProductDetails", "TannarxAnalytics", new { productID = report.ProductID, year = report.Year, month = report.Month })" 
                                                                   class="btn btn-sm btn-outline-info" title="@L.T("Details")">
                                                                    <i class="bx bx-show"></i>
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof jQuery === 'undefined') {
                console.error('jQuery is not loaded');
                return;
            }

            var table = jQuery('#analyticsReportTable').DataTable({
                "pageLength": 25,
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": -1 }
                ],
                "scrollX": true,
                "dom": 'Bfrtip',
                "buttons": erpDataTable.buttons({ fileName: 'Tannarx_Analytics_Report', title: '@L.Js("Mes_TanA_ReportTitle")', columns: ':not(:last-child)', pdf: false })
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@functions {
    private string GetMonthName(int month)
    {
        return month >= 1 && month <= 12 ? L.T("Month_" + month) : month.ToString();
    }
}
