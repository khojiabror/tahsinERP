@model tahsinERP.Models.CAR_PLANS
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="progressOverlay">
    <div class="progress-container">
        <div class="progress-bar"></div>
        <span class="progress-text">Yuklanmoqda...</span>
    </div>
</div>

<style>
    #progressOverlay {
        position: fixed;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5); /* Semi-transparent background */
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        visibility: hidden;
    }

    .progress-container {
        width: 50%;
        background: rgba(255, 255, 255, 0.9);
        padding: 20px;
        border-radius: 10px;
        text-align: center;
    }

    .progress-bar {
        width: 0%;
        height: 20px;
        background: linear-gradient(45deg, #4CAF50, #2196F3);
        transition: width 0.4s ease-in-out;
        border-radius: 5px;
    }

    .progress-text {
        display: block;
        margin-top: 10px;
        font-size: 16px;
        color: #333;
    }
</style>

@Html.AntiForgeryToken()
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/ProductPlan/Index">Rejalashtirish</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    Avtomobilga reja berish
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <section class="basic-select2">
                <div class="row">
                    <div class="col-xl-12 col-md-12 col-12">
                        <div class="card">

                            @using (Html.BeginForm("Create", "CarPlan", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                <div class="col-lg-12 col-md-6 mt-25">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <h6 class="invoice-to">Avtomobileni tanlang</h6>
                                    <fieldset class="invoice-address form-group">
                                        @Html.DropDownList("Model", (SelectList)ViewBag.CarModelList, "--tanlang--", new { @class = "form-control select2", @id = "carModel" })
                                        @Html.ValidationMessageFor(model => model.CarID, "", new { @class = "text-danger" })
                                    </fieldset>
                                    <h6 class="invoice-to">Avtomobileni variantini tanlang</h6>
                                    <fieldset class="invoice-address form-group">
                                        @Html.DropDownList("CarID", (SelectList)ViewBag.CarOptionList, "--tanlang--", new { @class = "form-control select2", @id = "optionCode" })
                                        @Html.ValidationMessageFor(model => model.CarID, "", new { @class = "text-danger" })
                                    </fieldset>
                                    <h6 class="invoice-to">Rejadagi mahsulot miqdori</h6>
                                    <fieldset class="form-group">
                                        @Html.EditorFor(model => model.Amount, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                                    </fieldset>
                                    <h6 class="invoice-to">Boshlanish sana</h6>
                                    <fieldset class="invoice-address form-group">
                                        @Html.TextBoxFor(model => model.StartDate, new { @class = "form-control", @id = "startDateInput", @name = "Date", @placeholder = "Boshlanish sanasi", @required = "required" })
                                        @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                                    </fieldset>
                                    <h6 class="invoice-to">Tugash sana </h6>
                                    <fieldset class="invoice-address form-group">
                                        @Html.TextBoxFor(model => model.DueDate, new { @class = "form-control", @id = "dueDateInput", @name = "Date", @placeholder = "Tugash sanasi", @required = "required" })
                                        @Html.ValidationMessageFor(model => model.DueDate, "", new { @class = "text-danger" })
                                    </fieldset>

                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item border-0 pb-0">
                                            <button class="btn btn-light-primary btn-block subtotal-preview-btn" name="create" type="submit" value="Create">
                                                <i class='bx bx-save'></i>
                                                Xisoblash
                                            </button>
                                        </li>
                                    </ul>
                                    <br />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>
            <section>
                @if (ViewBag.DataTable != null)
                {
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">SPL orqali maxsulotlarga chochilgan reja:</h4>
                        </div>
                        @using (Html.BeginForm("Save", "CarPlan", FormMethod.Post))
                        {
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- datatable start -->
                                    <div class="table-responsive">


                                        <table class="table zero-configuration" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Maxsulot raqami</th>
                                                    <th>Reja qiymati</th>
                                                    <th>Boshlanish sanasi</th>
                                                    <th>Tugash sanasi</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in ViewBag.DataTable)
                                                {
                                                    <tr>
                                                        <td>@row.PNo</td>
                                                        <td>@row.Requirement</td>
                                                        <td>@row.StartDate.ToString("dd.MM.yyyy")</td>
                                                        <td>@row.DueDate.ToString("dd.MM.yyyy")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>

                                    </div>
                                    @if (ViewBag.IsFileUploaded != null)
                                    {
                                        <br />
                                        <h6>
                                            Agar ma'lumotlar to'g'riliga ishonch xosil qilgan bo'lsangiz quyidagi tugma orqali ma'lumotlar bazasiga saqlashingiz mumkin.
                                        </h6>
                                        <input type="hidden" name="dataTableModel" value='@Html.Raw(ViewBag.DataTableModel)' />
                                        <hr />
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item border-0 pb-0">
                                                <button id="saveButton" class="btn btn-outline-success round mr-1 mb-1" type="submit" onclick="return confirmSave()">
                                                    <i class='bx bx-save'></i>
                                                    Saqlash
                                                </button>
                                            </li>
                                        </ul>
                                        @*<input type="submit" value="Maxsulotlarga reja berish" class="btn btn-outline-success round mr-1 mb-1" onclick="return confirmSave()" />*@
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        flatpickr("#startDateInput", {
            dateFormat: "d.m.Y", // You can customize the date format
            maxDate: "today",// Optional: restricts the selection to today's date or later
            altInput: true, // Optional: creates an alternate input (more user-friendly)
            altFormat: "F j, Y", // Format displayed in alt input
            weekNumbers: true,
            showTodayButton: true,
            locale: "en",
            onChange: function (selectedDates, dateStr, instance) {
                // Format the date to Y-m-d when it's selected
                const formattedDate = flatpickr.formatDate(selectedDates[0], "Y-m-d");
                document.getElementById("startDateInput").value = formattedDate;  // Update the input field with the formatted date
            }
        });
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        flatpickr("#dueDateInput", {
            dateFormat: "d.m.Y", // You can customize the date format
            altInput: true, // Optional: creates an alternate input (more user-friendly)
            altFormat: "F j, Y", // Format displayed in alt input
            weekNumbers: true,
            showTodayButton: true,
            locale: "en",
            onChange: function (selectedDates, dateStr, instance) {
                // Format the date to Y-m-d when it's selected
                const formattedDate = flatpickr.formatDate(selectedDates[0], "Y-m-d");
                document.getElementById("dueDateInput").value = formattedDate;  // Update the input field with the formatted date
            }
        });
    });
</script>
<script type="text/javascript">
    $(document).ready(function () {
        function getOptionCodes() {
            var carModel = document.getElementById("carModel").value;

            $.ajax({
                url: '@Url.Action("GetOptionCode", "CarPlan")',
                type: 'GET',
                data: { modelName: carModel },
                success: function (data) {
                    var optionCodes = $("#optionCode");
                    optionCodes.empty();
                    $.each(data.data, function (index, item) {
                        optionCodes.append(new Option(item.OptionCode, item.ID));
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching OptionCodes: ", error);
                }
            });
        }

        $('#carModel').on('change', getOptionCodes);
    });
</script>
<script>
    $(document).ready(function () {
        function showProgressBar() {
            document.getElementById("progressOverlay").style.visibility = "visible";
            let progress = 0;
            let progressBar = document.querySelector(".progress-bar");

            function updateProgress() {
                if (progress < 100) {
                    progress += Math.random() * 10; // Simulating progress increment
                    if (progress > 100) progress = 100;
                    progressBar.style.width = progress + "%";
                    setTimeout(updateProgress, 500);
                }
            }

            updateProgress();
        }

        function hideProgressBar() {
            document.getElementById("progressOverlay").style.visibility = "hidden";
            document.querySelector(".progress-bar").style.width = "0%"; // Reset progress bar
        }

        // Attach progress bar to form submission
        $("form").on("submit", function () {
            showProgressBar();
        });

        // AJAX-based submission for the "Saqlash" button in the table form
        $("#saveButton").click(function (event) {
            event.preventDefault(); // Prevent default form submission
            showProgressBar(); // Show progress bar

            var form = $(this).closest("form");
            var formData = new FormData(form[0]);

            $.ajax({
                url: form.attr("action"),
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() }, // CSRF protection
                success: function (data) {
                    hideProgressBar();
                    if (data.success) {
                        alert("Plan added successfully!");
                        location.reload();
                    } else {
                        alert("Error: " + data.message);
                    }
                },
                error: function (xhr, status, error) {
                    hideProgressBar();
                    alert("Something went wrong: " + error);
                }
            });
        });
    });
</script>