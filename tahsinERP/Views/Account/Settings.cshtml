@model tahsinERP.ViewModels.UserViewModel
@{
    ViewBag.Title = L.T("Core_AccountSettings");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    @Html.Link(L.T("Core_Pages"), "Home")
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Core_AccountSettings")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @using (Html.BeginForm("SaveSettings", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <div class="content-body">
                <section id="page-account-settings">
                    <div class="row">
                        <div class="col-12">
                            <div class="row">
                                <!-- right content section -->
                                <div class="col-md-9">
                                    <div class="card">
                                        <div class="card-content">
                                            <div class="card-body">

                                                <div class="media">
                                                    <img src="@ViewBag.Base64String" class="rounded mr-75" alt="@L.T("Core_ProfileImage")" height="64" width="64" />
                                                    <div class="media-body mt-25">
                                                        <div class="col-12 px-0 d-flex flex-sm-row flex-column justify-content-start">
                                                            <span>@L.T("Core_UploadNewPhoto")</span>
                                                            <input type="file" class="btn btn-sm btn-light-primary ml-50 mb-50 mb-sm-0" id="userPhotoUpload" name="userPhotoUpload" />
                                                            @Html.ValidationMessageFor(model => model.File, "", new { @class = "text-danger" })

                                                        </div>
                                                    </div>
                                                </div>
                                                <hr>

                                                @Html.AntiForgeryToken()
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                @if (TempData["MustChangePassword"] != null)
                                                {
                                                    <div class="alert alert-warning">@TempData["MustChangePassword"]</div>
                                                }
                                                <div class="row">
                                                    <div class="col-12">
                                                        <div class="form-group">
                                                            <div class="controls">
                                                                <label>@L.T("Core_UserName")</label>
                                                                @Html.TextBoxFor(model => model.UName, new { @class = "form-control", @type = "text", @placeholder = L.T("Core_UserName"), @readonly = "readonly" })
                                                                @Html.ValidationMessageFor(model => model.UName, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-12">
                                                        <div class="form-group">
                                                            <div class="controls">
                                                                <label>@L.T("Core_UserFullName")</label>
                                                                @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", @type = "text", @placeholder = L.T("Core_FullNameShort") })
                                                                @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-12">
                                                        <div class="form-group">
                                                            <div class="controls">
                                                                <label>E-mail</label>
                                                                @Html.TextBoxFor(model => model.Email, new { @class = "form-control", @type = "text", @placeholder = "Email" })
                                                                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-12">
                                                        <div class="form-group">
                                                            <div class="controls">
                                                                <label>@L.T("Core_CurrentPassword")</label>
                                                                @Html.PasswordFor(model => model.CurrentPassword, new { @class = "form-control", @placeholder = L.T("Core_PasswordPlaceholder"), @required = "required", autocomplete = "current-password" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-12">
                                                        <div class="form-group">
                                                            <div class="controls">
                                                                <label>@L.T("Core_NewPassword")</label>
                                                                @Html.PasswordFor(model => model.Password, new { @class = "form-control", @placeholder = L.T("Core_LeaveEmptyToKeep"), autocomplete = "new-password" })
                                                                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                                                                <div class="alert alert-warning mt-50 mb-0 small" role="note"><strong>@L.T("Core_PwdWarn_Title")</strong> @L.T("Core_PwdWarn_Set")</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-12">
                                                        <div class="form-group">
                                                            <div class="controls">
                                                                <label>@L.T("Core_ConfirmNewPassword")</label>
                                                                @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form-control", @placeholder = L.T("Core_PasswordPlaceholder"), autocomplete = "new-password" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-12 d-flex flex-sm-row flex-column justify-content-end">
                                                        <button type="submit" class="btn btn-primary glow mr-sm-1 mb-1">
                                                            @L.T("Save")
                                                        </button>
                                                        <button type="reset" class="btn btn-light mb-1" onclick="location.href='/Home'">@L.T("Cancel")</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        }
        </div>
</div>
