@model tahsinERP.ViewModels.UserViewModel
@{
    Layout = null;
    // Firma nomi (Kompaniya → Brending); standart "tahsinERP" bo'lsa ko'rsatilmaydi.
    var brand = tahsinERP.Services.Common.BrandingService.Current();
    string company = brand.CompanyName == "tahsinERP" ? null : brand.CompanyName;
    // Firma logosi (Sozlamalar → Kompaniya → Logo) — yuklangan bo'lsa kirish sahifasida ham ko'rinadi.
    string firmLogo = brand.HasLogo ? Url.Action("Logo", "Branding", new { area = "", v = brand.LogoVersion }) : null;
}
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Kirish · tahsinERP</title>
    <link rel="icon" href="~/app-assets/images/ico/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="~/app-assets/images/ico/apple-touch-icon.png">
    <meta name="theme-color" content="#060c1d">
    <link rel="stylesheet" href="@tahsinERP.Helpers.AssetVersion.Url("~/assets/fonts/fonts.css")">
    <link rel="stylesheet" href="@tahsinERP.Helpers.AssetVersion.Url("~/assets/css/login.css")">
</head>
<body class="lg">
    <svg xmlns="http://www.w3.org/2000/svg" class="lg-sprite" aria-hidden="true">
        <symbol id="i-user" viewBox="0 0 24 24"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></symbol>
        <symbol id="i-lock" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></symbol>
        <symbol id="i-tick" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></symbol>
        <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0" /><circle cx="12" cy="12" r="3" /></symbol>
    </svg>
    <div class="lg-bg" aria-hidden="true"><span class="orb o1"></span><span class="orb o2"></span><span class="orb o3"></span><span class="lg-grid"></span></div>

    <header class="lg-top">
        <a class="lg-brand" href="https://tahsinerp.uz" target="_blank" rel="noopener">
            <img src="~/app-assets/images/logo/tahsinerp-logo.png" alt="" width="36" height="36">
            <span>tahsin<b>ERP</b></span>
        </a>
        @if (company != null || firmLogo != null)
        {
            <span class="lg-chip">@if (firmLogo != null) { <img src="@firmLogo" alt=""> }@(company ?? "")</span>
        }
    </header>

    <div class="lg-wrap">
        <section class="lg-intro">
            <div class="lg-logo" aria-hidden="true"><span class="ring r1"></span><span class="ring r2"></span><img src="~/app-assets/images/logo/tahsinerp-logo.png" alt="" width="132" height="132"></div>
            <span class="lg-eyebrow">Korxona boshqaruv tizimi</span>
            <h2>Korxonangizni <span class="grad">bitta tizimda</span> boshqaring</h2>
            <p>Xarid, ombor, ishlab chiqarish, savdo, distributsiya, moliya va kadrlar — real vaqtda, bir joyda.</p>
            <ul class="lg-feats">
                <li><svg class="i"><use href="#i-tick" /></svg>Har bir firma uchun alohida, himoyalangan baza</li>
                <li><svg class="i"><use href="#i-tick" /></svg>Rollar bo'yicha huquqlar va amallar jurnali</li>
                <li><svg class="i"><use href="#i-tick" /></svg>Shifrlangan ulanish (HTTPS)</li>
            </ul>
        </section>

        <main class="lg-card">
            @if (firmLogo != null)
            {
                <div class="lg-firm"><img src="@firmLogo" alt="@(company ?? "")"><div><b>@(company ?? "Ish maydoni")</b><small>Xavfsiz kirish</small></div></div>
            }
            else
            {
                <span class="lg-pill">Xavfsiz kirish</span>
            }
            <h1>Tizimga kirish</h1>
            <p class="lg-sub">@(company != null && firmLogo == null ? company + " ish maydoni. " : "")Foydalanuvchi nomi va kalit so'zini kiriting.</p>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "lg-err" })

                <div class="lg-fld">
                    <label for="username">Foydalanuvchi nomi</label>
                    <div class="lg-ic">
                        <svg class="i"><use href="#i-user" /></svg>
                        @Html.TextBoxFor(u => u.UName, new { @id = "username", @placeholder = "login", @autocomplete = "username", @autofocus = "autofocus", @autocapitalize = "none", @spellcheck = "false" })
                    </div>
                    @Html.ValidationMessageFor(m => m.UName, "", new { @class = "lg-fe" })
                </div>

                <div class="lg-fld">
                    <label for="password">Kalit so'zi</label>
                    <div class="lg-ic">
                        <svg class="i"><use href="#i-lock" /></svg>
                        @Html.PasswordFor(u => u.Password, new { @id = "password", @placeholder = "••••••••", @autocomplete = "current-password" })
                        <button type="button" class="lg-eye" data-toggle-pw aria-label="Kalit so'zini ko'rsatish"><svg class="i"><use href="#i-eye" /></svg></button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "lg-fe" })
                </div>

                <label class="lg-check">
                    @Html.CheckBoxFor(u => u.KeepMeSigned, new { @id = "keepMeSigned" })
                    <span>Meni tizimda saqlab qolish (1 soat)</span>
                </label>

                <button type="submit" class="lg-btn">Kirish <svg class="i"><use href="#i-arrow" /></svg></button>
            }
            <div class="lg-meta"><span><svg class="i"><use href="#i-lock" /></svg>Seans shifrlangan</span><span>Parolni unutdingizmi? Administratoringizga murojaat qiling.</span></div>
        </main>
    </div>

    <footer class="lg-foot">
        <span>© @DateTime.Now.Year tahsinERP · SCHAIN</span>
        <a href="https://tahsinerp.uz" target="_blank" rel="noopener">tahsinerp.uz</a>
    </footer>
    <script>
        (function () {
            var b = document.querySelector('[data-toggle-pw]'), p = document.getElementById('password');
            if (b && p) b.addEventListener('click', function () { p.type = p.type === 'password' ? 'text' : 'password'; p.focus(); });
        })();
    </script>
</body>
</html>
