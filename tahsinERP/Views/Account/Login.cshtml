@model tahsinERP.ViewModels.UserViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
    <meta name="author" content="Khojiabror Makhmudov">
    <title>Login Page - tahsinERP</title>
    <script src="@tahsinERP.Helpers.AssetVersion.Url("~/assets/js/theme.js")"></script>
    <link rel="apple-touch-icon" href="~/app-assets/images/ico/apple-touch-icon.png">
    <link rel="shortcut icon" type="image/x-icon" href="~/app-assets/images/ico/favicon.ico">
    <link href="https://fonts.googleapis.com/css?family=Rubik:300,400,500,600%7CIBM+Plex+Sans:300,400,500,600,700" rel="stylesheet">

    <!-- BEGIN: Vendor CSS-->
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/vendors.min.css">
    <!-- END: Vendor CSS-->
    <!-- BEGIN: Theme CSS-->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap-extended.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/colors.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/components.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/themes/dark-layout.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/themes/semi-dark-layout.css">
    <!-- END: Theme CSS-->
    <!-- BEGIN: Page CSS-->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/core/menu/menu-types/vertical-menu.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/pages/authentication.css">
    <!-- END: Page CSS-->
    <!-- BEGIN: Custom CSS-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css">
    <!-- END: Custom CSS-->
    <style id="brand-vars">@Html.Raw(tahsinERP.Services.Common.BrandingService.RenderCssVariables(tahsinERP.Services.Common.BrandingService.Current().Tokens))</style>
    <link rel="stylesheet" type="text/css" href="@tahsinERP.Helpers.AssetVersion.Url("~/assets/css/theme-accent.css")" />
    <style>
        /* Custom Login Page Styles */
        body.blank-page {
            background-color: #F5F5F5;
            font-family: 'Rubik', 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        #auth-login {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 0;
        }

        .bg-authentication {
            background-color: #FFFFFF;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        .bg-authentication .card {
            border: none;
            box-shadow: none;
        }

        /* Left Section - Login Form */
        .login-form-section {
            padding: 3rem 2.5rem;
            background-color: #FFFFFF;
        }

        .login-form-section .card-header {
            border: none;
            padding: 0 0 2rem 0;
            margin-bottom: 0;
        }

        .login-form-section h4 {
            color: #333333;
            font-size: 1.75rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            letter-spacing: -0.02em;
        }

        .login-form-section h6 {
            color: #666666;
            font-size: 1rem;
            font-weight: 400;
            margin-bottom: 0;
        }

        .login-form-section .form-group {
            margin-bottom: 1.5rem;
        }

        .login-form-section label {
            color: #333333;
            font-weight: 600;
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
            display: block;
        }

        .login-form-section .form-control {
            border: 1px solid #E0E0E0;
            border-radius: 6px;
            padding: 0.75rem 1rem;
            font-size: 0.9375rem;
            color: #333333;
            transition: all 0.3s ease;
            background-color: #FFFFFF;
        }

        .login-form-section .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-ring);
            outline: none;
        }

        .login-form-section .form-control::placeholder {
            color: #999999;
        }

        .login-form-section .checkbox {
            margin-top: 1rem;
            margin-bottom: 0;
            display: flex;
            align-items: center;
        }

        .login-form-section .checkbox label {
            color: #666666;
            font-weight: 400;
            font-size: 0.875rem;
            margin-left: 0.5rem;
            margin-bottom: 0;
            cursor: pointer;
            display: flex;
            align-items: center;
        }

        .login-form-section .checkbox input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--accent);
        }

        .login-form-section hr {
            margin: 1.5rem 0;
            border: none;
            border-top: 1px solid #E0E0E0;
        }

        .login-form-section .btn-primary {
            background-color: var(--accent);
            border: none;
            border-radius: 6px;
            padding: 0.875rem 1.5rem;
            font-size: 1rem;
            font-weight: 500;
            color: #FFFFFF;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px var(--accent-ring);
        }

        .login-form-section .btn-primary:hover {
            background-color: var(--accent-hover);
            box-shadow: 0 4px 12px var(--accent-ring);
            transform: translateY(-1px);
        }

        .login-form-section .btn-primary:active {
            transform: translateY(0);
        }

        .login-form-section #icon-arrow {
            position: absolute;
            right: 1.5rem;
            top: 50%;
            transform: translateY(-50%);
            font-size: 1.25rem;
        }

        .text-danger {
            color: #E74C3C;
            font-size: 0.8125rem;
            margin-top: 0.25rem;
        }

        /* Right Section - Branding */
        .branding-section {
            background: #E8E8E8;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            min-height: 100%;
            overflow: hidden;
        }

        .branding-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800"><defs><pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(0,0,0,0.05)" stroke-width="1"/></pattern></defs><rect width="100%" height="100%" fill="url(%23grid)"/></svg>');
            opacity: 0.3;
        }

        .branding-content {
            position: relative;
            z-index: 1;
            text-align: center;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .branding-content img {
            width: 100%;
            max-width: 100%;
            height: auto;
            max-height: calc(100% - 3rem);
            object-fit: contain;
            object-position: center;
            filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.3));
            margin-bottom: 1rem;
        }

        .branding-content .brand-text {
            color: #FFFFFF;
            font-size: 2rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            letter-spacing: -0.02em;
        }

        .branding-content .brand-subtext {
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.875rem;
            margin-top: auto;
            padding-top: 1rem;
        }

        .branding-content .website-link {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.8125rem;
            margin-top: 1.5rem;
            text-decoration: none;
        }

        .branding-content .website-link:hover {
            color: #FFFFFF;
        }

        /* Responsive Design */
        @@media (max-width: 991.98px) {
            .branding-section {
                display: none;
            }

            .login-form-section {
                padding: 2.5rem 2rem;
            }

            .bg-authentication {
                border-radius: 8px;
            }
        }

        @@media (max-width: 575.98px) {
            .login-form-section {
                padding: 2rem 1.5rem;
            }

            .login-form-section h4 {
                font-size: 1.5rem;
            }
        }

        /* Tungi rejim (assets/js/theme.js -> html[data-theme]) */
        html[data-theme="dark"] body.blank-page { background-color: #1a233a; }
        html[data-theme="dark"] .bg-authentication,
        html[data-theme="dark"] .bg-authentication .card,
        html[data-theme="dark"] .login-form-section { background-color: #272e48 !important; box-shadow: 0 4px 24px rgba(0, 0, 0, .45); }
        html[data-theme="dark"] .login-form-section h4,
        html[data-theme="dark"] .login-form-section label { color: #dce4f2 !important; }
        html[data-theme="dark"] .login-form-section h6,
        html[data-theme="dark"] .login-form-section small { color: #a9b6cf !important; }
        html[data-theme="dark"] .login-form-section .form-control { background-color: #1a233a !important; border-color: #3a4466 !important; color: #dce4f2 !important; }
        html[data-theme="dark"] .login-form-section .form-control::placeholder { color: #8592ab !important; }
        html[data-theme="dark"] .login-form-section hr { border-top-color: #3a4466; }
    </style>
</head>
<body class="vertical-layout vertical-menu-modern boxicon-layout no-card-shadow 1-column navbar-sticky footer-static blank-page blank-page">
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
            </div>
            <div class="content-body">
                <!-- login page start -->
                <section id="auth-login" class="row flexbox-container">
                    <div class="col-xl-8 col-11">
                        <div class="card bg-authentication mb-0">
                            <div class="row m-0">
                                <!-- left section-login -->
                                <div class="col-md-6 col-12 px-0">
                                    <div class="card disable-rounded-right mb-0 h-100 login-form-section">
                                        <div class="card-header">
                                            <div>
                                                <h4>tahsinERP tizimi</h4>
                                                <h6>Xush kelibsiz!</h6>
                                            </div>
                                        </div>
                                        <div class="card-content">
                                            <div class="card-body">
                                                @using (Html.BeginForm())
                                                {
                                                    @Html.AntiForgeryToken()
                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                                    <div class="form-group">
                                                        <label class="text-bold-600" for="username">FOYDALANUVCHI NOMI</label>
                                                        @Html.TextBoxFor(u => u.UName, new { @class = "form-control", @id = "username", @placeholder = "Foydalanuvchi nomi", @autocomplete = "username" })
                                                        @Html.ValidationMessageFor(m => m.UName, "", new { @class = "text-danger" })
                                                    </div>

                                                    <div class="form-group" style="margin-bottom: 1.5rem;">
                                                        <label class="text-bold-600" for="password">KALIT SO'ZI</label>
                                                        @Html.PasswordFor(u => u.Password, new { @class = "form-control", @id = "password", @placeholder = "Kalit so'zi", @autocomplete = "current-password" })
                                                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                                                    </div>

                                                    <div class="form-group">
                                                        <div class="checkbox checkbox-sm">
                                                            @Html.CheckBoxFor(u => u.KeepMeSigned, new { @id = "keepMeSigned" })
                                                            <label for="keepMeSigned">
                                                                <small style="margin-top: 0,5rem; margin-left: 1rem;">Meni tizimda saqlab qolish (1 soat)</small>
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <hr />
                                                    <button type="submit" class="btn btn-primary glow w-100 position-relative">
                                                        Kirish <i id="icon-arrow" class="bx bx-right-arrow-alt"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- right section image -->
                                <div class="col-md-6 d-md-block d-none px-0 branding-section">
                                    <div class="branding-content">
                                        <img class="img-fluid" src="~/app-assets/images/logo/tahsin_logo_.png" alt="tahsinERP branding">
                                        @*<div class="brand-subtext">www.schain.uz</div>*@
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- login page ends -->
            </div>
        </div>
    </div>
    <!-- END: Content-->
    <!-- BEGIN: Vendor JS-->
    <script src="~/app-assets/vendors/js/vendors.min.js"></script>
    <script src="~/app-assets/fonts/LivIconsEvo/js/LivIconsEvo.tools.js"></script>
    <script src="~/app-assets/fonts/LivIconsEvo/js/LivIconsEvo.defaults.js"></script>
    <script src="~/app-assets/fonts/LivIconsEvo/js/LivIconsEvo.min.js"></script>
    <!-- BEGIN Vendor JS-->
    <!-- BEGIN: Page Vendor JS-->
    <!-- END: Page Vendor JS-->
    <!-- BEGIN: Theme JS-->
    <script src="~/app-assets/js/core/app-menu.js"></script>
    <script src="~/app-assets/js/core/app.js"></script>
    <script src="~/app-assets/js/scripts/components.js"></script>
    <script src="~/app-assets/js/scripts/footer.js"></script>
    <!-- END: Theme JS-->
</body>
</html>
