@model tahsinERP.ViewModels.UserViewModel
@{
    Layout = null;
    // Firma nomi (Kompaniya → Brending); standart "tahsinERP" bo'lsa ko'rsatilmaydi.
    var brand = tahsinERP.Services.Common.BrandingService.Current();
    string company = brand.CompanyName == "tahsinERP" ? null : brand.CompanyName;
    // Firma logosi (Sozlamalar → Kompaniya → Logo) — yuklangan bo'lsa kirish sahifasida ham ko'rinadi.
    string firmLogo = brand.HasLogo ? Url.Action("Logo", "Branding", new { area = "", v = brand.LogoVersion }) : null;
}
<!DOCTYPE html>
<html lang="@tahsinERP.Localization.Languages.HtmlLang(L.Lang)">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>@L.T("Login") · tahsinERP</title>
    <link rel="icon" href="~/app-assets/images/ico/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="~/app-assets/images/ico/apple-touch-icon.png">
    <meta name="theme-color" content="#060c1d">
    <link rel="stylesheet" href="@tahsinERP.Helpers.AssetVersion.Url("~/assets/fonts/fonts.css")">
    <link rel="stylesheet" href="@tahsinERP.Helpers.AssetVersion.Url("~/assets/css/login.css")">
    <style>
        .lg-lang { list-style: none; margin: 0 0 0 auto; padding: 0; position: relative; }
        .lg-lang .nav-link { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; font-size: 13px; font-weight: 600; color: #93c5fd; background: rgba(96, 165, 250, .1); border: 1px solid rgba(96, 165, 250, .25); text-decoration: none; }
        .lg-lang .lg-lang-menu { display: none; position: absolute; right: 0; top: calc(100% + 6px); min-width: 150px; padding: 6px; border-radius: 12px; background: #0b1530; border: 1px solid rgba(96, 165, 250, .25); z-index: 10; }
        .lg-lang .lg-lang-menu.show { display: block; }
        .lg-lang .dropdown-item { display: block; padding: 7px 10px; border-radius: 8px; color: #dbeafe; font-size: 14px; text-decoration: none; }
        .lg-lang .dropdown-item:hover, .lg-lang .dropdown-item.active { background: rgba(96, 165, 250, .15); color: #fff; }
    </style>
</head>
<body class="lg">
    <svg xmlns="http://www.w3.org/2000/svg" class="lg-sprite" aria-hidden="true">
        <symbol id="i-user" viewBox="0 0 24 24"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></symbol>
        <symbol id="i-lock" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></symbol>
        <symbol id="i-tick" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></symbol>
        <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0" /><circle cx="12" cy="12" r="3" /></symbol>
    </svg>
    <div class="lg-bg" aria-hidden="true"><span class="orb o1"></span><span class="orb o2"></span><span class="orb o3"></span><span class="lg-grid"></span></div>

    <header class="lg-top">
        <a class="lg-brand" href="https://tahsinerp.uz" target="_blank" rel="noopener">
            <img src="~/app-assets/images/logo/tahsinerp-logo.png" alt="" width="36" height="36">
            <span>tahsin<b>ERP</b></span>
        </a>
        @if (company != null || firmLogo != null)
        {
            <span class="lg-chip">@if (firmLogo != null) { <img src="@firmLogo" alt=""> }@(company ?? "")</span>
        }
        <ul class="lg-lang">
            @Html.Partial("_LanguageSwitch", new ViewDataDictionary { { "MenuClass", "lg-lang-menu" } })
        </ul>
    </header>

    <div class="lg-wrap">
        <section class="lg-intro">
            <div class="lg-logo" aria-hidden="true"><span class="ring r1"></span><span class="ring r2"></span><img src="~/app-assets/images/logo/tahsinerp-logo.png" alt="" width="132" height="132"></div>
            <span class="lg-eyebrow">@L.T("Core_Login2_Eyebrow")</span>
            <h2>@Html.Raw(L.T("Core_Login2_Headline", "<span class=\"grad\">" + Html.Encode(L.T("Core_Login2_HeadlineAccent")) + "</span>"))</h2>
            <p>@L.T("Core_Login2_Intro")</p>
            <ul class="lg-feats">
                <li><svg class="i"><use href="#i-tick" /></svg>@L.T("Core_Login2_FeatDb")</li>
                <li><svg class="i"><use href="#i-tick" /></svg>@L.T("Core_Login2_FeatRoles")</li>
                <li><svg class="i"><use href="#i-tick" /></svg>@L.T("Core_Login2_FeatHttps")</li>
            </ul>
        </section>

        <main class="lg-card">
            @if (firmLogo != null)
            {
                <div class="lg-firm"><img src="@firmLogo" alt="@(company ?? "")"><div><b>@(company ?? L.T("Core_Login2_Workspace"))</b><small>@L.T("Core_Login2_SecureLogin")</small></div></div>
            }
            else
            {
                <span class="lg-pill">@L.T("Core_Login2_SecureLogin")</span>
            }
            <h1>@L.T("Core_Login2_Title")</h1>
            <p class="lg-sub">@(company != null && firmLogo == null ? L.T("Core_Login2_CompanyWorkspace", company) + " " : "")@L.T("Core_Login2_EnterCredentials")</p>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "lg-err" })

                <div class="lg-fld">
                    <label for="username">@L.T("Core_UserName")</label>
                    <div class="lg-ic">
                        <svg class="i"><use href="#i-user" /></svg>
                        @Html.TextBoxFor(u => u.UName, new { @id = "username", @placeholder = L.T("Core_Login2_LoginPlaceholder"), @autocomplete = "username", @autofocus = "autofocus", @autocapitalize = "none", @spellcheck = "false" })
                    </div>
                    @Html.ValidationMessageFor(m => m.UName, "", new { @class = "lg-fe" })
                </div>

                <div class="lg-fld">
                    <label for="password">@L.T("Core_PasswordPlaceholder")</label>
                    <div class="lg-ic">
                        <svg class="i"><use href="#i-lock" /></svg>
                        @Html.PasswordFor(u => u.Password, new { @id = "password", @placeholder = "••••••••", @autocomplete = "current-password" })
                        <button type="button" class="lg-eye" data-toggle-pw aria-label="@L.T("Core_Login2_ShowPassword")"><svg class="i"><use href="#i-eye" /></svg></button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "lg-fe" })
                </div>

                <label class="lg-check">
                    @Html.CheckBoxFor(u => u.KeepMeSigned, new { @id = "keepMeSigned" })
                    <span>@L.T("Core_KeepMeSigned")</span>
                </label>

                <button type="submit" class="lg-btn">@L.T("Login") <svg class="i"><use href="#i-arrow" /></svg></button>
            }
            <div class="lg-meta"><span><svg class="i"><use href="#i-lock" /></svg>@L.T("Core_Login2_SessionEncrypted")</span><span>@L.T("Core_Login2_ForgotHint")</span></div>
        </main>
    </div>

    <footer class="lg-foot">
        <span>© @DateTime.Now.Year tahsinERP · SCHAIN</span>
        <a href="https://tahsinerp.uz" target="_blank" rel="noopener">tahsinerp.uz</a>
    </footer>
    <script>
        (function () {
            var b = document.querySelector('[data-toggle-pw]'), p = document.getElementById('password');
            if (b && p) b.addEventListener('click', function () { p.type = p.type === 'password' ? 'text' : 'password'; p.focus(); });
            // Til tanlagichi (Bootstrap JS'siz): tugma menyuni ochadi/yopadi, tashqariga bosilsa yopiladi.
            var lt = document.querySelector('.lg-lang [data-toggle="dropdown"]'), lm = document.querySelector('.lg-lang .lg-lang-menu');
            if (lt && lm) {
                lt.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); var o = lm.classList.toggle('show'); lt.setAttribute('aria-expanded', o ? 'true' : 'false'); });
                document.addEventListener('click', function () { lm.classList.remove('show'); lt.setAttribute('aria-expanded', 'false'); });
            }
        })();
    </script>
</body>
</html>
