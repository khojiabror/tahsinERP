@model List<tahsinERP.Models.ROLE>
@{
    ViewBag.Title = L.T("Adm_Roles");
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item active">@L.T("Adm_Roles")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "Role")" class="btn btn-success">
                                <i class="bx bx-plus"></i> @L.T("Core_RoleAddNew")
                            </a>
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert">
                                <span>&times;</span>
                            </button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert">
                                <span>&times;</span>
                            </button>
                        </div>
                    }

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="roleDataTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Core_RoleName")</th>
                                                    <th>@L.T("Description")</th>
                                                    <th>@L.T("Core_PermissionsCount")</th>
                                                    <th>@L.T("Adm_Users")</th>
                                                    @if (changePermit)
                                                    {
                                                        <th class="text-center">@L.T("Actions")</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>
                                                            <a href="@Url.Action("Details", "Role", new { id = item.ID })" class="font-weight-bold">
                                                                @item.RName
                                                            </a>
                                                        </td>
                                                        <td>@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                                                        <td>
                                                            <span class="badge badge-light-info">
                                                                @(item.PERMISSIONS?.Count ?? 0) ta
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="badge badge-light-primary">
                                                                @{
                                                                    var userCounts = ViewBag.UserCounts as System.Collections.Generic.Dictionary<int, int>;
                                                                    var count = userCounts != null && userCounts.ContainsKey(item.ID) ? userCounts[item.ID] : 0;
                                                                }
                                                                @count ta
                                                            </span>
                                                        </td>
                                                        @if (changePermit)
                                                        {
                                                            <td class="text-center">
                                                                <a href="@Url.Action("Permissions", "Role", new { id = item.ID })" 
                                                                   class="btn btn-sm btn-outline-warning" title="@L.T("Adm_Permissions")">
                                                                    <i class="bx bx-lock"></i>
                                                                </a>
                                                                <a href="@Url.Action("Edit", "Role", new { id = item.ID })" 
                                                                   class="btn btn-sm btn-outline-primary" title="@L.T("Edit")">
                                                                    <i class="bx bx-edit"></i>
                                                                </a>
                                                                @if (!tahsinERP.Services.Common.SystemCodes.IsSystem(item.SystemCode))
                                                                {
                                                                <a href="@Url.Action("Delete", "Role", new { id = item.ID })" 
                                                                   class="btn btn-sm btn-outline-danger" title="@L.T("Delete")">
                                                                    <i class="bx bx-trash"></i>
                                                                </a>
                                                                }
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var changePermit = @(changePermit ? "true" : "false");
            
            var columnDefs = [];
            if (changePermit) {
                columnDefs.push({ "orderable": false, "targets": -1 });
            }
            
            $('#roleDataTable').DataTable({
                language: erpDataTable.language,
                "pageLength": 25,
                "order": [[0, "asc"]],
                "columnDefs": columnDefs,
                dom: 'lBfrtip',
                buttons: erpDataTable.buttons({ fileName: '@L.Js("Adm_Roles")', pdfTitle: '@L.Js("Core_RolesList")', columns: changePermit ? ':not(:last-child)' : ':visible' }),
                "scrollX": true
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
