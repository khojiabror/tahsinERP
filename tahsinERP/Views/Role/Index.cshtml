@model List<tahsinERP.Models.ROLE>
@{
    ViewBag.Title = "Rollar";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Rollar</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item active">Rollar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "Role")" class="btn btn-success">
                                <i class="bx bx-plus"></i> Yangi rol qo'shish
                            </a>
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert">
                                <span>&times;</span>
                            </button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert">
                                <span>&times;</span>
                            </button>
                        </div>
                    }

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="roleDataTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Rol nomi</th>
                                                    <th>Tavsif</th>
                                                    <th>Huquqlar soni</th>
                                                    <th>Foydalanuvchilar</th>
                                                    @if (changePermit)
                                                    {
                                                        <th class="text-center">Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>
                                                            <a href="@Url.Action("Details", "Role", new { id = item.ID })" class="font-weight-bold">
                                                                @item.RName
                                                            </a>
                                                        </td>
                                                        <td>@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                                                        <td>
                                                            <span class="badge badge-light-info">
                                                                @(item.PERMISSIONS?.Count ?? 0) ta
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="badge badge-light-primary">
                                                                @{
                                                                    var userCounts = ViewBag.UserCounts as System.Collections.Generic.Dictionary<int, int>;
                                                                    var count = userCounts != null && userCounts.ContainsKey(item.ID) ? userCounts[item.ID] : 0;
                                                                }
                                                                @count ta
                                                            </span>
                                                        </td>
                                                        @if (changePermit)
                                                        {
                                                            <td class="text-center">
                                                                <a href="@Url.Action("Permissions", "Role", new { id = item.ID })" 
                                                                   class="btn btn-sm btn-outline-warning" title="Huquqlar">
                                                                    <i class="bx bx-lock"></i>
                                                                </a>
                                                                <a href="@Url.Action("Edit", "Role", new { id = item.ID })" 
                                                                   class="btn btn-sm btn-outline-primary" title="Tahrirlash">
                                                                    <i class="bx bx-edit"></i>
                                                                </a>
                                                                <a href="@Url.Action("Delete", "Role", new { id = item.ID })" 
                                                                   class="btn btn-sm btn-outline-danger" title="O'chirish">
                                                                    <i class="bx bx-trash"></i>
                                                                </a>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <!-- DataTables Buttons CSS and JS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#roleDataTable').DataTable({
                "language": {
                    "search": "Qidirish:",
                    "lengthMenu": "_MENU_ ta ko'rsatish",
                    "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    "infoEmpty": "Yozuvlar yo'q",
                    "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                    "paginate": {
                        "first": "Birinchi",
                        "last": "Oxirgi",
                        "next": "Keyingi",
                        "previous": "Oldingi"
                    },
                    "zeroRecords": "Ma'lumot topilmadi"
                },
                "pageLength": 25,
                "order": [[0, "asc"]],
                "columnDefs": [
                    @if (changePermit)
                    {
                        <text>
                        { "orderable": false, "targets": -1 }
                        </text>
                    }
                ],
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bx bx-file"></i> Excel ga export',
                        className: 'btn btn-success btn-sm mb-2',
                        exportOptions: {
                            columns: ':not(:last-child)',
                            format: {
                                body: function (data, row, column, node) {
                                    // Remove HTML tags from data
                                    return data.replace(/<[^>]*>/g, '').trim();
                                }
                            }
                        },
                        filename: function() {
                            return 'Rollar_' + new Date().toISOString().slice(0,10);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bx bx-file-blank"></i> PDF ga export',
                        className: 'btn btn-danger btn-sm mb-2',
                        exportOptions: {
                            columns: ':not(:last-child)',
                            format: {
                                body: function (data, row, column, node) {
                                    // Remove HTML tags from data
                                    return data.replace(/<[^>]*>/g, '').trim();
                                }
                            }
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        filename: function() {
                            return 'Rollar_' + new Date().toISOString().slice(0,10);
                        },
                        title: 'Rollar ro\'yxati',
                        customize: function (doc) {
                            doc.defaultStyle.fontSize = 9;
                            doc.styles.tableHeader.fontSize = 10;
                        }
                    }
                ]
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
