@model tahsinERP.Models.ROLE
@{
    ViewBag.Title = L.T("Core_RoleEdit");
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Role">@L.T("Adm_Roles")</a></li>
                                    <li class="breadcrumb-item active">@Model.RName</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                <div class="row">
                    <div class="col-md-8 col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title"><i class="bx bx-edit mr-1"></i>@L.T("Core_RoleData")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Edit", "Role", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(model => model.ID)
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        <div class="form-group">
                                            <label for="RName">@L.T("Core_RoleName") <span class="text-danger">*</span></label>
                                            @Html.TextBoxFor(model => model.RName, new { 
                                                @class = "form-control", 
                                                @placeholder = L.T("Core_RoleName"),
                                                @required = "required"
                                            })
                                            @Html.ValidationMessageFor(model => model.RName, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            <label for="Description">@L.T("Description")</label>
                                            @Html.TextAreaFor(model => model.Description, new { 
                                                @class = "form-control", 
                                                @rows = "4",
                                                @placeholder = L.T("Core_RoleDescPlaceholderShort")
                                            })
                                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="bx bx-save"></i> @L.T("Save")
                                            </button>
                                            <a href="@Url.Action("Permissions", "Role", new { id = Model.ID })" class="btn btn-warning">
                                                <i class="bx bx-lock"></i> @L.T("Core_ManagePermissions")
                                            </a>
                                            <a href="@Url.Action("Index", "Role")" class="btn btn-outline-secondary">
                                                <i class="bx bx-x"></i> @L.T("Cancel")
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
