@model tahsinERP.Models.ROLE
@{
    ViewBag.Title = "Rolni o'chirish";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Rolni o'chirish</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Role">Rollar</a></li>
                                    <li class="breadcrumb-item active">@Model.RName</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row">
                    <div class="col-md-8 col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title"><i class="bx bx-trash mr-1"></i>Rolni o'chirish</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Delete", "Role", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(model => model.ID)

                                        <div class="alert alert-warning">
                                            <i class="bx bx-error-circle"></i>
                                            <strong>Diqqat!</strong> Siz ushbu rolni o'chirishni xohlaysizmi?
                                        </div>

                                        <div class="form-group">
                                            <label><strong>Rol nomi:</strong></label>
                                            <p class="form-control-plaintext">@Model.RName</p>
                                        </div>

                                        <div class="form-group">
                                            <label><strong>Tavsif:</strong></label>
                                            <p class="form-control-plaintext">@(string.IsNullOrEmpty(Model.Description) ? "-" : Model.Description)</p>
                                        </div>

                                        @if (ViewBag.UsersCount != null && (int)ViewBag.UsersCount > 0)
                                        {
                                            <div class="alert alert-info">
                                                <i class="bx bx-info-circle"></i>
                                                Bu rolga ega <strong>@ViewBag.UsersCount</strong> ta foydalanuvchi mavjud. 
                                                Rol o'chirilgandan keyin, bu foydalanuvchilar rolsiz qoladi.
                                            </div>
                                        }

                                        <div class="form-group">
                                            <button type="submit" class="btn btn-danger">
                                                <i class="bx bx-trash"></i> Ha, o'chirish
                                            </button>
                                            <a href="@Url.Action("Index", "Role")" class="btn btn-outline-secondary">
                                                <i class="bx bx-x"></i> Bekor qilish
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
