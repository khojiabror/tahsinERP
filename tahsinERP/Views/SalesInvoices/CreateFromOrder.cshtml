@model tahsinERP.Models.SALES_INVOICES
@{
    ViewBag.Title = "Create Invoice from Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var order = ViewBag.Order as tahsinERP.Models.S_ORDERS;
    var orderProducts = ViewBag.OrderProducts as List<tahsinERP.Models.S_ORDER_PRODUCTS>;
    var products = ViewBag.Products as Dictionary<int, tahsinERP.Models.PRODUCT>;
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SalesInvoices">Invoyslar</a>
                                    </li>
                                    @if (order != null)
                                    {
                                        <li class="breadcrumb-item">
                                            <a href="@Url.Action("Details", "SOrder", new { id = order.ID })">Buyurtma @order.OrderNo</a>
                                        </li>
                                    }
                                    <li class="breadcrumb-item active">
                                        Invoys yaratish
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @if (order != null)
                                        {
                                            <div class="alert alert-info">
                                                <strong>Buyurtma:</strong> @order.OrderNo | 
                                                <strong>Mijoz:</strong> @(order.CUSTOMER?.Name ?? "") | 
                                                <strong>Summa:</strong> @(order.Amount?.ToString("N2") ?? "0.00") @(order.CURRENCy1?.Shortname ?? "")
                                            </div>
                                        }

                                        @using (Html.BeginForm("CreateFromOrder", "SalesInvoices", FormMethod.Post, new { @class = "form" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(m => m.OrderID)
                                            @Html.HiddenFor(m => m.ContractID)
                                            @Html.HiddenFor(m => m.CustomerID)

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Invoys raqami *</label>
                                                        @Html.TextBoxFor(m => m.InvoiceNo, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.InvoiceNo, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Invoys sanasi *</label>
                                                        @Html.TextBoxFor(m => m.InvoiceDate, new { @class = "form-control", type = "date", required = "required", Value = Model.InvoiceDate.ToString("yyyy-MM-dd") })
                                                        @Html.ValidationMessageFor(m => m.InvoiceDate, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Valyuta</label>
                                                        @Html.DropDownListFor(m => m.CurrencyCode, ViewBag.Currencies as SelectList, new { @class = "form-control" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Muddat</label>
                                                        @Html.TextBoxFor(m => m.DueDate, new { @class = "form-control", type = "date" })
                                                    </div>
                                                </div>
                                            </div>

                                            <hr />
                                            <h5>Invoys qatorlari</h5>

                                            <div class="table-responsive">
                                                <table class="table table-bordered" id="invoiceLinesTable">
                                                    <thead>
                                                        <tr>
                                                            <th>Mahsulot</th>
                                                            <th>Tavsif</th>
                                                            <th>Miqdor</th>
                                                            <th>Birlik narxi</th>
                                                            <th>QQS %</th>
                                                            <th>Amallar</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (orderProducts != null)
                                                        {
                                                            int index = 0;
                                                            foreach (var orderProduct in orderProducts)
                                                            {
                                                                var product = products != null && products.ContainsKey(orderProduct.ProductID) ? products[orderProduct.ProductID] : null;
                                                                <tr data-order-product-id="@orderProduct.ID">
                                                                    <td>
                                                                        @if (product != null)
                                                                        {
                                                                            @product.PNo
                                                                        }
                                                                        <input type="hidden" name="lines[@index].ProductID" value="@orderProduct.ProductID" />
                                                                    </td>
                                                                    <td>
                                                                        <input type="text" name="lines[@index].Description" class="form-control" value="@(product?.Name ?? "")" />
                                                                    </td>
                                                                    <td>
                                                                        <input type="number" name="lines[@index].Qty" class="form-control qty-input" step="0.01" min="0" max="@orderProduct.Amount" value="@orderProduct.Amount" required />
                                                                        <small class="text-muted">Max: @orderProduct.Amount</small>
                                                                    </td>
                                                                    <td>
                                                                        <input type="number" name="lines[@index].UnitPrice" class="form-control price-input" step="0.01" min="0" value="@orderProduct.Price" required />
                                                                    </td>
                                                                    <td>
                                                                        <input type="number" name="lines[@index].VATRate" class="form-control vat-input" step="0.01" min="0" max="100" value="12" required />
                                                                    </td>
                                                                    <td>
                                                                        <button type="button" class="btn btn-sm btn-danger remove-line">O'chirish</button>
                                                                    </td>
                                                                </tr>
                                                                index++;
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12 text-right">
                                                    <strong>Jami summa: <span id="totalAmount">0.00</span> @Model.CurrencyCode</strong><br />
                                                    <strong>QQS: <span id="totalVAT">0.00</span> @Model.CurrencyCode</strong><br />
                                                    <strong>Jami (QQS bilan): <span id="totalWithVAT">0.00</span> @Model.CurrencyCode</strong>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12">
                                                    <button type="submit" class="btn btn-primary">
                                                        <i class="bx bx-save"></i> Saqlash
                                                    </button>
                                                    <a href="@Url.Action("Details", "SOrder", new { id = order?.ID })" class="btn btn-secondary">
                                                        Bekor qilish
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            function calculateTotals() {
                var totalAmount = 0;
                var totalVAT = 0;

                $('#invoiceLinesTable tbody tr').each(function() {
                    var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                    var price = parseFloat($(this).find('.price-input').val()) || 0;
                    var vatRate = parseFloat($(this).find('.vat-input').val()) || 0;

                    var lineAmount = qty * price;
                    var vatAmount = lineAmount * vatRate / 100;

                    totalAmount += lineAmount;
                    totalVAT += vatAmount;
                });

                $('#totalAmount').text(totalAmount.toFixed(2));
                $('#totalVAT').text(totalVAT.toFixed(2));
                $('#totalWithVAT').text((totalAmount + totalVAT).toFixed(2));
            }

            $('.qty-input, .price-input, .vat-input').on('input', calculateTotals);
            calculateTotals();

            $('.remove-line').on('click', function() {
                if (confirm('Bu qatorni o\'chirishni tasdiqlaysizmi?')) {
                    $(this).closest('tr').remove();
                    calculateTotals();
                }
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

