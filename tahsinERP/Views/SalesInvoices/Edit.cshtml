@model tahsinERP.Models.SALES_INVOICES
@{
    ViewBag.Title = "Edit Invoice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SalesInvoices">Invoyslar</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="@Url.Action("Details", "SalesInvoices", new { id = Model.ID })">@Model.InvoiceNo</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Tahrirlash
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @if (Model.StatusCode == "FINALIZED" || Model.StatusCode == "PAID")
                                        {
                                            <div class="alert alert-warning">
                                                <strong>Diqqat!</strong> Yakunlangan yoki to'langan invoysni tahrirlash mumkin emas.
                                            </div>
                                        }
                                        @if (TempData["ErrorMessage"] != null)
                                        {
                                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                                <i class="bx bx-error"></i> @TempData["ErrorMessage"]
                                                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                            </div>
                                        }
                                        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger", @role = "alert", @id = "validationSummary" })

                                        @using (Html.BeginForm("Edit", "SalesInvoices", FormMethod.Post, new { @class = "form", @id = "invoiceEditForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(m => m.ID)

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Invoys raqami *</label>
                                                        @Html.TextBoxFor(m => m.InvoiceNo, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.InvoiceNo, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Invoys sanasi *</label>
                                                        @Html.TextBoxFor(m => m.InvoiceDate, new { @class = "form-control", type = "date", required = "required", Value = Model.InvoiceDate.ToString("yyyy-MM-dd") })
                                                        @Html.ValidationMessageFor(m => m.InvoiceDate, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Mijoz *</label>
                                                        @Html.DropDownListFor(m => m.CustomerID, ViewBag.Customers as SelectList, new { @class = "form-control", @id = "CustomerID", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.CustomerID, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Shartnoma *</label>
                                                        @Html.DropDownListFor(m => m.ContractID, ViewBag.Contracts as SelectList, new { @class = "form-control", @id = "ContractID", required = "required" })
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Buyurtma</label>
                                                        @Html.DropDownListFor(m => m.OrderID, ViewBag.Orders as SelectList, new { @class = "form-control", @id = "OrderID" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Valyuta *</label>
                                                        @Html.DropDownListFor(m => m.CurrencyID, ViewBag.Currencies as SelectList, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.CurrencyID, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <hr />
                                            <h5>Invoys qatorlari</h5>
                                            <div class="alert alert-info mb-2">
                                                <i class="bx bx-info-circle"></i> Tayyor maxsulot tanlang, miqdor va QQS % kiriting. Birlik narxi shartnomadan avtomatik yuklanadi.
                                            </div>

                                            <div class="table-responsive">
                                                <table class="table table-bordered" id="invoiceLinesTable">
                                                    <thead>
                                                        <tr>
                                                            <th>Mahsulot</th>
                                                            <th>Tavsif</th>
                                                            <th>Miqdor</th>
                                                            <th>Birlik narxi</th>
                                                            <th>QQS %</th>
                                                            <th>Amallar</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{
                                                            var productItems = ViewBag.ProductItems as List<SelectListItem> ?? new List<SelectListItem>();
                                                            var inv = System.Globalization.CultureInfo.InvariantCulture;
                                                            int lineIndex = 0;
                                                        }
                                                        @foreach (var line in Model.SALES_INVOICE_LINES.OrderBy(l => l.LineNo))
                                                        {
                                                            <tr>
                                                                <td>
                                                                    @* Har qator uchun alohida SelectList — saqlangan mahsulot tanlangan bo'ladi (CRM-B03; <select>'da Value atributi ishlamaydi) *@
                                                                    @Html.DropDownList($"lines[{lineIndex}].ProductID", new SelectList(productItems, "Value", "Text", line.ProductID.ToString()), "Tanlang", new { @class = "form-control product-select", required = "required" })
                                                                </td>
                                                                <td>
                                                                    <input type="text" name="lines[@lineIndex].Description" class="form-control" value="@(line.Description ?? "")" />
                                                                </td>
                                                                <td>
                                                                    <input type="number" name="lines[@lineIndex].Qty" class="form-control qty-input" step="0.01" min="0.01" value="@line.Qty.ToString(inv)" required />
                                                                </td>
                                                                <td>
                                                                    <input type="number" name="lines[@lineIndex].UnitPrice" class="form-control price-input" step="0.01" min="0" value="@line.UnitPrice.ToString(inv)" required readonly />
                                                                </td>
                                                                <td>
                                                                    <input type="number" name="lines[@lineIndex].VATRate" class="form-control vat-input" step="0.01" min="0" max="100" value="@line.VATRate.ToString(inv)" required readonly />
                                                                </td>
                                                                <td>
                                                                    <button type="button" class="btn btn-sm btn-danger remove-line">O'chirish</button>
                                                                </td>
                                                            </tr>
                                                            lineIndex++;
                                                        }
                                                    </tbody>
                                                </table>
                                                @Html.DropDownList("productSelectTemplate", new SelectList(productItems, "Value", "Text"), "Tanlang", new { @class = "form-control product-select d-none", id = "productSelectTemplate", disabled = "disabled" })
                                            </div>
                                            <small class="text-muted">Mahsulot yoki miqdor o'zgarsa, avvalgi ombor chiqimi qaytariladi va yangisi yoziladi.</small>

                                            <div class="row mt-2">
                                                <div class="col-md-12">
                                                    <button type="button" class="btn btn-sm btn-primary" id="addLine">
                                                        <i class="bx bx-plus"></i> Qator qo'shish
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12 text-right">
                                                    <strong>Jami summa: <span id="totalAmount">0.00</span> @tahsinERP.Services.Crm.SalesLookups.CurrencyCode(Model.CurrencyID)</strong><br />
                                                    <strong>QQS: <span id="totalVAT">0.00</span> @tahsinERP.Services.Crm.SalesLookups.CurrencyCode(Model.CurrencyID)</strong><br />
                                                    <strong>Jami (QQS bilan): <span id="totalWithVAT">0.00</span> @tahsinERP.Services.Crm.SalesLookups.CurrencyCode(Model.CurrencyID)</strong>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12">
                                                    <button type="submit" class="btn btn-primary">
                                                        <i class="bx bx-save"></i> Saqlash
                                                    </button>
                                                    <a href="@Url.Action("Details", "SalesInvoices", new { id = Model.ID })" class="btn btn-secondary">
                                                        Bekor qilish
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    // Skript uchun server qiymatlari (Scripts/crm/sales-invoice-form.js o'qiydi)
    var formConfig = new
    {
        formId = "invoiceEditForm",
        urls = new
        {
            contracts = Url.Action("GetContractsByCustomer", "SalesInvoices"),
            orders = Url.Action("GetOrdersByContract", "SalesInvoices"),
            price = Url.Action("GetContractPriceForProduct", "SalesInvoices"),
            currency = Url.Action("GetContractCurrency", "SalesInvoices")
        },
        resetCurrency = false,
        stockHints = false
    };
    <script type="application/json" id="salesInvoiceFormConfig">@Html.Raw(Json.Encode(formConfig))</script>
    <script src="@Url.Content("~/Scripts/crm/sales-invoice-form.js")"></script>
}

