@model tahsinERP.Models.SALES_INVOICES
@{
    ViewBag.Title = "Edit Invoice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SalesInvoices">Invoyslar</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="@Url.Action("Details", "SalesInvoices", new { id = Model.ID })">@Model.InvoiceNo</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Tahrirlash
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @if (Model.StatusCode == "FINALIZED" || Model.StatusCode == "PAID")
                                        {
                                            <div class="alert alert-warning">
                                                <strong>Diqqat!</strong> Yakunlangan yoki to'langan invoysni tahrirlash mumkin emas.
                                            </div>
                                        }
                                        @if (TempData["ErrorMessage"] != null)
                                        {
                                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                                <i class="bx bx-error"></i> @TempData["ErrorMessage"]
                                                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                            </div>
                                        }
                                        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger", @role = "alert", @id = "validationSummary" })

                                        @using (Html.BeginForm("Edit", "SalesInvoices", FormMethod.Post, new { @class = "form", @id = "invoiceEditForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(m => m.ID)

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Invoys raqami *</label>
                                                        @Html.TextBoxFor(m => m.InvoiceNo, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.InvoiceNo, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Invoys sanasi *</label>
                                                        @Html.TextBoxFor(m => m.InvoiceDate, new { @class = "form-control", type = "date", required = "required", Value = Model.InvoiceDate.ToString("yyyy-MM-dd") })
                                                        @Html.ValidationMessageFor(m => m.InvoiceDate, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Mijoz *</label>
                                                        @Html.DropDownListFor(m => m.CustomerID, ViewBag.Customers as SelectList, new { @class = "form-control", @id = "CustomerID", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.CustomerID, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Shartnoma *</label>
                                                        @Html.DropDownListFor(m => m.ContractID, ViewBag.Contracts as SelectList, new { @class = "form-control", @id = "ContractID", required = "required" })
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Buyurtma</label>
                                                        @Html.DropDownListFor(m => m.OrderID, ViewBag.Orders as SelectList, new { @class = "form-control", @id = "OrderID" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Valyuta *</label>
                                                        @Html.DropDownListFor(m => m.CurrencyCode, ViewBag.Currencies as SelectList, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.CurrencyCode, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <hr />
                                            <h5>Invoys qatorlari</h5>
                                            <div class="alert alert-info mb-2">
                                                <i class="bx bx-info-circle"></i> Tayyor maxsulot tanlang, miqdor va QQS % kiriting. Birlik narxi shartnomadan avtomatik yuklanadi.
                                            </div>

                                            <div class="table-responsive">
                                                <table class="table table-bordered" id="invoiceLinesTable">
                                                    <thead>
                                                        <tr>
                                                            <th>Mahsulot</th>
                                                            <th>Tavsif</th>
                                                            <th>Miqdor</th>
                                                            <th>Birlik narxi</th>
                                                            <th>QQS %</th>
                                                            <th>Amallar</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{
                                                            int lineIndex = 0;
                                                        }
                                                        @foreach (var line in Model.SALES_INVOICE_LINES.OrderBy(l => l.LineNo))
                                                        {
                                                            <tr>
                                                                <td>
                                                                    @Html.DropDownList($"lines[{lineIndex}].ProductID", ViewBag.Products as SelectList, new { @class = "form-control product-select", @Value = line.ProductID, required = "required" })
                                                                </td>
                                                                <td>
                                                                    <input type="text" name="lines[@lineIndex].Description" class="form-control" value="@(line.Description ?? "")" />
                                                                </td>
                                                                <td>
                                                                    <input type="number" name="lines[@lineIndex].Qty" class="form-control qty-input" step="0.01" min="0" value="@line.Qty" required />
                                                                </td>
                                                                <td>
                                                                    <input type="number" name="lines[@lineIndex].UnitPrice" class="form-control price-input" step="0.01" min="0" value="@line.UnitPrice" required readonly />
                                                                </td>
                                                                <td>
                                                                    <input type="number" name="lines[@lineIndex].VATRate" class="form-control vat-input" step="0.01" min="0" max="100" value="@line.VATRate" required />
                                                                </td>
                                                                <td>
                                                                    <button type="button" class="btn btn-sm btn-danger remove-line">O'chirish</button>
                                                                </td>
                                                            </tr>
                                                            lineIndex++;
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="row mt-2">
                                                <div class="col-md-12">
                                                    <button type="button" class="btn btn-sm btn-primary" id="addLine">
                                                        <i class="bx bx-plus"></i> Qator qo'shish
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12 text-right">
                                                    <strong>Jami summa: <span id="totalAmount">0.00</span> @Model.CurrencyCode</strong><br />
                                                    <strong>QQS: <span id="totalVAT">0.00</span> @Model.CurrencyCode</strong><br />
                                                    <strong>Jami (QQS bilan): <span id="totalWithVAT">0.00</span> @Model.CurrencyCode</strong>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12">
                                                    <button type="submit" class="btn btn-primary">
                                                        <i class="bx bx-save"></i> Saqlash
                                                    </button>
                                                    <a href="@Url.Action("Details", "SalesInvoices", new { id = Model.ID })" class="btn btn-secondary">
                                                        Bekor qilish
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        (function() {
            var urls = {
                contracts: '@Url.Action("GetContractsByCustomer", "SalesInvoices")',
                orders: '@Url.Action("GetOrdersByContract", "SalesInvoices")',
                price: '@Url.Action("GetContractPriceForProduct", "SalesInvoices")',
                currency: '@Url.Action("GetContractCurrency", "SalesInvoices")'
            };

            function init() {
                var lineIndex = @Model.SALES_INVOICE_LINES.Count;

                function loadContracts(customerId) {
                    var sel = document.getElementById('ContractID');
                    if (!sel) return;
                    sel.disabled = true;
                    sel.innerHTML = '<option value="">Yuklanmoqda...</option>';
                    fetch(urls.contracts + '?customerId=' + customerId)
                        .then(function(r) { return r.json(); })
                        .then(function(data) {
                            sel.innerHTML = '<option value="">Tanlang</option>';
                            if (data && data.length) {
                                data.forEach(function(c) {
                                    var opt = document.createElement('option');
                                    opt.value = c.ID;
                                    opt.textContent = c.ContractNo;
                                    sel.appendChild(opt);
                                });
                            }
                            sel.disabled = false;
                            var orderSel = document.getElementById('OrderID');
                            if (orderSel) orderSel.innerHTML = '<option value="">Tanlang</option>';
                        })
                        .catch(function() {
                            sel.innerHTML = '<option value="">Xatolik</option>';
                            sel.disabled = false;
                        });
                }

                function loadOrders(contractId) {
                    var sel = document.getElementById('OrderID');
                    if (!sel) return;
                    sel.disabled = true;
                    sel.innerHTML = '<option value="">Yuklanmoqda...</option>';
                    fetch(urls.orders + '?contractId=' + contractId)
                        .then(function(r) { return r.json(); })
                        .then(function(data) {
                            sel.innerHTML = '<option value="">Tanlang</option>';
                            if (data && data.length) {
                                data.forEach(function(o) {
                                    var opt = document.createElement('option');
                                    opt.value = o.ID;
                                    opt.textContent = o.OrderNo;
                                    sel.appendChild(opt);
                                });
                            }
                            sel.disabled = false;
                        })
                        .catch(function() {
                            sel.innerHTML = '<option value="">Xatolik</option>';
                            sel.disabled = false;
                        });
                    fetch(urls.currency + '?contractId=' + contractId)
                        .then(function(r) { return r.json(); })
                        .then(function(d) {
                            var curSel = document.getElementById('CurrencyCode');
                            if (curSel && d && d.CurrencyCode) curSel.value = d.CurrencyCode;
                        });
                }

                function loadPriceForProduct(contractId, productId, priceInput) {
                    if (!contractId || !productId || !priceInput) return;
                    fetch(urls.price + '?contractId=' + contractId + '&productId=' + productId)
                        .then(function(r) { return r.json(); })
                        .then(function(d) {
                            if (d && d.PiecePrice != null) priceInput.value = parseFloat(d.PiecePrice).toFixed(2);
                            calculateTotals();
                        });
                }

                var contractEl = document.getElementById('ContractID');
                var custEl = document.getElementById('CustomerID');
                if (custEl) {
                    custEl.addEventListener('change', function() {
                        var v = this.value;
                        if (v) loadContracts(v);
                        else {
                            if (contractEl) contractEl.innerHTML = '<option value="">Tanlang</option>';
                            var orderSel = document.getElementById('OrderID');
                            if (orderSel) orderSel.innerHTML = '<option value="">Tanlang</option>';
                        }
                    });
                }
                if (contractEl) {
                    contractEl.addEventListener('change', function() {
                        var v = this.value;
                        if (v) loadOrders(v);
                        else {
                            var orderSel = document.getElementById('OrderID');
                            if (orderSel) orderSel.innerHTML = '<option value="">Tanlang</option>';
                        }
                    });
                }

                document.addEventListener('change', function(e) {
                    if (e.target && e.target.classList && e.target.classList.contains('product-select')) {
                        var tr = e.target.closest('tr');
                        if (tr) {
                            var contractId = contractEl ? contractEl.value : '';
                            var productId = e.target.value;
                            var priceInp = tr.querySelector('.price-input');
                            if (contractId && productId && priceInp) loadPriceForProduct(contractId, productId, priceInp);
                        }
                    }
                });

                function calculateTotals() {
                    var totalAmount = 0, totalVAT = 0;
                    var rows = document.querySelectorAll('#invoiceLinesTable tbody tr');
                    for (var i = 0; i < rows.length; i++) {
                        var r = rows[i];
                        var qInp = r.querySelector('.qty-input'), pInp = r.querySelector('.price-input'), vInp = r.querySelector('.vat-input');
                        var qty = parseFloat(qInp ? qInp.value : 0) || 0;
                        var price = parseFloat(pInp ? pInp.value : 0) || 0;
                        var vatRate = parseFloat(vInp ? vInp.value : 0) || 0;
                        totalAmount += qty * price;
                        totalVAT += qty * price * vatRate / 100;
                    }
                    var totalEl = document.getElementById('totalAmount');
                    var vatEl = document.getElementById('totalVAT');
                    var withVatEl = document.getElementById('totalWithVAT');
                    if (totalEl) totalEl.textContent = totalAmount.toFixed(2);
                    if (vatEl) vatEl.textContent = totalVAT.toFixed(2);
                    if (withVatEl) withVatEl.textContent = (totalAmount + totalVAT).toFixed(2);
                }

                document.querySelectorAll('.qty-input, .price-input, .vat-input').forEach(function(el) {
                    el.addEventListener('input', calculateTotals);
                });
                calculateTotals();

                var addBtn = document.getElementById('addLine');
                if (addBtn) {
                    addBtn.addEventListener('click', function() {
                        var table = document.getElementById('invoiceLinesTable');
                        var firstRow = table ? table.querySelector('tbody tr:first-child') : null;
                        var productSelect = firstRow ? firstRow.querySelector('select') : null;
                        if (!table || !firstRow || !productSelect) return;

                        var newSelect = productSelect.cloneNode(true);
                        newSelect.name = 'lines[' + lineIndex + '].ProductID';
                        newSelect.removeAttribute('id');
                        newSelect.value = '';
                        newSelect.classList.add('product-select');

                        var newRow = document.createElement('tr');
                        var td1 = document.createElement('td');
                        td1.appendChild(newSelect);
                        newRow.appendChild(td1);
                        ['Description','Qty','UnitPrice','VATRate'].forEach(function(name, idx) {
                            var inp = document.createElement('input');
                            inp.className = 'form-control' + (idx === 1 ? ' qty-input' : idx === 2 ? ' price-input' : idx === 3 ? ' vat-input' : '');
                            inp.type = idx === 0 ? 'text' : 'number';
                            inp.name = 'lines[' + lineIndex + '].' + name;
                            if (idx >= 1) { inp.step = '0.01'; inp.min = '0'; inp.required = true; if (idx === 2) inp.readOnly = true; }
                            if (idx === 3) { inp.max = '100'; inp.value = '12'; }
                            var td = document.createElement('td');
                            td.appendChild(inp);
                            newRow.appendChild(td);
                        });
                        var tdBtn = document.createElement('td');
                        var btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'btn btn-sm btn-danger remove-line';
                        btn.textContent = 'O\'chirish';
                        btn.addEventListener('click', function() {
                            if (confirm('Bu qatorni o\'chirishni tasdiqlaysizmi?')) { newRow.remove(); calculateTotals(); }
                        });
                        tdBtn.appendChild(btn);
                        newRow.appendChild(tdBtn);

                        table.querySelector('tbody').appendChild(newRow);
                        newRow.querySelectorAll('.qty-input, .price-input, .vat-input').forEach(function(el) {
                            el.addEventListener('input', calculateTotals);
                        });
                        lineIndex++;
                    });
                }

                document.addEventListener('click', function(e) {
                    if (e.target && e.target.classList && e.target.classList.contains('remove-line')) {
                        if (confirm('Bu qatorni o\'chirishni tasdiqlaysizmi?')) {
                            var tr = e.target.closest('tr');
                            if (tr) { tr.remove(); calculateTotals(); }
                        }
                    }
                });

                var vs = document.getElementById('validationSummary');
                if (vs && vs.textContent.trim()) vs.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

