@model List<tahsinERP.Models.SALES_INVOICES>
@{
    ViewBag.Title = "Ro'yxat";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsPermittedForAction(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString(), true);

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Sotuv invoyslari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "SalesInvoices")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi invoys
                            </a>
                        </div>
                    }

                    <!-- Filters -->
                    <div class="users-list-filter px-1">
                        @using (Html.BeginForm("Index", "SalesInvoices", FormMethod.Get, new { @class = "form" }))
                        {
                            <div class="row border rounded py-2 mb-2">
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Qidirish</label>
                                    <input type="text" name="searchTerm" class="form-control" placeholder="Invoys raqami..." value="@ViewBag.SearchTerm" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Mijoz</label>
                                    @Html.DropDownList("customerID", ViewBag.Customers as SelectList, "Barchasi", new { @class = "form-control" })
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Buyurtma</label>
                                    @Html.DropDownList("orderID", ViewBag.Orders as SelectList, "Barchasi", new { @class = "form-control" })
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Dan</label>
                                    <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Gacha</label>
                                    <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bx bx-search"></i> Qidirish
                                    </button>
                                </div>
                                <div class="col-12 mt-1 text-right">
                                    @* Filtrlangan BARCHA yozuvlar (DataTables eksporti faqat joriy sahifani olardi) *@
                                    <a class="btn btn-sm btn-success" href="@(Url.Action("ExportExcel", "SalesInvoices") + Request.Url.Query)">
                                        <i class="bx bxs-file-excel"></i> Excel (barchasi)
                                    </a>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="invoiceDataTable" data-crm-table data-lock-last="@(changePermit ? "true" : "false")" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Invoys raqami</th>
                                                    <th>Sana</th>
                                                    <th>Mijoz</th>
                                                    <th>Shartnoma</th>
                                                    <th>Buyurtma</th>
                                                    <th>Summa</th>
                                                    <th>Valyuta</th>
                                                    <th>Holat</th>
                                                    @if (changePermit)
                                                    {
                                                        <th class="text-center">Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "SalesInvoices", new { id = item.ID })" class="font-weight-bold">
                                                                    @item.InvoiceNo
                                                                </a>
                                                            </td>
                                                            <td>@item.InvoiceDate.ToString("dd.MM.yyyy")</td>
                                                            <td>
                                                                @{
                                                                    var customerNames = ViewBag.CustomerNames as IDictionary<int, string>;
                                                                    string customerName = null;
                                                                    if (customerNames != null && customerNames.ContainsKey(item.CustomerID))
                                                                    {
                                                                        customerName = customerNames[item.CustomerID];
                                                                    }
                                                                }
                                                                @if (!string.IsNullOrEmpty(customerName))
                                                                {
                                                                    <span class="font-weight-bold">@customerName</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @{
                                                                    var contractNumbers = ViewBag.ContractNumbers as IDictionary<int, string>;
                                                                    string contractNo = null;
                                                                    if (item.ContractID.HasValue && contractNumbers != null && contractNumbers.ContainsKey(item.ContractID.Value))
                                                                    {
                                                                        contractNo = contractNumbers[item.ContractID.Value];
                                                                    }
                                                                }
                                                                @if (item.ContractID.HasValue && !string.IsNullOrEmpty(contractNo))
                                                                {
                                                                    <a href="@Url.Action("Details", "SContract", new { id = item.ContractID })" class="font-weight-bold">
                                                                        @contractNo
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @{
                                                                    var orderNumbers = ViewBag.OrderNumbers as IDictionary<int, string>;
                                                                    string orderNo = null;
                                                                    if (item.OrderID.HasValue && orderNumbers != null && orderNumbers.ContainsKey(item.OrderID.Value))
                                                                    {
                                                                        orderNo = orderNumbers[item.OrderID.Value];
                                                                    }
                                                                }
                                                                @if (item.OrderID.HasValue)
                                                                {
                                                                    <a href="@Url.Action("Details", "SOrder", new { id = item.OrderID })" class="font-weight-bold">
                                                                        Buyurtma #@(string.IsNullOrEmpty(orderNo) ? item.OrderID.ToString() : orderNo)
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            <td>@((item.TotalWithVAT ?? item.TotalAmount).ToString("N2"))</td>
                                                            <td>
                                                                @if (item.CurrencyID.HasValue)
                                                                {
                                                                    <span class="badge badge-light-primary">@tahsinERP.Services.Crm.SalesLookups.CurrencyCode(item.CurrencyID)</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (tahsinERP.Services.Crm.SalesInvoiceStatus.IsCanceled(item.StatusCode))
                                                                {
                                                                    <span class="badge badge-light-danger">Bekor qilingan</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge badge-light-success">@item.StatusCode</span>
                                                                }
                                                            </td>
                                                            @if (changePermit)
                                                            {
                                                                <td class="text-center">
                                                                    <a href="@Url.Action("Edit", "SalesInvoices", new { id = item.ID })" 
                                                                       class="btn btn-sm btn-outline-primary" title="Tahrirlash">
                                                                        <i class="bx bx-edit"></i>
                                                                    </a>
                                                                    @if (item.StatusCode != "PAID" && item.StatusCode != "CANCELED")
                                                                    {
                                                                        <a href="@Url.Action("Delete", "SalesInvoices", new { id = item.ID })"
                                                                           class="btn btn-sm btn-outline-danger" title="Bekor qilish">
                                                                            <i class="bx bx-trash"></i>
                                                                        </a>
                                                                    }
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    @Html.Partial("~/Views/SalesInvoices/_Pager.cshtml")

                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script src="@Url.Content("~/Scripts/crm/crm-page-table.js")"></script>
}

