@model tahsinERP.Models.SALES_INVOICES
@using System.Linq
@{
    ViewBag.Title = L.T("Crm_InvPrintTitle");
    Layout = null;

    var customer = ViewBag.Customer as tahsinERP.Models.CUSTOMER;
    var order = ViewBag.Order as tahsinERP.Models.S_ORDERS;
    var contract = ViewBag.Contract as tahsinERP.Models.S_CONTRACTS;
    var products = ViewBag.Products as Dictionary<int, tahsinERP.Models.PRODUCT>;
    var company = ViewBag.Company as tahsinERP.Models.COMPANy;
    var lines = Model.SALES_INVOICE_LINES.OrderBy(l => l.LineNo).ToList();
    var rowsToRender = Math.Max(lines.Count, 5);
    var baseCopyTitles = new[] { L.T("Crm_InvCopyOriginal"), L.T("Crm_InvCopyWarehouse"), L.T("Crm_InvCopyReturn") };
    var maxCopies = 6;
    var orderDate = order != null ? order.IssuedDate.ToString("dd.MM.yyyy") : "-";
    var contractDate = contract != null ? contract.IssuedDate.ToString("dd.MM.yyyy") : "-";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@L.T("Crm_InvPrintPageTitle", Model.InvoiceNo)</title>
    <style>
        @@page {
            size: A4 portrait;
            margin: 6mm;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #111;
        }

        .toolbar {
            position: sticky;
            top: 0;
            z-index: 50;
            background: #ffffff;
            border-bottom: 1px solid #dcdcdc;
            padding: 10px 14px;
            display: flex;
            gap: 8px;
        }

        .toolbar button {
            border: 1px solid #444;
            background: #fff;
            border-radius: 4px;
            padding: 6px 10px;
            font-size: 12px;
            cursor: pointer;
        }

        .print-root {
            width: 198mm;
            min-height: 285mm;
            margin: 8px auto;
            background: #fff;
            padding: 0;
        }

        .invoice-copy {
            border: 1.5px solid #333;
            height: 92mm;
            margin-bottom: 2mm;
            padding: 3mm;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .invoice-copy:last-child {
            margin-bottom: 0;
        }

        .copy-top {
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: center;
            gap: 8px;
            margin-bottom: 2mm;
        }

        .doc-title {
            text-align: center;
            font-weight: 700;
            font-size: 13px;
            letter-spacing: 0.2px;
        }

        .copy-label {
            font-size: 10px;
            border: 1px solid #555;
            padding: 2px 6px;
            white-space: nowrap;
        }

        .meta-table,
        .items-table,
        .totals-table,
        .sign-table {
            width: 100%;
            border-collapse: collapse;
        }

        .meta-table td,
        .items-table th,
        .items-table td,
        .totals-table td,
        .sign-table td {
            border: 1px solid #444;
            padding: 2px 4px;
            font-size: 10px;
            vertical-align: top;
        }

        .items-table th {
            background: #efefef;
            text-align: center;
            font-weight: 700;
            height: 18px;
        }

        .right {
            text-align: right;
        }

        .center {
            text-align: center;
        }

        .meta-table .label {
            width: 92px;
            font-weight: 700;
            background: #f6f6f6;
            white-space: nowrap;
        }

        .party-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4px;
            margin: 1.5mm 0;
        }

        .sign-table td {
            height: 20px;
        }

        .totals-wrap {
            margin-top: 1.5mm;
            margin-left: auto;
            width: 68mm;
        }

        .note {
            margin-top: 1mm;
            font-size: 9px;
            color: #333;
        }

        .footer-meta {
            margin-top: 1mm;
            display: flex;
            justify-content: space-between;
            font-size: 9px;
            color: #333;
        }

        @@media print {
            body {
                background: #fff;
            }

            .toolbar {
                display: none !important;
            }

            .print-root {
                margin: 0 auto;
                width: 100%;
                min-height: auto;
            }
        }
    </style>
</head>
<body>
    <div class="toolbar no-print">
        <label for="copyCountSelect" style="font-size: 12px; display: flex; align-items: center; gap: 4px; margin-right: 8px;">
            @L.T("Crm_InvCopyCount")
            <select id="copyCountSelect" style="font-size: 12px; padding: 4px;">
                <option value="3" selected>3</option>
                <option value="6">6</option>
            </select>
        </label>
        <button type="button" data-print-action="print">@L.T("Print")</button>
        <button type="button" data-print-action="pdf">@L.T("Crm_InvDownloadPdf")</button>
        <button type="button" data-print-action="close">@L.T("Close")</button>
    </div>

    <div class="print-root" id="invoice-print-root" data-pdf-filename="@L.T("Crm_InvPdfFilePrefix")_@(string.IsNullOrWhiteSpace(Model.InvoiceNo) ? Model.ID.ToString() : Model.InvoiceNo).pdf">
        @for (var copyIndex = 0; copyIndex < maxCopies; copyIndex++)
        {
            var label = copyIndex < baseCopyTitles.Length
                ? baseCopyTitles[copyIndex]
                : L.T("Crm_InvCopyN", copyIndex + 1);

            <section class="invoice-copy" data-copy-index="@copyIndex" style="@(copyIndex < 3 ? "" : "display:none;")">
                <div class="copy-top">
                    <div class="doc-title">@L.T("Crm_InvDocTitle")</div>
                    <div class="copy-label">@label</div>
                </div>

                <table class="meta-table">
                    <tr>
                        <td class="label">@L.T("Crm_InvInvoiceNo")</td>
                        <td>@(string.IsNullOrWhiteSpace(Model.InvoiceNo) ? Model.ID.ToString() : Model.InvoiceNo)</td>
                        <td class="label">@L.T("Crm_InvInvoiceDate")</td>
                        <td>@Model.InvoiceDate.ToString("dd.MM.yyyy")</td>
                    </tr>
                    <tr>
                        <td class="label">@L.T("Crm_Order")</td>
                        <td>@(order != null ? order.OrderNo : "-")</td>
                        <td class="label">@L.T("Crm_OrderDate")</td>
                        <td>@orderDate</td>
                        <td class="label">@L.T("Currency")</td>
                        <td>@tahsinERP.Services.Crm.SalesLookups.CurrencyCode(Model.CurrencyID)</td>
                    </tr>
                    <tr>
                        <td class="label">@L.T("Crm_Contract")</td>
                        <td>@(contract != null ? contract.ContractNo : "-")</td>
                        <td class="label">@L.T("Crm_InvContractDate")</td>
                        <td>@contractDate</td>
                    </tr>
                </table>

                <div class="party-grid">
                    <table class="meta-table">
                        <tr><td class="label">@L.T("Crm_InvSeller")</td><td>@(company?.Name ?? "-")</td></tr>
                        <tr><td class="label">@L.T("Address")</td><td>Oltinkul tumani, Mehnat MFY., 90-uy</td></tr>
                        <tr><td class="label">@L.T("Phone")</td><td>@(company?.Telephone ?? "-")</td></tr>
                        <tr><td class="label">@L.T("Email")</td><td>@(company?.Email ?? "-")</td></tr>
                        <tr><td class="label">@L.T("Crm_InvTinDuns")</td><td>@(company?.DUNS ?? "-")</td></tr>
                    </table>
                    <table class="meta-table">
                        <tr><td class="label">@L.T("Crm_Customer")</td><td>@(customer?.Name ?? "-")</td></tr>
                        <tr><td class="label">@L.T("Address")</td><td>@(customer?.Address ?? "-")</td></tr>
                        <tr><td class="label">@L.T("Phone")</td><td>@(customer?.Telephone ?? "-")</td></tr>
                        <tr><td class="label">@L.T("Email")</td><td>@(customer?.Email ?? "-")</td></tr>
                        <tr><td class="label">@L.T("Crm_InvTinDuns")</td><td>@(customer?.DUNS ?? "-")</td></tr>
                    </table>
                </div>

                <table class="items-table">
                    <thead>
                        <tr>
                            <th style="width:6%;">#</th>
                            <th style="width:14%;">SKU</th>
                            <th style="width:26%;">@L.T("Crm_InvProductNameDesc")</th>
                            <th style="width:8%;">@L.T("Unit")</th>
                            <th style="width:10%;">@L.T("Quantity")</th>
                            <th style="width:14%;">@L.T("Crm_InvUnitPriceNoVat")</th>
                            <th style="width:8%;">@L.T("Crm_VatPercent")</th>
                            <th style="width:14%;">@L.T("Amount")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < rowsToRender; i++)
                        {
                            var line = i < lines.Count ? lines[i] : null;
                            var product = line != null && products != null && products.ContainsKey(line.ProductID) ? products[line.ProductID] : null;
                            <tr>
                                <td class="center">@(line != null ? (i + 1).ToString() : "")</td>
                                <td>@(line != null ? (product?.PNo ?? line.ProductID.ToString()) : "")</td>
                                <td>@(line != null ? (line.Description ?? product?.Name ?? "") : "")</td>
                                <td class="center">@(line != null ? (product?.UNIT?.ShortName ?? "-") : "")</td>
                                <td class="right">@(line != null ? line.Qty.ToString("N3") : "")</td>
                                <td class="right">@(line != null ? line.UnitPrice.ToString("N2") : "")</td>
                                <td class="right">@(line != null ? line.VATRate.ToString("N2") : "")</td>
                                <td class="right">@(line != null ? (line.LineAmount.HasValue ? line.LineAmount.Value.ToString("N2") : "0.00") : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="totals-wrap">
                    <table class="totals-table">
                        <tr>
                            <td><strong>@L.T("Crm_TotalAmount")</strong></td>
                            <td class="right">@Model.TotalAmount.ToString("N2") @tahsinERP.Services.Crm.SalesLookups.CurrencyCode(Model.CurrencyID)</td>
                        </tr>
                        <tr>
                            <td><strong>@L.T("Crm_Vat")</strong></td>
                            <td class="right">@Model.TotalVAT.ToString("N2") @tahsinERP.Services.Crm.SalesLookups.CurrencyCode(Model.CurrencyID)</td>
                        </tr>
                        <tr>
                            <td><strong>@L.T("Crm_InvGrandTotal")</strong></td>
                            <td class="right"><strong>@(Model.TotalWithVAT.HasValue ? Model.TotalWithVAT.Value.ToString("N2") : "0.00") @tahsinERP.Services.Crm.SalesLookups.CurrencyCode(Model.CurrencyID)</strong></td>
                        </tr>
                    </table>
                </div>

                <table class="sign-table">
                    <tr>
                        <td><strong>@L.T("Crm_InvPreparedBy")</strong></td>
                        <td><strong>@L.T("Crm_InvReceivedBy")</strong></td>
                    </tr>
                    <tr>
                        <td>@L.T("Crm_InvSignature")</td>
                        <td>@L.T("Crm_InvSignature")</td>
                    </tr>
                </table>

                <div class="footer-meta">
                    <div>@L.T("Crm_InvCopyOf", copyIndex + 1, 3)</div>
                </div>
                <div class="note">
                    @L.T("Crm_InvGeneratedNote")
                </div>
            </section>
        }
    </div>

    <script src="@Url.Content("~/app-assets/js/scripts/pdfMake/html2pdf.bundle.min.js")"></script>
    <script src="@Url.Content("~/Scripts/crm/sales-invoice-print.js")"></script>
</body>
</html>
