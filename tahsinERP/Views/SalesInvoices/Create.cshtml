@model tahsinERP.Models.SALES_INVOICES
@{
    ViewBag.Title = L.T("Crm_CreateInvoice");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SalesInvoices">@L.T("Menu_Invoices")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Crm_CreateInvoice")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @if (TempData["ErrorMessage"] != null)
                                        {
                                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                                <i class="bx bx-error"></i> @TempData["ErrorMessage"]
                                                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                            </div>
                                        }
                                        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger", @role = "alert", @id = "validationSummary" })

                                        @using (Html.BeginForm("Create", "SalesInvoices", FormMethod.Post, new { @class = "form", @id = "invoiceCreateForm" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>@L.T("Crm_InvInvoiceNo")</label>
                                                        @Html.TextBoxFor(m => m.InvoiceNo, new { @class = "form-control", @placeholder = L.T("Crm_InvAutoNoPlaceholder", (object)ViewBag.SuggestedInvoiceNo) })
                                                        @Html.ValidationMessageFor(m => m.InvoiceNo, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>@L.T("Crm_InvInvoiceDate") *</label>
                                                        @Html.TextBoxFor(
                                                            m => m.InvoiceDate,
                                                            new
                                                            {
                                                                @class = "form-control",
                                                                type = "date",
                                                                required = "required",
                                                                Value = Model.InvoiceDate.ToString("yyyy-MM-dd"),
                                                                max = DateTime.Now.ToString("yyyy-MM-dd")
                                                            })
                                                        @Html.ValidationMessageFor(m => m.InvoiceDate, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>@L.T("Crm_PaymentDue")</label>
                                                        @Html.TextBoxFor(m => m.DueDate, new { @class = "form-control", type = "date", Value = Model.DueDate.HasValue ? Model.DueDate.Value.ToString("yyyy-MM-dd") : "" })
                                                        <small class="text-muted">@L.T("Crm_InvDueDateHint")</small>
                                                        @Html.ValidationMessageFor(m => m.DueDate, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>@L.T("Crm_Client") *</label>
                                                        @Html.DropDownListFor(m => m.CustomerID, ViewBag.Customers as SelectList, L.T("Select"), new { @class = "form-control", @id = "CustomerID", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.CustomerID, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>@L.T("Crm_Contract") *</label>
                                                        @Html.DropDownListFor(m => m.ContractID, ViewBag.Contracts as SelectList, new { @class = "form-control", @id = "ContractID", required = "required" })
                                                        <small class="text-muted">@L.T("Crm_InvContractHint")</small>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>@L.T("Crm_Order")</label>
                                                        @Html.DropDownListFor(m => m.OrderID, ViewBag.Orders as SelectList, new { @class = "form-control", @id = "OrderID" })
                                                        <small class="text-muted">@L.T("Crm_InvOrderHint")</small>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>@L.T("Currency") *</label>
                                                        @Html.DropDownListFor(m => m.CurrencyID, ViewBag.Currencies as SelectList, L.T("Select"), new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.CurrencyID, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="WarehouseID">@L.T("Crm_InvWarehouse") *</label>
                                                        @Html.DropDownListFor(m => m.WarehouseID, ViewBag.SalesWarehouses as List<SelectListItem>, new { @class = "form-control", id = "WarehouseID", required = "required" })
                                                        <small class="text-muted">@L.T("Crm_InvWarehouseHint")</small>
                                                    </div>
                                                </div>
                                            </div>

                                            <hr />
                                            <h5>@L.T("Crm_InvLines")</h5>
                                            <div class="alert alert-info mb-2">
                                                <i class="bx bx-info-circle"></i> @L.T("Crm_InvLinesHint")
                                            </div>

                                            <div class="table-responsive">
                                                <table class="table table-bordered doc-lines" id="invoiceLinesTable">
                                                    <thead>
                                                        <tr>
                                                            <th>@L.T("Crm_Product")</th>
                                                            <th>@L.T("Description")</th>
                                                            <th>@L.T("Quantity")</th>
                                                            <th>@L.T("Crm_UnitPrice")</th>
                                                            <th>@L.T("Crm_VatPercent")</th>
                                                            <th>@L.T("Actions")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{
                                                            var productItems = ViewBag.ProductItems as List<SelectListItem> ?? new List<SelectListItem>();
                                                            // Xato bilan qaytganda kiritilgan qatorlar saqlanadi
                                                            var formLines = Model.SALES_INVOICE_LINES != null && Model.SALES_INVOICE_LINES.Any()
                                                                ? Model.SALES_INVOICE_LINES.OrderBy(l => l.LineNo).ToList()
                                                                : new List<tahsinERP.Models.SALES_INVOICE_LINES> { new tahsinERP.Models.SALES_INVOICE_LINES() };
                                                            var inv = System.Globalization.CultureInfo.InvariantCulture;
                                                            int lineIndex = 0;
                                                        }
                                                        @foreach (var line in formLines)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    @Html.DropDownList($"lines[{lineIndex}].ProductID", new SelectList(productItems, "Value", "Text", line.ProductID > 0 ? line.ProductID.ToString() : null), L.T("Select"), new { @class = "form-control product-select", required = "required" })
                                                                    <small class="text-muted available-stock-hint"></small>
                                                                </td>
                                                                <td>
                                                                    <input type="text" name="lines[@lineIndex].Description" class="form-control" value="@line.Description" />
                                                                </td>
                                                                <td>
                                                                    <input type="number" name="lines[@lineIndex].Qty" class="form-control qty-input" step="0.01" min="0.01" value="@(line.ProductID > 0 ? line.Qty.ToString(inv) : "")" required />
                                                                </td>
                                                                <td>
                                                                    <input type="number" name="lines[@lineIndex].UnitPrice" class="form-control price-input" step="0.01" min="0" value="@(line.ProductID > 0 ? line.UnitPrice.ToString(inv) : "")" required readonly />
                                                                </td>
                                                                <td>
                                                                    <input type="number" name="lines[@lineIndex].VATRate" class="form-control vat-input" step="0.01" min="0" max="100" value="@line.VATRate.ToString(inv)" required readonly />
                                                                </td>
                                                                <td>
                                                                    <button type="button" class="btn btn-sm btn-danger remove-line">@L.T("Delete")</button>
                                                                </td>
                                                            </tr>
                                                            lineIndex++;
                                                        }
                                                    </tbody>
                                                </table>
                                                @* Yangi qator uchun mahsulot ro'yxati namunasi (birinchi qator o'chirilsa ham ishlaydi) *@
                                                @Html.DropDownList("productSelectTemplate", new SelectList(productItems, "Value", "Text"), L.T("Select"), new { @class = "form-control product-select d-none", id = "productSelectTemplate", disabled = "disabled" })
                                            </div>

                                            <div class="row mt-2">
                                                <div class="col-md-12">
                                                    <button type="button" class="btn btn-sm btn-primary" id="addLine">
                                                        <i class="bx bx-plus"></i> @L.T("Crm_AddRow")
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12 text-right">
                                                    <strong>@L.T("Crm_TotalAmount"): <span id="totalAmount">0.00</span> @tahsinERP.Services.Crm.SalesLookups.CurrencyCode(Model.CurrencyID)</strong><br />
                                                    <strong>@L.T("Crm_Vat"): <span id="totalVAT">0.00</span> @tahsinERP.Services.Crm.SalesLookups.CurrencyCode(Model.CurrencyID)</strong><br />
                                                    <strong>@L.T("Crm_TotalWithVat"): <span id="totalWithVAT">0.00</span> @tahsinERP.Services.Crm.SalesLookups.CurrencyCode(Model.CurrencyID)</strong>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12">
                                                    <button type="submit" class="btn btn-primary">
                                                        <i class="bx bx-save"></i> @L.T("Save")
                                                    </button>
                                                    <a href="@Url.Action("Index", "SalesInvoices")" class="btn btn-secondary">
                                                        @L.T("Cancel")
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    // Skript uchun server qiymatlari (Scripts/crm/sales-invoice-form.js o'qiydi)
    var formConfig = new
    {
        formId = "invoiceCreateForm",
        invoiceId = 0,
        urls = new
        {
            contracts = Url.Action("GetContractsByCustomer", "SalesInvoices"),
            orders = Url.Action("GetOrdersByContract", "SalesInvoices"),
            price = Url.Action("GetContractPriceForProduct", "SalesInvoices"),
            currency = Url.Action("GetContractCurrency", "SalesInvoices"),
            orderProducts = Url.Action("GetOrderProductsForInvoice", "SalesInvoices"),
            warehouseProducts = Url.Action("GetWarehouseProducts", "SalesInvoices")
        },
        resetCurrency = true,
        stockHints = true,
        initialOrderId = Model.OrderID.HasValue ? Model.OrderID.Value : 0,
        hasPostedLines = Model.SALES_INVOICE_LINES != null && Model.SALES_INVOICE_LINES.Any()
    };
    <script type="application/json" id="salesInvoiceFormConfig">@Html.Raw(Json.Encode(formConfig))</script>
    <script src="@Url.Content("~/Scripts/crm/sales-invoice-form.js")"></script>
}

