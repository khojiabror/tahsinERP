@model tahsinERP.Models.SALES_INVOICES
@{
    ViewBag.Title = "Create Invoice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SalesInvoices">Invoyslar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Invoys yaratish
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Create", "SalesInvoices", FormMethod.Post, new { @class = "form" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Invoys raqami *</label>
                                                        @Html.TextBoxFor(m => m.InvoiceNo, new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.InvoiceNo, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Invoys sanasi *</label>
                                                        @Html.TextBoxFor(m => m.InvoiceDate, new { @class = "form-control", type = "date", required = "required", Value = Model.InvoiceDate.ToString("yyyy-MM-dd") })
                                                        @Html.ValidationMessageFor(m => m.InvoiceDate, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Mijoz *</label>
                                                        @Html.DropDownListFor(m => m.CustomerID, ViewBag.Customers as SelectList, "Tanlang", new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.CustomerID, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Buyurtma</label>
                                                        @Html.DropDownListFor(m => m.OrderID, ViewBag.Orders as SelectList, "Tanlang", new { @class = "form-control" })
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Shartnoma</label>
                                                        @Html.DropDownListFor(m => m.ContractID, ViewBag.Contracts as SelectList, "Tanlang", new { @class = "form-control" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Valyuta *</label>
                                                        @Html.DropDownListFor(m => m.CurrencyCode, ViewBag.Currencies as SelectList, "Tanlang", new { @class = "form-control", required = "required" })
                                                        @Html.ValidationMessageFor(m => m.CurrencyCode, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Muddat</label>
                                                        @Html.TextBoxFor(m => m.DueDate, new { @class = "form-control", type = "date" })
                                                    </div>
                                                </div>
                                            </div>

                                            <hr />
                                            <h5>Invoys qatorlari</h5>

                                            <div class="table-responsive">
                                                <table class="table table-bordered" id="invoiceLinesTable">
                                                    <thead>
                                                        <tr>
                                                            <th>Mahsulot</th>
                                                            <th>Tavsif</th>
                                                            <th>Miqdor</th>
                                                            <th>Birlik narxi</th>
                                                            <th>QQS %</th>
                                                            <th>Amallar</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>
                                                                @Html.DropDownList("lines[0].ProductID", ViewBag.Products as SelectList, "Tanlang", new { @class = "form-control product-select", required = "required" })
                                                                <small class="text-muted available-stock-hint"></small>
                                                            </td>
                                                            <td>
                                                                <input type="text" name="lines[0].Description" class="form-control" />
                                                            </td>
                                                            <td>
                                                                <input type="number" name="lines[0].Qty" class="form-control qty-input" step="0.01" min="0" required />
                                                            </td>
                                                            <td>
                                                                <input type="number" name="lines[0].UnitPrice" class="form-control price-input" step="0.01" min="0" required />
                                                            </td>
                                                            <td>
                                                                <input type="number" name="lines[0].VATRate" class="form-control vat-input" step="0.01" min="0" max="100" value="12" required />
                                                            </td>
                                                            <td>
                                                                <button type="button" class="btn btn-sm btn-danger remove-line">O'chirish</button>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="row mt-2">
                                                <div class="col-md-12">
                                                    <button type="button" class="btn btn-sm btn-primary" id="addLine">
                                                        <i class="bx bx-plus"></i> Qator qo'shish
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12 text-right">
                                                    <strong>Jami summa: <span id="totalAmount">0.00</span> @Model.CurrencyCode</strong><br />
                                                    <strong>QQS: <span id="totalVAT">0.00</span> @Model.CurrencyCode</strong><br />
                                                    <strong>Jami (QQS bilan): <span id="totalWithVAT">0.00</span> @Model.CurrencyCode</strong>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12">
                                                    <button type="submit" class="btn btn-primary">
                                                        <i class="bx bx-save"></i> Saqlash
                                                    </button>
                                                    <a href="@Url.Action("Index", "SalesInvoices")" class="btn btn-secondary">
                                                        Bekor qilish
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            var lineIndex = 1;
            var productStockMap = {};

            function parseAvailableFromText(text) {
                var match = text.match(/Mavjud:\s*([0-9]+(?:\.[0-9]+)?)/i);
                return match ? match[1] : null;
            }

            function buildStockMap() {
                productStockMap = {};
                $('#invoiceLinesTable tbody tr:first td:first select option').each(function () {
                    var value = $(this).attr('value');
                    if (!value) return;
                    var available = parseAvailableFromText($(this).text());
                    if (available !== null) {
                        productStockMap[value] = available;
                    }
                });
            }

            function updateStockHint($row) {
                var productId = $row.find('.product-select').val();
                var available = productStockMap[productId];
                $row.find('.available-stock-hint').text(available ? ('Mavjud: ' + available) : '');
            }

            function calculateTotals() {
                var totalAmount = 0;
                var totalVAT = 0;

                $('#invoiceLinesTable tbody tr').each(function() {
                    var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                    var price = parseFloat($(this).find('.price-input').val()) || 0;
                    var vatRate = parseFloat($(this).find('.vat-input').val()) || 0;

                    var lineAmount = qty * price;
                    var vatAmount = lineAmount * vatRate / 100;

                    totalAmount += lineAmount;
                    totalVAT += vatAmount;
                });

                $('#totalAmount').text(totalAmount.toFixed(2));
                $('#totalVAT').text(totalVAT.toFixed(2));
                $('#totalWithVAT').text((totalAmount + totalVAT).toFixed(2));
            }

            $('.qty-input, .price-input, .vat-input').on('input', calculateTotals);
            calculateTotals();

            $('#addLine').on('click', function() {
                var productSelect = $('#invoiceLinesTable tbody tr:first td:first select').clone();
                productSelect.attr('name', 'lines[' + lineIndex + '].ProductID');
                productSelect.addClass('product-select');
                
                var newRow = $('<tr>');
                newRow.append($('<td>').append(productSelect).append($('<small>').addClass('text-muted available-stock-hint')));
                newRow.append($('<td>').append($('<input>').attr({type: 'text', name: 'lines[' + lineIndex + '].Description', class: 'form-control'})));
                newRow.append($('<td>').append($('<input>').attr({type: 'number', name: 'lines[' + lineIndex + '].Qty', class: 'form-control qty-input', step: '0.01', min: '0', required: 'required'})));
                newRow.append($('<td>').append($('<input>').attr({type: 'number', name: 'lines[' + lineIndex + '].UnitPrice', class: 'form-control price-input', step: '0.01', min: '0', required: 'required'})));
                newRow.append($('<td>').append($('<input>').attr({type: 'number', name: 'lines[' + lineIndex + '].VATRate', class: 'form-control vat-input', step: '0.01', min: '0', max: '100', value: '12', required: 'required'})));
                newRow.append($('<td>').append($('<button>').attr({type: 'button', class: 'btn btn-sm btn-danger remove-line'}).text('O\'chirish')));
                
                $('#invoiceLinesTable tbody').append(newRow);
                $('.qty-input, .price-input, .vat-input').off('input').on('input', calculateTotals);
                updateStockHint(newRow);
                lineIndex++;
            });

            $(document).on('click', '.remove-line', function() {
                if (confirm('Bu qatorni o\'chirishni tasdiqlaysizmi?')) {
                    $(this).closest('tr').remove();
                    calculateTotals();
                }
            });

            $(document).on('change', '.product-select', function () {
                updateStockHint($(this).closest('tr'));
            });

            buildStockMap();
            updateStockHint($('#invoiceLinesTable tbody tr:first'));
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

