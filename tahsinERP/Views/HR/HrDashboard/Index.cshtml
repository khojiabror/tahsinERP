@model tahsinERP.ViewModels.HR.HrDashboardViewModel
@{
    ViewBag.Title = "HR Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "HrDashboard"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">HR Dashboard</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item active">HR Dashboard</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <!-- Filters -->
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <form method="get" action="@Url.Action("Index")" class="row">
                                    <div class="col-md-3">
                                        <label>Год</label>
                                        <input type="number" name="year" class="form-control" value="@ViewBag.Year" min="2000" max="2100" />
                                    </div>
                                    <div class="col-md-3">
                                        <label>Месяц</label>
                                        <select name="month" class="form-control">
                                            @for (int i = 1; i <= 12; i++)
                                            {
                                                <option value="@i" @(ViewBag.Month == i ? "selected" : "")>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Подразделение</label>
                                        @Html.DropDownList("orgUnitId", ViewBag.OrgUnitID as SelectList, "Все подразделения", new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-2">
                                        <label>&nbsp;</label>
                                        <button type="submit" class="btn btn-primary btn-block">Применить</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Summary Cards -->
                <div class="row match-height">
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="bx bx-group primary font-large-2 float-left"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h3>@Model.TotalHeadcount</h3>
                                            <span>Всего сотрудников</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="bx bx-user-check success font-large-2 float-left"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h3>@Model.PlannedHeadcount</h3>
                                            <span>Плановое количество</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="bx bx-money warning font-large-2 float-left"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h3>@Model.TotalMonthlyPayroll.ToString("N2")</h3>
                                            <span>Месячный фонд оплаты</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="bx bx-time danger font-large-2 float-left"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h3>@Model.TotalOvertimeHours.ToString("N1")</h3>
                                            <span>Сверхурочные часы</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Charts Row -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Штатная численность по подразделениям</h4>
                            </div>
                            <div class="card-body">
                                <canvas id="headcountChart" height="300"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Динамика фонда оплаты труда</h4>
                            </div>
                            <div class="card-body">
                                <canvas id="payrollTrendChart" height="300"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Headcount by OrgUnit Table -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Штатная численность по подразделениям</h4>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-striped table-bordered" id="headcountTable">
                                        <thead>
                                            <tr>
                                                <th>Подразделение</th>
                                                <th>Плановое</th>
                                                <th>Фактическое</th>
                                                <th>Отклонение</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.HeadcountByOrgUnit)
                                            {
                                                var deviation = item.ActualHeadcount - item.PlannedHeadcount;
                                                <tr>
                                                    <td>@item.OrgUnitName</td>
                                                    <td>@item.PlannedHeadcount</td>
                                                    <td>@item.ActualHeadcount</td>
                                                    <td>
                                                        <span class="badge badge-@(deviation > 0 ? "danger" : deviation < 0 ? "warning" : "success")">
                                                            @(deviation > 0 ? "+" : "")@deviation
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        $(document).ready(function() {
            // Headcount by OrgUnit Chart
            var headcountCtx = document.getElementById('headcountChart').getContext('2d');
            var headcountChart = new Chart(headcountCtx, {
                type: 'bar',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.HeadcountByOrgUnit.Select(x => $"'{x.OrgUnitName}'")))],
                    datasets: [{
                        label: 'Плановое',
                        data: [@string.Join(",", Model.HeadcountByOrgUnit.Select(x => x.PlannedHeadcount))],
                        backgroundColor: 'rgba(54, 162, 235, 0.5)'
                    }, {
                        label: 'Фактическое',
                        data: [@string.Join(",", Model.HeadcountByOrgUnit.Select(x => x.ActualHeadcount))],
                        backgroundColor: 'rgba(255, 99, 132, 0.5)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });

            // Payroll Trend Chart
            var payrollCtx = document.getElementById('payrollTrendChart').getContext('2d');
            var payrollChart = new Chart(payrollCtx, {
                type: 'line',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.PayrollTrend.Select(x => $"'{x.Year}-{x.Month:D2}'")))],
                    datasets: [{
                        label: 'Фонд оплаты труда',
                        data: [@string.Join(",", Model.PayrollTrend.Select(x => x.TotalPayroll))],
                        borderColor: 'rgb(75, 192, 192)',
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });

            // DataTable
            $('#headcountTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Russian.json"
                },
                "pageLength": 25
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

