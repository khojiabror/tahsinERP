@model tahsinERP.ViewModels.HR.HrTimesheetHeaderViewModel
@{
    ViewBag.Title = "Табель - Печать";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int daysInMonth = DateTime.DaysInMonth(Model.Year, Model.Month);
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "HrTimesheets"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Табель за @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) @Model.Year</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "HrTimesheets")">Табели</a></li>
                                    <li class="breadcrumb-item active">Печать</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row mb-2">
                    <div class="col-12 text-right">
                        <button onclick="window.print()" class="btn btn-primary">
                            <i class="bx bx-printer"></i> Печать
                        </button>
                        <a href="@Url.Action("Export", new { id = Model.ID })" class="btn btn-success">
                            <i class="bx bx-export"></i> Экспорт в Excel
                        </a>
                    </div>
                </div>

                <div class="card" id="printArea">
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <h4>ТАБЕЛЬ УЧЕТА РАБОЧЕГО ВРЕМЕНИ</h4>
                            <p>за @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) @Model.Year года</p>
                            @if (!string.IsNullOrEmpty(Model.OrgUnitName))
                            {
                                <p><strong>Подразделение:</strong> @Model.OrgUnitName</p>
                            }
                        </div>

                        <table class="table table-bordered" style="font-size: 10px;">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="width: 30px;">№</th>
                                    <th rowspan="2" style="width: 60px;">Таб.№</th>
                                    <th rowspan="2" style="width: 150px;">Ф.И.О.</th>
                                    <th rowspan="2" style="width: 100px;">Должность</th>
                                    <th colspan="@daysInMonth" style="text-align: center;">Дни месяца</th>
                                    <th rowspan="2" style="width: 60px;">Раб.дней</th>
                                    <th rowspan="2" style="width: 60px;">Раб.часов</th>
                                    <th rowspan="2" style="width: 60px;">Сверхурочные</th>
                                    <th rowspan="2" style="width: 60px;">Неявки</th>
                                </tr>
                                <tr>
                                    @for (int day = 1; day <= daysInMonth; day++)
                                    {
                                        <th style="width: 30px; text-align: center;">@day</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rowNum = 1; }
                                @foreach (var line in Model.Lines.OrderBy(l => l.EmployeeTabNo))
                                {
                                    <tr>
                                        <td>@rowNum</td>
                                        <td>@line.EmployeeTabNo</td>
                                        <td>@line.EmployeeFullName</td>
                                        <td>@line.PositionName</td>
                                        @for (int day = 1; day <= daysInMonth; day++)
                                        {
                                            var propertyName = $"Day{day:D2}Hours";
                                            var property = typeof(tahsinERP.ViewModels.HR.HrTimesheetLineViewModel).GetProperty(propertyName);
                                            var hours = property?.GetValue(line) as decimal?;
                                            <td style="text-align: center;">@(hours?.ToString("F1") ?? "0")</td>
                                        }
                                        <td style="text-align: center;">@line.TotalWorkedDays.ToString("F1")</td>
                                        <td style="text-align: center;">@line.TotalWorkedHours.ToString("F2")</td>
                                        <td style="text-align: center;">@line.OvertimeHours.ToString("F2")</td>
                                        <td style="text-align: center;">@line.AbsentDays.ToString("F1")</td>
                                    </tr>
                                    rowNum++;
                                }
                            </tbody>
                        </table>

                        <div class="mt-4">
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>Составил:</strong> _________________</p>
                                </div>
                                <div class="col-md-6 text-right">
                                    <p><strong>Утвердил:</strong> _________________</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style media="print">
        .content-header, .breadcrumb-wrapper, .btn, .content-overlay {
            display: none !important;
        }
        #printArea {
            border: none;
            box-shadow: none;
        }
        body {
            background: white;
        }
    </style>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

