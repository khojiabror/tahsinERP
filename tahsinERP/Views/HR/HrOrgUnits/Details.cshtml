@model tahsinERP.ViewModels.HR.HrOrgUnitViewModel
@{
    ViewBag.Title = "Детали подразделения";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "HrOrgUnits"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrOrgUnits");

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Детали подразделения</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Организационная структура</a></li>
                                    <li class="breadcrumb-item active">Детали</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">Код:</dt>
                                <dd class="col-sm-9">@Model.Code</dd>

                                <dt class="col-sm-3">Название:</dt>
                                <dd class="col-sm-9">@Model.Name</dd>

                                <dt class="col-sm-3">Родительское подразделение:</dt>
                                <dd class="col-sm-9">@(Model.ParentName ?? "Корневое")</dd>

                                <dt class="col-sm-3">Уровень:</dt>
                                <dd class="col-sm-9">@Model.LevelNo</dd>

                                <dt class="col-sm-3">Плановое количество:</dt>
                                <dd class="col-sm-9">@Model.PlannedHeadcount</dd>

                                <dt class="col-sm-3">Фактическое количество:</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.ActualHeadcount >= Model.PlannedHeadcount ? "success" : "warning")">
                                        @Model.ActualHeadcount
                                    </span>
                                </dd>

                                <dt class="col-sm-3">Статус:</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.IsActive ? "success" : "danger")">
                                        @(Model.IsActive ? "Активен" : "Неактивен")
                                    </span>
                                </dd>

                                <dt class="col-sm-3">Создано:</dt>
                                <dd class="col-sm-9">@Model.CreatedDT.ToString("dd.MM.yyyy HH:mm")</dd>
                            </dl>

                            <div class="form-actions mt-3">
                                @if (changePermit)
                                {
                                    <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                                        <i class="bx bx-edit"></i> Редактировать
                                    </a>
                                }
                                <a href="@Url.Action("Index")" class="btn btn-secondary">Назад к списку</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

