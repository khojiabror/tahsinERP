@model tahsinERP.ViewModels.HR.HrTimesheetHeaderViewModel
@{
    ViewBag.Title = "Редактировать табель";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int daysInMonth = DateTime.DaysInMonth(Model.Year, Model.Month);
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrTimesheets"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Табель за @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) @Model.Year</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Табели</a></li>
                                    <li class="breadcrumb-item active">Редактировать</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                <div class="row mb-2">
                    <div class="col-12">
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-sm btn-primary" onclick="setDefaultHours(8)">
                                <i class="bx bx-time"></i> Установить 8 часов для выбранных
                            </button>
                            <button type="button" class="btn btn-sm btn-secondary" onclick="markWeekend()">
                                <i class="bx bx-calendar"></i> Отметить выходные
                            </button>
                            <a href="@Url.Action("Export", new { id = Model.ID })" class="btn btn-sm btn-success">
                                <i class="bx bx-export"></i> Экспорт в Excel
                            </a>
                            <a href="@Url.Action("Report", new { id = Model.ID })" class="btn btn-sm btn-info" target="_blank">
                                <i class="bx bx-printer"></i> Печать
                            </a>
                            @if (Model.Status == "Draft")
                            {
                                <a href="@Url.Action("Approve", new { id = Model.ID })" class="btn btn-sm btn-warning" onclick="return confirm('Утвердить табель?');">
                                    <i class="bx bx-check"></i> Утвердить
                                </a>
                            }
                        </div>
                        <span class="badge badge-@(Model.Status == "Approved" ? "success" : Model.Status == "Closed" ? "info" : "warning") ml-2">
                            Статус: @(Model.Status == "Draft" ? "Черновик" : Model.Status == "Approved" ? "Утвержден" : "Закрыт")
                        </span>
                    </div>
                </div>

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                                <table class="table table-bordered table-striped" id="timesheetGrid">
                                    <thead class="thead-light" style="position: sticky; top: 0; z-index: 10; background: white;">
                                        <tr>
                                            <th rowspan="2" style="min-width: 50px;">№</th>
                                            <th rowspan="2" style="min-width: 80px;">Таб.№</th>
                                            <th rowspan="2" style="min-width: 200px;">Ф.И.О.</th>
                                            <th rowspan="2" style="min-width: 150px;">Должность</th>
                                            <th colspan="@daysInMonth" style="text-align: center;">Дни месяца</th>
                                            <th rowspan="2" style="min-width: 80px;">Раб.дней</th>
                                            <th rowspan="2" style="min-width: 80px;">Раб.часов</th>
                                            <th rowspan="2" style="min-width: 80px;">Сверхурочные</th>
                                            <th rowspan="2" style="min-width: 80px;">Неявки</th>
                                        </tr>
                                        <tr>
                                            @for (int day = 1; day <= daysInMonth; day++)
                                            {
                                                <th style="min-width: 50px; text-align: center;">@day</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int rowNum = 1; }
                                        @foreach (var line in Model.Lines)
                                        {
                                            <tr data-employee-id="@line.EmployeeID">
                                                <td>@rowNum</td>
                                                <td>@line.EmployeeTabNo</td>
                                                <td>@line.EmployeeFullName</td>
                                                <td>@line.PositionName</td>
                                                @for (int day = 1; day <= daysInMonth; day++)
                                                {
                                                    var propertyName = $"Day{day:D2}Hours";
                                                    var property = typeof(tahsinERP.ViewModels.HR.HrTimesheetLineViewModel).GetProperty(propertyName);
                                                    var hours = property?.GetValue(line) as decimal?;
                                                    <td>
                                                        <input type="number" 
                                                               class="form-control form-control-sm day-hours" 
                                                               data-line-id="@line.ID" 
                                                               data-day="@day" 
                                                               data-employee-id="@line.EmployeeID"
                                                               value="@(hours?.ToString("F2") ?? "0")" 
                                                               step="0.25" 
                                                               min="0" 
                                                               max="24"
                                                               style="width: 60px; text-align: center;"
                                                               @(Model.Status != "Draft" ? "readonly" : "") />
                                                    </td>
                                                }
                                                <td class="total-days">@line.TotalWorkedDays.ToString("F1")</td>
                                                <td class="total-hours">@line.TotalWorkedHours.ToString("F2")</td>
                                                <td class="overtime-hours">@line.OvertimeHours.ToString("F2")</td>
                                                <td class="absent-days">@line.AbsentDays.ToString("F1")</td>
                                            </tr>
                                            rowNum++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        #timesheetGrid {
            font-size: 12px;
        }
        #timesheetGrid th {
            background-color: #f8f9fa;
            font-weight: bold;
        }
        #timesheetGrid .day-hours {
            padding: 2px 4px;
        }
        #timesheetGrid .day-hours:focus {
            background-color: #fff3cd;
        }
        #timesheetGrid tbody tr:hover {
            background-color: #f5f5f5;
        }
    </style>

    <script>
        var timesheetId = @Model.ID;
        var daysInMonth = @daysInMonth;

        $(document).ready(function() {
            // Handle hour input changes
            $('.day-hours').on('change blur', function() {
                var $input = $(this);
                var lineId = $input.data('line-id');
                var day = $input.data('day');
                var hours = parseFloat($input.val()) || 0;

                if (hours < 0) hours = 0;
                if (hours > 24) hours = 24;
                $input.val(hours.toFixed(2));

                // Update via AJAX
                $.post('@Url.Action("UpdateLine")', {
                    lineId: lineId,
                    day: day,
                    hours: hours
                }, function(result) {
                    if (result.success) {
                        // Recalculate row totals
                        recalculateRow($input.closest('tr'));
                    } else {
                        alert('Ошибка: ' + result.message);
                    }
                });
            });

            // Select row on click
            $('#timesheetGrid tbody tr').on('click', function(e) {
                if (e.target.tagName !== 'INPUT') {
                    $(this).toggleClass('table-active');
                }
            });
        });

        function recalculateRow($row) {
            var totalHours = 0;
            var workedDays = 0;
            var absentDays = 0;
            var overtimeHours = 0;

            $row.find('.day-hours').each(function() {
                var hours = parseFloat($(this).val()) || 0;
                if (hours > 0) {
                    totalHours += hours;
                    workedDays += 1;
                    if (hours > 8) {
                        overtimeHours += (hours - 8);
                    }
                } else {
                    absentDays += 1;
                }
            });

            $row.find('.total-hours').text(totalHours.toFixed(2));
            $row.find('.total-days').text(workedDays.toFixed(1));
            $row.find('.overtime-hours').text(overtimeHours.toFixed(2));
            $row.find('.absent-days').text(absentDays.toFixed(1));
        }

        function setDefaultHours(hours) {
            var selectedRows = $('#timesheetGrid tbody tr.table-active');
            if (selectedRows.length === 0) {
                alert('Выберите строки (нажмите на строку)');
                return;
            }

            if (confirm('Установить ' + hours + ' часов для выбранных сотрудников?')) {
                var employeeIds = [];
                selectedRows.each(function() {
                    employeeIds.push($(this).data('employee-id'));
                });

                // Get first day of month
                var firstDay = 1;
                var lastDay = daysInMonth;

                // Set for all days
                for (var day = firstDay; day <= lastDay; day++) {
                    $.post('@Url.Action("BulkUpdate")', {
                        timesheetId: timesheetId,
                        employeeIds: employeeIds,
                        day: day,
                        hours: hours
                    });
                }

                location.reload();
            }
        }

        function markWeekend() {
            var selectedRows = $('#timesheetGrid tbody tr.table-active');
            if (selectedRows.length === 0) {
                alert('Выберите строки');
                return;
            }

            // Mark weekends (Saturday=6, Sunday=0)
            var year = @Model.Year;
            var month = @Model.Month;
            var employeeIds = [];
            selectedRows.each(function() {
                employeeIds.push($(this).data('employee-id'));
            });

            for (var day = 1; day <= daysInMonth; day++) {
                var date = new Date(year, month - 1, day);
                var dayOfWeek = date.getDay();
                if (dayOfWeek === 0 || dayOfWeek === 6) {
                    $.post('@Url.Action("BulkUpdate")', {
                        timesheetId: timesheetId,
                        employeeIds: employeeIds,
                        day: day,
                        hours: 0
                    });
                }
            }

            location.reload();
        }
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

