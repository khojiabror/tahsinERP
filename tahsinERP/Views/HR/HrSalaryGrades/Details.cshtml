@model tahsinERP.ViewModels.HR.HrSalaryGradeViewModel
@{
    ViewBag.Title = "Детали тарифной сетки";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "HrSalaryGrades"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrSalaryGrades");

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Детали тарифной сетки</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Тарифные сетки</a></li>
                                    <li class="breadcrumb-item active">Детали</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">Код:</dt>
                                <dd class="col-sm-9">@Model.GradeCode</dd>

                                <dt class="col-sm-3">Название:</dt>
                                <dd class="col-sm-9">@Model.Name</dd>

                                <dt class="col-sm-3">Минимальная зарплата:</dt>
                                <dd class="col-sm-9">@Model.MinSalary.ToString("N2")</dd>

                                <dt class="col-sm-3">Максимальная зарплата:</dt>
                                <dd class="col-sm-9">@Model.MaxSalary.ToString("N2")</dd>

                                <dt class="col-sm-3">Валюта:</dt>
                                <dd class="col-sm-9">@Model.CurrencyCode</dd>

                                <dt class="col-sm-3">Действует с:</dt>
                                <dd class="col-sm-9">@Model.EffectiveFrom.ToString("dd.MM.yyyy")</dd>

                                <dt class="col-sm-3">Действует до:</dt>
                                <dd class="col-sm-9">@(Model.EffectiveTo?.ToString("dd.MM.yyyy") ?? "-")</dd>
                            </dl>

                            <div class="form-actions mt-3">
                                @if (changePermit)
                                {
                                    <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                                        <i class="bx bx-edit"></i> Редактировать
                                    </a>
                                }
                                <a href="@Url.Action("Index")" class="btn btn-secondary">Назад к списку</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

