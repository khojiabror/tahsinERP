@model tahsinERP.ViewModels.HR.HrStaffingPlanViewModel
@{
    ViewBag.Title = "Редактировать штатное расписание";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrStaffingPlan"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Редактировать штатное расписание</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Штатное расписание</a></li>
                                    <li class="breadcrumb-item active">Редактировать</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @using (Html.BeginForm("Edit", "HrStaffingPlan", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.ID)
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.OrgUnitID, new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.OrgUnitID, ViewBag.OrgUnitID as SelectList, "Выберите подразделение", new { @class = "form-control select2", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.OrgUnitID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.PositionID, new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.PositionID, ViewBag.PositionID as SelectList, "Выберите должность", new { @class = "form-control select2", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.PositionID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.SalaryGradeID, new { @class = "control-label" })
                                            @Html.DropDownListFor(model => model.SalaryGradeID, ViewBag.SalaryGradeID as SelectList, "Выберите тарифную сетку", new { @class = "form-control select2" })
                                            @Html.ValidationMessageFor(model => model.SalaryGradeID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.PlannedHeadcount, new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.TextBoxFor(model => model.PlannedHeadcount, new { @class = "form-control", @type = "number", @step = "0.01", @min = "0", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.PlannedHeadcount, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Тип оплаты</label>
                                            <div class="checkbox checkbox-secondary">
                                                @Html.CheckBoxFor(model => model.IsFixedSalary, new { @id = "checkboxFixed" })
                                                <label for="checkboxFixed">Фиксированная зарплата</label>
                                            </div>
                                            <div class="checkbox checkbox-secondary">
                                                @Html.CheckBoxFor(model => model.IsHourly, new { @id = "checkboxHourly" })
                                                <label for="checkboxHourly">Почасовая оплата</label>
                                            </div>
                                            <div class="checkbox checkbox-secondary">
                                                @Html.CheckBoxFor(model => model.IsPieceRate, new { @id = "checkboxPiece" })
                                                <label for="checkboxPiece">Сдельная оплата</label>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.EffectiveFrom, new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.TextBoxFor(model => model.EffectiveFrom, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.EffectiveFrom, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.EffectiveTo, new { @class = "control-label" })
                                            @Html.TextBoxFor(model => model.EffectiveTo, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                                            @Html.ValidationMessageFor(model => model.EffectiveTo, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            <div class="checkbox checkbox-secondary">
                                                @Html.CheckBoxFor(model => model.IsActive, new { @id = "checkboxActive" })
                                                <label for="checkboxActive">Активен</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-save"></i> Сохранить
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">Отмена</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('.select2').select2({ width: '100%' });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

