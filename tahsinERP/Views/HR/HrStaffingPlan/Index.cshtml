@model List<tahsinERP.ViewModels.HR.HrStaffingPlanViewModel>
@{
    ViewBag.Title = "Штатное расписание";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "HrStaffingPlan"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrStaffingPlan");

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Штатное расписание</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item active">Штатное расписание</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (changePermit)
                {
                    <div class="invoice-create-btn mb-1">
                        <a href="@Url.Action("Create")" class="btn btn-success">
                            <i class="bx bx-plus"></i> Добавить позицию
                        </a>
                        <a href="@Url.Action("GenerateFromEmployees")" class="btn btn-info">
                            <i class="bx bx-user-plus"></i> Создать из сотрудников
                        </a>
                        <a href="@Url.Action("Import")" class="btn btn-warning">
                            <i class="bx bx-import"></i> Импорт из Excel
                        </a>
                    </div>
                }

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <form method="get" action="@Url.Action("Index")" class="mb-2">
                                <div class="row">
                                    <div class="col-md-3">
                                        @Html.DropDownList("orgUnitId", ViewBag.OrgUnitID as SelectList, "Все подразделения", new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.DropDownList("positionId", ViewBag.PositionID as SelectList, "Все должности", new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-2">
                                        <select name="isActive" class="form-control">
                                            <option value="">Все</option>
                                            <option value="true" @(ViewBag.IsActive == true ? "selected" : "")>Активные</option>
                                            <option value="false" @(ViewBag.IsActive == false ? "selected" : "")>Неактивные</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" class="btn btn-primary">Фильтр</button>
                                    </div>
                                </div>
                            </form>

                            <div class="table-responsive">
                                <table id="staffingPlanTable" class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Подразделение</th>
                                            <th>Должность</th>
                                            <th>Тарифная сетка</th>
                                            <th>Плановое количество</th>
                                            <th>Фактическое</th>
                                            <th>Тип оплаты</th>
                                            <th>Действует с</th>
                                            <th>Действия</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.OrgUnitName</td>
                                                <td>@item.PositionName</td>
                                                <td>@(item.SalaryGradeName ?? "-")</td>
                                                <td>@item.PlannedHeadcount</td>
                                                <td>
                                                    <span class="badge badge-@(item.ActualHeadcount >= item.PlannedHeadcount ? "success" : "warning")">
                                                        @item.ActualHeadcount
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (item.IsFixedSalary)
                                                    {
                                                        <span class="badge badge-info">Фиксированная</span>
                                                    }
                                                    @if (item.IsHourly)
                                                    {
                                                        <span class="badge badge-primary">Почасовая</span>
                                                    }
                                                    @if (item.IsPieceRate)
                                                    {
                                                        <span class="badge badge-secondary">Сдельная</span>
                                                    }
                                                </td>
                                                <td>@item.EffectiveFrom.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-info">
                                                        <i class="bx bx-show"></i>
                                                    </a>
                                                    @if (changePermit)
                                                    {
                                                        <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-warning">
                                                            <i class="bx bx-edit"></i>
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('#staffingPlanTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Russian.json"
                },
                "pageLength": 25,
                "order": [[0, "asc"]]
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

