@model tahsinERP.ViewModels.HR.HrEmployeeViewModel
@{
    ViewBag.Title = "Детали сотрудника";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "HrEmployees"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrEmployees");

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Детали сотрудника</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Сотрудники</a></li>
                                    <li class="breadcrumb-item active">Детали</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">Табельный номер:</dt>
                                <dd class="col-sm-9">@Model.TabNo</dd>

                                <dt class="col-sm-3">Ф.И.О.:</dt>
                                <dd class="col-sm-9">@Model.FullName</dd>

                                <dt class="col-sm-3">Подразделение:</dt>
                                <dd class="col-sm-9">@(Model.OrgUnitName ?? "-")</dd>

                                <dt class="col-sm-3">Должность:</dt>
                                <dd class="col-sm-9">@(Model.PositionName ?? "-")</dd>

                                <dt class="col-sm-3">Базовая зарплата:</dt>
                                <dd class="col-sm-9">@(Model.BaseSalary?.ToString("N2") ?? "-")</dd>

                                <dt class="col-sm-3">Тарифная сетка:</dt>
                                <dd class="col-sm-9">@(Model.SalaryGradeName ?? "-")</dd>

                                <dt class="col-sm-3">Дата приема:</dt>
                                <dd class="col-sm-9">@(Model.EmploymentDate?.ToString("dd.MM.yyyy") ?? "-")</dd>

                                <dt class="col-sm-3">Дата увольнения:</dt>
                                <dd class="col-sm-9">@(Model.DismissalDate?.ToString("dd.MM.yyyy") ?? "-")</dd>

                                <dt class="col-sm-3">Статус:</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.IsActive ? "success" : "danger")">
                                        @(Model.IsActive ? "Активен" : "Неактивен")
                                    </span>
                                </dd>
                            </dl>

                            <div class="form-actions mt-3">
                                @if (changePermit)
                                {
                                    <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                                        <i class="bx bx-edit"></i> Редактировать
                                    </a>
                                }
                                <a href="@Url.Action("Index")" class="btn btn-secondary">Назад к списку</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

