@{
    ViewBag.Title = "Создать расчет заработной платы";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrPayroll"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Создать расчет заработной платы</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Расчет заработной платы</a></li>
                                    <li class="breadcrumb-item active">Создать</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @using (Html.BeginForm("Generate", "HrPayroll", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Год <span class="text-danger">*</span></label>
                                            <input type="number" name="year" class="form-control" value="@ViewBag.Year" min="2000" max="2100" required />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Месяц <span class="text-danger">*</span></label>
                                            <select name="month" class="form-control" required>
                                                @for (int i = 1; i <= 12; i++)
                                                {
                                                    <option value="@i" @(ViewBag.Month == i ? "selected" : "")>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Подразделение</label>
                                            @Html.DropDownList("orgUnitId", ViewBag.OrgUnitID as SelectList, "Вся компания", new { @class = "form-control select2" })
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>Табель (источник данных) <span class="text-danger">*</span></label>
                                            @Html.DropDownList("timesheetId", ViewBag.TimesheetID as SelectList, "Выберите утвержденный табель", new { @class = "form-control select2", @required = "required" })
                                            <small class="text-muted">Выберите утвержденный табель для расчета заработной платы</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-calculator"></i> Создать расчет
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">Отмена</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('.select2').select2({ width: '100%' });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

