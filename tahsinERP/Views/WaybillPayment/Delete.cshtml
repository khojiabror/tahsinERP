@model tahsinERP.Models.F_WAYBILL_PAYMENTS
@using tahsinERP.Services
@{
    ViewBag.Title = L.T("Log_PaymentDeleteTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currencyShort = Model.CURRENCy != null ? Model.CURRENCy.Shortname : "";
}
@using (Html.BeginForm("Delete", "WaybillPayment", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.Hidden("ID", Model.ID)
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Waybill/Index">@LogisticsTerms.Waybills</a></li>
                                    <li class="breadcrumb-item"><a href="~/WaybillPayment/Index">@L.T("Log_WaybillPayments")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Log_PaymentDeleteCrumb")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-9 col-md-8 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        <h4 class="text-primary">@L.T("Log_WaybillPayment")</h4>
                                        <p class="text-muted small">@L.T("Log_PayDeleteFinHint")</p>
                                        <hr />
                                        <table class="table table-bordered table-sm">
                                            <tr>
                                                <th style="width:180px">@L.T("Log_Waybill")</th>
                                                <td>@(Model.F_WAYBILLS != null ? Model.F_WAYBILLS.WaybillNo : Model.WaybillID.ToString())</td>
                                            </tr>
                                            <tr>
                                                <th>@LogisticsTerms.Forwarder</th>
                                                <td>@(Model.FORWARDER != null ? Model.FORWARDER.ForwarderName : "")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Log_PaymentDate")</th>
                                                <td>@(Model.PaymentDate?.ToString("dd.MM.yyyy") ?? "")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Log_PaymentAmount")</th>
                                                <td>@Model.Payment_Amount.ToString("N2") @currencyShort</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Comment")</th>
                                                <td>@(Model.Comment ?? "")</td>
                                            </tr>
                                        </table>
                                        <hr />
                                        <button type="submit" class="btn btn-danger" onclick="return confirm('@L.Js("Log_ConfirmDeletePayment")');">
                                            <i class="bx bx-trash"></i> @L.T("Delete")
                                        </button>
                                        <a href="@Url.Action("Index", "WaybillPayment")" class="btn btn-outline-secondary ml-1">@L.T("Cancel")</a>
                                        <a href="@Url.Action("Details", "WaybillPayment", new { Id = Model.ID })" class="btn btn-outline-info ml-1">@L.T("Details")</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
