@model List<tahsinERP.Models.F_WAYBILL_PAYMENTS>
@{
    ViewBag.Title = "Yo'l varaqasi to'lovlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var T = new
    {
        Waybill = tahsinERP.Services.LogisticsTerms.Waybill,
        Waybills = tahsinERP.Services.LogisticsTerms.Waybills,
        Forwarder = tahsinERP.Services.LogisticsTerms.Forwarder,
        TariffBasis = tahsinERP.Services.LogisticsTerms.TariffBasis,
        TariffRate = tahsinERP.Services.LogisticsTerms.TariffRate
    };
    var linkedWaybillMap = ViewBag.LinkedWaybillMap as IDictionary<int, string>;
    var paymentWaybillAmountMap = ViewBag.PaymentWaybillAmountMap as IDictionary<int, double>;
    var paymentOutstandingMap = ViewBag.PaymentOutstandingMap as IDictionary<int, double>;
}
@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = false;
    if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
    {
        changePermit = true;
    }
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        @T.Waybills
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @T.Waybill to'lovlari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <!-- users list start -->
                <section class="invoice-list-wrapper">
                    @Html.Partial("~/Views/Logistic/Shared/_Alerts.cshtml")
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <button type="button" class="btn btn-outline-success mr-1 mb-1" onclick="window.location.href='/WaybillPayment/Create';">
                                <i class="bx bx-plus"></i> Yangi to'lov
                            </button>
                        </div>
                    }
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- datatable start -->
                                    <div class="table-responsive table-responsivetable-responsive">
                                        <table id="myDataTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>To'liq ma'lumot</th>
                                                    <th>@T.Waybill lar</th>
                                                    <th>@T.Forwarder</th>
                                                    <th>To'lov sanasi</th>
                                                    <th>Miqdori</th>
                                                    <th>@T.Waybill summasi</th>
                                                    <th>Qoldiq</th>
                                                    <th>Pul birligi</th>
                                                    <th>Izoh</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    var waybillAmount = paymentWaybillAmountMap != null && paymentWaybillAmountMap.ContainsKey(item.ID)
                                                        ? paymentWaybillAmountMap[item.ID]
                                                        : (item.F_WAYBILLS?.Amount ?? 0);
                                                    var outstanding = paymentOutstandingMap != null && paymentOutstandingMap.ContainsKey(item.ID)
                                                        ? paymentOutstandingMap[item.ID]
                                                        : 0;
                                                    <tr>
                                                        <td>
                                                            <a href="~/WaybillPayment/Details/@item.ID">@item.ID</a>
                                                        </td>
                                                        <td>
                                                            @{
                                                                var waybillText = linkedWaybillMap != null && linkedWaybillMap.ContainsKey(item.ID)
                                                                    ? linkedWaybillMap[item.ID]
                                                                    : "";
                                                            }
                                                            @waybillText
                                                        </td>
                                                        <td><a href="~/Forwarder/Details/@item.ForwarderID">@(item.FORWARDER != null ? item.FORWARDER.ForwarderName : "")</a></td>
                                                        <td>@(item.PaymentDate?.ToString("dd.MM.yyyy") ?? "")</td>
                                                        <td>@item.Payment_Amount.ToString("N2")</td>
                                                        <td>@waybillAmount.ToString("N2")</td>
                                                        <td>@outstanding.ToString("N2")</td>
                                                        <td>@(item.CURRENCy != null ? item.CURRENCy.Shortname : "")</td>
                                                        <td>@(item.Comment ?? "")</td>
                                                        @if (changePermit)
                                                        {
                                                            <td>
                                                                <div>
                                                                    <a href="@Url.Action("Edit", "WaybillPayment", new { id = item.ID })" class="btn btn-sm btn-outline-success" title="Tahrirlash"><i class="bx bx-edit-alt"></i></a>
                                                                    <a href="@Url.Action("Delete", "WaybillPayment", new { id = item.ID })" class="btn btn-sm btn-outline-danger" title="O'chirish"><i class="bx bx-trash"></i></a>
                                                                </div>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    @Html.Partial("~/Views/Logistic/Shared/_Pager.cshtml", (tahsinERP.ViewModels.LogisticsPageInfo)ViewBag.Paging)
                                    <!-- datatable ends -->
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- users list ends -->
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}