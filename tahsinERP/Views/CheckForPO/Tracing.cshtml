@model tahsinERP.ViewModels.OrderTracingViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Tracing</title>

    <!-- BEGIN: Custom CSS-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css">
    <!-- END: Custom CSS-->
    <!-- BEGIN: Theme CSS-->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/bootstrap-extended.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/colors.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css/components.css">
    <!-- END: Theme CSS-->

    <style>
        .wizard-header {
            display: flex;
            justify-content: space-between;
            position: relative;
        }

        .step {
            text-align: center;
            display: inline-block;
            width: calc(100% / 4);
        }

        .circle {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            font-weight: bold;
        }

        .completed {
            background-color: green;
        }

        .pending {
            background-color: red;
        }

        .label {
            margin-top: 10px;
        }

        .progress-container {
            position: relative;
            height: 2px;
            background-color: #bbb;
            margin-top: 20px;
        }

     
            .progress-bar.dashed {
                background: repeating-linear-gradient( to right, green 0%, green 10%, transparent 10%, transparent 20% );
            }
        .progress-bar {
            background-color: #e0e0e0;
            border-radius: 10px;
            height: 30px;
            position: relative;
        }

        .element {
            background-color: #4caf50;
            height: 100%;
            line-height: 30px;
            text-align: center;
            color: white;
            border-radius: 5px;
            transition: width 3s; /* To'ldirish tezligini sekinlashtirish */
        }



    </style>
</head>
<body>
        <div class="content-wrapper">
            <div class="content-body">
                <div class="row">
                    <div class="col-xl-12 col-md-12 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body pb-0 mx-25">
                                    <h4 class="text-primary">Buyurtma ma'lumotlari</h4> <br />
                                    <div class="wizard-header">
                                        <div class="step">
                                            <div class="circle @(Model.IsOrderCompleted ? "completed" : "pending")">
                                                1
                                            </div>
                                            <div class="label">Buyurtma </div>
                                            <span><b>@Model.CreatedOrderDT.ToString("dd.MM.yyyy")</b></span>
                                        </div>
                                        <div class="step">
                                            <div class="circle @(Model.IsContractConfirmed ? "completed" : "pending")">
                                                2
                                            </div>
                                            <div class="label">Shartnoma</div>
                                            <span><b>@Model.IssuedContractDT.ToString("dd.MM.yyyy")</b></span>
                                        </div>
                                        <div class="step">
                                            <div class="circle @(Model.IsPaymentMade ? "completed" : "pending")">
                                                3
                                            </div>
                                            <div class="label">To'lov</div>
                                        </div>
                                        <div class="step">
                                            <div class="circle @(Model.HasArrivedInWarehouse ? "completed" : "pending")">
                                                4
                                            </div>
                                            <div class="label">Ombor</div>
                                        </div>
                                    </div>
                                    <br />
                                    <hr />
                                    <hr />
                                    <div class="progress-bar">
                                        <div id="progress-element" class="element" style="width: @(Model.GetProgressPercentage())%;">@(Model.GetProgressPercentage())%</div>
                                    </div>
                                    <hr />
                                    <hr />
                                    <div class="table-responsive table-responsivetable-responsive">
                                        <table class="table invoice-data-table dt-responsive nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th></th>
                                                    <th></th>
                                                    <th>Maxsulot nomi</th>
                                                    <th>Miqdori</th>
                                                    <th>Buyurtma</th>
                                                    <th>Shartnoma</th>
                                                    <th>To'lov</th>
                                                    <th>Ombor</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.Parts)
                                                {
                                                    <tr>
                                                        <td></td>
                                                        <td></td>
                                                        <td>@item.ItemName</td>
                                                        <td>@item.Amount</td>
                                                        <td>
                                                            <span class="badge @(item.OrderStatus ? "badge-light-success" : "badge-light-danger")">
                                                                <i class="bx @(item.OrderStatus ? "bx-check" : "bx-x")"></i>
                                                                @(item.OrderStatus ? "✔" : "X")
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="badge @(item.ContractStatus ? "badge-light-success" : "badge-light-danger")">
                                                                <i class="bx @(item.ContractStatus ? "bx-check" : "bx-x")"></i>
                                                                @(item.ContractStatus ? "✔" : "X")
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="badge @(item.PaymentStatus ? "badge-light-success" : "badge-light-danger")">
                                                                <i class="bx @(item.PaymentStatus ? "bx-check" : "bx-x")"></i>
                                                                @(item.PaymentStatus ? "✔" : "X")
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="badge @(item.IncomeStatus ? "badge-light-success" : "badge-light-danger")">
                                                                <i class="bx @(item.IncomeStatus ? "bx-check" : "bx-x")"></i>
                                                                @(item.IncomeStatus ? "✔" : "X")
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    <script>
        $(document).ready(function () {
            var steps = $('.step');
            var totalSteps = steps.length;

            var progressWidth = ($('.step.completed').length / totalSteps) * 100;

            $('.progress-bar').css('width', progressWidth + '%');
            $('.progress-bar').toggleClass('dashed', progressWidth < 100);
        });
    </script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    
    <script>
        $(document).ready(function () {
            // Get the progress percentage directly from the model (assuming you have a method to get it)
            var progress = '@Model.GetProgressPercentage()'; // Get progress percentage directly

            // Gradually fill the progress bar
            $('#progress-element').animate({ width: progress + '%' }, { duration: 3000 }); // 3 soniyada to'ldirish
            $('#progress-element').text(progress + '%'); // Matnni yangilash
        });

    </script>

</body>
</html>
