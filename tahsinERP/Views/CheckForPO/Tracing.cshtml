                                                                Ombor@(4)
                                                            </div>
                                                            <div class="label">
                                                                <div class="date"></div>
                                                                <div class="location">YETIB KELDI</div>
                                                            </div>
                                                        </div>
                                                        @*}*@
                                                    </div>
                                                    <div class="progress-container">
                                                        <div class="progress-bar" id="progress"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <hr>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <style>
    .wizard-container {
        position: relative;
        padding: 20px;
    }

    .wizard-header {
        display: flex;
        justify-content: space-between;
        position: relative;
    }

    .step {
        text-align: center;
        position: relative;
        z-index: 1;
        display: inline-block;
        width: calc(100% / 4;
    }

    .circle {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background-color: #bbb;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        font-weight: bold;
    }

    .step.completed .circle {
        background-color: green;
    }

    .label {
        margin-top: 10px;
        font-size: 14px;
    }

    .progress-container {
        position: absolute;
        top: 15px;
        left: 0;
        right: 0;
        height: 2px;
        background-color: #bbb;
        z-index: 0;
    }

    .progress-bar {
        height: 2px;
        background-color: green;
        width: 0;
    }

    .date {
        font-size: 12px;
        color: gray;
    }

    .location {
        font-weight: bold;
    }

    .distance {
        font-size: 12px;
        color: gray;
    }

    .progress-bar.dashed {
        background: repeating-linear-gradient(
            to right,
            green 0%,
            green 10%,
            transparent 10%,
            transparent 20%
        );
    }
        </style>

        <script>
    $(document).ready(function () {
        var steps = $('.step');
        var totalSteps = steps.length;

        var progressWidth = ($('.step.completed').length / totalSteps) * 100;

        $('#progress').css('width', progressWidth + '%');
        $('#progress').toggleClass('dashed', progressWidth < 100);
    });
        </script>
    </div>
</body>
</html>
