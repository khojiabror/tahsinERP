
@model tahsinERP.Models.PURCHASING_ITEMS
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Edit", "PurchasingItem", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/PurchasingItem/Index">Xarid qilish buyumlari</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    Xarid qilish buyumini tahrirlash
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-xl-12 col-md-12 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body pb-0 mx-20">
                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 mt-25">
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                        <hr>
                                        <div class="row my-2 py-50">
                                            <div class="col-sm-9 col-12 order-2 order-sm-1">
                                                @Html.AntiForgeryToken()
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                <hr>
                                                <h6 class="invoice-to">Item Kodi</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.ItemCode, new { @class = "form-control round"})
                                                    @Html.ValidationMessageFor(model => model.ItemCode, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">Item nomi</h6>
                                                <fieldset class="form-group">
                                                    @Html.TextBoxFor(model => model.ItemName, new { @class = "form-control round" })
                                                    @Html.ValidationMessageFor(model => model.ItemName, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">Birligini tanlang</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.DropDownListFor(model => model.UnitID, ViewBag.units as SelectList, "birligini tanlang: ", new { @class = "form-control select2" })
                                                    @Html.ValidationMessageFor(model => model.UnitID, "", new { @class = "text-danger" })
                                                </fieldset>

                                                <h6>Batafsil ma'lumot</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.Description, new { @class = "form-control round", @placeholder = "Izohlar bo'lsa yozib qolding" })
                                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                </fieldset>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-lg-12 col-md-6 mt-25">
                                                <ul class="list-group list-group-flush">
                                                    <li class="list-group-item border-0 pb-0">
                                                        <button class="btn btn-primary btn-block subtotal-preview-btn" name="create" type="submit" value="Create">
                                                            <i class='bx bx-save'></i>
                                                            Saqlash
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
