@{
    ViewBag.Title = "Tender taqqoslash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "Tender", "Index"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Tender taqqoslash
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Tender taqqoslash</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- Material Selection -->
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label for="materialSelect">Material</label>
                                            @Html.DropDownList("MaterialID", ViewBag.Materials as SelectList, "---Materialni tanlang---", new { @class = "form-control select2", @id = "materialSelect", @required = "required" })
                                            <small class="text-muted" id="materialLocked" style="display:none;">Material tanlangan va muzlatilgan</small>
                                        </div>
                                    </div>

                                    <!-- Offer Input Form -->
                                    <div class="row mb-3 border rounded p-3">
                                        <div class="col-12">
                                            <h5>Yangi taklif qo'shish</h5>
                                            <div class="row">
                                                <div class="col-md-3 form-group">
                                                    <label for="supplierName">Ta'minotchi nomi</label>
                                                    <input type="text" id="supplierName" class="form-control" placeholder="Ta'minotchi nomi" />
                                                </div>
                                                <div class="col-md-2 form-group">
                                                    <label for="offeredPrice">Taklif narxi</label>
                                                    <input type="number" id="offeredPrice" class="form-control" step="0.01" min="0" placeholder="0.00" />
                                                </div>
                                                <div class="col-md-2 form-group">
                                                    <label for="moq">MOQ</label>
                                                    <input type="number" id="moq" class="form-control" step="0.01" min="0" placeholder="0" />
                                                </div>
                                                <div class="col-md-2 form-group">
                                                    <label for="leadTime">Yetkazib berish muddati (kun)</label>
                                                    <input type="number" id="leadTime" class="form-control" min="0" placeholder="0" />
                                                </div>
                                                <div class="col-md-3 form-group">
                                                    <label for="paymentTerms">To'lov shartlari</label>
                                                    <input type="text" id="paymentTerms" class="form-control" placeholder="To'lov shartlari" />
                                                </div>
                                            </div>
                                            <div class="row mt-2">
                                                <div class="col-12">
                                                    <button type="button" class="btn btn-primary" id="addOfferBtn">
                                                        <i class="bx bx-plus"></i> Taklif qo'shish
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Offers List -->
                                    <div class="row mb-3">
                                        <div class="col-12">
                                            <h5>Takliflar ro'yxati</h5>
                                            <div class="table-responsive">
                                                <table id="offersTable" class="table table-striped table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>Ta'minotchi</th>
                                                            <th>Narx</th>
                                                            <th>MOQ</th>
                                                            <th>Yetkazib berish (kun)</th>
                                                            <th>To'lov shartlari</th>
                                                            <th>Afzal</th>
                                                            <th>Amallar</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <!-- Offers will be added here dynamically -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Comparison Chart -->
                                    <div class="row mb-3" id="chartSection" style="display:none;">
                                        <div class="col-12">
                                            <h5>Taqqoslash grafigi</h5>
                                            <canvas id="comparisonChart" height="100"></canvas>
                                        </div>
                                    </div>

                                    <!-- Export Button -->
                                    <div class="row">
                                        <div class="col-12">
                                            <button type="button" class="btn btn-success" id="exportPdfBtn" disabled>
                                                <i class="bx bx-file"></i> PDF ga eksport qilish
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Wait for jQuery to be loaded
        (function() {
            function initTenderScripts() {
                // Check if jQuery and Select2 are available
                if (typeof jQuery === 'undefined' || typeof jQuery.fn.select2 === 'undefined') {
                    // Retry after a short delay
                    setTimeout(initTenderScripts, 100);
                    return;
                }

                // Use jQuery - $ might be conflicted, so use jQuery explicitly
                var $ = jQuery;

                $(document).ready(function () {
                    // Initialize Select2
                    if (typeof $.fn.select2 !== 'undefined') {
                        $('.select2').select2();
                    }
            
                    var offers = [];
                    var selectedMaterialId = null;
                    var materialLocked = false;
                    var comparisonChart = null;

            // Lock material after first offer
            $('#materialSelect').on('change', function () {
                var materialId = $(this).val();
                if (materialId && materialId !== '') {
                    if (!materialLocked) {
                        selectedMaterialId = materialId;
                        materialLocked = true;
                        $(this).prop('disabled', true);
                        $('#materialLocked').show();
                    } else {
                        selectedMaterialId = materialId;
                    }
                }
            });

            // Add offer
            $('#addOfferBtn').on('click', function (e) {
                e.preventDefault();
                
                // Check if material is selected
                var currentMaterialId = $('#materialSelect').val();
                if (!currentMaterialId || currentMaterialId === '' || currentMaterialId === null) {
                    alert('Avval materialni tanlang');
                    $('#materialSelect').focus();
                    return false;
                }

                // If material not locked yet, lock it now
                if (!materialLocked) {
                    selectedMaterialId = currentMaterialId;
                    materialLocked = true;
                    $('#materialSelect').prop('disabled', true);
                    $('#materialLocked').show();
                }

                var supplierName = $('#supplierName').val().trim();
                var offeredPrice = parseFloat($('#offeredPrice').val()) || 0;
                var moq = parseFloat($('#moq').val()) || 0;
                var leadTime = parseInt($('#leadTime').val()) || 0;
                var paymentTerms = $('#paymentTerms').val().trim() || '';

                if (!supplierName) {
                    alert('Ta\'minotchi nomini kiriting');
                    $('#supplierName').focus();
                    return false;
                }

                var offer = {
                    id: Date.now(),
                    supplierName: supplierName,
                    price: offeredPrice,
                    moq: moq,
                    leadTime: leadTime,
                    paymentTerms: paymentTerms,
                    preferred: false
                };

                offers.push(offer);
                renderOffersTable();
                updateChart();
                clearOfferForm();
                $('#exportPdfBtn').prop('disabled', false);
                
                return false;
            });

            function renderOffersTable() {
                var tbody = $('#offersTable tbody');
                tbody.empty();

                offers.forEach(function (offer, index) {
                    var row = '<tr data-offer-id="' + offer.id + '">' +
                        '<td>' + offer.supplierName + '</td>' +
                        '<td>' + offer.price.toFixed(2) + '</td>' +
                        '<td>' + offer.moq.toFixed(2) + '</td>' +
                        '<td>' + offer.leadTime + '</td>' +
                        '<td>' + offer.paymentTerms + '</td>' +
                        '<td>' +
                            '<input type="checkbox" class="preferred-checkbox" ' + (offer.preferred ? 'checked' : '') + ' data-offer-id="' + offer.id + '" />' +
                        '</td>' +
                        '<td>' +
                            '<button type="button" class="btn btn-sm btn-danger remove-offer" data-offer-id="' + offer.id + '">' +
                                '<i class="bx bx-trash"></i>' +
                            '</button>' +
                        '</td>' +
                        '</tr>';
                    tbody.append(row);
                });
            }

            // Remove offer
            $(document).on('click', '.remove-offer', function () {
                var offerId = parseInt($(this).data('offer-id'));
                offers = offers.filter(function (o) { return o.id !== offerId; });
                renderOffersTable();
                updateChart();
                
                if (offers.length === 0) {
                    $('#exportPdfBtn').prop('disabled', true);
                    $('#chartSection').hide();
                }
            });

            // Toggle preferred
            $(document).on('change', '.preferred-checkbox', function () {
                var offerId = parseInt($(this).data('offer-id'));
                var offer = offers.find(function (o) { return o.id === offerId; });
                if (offer) {
                    offer.preferred = $(this).is(':checked');
                    updateChart();
                }
            });

            function updateChart() {
                if (offers.length === 0) {
                    $('#chartSection').hide();
                    return;
                }

                $('#chartSection').show();

                var ctx = document.getElementById('comparisonChart').getContext('2d');
                
                if (comparisonChart) {
                    comparisonChart.destroy();
                }

                var labels = offers.map(function (o) { return o.supplierName; });
                var prices = offers.map(function (o) { return o.price; });
                var leadTimes = offers.map(function (o) { return o.leadTime; });
                var preferredColors = offers.map(function (o) { return o.preferred ? 'rgba(40, 199, 111, 0.8)' : 'rgba(115, 103, 240, 0.8)'; });

                comparisonChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Narx',
                                data: prices,
                                backgroundColor: preferredColors,
                                yAxisID: 'y'
                            },
                            {
                                label: 'Yetkazib berish muddati (kun)',
                                data: leadTimes,
                                backgroundColor: 'rgba(255, 159, 64, 0.8)',
                                yAxisID: 'y1',
                                type: 'line'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                type: 'linear',
                                position: 'left',
                                title: { display: true, text: 'Narx' }
                            },
                            y1: {
                                type: 'linear',
                                position: 'right',
                                title: { display: true, text: 'Yetkazib berish muddati (kun)' },
                                grid: { drawOnChartArea: false }
                            }
                        }
                    }
                });
            }

            function clearOfferForm() {
                $('#supplierName').val('');
                $('#offeredPrice').val('');
                $('#moq').val('');
                $('#leadTime').val('');
                $('#paymentTerms').val('');
            }

            // Export to PDF
            $('#exportPdfBtn').click(function () {
                if (offers.length === 0) {
                    alert('Eksport qilish uchun kamida bitta taklif bo\'lishi kerak');
                    return;
                }

                // Simple PDF export - you can enhance this with a proper PDF library
                var printWindow = window.open('', '_blank');
                var content = '<html><head><title>Tender Taqqoslash</title></head><body>';
                content += '<h2>Tender Taqqoslash</h2>';
                content += '<table border="1" cellpadding="5" style="border-collapse: collapse; width: 100%;">';
                content += '<thead><tr><th>Ta\'minotchi</th><th>Narx</th><th>MOQ</th><th>Yetkazib berish</th><th>To\'lov shartlari</th><th>Afzal</th></tr></thead>';
                content += '<tbody>';
                
                offers.forEach(function (offer) {
                    content += '<tr>';
                    content += '<td>' + offer.supplierName + '</td>';
                    content += '<td>' + offer.price.toFixed(2) + '</td>';
                    content += '<td>' + offer.moq.toFixed(2) + '</td>';
                    content += '<td>' + offer.leadTime + ' kun</td>';
                    content += '<td>' + offer.paymentTerms + '</td>';
                    content += '<td>' + (offer.preferred ? 'Ha' : 'Yo\'q') + '</td>';
                    content += '</tr>';
                });
                
                content += '</tbody></table>';
                content += '</body></html>';
                
                printWindow.document.write(content);
                printWindow.document.close();
                printWindow.focus();

                // Wait until popup content is fully rendered before printing.
                printWindow.onload = function () {
                    setTimeout(function () {
                        printWindow.print();
                    }, 250);
                };
            });
                });
            }

            // Start initialization
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initTenderScripts);
            } else {
                initTenderScripts();
            }
        })();
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
