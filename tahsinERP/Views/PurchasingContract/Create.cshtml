@model tahsinERP.ViewModels.Purchasing.PurchasingContractViewModel
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    #file-upload-div {
        transition: background-color 1s ease;
    }

    .file-upload-success {
        background-color: lightgreen; /* or lightblue */
    }
</style>
@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/PurchasingContract/Index">Shartnomalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Shartnoma yaratish
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Create", "PurchasingContract", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form repeater-default" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            // WRHS_InComes
                                            <div class="row justify-content-around d-flex align-items-start">
                                                @*Left Part*@
                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Shartnoma raqami</h6>
                                                            @Html.TextBoxFor(model => model.ContractNo, new { @type = "text", @class = "form-control", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Buyurtmani tanlang</h6>
                                                            @Html.DropDownList("OrderID", (SelectList)ViewBag.orderList, "Buyurtmani tanlang", new { @class = "form-control select2", @id = "order-dropdown" })
                                                            @Html.ValidationMessageFor(model => model.OrderID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Ta'minotchi</h6>
                                                            @Html.TextBoxFor(model => model.Supplier, new { @class = "form-control", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.Supplier, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Valyuta</h6>
                                                            @Html.DropDownListFor(model => model.CurrencyID, ViewBag.currencies as SelectList, new { @class = "form-control select2", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                        </div>

                                                    </div>
                                                </div>

                                                @*Right Part*@
                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Incoterms</h6>
                                                            @Html.TextBoxFor(model => model.Incoterms, new { @type = "text", @class = "form-control", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.Incoterms, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">To'lov sharti</h6>
                                                            @Html.TextBoxFor(model => model.PaymentTerms, new { @type = "text", @class = "form-control", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.PaymentTerms, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="dateInput">Tuzilgan sanasi:</label>
                                                            @Html.TextBoxFor(model => model.IssueDT, new { @class = "form-control", @id = "dateInput", @name = "Date", @placeholder = "dan", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.IssueDT, "", new { @class = "text-danger" })
                                                            <div class="form-control-position mt-2">
                                                                <i class='bx bx-calendar'></i>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="dateInput">Tugaydigan sanasi:</label>
                                                            @Html.TextBoxFor(model => model.DueDT, new { @class = "form-control", @id = "dateInput", @name = "Date", @placeholder = "gacha", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.DueDT, "", new { @class = "text-danger" })
                                                            <div class="form-control-position mt-2">
                                                                <i class='bx bx-calendar'></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <br />
                                            </div>

                                            <div class="col-md-6 col-12 form-group" id="file-upload-div">
                                                <hr />
                                                <label for="file-upload" class="form-label">Shartnoma faylini yuklang</label>
                                                <div class="custom-file">
                                                    @Html.TextBoxFor(model => model.File, new { type = "file", @class = "form-control", @id = "file-upload", accept = ".pdf,.doc,.docx,.xlsx" })
                                                    @Html.ValidationMessageFor(model => model.File, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="progress mt-3 d-none" id="upload-progress">
                                                    <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%;" id="progress-bar"></div>
                                                </div>
                                                <hr />
                                            </div>
                                            <br />
                                            <h4>
                                                Maxsulotlar
                                            </h4>
                                            <div data-repeater-list="Parts">
                                                <div data-repeater-item id="repeaterItem">
                                                    <div class="row justify-content-between">
                                                        <input type="hidden" name="ID" />
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_PartID">Maxsulotni tanlang</label>
                                                            @Html.DropDownList("ItemID", (SelectList)ViewBag.items, new { @class = "form-control select", @id = "select2", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.Parts[0].ItemID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Unit">Birligi</label>
                                                            @Html.DropDownList("UnitID", (SelectList)ViewBag.units, new { @class = "form-control", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.Parts[0].UnitID, "", new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Amount">Miqdori</label>
                                                            <input type="number" name="Amount" class="form-control" id="Part_Amount" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Amount, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Price">Dona narx</label>
                                                            <input type="number" name="Price" step="0.01" class="form-control" id="Part_Price" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Price, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_TotalPrice">Umumiy narx</label>
                                                            <input type="number" name="TotalPrice" step="0.01" class="form-control" id="Part_TotalPrice" disabled="disabled" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].TotalPrice, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-1 col-sm-12 form-group d-flex align-items-center pt-2">
                                                            <button data-repeater-delete type="button" class="btn btn-danger">O`chirish</button>
                                                        </div>
                                                    </div>
                                                    <hr>
                                                </div>
                                            </div>

                                            <button data-repeater-create type="button" class="btn btn-primary">Yangi maxsulot qo`shish</button>

                                            // Save button
                                            <ul class="list-group list-group-flush">
                                                <li class="list-group-item border-0 pb-0">
                                                    <button class="btn btn-primary btn-block subtotal-preview-btn" name="create" type="submit" value="Create">
                                                        <i class='bx bx-save'></i>
                                                        Saqlash
                                                    </button>
                                                </li>
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        flatpickr("#dateInput", {
            dateFormat: "d.m.Y", // You can customize the date format
            // Optional: restricts the selection to today's date or later
            altInput: true, // Optional: creates an alternate input (more user-friendly)
            altFormat: "F j, Y", // Format displayed in alt input
            weekNumbers: true,
            showTodayButton: true,
            locale: "uz",
        });
    });
</script>
<script>
    $(document).ready(function () {
    // Trigger event when OrderID is changed
    $('#order-dropdown').on('change', function () {
        var orderId = $(this).val();
        if (orderId) {
            // Make an AJAX request to load items based on selected OrderID
            $.ajax({
                url: '@Url.Action("GetOrderItems", "PurchasingContract")',
                type: 'GET',
                data: { orderId: orderId },
                success: function (response) {
                    // Clear existing repeater items
                    $('[data-repeater-list="Parts"]').empty();

                    // Populate the repeater with new items from response
                    response.forEach(function (item, index) {
                        // Create Item dropdown options
                        var itemOptions = '';
                        item.Items.forEach(function (itemOption) {
                            itemOptions += `<option value="${itemOption.ID}" ${itemOption.ID === item.ItemID ? 'selected' : ''}>${itemOption.ItemName}</option>`;
                        });

                        // Create Unit dropdown options
                        var unitOptions = '';
                        item.Units.forEach(function (unitOption) {
                            unitOptions += `<option value="${unitOption.ID}" ${unitOption.ID === item.UnitID ? 'selected' : ''}>${unitOption.ShortName}</option>`;
                        });

                        // Append new repeater item with populated dropdowns
                        var newItem = `
                        <div data-repeater-item id="repeaterItem">
                            <div class="row justify-content-between">
                                <input type="hidden" name="Parts[${index}].ID" value="${item.ID}" />

                                <!-- ItemName Dropdown (Predmetni tanlang) -->
                                <div class="col-md-2 col-sm-12 form-group">
                                    <label for="Part_PartID">Predmetni tanlang</label>
                                    <select name="Parts[${index}].ItemID" class="form-control">
                                        ${itemOptions}
                                    </select>
                                </div>

                                <!-- UnitName Dropdown (Birligi) -->
                                <div class="col-md-2 col-sm-12 form-group">
                                    <label for="Part_Unit">Birligi</label>
                                    <select name="Parts[${index}].UnitID" class="form-control">
                                        ${unitOptions}
                                    </select>
                                </div>

                                <!-- Other fields (Amount, Price, etc.) -->
                                <!-- Amount -->
                                <div class="col-md-2 col-sm-12 form-group">
                                    <label for="Part_Amount">Miqdori</label>
                                    <input type="number" name="Parts[${index}].Amount" value="${item.Amount}" class="form-control" />
                                </div>
                                <!-- Price -->
                                <div class="col-md-2 col-sm-12 form-group">
                                    <label for="Part_Price">Dona narxi</label>
                                    <input type="number" name="Parts[${index}].Price" value="${item.Price}" class="form-control" step="0.01" />
                                </div>
                                <!-- TotalPrice (disabled) -->
                                <div class="col-md-2 col-sm-12 form-group">
                                    <label for="Part_TotalPrice">Umumiy narxi</label>
                                    <input type="number" name="Parts[${index}].TotalPrice" value="${item.TotalPrice}" class="form-control" step="0.01" disabled="disabled" />
                                </div>

                                <!-- Delete Button -->
                                <div class="col-md-1 col-sm-12 form-group d-flex align-items-center pt-2">
                                    <button data-repeater-delete type="button" class="btn btn-danger">O'chirish</button>
                                </div>
                            </div>
                            <hr>
                        </div>`;

                        // Append the new item to the repeater list
                        $('[data-repeater-list="Parts"]').append(newItem);
                    });

                },
                error: function () {
                    alert('Error loading order items.');
                }
            });
        }
    });
});

</script>

<script>
    document.getElementById('file-upload').addEventListener('change', function () {
        if (this.files && this.files.length > 0) {
            document.getElementById('file-upload-div').classList.add('file-upload-success');
        }
    });

</script>