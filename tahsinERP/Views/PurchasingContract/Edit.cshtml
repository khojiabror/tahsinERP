
@model tahsinERP.ViewModels.Purchasing.PurchasingContractViewModel

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Edit", "PurchasingContract", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ID) <!-- Hidden field for ID -->

        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/PurchasingContract/Index">Xarid Shartnomalar</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            Shartnoma sahifasi
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <div class="row">
                        <!-- invoice view page -->
                        <div class="col-xl-12 col-md-8 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row justify-content-around d-flex align-items-start">
                                            <div class="col-lg-6 col-sm-12">
                                                <div class="row">
                                                    <div class="col-md-6 col-12 form-group">
                                                        <h6 class="invoice-to">Shartnoma raqami</h6>
                                                        @Html.TextBoxFor(model => model.ContractNo, new { @type = "text", @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-6 col-12 form-group">
                                                        <h6 class="invoice-to">Ta'minotchi</h6>
                                                        @Html.TextBoxFor(model => model.Supplier, new { @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.Supplier, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="form-group position-relative has-icon-left">
                                                        <label>Tuzilgan sanasi</label>
                                                        @Html.TextBoxFor(model => model.IssueDT, new { @class = "form-control pickadate-months-year round", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.IssueDT, "", new { @class = "text-danger" })
                                                        <div class="form-control-position mt-2">
                                                            <i class='bx bx-calendar'></i>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-12 form-group">
                                                        <h6 class="invoice-to">Izoh</h6>
                                                        @Html.TextAreaFor(model => model.Comment, new { @type = "text", @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.Comment, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-6 col-12 form-group">
                                                        <h6 class="invoice-to">Valyuta</h6>
                                                        @Html.DropDownListFor(model => model.CurrencyID, ViewBag.currencies as SelectList,new {  @class = "form-control select2", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                    </div>

                                                </div>
                                            </div>

                                            @*Right Part*@
                                            <div class="col-lg-6 col-sm-12">
                                                <div class="row">
                                                    <div class="col-md-6 col-12 form-group">
                                                        <h6 class="invoice-to">Incoterms</h6>
                                                        @Html.TextBoxFor(model => model.Incoterms, new { @type = "text", @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.Incoterms, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-6 col-12 form-group">
                                                        <h6 class="invoice-to">To'lov sharti</h6>
                                                        @Html.TextBoxFor(model => model.PaymentTerms, new { @type = "text", @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.PaymentTerms, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="form-group position-relative has-icon-left">
                                                        <label>Tugaydigan sanasi</label>
                                                        @Html.TextBoxFor(model => model.DueDT, new { @class = "form-control pickadate-months-year round", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.DueDT, "", new { @class = "text-danger" })
                                                        <div class="form-control-position mt-2">
                                                            <i class='bx bx-calendar'></i>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-12 form-group">
                                                        <h6 class="invoice-to">Umumiy miqdori</h6>
                                                        @Html.TextBoxFor(model => model.Amount, new { @type = "text", @class = "form-control", @required = "required", disabled="disabled" })
                                                        @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <section id="column-selectors">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="card">
                                                    <div class="card-header">
                                                        <h4 class="card-title">Buyurtma predmeti</h4>
                                                    </div>
                                                    <div class="card-content">
                                                        <div class="card-body card-dashboard">
                                                            <div class="table-responsive">
                                                                <table class="table table-striped dataex-html5-selectors" style="width:100%">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Maxsulot nomi</th>
                                                                            <th>Birlik narxi</th>
                                                                            <th>Miqdori</th>
                                                                            <th>MOQ</th>
                                                                            <th>Umumiy summasi</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @for (int i = 0; i < Model.Parts.Count; i++)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    <a href="~/PurchasingItem/Details/@Model.Parts[i].ItemID">@Model.Parts[i].ItemName</a>
                                                                                    @Html.HiddenFor(model => model.Parts[i].ItemID)
                                                                                    @Html.HiddenFor(model => model.Parts[i].ID)
                                                                                </td>
                                                                                <td>
                                                                                    @Html.TextBoxFor(model => model.Parts[i].Price, new { @class = "form-control" })
                                                                                </td>
                                                                                <td>
                                                                                    @Html.TextBoxFor(model => model.Parts[i].Amount, new { @class = "form-control" })
                                                                                </td>
                                                                                <td>@Html.TextBoxFor(model => model.Parts[i].MOQ, new { @class = "form-control" })</td>@*
                                                                                <td>@Html.DropDownListFor(model => model.Parts[i].UnitID, ViewBag.units as SelectList, new { @class = "form-control select2"})</td>*@
                                                                                <td>@Html.DisplayFor(model => model.Parts[i].TotalPrice, new { @class = "form-control"})</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item border-0 pb-0">
                                            <button class="btn btn-primary btn-block subtotal-preview-btn" name="edit" type="submit" value="Edit">
                                                <i class='bx bx-save'></i>
                                                Saqlash
                                            </button>
                                        </li>
                                    </ul>
                                    <hr>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
