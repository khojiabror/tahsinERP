@model tahsinERP.ViewModels.Finance.OpeningBalanceViewModel
@using System.Linq
@{
    ViewBag.Title = L.T("Fin_OpeningDetailsTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "OpeningBalance")">@L.T("Fin_OpeningBalance")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Details")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">@L.T("Fin_OpeningDetailsHeader")</h4>
                    </div>
                    <div class="card-content">
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <p><strong>@L.T("Date"):</strong> @Model.SnapshotDate.ToString("yyyy-MM-dd")</p>
                                </div>
                            </div>

                            <h5 class="mb-1">@L.T("Fin_ArTitle")</h5>
                            <div class="table-responsive mb-2">
                                <table class="table table-bordered table-sm">
                                    <thead><tr><th>@L.T("Fin_Customer")</th><th>@L.T("Fin_Contract")</th><th class="text-right">@L.T("Fin_TotalAmt")</th><th class="text-right">@L.T("Fin_Received")</th><th class="text-right">@L.T("Fin_Balance")</th></tr></thead>
                                    <tbody>
                                        @if (Model.CustomerReceivableLines != null && Model.CustomerReceivableLines.Any())
                                        {
                                            foreach (var x in Model.CustomerReceivableLines)
                                            {
                                                <tr><td>@x.CounterpartyName</td><td>@x.ContractNo</td><td class="text-right">@x.TotalAmount.ToString("N2")</td><td class="text-right">@x.PaidAmount.ToString("N2")</td><td class="text-right">@x.Amount.ToString("N2")</td></tr>
                                            }
                                        }
                                        else { <tr><td colspan="5" class="text-center text-muted">@L.T("No")</td></tr> }
                                    </tbody>
                                </table>
                            </div>

                            <h5 class="mb-1">@L.T("Fin_ApTitle")</h5>
                            <div class="table-responsive mb-2">
                                <table class="table table-bordered table-sm">
                                    <thead><tr><th>@L.T("Fin_Supplier")</th><th>@L.T("Fin_Contract")</th><th class="text-right">@L.T("Fin_TotalAmt")</th><th class="text-right">@L.T("Fin_Paid")</th><th class="text-right">@L.T("Fin_Balance")</th></tr></thead>
                                    <tbody>
                                        @if (Model.SupplierPayableLines != null && Model.SupplierPayableLines.Any())
                                        {
                                            foreach (var x in Model.SupplierPayableLines)
                                            {
                                                <tr><td>@x.CounterpartyName</td><td>@x.ContractNo</td><td class="text-right">@x.TotalAmount.ToString("N2")</td><td class="text-right">@x.PaidAmount.ToString("N2")</td><td class="text-right">@x.Amount.ToString("N2")</td></tr>
                                            }
                                        }
                                        else { <tr><td colspan="5" class="text-center text-muted">@L.T("No")</td></tr> }
                                    </tbody>
                                </table>
                            </div>

                            <h5 class="mb-1">@L.T("Fin_PayrollDebtTitle")</h5>
                            <div class="table-responsive mb-2">
                                <table class="table table-bordered table-sm">
                                    <thead><tr><th>@L.T("Fin_Employee")</th><th class="text-right">@L.T("Fin_Accrued")</th><th class="text-right">@L.T("Fin_Paid")</th><th class="text-right">@L.T("Fin_Balance")</th></tr></thead>
                                    <tbody>
                                        @if (Model.EmployeePayrollLines != null && Model.EmployeePayrollLines.Any())
                                        {
                                            foreach (var x in Model.EmployeePayrollLines)
                                            {
                                                <tr><td>@x.EmployeeName</td><td class="text-right">@x.TotalAmount.ToString("N2")</td><td class="text-right">@x.PaidAmount.ToString("N2")</td><td class="text-right">@x.Amount.ToString("N2")</td></tr>
                                            }
                                        }
                                        else { <tr><td colspan="4" class="text-center text-muted">@L.T("No")</td></tr> }
                                    </tbody>
                                </table>
                            </div>

                            <h5 class="mb-1">@L.T("Fin_LogisticsDebtTitle")</h5>
                            <div class="table-responsive mb-2">
                                <table class="table table-bordered table-sm">
                                    <thead><tr><th>@L.T("Fin_Forwarder")</th><th>@L.T("Fin_Contract")</th><th class="text-right">@L.T("Fin_TotalAmt")</th><th class="text-right">@L.T("Fin_Paid")</th><th class="text-right">@L.T("Fin_Balance")</th></tr></thead>
                                    <tbody>
                                        @if (Model.ForwarderPayableLines != null && Model.ForwarderPayableLines.Any())
                                        {
                                            foreach (var x in Model.ForwarderPayableLines)
                                            {
                                                <tr><td>@x.CounterpartyName</td><td>@x.ContractNo</td><td class="text-right">@x.TotalAmount.ToString("N2")</td><td class="text-right">@x.PaidAmount.ToString("N2")</td><td class="text-right">@x.Amount.ToString("N2")</td></tr>
                                            }
                                        }
                                        else { <tr><td colspan="5" class="text-center text-muted">@L.T("No")</td></tr> }
                                    </tbody>
                                </table>
                            </div>

                            <h5 class="mb-1">@L.T("Fin_OtherBalanceCategories")</h5>
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>@L.T("Category")</th>
                                            <th>@L.T("Type")</th>
                                            <th class="text-right">@L.T("Fin_AmountOf")</th>
                                            <th>@L.T("Currency")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Items != null && Model.Items.Any())
                                        {
                                            foreach (var item in Model.Items)
                                            {
                                                <tr>
                                                    <td>@item.CategoryName</td>
                                                    <td>@item.TypeName</td>
                                                    <td class="text-right">@item.Amount.ToString("N2")</td>
                                                    <td>@item.CurrencyShortname</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="4" class="text-center text-muted">@L.T("No")</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <h5 class="mb-1">@L.T("Fin_OpeningByAccounts")</h5>
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered table-sm">
                                    <thead>
                                        <tr>
                                            <th>@L.T("Fin_Account")</th>
                                            <th>@L.T("Category")</th>
                                            <th class="text-right">@L.T("Fin_OpeningBalanceAmount")</th>
                                            <th>@L.T("Currency")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in Model.AccountItems.Where(x => x.Amount.HasValue))
                                        {
                                            <tr>
                                                <td>@a.AccountName</td>
                                                <td>@a.CategoryName</td>
                                                <td class="text-right">@a.Amount.Value.ToString("N2")</td>
                                                <td>@a.CurrencyShortname</td>
                                            </tr>
                                        }
                                        @if (!Model.AccountItems.Any(x => x.Amount.HasValue))
                                        {
                                            <tr><td colspan="4" class="text-center text-muted">@L.T("Fin_NotEntered")</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <a href="@Url.Action("Index", "OpeningBalance")" class="btn btn-secondary mt-2">@L.T("Fin_ToList")</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
