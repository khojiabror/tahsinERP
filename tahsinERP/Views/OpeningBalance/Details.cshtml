@model tahsinERP.ViewModels.Finance.OpeningBalanceViewModel
@using System.Linq
@{
    ViewBag.Title = "Opening balans — batafsil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "OpeningBalance")">Opening balans</a></li>
                                    <li class="breadcrumb-item active">Batafsil</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Opening balans — batafsil ko'rinish</h4>
                    </div>
                    <div class="card-content">
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <p><strong>Sana:</strong> @Model.SnapshotDate.ToString("yyyy-MM-dd")</p>
                                </div>
                            </div>

                            <h5 class="mb-1">Mijozlardan haqqimiz (AR)</h5>
                            <div class="table-responsive mb-2">
                                <table class="table table-bordered table-sm">
                                    <thead><tr><th>Mijoz</th><th>Shartnoma</th><th class="text-right">Umumiy</th><th class="text-right">Olingan</th><th class="text-right">Qoldiq</th></tr></thead>
                                    <tbody>
                                        @if (Model.CustomerReceivableLines != null && Model.CustomerReceivableLines.Any())
                                        {
                                            foreach (var x in Model.CustomerReceivableLines)
                                            {
                                                <tr><td>@x.CounterpartyName</td><td>@x.ContractNo</td><td class="text-right">@x.TotalAmount.ToString("N2")</td><td class="text-right">@x.PaidAmount.ToString("N2")</td><td class="text-right">@x.Amount.ToString("N2")</td></tr>
                                            }
                                        }
                                        else { <tr><td colspan="5" class="text-center text-muted">Yo'q</td></tr> }
                                    </tbody>
                                </table>
                            </div>

                            <h5 class="mb-1">Ta'minotchilardan qarzimiz (AP)</h5>
                            <div class="table-responsive mb-2">
                                <table class="table table-bordered table-sm">
                                    <thead><tr><th>Ta'minotchi</th><th>Shartnoma</th><th class="text-right">Umumiy</th><th class="text-right">To'langan</th><th class="text-right">Qoldiq</th></tr></thead>
                                    <tbody>
                                        @if (Model.SupplierPayableLines != null && Model.SupplierPayableLines.Any())
                                        {
                                            foreach (var x in Model.SupplierPayableLines)
                                            {
                                                <tr><td>@x.CounterpartyName</td><td>@x.ContractNo</td><td class="text-right">@x.TotalAmount.ToString("N2")</td><td class="text-right">@x.PaidAmount.ToString("N2")</td><td class="text-right">@x.Amount.ToString("N2")</td></tr>
                                            }
                                        }
                                        else { <tr><td colspan="5" class="text-center text-muted">Yo'q</td></tr> }
                                    </tbody>
                                </table>
                            </div>

                            <h5 class="mb-1">Oylikdan qarzimiz (HRM)</h5>
                            <div class="table-responsive mb-2">
                                <table class="table table-bordered table-sm">
                                    <thead><tr><th>Xodim</th><th class="text-right">Hisoblangan</th><th class="text-right">To'langan</th><th class="text-right">Qoldiq</th></tr></thead>
                                    <tbody>
                                        @if (Model.EmployeePayrollLines != null && Model.EmployeePayrollLines.Any())
                                        {
                                            foreach (var x in Model.EmployeePayrollLines)
                                            {
                                                <tr><td>@x.EmployeeName</td><td class="text-right">@x.TotalAmount.ToString("N2")</td><td class="text-right">@x.PaidAmount.ToString("N2")</td><td class="text-right">@x.Amount.ToString("N2")</td></tr>
                                            }
                                        }
                                        else { <tr><td colspan="4" class="text-center text-muted">Yo'q</td></tr> }
                                    </tbody>
                                </table>
                            </div>

                            <h5 class="mb-1">Logistikadan qarzimiz</h5>
                            <div class="table-responsive mb-2">
                                <table class="table table-bordered table-sm">
                                    <thead><tr><th>Ekspeditor</th><th>Shartnoma</th><th class="text-right">Umumiy</th><th class="text-right">To'langan</th><th class="text-right">Qoldiq</th></tr></thead>
                                    <tbody>
                                        @if (Model.ForwarderPayableLines != null && Model.ForwarderPayableLines.Any())
                                        {
                                            foreach (var x in Model.ForwarderPayableLines)
                                            {
                                                <tr><td>@x.CounterpartyName</td><td>@x.ContractNo</td><td class="text-right">@x.TotalAmount.ToString("N2")</td><td class="text-right">@x.PaidAmount.ToString("N2")</td><td class="text-right">@x.Amount.ToString("N2")</td></tr>
                                            }
                                        }
                                        else { <tr><td colspan="5" class="text-center text-muted">Yo'q</td></tr> }
                                    </tbody>
                                </table>
                            </div>

                            <h5 class="mb-1">Boshqa balans kategoriyalari</h5>
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Kategoriya</th>
                                            <th>Turi</th>
                                            <th class="text-right">Summasi</th>
                                            <th>Valyuta</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Items != null && Model.Items.Any())
                                        {
                                            foreach (var item in Model.Items)
                                            {
                                                <tr>
                                                    <td>@item.CategoryName</td>
                                                    <td>@item.TypeName</td>
                                                    <td class="text-right">@item.Amount.ToString("N2")</td>
                                                    <td>@item.CurrencyShortname</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="4" class="text-center text-muted">Yo'q</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <a href="@Url.Action("Index", "OpeningBalance")" class="btn btn-secondary mt-2">Ro'yxatga</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
