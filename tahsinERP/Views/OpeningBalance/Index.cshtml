@model tahsinERP.ViewModels.Finance.OpeningBalanceViewModel

@{
    ViewBag.Title = "Opening balans";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinBalanceCategories"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">Moliya</li>
                                    <li class="breadcrumb-item active">Opening balans</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Opening balans - boshlang'ich qoldiqlar</h4>
                    </div>
                    <div class="card-content">
                        <div class="card-body">
                            @if (TempData["Success"] != null)
                            {
                                <div class="alert alert-success">@TempData["Success"]</div>
                            }

                            @using (Html.BeginForm("Index", "OpeningBalance", FormMethod.Post, new { @class = "form" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="row mb-2">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="control-label">Opening sana *</label>
                                            @Html.TextBoxFor(m => m.SnapshotDate, new
                                            {
                                                @class = "form-control",
                                                type = "date",
                                                required = "required",
                                                Value = Model.SnapshotDate.ToString("yyyy-MM-dd")
                                            })
                                            <small class="text-muted">Bu sanaga nisbatan barcha balanslar birinchi marta kiritiladi.</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3 d-flex align-items-end">
                                        <div class="form-group">
                                            <button type="button" id="btnLoadOpeningByDate" class="btn btn-info">
                                                Load qilish
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Kategoriya</th>
                                                <th>Turi</th>
                                                <th class="text-right">Summasi</th>
                                                <th>Valyuta</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Model.Items.Count; i++)
                                            {
                                                var item = Model.Items[i];
                                                <tr>
                                                    @Html.HiddenFor(m => m.Items[i].CategoryID)
                                                    @Html.HiddenFor(m => m.Items[i].Type)
                                                    <td>@Model.Items[i].CategoryName</td>
                                                    <td>@Model.Items[i].TypeName</td>
                                                    <td class="text-right">
                                                        @Html.TextBoxFor(m => m.Items[i].Amount, new
                                                        {
                                                            @class = "form-control text-right",
                                                            type = "number",
                                                            step = "0.01"
                                                        })
                                                    </td>
                                                    <td>
                                                        @Html.DropDownListFor(m => m.Items[i].CurrencyID,
                                                            Model.CurrencyList,
                                                            new { @class = "form-control" })
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="form-actions mt-2">
                                    <button type="submit" class="btn btn-primary">Saqlash</button>
                                    <a href="@Url.Action("Index", new { snapshotDate = Model.SnapshotDate.ToString("yyyy-MM-dd") })" class="btn btn-secondary">Yangilash</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@section scripts
{
    <script type="text/javascript">
        (function () {
            var loadBtn = document.getElementById('btnLoadOpeningByDate');
            var dateInput = document.getElementById('SnapshotDate');
            if (!loadBtn || !dateInput) return;

            loadBtn.addEventListener('click', function () {
                var dateValue = dateInput.value;
                if (!dateValue) {
                    alert('Avval sana tanlang.');
                    return;
                }
                var baseUrl = '@Url.Action("Index", "OpeningBalance")';
                window.location.href = baseUrl + '?snapshotDate=' + encodeURIComponent(dateValue);
            });
        })();
    </script>
}

