@using System
@model System.Collections.Generic.List<tahsinERP.ViewModels.Finance.OpeningBalanceDateRow>

@{
    ViewBag.Title = L.T("Fin_OpeningBalance");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canChange = ViewBag.CanChange as bool? ?? false;
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">@Html.Link(L.T("Menu_Finance"), "FinDashboard", "FinancialOverview")</li>
                                    <li class="breadcrumb-item active">@L.T("Fin_OpeningBalance")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                        <h4 class="card-title mb-0">@L.T("Fin_OpeningDates")</h4>
                        @if (canChange)
                        {
                            <a href="@Url.Action("Edit", "OpeningBalance", new { snapshotDate = DateTime.Today.ToString("yyyy-MM-dd") })" class="btn btn-primary btn-sm mt-1 mt-md-0">
                                @L.T("Fin_NewEditToday")
                            </a>
                        }
                    </div>
                    <div class="card-content">
                        <div class="card-body">
                            @if (TempData["Success"] != null)
                            {
                                <div class="alert alert-success">@TempData["Success"]</div>
                            }
                            @if (TempData["Error"] != null)
                            {
                                <div class="alert alert-danger">@TempData["Error"]</div>
                            }

                            @if (Model == null || !Model.Any())
                            {
                                <p class="text-muted">@L.T("Fin_NoOpeningYet")</p>
                                if (canChange)
                                {
                                    <p><a href="@Url.Action("Edit", "OpeningBalance", new { snapshotDate = DateTime.Today.ToString("yyyy-MM-dd") })" class="btn btn-outline-primary">@L.T("Fin_Begin")</a></p>
                                }
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Date")</th>
                                                <th class="text-right">@L.T("Fin_LineCount")</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in Model)
                                            {
                                                var d = row.SnapshotDate.ToString("yyyy-MM-dd");
                                                <tr>
                                                    <td>@row.SnapshotDate.ToString("yyyy-MM-dd")</td>
                                                    <td class="text-right">@row.LineCount</td>
                                                    <td class="text-nowrap">
                                                        <a href="@Url.Action("Details", "OpeningBalance", new { snapshotDate = d })" class="btn btn-sm btn-outline-info">
                                                            @L.T("Details")
                                                        </a>
                                                        <a href="@Url.Action("Edit", "OpeningBalance", new { snapshotDate = d })" class="btn btn-sm btn-outline-primary">
                                                            @(canChange ? L.T("Fin_EditShort") : L.T("View"))
                                                        </a>
                                                        @if (canChange)
                                                        {
                                                            <a href="@Url.Action("Delete", "OpeningBalance", new { snapshotDate = d })" class="btn btn-sm btn-outline-danger">@L.T("Delete")</a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
