@model List<tahsinERP.Controllers.Finance.PlItemTreeItem>

@{
    ViewBag.Title = "P&L elementlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "FinPlItems"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinPlItems");
    
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item">Moliya</li>
                                    <li class="breadcrumb-item active">P&L elementlar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <button type="button" class="btn btn-outline-success mr-1 mb-1" onclick="window.location.href='/FinPlItems/Create';">
                                <span class="align-middle ml-25">P&L element qo'shish</span>
                            </button>
                        </div>
                    }
                    
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="plItemsTable" class="table table-striped table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Kod</th>
                                                <th>Nomi</th>
                                                <th>Belgi</th>
                                                <th>Ota element</th>
                                                <th>Tartib</th>
                                                <th>Holati</th>
                                                @if (changePermit)
                                                {
                                                    <th>Amallar</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var treeItem in Model)
                                            {
                                                @RenderItemRow(treeItem, 0, changePermit)
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                var changePermit = @(changePermit ? "true" : "false");
                
                var columnDefs = [
                    { "className": "text-center", "targets": [0, 1, 2, 3, 4, 5] }
                ];
                if (changePermit) {
                    columnDefs.push({ "orderable": false, "targets": -1, "className": "text-center" });
                }
                
                $('#plItemsTable').DataTable({
                    "language": {
                        "search": "Qidirish:",
                        "lengthMenu": "_MENU_ ta ko'rsatish",
                        "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                        "infoEmpty": "Yozuvlar yo'q",
                        "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                        "paginate": {
                            "first": "Birinchi",
                            "last": "Oxirgi",
                            "next": "Keyingi",
                            "previous": "Oldingi"
                        },
                        "zeroRecords": "Ma'lumot topilmadi"
                    },
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Barchasi"]],
                    "order": [[0, "asc"]],
                    "columnDefs": columnDefs,
                    "dom": 'lBfrtip',
                    "pagingType": "full_numbers",
                    "buttons": [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bx bxs-file-excel"></i> Excel',
                            titleAttr: 'Excelga yuklash',
                            className: 'btn btn-success mr-1',
                            filename: function () {
                                var now = new Date();
                                var dateStr = now.getFullYear() + 
                                    String(now.getMonth() + 1).padStart(2, '0') + 
                                    String(now.getDate()).padStart(2, '0') + '_' +
                                    String(now.getHours()).padStart(2, '0') + 
                                    String(now.getMinutes()).padStart(2, '0') + 
                                    String(now.getSeconds()).padStart(2, '0');
                                return 'FinPlItems_' + dateStr;
                            },
                            exportOptions: {
                                columns: changePermit ? ':not(:last-child)' : ':visible',
                                format: {
                                    body: function (data, row, column, node) {
                                        return data.replace(/<[^>]*>/g, '').trim();
                                    }
                                }
                            }
                        }
                    ]
                });
            });
        </script>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@helper RenderItemRow(tahsinERP.Controllers.Finance.PlItemTreeItem treeItem, int level, bool changePermit)
{
    var item = treeItem.Item;
    var indent = level * 20;
    <tr>
        <td style="padding-left: @(indent)px;">
            @if (level > 0)
            {
                <i class="bx bx-right-arrow-alt"></i>
            }
            @item.Code
        </td>
        <td>
            <a href="@Url.Action("Details", new { id = item.ID })">@item.Name</a>
        </td>
        <td>
            @if (item.Sign == 1)
            { <span class="badge badge-success">+ (Musbat)</span> }
            else
            { <span class="badge badge-danger">- (Manfiy)</span> }
        </td>
        <td>@(item.FIN_PL_ITEMS2?.Name ?? "-")</td>
        <td>@item.SortOrder</td>
        <td>
            @if (item.IsActive)
            { <span class="badge badge-success">Faol</span> }
            else
            { <span class="badge badge-danger">Nofaol</span> }
        </td>
        @if (changePermit)
        {
            <td class="text-center">
                <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-outline-info" title="Ko'rish">
                    <i class="bx bx-show"></i>
                </a>
                <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-outline-primary" title="Tahrirlash">
                    <i class="bx bx-edit"></i>
                </a>
                <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-outline-danger" title="O'chirish">
                    <i class="bx bx-trash"></i>
                </a>
                <a href="@Url.Action("MapCategories", new { id = item.ID })" class="btn btn-sm btn-outline-warning" title="Kategoriyalarni bog'lash">
                    <i class="bx bx-link"></i>
                </a>
                <a href="@Url.Action("Create", new { parentID = item.ID })" class="btn btn-sm btn-outline-success" title="Kichik element qo'shish">
                    <i class="bx bx-plus-circle"></i>
                </a>
            </td>
        }
    </tr>
    if (treeItem.Children != null && treeItem.Children.Any())
    {
        foreach (var child in treeItem.Children)
        {
            @RenderItemRow(child, level + 1, changePermit)
        }
    }
}
