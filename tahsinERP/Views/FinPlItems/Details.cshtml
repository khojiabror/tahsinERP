@model tahsinERP.Models.FIN_PL_ITEMS

@{
    ViewBag.Title = L.T("Fin_PlItemDetails");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'dagi [Permission] filtrida tekshiriladi (FIN-M04) *@
@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "FinPlItems");
}

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/FinPlItems">@L.T("Fin_PlItems")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Fin_Details")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Fin_PlItemDetails")</h4>
                                @if (changePermit)
                                {
                                    <div class="heading-elements">
                                        <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-sm btn-primary">@L.T("Edit")</a>
                                        <a href="@Url.Action("Delete", new { id = Model.ID })" class="btn btn-sm btn-danger">@L.T("Delete")</a>
                                        <a href="@Url.Action("MapCategories", new { id = Model.ID })" class="btn btn-sm btn-info">@L.T("Fin_MapCategories")</a>
                                    </div>
                                }
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <dl class="row">
                                        <dt class="col-sm-4">@L.T("Code"):</dt>
                                        <dd class="col-sm-8">@(Model.Code ?? "-")</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Name"):</dt>
                                        <dd class="col-sm-8">@Model.Name</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_Sign"):</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.Sign == 1)
                                            { <span class="badge badge-success">+ (@L.T("Fin_Positive"))</span> }
                                            else
                                            { <span class="badge badge-danger">- (@L.T("Fin_Negative"))</span> }
                                        </dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_ParentItem"):</dt>
                                        <dd class="col-sm-8">@(Model.FIN_PL_ITEMS2?.Name ?? "-")</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_SortOrder"):</dt>
                                        <dd class="col-sm-8">@Model.SortOrder</dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_State"):</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.IsActive)
                                            { <span class="badge badge-success">@L.T("Active")</span> }
                                            else
                                            { <span class="badge badge-danger">@L.T("Inactive")</span> }
                                        </dd>
                                        
                                        <dt class="col-sm-4">@L.T("Fin_PlanCount"):</dt>
                                        <dd class="col-sm-8">@L.T("Fin_CountPcs", ViewBag.PlanCount)</dd>
                                    </dl>
                                    
                                    @if (ViewBag.ChildItems != null && ((List<tahsinERP.Models.FIN_PL_ITEMS>)ViewBag.ChildItems).Any())
                                    {
                                        <h5 class="mt-3">@L.T("Fin_SubItems"):</h5>
                                        <ul>
                                            @foreach (var child in (List<tahsinERP.Models.FIN_PL_ITEMS>)ViewBag.ChildItems)
                                            {
                                                <li><a href="@Url.Action("Details", new { id = child.ID })">@child.Name</a></li>
                                            }
                                        </ul>
                                    }
                                    
                                    @if (ViewBag.MappedCategories != null && ((List<tahsinERP.Models.FIN_CATEGORIES>)ViewBag.MappedCategories).Any())
                                    {
                                        <h5 class="mt-3">@L.T("Fin_MappedCategories"):</h5>
                                        <ul>
                                            @foreach (var category in (List<tahsinERP.Models.FIN_CATEGORIES>)ViewBag.MappedCategories)
                                            {
                                                <li>@category.Name</li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
