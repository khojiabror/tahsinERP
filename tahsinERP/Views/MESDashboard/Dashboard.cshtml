@model tahsinERP.ViewModels.MESDashboardViewModel
@using System.Web.Helpers
@{
    ViewBag.Title = L.T("Menu_DashMes");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">@L.T("Menu_DashMes")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <form method="get" action="@Url.Action("Dashboard")" class="row">
                                        <div class="col-md-3 col-12">
                                            <label>@L.T("Mes_Year")</label>
                                            <select name="year" class="form-control">
                                                @foreach (var y in Enumerable.Range(DateTime.Now.Year - 5, 7))
                                                {
                                                    <option value="@y" @(ViewBag.SelectedYear == y ? "selected" : "")>@y</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3 col-12">
                                            <label>@L.T("Mes_Month")</label>
                                            <select name="month" class="form-control">
                                                <option value="">@L.T("Select")</option>
                                                @for (int m = 1; m <= 12; m++)
                                                {
                                                    <option value="@m" @(ViewBag.SelectedMonth != null && ViewBag.SelectedMonth == m ? "selected" : "")>@m</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3 col-12">
                                            <label>@L.T("Mes_Dash_Day")</label>
                                            <select name="day" class="form-control">
                                                <option value="">@L.T("Select")</option>
                                                @for (int d = 1; d <= 31; d++)
                                                {
                                                    <option value="@d" @(ViewBag.SelectedDay != null && ViewBag.SelectedDay == d ? "selected" : "")>@d</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3 col-12 d-flex align-items-end">
                                            <button type="submit" class="btn btn-primary w-100">
                                                <i class="bx bx-filter"></i> @L.T("Mes_Show")
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KPI Cards -->
                <div class="row">
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="media-body text-left">
                                            <h3 class="primary">@Model.TodayPlanned.ToString("N2")</h3>
                                            <span>@L.T("Mes_Dash_PeriodPlan", (string)ViewBag.PrimaryLabel ?? L.T("Mes_Dash_SelectedPeriod"))</span>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="bx bx-calendar primary font-large-2 float-right"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="media-body text-left">
                                            <h3 class="success">@Model.TodayActual.ToString("N2")</h3>
                                            <span>@L.T("Mes_Dash_PeriodFact", (string)ViewBag.PrimaryLabel ?? L.T("Mes_Dash_SelectedPeriod"))</span>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="bx bx-check-circle success font-large-2 float-right"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="media-body text-left">
                                            <h3 class="@(Model.TodayPlanVsActualPercent >= 100 ? "success" : "warning")">@Model.TodayPlanVsActualPercent.ToString("N1")%</h3>
                                            <span>@L.T("Mes_Dash_PeriodPlanVsFact", (string)ViewBag.PrimaryLabel ?? L.T("Mes_Dash_SelectedPeriod"))</span>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="bx bx-trending-up @(Model.TodayPlanVsActualPercent >= 100 ? "success" : "warning") font-large-2 float-right"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="media-body text-left">
                                            <h3 class="@(Model.MonthPlanVsActualPercent >= 100 ? "success" : "warning")">@Model.MonthPlanVsActualPercent.ToString("N1")%</h3>
                                            <span>@L.T("Mes_Dash_PeriodPlanVsFact", (string)ViewBag.SecondaryLabel ?? L.T("Mes_Dash_SelectedPeriod"))</span>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="bx bx-bar-chart-alt-2 @(Model.MonthPlanVsActualPercent >= 100 ? "success" : "warning") font-large-2 float-right"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Charts Row -->
                <div class="row">
                    <div class="col-xl-8 col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Mes_Dash_DailyPlanVsFact") (@(ViewBag.StartDate != null && ViewBag.EndDate != null ? ((DateTime)ViewBag.StartDate).ToString("dd.MM.yyyy") + " - " + ((DateTime)ViewBag.EndDate).ToString("dd.MM.yyyy") : L.T("Mes_Dash_SelectedPeriod")))</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <canvas id="planVsActualChart" height="300"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4 col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Mes_Dash_ProductionByShop")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <canvas id="productionByShopChart" height="300"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quality Summary and Bottlenecks -->
                <div class="row">
                    <div class="col-xl-6 col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Mes_Dash_QualitySummary")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6 col-12">
                                            <p><strong>@L.T("Mes_Dash_TotalInspections"):</strong> @Model.TotalInspections</p>
                                            <p><strong>@L.T("Mes_Qi_Status_APPROVED"):</strong> <span class="text-success">@Model.ApprovedInspections</span></p>
                                            <p><strong>@L.T("Mes_Qi_QtyAccepted"):</strong> @Model.TotalAcceptedQty.ToString("N3")</p>
                                            <p><strong>@L.T("Mes_Dash_DefectQty"):</strong> <span class="text-danger">@Model.TotalRejectedQty.ToString("N3")</span></p>
                                            @if (Model.FTQPercent.HasValue)
                                            {
                                                <p><strong>FTQ (First Time Quality):</strong> <span class="text-primary">@Model.FTQPercent.Value.ToString("N1")%</span></p>
                                            }
                                            @if (Model.RejectedInspections > 0)
                                            {
                                                <p class="mb-0"><strong>@L.T("Mes_Dash_InspectionsWithDefects"):</strong> <span class="text-danger">@Model.RejectedInspections</span></p>
                                            }
                                        </div>
                                        <div class="col-md-6 col-12">
                                            <div class="mb-1">
                                                <canvas id="qualityQtyChart" height="150"></canvas>
                                            </div>
                                            <div>
                                                <canvas id="topDefectsChart" height="150"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-6 col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Mes_Dash_OrderBottlenecks")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="text-muted mb-1" style="font-size: 12px;">
                                        @L.T("Mes_Dash_BottleneckHint")
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Mes_Order")</th>
                                                    <th>@L.T("Mes_Product")</th>
                                                    <th class="text-right">@L.T("Mes_Plan")</th>
                                                    <th class="text-right">@L.T("Mes_Actual")</th>
                                                    <th class="text-right">@L.T("Mes_Qi_Remaining")</th>
                                                    <th>@L.T("Comment")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var bottleneck in Model.OrderBottlenecks)
                                                {
                                                    <tr>
                                                        <td>@bottleneck.OrderNo</td>
                                                        <td>@bottleneck.ProductNo</td>
                                                        <td class="text-right">@bottleneck.OrderedQty.ToString("N3")</td>
                                                        <td class="text-right">@bottleneck.ProducedQty.ToString("N3")</td>
                                                        <td class="text-right"><strong>@bottleneck.RemainingQty.ToString("N3")</strong></td>
                                                        <td>@bottleneck.Note</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var planVsLabels = @Html.Raw(Json.Encode(Model.DailyPlanVsActual.Select(d => d.Date.ToString("dd.MM")).ToList()));
        var planVsPlanned = @Html.Raw(Json.Encode(Model.DailyPlanVsActual.Select(d => d.Planned).ToList()));
        var planVsActual = @Html.Raw(Json.Encode(Model.DailyPlanVsActual.Select(d => d.Actual).ToList()));

        // Plan vs Actual Chart
        var planVsActualCtx = document.getElementById('planVsActualChart').getContext('2d');
        var planVsActualChart = new Chart(planVsActualCtx, {
            type: 'line',
            data: {
                labels: planVsLabels,
                datasets: [{
                    label: '@L.Js("Mes_Plan")',
                    data: planVsPlanned,
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    tension: 0.1
                }, {
                    label: '@L.Js("Mes_Actual")',
                    data: planVsActual,
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    tension: 0.1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        var shopLabels = @Html.Raw(Json.Encode(Model.ProductionByShop.Select(s => s.ShopName).ToList()));
        var shopTotals = @Html.Raw(Json.Encode(Model.ProductionByShop.Select(s => s.TotalProduction).ToList()));

        // Production by Shop Chart
        var productionByShopCtx = document.getElementById('productionByShopChart').getContext('2d');
        var productionByShopChart = new Chart(productionByShopCtx, {
            type: 'bar',
            data: {
                labels: shopLabels,
                datasets: [{
                    label: '@L.Js("Mes_Qi_Production")',
                    data: shopTotals,
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.2)',
                        'rgba(54, 162, 235, 0.2)',
                        'rgba(255, 206, 86, 0.2)',
                        'rgba(75, 192, 192, 0.2)',
                        'rgba(153, 102, 255, 0.2)'
                    ],
                    borderColor: [
                        'rgba(255, 99, 132, 1)',
                        'rgba(54, 162, 235, 1)',
                        'rgba(255, 206, 86, 1)',
                        'rgba(75, 192, 192, 1)',
                        'rgba(153, 102, 255, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // Quality Qty doughnut
        var qualityQtyCtx = document.getElementById('qualityQtyChart').getContext('2d');
        var qualityQtyChart = new Chart(qualityQtyCtx, {
            type: 'doughnut',
            data: {
                labels: ['@L.Js("Mes_Qi_AcceptShort")', '@L.Js("Mes_Dash_Defect")'],
                datasets: [{
                    data: @Html.Raw(Json.Encode(new[] { Model.TotalAcceptedQty, Model.TotalRejectedQty })),
                    backgroundColor: ['rgba(40, 199, 111, 0.25)', 'rgba(234, 84, 85, 0.25)'],
                    borderColor: ['rgba(40, 199, 111, 1)', 'rgba(234, 84, 85, 1)'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // Top-3 defects chart
        var defectLabels = @Html.Raw(Json.Encode((Model.TopDefects ?? new List<tahsinERP.ViewModels.TopDefectData>()).Select(d => d.DefectName).ToList()));
        var defectValues = @Html.Raw(Json.Encode((Model.TopDefects ?? new List<tahsinERP.ViewModels.TopDefectData>()).Select(d => d.RejectedQty).ToList()));
        var topDefectsCtx = document.getElementById('topDefectsChart').getContext('2d');
        var topDefectsChart = new Chart(topDefectsCtx, {
            type: 'bar',
            data: {
                labels: defectLabels,
                datasets: [{
                    label: '@L.Js("Mes_Dash_Top3Defects")',
                    data: defectValues,
                    backgroundColor: 'rgba(234, 84, 85, 0.25)',
                    borderColor: 'rgba(234, 84, 85, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

