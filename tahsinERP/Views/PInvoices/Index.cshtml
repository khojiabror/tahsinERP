@model List<tahsinERP.Models.P_INVOICES>
@{
    ViewBag.Title = "Xarid invoyslari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    bool changePermit = ViewBag.ChangePermit as bool? ?? false;
}
<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Xarid invoyslari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "PInvoices")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi invoys
                            </a>
                        </div>
                    }

                    <div class="card mb-2">
                        <div class="card-body py-1">
                            @using (Html.BeginForm("Index", "PInvoices", FormMethod.Get, new { @class = "form" }))
                            {
                                <div class="row">
                                    <div class="col-md-2 form-group mb-1">
                                        <label for="purchaseTypeFilter">Xarid turi</label>
                                        @Html.DropDownList("purchaseTypeFilter", new SelectList(new[]
                                        {
                                            new { Value = "", Text = "Barchasi" },
                                            new { Value = "Direct", Text = "Direct Purchase" },
                                            new { Value = "Indirect", Text = "Indirect Purchase" }
                                        }, "Value", "Text", ViewBag.PurchaseTypeFilter), new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3 form-group mb-1">
                                        <label for="supplierID">Ta'minotchi</label>
                                        @Html.DropDownList("supplierID", ViewBag.Suppliers as SelectList, "Barchasi", new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3 form-group mb-1">
                                        <label for="contractID">Shartnoma</label>
                                        @Html.DropDownList("contractID", ViewBag.Contracts as SelectList, "Barchasi", new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-2 form-group mb-1">
                                        <label for="fromDate">Dan</label>
                                        <input type="date" id="fromDate" name="fromDate" class="form-control" value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")" />
                                    </div>
                                    <div class="col-md-2 form-group mb-1">
                                        <label for="toDate">Gacha</label>
                                        <input type="date" id="toDate" name="toDate" class="form-control" value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <button type="submit" class="btn btn-primary btn-sm mr-1"><i class="bx bx-filter"></i> Filtrlash</button>
                                        <a href="@Url.Action("Index", "PInvoices")" class="btn btn-outline-secondary btn-sm">Tozalash</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="pInvoicesTable" class="table dt-responsive nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Invoys raqami</th>
                                                    <th>Ta'minotchi</th>
                                                    <th>Turi</th>
                                                    <th>Buyurtma raqami</th>
                                                    <th>Shartnoma raqami</th>
                                                    <th>Invoys summasi (QQS bilan)</th>
                                                    <th>Sana</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    var vatRates = ViewBag.VatRatesByContract as Dictionary<int, double>;
                                                    var netByInvoice = ViewBag.NetByInvoice as Dictionary<int, double> ?? new Dictionary<int, double>();
                                                    foreach (var item in Model)
                                                    {
                                                        var contractIdForVat = item.ContractID > 0 ? item.ContractID : (item.P_ORDERS != null && item.P_ORDERS.ContractID.HasValue ? item.P_ORDERS.ContractID.Value : 0);
                                                        var vatRate = (vatRates != null && contractIdForVat > 0 && vatRates.ContainsKey(contractIdForVat)) ? vatRates[contractIdForVat] : 0d;
                                                        // Amount QQS bilan saqlanadi (SRM-B25); QQSsiz summa — qatorlar yig'indisi
                                                        var amountWithVat = item.Amount ?? 0d;
                                                        var baseAmount = netByInvoice.ContainsKey(item.ID) ? netByInvoice[item.ID] : amountWithVat;
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "PInvoices", new { id = item.ID })">@item.InvoiceNo</a>
                                                            </td>
                                                            <td>
                                                                @if (item.SUPPLIER != null)
                                                                {
                                                                    <a href="@Url.Action("Details", "Supplier", new { id = item.SupplierID })">@item.SUPPLIER.Name</a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @{
                                                                    var invoiceType = item.PurchaseType == 1 ? "Indirect" : "Direct";
                                                                    var invoiceTypeClass = item.PurchaseType == 1 ? "badge-info" : "badge-primary";
                                                                }
                                                                <span class="badge @invoiceTypeClass">@invoiceType</span>
                                                            </td>
                                                            <td>
                                                                @if (item.P_ORDERS != null)
                                                                {
                                                                    <a href="@Url.Action("Details", "POrders", new { id = item.OrderID })">@item.P_ORDERS.OrderNo</a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (item.P_CONTRACTS != null)
                                                                {
                                                                    <a href="@Url.Action("Details", "PContracts", new { id = item.ContractID })">@item.P_CONTRACTS.ContractNo</a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            <td class="text-right" data-export="@amountWithVat.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                                                @amountWithVat.ToString("N2")
                                                                @if (vatRate > 0)
                                                                {
                                                                    <br />
                                                                    <small class="text-muted">@baseAmount.ToString("N2") + QQS @vatRate.ToString("0.##")%</small>
                                                                }
                                                            </td>
                                                            <td data-order="@item.InvoiceDate.ToString("yyyyMMdd")">@item.InvoiceDate.ToString("dd.MM.yyyy")</td>
                                                            @if (changePermit)
                                                            {
                                                                <td>
                                                                    <div class="d-flex">
                                                                        <a href="@Url.Action("Details", "PInvoices", new { id = item.ID })" class="btn btn-sm btn-icon btn-outline-primary mr-1" title="Ko'rish">
                                                                            <i class="bx bx-show"></i>
                                                                        </a>
                                                                        <a href="@Url.Action("Edit", "PInvoices", new { id = item.ID })" class="btn btn-sm btn-icon btn-outline-warning mr-1" title="Tahrirlash">
                                                                            <i class="bx bx-edit-alt"></i>
                                                                        </a>
                                                                        <a href="@Url.Action("Delete", "PInvoices", new { id = item.ID })" class="btn btn-sm btn-icon btn-outline-danger" title="O'chirish" onclick="return confirm('Ushbu invoysni o\'chirishni tasdiqlaysizmi?');">
                                                                            <i class="bx bx-trash"></i>
                                                                        </a>
                                                                    </div>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        (function () {
            function initPInvoicesTable() {
                if (typeof window.jQuery === 'undefined' || typeof window.jQuery.fn.DataTable === 'undefined') {
                    setTimeout(initPInvoicesTable, 100);
                    return;
                }
                var $ = window.jQuery;
                if (!$('#pInvoicesTable').length) return;

                var exportColumns = [0, 1, 2, 3, 4, 5, 6];
                var columnDefs = [
                    { type: 'num', targets: 5 },
                    { type: 'date', targets: 6 }
                ];
                @if (changePermit)
                {
                    <text>columnDefs.push({ orderable: false, targets: 7 });</text>
                }
                var stripHtml = function (data, row, column, node) {
                    if (node && node.getAttribute) {
                        var exportVal = node.getAttribute('data-export');
                        if (exportVal !== null && exportVal !== '') {
                            return exportVal;
                        }
                    }
                    return (data || '').toString().replace(/<[^>]*>/g, '').trim();
                };

                $('#pInvoicesTable').DataTable({
                "language": {
                    "search": "Qidirish:",
                    "lengthMenu": "_MENU_ ta ko'rsatish",
                    "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    "infoEmpty": "Yozuvlar yo'q",
                    "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                    "paginate": {
                        "first": "Birinchi",
                        "last": "Oxirgi",
                        "next": "Keyingi",
                        "previous": "Oldingi"
                    },
                    "zeroRecords": "Ma'lumot topilmadi"
                },
                "pageLength": 25,
                "order": [[6, "desc"]],
                "columnDefs": columnDefs,
                "scrollX": true,
                dom: 'lBfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bx bxs-file-excel"></i> Excel',
                        titleAttr: 'Excelga yuklash',
                        className: 'btn btn-success btn-sm mr-1',
                        filename: function () {
                            var now = new Date();
                            return 'Xarid_invoyslari_' + now.getFullYear() +
                                String(now.getMonth() + 1).padStart(2, '0') +
                                String(now.getDate()).padStart(2, '0');
                        },
                        exportOptions: {
                            columns: exportColumns,
                            format: { body: stripHtml }
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bx bxs-file-pdf"></i> PDF',
                        titleAttr: 'PDFga yuklash',
                        className: 'btn btn-danger btn-sm',
                        pageSize: 'A4',
                        exportOptions: {
                            columns: exportColumns,
                            format: { body: stripHtml }
                        }
                    }
                ]
            });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initPInvoicesTable);
            } else {
                initPInvoicesTable();
            }
        })();
    </script>
