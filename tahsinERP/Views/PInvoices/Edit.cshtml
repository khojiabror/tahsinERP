@model tahsinERP.Controllers.PInvoiceEditViewModel
@using System.Collections.Generic
@{
    ViewBag.Title = "Invoysni tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "PInvoices"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/PInvoices/Index">Xarid invoyslari</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Tahrirlash
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Edit", "PInvoices", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form", @id = "invoiceForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(model => model.ID)
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row">
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="InvoiceNo">Invoys raqami</label>
                                                    @Html.TextBoxFor(model => model.InvoiceNo, new { @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.InvoiceNo, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="InvoiceDate">Sana</label>
                                                    @Html.TextBoxFor(model => model.InvoiceDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.InvoiceDate, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="SupplierID">Ta'minotchi</label>
                                                    @Html.DropDownListFor(model => model.SupplierID, ViewBag.Suppliers as SelectList, "---Tanlang---", new { @class = "form-control select2", @id = "supplierSelect", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="ContractID">Shartnoma</label>
                                                    @Html.DropDownListFor(model => model.ContractID, ViewBag.Contracts as SelectList, "---Tanlang---", new { @class = "form-control select2", @id = "contractSelect" })
                                                    @Html.ValidationMessageFor(model => model.ContractID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="OrderID">Buyurtma</label>
                                                    @Html.DropDownListFor(model => model.OrderID, ViewBag.POrders as SelectList, "---Tanlang---", new { @class = "form-control select2", @id = "orderSelect" })
                                                    @Html.ValidationMessageFor(model => model.OrderID, "", new { @class = "text-danger" })
                                                    <small class="text-muted">Ixtiyoriy</small>
                                                </div>
                                                @Html.HiddenFor(model => model.CompanyID, new { @Value = ViewBag.DefaultCompanyID ?? Model.CompanyID })
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="CurrencyID">Valyuta</label>
                                                    @Html.DropDownListFor(model => model.CurrencyID, ViewBag.Currencies as SelectList, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-9 col-12 form-group">
                                                    <label for="invoiceFile">Yangi invoys hujjati (PDF) - mavjud hujjat o'rniga qo'yiladi</label>
                                                    <input type="file" name="invoiceFile" id="invoiceFile" class="form-control" accept=".pdf" />
                                                </div>
                                            </div>

                                            <br />
                                            <h5>Invoys mahsulotlari</h5>

                                            <div class="table-responsive">
                                                <table id="invoiceProductsTable" class="table table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>Mahsulot</th>
                                                            <th>Miqdor</th>
                                                            <th>Birlik</th>
                                                            <th>Narx</th>
                                                            <th>Jami</th>
                                                            <th>Amallar</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (Model.InvoiceProducts != null)
                                                        {
                                                            for (int i = 0; i < Model.InvoiceProducts.Count; i++)
                                                            {
                                                                var product = Model.InvoiceProducts[i];
                                                                <tr data-row-index="@i">
                                                                    <td>
                                                                        @Html.DropDownListFor(m => m.InvoiceProducts[i].ProductID, ViewBag.PurchasableProducts as SelectList, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                                        @Html.HiddenFor(m => m.InvoiceProducts[i].ID)
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.InvoiceProducts[i].Quantity, new { @type = "number", @class = "form-control quantity-input", @step = "0.01", @min = "0", @required = "required" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.DropDownListFor(m => m.InvoiceProducts[i].UnitID, ViewBag.Units as SelectList, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.InvoiceProducts[i].Price, new { @type = "number", @class = "form-control price-input", @step = "0.01", @min = "0", @required = "required" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.InvoiceProducts[i].TotalPrice, new { @type = "number", @class = "form-control total-price", @readonly = "readonly" })
                                                                    </td>
                                                                    <td>
                                                                        <button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="4" class="text-right"><strong>Jami:</strong></td>
                                                            <td id="totalAmount" class="text-right"><strong>@Model.Amount.ToString("N2")</strong></td>
                                                            <td></td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>

                                            <div class="row mt-2">
                                                <div class="col-12">
                                                    <button type="button" class="btn btn-outline-primary" id="addRowBtn">
                                                        <i class="bx bx-plus"></i> Qo'shish
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-12">
                                                    <button type="submit" class="btn btn-success">
                                                        <i class="bx bx-save"></i> Saqlash
                                                    </button>
                                                    <a href="@Url.Action("Index", "PInvoices")" class="btn btn-secondary">
                                                        <i class="bx bx-x"></i> Bekor qilish
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        (function () {
            function initInvoiceScripts() {
                if (typeof jQuery === 'undefined') {
                    setTimeout(initInvoiceScripts, 100);
                    return;
                }

                var $ = jQuery;

                $(document).ready(function () {

                    if (typeof $.fn.select2 !== 'undefined') {
                        $('.select2').select2();
                    }

                    var productRowIndex = @(Model.InvoiceProducts?.Count ?? 0);

            @{
                var purchasableProductsList = new List<object>();
                if (ViewBag.PurchasableProducts != null)
                {
                    var purchasableProductsSelectList = ViewBag.PurchasableProducts as System.Web.Mvc.SelectList;
                    if (purchasableProductsSelectList != null)
                    {
                        foreach (System.Web.Mvc.SelectListItem item in purchasableProductsSelectList.Items)
                        {
                            purchasableProductsList.Add(new { Value = item.Value, Text = item.Text });
                        }
                    }
                }

                var unitsList = new List<object>();
                if (ViewBag.Units != null)
                {
                    var unitsSelectList = ViewBag.Units as System.Web.Mvc.SelectList;
                    if (unitsSelectList != null)
                    {
                        foreach (var unit in unitsSelectList.Items)
                        {
                            var unitEntity = unit as tahsinERP.Models.UNIT;
                            if (unitEntity != null)
                            {
                                unitsList.Add(new { Value = unitEntity.ID.ToString(), Text = unitEntity.ShortName ?? "" });
                            }
                        }
                    }
                }
            }

                    var purchasableProducts = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(purchasableProductsList));
                    var units = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(unitsList));

                    // Load contracts when supplier changes
                    $('#supplierSelect').on('change', function () {
                        var supplierId = $(this).val();
                        var $contractSelect = $('#contractSelect');

                        if (supplierId) {
                            $contractSelect.prop('disabled', true);

                            $.ajax({
                                url: '@Url.Action("GetContractsBySupplier", "PInvoices")',
                                type: 'POST',
                                data: { supplierId: supplierId },
                                success: function (response) {
                                    if (response && response.success) {
                                        $contractSelect.empty().append('<option value="">---Tanlang---</option>');

                                        if (response.data && Array.isArray(response.data) && response.data.length > 0) {
                                            response.data.forEach(function (contract) {
                                                $contractSelect.append($('<option>')
                                                    .attr('value', contract.ID)
                                                    .text(contract.ContractNo));
                                            });
                                        }

                                        $contractSelect.prop('disabled', false);

                                        // Reinitialize Select2
                                        if (typeof $.fn.select2 !== 'undefined') {
                                            $contractSelect.select2();
                                        }
                                    } else {
                                        $contractSelect.prop('disabled', false);
                                        if (typeof $.fn.select2 !== 'undefined') {
                                            $contractSelect.select2();
                                        }
                                    }
                                },
                                error: function (xhr, status, error) {
                                    console.error('Contract loading error:', status, error, xhr);
                                    $contractSelect.prop('disabled', false);
                                    if (typeof $.fn.select2 !== 'undefined') {
                                        $contractSelect.select2();
                                    }
                                }
                            });
                        } else {
                            $contractSelect.empty().append('<option value="">---Tanlang---</option>');
                            if (typeof $.fn.select2 !== 'undefined') {
                                $contractSelect.select2();
                            }
                        }
                    });

                    // Calculate totals for existing rows
                    $('.quantity-input, .price-input').each(function () {
                        var $row = $(this).closest('tr');
                        var quantity = parseFloat($row.find('.quantity-input').val()) || 0;
                        var price = parseFloat($row.find('.price-input').val()) || 0;
                        var total = quantity * price;
                        $row.find('.total-price').val(total.toFixed(2));
                    });
                    updateTotal();

                    $('#addRowBtn').click(function () {
                        addProductRow(null, 0, null, 0);
                    });

                    function addProductRow(productId, quantity, unitId, price) {
                        var row = '<tr data-row-index="' + productRowIndex + '">' +
                            '<td>' +
                            '<select name="InvoiceProducts[' + productRowIndex + '].ProductID" class="form-control select2" required>' +
                            '<option value="">---Tanlang---</option>';

                        purchasableProducts.forEach(function (product) {
                            var selected = product.Value == productId ? 'selected' : '';
                            row += '<option value="' + product.Value + '" ' + selected + '>' + product.Text + '</option>';
                        });

                        row += '</select>' +
                            '<input type="hidden" name="InvoiceProducts[' + productRowIndex + '].ID" value="" />' +
                            '</td>' +
                            '<td><input type="number" name="InvoiceProducts[' + productRowIndex + '].Quantity" class="form-control quantity-input" value="' + (quantity || 0) + '" step="0.01" min="0" required /></td>' +
                            '<td>' +
                            '<select name="InvoiceProducts[' + productRowIndex + '].UnitID" class="form-control select2" required>' +
                            '<option value="">---Tanlang---</option>';

                        units.forEach(function (unit) {
                            var selected = unit.Value == unitId ? 'selected' : '';
                            row += '<option value="' + unit.Value + '" ' + selected + '>' + unit.Text + '</option>';
                        });

                        row += '</select></td>' +
                            '<td><input type="number" name="InvoiceProducts[' + productRowIndex + '].Price" class="form-control price-input" value="' + (price || 0) + '" step="0.01" min="0" required /></td>' +
                            '<td><input type="number" name="InvoiceProducts[' + productRowIndex + '].TotalPrice" class="form-control total-price" value="0" readonly /></td>' +
                            '<td><button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button></td>' +
                            '</tr>';

                        $('#invoiceProductsTable tbody').append(row);

                        $('select.product-select').last().select2();
                        $('select.unit-select').last().select2();

                        productRowIndex++;
                    }

                    $(document).on('click', '.remove-row', function () {
                        $(this).closest('tr').remove();
                        updateTotal();
                    });

                    $(document).on('input', '.quantity-input, .price-input', function () {
                        var $row = $(this).closest('tr');
                        var quantity = parseFloat($row.find('.quantity-input').val()) || 0;
                        var price = parseFloat($row.find('.price-input').val()) || 0;
                        var total = quantity * price;
                        $row.find('.total-price').val(total.toFixed(2));
                        updateTotal();
                    });

                    function updateTotal() {
                        var total = 0;
                        $('.total-price').each(function () {
                            total += parseFloat($(this).val()) || 0;
                        });
                        $('#totalAmount').text(total.toFixed(2));
                    }
                });
            }
            // Start initialization
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initInvoiceScripts);
            } else {
                initInvoiceScripts();
            }
            }) ();

    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
