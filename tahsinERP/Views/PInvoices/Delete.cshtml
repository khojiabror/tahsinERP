@model tahsinERP.Models.P_INVOICES
@{
    ViewBag.Title = "Invoysni o'chirish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/PInvoices/Index">Xarid invoyslari</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    O'chirish
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title text-danger">Invoysni o'chirish</h4>
                        </div>
                        <div class="card-content">
                            <div class="card-body">
                                <div class="alert alert-warning">
                                    <h5>Diqqat!</h5>
                                    <p>Ushbu invoysni o'chirishni tasdiqlaysizmi? Bu amalni qaytarib bo'lmaydi.</p>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <table class="table table-borderless">
                                            <tr>
                                                <th width="40%">Invoys raqami:</th>
                                                <td>@Model.InvoiceNo</td>
                                            </tr>
                                            <tr>
                                                <th>Sana:</th>
                                                <td>@Model.InvoiceDate.ToString("dd.MM.yyyy")</td>
                                            </tr>
                                            <tr>
                                                <th>Ta'minotchi:</th>
                                                <td>@(Model.SUPPLIER?.Name ?? "-")</td>
                                            </tr>
                                            <tr>
                                                <th>Invoys summasi:</th>
                                                <td><strong>@(Model.Amount.HasValue ? Model.Amount.Value.ToString("N2") : "-")</strong> <small class="text-muted">(QQS bilan)</small></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                @using (Html.BeginForm("Delete", "PInvoices", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.HiddenFor(model => model.ID)

                                    <div class="form-actions">
                                        <button type="submit" class="btn btn-danger">
                                            <i class="bx bx-trash"></i> Ha, o'chirish
                                        </button>
                                        <a href="@Url.Action("Index", "PInvoices")" class="btn btn-secondary">
                                            <i class="bx bx-x"></i> Bekor qilish
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
