@model tahsinERP.ViewModels.ProductProductionDetailsViewModel
@using tahsinERP.Models
@{
    ViewBag.Title = L.T("Mes_Prod_DetailsTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ModelProduction = Model.Production;
    // Controller: o'zgartirish huquqi bor va yozuv QI/lot transferiga bog'lanmagan
    bool changePermit = ViewBag.ChangePermit == true;
}

<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/ProductProduction/Index">@L.T("Mes_Prod_Title")</a>
                                    </li>
                                    <li class="breadcrumb-item active">@L.T("Details")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <!-- Asosiy ma'lumotlar -->
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                <h4 class="text-primary">@L.T("Mes_Prod_DetailsTitle")</h4>
                                                <p class="text-muted small mb-0">@L.T("Mes_Prod_DocRef") #@ModelProduction.ID</p>
                                                <hr />
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <p><strong>@L.T("Mes_Product"):</strong> @(ModelProduction.PRODUCT?.PNo ?? ModelProduction.ProductID.ToString()) - @(ModelProduction.PRODUCT?.Name ?? "")</p>
                                                        <p><strong>@L.T("Date"):</strong> @ModelProduction.Date.ToString("dd.MM.yyyy")</p>
                                                        <p><strong>@L.T("Mes_Prod_Shop"):</strong> @(ModelProduction.SHOP?.ShopName ?? ModelProduction.ShopID.ToString())</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <p><strong>@L.T("Mes_DayShift"):</strong> @ModelProduction.DayShift.ToString("N3")</p>
                                                        <p><strong>@L.T("Mes_NightShift"):</strong> @ModelProduction.NightShift.ToString("N3")</p>
                                                        <p><strong>@L.T("Total"):</strong> <span class="text-primary"><strong>@ModelProduction.Total.ToString("N3")</strong></span></p>
                                                        @if (!string.IsNullOrEmpty(ModelProduction.Comment))
                                                        {
                                                            <p><strong>@L.T("Comment"):</strong> @ModelProduction.Comment</p>
                                                        }
                                                    </div>
                                                </div>
                                                <hr />
                                                <div class="row mt-3">
                                                    <div class="col-12">
                                                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                                                            <i class="bx bx-arrow-back"></i> @L.T("Back")
                                                        </a>
                                                        @if (changePermit)
                                                        {
                                                            <a href="@Url.Action("Edit", new { id = ModelProduction.ID })" class="btn btn-outline-success">
                                                                <i class="bx bx-edit"></i> @L.T("Edit")
                                                            </a>
                                                            using (Html.BeginForm("Delete", "ProductProduction", new { id = ModelProduction.ID }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('" + L.Js("Mes_Prod_DeleteConfirm") + "');" }))
                                                            {
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-outline-danger">
                                                                    <i class="bx bx-trash"></i> @L.T("Delete")
                                                                </button>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- BOM/Norm bo'yicha sarf -->
                            <div class="card mt-2">
                                <div class="card-header">
                                    <h4 class="card-title mb-0">
                                        <i class="bx bx-list-check"></i> @L.T("Mes_Prod_BomConsumptionTitle")
                                    </h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        @if (Model.BomConsumptionLines != null && Model.BomConsumptionLines.Any())
                                        {
                                            <p class="text-muted small mb-2">@Html.Raw(L.T("Mes_Prod_BomLinesCount", Model.BomConsumptionLines.Count))</p>
                                            <div class="table-responsive">
                                                <table id="bomSarfTable" class="table table-striped table-bordered table-hover" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <th>@L.T("Mes_ProductCode")</th>
                                                            <th>@L.T("Mes_Prod_MaterialName")</th>
                                                            <th>@L.T("Mes_Prod_RequiredPcs")</th>
                                                            <th>@L.T("Mes_Prod_TotalConsumption")</th>
                                                            <th>@L.T("Unit")</th>
                                                            <th>@L.T("Mes_Prod_PiecePrice")</th>
                                                            <th>@L.T("Mes_Prod_AmountMoney")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{ int bomIdx = 1; }
                                                        @foreach (var line in Model.BomConsumptionLines)
                                                        {
                                                            <tr>
                                                                <td>@(bomIdx++)</td>
                                                                <td>@(line.MaterialPNo ?? "-")</td>
                                                                <td>@(line.MaterialName ?? "-")</td>
                                                                <td>@(line.RequiredQtyPieces > 0 ? line.RequiredQtyPieces.ToString("N3") : "-")</td>
                                                                <td><strong>@line.TotalConsumption.ToString("N3")</strong> @(line.TotalConsumptionIsInKg ? " kg" : "")</td>
                                                                <td>@(line.UnitName ?? "-")</td>
                                                                <td>@(line.PiecePrice > 0 ? line.PiecePrice.ToString("N2") : "-")</td>
                                                                <td>@(line.TotalPrice > 0 ? line.TotalPrice.ToString("N2") : "-")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-muted mb-0">@L.T("Mes_Prod_NoBomLines")</p>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- 2-datatable: Chiqim hujjatlari (BOM chiqimi) — har bir qator chiqim sahifasiga link -->
                            <div class="card mt-2">
                                <div class="card-header">
                                    <h4 class="card-title mb-0">
                                        <i class="bx bx-log-out-circle"></i> @L.T("Mes_Prod_ExpenseDocsTitle")
                                    </h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <p class="text-muted small mb-2">@L.T("Mes_Prod_ExpensePageUrl") <code>~/Expenses/Details/{id}</code>. @Html.Raw(L.T("Mes_Prod_ExpenseLinkHint"))</p>
                                        @if (Model.ExpenseDocuments != null && Model.ExpenseDocuments.Any())
                                        {
                                            <p class="text-muted small mb-2">@Html.Raw(L.T("Mes_Prod_ExpenseDocsCount", Model.ExpenseDocuments.Count))</p>
                                            <div class="table-responsive">
                                                <table id="expenseTable" class="table table-striped table-bordered table-hover" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>@L.T("Mes_Prod_DocNo")</th>
                                                            <th>@L.T("Mes_Prod_DateTime")</th>
                                                            <th>@L.T("Mes_Prod_ProductCount")</th>
                                                            <th>@L.T("Mes_Prod_TotalQty")</th>
                                                            <th>@L.T("Amount")</th>
                                                            <th>@L.T("Mes_Prod_ExpenseUrl")</th>
                                                            <th>@L.T("Actions")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var exp in Model.ExpenseDocuments)
                                                        {
                                                            <tr>
                                                                <td>@(exp.DocNo ?? "-")</td>
                                                                <td>@exp.IssueDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                                                <td>@exp.ProductCount</td>
                                                                <td>@exp.Amount.ToString("N3")</td>
                                                                <td>@exp.TotalPrice.ToString("N2")</td>
                                                                <td><a href="@(exp.DetailsUrl ?? Url.Action("Details", "Expenses", new { id = exp.ExpenseID }))" target="_blank">@(exp.DetailsUrl ?? ("/Expenses/Details/" + exp.ExpenseID))</a></td>
                                                                <td>
                                                                    <a href="@(exp.DetailsUrl ?? Url.Action("Details", "Expenses", new { id = exp.ExpenseID }))" class="btn btn-sm btn-outline-primary" title="@L.T("Mes_Prod_GoToExpense")">
                                                                        <i class="bx bx-link-external"></i> @L.T("Mes_Prod_Expense")
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="table-responsive">
                                                <table id="expenseTable" class="table table-striped table-bordered table-hover" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>@L.T("Mes_Prod_DocNo")</th>
                                                            <th>@L.T("Mes_Prod_DateTime")</th>
                                                            <th>@L.T("Mes_Prod_ProductCount")</th>
                                                            <th>@L.T("Mes_Prod_TotalQty")</th>
                                                            <th>@L.T("Amount")</th>
                                                            <th>@L.T("Mes_Prod_ExpenseUrl")</th>
                                                            <th>@L.T("Actions")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td class="text-muted text-center">
                                                                @L.T("Mes_Prod_NoExpenseDocs")
                                                            </td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($('#bomSarfTable').length) {
                $('#bomSarfTable').DataTable({
                    paging: true,
                    lengthChange: true,
                    order: [[1, "asc"]],
                    pageLength: 25
                });
            }

            if ($('#expenseTable').length) {
                $('#expenseTable').DataTable({
                    paging: true,
                    lengthChange: true,
                    order: [[1, "desc"]],
                    pageLength: 10
                });
            }
        });
    </script>
}
