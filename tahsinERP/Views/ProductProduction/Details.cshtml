@model tahsinERP.ViewModels.ProductProductionDetailsViewModel
@using tahsinERP.Models
@{
    ViewBag.Title = "Ishlab Chiqarish Ma'lumotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ModelProduction = Model.Production;
    // TODO: agar kerak bo'lsa, ChangePermit ni controllerdan ViewBag orqali uzatish mumkin
    bool changePermit = true;
}

<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/ProductProduction/Index">Ishlab Chiqarish</a>
                                    </li>
                                    <li class="breadcrumb-item active">Ma'lumotlar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <!-- Asosiy ma'lumotlar -->
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                <h4 class="text-primary">Ishlab Chiqarish Ma'lumotlari</h4>
                                                <p class="text-muted small mb-0">Hujjat havolasi: #@ModelProduction.ID</p>
                                                <hr />
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <p><strong>Mahsulot:</strong> @(ModelProduction.PRODUCT?.PNo ?? ModelProduction.ProductID.ToString()) - @(ModelProduction.PRODUCT?.Name ?? "")</p>
                                                        <p><strong>Sana:</strong> @ModelProduction.Date.ToString("dd.MM.yyyy")</p>
                                                        <p><strong>Sex:</strong> @(ModelProduction.SHOP?.ShopName ?? ModelProduction.ShopID.ToString())</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <p><strong>Kunduzgi smena:</strong> @ModelProduction.DayShift.ToString("N3")</p>
                                                        <p><strong>Tungi smena:</strong> @ModelProduction.NightShift.ToString("N3")</p>
                                                        <p><strong>Jami:</strong> <span class="text-primary"><strong>@ModelProduction.Total.ToString("N3")</strong></span></p>
                                                        @if (!string.IsNullOrEmpty(ModelProduction.Comment))
                                                        {
                                                            <p><strong>Izoh:</strong> @ModelProduction.Comment</p>
                                                        }
                                                    </div>
                                                </div>
                                                <hr />
                                                <div class="row mt-3">
                                                    <div class="col-12">
                                                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                                                            <i class="bx bx-arrow-back"></i> Orqaga
                                                        </a>
                                                        @if (changePermit)
                                                        {
                                                            <a href="@Url.Action("Edit", new { id = ModelProduction.ID })" class="btn btn-outline-success">
                                                                <i class="bx bx-edit"></i> Tahrirlash
                                                            </a>
                                                            <a href="@Url.Action("Delete", new { id = ModelProduction.ID })" class="btn btn-outline-danger">
                                                                <i class="bx bx-trash"></i> O'chirish
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- BOM/Norm bo'yicha sarf -->
                            <div class="card mt-2">
                                <div class="card-header">
                                    <h4 class="card-title mb-0">
                                        <i class="bx bx-list-check"></i> BOM/Norm bo'yicha sarf (xom ashyo talabi)
                                    </h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        @if (Model.BomConsumptionLines != null && Model.BomConsumptionLines.Any())
                                        {
                                            <p class="text-muted small mb-2">Jami <strong>@Model.BomConsumptionLines.Count</strong> ta xom ashyo (BOM/Norm).</p>
                                            <div class="table-responsive">
                                                <table id="bomSarfTable" class="table table-striped table-bordered table-hover" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <th>Mahsulot kodi</th>
                                                            <th>Xom ashyo nomi</th>
                                                            <th>Talab qilingan (dona)</th>
                                                            <th>Talab (m)</th>
                                                            <th>Chiqindi</th>
                                                            <th>Jami sarf</th>
                                                            <th>O'lchov birligi</th>
                                                            <th>Dona narxi</th>
                                                            <th>Summa (pul)</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{ int bomIdx = 1; }
                                                        @foreach (var line in Model.BomConsumptionLines)
                                                        {
                                                            <tr>
                                                                <td>@(bomIdx++)</td>
                                                                <td>@(line.MaterialPNo ?? "-")</td>
                                                                <td>@(line.MaterialName ?? "-")</td>
                                                                <td>@(line.RequiredQtyPieces > 0 ? line.RequiredQtyPieces.ToString("N3") : "-")</td>
                                                                <td>@(line.RequiredQtyMeters > 0 ? line.RequiredQtyMeters.ToString("N3") : "-")</td>
                                                                <td>@(line.WasteQty > 0 ? line.WasteQty.ToString("N3") : "-")</td>
                                                                <td><strong>@line.TotalConsumption.ToString("N3")</strong> @(line.TotalConsumptionIsInKg ? " kg" : "")</td>
                                                                <td>@(line.UnitName ?? "-")</td>
                                                                <td>@(line.PiecePrice > 0 ? line.PiecePrice.ToString("N2") : "-")</td>
                                                                <td>@(line.TotalPrice > 0 ? line.TotalPrice.ToString("N2") : "-")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-muted mb-0">Ushbu mahsulot uchun BOM/Norm topilmadi yoki sarf qatorlari yo'q.</p>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- 2-datatable: Chiqim hujjatlari (BOM chiqimi) — har bir qator chiqim sahifasiga link -->
                            <div class="card mt-2">
                                <div class="card-header">
                                    <h4 class="card-title mb-0">
                                        <i class="bx bx-log-out-circle"></i> Chiqim hujjatlari (ishlab chiqarish uchun xomashyo chiqimi)
                                    </h4>
                                </div>
                                <div class="card-content">
                                    <div class="card-body">
                                        <p class="text-muted small mb-2">Chiqim sahifasi URL: <code>~/Expenses/Details/{id}</code>. Quyidagi jadvalda har bir qator uchun <strong>Chiqim</strong> tugmasi yoki havola orqali chiqim hujjatiga o‘ting.</p>
                                        @if (Model.ExpenseDocuments != null && Model.ExpenseDocuments.Any())
                                        {
                                            <p class="text-muted small mb-2">Ushbu ishlab chiqarishga bog‘liq <strong>@Model.ExpenseDocuments.Count</strong> ta chiqim hujjati.</p>
                                            <div class="table-responsive">
                                                <table id="expenseTable" class="table table-striped table-bordered table-hover" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>Hujjat raqami</th>
                                                            <th>Sana va vaqt</th>
                                                            <th>Mahsulotlar soni</th>
                                                            <th>Jami miqdor</th>
                                                            <th>Summa</th>
                                                            <th>Chiqim URL</th>
                                                            <th>Amallar</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var exp in Model.ExpenseDocuments)
                                                        {
                                                            <tr>
                                                                <td>@(exp.DocNo ?? "-")</td>
                                                                <td>@exp.IssueDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                                                <td>@exp.ProductCount</td>
                                                                <td>@exp.Amount.ToString("N3")</td>
                                                                <td>@exp.TotalPrice.ToString("N2")</td>
                                                                <td><a href="@(exp.DetailsUrl ?? Url.Action("Details", "Expenses", new { id = exp.ExpenseID }))" target="_blank">@(exp.DetailsUrl ?? ("/Expenses/Details/" + exp.ExpenseID))</a></td>
                                                                <td>
                                                                    <a href="@(exp.DetailsUrl ?? Url.Action("Details", "Expenses", new { id = exp.ExpenseID }))" class="btn btn-sm btn-outline-primary" title="Chiqim hujjatiga o'tish">
                                                                        <i class="bx bx-link-external"></i> Chiqim
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="table-responsive">
                                                <table id="expenseTable" class="table table-striped table-bordered table-hover" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>Hujjat raqami</th>
                                                            <th>Sana va vaqt</th>
                                                            <th>Mahsulotlar soni</th>
                                                            <th>Jami miqdor</th>
                                                            <th>Summa</th>
                                                            <th>Chiqim URL</th>
                                                            <th>Amallar</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td class="text-muted text-center">
                                                                Ushbu ishlab chiqarish uchun chiqim hujjati topilmadi (BOM chiqimi bo‘lmagan yoki eski yozuvlar).
                                                            </td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($('#bomSarfTable').length) {
                $('#bomSarfTable').DataTable({
                    language: {
                        search: "Qidirish:",
                        lengthMenu: "_MENU_ ta ko'rsatish",
                        info: "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                        infoEmpty: "Yozuvlar yo'q",
                        infoFiltered: "(jami _MAX_ ta yozuvdan filtrlangan)",
                        paginate: {
                            first: "Birinchi",
                            last: "Oxirgi",
                            next: "Keyingi",
                            previous: "Oldingi"
                        },
                        zeroRecords: "Ma'lumot topilmadi"
                    },
                    paging: true,
                    lengthChange: true,
                    order: [[1, "asc"]],
                    pageLength: 25
                });
            }

            if ($('#expenseTable').length) {
                $('#expenseTable').DataTable({
                    language: {
                        search: "Qidirish:",
                        lengthMenu: "_MENU_ ta ko'rsatish",
                        info: "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                        infoEmpty: "Yozuvlar yo'q",
                        infoFiltered: "(jami _MAX_ ta yozuvdan filtrlangan)",
                        paginate: {
                            first: "Birinchi",
                            last: "Oxirgi",
                            next: "Keyingi",
                            previous: "Oldingi"
                        },
                        zeroRecords: "Ma'lumot topilmadi"
                    },
                    paging: true,
                    lengthChange: true,
                    order: [[1, "desc"]],
                    pageLength: 10
                });
            }
        });
    </script>
}
