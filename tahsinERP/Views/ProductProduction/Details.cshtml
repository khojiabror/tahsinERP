@model tahsinERP.Models.PRODUCT_PRODUCTION
@{
    ViewBag.Title = "Ishlab Chiqarish Ma'lumotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/ProductProduction/Index">Ishlab Chiqarish</a>
                                    </li>
                                    <li class="breadcrumb-item active">Ma'lumotlar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                <h4 class="text-primary">Ishlab Chiqarish Ma'lumotlari</h4>
                                                <hr />
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <p><strong>Mahsulot:</strong> @(Model.PRODUCT?.PNo ?? Model.ProductID.ToString()) - @(Model.PRODUCT?.Name ?? "")</p>
                                                        <p><strong>Sana:</strong> @Model.Date.ToString("dd.MM.yyyy")</p>
                                                        <p><strong>Sex:</strong> @(Model.SHOP?.ShopName ?? Model.ShopID.ToString())</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <p><strong>Kunduzgi smena:</strong> @Model.DayShift.ToString("N3")</p>
                                                        <p><strong>Tungi smena:</strong> @Model.NightShift.ToString("N3")</p>
                                                        <p><strong>Jami:</strong> <span class="text-primary"><strong>@Model.Total.ToString("N3")</strong></span></p>
                                                        @if (!string.IsNullOrEmpty(Model.Comment))
                                                        {
                                                            <p><strong>Izoh:</strong> @Model.Comment</p>
                                                        }
                                                    </div>
                                                </div>
                                                <hr />
                                                <div class="row mt-3">
                                                    <div class="col-12">
                                                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                                                            <i class="bx bx-arrow-back"></i> Orqaga
                                                        </a>
                                                        @if (changePermit)
                                                        {
                                                            <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                                                                <i class="bx bx-edit"></i> Tahrirlash
                                                            </a>
                                                            <a href="@Url.Action("Delete", new { id = Model.ID })" class="btn btn-danger">
                                                                <i class="bx bx-trash"></i> O'chirish
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

