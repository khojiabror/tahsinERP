@model tahsinERP.ViewModels.ProductProductionViewModel
@{
    ViewBag.Title = L.T("Mes_Prod_EditTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Edit", "ProductProduction", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ID)
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/ProductProduction/Index">@L.T("Mes_Prod_Title")</a>
                                        </li>
                                        <li class="breadcrumb-item active">@L.T("Edit")</li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="basic-select2">
                        <div class="row">
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                            <hr />
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <h6 class="invoice-to">@L.T("Mes_Product") *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.DropDownListFor(model => model.ProductID, ViewBag.Products as SelectList, L.T("Mes_Val_SelectProduct"), new { @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.ProductID, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                </div>
                                                <div class="col-md-6">
                                                    <h6 class="invoice-to">@L.T("Mes_Prod_Shop") *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.DropDownListFor(model => model.ShopID, ViewBag.Shops as SelectList, L.T("Mes_Prod_Val_SelectShop"), new { @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.ShopID, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <h6 class="invoice-to">@L.T("Date") *</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Date, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                </div>
                                                <div class="col-md-6">
                                                    <h6 class="invoice-to">@L.T("Comment")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Comment, new { @class = "form-control", @placeholder = L.T("Comment") })
                                                    </fieldset>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <h6 class="invoice-to">@L.T("Mes_DayShift")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.DayShift, "{0:0.######}", new { @class = "form-control day-shift-input", @type = "number", @step = "0.001", @min = "0" })
                                                        @Html.ValidationMessageFor(model => model.DayShift, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                </div>
                                                <div class="col-md-4">
                                                    <h6 class="invoice-to">@L.T("Mes_NightShift")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.NightShift, "{0:0.######}", new { @class = "form-control night-shift-input", @type = "number", @step = "0.001", @min = "0" })
                                                        @Html.ValidationMessageFor(model => model.NightShift, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                </div>
                                                <div class="col-md-4">
                                                    <h6 class="invoice-to">@L.T("Total")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Total, "{0:0.######}", new { @class = "form-control", @readonly = "readonly", @id = "totalDisplay" })
                                                    </fieldset>
                                                </div>
                                            </div>
                                            <hr />
                                            <div class="row">
                                                <div class="col-12">
                                                    <button type="submit" class="btn btn-success">
                                                        <i class="bx bx-save"></i> @L.T("Save")
                                                    </button>
                                                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                                                        <i class="bx bx-x"></i> @L.T("Cancel")
                                                    </a>
                                                    <a href="@Url.Action("Details", new { id = Model.ID })" class="btn btn-outline-success ml-1">
                                                        <i class="bx bx-show"></i> @L.T("Details")
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }

    <script>
        $(document).ready(function() {
            function updateTotal() {
                var day = parseFloat($('.day-shift-input').val()) || 0;
                var night = parseFloat($('.night-shift-input').val()) || 0;
                var total = day + night;
                $('#totalDisplay').val(total.toFixed(3));
                $('input[name="Total"]').val(total);
            }
            $('.day-shift-input, .night-shift-input').on('input', updateTotal);
            updateTotal();
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
