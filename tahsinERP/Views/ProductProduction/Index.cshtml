@model List<tahsinERP.Models.PRODUCT_PRODUCTION>
@{
    ViewBag.Title = "Ishlab Chiqarish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">Ishlab Chiqarish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "ProductProduction")" class="btn btn-success bg-light invoice-create" role="button">
                                <i class="bx bx-plus"></i> Yangi Ishlab Chiqarish
                            </a>
                        </div>
                    }

                    @if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Expenses"))
                    {
                        <div class="invoice-create-btn mb-1">
                            @using (Html.BeginForm("ReconcileProductionConsumption", "ProductProduction", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Har bir ishlab chiqarish uchun xomashyo chiqimini «ishlab chiqarilgan son × BOM» ga moslab qayta hisoblashni xohlaysizmi?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary" title="Avtomatik xomashyo chiqimlarini BOM bo'yicha qayta hisoblash">
                                    <i class="bx bx-wrench"></i> Chiqimni tuzatish (BOM)
                                </button>
                            }
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    }

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- Search and Filter -->
                                    <div class="users-list-filter px-1">
                                        <form method="get" action="@Url.Action("Index")">
                                            <div class="row border rounded py-2 mb-2">
                                                <div class="col-12 col-sm-6 col-lg-3">
                                                    <label>Dan</label>
                                                    <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd") ?? "")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-3">
                                                    <label>Gacha</label>
                                                    <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd") ?? "")" />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Sex</label>
                                                    @Html.DropDownList("shopID", ViewBag.Shops as SelectList, "Barchasi", new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Mahsulot</label>
                                                    @Html.DropDownList("productID", ViewBag.Products as SelectList, "Barchasi", new { @class = "form-control select2" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>&nbsp;</label>
                                                    <button type="submit" class="btn btn-success btn-block">Qidirish</button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- datatable start -->
                                    <div class="card-datatable table-responsive">
                                        <table id="productionTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Sana</th>
                                                    <th>Mahsulot</th>
                                                    <th>TSex</th>
                                                    <th>Kunduzgi</th>
                                                    <th>Tungi</th>
                                                    <th>Jami</th>
                                                    <th>Izoh</th>
                                                    <th>Amallar</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@item.Date.ToString("dd.MM.yyyy")</td>
                                                            <td>@(item.PRODUCT?.PNo ?? item.ProductID.ToString())</td>
                                                            <td>@(item.SHOP?.ShopName ?? item.ShopID.ToString())</td>
                                                            <td>@item.DayShift.ToString("N3")</td>
                                                            <td>@item.NightShift.ToString("N3")</td>
                                                            <td><strong>@item.Total.ToString("N3")</strong></td>
                                                            <td>@(item.Comment ?? "-")</td>
                                                            <td>
                                                                <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-outline-success" title="Ko'rish"><i class="bx bx-show"></i></a>
                                                                @if (changePermit)
                                                                {
                                                                    <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-outline-success" title="Tahrirlash"><i class="bx bx-edit"></i></a>
                                                                    using (Html.BeginForm("Delete", "ProductProduction", new { id = item.ID }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Ishlab chiqarishni oʻchirishni tasdiqlaysizmi? Kirim va xomashyo chiqimi bekor qilinadi.');" }))
                                                                    {
                                                                        @Html.AntiForgeryToken()
                                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="O'chirish"><i class="bx bx-trash"></i></button>
                                                                    }
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                $('.select2').select2({
                    placeholder: "Barchasi",
                    allowClear: true
                });

                $('#productionTable').DataTable({
                    "language": {
                        "search": "Qidirish:",
                        "lengthMenu": "_MENU_ ta ko'rsatish",
                        "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                        "infoEmpty": "Yozuvlar yo'q",
                        "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                        "paginate": {
                            "first": "Birinchi",
                            "last": "Oxirgi",
                            "next": "Keyingi",
                            "previous": "Oldingi"
                        },
                        "zeroRecords": "Ma'lumot topilmadi"
                    },
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Barchasi"]],
                    "order": [[3, "desc"]],
                    "columnDefs": [
                        { "type": "date", "targets": 3 }
                    ],
                    "scrollX": true,
                    dom: 'lBfrtip',
                    buttons: erpDataTable.buttons({ fileName: 'Ishlab_Chiqarish', pdfTitle: 'Ishlab Chiqarish' })
                });
            });
        </script>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

