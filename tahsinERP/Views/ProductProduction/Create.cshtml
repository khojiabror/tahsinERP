@model tahsinERP.ViewModels.ProductProductionDailyEntryViewModel
@{
    ViewBag.Title = "Kunlik Ishlab Chiqarish Kiritish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Create", "ProductProduction", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/ProductProduction/Index">Ishlab Chiqarish</a>
                                        </li>
                                        <li class="breadcrumb-item active">Kunlik Ishlab Chiqarish</li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="basic-select2">
                        <div class="row">
                            <div class="col-xl-12 col-md-12 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            <div class="row">
                                                <div class="col-lg-12 col-md-6 mt-25">
                                                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                                                    @if (TempData["Error"] != null)
                                                    {
                                                        <div class="alert alert-danger">@TempData["Error"]</div>
                                                    }
                                                    <hr>
                                                    
                                                    <div class="row">
                                                        <div class="col-md-4">
                                                            <h6 class="invoice-to">Reja sanasi *</h6>
                                                            <fieldset class="invoice-address form-group">
                                                                @Html.TextBoxFor(model => model.Date, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @required = "required", @id = "planDate" })
                                                                @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                                                            </fieldset>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <h6 class="invoice-to">Fakt ishlab chiqarish sanasi *</h6>
                                                            <fieldset class="invoice-address form-group">
                                                                @Html.TextBoxFor(model => model.ProductionDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @required = "required", @id = "factProductionDate" })
                                                                @Html.ValidationMessageFor(model => model.ProductionDate, "", new { @class = "text-danger" })
                                                            </fieldset>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <h6 class="invoice-to">Sex *</h6>
                                                            <fieldset class="invoice-address form-group">
                                                                @Html.DropDownListFor(model => model.ShopID, ViewBag.Shops as SelectList, "Sexni tanlang", new { @class = "form-control", @required = "required", @id = "shopSelect" })
                                                                @Html.ValidationMessageFor(model => model.ShopID, "", new { @class = "text-danger" })
                                                            </fieldset>
                                                        </div>
                                                        <div class="col-md-12">
                                                            <h6 class="invoice-to">&nbsp;</h6>
                                                            <fieldset class="invoice-address form-group">
                                                                <button type="button" id="loadPlannedBtn" class="btn btn-primary btn-block">
                                                                    <i class="bx bx-refresh"></i> Rejalashtirilgan mahsulotlarni yuklash
                                                                </button>
                                                            </fieldset>
                                                        </div>
                                                    </div>

                                                    <hr />

                                                    <div id="productionItemsContainer">
                                                        <table class="table table-bordered" id="productionItemsTable">
                                                            <thead>
                                                                <tr>
                                                                    <th>Mahsulot</th>
                                                                    <th>Reja (Kunduzgi)</th>
                                                                    <th>Reja (Tungi)</th>
                                                                    <th>Reja (Jami)</th>
                                                                    <th>Kunduzgi smena</th>
                                                                    <th>Tungi smena</th>
                                                                    <th>Jami</th>
                                                                    <th>Izoh</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @if (Model.ProductionItems != null && Model.ProductionItems.Any())
                                                                {
                                                                    for (int i = 0; i < Model.ProductionItems.Count; i++)
                                                                    {
                                                                        var item = Model.ProductionItems[i];
                                                                        <tr>
                                                                            <td>
                                                                                @item.ProductNo - @item.ProductName
                                                                                @Html.Hidden($"ProductionItems[{i}].ProductID", item.ProductID)
                                                                                @Html.Hidden($"ProductionItems[{i}].ID", item.ID)
                                                                                @if (item.IsPlanned)
                                                                                {
                                                                                    <span class="badge badge-info">Rejalashtirilgan</span>
                                                                                }
                                                                            </td>
                                                                            <td>@(item.PlannedDayShift?.ToString("N3") ?? "-")</td>
                                                                            <td>@(item.PlannedNightShift?.ToString("N3") ?? "-")</td>
                                                                            <td>@(item.PlannedTotal?.ToString("N3") ?? "-")</td>
                                                                            <td>
                                                                                @Html.TextBox($"ProductionItems[{i}].DayShift", item.DayShift, new { @class = "form-control day-shift", @type = "number", @step = "0.001", @min = "0" })
                                                                            </td>
                                                                            <td>
                                                                                @Html.TextBox($"ProductionItems[{i}].NightShift", item.NightShift, new { @class = "form-control night-shift", @type = "number", @step = "0.001", @min = "0" })
                                                                            </td>
                                                                            <td>
                                                                                <span class="total-display">@item.Total.ToString("N3")</span>
                                                                                @Html.Hidden($"ProductionItems[{i}].Total", item.Total, new { @class = "total-input" })
                                                                            </td>
                                                                            <td>
                                                                                @Html.TextBox($"ProductionItems[{i}].Comment", item.Comment, new { @class = "form-control" })
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <tr>
                                                                        <td colspan="8" class="text-center">
                                                                            Sana va sexni tanlang va "Rejalashtirilgan mahsulotlarni yuklash" tugmasini bosing
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="invoice-action">
                            <div class="row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary mr-1">
                                        <i class="bx bx-save"></i> Saqlash
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                                        <i class="bx bx-x"></i> Bekor qilish
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }

    @section scripts {
    <script>
        // Wait for jQuery to be loaded
        (function() {
            function initProductionPage() {
                if (typeof jQuery === 'undefined') {
                    console.error('jQuery is not loaded!');
                    setTimeout(initProductionPage, 100);
                    return;
                }

        $(document).ready(function() {
            // Load planned products
            $('#loadPlannedBtn').on('click', function() {
                var date = $('#planDate').val();
                var shopID = $('#shopSelect').val();
                
                if (!date || !shopID) {
                    alert('Iltimos, sana va sexni tanlang');
                    return;
                }

                // Disable button during loading
                var $btn = $(this);
                $btn.prop('disabled', true).html('<i class="bx bx-loader bx-spin"></i> Yuklanmoqda...');

                $.ajax({
                    url: '@Url.Action("GetPlannedProducts", "ProductProduction")',
                    type: 'GET',
                    data: { 
                        date: date, 
                        shopID: parseInt(shopID) 
                    },
                    dataType: 'json',
                    success: function(data) {
                        var tbody = $('#productionItemsTable tbody');
                        tbody.empty();
                        
                        if (!data || data.length === 0) {
                            tbody.append('<tr><td colspan="8" class="text-center">Rejalashtirilgan mahsulotlar topilmadi</td></tr>');
                            $btn.prop('disabled', false).html('<i class="bx bx-refresh"></i> Rejalashtirilgan mahsulotlarni yuklash');
                            return;
                        }

                        $.each(data, function(index, item) {
                            var productName = (item.ProductName || '').replace(/'/g, "&#39;");
                            var comment = (item.Comment || '').replace(/'/g, "&#39;");
                            
                            var row = '<tr>' +
                                '<td>' + (item.ProductNo || '') + ' - ' + productName +
                                '<input type="hidden" name="ProductionItems[' + index + '].ProductID" value="' + (item.ProductID || '') + '" />' +
                                '<input type="hidden" name="ProductionItems[' + index + '].ID" value="' + (item.ID || '') + '" />';
                            
                            if (item.IsPlanned) {
                                row += ' <span class="badge badge-info">Rejalashtirilgan</span>';
                            }
                            
                            row += '</td>' +
                                '<td>' + (item.PlannedDayShift ? parseFloat(item.PlannedDayShift).toFixed(3) : '-') + '</td>' +
                                '<td>' + (item.PlannedNightShift ? parseFloat(item.PlannedNightShift).toFixed(3) : '-') + '</td>' +
                                '<td>' + (item.PlannedTotal ? parseFloat(item.PlannedTotal).toFixed(3) : '-') + '</td>' +
                                '<td><input type="number" step="0.001" min="0" class="form-control day-shift" name="ProductionItems[' + index + '].DayShift" value="' + (item.DayShift || 0) + '" /></td>' +
                                '<td><input type="number" step="0.001" min="0" class="form-control night-shift" name="ProductionItems[' + index + '].NightShift" value="' + (item.NightShift || 0) + '" /></td>' +
                                '<td><span class="total-display">' + (item.Total ? parseFloat(item.Total).toFixed(3) : '0.000') + '</span>' +
                                '<input type="hidden" class="total-input" name="ProductionItems[' + index + '].Total" value="' + (item.Total || 0) + '" /></td>' +
                                '<td><input type="text" class="form-control" name="ProductionItems[' + index + '].Comment" value="' + comment + '" /></td>' +
                                '</tr>';
                            tbody.append(row);
                        });

                        // Attach total calculation
                        attachTotalCalculation();
                        
                        // Re-enable button
                        $btn.prop('disabled', false).html('<i class="bx bx-refresh"></i> Rejalashtirilgan mahsulotlarni yuklash');
                    },
                    error: function(xhr, status, error) {
                        console.error('AJAX Error:', status, error);
                        console.error('Response:', xhr.responseText);
                        alert('Xatolik yuz berdi: ' + (xhr.responseJSON?.message || error || 'Noma\'lum xatolik'));
                        $btn.prop('disabled', false).html('<i class="bx bx-refresh"></i> Rejalashtirilgan mahsulotlarni yuklash');
                    }
                });
            });

            // Calculate total when day/night shift changes
            function attachTotalCalculation() {
                $('.day-shift, .night-shift').off('input').on('input', function() {
                    var row = $(this).closest('tr');
                    var dayShift = parseFloat(row.find('.day-shift').val()) || 0;
                    var nightShift = parseFloat(row.find('.night-shift').val()) || 0;
                    var total = dayShift + nightShift;
                    row.find('.total-display').text(total.toFixed(3));
                    row.find('.total-input').val(total);
                });
            }

            attachTotalCalculation();
        });
            }

            // Start initialization
            initProductionPage();
        })();
    </script>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

