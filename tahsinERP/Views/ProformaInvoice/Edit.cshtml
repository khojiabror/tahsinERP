
@model tahsinERP.Models.P_PROFORMA_INVOICES
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Edit", "ProformaInvoice", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/ProformaInvoice/Index">Proforma Invoyslar</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            @Model.PrInvoiceNo raqamli proforma invoys ni tahrirlash
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <!-- app invoice View Page -->
                    <section class="basic-select2">
                        <div class="row">
                            <!-- invoice view page -->
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            <div class="row">
                                                <div class="col-lg-12 col-md-6 mt-25">
                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                    <hr>
                                                    <h6 class="invoice-to">Proforma invoys raqami</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.PrInvoiceNo, new { @class = "form-control round", @placeholder = "Nomi", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.PrInvoiceNo, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">Invoys</h6>
                                                    <fieldset class="form-group">
                                                        @Html.DropDownListFor(model => model.InvoiceID, ViewBag.invoices as SelectList, new { @class = "form-control round", @required = "required" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">Ta'minotchi</h6>
                                                    <fieldset class="form-group">
                                                        @Html.DropDownListFor(model => model.SupplierID, ViewBag.suppliers as SelectList, new { @class = "form-control round", @required = "required" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">Miqdori</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Amount, new { @class = "form-control round", @placeholder = "DUNS", @required = "required", @type = "number" })
                                                        @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">Valyuta</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Currency, new { @class = "form-control round", @placeholder = "Mamlakat" })
                                                        @Html.ValidationMessageFor(model => model.Currency, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <div class="col-md-6 col-12 form-group position-relative has-icon-left">
                                                        <label>Tugaydigan sanasi</label>
                                                        @Html.TextBoxFor(model => model.InvoiceDate, new { @class = "form-control pickadate-months-year round", @placeholder = "Tugaydigan sanasi" })
                                                        @Html.ValidationMessageFor(model => model.InvoiceDate, "", new { @class = "text-danger" })
                                                        <div class="form-control-position mt-2">
                                                            <i class='bx bx-calendar'></i>
                                                        </div>
                                                    </div>
                                                    <ul class="list-group list-group-flush">
                                                        <li class="list-group-item border-0 pb-0">
                                                            <button class="btn btn-primary btn-block subtotal-preview-btn" name="edit" type="submit" value="Edit">
                                                                <i class='bx bx-save'></i>
                                                                Saqlash
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                            <hr>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}