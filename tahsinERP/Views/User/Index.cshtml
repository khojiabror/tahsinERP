@model List<tahsinERP.ViewModels.UserViewModel>
@{
    ViewBag.Title = "Foydalanuvchilar";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Foydalanuvchilar</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item active">Foydalanuvchilar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "User")" class="btn btn-success">
                                <i class="bx bx-plus"></i> Yangi foydalanuvchi qo'shish
                            </a>
                        </div>
                    }

                    <div class="card mb-2">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-12 col-sm-6 col-lg-4 mb-2">
                                    <label for="RoleId" class="form-label">Rol bo'yicha filtrlash</label>
                                    @Html.DropDownList("RoleId", ViewBag.RoleList as SelectList, "Barcha rollar", new { @class = "form-control", @id = "RoleId" })
                                </div>
                                <div class="col-12 col-sm-6 col-lg-8 d-flex align-items-end mb-2">
                                    <a href="@Url.Action("Index", "User", new { status = "InActive" })" class="btn btn-warning mr-2">
                                        <i class="bx bx-user-x"></i> Nofaol foydalanuvchilar
                                    </a>
                                    <a href="@Url.Action("Index", "User")" class="btn btn-secondary">
                                        <i class="bx bx-refresh"></i> Yangilash
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">

                                    <!-- Table -->
                                    <div class="table-responsive">
                                        <table id="userDataTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Foydalanuvchi nomi</th>
                                                    <th>F.I.Sh</th>
                                                    <th>E-mail</th>
                                                    <th>Roli</th>
                                                    <th>Faolligi</th>
                                                    @if (changePermit)
                                                    {
                                                        <th class="text-center">Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>
                                                            <a href="@Url.Action("Details", "User", new { id = item.ID })" class="font-weight-bold">
                                                                @item.UName
                                                            </a>
                                                        </td>
                                                        <td>@item.FullName</td>
                                                        <td>@item.Email</td>
                                                        <td><span class="badge badge-light-primary">@item.Role</span></td>
                                                        <td>
                                                            @if (item.IsActive)
                                                            {
                                                                <span class="badge badge-light-success">Faol</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge badge-light-danger">Nofaol</span>
                                                            }
                                                        </td>
                                                        @if (changePermit)
                                                        {
                                                            <td class="text-center">
                                                                <a href="@Url.Action("Edit", "User", new { id = item.ID })" class="btn btn-sm btn-outline-primary" title="Tahrirlash">
                                                                    <i class="bx bx-edit"></i>
                                                                </a>
                                                                <a href="@Url.Action("Delete", "User", new { id = item.ID })" class="btn btn-sm btn-outline-danger" title="O'chirish">
                                                                    <i class="bx bx-trash"></i>
                                                                </a>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <style>
        .users-list-filter .card {
            border: 1px solid #e0e0e0;
        }
        .users-list-filter .form-label {
            font-weight: 500;
            margin-bottom: 0.5rem;
        }
    </style>

    <!-- DataTables Buttons CSS and JS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            var table = $('#userDataTable').DataTable({
                "language": {
                    "search": "Qidirish:",
                    "lengthMenu": "_MENU_ ta ko'rsatish",
                    "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    "infoEmpty": "Yozuvlar yo'q",
                    "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                    "paginate": {
                        "first": "Birinchi",
                        "last": "Oxirgi",
                        "next": "Keyingi",
                        "previous": "Oldingi"
                    },
                    "zeroRecords": "Ma'lumot topilmadi"
                },
                "pageLength": 25,
                "order": [[0, "asc"]],
                @if (changePermit)
                {
                    <text>
                    "columnDefs": [
                        { "orderable": false, "targets": -1 }
                    ],
                    </text>
                }
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bx bx-file"></i> Excel ga export',
                        className: 'btn btn-success btn-sm mb-2',
                        exportOptions: {
                            columns: ':not(:last-child)',
                            format: {
                                body: function (data, row, column, node) {
                                    // Remove HTML tags from data
                                    return data.replace(/<[^>]*>/g, '').trim();
                                }
                            }
                        },
                        filename: function() {
                            return 'Foydalanuvchilar_' + new Date().toISOString().slice(0,10);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bx bx-file-blank"></i> PDF ga export',
                        className: 'btn btn-danger btn-sm mb-2',
                        exportOptions: {
                            columns: ':not(:last-child)',
                            format: {
                                body: function (data, row, column, node) {
                                    // Remove HTML tags from data
                                    return data.replace(/<[^>]*>/g, '').trim();
                                }
                            }
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        filename: function() {
                            return 'Foydalanuvchilar_' + new Date().toISOString().slice(0,10);
                        },
                        title: 'Foydalanuvchilar ro\'yxati',
                        customize: function (doc) {
                            doc.defaultStyle.fontSize = 9;
                            doc.styles.tableHeader.fontSize = 10;
                        }
                    }
                ]
            });

            // Role filter
            $('#RoleId').on('change', function() {
                var roleId = this.value;
                if (roleId) {
                    window.location.href = '@Url.Action("Index", "User")?roleID=' + roleId;
                } else {
                    window.location.href = '@Url.Action("Index", "User")';
                }
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
