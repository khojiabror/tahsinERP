@model tahsinERP.ViewModels.UserViewModel
@{
    ViewBag.Title = "Yangi foydalanuvchi qo'shish";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Create", "User", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                        <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                        <li class="breadcrumb-item"><a href="~/User/Index">Foydalanuvchilar</a></li>
                                        <li class="breadcrumb-item active">Yangi foydalanuvchi</li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="content-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    }

                    <section class="basic-select2">
                        <div class="row">
                            <div class="col-xl-12 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row my-2 py-50">
                                                <div class="col-sm-6 col-12">
                                                    <h6 class="invoice-to">Foydalanuvchi nomi <span class="text-danger">*</span></h6>
                                                    <fieldset class="form-group">
                                                        @Html.TextBoxFor(model => model.UName, new { @class = "form-control", @placeholder = "Foydalanuvchi nomi", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.UName, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">E-mail</h6>
                                                    <fieldset class="form-group">
                                                        @Html.TextBoxFor(model => model.Email, new { @class = "form-control", @placeholder = "E-mail", type = "email" })
                                                        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">To'liq F.I.Sh</h6>
                                                    <fieldset class="form-group">
                                                        @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", @placeholder = "Ismi, familyasi va otasining ismi" })
                                                        @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                </div>

                                                <div class="col-sm-6 col-12">
                                                    <h6 class="invoice-to">Foydalanuvchi sur'ati</h6>
                                                    <fieldset class="form-group">
                                                        <input type="file" id="userPhotoUpload" name="userPhotoUpload" accept="image/*" class="form-control" />
                                                        <small class="text-muted">Maksimal hajmi: 2 MB</small>
                                                        @Html.ValidationMessageFor(model => model.File, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">Roli <span class="text-danger">*</span></h6>
                                                    <fieldset class="form-group">
                                                        @Html.DropDownList("RoleID", null, "Rolni tanlang", htmlAttributes: new { @class = "form-control select2", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.RoleID, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">Kalit so'zi <span class="text-danger">*</span></h6>
                                                    <fieldset class="form-group">
                                                        @Html.PasswordFor(model => model.Password, new { @class = "form-control", @placeholder = "Kalit so'zi", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                                                    </fieldset>

                                                    <h6 class="invoice-to">Faolligi</h6>
                                                    <fieldset class="form-group">
                                                        <div class="checkbox checkbox-secondary checkbox-glow">
                                                            @Html.CheckBoxFor(model => model.IsActive, new { @type = "checkbox", @id = "checkboxGlow2" })
                                                            <label for="checkboxGlow2">Faol</label>
                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                </div>
                                            </div>

                                            <hr>

                                            <div class="row">
                                                <div class="col-12">
                                                    <button class="btn btn-primary" type="submit">
                                                        <i class='bx bx-save'></i> Saqlash
                                                    </button>
                                                    <a href="@Url.Action("Index", "User")" class="btn btn-secondary">
                                                        <i class='bx bx-x'></i> Bekor qilish
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
