@model tahsinERP.ViewModels.UserViewModel
@{
    ViewBag.Title = L.T("Core_UserData");
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/AdminPanel"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/User/Index">@L.T("Adm_Users")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Core_Info")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <section id="page-account-settings">
                    <div class="row">
                        <div class="col-12">
                            <div class="row">
                                <!-- left menu section -->
                                <div class="col-md-3 mb-2 mb-md-0 pills-stacked">
                                    <ul class="nav nav-pills flex-column">
                                        <li class="nav-item">
                                            <a class="nav-link d-flex align-items-center active" id="account-pill-general" data-toggle="pill" href="#account-vertical-general" aria-expanded="true">
                                                <i class="bx bx-cog"></i>
                                                <span>@L.T("Core_UserData")</span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link d-flex align-items-center" id="account-pill-info" data-toggle="pill" href="#account-vertical-info" aria-expanded="false">
                                                <i class="bx bx-info-circle"></i>
                                                <span>@L.T("Core_ActionsInfo")</span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>

                                <!-- right content section -->
                                <div class="col-md-9">
                                    <div class="card">
                                        <div class="card-content">
                                            <div class="card-body">
                                                <div class="tab-content">
                                                    <div role="tabpanel" class="tab-pane active" id="account-vertical-general" aria-labelledby="account-pill-general" aria-expanded="true">
                                                        <div class="card-content">
                                                            <div class="card-body pb-0 mx-25">
                                                                <div class="row my-2 py-50">
                                                                    <div class="col-sm-6 col-12">
                                                                        <h4 class="text-primary mb-3">@L.T("Core_UserData")</h4>
                                                                        <p><strong>@L.T("Core_UserNameColon")</strong> @Html.DisplayFor(model => model.UName)</p>
                                                                        <p><strong>@L.T("Core_EmailColon")</strong> @Html.DisplayFor(model => model.Email)</p>
                                                                        <p><strong>@L.T("Core_FullNameColon")</strong> @Html.DisplayFor(model => model.FullName)</p>
                                                                        <p><strong>@L.T("Core_RoleColon")</strong> <span class="badge badge-light-primary">@Html.DisplayFor(model => model.Role)</span></p>
                                                                        <p>
                                                                            <strong>@L.T("Core_ActivityColon")</strong>
                                                                            @if (Model.IsActive)
                                                                            {
                                                                                <span class="badge badge-light-success">@L.T("Active")</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="badge badge-light-danger">@L.T("Inactive")</span>
                                                                            }
                                                                        </p>
                                                                    </div>
                                                                    <div class="col-sm-6 col-12 text-center">
                                                                        <h4 class="text-primary mb-3">@L.T("Core_UserPhoto")</h4>
                                                                        @if (ViewBag.Base64String != null)
                                                                        {
                                                                            <img alt="" src="@ViewBag.Base64String" style="height:200px;width:200px;border-radius:8px;border:2px solid #ddd;" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="text-muted">
                                                                                <i class="bx bx-user" style="font-size:100px;"></i>
                                                                                <p>@L.T("Core_NoPhoto")</p>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </div>
                                                                <hr>
                                                                @if (changePermit)
                                                                {
                                                                    <div class="row">
                                                                        <div class="col-12">
                                                                            <a href="@Url.Action("Edit", "User", new { id = Model.ID })" class="btn btn-primary">
                                                                                <i class="bx bx-edit"></i> @L.T("Edit")
                                                                            </a>
                                                                            <a href="@Url.Action("Index", "User")" class="btn btn-secondary">
                                                                                <i class="bx bx-arrow-back"></i> @L.T("Back")
                                                                            </a>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="tab-pane fade" id="account-vertical-info" role="tabpanel" aria-labelledby="account-pill-info" aria-expanded="false">
                                                        <section id="column-selectors">
                                                            <div class="row">
                                                                <div class="col-12">
                                                                    <div class="card">
                                                                        <div class="card-header">
                                                                            <h4 class="card-title">@L.T("Core_UserActivityTitle")</h4>
                                                                        </div>
                                                                        <div class="card-content">
                                                                            <div class="card-body card-dashboard">
                                                                                <div class="table-responsive">
                                                                                    <table id="userLogsDataTable" class="table table-striped table-bordered" style="width:100%">
                                                                                        <thead>
                                                                                            <tr>
                                                                                                <th>Controller</th>
                                                                                                <th>@L.T("Core_ActionCol")</th>
                                                                                                <th>@L.T("Core_DateCol")</th>
                                                                                                <th>@L.T("Core_TimeCol")</th>
                                                                                                <th>@L.T("Core_IpAddress")</th>
                                                                                                <th>@L.T("Core_MacAddress")</th>
                                                                                            </tr>
                                                                                        </thead>
                                                                                        <tbody>
                                                                                            @if (Model.logs != null && Model.logs.Any())
                                                                                            {
                                                                                                foreach (var item in Model.logs)
                                                                                                {
                                                                                                    <tr>
                                                                                                        <td>@item.ControllerName</td>
                                                                                                        <td>@item.ActionName</td>
                                                                                                        <td>@item.DateTime.ToString("yyyy-MM-dd")</td>
                                                                                                        <td>@item.DateTime.ToString("HH:mm:ss")</td>
                                                                                                        <td>@item.IP</td>
                                                                                                        <td>@item.MacAddr</td>
                                                                                                    </tr>
                                                                                                }
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <tr>
                                                                                                    <td colspan="6" class="text-center text-muted">@L.T("Core_NoDataPlural")</td>
                                                                                                </tr>
                                                                                            }
                                                                                        </tbody>
                                                                                    </table>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </section>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                $('#userLogsDataTable').DataTable({
                    language: erpDataTable.language,
                    "pageLength": 25,
                    "lengthMenu": [[25, 50, 100, -1], [25, 50, 100, '@L.Js("All")']],
                    "order": [[2, "desc"], [3, "desc"]], // Sort by date desc, then time desc
                    "scrollX": true,
                    "columnDefs": [
                        { "type": "date", "targets": 2 } // Date column for proper sorting
                    ]
                });
            });
        </script>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
