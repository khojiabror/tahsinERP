@model tahsinERP.Models.HR_PAYROLL_HEADERS
@{
    ViewBag.Title = L.T("Hr_PayDelete");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_PayTitle")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Delete")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="alert alert-warning">
                    <strong>@L.T("Hr_Attention")</strong> @L.T("Hr_PayDeleteConfirm")
                </div>

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">@L.T("Hr_Year"):</dt>
                                <dd class="col-sm-9">@Model.Year</dd>

                                <dt class="col-sm-3">@L.T("Hr_Month"):</dt>
                                <dd class="col-sm-9">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month)</dd>

                                <dt class="col-sm-3">@L.T("Hr_OrgUnit"):</dt>
                                <dd class="col-sm-9">@(Model.HR_ORG_UNITS?.Name ?? L.T("Hr_WholeCompany"))</dd>

                                <dt class="col-sm-3">@L.T("Type"):</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-info">
                                        @(Model.PayrollType == "Hourly" ? L.T("Hr_PayHourly") : Model.PayrollType == "PieceRate" ? L.T("Hr_PayPiece") : Model.PayrollType ?? "-")
                                    </span>
                                </dd>

                                <dt class="col-sm-3">@L.T("Status"):</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.Status == "Approved" ? "success" : Model.Status == "Posted" ? "info" : "warning")">
                                        @(Model.Status == "Draft" ? L.T("Hr_PayStatus_Draft") : Model.Status == "Approved" ? L.T("Hr_PayStatus_Approved") : Model.Status == "Posted" ? L.T("Hr_PayStatus_Posted") : Model.Status ?? "-")
                                    </span>
                                </dd>

                                <dt class="col-sm-3">@L.T("CreatedAt"):</dt>
                                <dd class="col-sm-9">@Model.CreatedDT.ToString("dd.MM.yyyy HH:mm")</dd>
                            </dl>

                            @using (Html.BeginForm("Delete", "HrPayroll", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", Model.ID)

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bx bx-trash"></i> @L.T("Delete")
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("Cancel")</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

