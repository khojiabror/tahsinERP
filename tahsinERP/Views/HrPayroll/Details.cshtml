@model tahsinERP.ViewModels.HR.HrPayrollHeaderViewModel
@using tahsinERP.Models
@{
    ViewBag.Title = L.T("Hr_PayDetails");
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool changePermit = RoleHelper.IsChangePermitted(User.Identity.Name, "HrPayroll");
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_PayTitle")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Details")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row mb-2">
                    <div class="col-12">
                        <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary"><i class="bx bx-left-arrow-alt"></i> @L.T("Hr_ToList")</a>
                        @if (changePermit)
                        {
                            <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-sm btn-primary">
                                <i class="bx bx-edit"></i> @L.T("Edit")
                            </a>
                        }
                        <a href="@Url.Action("Export", new { id = Model.ID })" class="btn btn-sm btn-success">
                            <i class="bx bx-export"></i> @L.T("ExportExcel")
                        </a>
                        <a href="@Url.Action("Report", new { id = Model.ID })" class="btn btn-sm btn-info" target="_blank">
                            <i class="bx bx-printer"></i> @L.T("Print")
                        </a>
                        <span class="badge badge-@(Model.Status == "Approved" ? "success" : Model.Status == "Posted" ? "info" : "warning") ml-2">
                            @L.T("Status"): @(Model.Status == "Draft" ? L.T("Hr_PayStatus_Draft") : Model.Status == "Approved" ? L.T("Hr_PayStatus_Approved") : L.T("Hr_PayStatus_Posted"))
                        </span>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title mb-0">@L.T("Hr_YearN", Model.Year) @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) — @(Model.OrgUnitName ?? L.T("Hr_WholeCompany"))</h4>
                        <p class="text-muted mb-0 small">
                            @L.T("Type"): @(Model.PayrollType == "PieceRate" ? L.T("Hr_PayPiece") : L.T("Hr_PayHourly")) · @L.T("CreatedAt"): @Model.CreatedDT.ToString("dd.MM.yyyy HH:mm")
                            @if (Model.ApprovedDT.HasValue)
                            {
                                <span> · @L.T("Hr_PayStatus_Approved"): @Model.ApprovedDT.Value.ToString("dd.MM.yyyy HH:mm")</span>
                            }
                        </p>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <strong>@L.T("Hr_TotalAccrued"):</strong> @Model.TotalGrossSalary.ToString("N2")
                            </div>
                            @if (Model.ApplyIncomeTax)
                            {
                                <div class="col-md-3">
                                    <strong>@L.T("Hr_TotalIncomeTax"):</strong> @Model.TotalIncomeTax.ToString("N2")
                                </div>
                            }
                            <div class="col-md-3">
                                <strong>@L.T("Hr_Bonuses"):</strong> @Model.Lines.Sum(l => l.Bonuses).ToString("N2")
                            </div>
                            <div class="col-md-3">
                                <strong>@L.T("Hr_Penalties"):</strong> @Model.Lines.Sum(l => l.Penalties).ToString("N2")
                            </div>
                            <div class="col-md-3">
                                <strong>@L.T("Hr_NetPay"):</strong> <span class="text-success font-weight-bold">@Model.TotalNetSalary.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped" id="payrollDetailsGrid">
                                    <thead>
                                        <tr>
                                            <th>№</th>
                                            <th>@L.T("Hr_TabNoShort")</th>
                                            <th>@L.T("Hr_FullName")</th>
                                            <th>@L.T("Hr_Position")</th>
                                            <th>@L.T("Hr_BaseSalary")</th>
                                            <th>@L.T("Hr_HoursWorked")</th>
                                            <th>@L.T("Hr_Accrued")</th>
                                            @if (Model.ApplyIncomeTax)
                                            {
                                                <th>@L.T("Hr_IncomeTax")</th>
                                            }
                                            <th>@L.T("Hr_Bonuses")</th>
                                            <th>@L.T("Hr_Penalties")</th>
                                            <th>@L.T("Hr_NetPay")</th>
                                            <th>@L.T("Currency")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int rowNum = 1; }
                                        @foreach (var line in Model.Lines)
                                        {
                                            <tr>
                                                <td>@rowNum</td>
                                                <td>@line.EmployeeTabNo</td>
                                                <td>@line.EmployeeFullName</td>
                                                <td>@line.PositionName</td>
                                                <td>@line.BaseSalary.ToString("N2")</td>
                                                <td>@line.HoursWorked.ToString("F2")</td>
                                                <td>@line.GrossSalary.ToString("N2")</td>
                                                @if (Model.ApplyIncomeTax)
                                                {
                                                    <td>@line.IncomeTaxAmount.ToString("N2")</td>
                                                }
                                                <td>@line.Bonuses.ToString("N2")</td>
                                                <td>@line.Penalties.ToString("N2")</td>
                                                <td>@line.NetSalary.ToString("N2")</td>
                                                <td>@(line.CurrencyCode ?? "-")</td>
                                            </tr>
                                            rowNum++;
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="font-weight-bold">
                                            <td colspan="6" class="text-right">@L.T("Hr_TotalUpper"):</td>
                                            <td>@Model.TotalGrossSalary.ToString("N2")</td>
                                            @if (Model.ApplyIncomeTax)
                                            {
                                                <td>@Model.TotalIncomeTax.ToString("N2")</td>
                                            }
                                            <td>@Model.Lines.Sum(l => l.Bonuses).ToString("N2")</td>
                                            <td>@Model.Lines.Sum(l => l.Penalties).ToString("N2")</td>
                                            <td class="text-success">@Model.TotalNetSalary.ToString("N2")</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            (function ($) {
                if (!$ || !$.fn.DataTable) return;
                $(document).ready(function () {
                    if ($.fn.DataTable.isDataTable('#payrollDetailsGrid')) {
                        $('#payrollDetailsGrid').DataTable().destroy();
                    }
                    $('#payrollDetailsGrid').DataTable({
                        language: erpDataTable.language,
                        pageLength: 25,
                        order: [[1, "asc"]],
                        autoWidth: false
                    });
                });
            })(window.jQuery || window.$j);
        </script>
    }
