@model tahsinERP.ViewModels.HR.HrPayrollHeaderViewModel
@using tahsinERP.Models
@{
    ViewBag.Title = "Ish haqi hisobi — batafsil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool changePermit = RoleHelper.IsChangePermitted(User.Identity.Name, "HrPayroll");
}

@if (RoleHelper.IsViewPermitted(User.Identity.Name, "HrPayroll"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Ish haqi hisobi</a></li>
                                    <li class="breadcrumb-item active">Batafsil</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row mb-2">
                    <div class="col-12">
                        <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary"><i class="bx bx-left-arrow-alt"></i> Ro'yxatga</a>
                        @if (changePermit)
                        {
                            <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-sm btn-primary">
                                <i class="bx bx-edit"></i> Tahrirlash
                            </a>
                        }
                        <a href="@Url.Action("Export", new { id = Model.ID })" class="btn btn-sm btn-success">
                            <i class="bx bx-export"></i> Excelga eksport
                        </a>
                        <a href="@Url.Action("Report", new { id = Model.ID })" class="btn btn-sm btn-info" target="_blank">
                            <i class="bx bx-printer"></i> Chop etish
                        </a>
                        <span class="badge badge-@(Model.Status == "Approved" ? "success" : Model.Status == "Posted" ? "info" : "warning") ml-2">
                            Holat: @(Model.Status == "Draft" ? "Qoralama" : Model.Status == "Approved" ? "Tasdiqlangan" : "O'tkazilgan")
                        </span>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title mb-0">@Model.Year yil @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) — @(Model.OrgUnitName ?? "Butun kompaniya")</h4>
                        <p class="text-muted mb-0 small">
                            Tur: @(Model.PayrollType == "PieceRate" ? "Ishbay" : "Soatbay") · Yaratilgan: @Model.CreatedDT.ToString("dd.MM.yyyy HH:mm")
                            @if (Model.ApprovedDT.HasValue)
                            {
                                <span> · Tasdiqlangan: @Model.ApprovedDT.Value.ToString("dd.MM.yyyy HH:mm")</span>
                            }
                        </p>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <strong>Jami hisoblangan:</strong> @Model.TotalGrossSalary.ToString("N2")
                            </div>
                            <div class="col-md-3">
                                <strong>Mukofotlar:</strong> @Model.Lines.Sum(l => l.Bonuses).ToString("N2")
                            </div>
                            <div class="col-md-3">
                                <strong>Jarimalar:</strong> @Model.Lines.Sum(l => l.Penalties).ToString("N2")
                            </div>
                            <div class="col-md-3">
                                <strong>To'lovga:</strong> <span class="text-success font-weight-bold">@Model.TotalNetSalary.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped" id="payrollDetailsGrid">
                                    <thead>
                                        <tr>
                                            <th>№</th>
                                            <th>Tab.№</th>
                                            <th>F.I.O.</th>
                                            <th>Lavozim</th>
                                            <th>Asosiy maosh</th>
                                            <th>Ishlangan soatlar</th>
                                            <th>Hisoblangan</th>
                                            <th>Mukofotlar</th>
                                            <th>Jarimalar</th>
                                            <th>To'lovga</th>
                                            <th>Valyuta</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int rowNum = 1; }
                                        @foreach (var line in Model.Lines)
                                        {
                                            <tr>
                                                <td>@rowNum</td>
                                                <td>@line.EmployeeTabNo</td>
                                                <td>@line.EmployeeFullName</td>
                                                <td>@line.PositionName</td>
                                                <td>@line.BaseSalary.ToString("N2")</td>
                                                <td>@line.HoursWorked.ToString("F2")</td>
                                                <td>@line.GrossSalary.ToString("N2")</td>
                                                <td>@line.Bonuses.ToString("N2")</td>
                                                <td>@line.Penalties.ToString("N2")</td>
                                                <td>@line.NetSalary.ToString("N2")</td>
                                                <td>@(line.CurrencyCode ?? "-")</td>
                                            </tr>
                                            rowNum++;
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="font-weight-bold">
                                            <td colspan="6" class="text-right">JAMI:</td>
                                            <td>@Model.TotalGrossSalary.ToString("N2")</td>
                                            <td>@Model.Lines.Sum(l => l.Bonuses).ToString("N2")</td>
                                            <td>@Model.Lines.Sum(l => l.Penalties).ToString("N2")</td>
                                            <td class="text-success">@Model.TotalNetSalary.ToString("N2")</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            (function ($) {
                if (!$ || !$.fn.DataTable) return;
                $(document).ready(function () {
                    if ($.fn.DataTable.isDataTable('#payrollDetailsGrid')) {
                        $('#payrollDetailsGrid').DataTable().destroy();
                    }
                    var dtUz = {
                        decimal: "",
                        emptyTable: "Jadvalda ma'lumot yo'q",
                        info: "_TOTAL_ yozuvdan _START_ - _END_ gacha ko'rsatilmoqda",
                        infoEmpty: "0 yozuvdan 0 - 0 gacha ko'rsatilmoqda",
                        infoFiltered: "(_MAX_ yozuvdan filtrlangan)",
                        lengthMenu: "Ko'rsatish _MENU_ ta yozuv",
                        loadingRecords: "Yuklanmoqda...",
                        processing: "Qayta ishlanmoqda...",
                        search: "Qidirish:",
                        zeroRecords: "Mos yozuv topilmadi",
                        paginate: { first: "Birinchi", last: "Oxirgi", next: "Keyingi", previous: "Oldingi" }
                    };
                    $('#payrollDetailsGrid').DataTable({
                        language: dtUz,
                        pageLength: 25,
                        order: [[1, "asc"]],
                        autoWidth: false
                    });
                });
            })(window.jQuery || window.$j);
        </script>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
