@model List<tahsinERP.ViewModels.HR.HrPayrollHeaderViewModel>
@{
    ViewBag.Title = L.T("Hr_PayTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    @{ bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrPayroll"); }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item active">@L.T("Hr_PayTitle")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (changePermit)
                {
                    <div class="invoice-create-btn mb-1">
                        <a href="@Url.Action("GenerateHourly")" class="btn btn-success">
                            <i class="bx bx-plus"></i> @L.T("Hr_PayCreateHourly")
                        </a>
                        <a href="@Url.Action("GeneratePieceRate")" class="btn btn-warning">
                            <i class="bx bx-plus"></i> @L.T("Hr_PayCreatePiece")
                        </a>
                        <a href="@Url.Action("Index", "HrSettings")" class="btn btn-outline-secondary" title="@L.T("Hr_SetCalendarCoefs")">
                            <i class="bx bx-cog"></i> @L.T("Settings")
                        </a>
                    </div>
                }

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <form method="get" action="@Url.Action("Index")" class="mb-2">
                                <div class="row">
                                    <div class="col-md-2">
                                        <select name="year" class="form-control">
                                            @for (int y = DateTime.Now.Year + 5; y >= DateTime.Now.Year - 5; y--)
                                            {
                                                <option value="@y" @(ViewBag.Year == y ? "selected" : "")>@y</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <select name="month" class="form-control">
                                            <option value="">@L.T("Hr_AllMonths")</option>
                                            @for (int i = 1; i <= 12; i++)
                                            {
                                                <option value="@i" @(ViewBag.Month == i ? "selected" : "")>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        @Html.DropDownList("orgUnitId", ViewBag.OrgUnitID as SelectList, L.T("Hr_AllOrgUnits"), new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-2">
                                        <select name="status" class="form-control">
                                            <option value="">@L.T("Hr_AllStatuses")</option>
                                            <option value="Draft" @(ViewBag.Status == "Draft" ? "selected" : "")>@L.T("Hr_PayStatus_Draft")</option>
                                            <option value="Approved" @(ViewBag.Status == "Approved" ? "selected" : "")>@L.T("Hr_PayStatus_Approved")</option>
                                            <option value="Posted" @(ViewBag.Status == "Posted" ? "selected" : "")>@L.T("Hr_PayStatus_Posted")</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <select name="payrollType" class="form-control">
                                            <option value="">@L.T("Hr_AllTypes")</option>
                                            <option value="Hourly" @(ViewBag.PayrollType == "Hourly" ? "selected" : "")>@L.T("Hr_PayHourly")</option>
                                            <option value="PieceRate" @(ViewBag.PayrollType == "PieceRate" ? "selected" : "")>@L.T("Hr_PayPiece")</option>
                                        </select>
                                    </div>
                                    <div class="col-md-1">
                                        <button type="submit" class="btn btn-primary">@L.T("Filter")</button>
                                    </div>
                                </div>
                            </form>

                            <div class="table-responsive">
                                <table id="payrollTable" class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>@L.T("Hr_Year")</th>
                                            <th>@L.T("Hr_Month")</th>
                                            <th>@L.T("Hr_OrgUnit")</th>
                                            <th>@L.T("Type")</th>
                                            <th>@L.T("Status")</th>
                                            <th>@L.T("Hr_PayAmount")</th>
                                            <th>@L.T("CreatedAt")</th>
                                            <th>@L.T("Actions")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.Year</td>
                                                <td>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.Month)</td>
                                                <td>@(item.OrgUnitName ?? L.T("Hr_WholeCompany"))</td>
                                                <td>
                                                    <span class="badge badge-@(item.PayrollType == "PieceRate" ? "warning" : "info")">
                                                        @(item.PayrollType == "PieceRate" ? L.T("Hr_PayPiece") : L.T("Hr_PayHourly"))
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge badge-@(item.Status == "Approved" ? "success" : item.Status == "Posted" ? "info" : "warning")">
                                                        @(item.Status == "Draft" ? L.T("Hr_PayStatus_Draft") : item.Status == "Approved" ? L.T("Hr_PayStatus_Approved") : L.T("Hr_PayStatus_Posted"))
                                                    </span>
                                                </td>
                                                <td>@item.TotalNetSalary.ToString("N2")</td>
                                                <td>@item.CreatedDT.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-secondary" title="@L.T("Details")">
                                                        <i class="bx bx-show"></i>
                                                    </a>
                                                    <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-info">
                                                        <i class="bx bx-edit"></i>
                                                    </a>
                                                    <a href="@Url.Action("Export", new { id = item.ID })" class="btn btn-sm btn-success">
                                                        <i class="bx bx-export"></i>
                                                    </a>
                                                    @if (changePermit && item.Status == "Draft")
                                                    {
                                                        <a href="#" data-post-url="@Url.Action("Approve", new { id = item.ID })" data-confirm="@L.T("Hr_PayApproveConfirmDefault")" class="btn btn-sm btn-primary" title="@L.T("Hr_PayApproveAndPost")">
                                                            <i class="bx bx-check"></i>
                                                        </a>
                                                        <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-danger" onclick="return confirm('@L.Js("Hr_PayDeleteQ")');">
                                                            <i class="bx bx-trash"></i>
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            (function ($) {
                if (!$ || !$.fn.DataTable) return;
                $(document).ready(function () {
                    if ($.fn.DataTable.isDataTable('#payrollTable')) {
                        $('#payrollTable').DataTable().destroy();
                    }
                    $('#payrollTable').DataTable({
                        language: erpDataTable.language,
                        "pageLength": 25,
                        "order": [[0, "desc"], [1, "desc"]],
                        dom: 'lBfrtip',
                        buttons: erpDataTable.buttons({ small: true })
                    });
                });
            })(window.jQuery || window.$j);
        </script>
    }

