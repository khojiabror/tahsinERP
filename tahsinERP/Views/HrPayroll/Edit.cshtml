@model tahsinERP.ViewModels.HR.HrPayrollHeaderViewModel
@{
    ViewBag.Title = "Ish haqi hisobini tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrPayroll"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Ish haqi hisobi @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) @Model.Year</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Ish haqi hisobi</a></li>
                                    <li class="breadcrumb-item active">Tahrirlash</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                <div class="row mb-2">
                    <div class="col-12">
                        <div class="btn-group" role="group">
                            <a href="@Url.Action("Export", new { id = Model.ID })" class="btn btn-sm btn-success">
                                <i class="bx bx-export"></i> Excelga eksport
                            </a>
                            <a href="@Url.Action("Report", new { id = Model.ID })" class="btn btn-sm btn-info" target="_blank">
                                <i class="bx bx-printer"></i> Chop etish
                            </a>
                            @if (Model.Status == "Draft")
                            {
                                <a href="@Url.Action("Approve", new { id = Model.ID })" class="btn btn-sm btn-warning" onclick="return confirm('Hisobni tasdiqlash?');">
                                    <i class="bx bx-check"></i> Tasdiqlash
                                </a>
                            }
                            @if (Model.Status == "Approved")
                            {
                                <button type="button" class="btn btn-sm btn-primary" data-toggle="modal" data-target="#postModal">
                                    <i class="bx bx-check-circle"></i> Moliya moduliga o'tkazish
                                </button>
                            }
                        </div>
                        <span class="badge badge-@(Model.Status == "Approved" ? "success" : Model.Status == "Posted" ? "info" : "warning") ml-2">
                            Holat: @(Model.Status == "Draft" ? "Qoralama" : Model.Status == "Approved" ? "Tasdiqlangan" : "O'tkazilgan")
                        </span>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Xulosa</h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <strong>Jami hisoblangan:</strong> @Model.TotalGrossSalary.ToString("N2")
                            </div>
                            <div class="col-md-3">
                                <strong>Mukofotlar:</strong> @Model.Lines.Sum(l => l.Bonuses).ToString("N2")
                            </div>
                            <div class="col-md-3">
                                <strong>Jarimalar:</strong> @Model.Lines.Sum(l => l.Penalties).ToString("N2")
                            </div>
                            <div class="col-md-3">
                                <strong>To'lovga:</strong> <span class="text-success font-weight-bold">@Model.TotalNetSalary.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped" id="payrollGrid">
                                    <thead>
                                        <tr>
                                            <th>№</th>
                                            <th>Tab.№</th>
                                            <th>F.I.O.</th>
                                            <th>Lavozim</th>
                                            <th>Asosiy maosh</th>
                                            <th>Ishlangan soatlar</th>
                                            <th>Hisoblangan</th>
                                            <th>Mukofotlar</th>
                                            <th>Jarimalar</th>
                                            <th>To'lovga</th>
                                            <th>Valyuta</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int rowNum = 1; }
                                        @foreach (var line in Model.Lines)
                                        {
                                            <tr data-line-id="@line.ID">
                                                <td>@rowNum</td>
                                                <td>@line.EmployeeTabNo</td>
                                                <td>@line.EmployeeFullName</td>
                                                <td>@line.PositionName</td>
                                                <td>@line.BaseSalary.ToString("N2")</td>
                                                <td>@line.HoursWorked.ToString("F2")</td>
                                                <td>@line.GrossSalary.ToString("N2")</td>
                                                <td>
                                                    <input type="number" 
                                                           class="form-control form-control-sm bonuses-input" 
                                                           data-line-id="@line.ID"
                                                           value="@line.Bonuses.ToString("F2")" 
                                                           step="0.01" 
                                                           min="0"
                                                           style="width: 100px;"
                                                           @(Model.Status != "Draft" ? "readonly" : "") />
                                                </td>
                                                <td>
                                                    <input type="number" 
                                                           class="form-control form-control-sm penalties-input" 
                                                           data-line-id="@line.ID"
                                                           value="@line.Penalties.ToString("F2")" 
                                                           step="0.01" 
                                                           min="0"
                                                           style="width: 100px;"
                                                           @(Model.Status != "Draft" ? "readonly" : "") />
                                                </td>
                                                <td class="net-salary">@line.NetSalary.ToString("N2")</td>
                                                <td>@line.CurrencyCode</td>
                                            </tr>
                                            rowNum++;
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="font-weight-bold">
                                            <td colspan="6" class="text-right">ИТОГО:</td>
                                            <td>@Model.TotalGrossSalary.ToString("N2")</td>
                                            <td>@Model.Lines.Sum(l => l.Bonuses).ToString("N2")</td>
                                            <td>@Model.Lines.Sum(l => l.Penalties).ToString("N2")</td>
                                            <td class="text-success">@Model.TotalNetSalary.ToString("N2")</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Post Modal -->
    <div class="modal fade" id="postModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Hisobni moliya moduliga o'tkazish</h5>
                    <button type="button" class="close" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>
                @using (Html.BeginForm("Post", "HrPayroll", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.ID)
                    <div class="modal-body">
                        <div class="form-group">
                            <label>Hisob <span class="text-danger">*</span></label>
                            @Html.DropDownList("accountId", ViewBag.AccountList as SelectList, "Hisobni tanlang", new { @class = "form-control select2", @required = "required" })
                        </div>
                        <div class="form-group">
                            <label>Kategoriya <span class="text-danger">*</span></label>
                            @Html.DropDownList("categoryId", ViewBag.CategoryList as SelectList, "Kategoriyani tanlang", new { @class = "form-control select2", @required = "required" })
                        </div>
                        <p class="text-muted">O'tkazish summasi: <strong>@Model.TotalNetSalary.ToString("N2")</strong></p>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">O'tkazish</button>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Bekor qilish</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('.select2').select2({ width: '100%' });

            // Update bonuses/penalties
            $('.bonuses-input, .penalties-input').on('change blur', function() {
                var $input = $(this);
                var lineId = $input.data('line-id');
                var bonuses = parseFloat($('.bonuses-input[data-line-id="' + lineId + '"]').val()) || 0;
                var penalties = parseFloat($('.penalties-input[data-line-id="' + lineId + '"]').val()) || 0;

                $.post('@Url.Action("UpdateLine")', {
                    lineId: lineId,
                    bonuses: bonuses,
                    penalties: penalties
                }, function(result) {
                    if (result.success) {
                        $('tr[data-line-id="' + lineId + '"] .net-salary').text(result.netSalary.toFixed(2));
                        location.reload();
                    } else {
                        alert('Xatolik: ' + result.message);
                    }
                });
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

