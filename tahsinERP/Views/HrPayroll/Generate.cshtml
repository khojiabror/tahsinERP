@{
    ViewBag.Title = "Ish haqi hisobini yaratish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrPayroll"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Ish haqi hisobi</a></li>
                                    <li class="breadcrumb-item active">Yaratish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @using (Html.BeginForm(ViewBag.PayrollType == "PieceRate" ? "GeneratePieceRate" : "Generate", "HrPayroll", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Yil <span class="text-danger">*</span></label>
                                            <select name="year" id="year" class="form-control" required>
                                                @{
                                                    int currentYear = ViewBag.Year ?? DateTime.Now.Year;
                                                    for (int y = currentYear - 5; y <= currentYear + 5; y++)
                                                    {
                                                        <option value="@y" @(y == currentYear ? "selected" : "")>@y</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Oy <span class="text-danger">*</span></label>
                                            <select name="month" id="month" class="form-control" required>
                                                @{
                                                    int currentMonth = ViewBag.Month ?? DateTime.Now.Month;
                                                    string[] uzbekMonths = { "", "Yanvar", "Fevral", "Mart", "Aprel", "May", "Iyun", "Iyul", "Avgust", "Sentabr", "Oktabr", "Noyabr", "Dekabr" };
                                                    for (int i = 1; i <= 12; i++)
                                                    {
                                                        <option value="@i" @(i == currentMonth ? "selected" : "")>@uzbekMonths[i]</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Bo'lim</label>
                                            @Html.DropDownList("orgUnitId", ViewBag.OrgUnitID as SelectList, "Butun kompaniya", new { @class = "form-control select2", @id = "orgUnitId" })
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>Tabel (ma'lumot manbai) <span class="text-danger">*</span></label>
                                            @Html.DropDownList("timesheetId", ViewBag.TimesheetID as SelectList, "Tasdiqlangan tabelni tanlang", new { @class = "form-control select2", @id = "timesheetId", @required = "required" })
                                            <small class="text-muted">Ish haqi hisobi uchun tasdiqlangan tabelni tanlang</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-calculator"></i> Hisob yaratish
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">Bekor qilish</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @section scripts {
        <script>
            var payrollType = '@ViewBag.PayrollType';
            
            // Wait for jQuery and Select2 to be loaded
            function initSelect2() {
                if (typeof jQuery !== 'undefined' && typeof $.fn.select2 !== 'undefined') {
                    $('.select2').select2({ width: '100%' });
                } else {
                    // If Select2 is not loaded yet, wait a bit and try again
                    setTimeout(initSelect2, 100);
                }
            }
            
            // Function to update timesheet dropdown
            function updateTimesheetDropdown() {
                var year = $('#year').val();
                var month = $('#month').val();
                var orgUnitId = $('#orgUnitId').val();
                
                if (!year || !month) {
                    return;
                }
                
                $.ajax({
                    url: '@Url.Action("GetTimesheets", "HrPayroll")',
                    type: 'GET',
                    data: {
                        year: year,
                        month: month,
                        orgUnitId: orgUnitId || null,
                        payrollType: payrollType
                    },
                    success: function (response) {
                        if (response.success) {
                            var timesheetDropdown = $('#timesheetId');
                            timesheetDropdown.empty();
                            
                            // Add default option
                            timesheetDropdown.append(new Option('Tasdiqlangan tabelni tanlang', '', true, true));
                            
                            // Add timesheet options
                            $.each(response.data, function (index, item) {
                                timesheetDropdown.append(new Option(item.Name, item.ID));
                            });
                            
                            // Trigger Select2 update
                            timesheetDropdown.trigger('change');
                        } else {
                            console.error('Xatolik: ' + response.message);
                            var timesheetDropdown = $('#timesheetId');
                            timesheetDropdown.empty();
                            timesheetDropdown.append(new Option('Tasdiqlangan tabelni tanlang', '', true, true));
                            timesheetDropdown.trigger('change');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Tabel ro\'yxatini olishda xatolik:', error);
                        var timesheetDropdown = $('#timesheetId');
                        timesheetDropdown.empty();
                        timesheetDropdown.append(new Option('Tasdiqlangan tabelni tanlang', '', true, true));
                        timesheetDropdown.trigger('change');
                    }
                });
            }
            
            // Start initialization when DOM is ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function() {
                    setTimeout(initSelect2, 500);
                    
                    // Attach change event listeners
                    $('#year, #month, #orgUnitId').on('change', function() {
                        updateTimesheetDropdown();
                    });
                });
            } else {
                setTimeout(initSelect2, 500);
                
                // Attach change event listeners
                $('#year, #month, #orgUnitId').on('change', function() {
                    updateTimesheetDropdown();
                });
            }
        </script>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

