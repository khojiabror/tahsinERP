@{
    ViewBag.Title = L.T("Prd_HsCodes");
    Layout = "~/Views/Shared/_Layout.cshtml";

}
@{
    bool changePermit = false;
    if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
    {
        changePermit = true;
    }
}
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item ">
                                    @Html.Link(L.T("Prd_Pages"), "Home")
                                </li>
                                <li class="breadcrumb-item active">
                                    HSCODE
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <!-- users list start -->
            <section class="invoice-list-wrapper">
                @if (changePermit)
                {
                    <div class="invoice-create-btn mb-1">
                        <button type="button" class="btn btn-outline-success mr-1 mb-1" onclick="window.location.href='/HSCODE/Create';">
                            <span class="align-middle ml-25">@L.T("Prd_AddHsCode")</span>
                        </button>
                    </div>
                }
                <div class="col-md-12 col-sm-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <!-- datatable start -->
                                <div class="table-responsive table-responsivetable-responsive">
                                    <table id="hsCodesTable" class="table table-striped table-bordered complex-headers" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>HSCODE</th>
                                                <th>@L.T("Prd_ShortDescription")</th>
                                                @if (changePermit)
                                                {
                                                    <th>@L.T("Actions")</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                                <!-- datatable ends -->
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- users list ends -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="@tahsinERP.Helpers.AssetVersion.Url("~/Scripts/srm/srm-server-table.js")"></script>
    <script>
        $(document).ready(function () {
            var editUrl = '@Url.Action("Edit", "HSCode")/';
            var deleteUrl = '@Url.Action("Delete", "HSCode")/';
            var columns = [
                { data: 'code', render: function (v) { return srmEsc(v); } },
                { data: 'description', render: function (v) { return srmEsc(v); } }
            ];
            @if (changePermit)
            {
                <text>
                columns.push({
                    data: null, orderable: false, render: function (v, t, r) {
                        return '<div><a href="' + editUrl + r.id + '" class="btn btn-sm btn-outline-success" title="@L.Js("Edit")"><i class="bx bx-edit-alt"></i></a> ' +
                            '<a href="' + deleteUrl + r.id + '" class="btn btn-sm btn-outline-danger" title="@L.Js("Delete")"><i class="bx bx-trash"></i></a></div>';
                    }
                });
                </text>
            }
            srmServerTable('#hsCodesTable', {
                dataUrl: '@Url.Action("IndexData", "HSCode")',
                order: [[0, 'asc']],
                columns: columns
            });
        });
    </script>
}