@model  tahsinERP.Models.HSCODE
@{
    ViewBag.Title = L.T("Delete");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item ">
                                    <a href="~/HSCODE">@L.T("Prd_HsCodes")</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Prd_DeleteHsCode")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-xl-9 col-md-8 col-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body pb-0 mx-25">
                                <div class="row invoice-info">
                                    <div class="col-lg-12 col-md-6 mt-25">
                                        @Html.AntiForgeryToken()
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                        <hr>
                                        <h6 class="invoice-to"></h6>
                                        <fieldset class="invoice-address form-group">
                                            @Html.TextBoxFor(model => model.HSCODE1, new { @class = "form-control round", @placeholder = L.T("Prd_EnterHsCode") })
                                            @Html.ValidationMessageFor(model => model.HSCODE1, "", new { @class = "text-danger" })
                                        </fieldset>
                                        <h6 class="invoice-to">@L.T("Prd_DetailedInfo")</h6>
                                        <fieldset class="invoice-address form-group">
                                            @Html.TextBoxFor(model => model.Description, new { @class = "form-control round", @placeholder = L.T("Prd_EnterShortInfo") })
                                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                        </fieldset>
                                    </div>
                                </div>

                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item border-0 pb-0">
                                        @using (Html.BeginForm("Delete", "HSCODE", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-danger bg-light btn-block subtotal-preview-btn" name="delete" type="submit" value="Delete" onclick="return confirm('@L.Js("Confirm_Delete")')">
                                                <i class='bx bx-trash'></i>
                                                @L.T("Delete")
                                            </button>
                                        }
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


