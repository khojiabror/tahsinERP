@model tahsinERP.Models.HSCODE

@{
    ViewBag.Title = L.T("Create");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Create", "HSCODE", FormMethod.Post, new { enctype = "multipart/form-data" }))  // Ensure enctype is set
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/HSCODE/Index">@L.T("Prd_HsCodes")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Prd_AddNewHsCode")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="basic-select2">
                    <div class="row">
                        <div class="col-xl-9 col-md-8 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row">
                                            <div class="col-lg-12 col-md-6 mt-25">
                                                @Html.AntiForgeryToken()
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                <hr>
                                                <h6 class="invoice-to"></h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.HSCODE1, new { @class = "form-control round", @placeholder = L.T("Prd_EnterHsCode") })
                                                    @Html.ValidationMessageFor(model => model.HSCODE1, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">@L.T("Prd_DetailedInfo")</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.Description, new { @class = "form-control round", @placeholder = L.T("Prd_EnterShortInfo") })
                                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <ul class="list-group list-group-flush">
                                                    <li class="list-group-item border-0 pb-0">
                                                        <button class="btn btn-primary btn-block subtotal-preview-btn" name="create" type="submit" value="Create">
                                                            <i class='bx bx-save'></i>
                                                            @L.T("Save")
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                        <hr>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
