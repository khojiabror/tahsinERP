@model tahsinERP.ViewModels.OfficialLetterEditVm
@{
    ViewBag.Title = "Maktubni Tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Rasmiy Maktublar</a></li>
                                    <li class="breadcrumb-item active">Tahrirlash</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Edit", "OfficialLetters", FormMethod.Post, new { @class = "form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(m => m.DocumentId)
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.LetterNo, new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.LetterNo, new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.LetterNo, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.LetterDate, new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.LetterDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                                                    @Html.ValidationMessageFor(m => m.LetterDate, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.DirectionCode, new { @class = "control-label" })
                                                    @Html.DropDownListFor(m => m.DirectionCode, Model.Directions, "Tanlang", new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.DirectionCode, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.ChannelCode, new { @class = "control-label" })
                                                    @Html.DropDownListFor(m => m.ChannelCode, Model.Channels, "Tanlang", new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.ChannelCode, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.ExternalCompanyName, new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.ExternalCompanyName, new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.ExternalCompanyName, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.ExternalContactName, new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.ExternalContactName, new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.ExternalContactName, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.ExternalContactPosition, new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.ExternalContactPosition, new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.ExternalContactPosition, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.OurRefNo, new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.OurRefNo, new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.OurRefNo, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.TheirRefNo, new { @class = "control-label" })
                                                    @Html.TextBoxFor(m => m.TheirRefNo, new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.TheirRefNo, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Topic, new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.Topic, new { @class = "form-control", @id = "TopicInput" })
                                            @Html.ValidationMessageFor(m => m.Topic, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label">Salomlashish</label>
                                            @Html.TextBoxFor(m => m.GreetingLine, new { @class = "form-control", @id = "GreetingInput" })
                                            @Html.ValidationMessageFor(m => m.GreetingLine, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label">Asosiy matn</label>
                                            <div class="text-right mb-1">
                                                <button type="button" class="btn btn-sm btn-info" id="btnSuggestText">
                                                    <i class="bx bx-bulb"></i> Matn taklif qilish
                                                </button>
                                            </div>
                                            <div id="letter-body-toolbar">
                                                <span class="ql-formats">
                                                    <select class="ql-font"></select>
                                                    <select class="ql-size"></select>
                                                </span>
                                                <span class="ql-formats">
                                                    <button class="ql-bold"></button>
                                                    <button class="ql-italic"></button>
                                                    <button class="ql-underline"></button>
                                                    <button class="ql-strike"></button>
                                                </span>
                                                <span class="ql-formats">
                                                    <select class="ql-color"></select>
                                                    <select class="ql-background"></select>
                                                </span>
                                                <span class="ql-formats">
                                                    <button class="ql-header" value="1"></button>
                                                    <button class="ql-header" value="2"></button>
                                                </span>
                                                <span class="ql-formats">
                                                    <button class="ql-list" value="ordered"></button>
                                                    <button class="ql-list" value="bullet"></button>
                                                    <button class="ql-indent" value="-1"></button>
                                                    <button class="ql-indent" value="+1"></button>
                                                </span>
                                                <span class="ql-formats">
                                                    <select class="ql-align"></select>
                                                </span>
                                                <span class="ql-formats">
                                                    <button class="ql-link"></button>
                                                    <button class="ql-clean"></button>
                                                </span>
                                            </div>
                                            <div id="letter-body-editor" style="height: 300px; background: white;"></div>
                                            @Html.HiddenFor(m => m.BodyText, new { @id = "BodyTextHidden" })
                                            @Html.ValidationMessageFor(m => m.BodyText, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label">Mahsulot va narx</label>
                                            <div class="table-responsive">
                                                <table class="table table-bordered" id="itemsTable">
                                                    <thead>
                                                        <tr>
                                                            <th style="min-width:160px;">Mahsulot nomi</th>
                                                            <th style="min-width:110px;">O'lchami</th>
                                                            <th style="min-width:110px;">Narx EXW</th>
                                                            <th style="min-width:130px;">Narx QQS bilan EXW</th>
                                                            <th style="min-width:110px;">Narx CIP</th>
                                                            <th style="min-width:130px;">Narx QQS bilan CIP</th>
                                                            <th style="width:48px;"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="itemsBody">
                                                        @{ var __ic = 0; }
                                                        @foreach (var item in (Model.Items ?? new System.Collections.Generic.List<tahsinERP.ViewModels.OfficialLetterItemVm>()))
                                                        {
                                                            var key = "i" + __ic;
                                                            var inv = System.Globalization.CultureInfo.InvariantCulture;
                                                            <tr class="item-row">
                                                                <td>
                                                                    <input type="hidden" name="Items.Index" value="@key" />
                                                                    <input class="form-control" name="Items[@key].ItemName" value="@item.ItemName" />
                                                                </td>
                                                                <td><input class="form-control" name="Items[@key].ItemSize" value="@item.ItemSize" /></td>
                                                                <td><input type="number" step="0.01" class="form-control" name="Items[@key].PriceExw" value="@(item.PriceExw?.ToString(inv))" /></td>
                                                                <td><input type="number" step="0.01" class="form-control" name="Items[@key].PriceVatExw" value="@(item.PriceVatExw?.ToString(inv))" /></td>
                                                                <td><input type="number" step="0.01" class="form-control" name="Items[@key].PriceCip" value="@(item.PriceCip?.ToString(inv))" /></td>
                                                                <td><input type="number" step="0.01" class="form-control" name="Items[@key].PriceVatCip" value="@(item.PriceVatCip?.ToString(inv))" /></td>
                                                                <td class="text-center"><button type="button" class="btn btn-sm btn-danger btn-remove-item"><i class="bx bx-trash"></i></button></td>
                                                            </tr>
                                                            __ic++;
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddItem">
                                                <i class="bx bx-plus"></i> Mahsulot qo'shish
                                            </button>
                                        </div>

                                        <div class="form-group">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="bx bx-save"></i> Saqlash
                                            </button>
                                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                                <i class="bx bx-x"></i> Bekor qilish
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <style>
        #letter-body-toolbar { border: 1px solid #ddd; border-bottom: none; background: #f8f9fa; }
        #letter-body-editor { border: 1px solid #ddd; }
        .ql-editor { min-height: 250px; }
    </style>
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script>
        (function () {
            function waitForJQuery(cb) {
                if (typeof jQuery !== 'undefined' && typeof window.Quill !== 'undefined') { cb(jQuery); }
                else { setTimeout(function () { waitForJQuery(cb); }, 100); }
            }

            waitForJQuery(function ($) {
                $(document).ready(function () {
                    // ---- Quill mini Word muharriri ----
                    var quill = new Quill('#letter-body-editor', {
                        modules: { toolbar: '#letter-body-toolbar' },
                        theme: 'snow',
                        placeholder: 'Maktub matnini kiriting...'
                    });

                    var initialBody = $('#BodyTextHidden').val();
                    if (initialBody && initialBody.trim() !== '') {
                        quill.clipboard.dangerouslyPasteHTML(initialBody);
                    }

                    // Forma yuborilishidan oldin HTML ni yashirin maydonga ko'chirish
                    $('form.form').on('submit', function () {
                        var html = quill.root.innerHTML;
                        if (quill.getText().trim() === '') { html = ''; }
                        $('#BodyTextHidden').val(html);
                    });

                    // ---- Mahsulot satrlari (dinamik) ----
                    var itemIndex = 0;
                    function itemRowHtml(key) {
                        return '<tr class="item-row">' +
                            '<td><input type="hidden" name="Items.Index" value="' + key + '" />' +
                            '<input class="form-control" name="Items[' + key + '].ItemName" /></td>' +
                            '<td><input class="form-control" name="Items[' + key + '].ItemSize" /></td>' +
                            '<td><input type="number" step="0.01" class="form-control" name="Items[' + key + '].PriceExw" /></td>' +
                            '<td><input type="number" step="0.01" class="form-control" name="Items[' + key + '].PriceVatExw" /></td>' +
                            '<td><input type="number" step="0.01" class="form-control" name="Items[' + key + '].PriceCip" /></td>' +
                            '<td><input type="number" step="0.01" class="form-control" name="Items[' + key + '].PriceVatCip" /></td>' +
                            '<td class="text-center"><button type="button" class="btn btn-sm btn-danger btn-remove-item"><i class="bx bx-trash"></i></button></td>' +
                            '</tr>';
                    }
                    function addItemRow() {
                        $('#itemsBody').append(itemRowHtml('n' + (itemIndex++)));
                    }
                    $('#btnAddItem').on('click', addItemRow);
                    $('#itemsBody').on('click', '.btn-remove-item', function () {
                        $(this).closest('tr').remove();
                    });
                    // Mavjud satr bo'lmasa, bitta bo'sh satr qo'shamiz
                    if ($('#itemsBody .item-row').length === 0) { addItemRow(); }

                    // ---- Matn taklif qilish ----
                    $('#btnSuggestText').click(function () {
                        var $btn = $(this);
                        var originalText = $btn.html();
                        $btn.prop('disabled', true).html('<i class="bx bx-loader-alt bx-spin"></i> Kutilmoqda...');

                        $.ajax({
                            url: '@Url.Action("SuggestText", "OfficialLetters")',
                            type: 'POST',
                            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                            data: {
                                directionCode: $('#DirectionCode').val() || 'OUT',
                                externalCompanyName: $('#ExternalCompanyName').val() || '',
                                externalContactName: $('#ExternalContactName').val() || '',
                                topic: $('#TopicInput').val() || '',
                                letterDate: $('#LetterDate').val() || null,
                                ourRefNo: $('#OurRefNo').val() || '',
                                theirRefNo: $('#TheirRefNo').val() || ''
                            },
                            success: function (response) {
                                if (response && response.success) {
                                    quill.setText(response.text || '');
                                    var contactName = $('#ExternalContactName').val();
                                    if (contactName) { $('#GreetingInput').val('Hurmatli ' + contactName + '!'); }
                                } else {
                                    alert('Xatolik: ' + (response ? response.error : 'Noma\'lum xatolik'));
                                }
                            },
                            error: function (xhr, status, error) {
                                console.error('AJAX Error:', error, xhr.responseText);
                                var errorMsg = 'Xatolik yuz berdi';
                                if (xhr.responseJSON && xhr.responseJSON.error) { errorMsg = xhr.responseJSON.error; }
                                else if (xhr.responseText) { errorMsg = xhr.responseText; }
                                alert(errorMsg);
                            },
                            complete: function () {
                                $btn.prop('disabled', false).html(originalText);
                            }
                        });
                    });
                });
            });
        })();
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

