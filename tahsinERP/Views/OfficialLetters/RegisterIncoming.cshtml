@model tahsinERP.ViewModels.IncomingLetterRegisterVm
@{
    ViewBag.Title = L.T("Doc_RegisterIncoming");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Menu_OfficialLetters")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Doc_RegisterIncoming")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <h4 class="mb-3">@L.T("Doc_RegisterIncoming")</h4>

                                    @if (TempData["ErrorMessage"] != null)
                                    {
                                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                            @TempData["ErrorMessage"]
                                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                                        </div>
                                    }

                                    @using (Html.BeginForm("RegisterIncoming", "OfficialLetters", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                    {
                                        @Html.AntiForgeryToken()

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.CompanyOrPersonName, new { @class = "form-label" })
                                                    @Html.TextBoxFor(m => m.CompanyOrPersonName, new { @class = "form-control", placeholder = L.T("Doc_CompanyOrPersonPh") })
                                                    @Html.ValidationMessageFor(m => m.CompanyOrPersonName, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.LetterNo, new { @class = "form-label" })
                                                    @Html.TextBoxFor(m => m.LetterNo, new { @class = "form-control", placeholder = L.T("Doc_IncomingNo") })
                                                    @Html.ValidationMessageFor(m => m.LetterNo, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.LetterDate, new { @class = "form-label" })
                                                    @Html.TextBoxFor(m => m.LetterDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                                    @Html.ValidationMessageFor(m => m.LetterDate, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(m => m.AttachmentFile, new { @class = "form-label" })
                                                    <div class="custom-file">
                                                        <input type="file" class="custom-file-input" id="AttachmentFile" name="AttachmentFile" accept=".pdf" />
                                                        <label class="custom-file-label" for="AttachmentFile">@L.T("Doc_SelectPdf")</label>
                                                    </div>
                                                    @Html.ValidationMessageFor(m => m.AttachmentFile, "", new { @class = "text-danger" })
                                                    <small class="form-text text-muted">@L.T("Doc_PdfOnlyHint")</small>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <button type="submit" class="btn btn-info">
                                                    <i class="bx bx-save"></i> @L.T("Save")
                                                </button>
                                                <a href="@Url.Action("Index")" class="btn btn-secondary">
                                                    <i class="bx bx-arrow-back"></i> @L.T("Cancel")
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        // Update file input label when file is selected
        document.getElementById('AttachmentFile').addEventListener('change', function(e) {
            var fileName = e.target.files[0]?.name || '@L.Js("Doc_SelectPdf")';
            var label = e.target.nextElementSibling;
            label.textContent = fileName;
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

