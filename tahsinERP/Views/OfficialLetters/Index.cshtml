@model List<tahsinERP.ViewModels.OfficialLetterIndexVm>
@{
    ViewBag.Title = "Rasmiy Maktublar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">Rasmiy Maktublar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "OfficialLetters")" class="btn btn-success bg-light invoice-create" role="button">
                                <i class="bx bx-plus"></i> Yangi Maktub
                            </a>
                            <a href="@Url.Action("RegisterIncoming", "OfficialLetters")" class="btn btn-info bg-light invoice-create" role="button" style="margin-left: 10px;">
                                <i class="bx bx-file"></i> Kiruvchi xatni ro'yxatga olish
                            </a>
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    }

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- Search and Filter -->
                                    <div class="users-list-filter px-1">
                                        <form method="get" action="@Url.Action("Index")">
                                            <div class="row border rounded py-2 mb-2">
                                                <div class="col-12 col-sm-6 col-lg-3">
                                                    <label>Qidirish</label>
                                                    <input type="text" name="topicSearch" class="form-control" value="@ViewBag.TopicSearch" placeholder="Mavzu, kompaniya..." />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Yil</label>
                                                    @Html.DropDownList("year", ViewBag.Years as SelectList, "Barchasi", new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>Yo'nalish</label>
                                                    @Html.DropDownList("directionCode", ViewBag.Directions as SelectList, "Barchasi", new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>&nbsp;</label>
                                                    <button type="submit" class="btn btn-primary btn-block">
                                                        <i class="bx bx-search"></i> Qidirish
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- datatable start -->
                                    <div class="table-responsive">
                                        <table id="officialLettersTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Raqam</th>
                                                    <th>Sana</th>
                                                    <th>Yo'nalish</th>
                                                    <th>Kompaniya</th>
                                                    <th>Kontakt</th>
                                                    <th>Mavzu</th>
                                                    <th>Holat</th>
                                                    <th>Amallar</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@item.LetterNo</td>
                                                            <td>@item.LetterDate.ToString("dd.MM.yyyy")</td>
                                                            <td><span class="badge badge-@(item.DirectionCode == "OUT" ? "primary" : "secondary")">@(item.DirectionCode == "OUT" ? "Chiqish" : "Kirish")</span></td>
                                                            <td>@(item.ExternalCompanyName ?? "-")</td>
                                                            <td>@(item.ExternalContactName ?? "-")</td>
                                                            <td>@item.Topic</td>
                                                            <td><span class="badge badge-info">@item.StatusName</span></td>
                                                            <td>
                                                                <a href="@Url.Action("Details", new { id = item.DocumentId })" class="btn btn-sm btn-info" title="Ko'rish">
                                                                    <i class="bx bx-show"></i>
                                                                </a>
                                                                @if (changePermit)
                                                                {
                                                                    <a href="@Url.Action("Edit", new { id = item.DocumentId })" class="btn btn-sm btn-warning" title="Tahrirlash">
                                                                        <i class="bx bx-edit"></i>
                                                                    </a>
                                                                    <a href="#" data-post-url="@Url.Action("Delete", "OfficialLetters", new { id = item.DocumentId })" data-confirm="O'chirishni tasdiqlaysizmi?" class="btn btn-sm btn-danger" title="O'chirish"><i class="bx bx-trash"></i></a>
                                                                    <a href="#" data-post-url="@Url.Action("GenerateDoc", "OfficialLetters", new { id = item.DocumentId })" data-confirm="Hujjat yaratilsinmi?" class="btn btn-sm btn-success" title="Hujjat yaratish"><i class="bx bx-file"></i></a>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
    (function () {
        function initSOrderTable() {
            if (typeof window.jQuery === 'undefined' || typeof window.jQuery.fn.DataTable === 'undefined') {
                setTimeout(initSOrderTable, 100);
                return;
            }
            var $ = window.jQuery;
            if (!$('#officialLettersTable').length) return;
                        
            var columnDefs = [];
            {
                columnDefs.push({ "orderable": false, "targets": -1 });
            }

            $('#officialLettersTable').DataTable({
            "language": {
                "search": "Qidirish:",
                "lengthMenu": "_MENU_ ta ko'rsatish",
                "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                "infoEmpty": "Yozuvlar yo'q",
                "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                "paginate": {
                    "first": "Birinchi",
                    "last": "Oxirgi",
                    "next": "Keyingi",
                    "previous": "Oldingi"
                },
                "zeroRecords": "Ma'lumot topilmadi"
            },
            "paging": true,
            "info": true,
            "lengthChange": true,
            "pageLength": 25,
            "lengthMenu": [10, 25, 50, 100],
            "order": [[3, "desc"]],
            "columnDefs": columnDefs,
            dom: 'lBfrtip',
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: '<i class="bx bxs-file-excel"></i> Excel',
                    titleAttr: 'Excelga yuklash',
                    className: 'btn btn-success mr-1',
                    filename: function () {
                        var now = new Date();
                        var dateStr = now.getFullYear() +
                            String(now.getMonth() + 1).padStart(2, '0') +
                            String(now.getDate()).padStart(2, '0') + '_' +
                            String(now.getHours()).padStart(2, '0') +
                            String(now.getMinutes()).padStart(2, '0') +
                            String(now.getSeconds()).padStart(2, '0');
                        return 'Xatlar_' + dateStr;
                    },
                    exportOptions: {
                        columns: true ? ':not(:last-child)' : ':visible',
                        format: {
                            body: function (data, row, column, node) {
                                return data.replace(/<[^>]*>/g, '').trim();
                            }
                        }
                    }
                },
                {
                    extend: 'pdfHtml5',
                    text: '<i class="bx bxs-file-pdf"></i> PDF',
                    titleAttr: 'PDFga yuklash',
                    className: 'btn btn-danger',
                    orientation: 'landscape',
                    pageSize: 'A4',
                    filename: function () {
                        var now = new Date();
                        var dateStr = now.getFullYear() +
                            String(now.getMonth() + 1).padStart(2, '0') +
                            String(now.getDate()).padStart(2, '0') + '_' +
                            String(now.getHours()).padStart(2, '0') +
                            String(now.getMinutes()).padStart(2, '0') +
                            String(now.getSeconds()).padStart(2, '0');
                        return 'Xatlar_' + dateStr;
                    },
                    exportOptions: {
                        columns: true ? ':not(:last-child)' : ':visible',
                        format: {
                            body: function (data, row, column, node) {
                                return data.replace(/<[^>]*>/g, '').trim();
                            }
                        }
                    },
                    title: 'Xatlar ro\'yxati',
                    customize: function (doc) {
                        doc.defaultStyle.fontSize = 9;
                        doc.styles.tableHeader.fontSize = 10;
                    }
                }
            ],
            "scrollX": true
        });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSOrderTable);
        } else {
            initSOrderTable();
        }
    })();
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

