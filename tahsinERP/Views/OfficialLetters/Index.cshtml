@model List<tahsinERP.ViewModels.OfficialLetterIndexVm>
@{
    ViewBag.Title = L.T("Menu_OfficialLetters");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">@L.T("Menu_OfficialLetters")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "OfficialLetters")" class="btn btn-success bg-light invoice-create" role="button">
                                <i class="bx bx-plus"></i> @L.T("Doc_NewLetter")
                            </a>
                            <a href="@Url.Action("RegisterIncoming", "OfficialLetters")" class="btn btn-info bg-light invoice-create" role="button" style="margin-left: 10px;">
                                <i class="bx bx-file"></i> @L.T("Doc_RegisterIncoming")
                            </a>
                            <a href="@Url.Action("Index", "DocTemplates", new { docType = "OFFICIAL_LETTER" })" class="btn btn-outline-secondary" role="button" style="margin-left: 10px;">
                                <i class="bx bx-cog"></i> @L.T("Doc_WordTemplates")
                            </a>
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    }

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- Search and Filter -->
                                    <div class="users-list-filter px-1">
                                        <form method="get" action="@Url.Action("Index")">
                                            <div class="row border rounded py-2 mb-2">
                                                <div class="col-12 col-sm-6 col-lg-3">
                                                    <label>@L.T("Search")</label>
                                                    <input type="text" name="topicSearch" class="form-control" value="@ViewBag.TopicSearch" placeholder="Mavzu, kompaniya..." />
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>@L.T("Doc_Year")</label>
                                                    @Html.DropDownList("year", ViewBag.Years as SelectList, L.T("All"), new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>@L.T("Doc_Direction")</label>
                                                    @Html.DropDownList("directionCode", ViewBag.Directions as SelectList, L.T("All"), new { @class = "form-control" })
                                                </div>
                                                <div class="col-12 col-sm-6 col-lg-2">
                                                    <label>&nbsp;</label>
                                                    <button type="submit" class="btn btn-primary btn-block">
                                                        <i class="bx bx-search"></i> @L.T("Search")
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- datatable start -->
                                    <div class="table-responsive">
                                        <table id="officialLettersTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Number")</th>
                                                    <th>@L.T("Date")</th>
                                                    <th>@L.T("Doc_Direction")</th>
                                                    <th>@L.T("Doc_Company")</th>
                                                    <th>@L.T("Doc_Contact")</th>
                                                    <th>@L.T("Doc_Topic")</th>
                                                    <th>@L.T("Status")</th>
                                                    <th>@L.T("Actions")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@item.LetterNo</td>
                                                            <td>@item.LetterDate.ToString("dd.MM.yyyy")</td>
                                                            <td><span class="badge badge-@(item.DirectionCode == "OUT" ? "primary" : "secondary")">@(item.DirectionCode == "OUT" ? "Chiqish" : "Kirish")</span></td>
                                                            <td>@(item.ExternalCompanyName ?? "-")</td>
                                                            <td>@(item.ExternalContactName ?? "-")</td>
                                                            <td>@item.Topic</td>
                                                            <td><span class="badge badge-info">@item.StatusName</span></td>
                                                            <td>
                                                                <a href="@Url.Action("Details", new { id = item.DocumentId })" class="btn btn-sm btn-info" title="@L.T("View")">
                                                                    <i class="bx bx-show"></i>
                                                                </a>
                                                                @if (changePermit)
                                                                {
                                                                    <a href="@Url.Action("Edit", new { id = item.DocumentId })" class="btn btn-sm btn-warning" title="@L.T("Edit")">
                                                                        <i class="bx bx-edit"></i>
                                                                    </a>
                                                                    <a href="#" data-post-url="@Url.Action("Delete", "OfficialLetters", new { id = item.DocumentId })" data-confirm="@L.T("Js_ConfirmDelete")" class="btn btn-sm btn-danger" title="@L.T("Delete")"><i class="bx bx-trash"></i></a>
                                                                    <a href="#" data-post-url="@Url.Action("GenerateDoc", "OfficialLetters", new { id = item.DocumentId })" data-confirm="@L.T("Doc_ConfirmGenerate")" class="btn btn-sm btn-success" title="@L.T("Doc_GenerateDoc")"><i class="bx bx-file"></i></a>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
    (function () {
        function initSOrderTable() {
            if (typeof window.jQuery === 'undefined' || typeof window.jQuery.fn.DataTable === 'undefined') {
                setTimeout(initSOrderTable, 100);
                return;
            }
            var $ = window.jQuery;
            if (!$('#officialLettersTable').length) return;
                        
            var columnDefs = [];
            {
                columnDefs.push({ "orderable": false, "targets": -1 });
            }

            $('#officialLettersTable').DataTable({
            language: erpDataTable.language,
            "paging": true,
            "info": true,
            "lengthChange": true,
            "pageLength": 25,
            "lengthMenu": [10, 25, 50, 100],
            "order": [[3, "desc"]],
            "columnDefs": columnDefs,
            dom: 'lBfrtip',
            buttons: erpDataTable.buttons({ fileName: '@L.Js("Doc_LettersFile")', pdfTitle: '@L.Js("Doc_LettersList")', columns: true ? ':not(:last-child)' : ':visible' }),
            "scrollX": true
        });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSOrderTable);
        } else {
            initSOrderTable();
        }
    })();
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

