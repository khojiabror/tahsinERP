@model List<tahsinERP.Models.PRODUCT_CATEGORIES>
@{
    ViewBag.Title = L.T("Menu_ProductTypes");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = false;
    if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
    {
        changePermit = true;
    }
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Product/Index">@L.T("Menu_Products")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Menu_ProductTypes")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <!-- users list start -->
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "ProductCategory")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                @L.T("Prd_AddProductType")
                            </a>
                        </div>
                    }
                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <!-- datatable start -->
                                    <div class="card-datatable table-responsive">
                                        <table class="table table-striped table-bordered" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>@L.T("Code")</th>
                                                            <th>@L.T("Name")</th>
                                                            <th>@L.T("Prd_TypeRaw")</th>
                                                            <th>@L.T("Prd_FinishedProduct")</th>
                                                            <th>@L.T("Prd_TypeSemi")</th>
                                                            <th>@L.T("Prd_Consumable")</th>
                                                            @if (changePermit)
                                                            {
                                                                <th>@L.T("Actions")</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in Model)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    <a href="~/ProductCategory/Details/@item.ID">@item.Code</a>
                                                                </td>
                                                                <td>@item.Name</td>
                                                                <td>
                                                                    @if (item.IsRawMaterial)
                                                                    {
                                                                        <span class="badge badge-info">@L.T("Yes")</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge badge-secondary">@L.T("No")</span>
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (item.IsFinishedGood)
                                                                    {
                                                                        <span class="badge badge-success">@L.T("Yes")</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge badge-secondary">@L.T("No")</span>
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (item.IsComponent)
                                                                    {
                                                                        <span class="badge badge-warning">@L.T("Yes")</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge badge-secondary">@L.T("No")</span>
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (item.IsConsumable)
                                                                    {
                                                                        <span class="badge badge-primary">@L.T("Yes")</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge badge-secondary">@L.T("No")</span>
                                                                    }
                                                                </td>
                                                                @if (changePermit)
                                                                {
                                                                    <td>
                                                                        <div>
                                                                            <a href="@Url.Action("Edit", "ProductCategory", new { id = item.ID })" class="btn btn-sm btn-outline-success" title="@L.T("Edit")"><i class="bx bx-edit-alt"></i></a>
                                                                            <a href="@Url.Action("Delete", "ProductCategory", new { id = item.ID })" class="btn btn-sm btn-outline-danger" title="@L.T("Delete")"><i class="bx bx-trash"></i></a>
                                                                        </div>
                                                                    </td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            <!-- datatable ends -->
</div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
