@model tahsinERP.Models.PRODUCT_CATEGORIES
@{
    ViewBag.Title = "O'chirish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Delete", "ProductCategory", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/ProductCategory">Maxsulot turlari</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            @Model.Name ma'lumotlarini o'chirish
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <!-- app invoice View Page -->
                    <section class="invoice-edit-wrapper">
                        <div class="row">
                            <!-- invoice view page -->
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            <div class="row invoice-info">
                                                <div class="col-lg-12 col-md-6 mt-25">
                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                    <h4 class="text-primary">Maxsulot turi ma'lumotlari</h4>
                                                    <hr />
                                                    <div class="alert alert-warning">
                                                        <i class="bx bx-error"></i> Siz ushbu maxsulot turini o'chirmoqchimisiz?
                                                    </div>
                                                    <div class="row mb-2">
                                                        <div class="col-4"><b>Kod:</b></div>
                                                        <div class="col-8">@(Model.Code ?? "-")</div>
                                                    </div>
                                                    <div class="row mb-2">
                                                        <div class="col-4"><b>Nomi:</b></div>
                                                        <div class="col-8">@Model.Name</div>
                                                    </div>
                                                    <hr />
                                                    <br />
                                                </div>
                                                <ul class="list-group list-group-flush">
                                                    <li class="list-group-item border-0 pb-0">
                                                        @if (tahsinERP.Services.Common.SystemCodes.IsSystem(Model.SystemCode))
                                                        {
                                                            <div class="alert alert-danger"><i class="bx bx-lock"></i> @tahsinERP.Services.Common.SystemCodes.DeleteForbiddenMessage</div>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-danger bg-light btn-block subtotal-preview-btn" name="delete" type="submit" value="Delete">
                                                                <i class='bx bx-trash'></i>
                                                                O'chirish
                                                            </button>
                                                        }
                                                    </li>
                                                </ul>
                                            </div>
                                            <hr>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
