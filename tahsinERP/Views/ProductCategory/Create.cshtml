@model tahsinERP.Models.PRODUCT_CATEGORIES
@{
    ViewBag.Title = L.T("Create");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Create", "ProductCategory", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home/Index"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/ProductCategory/Index">@L.T("Menu_ProductTypes")</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            @L.T("Prd_AddProductType")
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <!-- app invoice View Page -->
                    <section class="basic-select2">
                        <div class="row">
                            <!-- invoice view page -->
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            <div class="row">
                                                <div class="col-lg-12 col-md-6 mt-25">
                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                    <hr>
                                                    <h6 class="invoice-to">@L.T("Code") <small class="text-muted">@L.T("Prd_AutoGenerated")</small></h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @placeholder = L.T("Name") })
                                                        <small class="text-muted">@L.T("Prd_CodeAutoHint")</small>
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Name") <span class="text-danger">*</span></h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control", @placeholder = L.T("Name"), @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Prd_MaterialKind")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.DropDownListFor(model => model.MaterialKind,
                                                            new SelectList(tahsinERP.Services.Common.SystemCodes.MaterialKind.All.Select(k => new { k.Key, Value = L.T("Prd_MaterialKind_" + k.Key) }), "Key", "Value", Model?.MaterialKind),
                                                            L.T("Prd_MaterialKindPlain"), new { @class = "form-control" })
                                                        <small class="text-muted">@L.T("Prd_MaterialKindHint")</small>
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Prd_RawGroup")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.RawMaterialGroup, new { @class = "form-control", @placeholder = L.T("Prd_RawGroup") })
                                                        @Html.ValidationMessageFor(model => model.RawMaterialGroup, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Prd_RawSubGroup")</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.RawMaterialSubGrp, new { @class = "form-control", @placeholder = L.T("Prd_RawSubGroup") })
                                                        @Html.ValidationMessageFor(model => model.RawMaterialSubGrp, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <hr>
                                                    <h6 class="invoice-to">@L.T("Prd_Properties")</h6>
                                                    <div class="form-group">
                                                        <div class="custom-control custom-checkbox">
                                                            @Html.CheckBoxFor(model => model.IsRawMaterial, new { @class = "custom-control-input" })
                                                            <label class="custom-control-label" for="IsRawMaterial">@L.T("Prd_TypeRaw")</label>
                                                        </div>
                                                        <div class="custom-control custom-checkbox">
                                                            @Html.CheckBoxFor(model => model.IsFinishedGood, new { @class = "custom-control-input" })
                                                            <label class="custom-control-label" for="IsFinishedGood">@L.T("Prd_FinishedProduct")</label>
                                                        </div>
                                                        <div class="custom-control custom-checkbox">
                                                            @Html.CheckBoxFor(model => model.IsComponent, new { @class = "custom-control-input" })
                                                            <label class="custom-control-label" for="IsComponent">@L.T("Prd_TypeSemi")</label>
                                                        </div>
                                                        <div class="custom-control custom-checkbox">
                                                            @Html.CheckBoxFor(model => model.IsConsumable, new { @class = "custom-control-input" })
                                                            <label class="custom-control-label" for="IsConsumable">@L.T("Prd_Consumable")</label>
                                                        </div>
                                                        <div class="custom-control custom-checkbox">
                                                            @Html.CheckBoxFor(model => model.RequiresNORM, new { @class = "custom-control-input" })
                                                            <label class="custom-control-label" for="RequiresNORM">@L.T("Prd_RequiresNorm")</label>
                                                        </div>
                                                        <div class="custom-control custom-checkbox">
                                                            @Html.CheckBoxFor(model => model.RequiresCutting, new { @class = "custom-control-input" })
                                                            <label class="custom-control-label" for="RequiresCutting">@L.T("Prd_RequiresCutting")</label>
                                                        </div>
                                                        <div class="custom-control custom-checkbox">
                                                            @Html.CheckBoxFor(model => model.IncludeInMRP, new { @class = "custom-control-input" })
                                                            <label class="custom-control-label" for="IncludeInMRP">@L.T("Prd_IncludeInMrp")</label>
                                                        </div>
                                                        <div class="custom-control custom-checkbox">
                                                            @Html.CheckBoxFor(model => model.AllowPurchase, new { @class = "custom-control-input" })
                                                            <label class="custom-control-label" for="AllowPurchase">@L.T("Prd_AllowPurchase")</label>
                                                        </div>
                                                        <div class="custom-control custom-checkbox">
                                                            @Html.CheckBoxFor(model => model.AllowSales, new { @class = "custom-control-input" })
                                                            <label class="custom-control-label" for="AllowSales">@L.T("Prd_AllowSales")</label>
                                                        </div>
                                                        <div class="custom-control custom-checkbox">
                                                            @{
                                                                bool calculateByWeightValue = Model?.CalculateByWeight ?? false;
                                                            }
                                                            <input type="checkbox" name="CalculateByWeight" id="CalculateByWeight" value="true" @(calculateByWeightValue ? "checked" : "") class="custom-control-input" />
                                                            <input type="hidden" name="CalculateByWeight" value="false" />
                                                            <label class="custom-control-label" for="CalculateByWeight">
                                                                @L.T("Prd_CalcByWeight")
                                                            </label>
                                                        </div>
                                                        <small class="text-muted d-block mt-2">
                                                            @L.T("Prd_CalcByWeightHint1")
                                                            @L.T("Prd_CalcByWeightHint2")
                                                        </small>
                                                    </div>
                                                    <ul class="list-group list-group-flush">
                                                        <li class="list-group-item border-0 pb-0">
                                                            <button class="btn btn-primary btn-block subtotal-preview-btn" name="create" type="submit" value="Create">
                                                                <i class='bx bx-save'></i>
                                                                @L.T("Save")
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                            <hr>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
