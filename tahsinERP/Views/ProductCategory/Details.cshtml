@model tahsinERP.Models.PRODUCT_CATEGORIES
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/ProductCategory">Maxsulot turlari</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @Model.Name ma'lumotlari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <!-- app invoice View Page -->
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <!-- invoice view page -->
                        <div class="col-xl-12 col-md-12 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-6 mt-25">
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                <h4 class="text-primary">Maxsulot turi ma'lumotlari</h4>
                                                <hr />
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Kod:</b></div>
                                                    <div class="col-8">@(Model.Code ?? "-")</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Nomi:</b></div>
                                                    <div class="col-8">@Model.Name</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Tartib raqami:</b></div>
                                                    <div class="col-8">@Model.SortOrder</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Xomashyo guruhi:</b></div>
                                                    <div class="col-8">@(Model.RawMaterialGroup ?? "-")</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Xomashyo kichik guruhi:</b></div>
                                                    <div class="col-8">@(Model.RawMaterialSubGrp ?? "-")</div>
                                                </div>
                                                <hr />
                                                <h6 class="text-primary">Xususiyatlar</h6>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Xomashyo:</b></div>
                                                    <div class="col-8">
                                                        @if (Model.IsRawMaterial)
                                                        {
                                                            <span class="badge badge-info">Ha</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Yo'q</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Tayyor maxsulot:</b></div>
                                                    <div class="col-8">
                                                        @if (Model.IsFinishedGood)
                                                        {
                                                            <span class="badge badge-success">Ha</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Yo'q</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Yarim tayyor:</b></div>
                                                    <div class="col-8">
                                                        @if (Model.IsComponent)
                                                        {
                                                            <span class="badge badge-warning">Ha</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Yo'q</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Sarflanish:</b></div>
                                                    <div class="col-8">
                                                        @if (Model.IsConsumable)
                                                        {
                                                            <span class="badge badge-primary">Ha</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Yo'q</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>NORM talab qiladi:</b></div>
                                                    <div class="col-8">
                                                        @if (Model.RequiresNORM)
                                                        {
                                                            <span class="badge badge-success">Ha</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Yo'q</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Kesish talab qiladi:</b></div>
                                                    <div class="col-8">
                                                        @if (Model.RequiresCutting)
                                                        {
                                                            <span class="badge badge-success">Ha</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Yo'q</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>MRP ga kiritish:</b></div>
                                                    <div class="col-8">
                                                        @if (Model.IncludeInMRP)
                                                        {
                                                            <span class="badge badge-success">Ha</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Yo'q</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Xarid qilishga ruxsat:</b></div>
                                                    <div class="col-8">
                                                        @if (Model.AllowPurchase)
                                                        {
                                                            <span class="badge badge-success">Ha</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Yo'q</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Sotishga ruxsat:</b></div>
                                                    <div class="col-8">
                                                        @if (Model.AllowSales)
                                                        {
                                                            <span class="badge badge-success">Ha</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Yo'q</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Faol:</b></div>
                                                    <div class="col-8">
                                                        @if (Model.IsActive)
                                                        {
                                                            <span class="badge badge-success">Ha</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-danger">Yo'q</span>
                                                        }
                                                    </div>
                                                </div>
                                                <hr />
                                                <div class="row mb-2">
                                                    <div class="col-4"><b>Yaratilgan sana:</b></div>
                                                    <div class="col-8">@Model.CreatedDT.ToString("dd.MM.yyyy HH:mm")</div>
                                                </div>
                                                @if (Model.UpdatedDT.HasValue)
                                                {
                                                    <div class="row mb-2">
                                                        <div class="col-4"><b>Yangilangan sana:</b></div>
                                                        <div class="col-8">@Model.UpdatedDT.Value.ToString("dd.MM.yyyy HH:mm")</div>
                                                    </div>
                                                }
                                                <hr />
                                                <div class="mb-2">
                                                    @if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "ProductCategory", "Edit"))
                                                    {
                                                        @Html.ActionLink("Tahrirlash", "Edit", new { id = Model.ID }, new { @class = "btn btn-primary" })
                                                    }
                                                    @Html.ActionLink("Ortga", "Index", null, new { @class = "btn btn-outline-secondary" })
                                                </div>
                                            </div>
                                        </div>
                                        <hr>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
