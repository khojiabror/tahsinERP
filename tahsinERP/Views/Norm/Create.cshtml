                                    '<td><input type="number" name="CuttingLines[' + newRowIndex + '].UnitPrice" class="form-control price-input" step="0.01" value="' + opt.price + '" /></td>' +
                                    '<td><span class="total-cost">' + opt.totalCost.toFixed(2) + '</span><input type="hidden" name="CuttingLines[' + newRowIndex + '].TotalCostPerProduct" value="' + opt.totalCost.toFixed(2) + '" /></td>' +
                                    '<td><button type="button" class="btn btn-sm btn-danger remove-line"><i class="bx bx-trash"></i></button></td>' +
                                    '<input type="hidden" name="CuttingLines[' + newRowIndex + '].ID" value="0" />' +
