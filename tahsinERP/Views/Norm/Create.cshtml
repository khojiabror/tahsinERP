                            }
                            
                            processedKeys[key] = true;
                            appliedCount++;
                            
                            // Remove from map if used
                            if (optimizedMap[key]) {
                                optimizedMap[key].shift(); // Remove first item
                                if (optimizedMap[key].length === 0) {
                                    delete optimizedMap[key];
                                }
                            }
                        }
                    }
                });

                // Now, add new rows for any remaining optimized data
                Object.keys(optimizedMap).forEach(function(key) {
                    var opts = optimizedMap[key];
                    opts.forEach(function(opt) {
                        if (opt.materialId > 0) {
