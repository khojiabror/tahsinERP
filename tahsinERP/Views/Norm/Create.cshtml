@model tahsinERP.ViewModels.ProductNormViewModel
@{
    ViewBag.Title = "Yangi Norma kiritish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">Yangi Norma kiritish</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Norm">Norma kiritish</a></li>
                                    <li class="breadcrumb-item active">Yangi NORMA</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @using (Html.BeginForm("Confirm", "Norm", FormMethod.Post, new { id = "normForm" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ProductID)
                    @Html.HiddenFor(m => m.NormVersionID)
                    <input type="hidden" id="IsOptimized" name="IsOptimized" value="false" />

                    <section class="invoice-edit-wrapper">
                        <div class="row">
                            <div class="col-xl-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body">
                                            <h4 class="text-primary mb-3">Mahsulot ma'lumotlari</h4>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Mahsulot raqami</label>
                                                        <input type="text" class="form-control" value="@Model.ProductCode" readonly />
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Mahsulot nomi</label>
                                                        <input type="text" class="form-control" value="@Model.ProductName" readonly />
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Oy <span class="text-danger">*</span></label>
                                                        @Html.TextBoxFor(m => m.Period, new { @class = "form-control", type = "month", @required = "required" })
                                                        @Html.ValidationMessageFor(m => m.Period, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Samarali shu sanadan</label>
                                                        @Html.TextBoxFor(m => m.EffectiveFrom, new { @class = "form-control", type = "date" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Samarali shu sanagacha</label>
                                                        @Html.TextBoxFor(m => m.EffectiveTo, new { @class = "form-control", type = "date" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label>Izoh</label>
                                                @Html.TextAreaFor(m => m.Comment, new { @class = "form-control", rows = 2 })
                                            </div>

                                            <hr>

                                            <h4 class="text-primary mb-3">Kesish variantlari</h4>
                                            <div class="table-responsive">
                                                <table class="table table-striped table-bordered" id="cuttingLinesTable">
                                                    <thead class="thead-light">
                                                        <tr>
                                                            <th style="width: 30px;">
                                                                <input type="checkbox" id="selectAll" />
                                                            </th>
                                                            <th>Material</th>
                                                            <th>Material kodi</th>
                                                            <th>Uzunlik (mm)</th>
                                                            <th>Standart uzunlik (mm)</th>
                                                            <th>Miqdori</th>
                                                            <th>Sarflanish (m)</th>
                                                            <th>Chiqindi (m)</th>
                                                            <th>Narx</th>
                                                            <th>Ja'mi narx</th>
                                                            <th style="width: 50px;">Amallar</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="linesBody">
                                                        <!-- Lines will be added dynamically -->
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="mt-3">
                                                <button type="button" class="btn btn-primary" id="addLineBtn">
                                                    <i class="bx bx-plus"></i> Qator qo'shish
                                                </button>
                                            </div>

                                            <hr>

                                            <h4 class="text-primary mb-3">Jami hisoblar</h4>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="card bg-success text-white">
                                                        <div class="card-body">
                                                            <h6>Umumiy norma (m)</h6>
                                                            <h4 id="totalNorm">0.0000</h4>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="card bg-light">
                                                        <div class="card-body">
                                                            <h6>Umumiy chiqindi (m)</h6>
                                                            <h4 id="totalWaste">0.0000</h4>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <hr>

                                            <h4 class="text-primary mb-3">Summa hisoblar</h4>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="card" style="background-color: #d4edda; border-color: #c3e6cb;">
                                                        <div class="card-body">
                                                            <h6>Umumiy toza sarf summa</h6>
                                                            <br />
                                                            <small class="text-muted">faqat kesiladigan lar uchun</small>
                                                            <h4 id="totalSarfSumma">0.00</h4>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="card bg-light">
                                                        <div class="card-body">
                                                            <h6>Umumiy chiqindi summa</h6>
                                                            <br />
                                                            <small class="text-muted">faqat kesiladigan lar uchun</small>
                                                            <h4 id="totalChiqindiSumma">0.00</h4>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="card" style="background-color: #ffeaa7; border-color: #fdcb6e;">
                                                        <div class="card-body">
                                                            <h6>Umumiy summa</h6>
                                                            <br />
                                                            <small class="text-muted">faqat kesiladigan lar uchun</small>
                                                            <h4 id="totalCost">0.00</h4>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <hr>

                                            <div id="optimizationSection" style="display: none;">
                                                <h4 class="text-primary mb-3">Optimizatsiya taklifi</h4>
                                                <div class="alert alert-info" id="optimizationMessage"></div>
                                                <div class="row">
                                                    <div class="col-md-4">
                                                        <div class="card bg-info text-white">
                                                            <div class="card-body">
                                                                <h6>Taklif qilingan norma (m)</h6>
                                                                <h4 id="suggestedNorm">0.0000</h4>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="card bg-info text-white">
                                                            <div class="card-body">
                                                                <h6>Taklif qilingan chiqindi (m)</h6>
                                                                <h4 id="suggestedWaste">0.0000</h4>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="card bg-info text-white">
                                                            <div class="card-body">
                                                                <h6>Taklif qilingan summa</h6>
                                                                <h4 id="suggestedCost">0.00</h4>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <!-- Optimized Lines DataTable -->
                                                <div class="mt-4">
                                                    <h5 class="mb-3">Optimizatsiya qilingan pozitsiyalar</h5>
                                                    <div class="table-responsive">
                                                        <table id="optimizedLinesTable" class="table table-bordered table-striped" style="display: none;">
                                                            <thead>
                                                                <tr>
                                                                    <th>Xomashyo kodi</th>
                                                                    <th>Xomashyo nomi</th>
                                                                    <th>Uzunlik (mm)</th>
                                                                    <th>Miqdori</th>
                                                                    <th>Sarf (m)</th>
                                                                    <th>Chiqindi (m)</th>
                                                                    <th>Narx</th>
                                                                    <th>Ja'mi narx</th>
                                                                    <th>Izoh</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <!-- Data will be populated by JavaScript -->
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>

                                            <hr>

                                            <div class="row mt-3">
                                                <div class="col-12">
                                                    <button type="button" class="btn btn-warning" id="calculateBtn">
                                                        <i class="bx bx-calculator"></i> Sarf Optimizatsiyasi
                                                    </button>
                                                    <button type="submit" class="btn btn-success" id="confirmBtn">
                                                        <i class="bx bx-check"></i> Saqlash va tasdiqlash
                                                    </button>
                                                    <a href="@Url.Action("Details", "Norm", new { id = Model.ProductID })" class="btn btn-secondary">
                                                        <i class="bx bx-x"></i> Bekor qilish
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@section scripts {
    @if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
    {
        <script>
            var lineIndex = 0;
            var materials = @Html.Raw(Json.Encode(ViewBag.MaterialsJson ?? new List<object>()));
            var isOptimized = false; // Flag to track if optimization was performed

            $(document).ready(function () {
                // Initialize select2 for existing material dropdowns (if any)
                $('.material-select.select2').select2({
                    width: '100%',
                    placeholder: 'Tanlang',
                    allowClear: true
                });
                
                // Add new line
                $('#addLineBtn').on('click', function (e) {
                    e.preventDefault();
                    var newRow = '<tr class="line-row" data-line-index="' + lineIndex + '">' +
                        '<td><input type="checkbox" name="CuttingLines[' + lineIndex + '].IsSelected" class="line-select" checked /></td>' +
                        '<td>' + getMaterialDropdown(lineIndex) + '</td>' +
                        '<td><span class="material-code">-</span></td>' +
                        '<td><input type="number" name="CuttingLines[' + lineIndex + '].CalculatedLengthMm" class="form-control length-input" step="0.01" /></td>' +
                        '<td><span class="standard-length">-</span></td>' +
                        '<td><input type="number" name="CuttingLines[' + lineIndex + '].Quantity" class="form-control quantity-input" min="1" value="1" required /></td>' +
                        '<td><span class="consumption">0.0000</span><input type="hidden" name="CuttingLines[' + lineIndex + '].ConsumptionPerProduct" value="0" /></td>' +
                        '<td><input type="number" name="CuttingLines[' + lineIndex + '].WastePerProduct" class="form-control waste-input" value="0.0000" step="0.0001" /></td>' +
                        '<td><input type="number" name="CuttingLines[' + lineIndex + '].UnitPrice" class="form-control price-input" step="0.01" /></td>' +
                        '<td><span class="total-cost">0.00</span><input type="hidden" name="CuttingLines[' + lineIndex + '].TotalCostPerProduct" value="0" /></td>' +
                        '<td><button type="button" class="btn btn-sm btn-danger remove-line"><i class="bx bx-trash"></i></button></td>' +
                        '<input type="hidden" name="CuttingLines[' + lineIndex + '].ID" value="0" />' +
                        '</tr>';
                    var $newRow = $(newRow);
                    $('#linesBody').append($newRow);
                    
                    // Initialize select2 for the new dropdown
                    $newRow.find('.material-select.select2').select2({
                        width: '100%',
                        placeholder: 'Tanlang',
                        allowClear: true
                    });
                    
                    lineIndex++;
                });

                // Remove line
                $(document).on('click', '.remove-line', function () {
                    $(this).closest('tr').remove();
                    recalculateTotals();
                });

                // Material selection change
                $(document).on('change', '.material-select', function () {
                    var materialId = $(this).val();
                    var row = $(this).closest('tr');
                    if (materialId) {
                        loadMaterialData(materialId, row);
                    }
                });

                // Recalculate on input change
                $(document).on('input', '.length-input, .quantity-input, .price-input, .waste-input', function () {
                    recalculateRow($(this).closest('tr'));
                    recalculateTotals();
                });

                // Select all
                $('#selectAll').change(function () {
                    $('.line-select').prop('checked', $(this).prop('checked'));
                });

                // Calculate optimization
                $('#calculateBtn').click(function () {
                    calculateOptimization();
                });
            });

            function getMaterialDropdown(index) {
                var html = '<select name="CuttingLines[' + index + '].MaterialID" class="form-control material-select select2" required>';
                html += '<option value="">Tanlang</option>';
                if (materials && materials.length > 0) {
                    for (var i = 0; i < materials.length; i++) {
                        // Format: "PNo - Name"
                        var displayText = materials[i].name ? (materials[i].text + ' - ' + materials[i].name) : materials[i].text;
                        html += '<option value="' + materials[i].id + '">' + displayText + '</option>';
                    }
                }
                html += '</select>';
                return html;
            }

            function loadMaterialData(materialId, row) {
                if (!materialId) {
                    row.find('.material-code').text('-');
                    row.find('.standard-length').text('-');
                    row.find('.price-input').val('');
                    row.data('requires-cutting', false);
                    return;
                }

                row.find('.material-code').text('Loading...');
                
                $.ajax({
                    url: '@Url.Action("GetMaterialData", "Norm")',
                    type: 'GET',
                    data: { materialId: materialId },
                    success: function (response) {
                        if (response.success) {
                            row.find('.material-code').text(response.materialName || response.materialCode || '-');
                            row.data('requires-cutting', response.requiresCutting || false);
                            var standardLength = response.standardLengthMm || 0;
                            row.data('standard-length-mm', standardLength);
                            if (standardLength > 0) {
                                row.find('.standard-length').text(standardLength.toFixed(2));
                            } else {
                                row.find('.standard-length').text('-');
                            }
                            if (response.unitPrice) {
                                row.find('.price-input').val(response.unitPrice);
                            }
                            recalculateRow(row);
                            recalculateTotals();
                        } else {
                            row.find('.material-code').text('-');
                            row.find('.standard-length').text('-');
                            row.data('requires-cutting', false);
                            row.data('standard-length-mm', 0);
                        }
                    },
                    error: function () {
                        row.find('.material-code').text('-');
                        row.find('.standard-length').text('-');
                        row.data('requires-cutting', false);
                    }
                });
            }

            function recalculateRow(row) {
                var length = parseFloat(row.find('.length-input').val()) || 0;
                var quantity = parseInt(row.find('.quantity-input').val()) || 1;
                var price = parseFloat(row.find('.price-input').val()) || 0;
                var standardLength = row.data('standard-length-mm') || parseFloat(row.find('.standard-length').text()) || 0;
                var requiresCutting = row.data('requires-cutting') || false;

                var consumption = 0;
                if (requiresCutting && length > 0) {
                    consumption = (length / 1000.0) * quantity;
                } else {
                    consumption = quantity;
                }
                
                // Waste calculation: calculate how many bars are needed
                var waste = 0;
                if (requiresCutting && standardLength > 0 && length > 0 && quantity > 0) {
                    // Total length needed for all pieces
                    var totalLengthNeeded = length * quantity;
                    // Calculate how many bars are needed (round up)
                    var barsNeeded = Math.ceil(totalLengthNeeded / standardLength);
                    // Total material used
                    var totalMaterialUsed = barsNeeded * standardLength;
                    // Waste = total material used - total length needed
                    waste = (totalMaterialUsed - totalLengthNeeded) / 1000.0; // Convert to meters
                }
                
                var totalCost = consumption * price;

                row.find('.consumption').text(consumption.toFixed(4));
                // Update waste input field (user can also manually edit it)
                var wasteInput = row.find('.waste-input');
                if (wasteInput.length > 0) {
                    wasteInput.val(waste.toFixed(4));
                } else {
                    // Fallback for span (should not happen, but just in case)
                    row.find('.waste').text(waste.toFixed(4));
                }
                row.find('.total-cost').text(totalCost.toFixed(2));
            }

            function recalculateTotals() {
                var totalNorm = 0;
                var totalWaste = 0;
                var totalSarfSumma = 0; // A: TotalAmount (price * consumption) - faqat kesiladigan materiallar uchun
                var totalChiqindiSumma = 0; // B: Price * wasteAmount (in meters) - faqat kesiladigan materiallar uchun
                var totalCost = 0; // A + B

                $('.line-row').each(function () {
                    if ($(this).find('.line-select').prop('checked')) {
                        var requiresCutting = $(this).data('requires-cutting') || false;
                        var consumption = parseFloat($(this).find('.consumption').text()) || 0;
                        var price = parseFloat($(this).find('.price-input').val()) || 0;
                        var quantity = parseInt($(this).find('.quantity-input').val()) || 0;
                        
                        // Faqat kesiladigan materiallar uchun hisobla
                        if (requiresCutting) {
                            totalNorm += consumption;
                            
                            // Get waste from input field (in meters)
                            var wasteInput = $(this).find('.waste-input');
                            var wasteMeters = 0;
                            if (wasteInput.length > 0) {
                                wasteMeters = parseFloat(wasteInput.val()) || 0;
                                totalWaste += wasteMeters;
                            } else {
                                wasteMeters = parseFloat($(this).find('.waste').text()) || 0;
                                totalWaste += wasteMeters;
                            }
                            
                            // A: Umumiy toza sarf summa = TotalAmount = (CutLengthMm / 1000) * PiecesPerProduct * Price
                            // But we have consumption in meters already, so: consumption * price
                            if (consumption > 0 && price > 0) {
                                totalSarfSumma += consumption * price;
                            }
                            
                            // B: Umumiy chiqindi summa = Price * wasteAmount (wasteAmount allaqachon metrlarda, umumiy chiqindi miqdori)
                            if (price > 0 && wasteMeters > 0) {
                                totalChiqindiSumma += price * wasteMeters;
                            }
                        }
                    }
                });

                // Umumiy summa = A + B
                totalCost = totalSarfSumma + totalChiqindiSumma;

                $('#totalNorm').text(totalNorm.toFixed(4));
                $('#totalWaste').text(totalWaste.toFixed(4));
                $('#totalSarfSumma').text(totalSarfSumma.toFixed(2));
                $('#totalChiqindiSumma').text(totalChiqindiSumma.toFixed(2));
                $('#totalCost').text(totalCost.toFixed(2));
            }

            var optimizedLinesDataTable = null;

            function populateOptimizedLinesTable(optimizedLines) {
                var table = $('#optimizedLinesTable');
                var tbody = table.find('tbody');
                tbody.empty();

                if (!optimizedLines || optimizedLines.length === 0) {
                    table.hide();
                    return;
                }

                // Group by material to show which lines use waste from previous cuts
                var materialGroups = {};
                optimizedLines.forEach(function(line, index) {
                    var materialId = line.materialId;
                    if (!materialGroups[materialId]) {
                        materialGroups[materialId] = [];
                    }
                    materialGroups[materialId].push(line);
                });

                // Sort materials by calculated length (descending) to show larger cuts first
                var sortedMaterials = Object.keys(materialGroups).sort(function(a, b) {
                    var maxA = Math.max.apply(Math, materialGroups[a].map(function(l) { return l.calculatedLengthMm || 0; }));
                    var maxB = Math.max.apply(Math, materialGroups[b].map(function(l) { return l.calculatedLengthMm || 0; }));
                    return maxB - maxA;
                });

                sortedMaterials.forEach(function(materialId) {
                    var lines = materialGroups[materialId];
                    lines.sort(function(a, b) {
                        return (b.calculatedLengthMm || 0) - (a.calculatedLengthMm || 0);
                    });

                    lines.forEach(function(line, lineIndex) {
                        // Use note from server response
                        var note = line.note || '';
                        if (!note && lineIndex > 0 && line.wastePerProduct === 0) {
                            note = 'Tepadagi pozitsiyaning chiqindisidan foydalanilgan';
                        }

                        var row = $('<tr>');
                        row.append('<td>' + (line.materialCode || '-') + '</td>');
                        row.append('<td>' + (line.materialName || '-') + '</td>');
                        row.append('<td><input type="number" class="form-control form-control-sm opt-length" value="' + (line.calculatedLengthMm || 0) + '" step="0.01" data-line-id="' + (line.id || 0) + '" data-material-id="' + (line.materialId || 0) + '"></td>');
                        row.append('<td><input type="number" class="form-control form-control-sm opt-quantity" value="' + (line.quantity || 0) + '" step="1" data-line-id="' + (line.id || 0) + '" data-material-id="' + (line.materialId || 0) + '"></td>');
                        row.append('<td><input type="number" class="form-control form-control-sm opt-consumption" value="' + (line.consumptionPerProduct || 0).toFixed(4) + '" step="0.0001" data-line-id="' + (line.id || 0) + '" data-material-id="' + (line.materialId || 0) + '"></td>');
                        row.append('<td><input type="number" class="form-control form-control-sm opt-waste" value="' + (line.wastePerProduct || 0).toFixed(4) + '" step="0.0001" data-line-id="' + (line.id || 0) + '" data-material-id="' + (line.materialId || 0) + '"></td>');
                        row.append('<td><input type="number" class="form-control form-control-sm opt-price" value="' + (line.unitPrice || 0).toFixed(2) + '" step="0.01" data-line-id="' + (line.id || 0) + '" data-material-id="' + (line.materialId || 0) + '"></td>');
                        row.append('<td class="opt-total-cost">' + (line.totalCostPerProduct || 0).toFixed(2) + '</td>');
                        row.append('<td><small class="text-info">' + note + '</small></td>');
                        tbody.append(row);
                    });
                });

                // Initialize or reinitialize DataTable
                if (optimizedLinesDataTable) {
                    optimizedLinesDataTable.destroy();
                }
                
                table.show();
                optimizedLinesDataTable = table.DataTable({
                    "paging": true,
                    "pageLength": 10,
                    "lengthChange": true,
                    "searching": true,
                    "ordering": true,
                    "info": true,
                    "autoWidth": false,
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Uzbek.json"
                    }
                });

                // Add event listeners for editable fields
                tbody.on('change', '.opt-length, .opt-quantity, .opt-consumption, .opt-waste, .opt-price', function() {
                    var row = $(this).closest('tr');
                    var length = parseFloat(row.find('.opt-length').val()) || 0;
                    var quantity = parseInt(row.find('.opt-quantity').val()) || 0;
                    var consumption = parseFloat(row.find('.opt-consumption').val()) || 0;
                    var waste = parseFloat(row.find('.opt-waste').val()) || 0;
                    var price = parseFloat(row.find('.opt-price').val()) || 0;
                    
                    // Recalculate total cost
                    var totalCost = consumption * price;
                    row.find('.opt-total-cost').text(totalCost.toFixed(2));
                });
            }

            // Apply optimized values to main table before form submit
            $('#normForm').on('submit', function(e) {
                console.log('Form submit - isOptimized:', isOptimized);
                
                // If optimization was performed, read data from optimized table
                if (isOptimized && $('#optimizedLinesTable').is(':visible')) {
                    console.log('Reading optimized data from DataTable');
                    readOptimizedDataAndUpdateForm();
                } else {
                    console.log('No optimization performed, using main table data');
                }
                
                // Don't prevent default - let form submit normally
            });
            
            // Function to read optimized data from DataTable and update form
            function readOptimizedDataAndUpdateForm() {
                var optimizedTable = $('#optimizedLinesTable');
                if (!optimizedTable.is(':visible') || optimizedTable.length === 0) {
                    console.log('Optimized table not visible');
                    return;
                }

                // Get all rows from optimized table
                var optimizedRows;
                if (typeof optimizedLinesDataTable !== 'undefined' && optimizedLinesDataTable) {
                    optimizedRows = optimizedLinesDataTable.rows().nodes();
                } else {
                    optimizedRows = optimizedTable.find('tbody tr');
                }
                
                if (optimizedRows.length === 0) {
                    console.log('No rows in optimized table');
                    return;
                }

                console.log('Found ' + optimizedRows.length + ' optimized rows');

                // IMPORTANT: Clear all existing rows' selection to avoid double-counting
                $('.line-row').each(function() {
                    $(this).find('.line-select').prop('checked', false);
                });

                // Store optimized data
                var optimizedData = [];
                $(optimizedRows).each(function() {
                    var row = $(this);
                    var lineId = parseInt(row.find('.opt-length').data('line-id')) || 0;
                    var materialId = parseInt(row.find('.opt-length').data('material-id')) || 0;
                    
                    var length = parseFloat(row.find('.opt-length').val()) || 0;
                    var quantity = parseInt(row.find('.opt-quantity').val()) || 0;
                    var consumption = parseFloat(row.find('.opt-consumption').val()) || 0;
                    var waste = parseFloat(row.find('.opt-waste').val()) || 0;
                    var price = parseFloat(row.find('.opt-price').val()) || 0;
                    var totalCost = parseFloat(row.find('.opt-total-cost').text().replace(/[^\d.-]/g, '')) || 0;
                    
                    if (materialId > 0 && length > 0) {
                        optimizedData.push({
                            lineId: lineId,
                            materialId: materialId,
                            length: length,
                            quantity: quantity,
                            consumption: consumption,
                            waste: waste,
                            price: price,
                            totalCost: totalCost
                        });
                    }
                });
                
                console.log('Optimized data to apply:', optimizedData);

                // Group by materialId and length to avoid duplicates
                var optimizedMap = {};
                optimizedData.forEach(function(opt) {
                    var key = opt.materialId + '_' + opt.length.toFixed(2);
                    if (!optimizedMap[key]) {
                        optimizedMap[key] = opt; // Store only one per key to avoid duplicates
                    }
                });

                // Apply to existing rows or create new ones
                var appliedCount = 0;
                var processedKeys = {};
                
                // First, try to match existing rows and update them
                $('.line-row').each(function() {
                    var mainRow = $(this);
                    var materialSelect = mainRow.find('.material-select');
                    var materialId = parseInt(materialSelect.val()) || 0;
                    var currentLength = parseFloat(mainRow.find('.length-input').val()) || 0;
                    
                    if (materialId > 0 && currentLength > 0) {
                        var key = materialId + '_' + currentLength.toFixed(2);
                        var matched = optimizedMap[key];
                        
                        if (matched && !processedKeys[key]) {
                            // Update all fields
                            mainRow.find('.length-input').val(matched.length);
                            mainRow.find('.quantity-input').val(matched.quantity);
                            mainRow.find('.price-input').val(matched.price);
                            mainRow.find('.consumption').text(matched.consumption.toFixed(4));
                            var consumptionInput = mainRow.find('input[name*=".ConsumptionPerProduct"]');
                            if (consumptionInput.length > 0) {
                                consumptionInput.val(matched.consumption.toFixed(4));
                            }
                            var wasteInput = mainRow.find('.waste-input');
                            if (wasteInput.length > 0) {
                                wasteInput.val(matched.waste.toFixed(4));
                            }
                            mainRow.find('.total-cost').text(matched.totalCost.toFixed(2));
                            var totalCostInput = mainRow.find('input[name*=".TotalCostPerProduct"]');
                            if (totalCostInput.length > 0) {
                                totalCostInput.val(matched.totalCost.toFixed(2));
                            }
                            mainRow.find('.line-select').prop('checked', true);
                            var lengthInput = mainRow.find('input[name*=".CalculatedLengthMm"]');
                            if (lengthInput.length > 0) {
                                lengthInput.val(matched.length);
                            }
                            
                            processedKeys[key] = true;
                            appliedCount++;
                        }
                    }
                });

                // Add new rows for remaining optimized data (that didn't match existing rows)
                Object.keys(optimizedMap).forEach(function(key) {
                    if (!processedKeys[key]) {
                        var opt = optimizedMap[key];
                        if (opt.materialId > 0) {
                            var material = materials.find(function(m) { return m.id === opt.materialId; });
                            if (material) {
                                var newRowIndex = lineIndex++;
                                var newRow = '<tr class="line-row" data-line-index="' + newRowIndex + '">' +
                                    '<td><input type="checkbox" name="CuttingLines[' + newRowIndex + '].IsSelected" class="line-select" checked /></td>' +
                                    '<td>' + getMaterialDropdown(newRowIndex) + '</td>' +
                                    '<td><span class="material-code">' + (material.text || '-') + '</span></td>' +
                                    '<td><input type="number" name="CuttingLines[' + newRowIndex + '].CalculatedLengthMm" class="form-control length-input" step="0.01" value="' + opt.length + '" /></td>' +
                                    '<td><span class="standard-length">-</span></td>' +
                                    '<td><input type="number" name="CuttingLines[' + newRowIndex + '].Quantity" class="form-control quantity-input" min="1" value="' + opt.quantity + '" required /></td>' +
                                    '<td><span class="consumption">' + opt.consumption.toFixed(4) + '</span><input type="hidden" name="CuttingLines[' + newRowIndex + '].ConsumptionPerProduct" value="' + opt.consumption.toFixed(4) + '" /></td>' +
                                    '<td><input type="number" name="CuttingLines[' + newRowIndex + '].WastePerProduct" class="form-control waste-input" value="' + opt.waste.toFixed(4) + '" step="0.0001" /></td>' +
                                    '<td><input type="number" name="CuttingLines[' + newRowIndex + '].UnitPrice" class="form-control price-input" step="0.01" value="' + opt.price + '" /></td>' +
                                    '<td><span class="total-cost">' + opt.totalCost.toFixed(2) + '</span><input type="hidden" name="CuttingLines[' + newRowIndex + '].TotalCostPerProduct" value="' + opt.totalCost.toFixed(2) + '" /></td>' +
                                    '<td><button type="button" class="btn btn-sm btn-danger remove-line"><i class="bx bx-trash"></i></button></td>' +
                                    '<input type="hidden" name="CuttingLines[' + newRowIndex + '].ID" value="0" />' +
                                    '</tr>';
                                
                                var $newRow = $(newRow);
                                $('#linesBody').append($newRow);
                                $newRow.find('.material-select').val(opt.materialId).trigger('change');
                                $newRow.find('.material-select.select2').select2({
                                    width: '100%',
                                    placeholder: 'Tanlang',
                                    allowClear: true
                                });
                                loadMaterialData(opt.materialId, $newRow);
                                appliedCount++;
                            }
                        }
                    }
                });

                console.log('Applied ' + appliedCount + ' optimized rows to form (no duplicates)');
            }

            function calculateOptimization() {
                var viewModel = {
                    ProductID: parseInt($('#ProductID').val()) || 0,
                    NormVersionID: parseInt($('#NormVersionID').val()) || 0,
                    Period: $('#Period').val() || '',
                    EffectiveFrom: $('#EffectiveFrom').val() || null,
                    EffectiveTo: $('#EffectiveTo').val() || null,
                    Comment: $('#Comment').val() || '',
                    CuttingLines: []
                };
                
                $('.line-row').each(function (index) {
                    var row = $(this);
                    var line = {
                        ID: parseInt(row.find('input[name*=".ID"]').val()) || 0,
                        MaterialID: parseInt(row.find('.material-select').val()) || 0,
                        CalculatedLengthMm: parseFloat(row.find('.length-input').val()) || 0,
                        Quantity: parseInt(row.find('.quantity-input').val()) || 1,
                        PiecesPerBar: 1, // Always 1 (removed from UI)
                        UnitPrice: parseFloat(row.find('.price-input').val()) || 0,
                        StandardLengthMm: row.data('standard-length-mm') || parseFloat(row.find('.standard-length').text()) || 0,
                        IsSelected: row.find('.line-select').prop('checked') || false
                    };
                    
                    if (line.MaterialID > 0) {
                        viewModel.CuttingLines.push(line);
                    }
                });
                
                $('#calculateBtn').prop('disabled', true).html('<i class="bx bx-loader-alt bx-spin"></i> Hisoblanmoqda...');
                
                $.ajax({
                    url: '@Url.Action("Calculate", "Norm")',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(viewModel),
                    success: function (response) {
                        $('#calculateBtn').prop('disabled', false).html('<i class="bx bx-calculator"></i> Optimizatsiya qilish');
                        console.log('Optimize response:', response);
                        
                        // Check if response is a string (needs parsing)
                        if (typeof response === 'string') {
                            try {
                                response = JSON.parse(response);
                            } catch (e) {
                                console.error('Failed to parse response:', e);
                                alert('Xatolik: Server javobini tahlil qilishda muammo yuz berdi.');
                                return;
                            }
                        }
                        
                        if (response && response.success) {
                            if (response.totalNorm !== undefined) {
                                $('#suggestedNorm').text(parseFloat(response.totalNorm).toFixed(4));
                            }
                            if (response.totalWaste !== undefined) {
                                $('#suggestedWaste').text(parseFloat(response.totalWaste).toFixed(4));
                            }
                            if (response.totalCost !== undefined) {
                                $('#suggestedCost').text(parseFloat(response.totalCost).toFixed(2));
                            }
                            if (response.optimization && response.optimization.message) {
                                $('#optimizationMessage').text(response.optimization.message);
                            } else if (response.message) {
                                $('#optimizationMessage').text(response.message);
                            }
                            
                            // Populate optimized lines DataTable
                            if (response.optimization && response.optimization.optimizedLines && response.optimization.optimizedLines.length > 0) {
                                populateOptimizedLinesTable(response.optimization.optimizedLines);
                                // Set optimization flag
                                isOptimized = true;
                                $('#IsOptimized').val('true');
                            }
                            
                            $('#optimizationSection').show();
                        } else {
                            var errorMsg = response && response.message ? response.message : 'Noma\'lum xatolik yuz berdi.';
                            alert('Xatolik: ' + errorMsg);
                            console.error('Optimize error response:', response);
                        }
                    },
                    error: function (xhr, status, error) {
                        $('#calculateBtn').prop('disabled', false).html('<i class="bx bx-calculator"></i> Optimizatsiya qilish');
                        var errorMessage = 'Server xatosi yuz berdi.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            try {
                                var errorObj = JSON.parse(xhr.responseText);
                                if (errorObj.message) {
                                    errorMessage = errorObj.message;
                                }
                            } catch (e) {
                                errorMessage = 'Xatolik: ' + error;
                            }
                        }
                        alert(errorMessage);
                        console.error('AJAX Error:', { xhr: xhr, status: status, error: error });
                    }
                });
            }

            function applyOptimizedValuesToMainTable() {
                // Check if optimized lines table exists and has data
                var optimizedTable = $('#optimizedLinesTable');
