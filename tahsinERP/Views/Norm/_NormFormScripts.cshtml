@using System.Collections.Generic
@model tahsinERP.ViewModels.ProductNormViewModel
@* Norma formasi skriptlari (Create/Edit umumiy) — @section scripts ichidan chaqiriladi. *@
@{
    var isEdit = string.Equals(ViewBag.NormFormMode as string, "edit", System.StringComparison.OrdinalIgnoreCase);
    var loadedFromTemplateNorm = ViewBag.SelectedTemplateNormVersionId != null;
}
    @if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
    {
        <script>
            var lineIndex = @Model.CuttingLines.Count;
            // Materiallar ro'yxati sahifaga yuklanmaydi — select2 serverdan qidiradi (MES-P15)
            function materialSelect2Options() {
                return {
                    width: '100%',
                    placeholder: '@L.Js("Select")',
                    allowClear: true,
                    minimumInputLength: 0,
                    ajax: {
                        url: '@Url.Action("SearchMaterials", "Norm")',
                        dataType: 'json',
                        delay: 250,
                        data: function (params) { return { q: params.term || '', page: params.page || 1 }; },
                        processResults: function (data) { return data; },
                        cache: true
                    }
                };
            }
            var unitsJson = @Html.Raw(Json.Encode(ViewBag.UnitsJson ?? new List<object>()));
            // Mahsulot/birlik nomlari HTML satrga qo'shilishidan oldin ekranlanadi (stored XSS, MES-B14)
            function escHtml(s) {
                return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
            }
            var isOptimized = false; // Flag to track if optimization was performed
            var loadedFromTemplateNorm = @(loadedFromTemplateNorm ? "true" : "false");
            var normFormIsEdit = @(isEdit ? "true" : "false");
            var normTemplateUrlPrefix = @Html.Raw(Json.Encode(isEdit ? Url.Action("Edit", "Norm", new { normVersionId = Model.NormVersionID }) : Url.Action("Create", "Norm", new { productId = Model.ProductID })));

            function getUnitDropdownHtml(lineIndex, selectedId) {
                var html = '<select name="CuttingLines[' + lineIndex + '].UnitID" id="normLineUnit_' + lineIndex + '" class="form-control form-control-sm unit-select unit-select2" style="min-width:90px" data-norm-unit="1">';
                html += '<option value="">@L.Js("Select")</option>';
                if (unitsJson && unitsJson.length > 0) {
                    for (var j = 0; j < unitsJson.length; j++) {
                        var sel = (selectedId && String(selectedId) === String(unitsJson[j].id)) ? ' selected' : '';
                        html += '<option value="' + unitsJson[j].id + '"' + sel + '>' + escHtml(unitsJson[j].text) + '</option>';
                    }
                }
                html += '</select>';
                return html;
            }

        $(document).ready(function () {

            $('#loadTemplateNormBtn').on('click', function () {
                var templateId = $('#templateNormVersionId').val();
                if (!templateId) {
                    alert('@L.Js("Mes_Norm_SelectPreviousNorm")');
                    return;
                }
                var url = normTemplateUrlPrefix;
                if (!normFormIsEdit) {
                    url += '&period=' + encodeURIComponent($('#Period').val() || '');
                }
                window.location.href = url + '&templateNormVersionId=' + encodeURIComponent(templateId);
            });

            function isAutoPriceEnabled() {
                return $('#autoPriceFromWarehouse').is(':checked');
            }

            function updatePriceInputsState() {
                $('.price-input').prop('readonly', isAutoPriceEnabled());
            }

            function setWasteManual(row, isManual) {
                row.data('manual-waste', isManual);
                var manualInput = row.find('.waste-manual-flag');
                if (manualInput.length > 0) {
                    manualInput.val(isManual ? 'true' : 'false');
                }
            }
            
            // Initialize select2 for existing material dropdowns
            $('.material-select.select2').select2(materialSelect2Options());

            function initNormUnitSelect2($ctx) {
                ($ctx || $(document)).find('select.unit-select2').each(function () {
                    var $s = $(this);
                    if ($s.hasClass('select2-hidden-accessible')) return;
                    $s.select2({
                        width: '100%',
                        placeholder: '@L.Js("Unit")',
                        allowClear: true,
                        minimumResultsForSearch: 8
                    });
                });
            }
            initNormUnitSelect2($('#cuttingLinesTable'));

            updatePriceInputsState();

            $('#autoPriceFromWarehouse').on('change', function () {
                updatePriceInputsState();
                if (isAutoPriceEnabled()) {
                    $('.line-row').each(function () {
                        var row = $(this);
                        var materialId = row.find('.material-select').val();
                        if (materialId) {
                            loadMaterialData(materialId, row, { setPrice: true });
                        }
                    });
                }
            });
            
            // Load material data for existing rows (barcha qatorlar uchun bitta so'rov, MES-P15)
            var initialRows = [];
            $('.line-row').each(function () {
                var row = $(this);
                var materialId = row.find('.material-select').val();
                var existingWaste = parseFloat(row.find('.waste-input').val());
                var isManualWaste = (row.find('.waste-manual-flag').val() || '').toLowerCase() === 'true';
                if (isManualWaste || (!isNaN(existingWaste) && existingWaste > 0)) {
                    setWasteManual(row, true);
                }
                // Get standardLength from existing data if available
                var existingStandardLength = row.find('.standard-length').text();
                if (existingStandardLength && existingStandardLength !== '-') {
                    var standardLengthValue = parseFloat(existingStandardLength) || 0;
                    if (standardLengthValue > 0) {
                        row.data('standard-length-mm', standardLengthValue);
                    }
                }
                if (materialId) {
                    initialRows.push({ row: row, materialId: String(materialId) });
                } else {
                    // If no material selected, still try to recalculate with existing data
                    recalculateRow(row);
                }
            });
            if (initialRows.length > 0) {
                var initialIds = initialRows.map(function (x) { return x.materialId; })
                    .filter(function (v, i, a) { return a.indexOf(v) === i; });
                $.ajax({
                    url: '@Url.Action("GetMaterialDataBatch", "Norm")',
                    type: 'GET',
                    traditional: true,
                    data: { ids: initialIds },
                    success: function (response) {
                        var byId = {};
                        ((response && response.items) || []).forEach(function (m) { byId[String(m.materialId)] = m; });
                        var initialOptions = { setPrice: !loadedFromTemplateNorm && isAutoPriceEnabled() };
                        initialRows.forEach(function (x) {
                            applyMaterialData(x.row, byId[x.materialId] || { success: false }, initialOptions);
                        });
                    },
                    error: function () {
                        initialRows.forEach(function (x) { applyMaterialData(x.row, { success: false }, {}); });
                    }
                });
            }
            
            // Initialize totals on page load
            recalculateTotals();
            
            // Add new line
            $('#addLineBtn').on('click', function (e) {
                e.preventDefault();
                var newRow = '<tr class="line-row" data-line-index="' + lineIndex + '">' +
                    '<td><input type="checkbox" name="CuttingLines[' + lineIndex + '].IsSelected" class="line-select" checked /></td>' +
                    '<td>' + getMaterialDropdown(lineIndex) + '</td>' +
                    '<td><span class="material-code">-</span></td>' +
                    '<td><input type="number" name="CuttingLines[' + lineIndex + '].CalculatedLengthMm" class="form-control length-input" step="0.01" /></td>' +
                    '<td><span class="standard-length">-</span></td>' +
                    '<td><input type="number" name="CuttingLines[' + lineIndex + '].Quantity" class="form-control quantity-input" min="0" value="1" required /></td>' +
                    '<td>' + getUnitDropdownHtml(lineIndex, '') + '</td>' +
                    '<td><span class="consumption">0.0000</span><input type="hidden" name="CuttingLines[' + lineIndex + '].ConsumptionPerProduct" value="0" /></td>' +
                    '<td><input type="number" name="CuttingLines[' + lineIndex + '].WastePerProduct" class="form-control waste-input" value="0.0000" step="0.0001" />' +
                    '<input type="hidden" name="CuttingLines[' + lineIndex + '].IsWasteManual" class="waste-manual-flag" value="false" /></td>' +
                    '<td><input type="number" name="CuttingLines[' + lineIndex + '].UnitPrice" class="form-control price-input" step="0.01" /></td>' +
                    '<td><span class="clean-cost">0.00</span></td>' +
                    '<td><span class="waste-cost">0.00</span></td>' +
                    '<td><span class="total-cost">0.00</span><input type="hidden" name="CuttingLines[' + lineIndex + '].TotalCostPerProduct" value="0" /></td>' +
                    '<td><input type="text" name="CuttingLines[' + lineIndex + '].CuttingMethod" class="form-control cutting-method-input" placeholder="@L.Js("Mes_Norm_CuttingMethod")" /></td>' +
                    '<td><button type="button" class="btn btn-sm btn-danger remove-line"><i class="bx bx-trash"></i></button></td>' +
                    '<input type="hidden" name="CuttingLines[' + lineIndex + '].ID" value="0" />' +
                    '</tr>';
                var $newRow = $(newRow);
                $('#linesBody').append($newRow);
                
                // Initialize select2 for the new dropdown
                $newRow.find('.material-select.select2').select2(materialSelect2Options());
                initNormUnitSelect2($newRow);
                updatePriceInputsState();
                
                lineIndex++;
            });

            // Remove line
            $(document).on('click', '.remove-line', function () {
                var $tr = $(this).closest('tr');
                $tr.find('select.unit-select2').each(function () {
                    var $s = $(this);
                    if ($s.hasClass('select2-hidden-accessible')) {
                        try { $s.select2('destroy'); } catch (e) { }
                    }
                });
                $tr.remove();
                recalculateTotals();
            });

            // Material selection change
            $(document).on('change', '.material-select', function () {
                var materialId = $(this).val();
                var row = $(this).closest('tr');
                if (materialId) {
                    loadMaterialData(materialId, row, { setPrice: isAutoPriceEnabled() });
                }
            });

            // Recalculate on input change
            $(document).on('input', '.length-input, .quantity-input, .price-input, .waste-input', function () {
                var row = $(this).closest('tr');
                if ($(this).hasClass('waste-input')) {
                    setWasteManual(row, true);
                    recalculateRow(row, { preserveWaste: true });
                } else {
                    recalculateRow(row);
                }
                recalculateTotals();
            });

            // Select all
            $('#selectAll').change(function () {
                $('.line-select').prop('checked', $(this).prop('checked'));
            });

            // Calculate optimization
            $('#calculateBtn').click(function () {
                calculateOptimization();
            });

            function captureMaterialSelection() {
                var snapshot = {};
                $('.line-row').each(function() {
                    var row = $(this);
                    var key = row.data('line-index');
                    snapshot[key] = row.find('.material-select').val() || '';
                });
                return snapshot;
            }

            function restoreMaterialSelection(snapshot) {
                $('.line-row').each(function() {
                    var row = $(this);
                    var key = row.data('line-index');
                    var original = snapshot[key] || '';
                    var current = row.find('.material-select').val() || '';
                    if (original && current !== original) {
                        row.find('.material-select').val(original).trigger('change.select2');
                    }
                });
            }

            /** Select2: saqlashdan oldin native select qiymatini POST uchun sinxronlash (UnitID yo'qolmasin). */
            function syncNormUnitSelectsBeforeSubmit() {
                $('.line-row select.unit-select2').each(function () {
                    var $s = $(this);
                    var v = $s.val();
                    try { $s.trigger('change.select2'); } catch (e) { }
                    if (v !== null && v !== undefined && v !== '') {
                        $s.val(v);
                    }
                });
            }

            // Apply optimized values to main table before form submit
            $('#normForm').on('submit', function(e) {
                // Error-proof: user tanlagan material hech qachon avtomatik almashtirilmasin
                var materialSnapshot = captureMaterialSelection();
                
                // If optimization was performed, read data from optimized table
                if (isOptimized && $('#optimizedLinesTable').is(':visible')) {
                    readOptimizedDataAndUpdateForm();
                } else {
                }
                
                restoreMaterialSelection(materialSnapshot);
                syncNormUnitSelectsBeforeSubmit();
                // Don't prevent default - let form submit normally
            });
            
            // Function to read optimized data from DataTable and update form
            function readOptimizedDataAndUpdateForm() {
                var optimizedTable = $('#optimizedLinesTable');
                if (!optimizedTable.is(':visible') || optimizedTable.length === 0) {
                    return;
                }

                // Get all rows from optimized table
                var optimizedRows;
                if (typeof optimizedLinesDataTable !== 'undefined' && optimizedLinesDataTable) {
                    optimizedRows = optimizedLinesDataTable.rows().nodes();
                } else {
                    optimizedRows = optimizedTable.find('tbody tr');
                }
                
                if (optimizedRows.length === 0) {
                    return;
                }


                // Clear all existing rows' selection first
                $('.line-row').each(function() {
                    $(this).find('.line-select').prop('checked', false);
                });

                // Store optimized data
                var optimizedData = [];
                $(optimizedRows).each(function() {
                    var row = $(this);
                    var lineId = parseInt(row.find('.opt-length').data('line-id')) || 0;
                    var materialId = parseInt(row.find('.opt-length').data('material-id')) || 0;
                    
                    var length = parseFloat(row.find('.opt-length').val()) || 0;
                    var quantity = parseInt(row.find('.opt-quantity').val()) || 0;
                    var consumption = parseFloat(row.find('.opt-consumption').val()) || 0;
                    var waste = parseFloat(row.find('.opt-waste').val()) || 0;
                    var price = parseFloat(row.find('.opt-price').val()) || 0;
                    var totalCost = parseFloat(row.find('.opt-total-cost').text().replace(/[^\d.-]/g, '')) || 0;
                    
                    if (materialId > 0 && length > 0) {
                        optimizedData.push({
                            lineId: lineId,
                            materialId: materialId,
                            length: length,
                            quantity: quantity,
                            consumption: consumption,
                            waste: waste,
                            price: price,
                            totalCost: totalCost
                        });
                    }
                });
                

                // Group by materialId and length to avoid duplicates
                // Priority: match by lineId first, then by materialId+length
                var optimizedMapById = {};
                var optimizedMapByMaterial = {};
                optimizedData.forEach(function(opt) {
                    if (opt.lineId > 0) {
                        optimizedMapById[opt.lineId] = opt;
                    }
                    if (opt.materialId > 0 && opt.length > 0) {
                        var key = opt.materialId + '_' + opt.length.toFixed(2);
                        if (!optimizedMapByMaterial[key]) {
                            optimizedMapByMaterial[key] = opt; // Store only one per key to avoid duplicates
                        }
                    }
                });

                // Apply to existing rows
                var appliedCount = 0;
                var processedKeys = {};
                $('.line-row').each(function() {
                    var mainRow = $(this);
                    var lineIdInput = mainRow.find('input[name*=".ID"]');
                    var lineId = 0;
                    if (lineIdInput.length > 0) {
                        lineId = parseInt(lineIdInput.val()) || 0;
                    }
                    
                    var materialSelect = mainRow.find('.material-select');
                    var materialId = parseInt(materialSelect.val()) || 0;
                    var currentLength = parseFloat(mainRow.find('.length-input').val()) || 0;
                    
                    var optimized = null;
                    var key = '';
                    
                    // First try to match by line ID (highest priority)
                    if (lineId > 0 && optimizedMapById[lineId]) {
                        optimized = optimizedMapById[lineId];
                        key = 'id_' + lineId;
                    }
                    // If not found, try to match by materialId + length
                    else if (materialId > 0 && currentLength > 0) {
                        key = materialId + '_' + currentLength.toFixed(2);
                        if (optimizedMapByMaterial[key] && !processedKeys[key]) {
                            optimized = optimizedMapByMaterial[key];
                        }
                    }

                    if (optimized && !processedKeys[key]) {
                        // Update all fields
                        mainRow.find('.length-input').val(optimized.length);
                        mainRow.find('.quantity-input').attr('min', '0').val(optimized.quantity);
                        mainRow.find('.price-input').val(optimized.price);
                        mainRow.find('.consumption').text(optimized.consumption.toFixed(4));
                        var consumptionInput = mainRow.find('input[name*=".ConsumptionPerProduct"]');
                        if (consumptionInput.length > 0) {
                            consumptionInput.val(optimized.consumption.toFixed(4));
                        }
                        var wasteInput = mainRow.find('.waste-input');
                        if (wasteInput.length > 0) {
                            wasteInput.val(optimized.waste.toFixed(4));
                        }
                        setWasteManual(mainRow, true);
                        var cleanCost = optimized.consumption * optimized.price;
                        var wasteCost = optimized.waste * optimized.price;
                        var totalCost = cleanCost + wasteCost;
                        mainRow.find('.clean-cost').text(cleanCost.toFixed(2));
                        mainRow.find('.waste-cost').text(wasteCost.toFixed(2));
                        mainRow.find('.total-cost').text(totalCost.toFixed(2));
                        var totalCostInput = mainRow.find('input[name*=".TotalCostPerProduct"]');
                        if (totalCostInput.length > 0) {
                            totalCostInput.val(totalCost.toFixed(2));
                        }
                        mainRow.find('.line-select').prop('checked', true);
                        var lengthInput = mainRow.find('input[name*=".CalculatedLengthMm"]');
                        if (lengthInput.length > 0) {
                            lengthInput.val(optimized.length);
                        }
                        processedKeys[key] = true;
                        appliedCount++;
                    }
                });

            }
        });

        function getMaterialDropdown(index) {
            // Variantlar select2 orqali serverdan yuklanadi (MES-P15)
            return '<select name="CuttingLines[' + index + '].MaterialID" class="form-control material-select select2" required>' +
                '<option value="">@L.Js("Select")</option></select>';
        }

        function loadMaterialData(materialId, row, options) {
            options = options || {};
            var setPrice = options.setPrice !== undefined ? options.setPrice : $('#autoPriceFromWarehouse').is(':checked');
            if (!materialId) {
                row.find('.material-code').text('-');
                row.find('.standard-length').text('-');
                row.find('.price-input').val('');
                row.find('.unit-select').val('').trigger('change.select2');
                row.data('requires-cutting', false);
                return;
            }

            row.find('.material-code').text('@L.Js("Loading")');
            
            $.ajax({
                url: '@Url.Action("GetMaterialData", "Norm")',
                type: 'GET',
                data: { materialId: materialId },
                success: function (response) {
                    applyMaterialData(row, response, { setPrice: setPrice });
                },
                error: function () {
                    applyMaterialData(row, { success: false }, {});
                }
            });
        }

        function applyMaterialData(row, response, options) {
            var setPrice = !!(options && options.setPrice);
            if (response && response.success) {
                row.find('.material-code').text(response.materialName || response.materialCode || '-');
                // Store requiresCutting flag in row data
                row.data('requires-cutting', response.requiresCutting || false);
                // Store standardLengthMm in row data for waste calculation
                var standardLength = response.standardLengthMm || 0;
                row.data('standard-length-mm', standardLength);
                if (standardLength > 0) {
                    row.find('.standard-length').text(standardLength.toFixed(2));
                } else {
                    row.find('.standard-length').text('-');
                }
                if (setPrice && response.unitPrice) {
                    row.find('.price-input').val(response.unitPrice);
                }
                if (setPrice && response.defaultUnitId) {
                    row.find('.unit-select').val(String(response.defaultUnitId)).trigger('change.select2');
                }
                // Recalculate row after loading data
                recalculateRow(row);
                recalculateTotals();
            } else {
                row.find('.material-code').text('-');
                row.find('.standard-length').text('-');
                row.data('requires-cutting', false);
                row.data('standard-length-mm', 0);
            }
        }

        function recalculateRow(row, options) {
            options = options || {};
            var length = parseFloat(row.find('.length-input').val()) || 0;
            var quantity = parseInt(row.find('.quantity-input').val());
            if (isNaN(quantity)) { quantity = 0; }
            var price = parseFloat(row.find('.price-input').val()) || 0;
            // Get standardLength from row data (set during material load) or from text
            var standardLength = row.data('standard-length-mm') || parseFloat(row.find('.standard-length').text()) || 0;
            var requiresCutting = row.data('requires-cutting') || false;

            // Consumption calculation:
            // For cutting materials (wood, cellophane, cardboard): convert mm to m
            // For non-cutting materials: use quantity as-is (piece-based)
            var consumption = 0;
            if (requiresCutting && length > 0) {
                consumption = (length / 1000.0) * quantity;
            } else {
                consumption = quantity;
            }
            
            // Waste calculation (only for materials that require cutting):
            // Calculate how many bars are needed based on total length needed
            var waste = 0;
            if (requiresCutting && standardLength > 0 && length > 0 && quantity > 0) {
                // Total length needed for all pieces
                var totalLengthNeeded = length * quantity;
                // Calculate how many bars are needed (round up)
                var barsNeeded = Math.ceil(totalLengthNeeded / standardLength);
                // Total material used
                var totalMaterialUsed = barsNeeded * standardLength;
                // Waste = total material used - total length needed
                waste = (totalMaterialUsed - totalLengthNeeded) / 1000.0; // Convert to meters
            }
            
            row.find('.consumption').text(consumption.toFixed(4));
            var consumptionInput = row.find('input[name*=".ConsumptionPerProduct"]');
            if (consumptionInput.length > 0) {
                consumptionInput.val(consumption.toFixed(4));
            }
            // Update waste input field (user can also manually edit it)
            var wasteInput = row.find('.waste-input');
            var preserveWaste = options.preserveWaste || row.data('manual-waste') === true;
            var wasteMeters = waste;
            if (wasteInput.length > 0) {
                if (!preserveWaste) {
                    wasteInput.val(waste.toFixed(4));
                }
                wasteMeters = parseFloat(wasteInput.val()) || 0;
            } else {
                row.find('.waste').text(waste.toFixed(4));
            }

            var cleanCost = consumption * price;
            var wasteCost = wasteMeters * price;
            var totalCost = cleanCost + wasteCost;

            row.find('.clean-cost').text(cleanCost.toFixed(2));
            row.find('.waste-cost').text(wasteCost.toFixed(2));
            row.find('.total-cost').text(totalCost.toFixed(2));

            var totalCostInput = row.find('input[name*=".TotalCostPerProduct"]');
            if (totalCostInput.length > 0) {
                totalCostInput.val(totalCost.toFixed(2));
            }
        }

        function recalculateTotals() {
            var totalNorm = 0;
            var totalWaste = 0;
            var totalSarfSumma = 0; // A: TotalAmount (price * consumption) - barcha elementlar uchun
            var totalChiqindiSumma = 0; // B: Price * wasteAmount (in meters) - barcha elementlar uchun
            var totalCost = 0; // A + B

            $('.line-row').each(function () {
                var requiresCutting = $(this).data('requires-cutting') || false;
                var consumption = parseFloat($(this).find('.consumption').text()) || 0;
                var price = parseFloat($(this).find('.price-input').val()) || 0;

                // Norm/waste kartalari: faqat kesiladigan materiallar
                var wasteInput = $(this).find('.waste-input');
                var wasteMeters = 0;
                if (wasteInput.length > 0) {
                    wasteMeters = parseFloat(wasteInput.val()) || 0;
                } else {
                    wasteMeters = parseFloat($(this).find('.waste').text()) || 0;
                }

                if (requiresCutting) {
                    totalNorm += consumption;
                    totalWaste += wasteMeters;
                }

                // Summa kartalari: ViewDetails kabi barcha elementlar bo'yicha
                if (consumption > 0 && price > 0) {
                    totalSarfSumma += consumption * price;
                }
                if (price > 0 && wasteMeters > 0) {
                    totalChiqindiSumma += price * wasteMeters;
                }
            });

            // Umumiy summa = A + B
            totalCost = totalSarfSumma + totalChiqindiSumma;

            $('#totalNorm').text(totalNorm.toFixed(4));
            $('#totalWaste').text(totalWaste.toFixed(4));
            $('#totalSarfSumma').text(totalSarfSumma.toFixed(2));
            $('#totalChiqindiSumma').text(totalChiqindiSumma.toFixed(2));
            $('#totalCost').text(totalCost.toFixed(2));
        }

        var optimizedLinesDataTable = null;

        function populateOptimizedLinesTable(optimizedLines) {
            var table = $('#optimizedLinesTable');
            var tbody = table.find('tbody');
            tbody.empty();

            if (!optimizedLines || optimizedLines.length === 0) {
                table.hide();
                return;
            }

            // Group by material to show which lines use waste from previous cuts
            var materialGroups = {};
            optimizedLines.forEach(function(line, index) {
                var materialId = line.materialId;
                if (!materialGroups[materialId]) {
                    materialGroups[materialId] = [];
                }
                materialGroups[materialId].push(line);
            });

            // Sort materials by calculated length (descending) to show larger cuts first
            var sortedMaterials = Object.keys(materialGroups).sort(function(a, b) {
                var maxA = Math.max.apply(Math, materialGroups[a].map(function(l) { return l.calculatedLengthMm || 0; }));
                var maxB = Math.max.apply(Math, materialGroups[b].map(function(l) { return l.calculatedLengthMm || 0; }));
                return maxB - maxA;
            });

            sortedMaterials.forEach(function(materialId) {
                var lines = materialGroups[materialId];
                lines.sort(function(a, b) {
                    return (b.calculatedLengthMm || 0) - (a.calculatedLengthMm || 0);
                });

                    lines.forEach(function(line, lineIndex) {
                        // Use note from server response
                        var note = line.note || '';
                        if (!note && lineIndex > 0 && line.wastePerProduct === 0) {
                            note = '@L.Js("Mes_Norm_UsedWasteFromAbove")';
                        }

                        var price = line.unitPrice || 0;
                        var cleanCost = (line.consumptionPerProduct || 0) * price;
                        var wasteCost = (line.wastePerProduct || 0) * price;
                        var totalCost = cleanCost + wasteCost;

                        var row = $('<tr>');
                        row.append('<td>' + (line.materialCode || '-') + '</td>');
                        row.append('<td>' + (line.materialName || '-') + '</td>');
                        row.append('<td><input type="number" class="form-control form-control-sm opt-length" value="' + (line.calculatedLengthMm || 0) + '" step="0.01" data-line-id="' + (line.id || 0) + '" data-material-id="' + (line.materialId || 0) + '"></td>');
                        row.append('<td><input type="number" class="form-control form-control-sm opt-quantity" value="' + (line.quantity || 0) + '" step="1" data-line-id="' + (line.id || 0) + '" data-material-id="' + (line.materialId || 0) + '"></td>');
                        row.append('<td><input type="number" class="form-control form-control-sm opt-consumption" value="' + (line.consumptionPerProduct || 0).toFixed(4) + '" step="0.0001" data-line-id="' + (line.id || 0) + '" data-material-id="' + (line.materialId || 0) + '"></td>');
                        row.append('<td><input type="number" class="form-control form-control-sm opt-waste" value="' + (line.wastePerProduct || 0).toFixed(4) + '" step="0.0001" data-line-id="' + (line.id || 0) + '" data-material-id="' + (line.materialId || 0) + '"></td>');
                        row.append('<td><input type="number" class="form-control form-control-sm opt-price" value="' + price.toFixed(2) + '" step="0.01" data-line-id="' + (line.id || 0) + '" data-material-id="' + (line.materialId || 0) + '"></td>');
                        row.append('<td class="opt-clean-cost">' + cleanCost.toFixed(2) + '</td>');
                        row.append('<td class="opt-waste-cost">' + wasteCost.toFixed(2) + '</td>');
                        row.append('<td class="opt-total-cost">' + totalCost.toFixed(2) + '</td>');
                        row.append('<td><small class="text-info">' + note + '</small></td>');
                        tbody.append(row);
                    });
            });

            // Initialize or reinitialize DataTable
            if (optimizedLinesDataTable) {
                optimizedLinesDataTable.destroy();
            }
            
            table.show();
            optimizedLinesDataTable = table.DataTable({
                "paging": true,
                "pageLength": 10,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
            });

            // Add event listeners for editable fields
            tbody.on('change', '.opt-length, .opt-quantity, .opt-consumption, .opt-waste, .opt-price', function() {
                var row = $(this).closest('tr');
                var length = parseFloat(row.find('.opt-length').val()) || 0;
                var quantity = parseInt(row.find('.opt-quantity').val()) || 0;
                var consumption = parseFloat(row.find('.opt-consumption').val()) || 0;
                var waste = parseFloat(row.find('.opt-waste').val()) || 0;
                var price = parseFloat(row.find('.opt-price').val()) || 0;
                
                // Recalculate total cost
                var cleanCost = consumption * price;
                var wasteCost = waste * price;
                var totalCost = cleanCost + wasteCost;
                row.find('.opt-clean-cost').text(cleanCost.toFixed(2));
                row.find('.opt-waste-cost').text(wasteCost.toFixed(2));
                row.find('.opt-total-cost').text(totalCost.toFixed(2));
            });
        }

        function calculateOptimization() {
            // Build viewModel object manually from form
            var viewModel = {
                ProductID: parseInt($('#ProductID').val()) || 0,
                NormVersionID: parseInt($('#NormVersionID').val()) || 0,
                Period: $('#Period').val() || '',
                EffectiveFrom: $('#EffectiveFrom').val() || null,
                EffectiveTo: $('#EffectiveTo').val() || null,
                Comment: $('#Comment').val() || '',
                CuttingLines: []
            };
            
            // Collect all line data
            $('.line-row').each(function (index) {
                var row = $(this);
                var line = {
                    ID: parseInt(row.find('input[name*=".ID"]').val()) || 0,
                    MaterialID: parseInt(row.find('.material-select').val()) || 0,
                    CalculatedLengthMm: parseFloat(row.find('.length-input').val()) || 0,
                    Quantity: isNaN(parseInt(row.find('.quantity-input').val())) ? 0 : parseInt(row.find('.quantity-input').val()),
                    PiecesPerBar: 1, // Always 1 (removed from UI)
                    UnitPrice: parseFloat(row.find('.price-input').val()) || 0,
                    UnitID: parseInt(row.find('.unit-select').val(), 10) || null,
                    StandardLengthMm: row.data('standard-length-mm') || parseFloat(row.find('.standard-length').text()) || 0,
                    IsSelected: row.find('.line-select').prop('checked') || false
                };
                
                // Only add if MaterialID is set
                if (line.MaterialID > 0) {
                    viewModel.CuttingLines.push(line);
                }
            });
            
            
            // Show loading indicator
            $('#calculateBtn').prop('disabled', true).html('<i class="bx bx-loader-alt bx-spin"></i> ' + '@L.Js("Mes_Norm_Calculating")');
            
            $.ajax({
                url: '@Url.Action("Calculate", "Norm")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                // CSRF header aniq beriladi (csrf.js XHR'ni o'rab olgan muhitlarda ham ishlasin)
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val() },
                data: JSON.stringify(viewModel),
                success: function (response) {
                    $('#calculateBtn').prop('disabled', false).html('<i class="bx bx-calculator"></i> ' + '@L.Js("Mes_Norm_Optimize")');
                    
                    // Check if response is a string (needs parsing)
                    if (typeof response === 'string') {
                        try {
                            response = JSON.parse(response);
                        } catch (e) {
                            console.error('Failed to parse response:', e);
                            alert('@L.Js("Mes_Norm_ResponseParseError")');
                            return;
                        }
                    }
                    
                    if (response && response.success) {
                        if (response.totalNorm !== undefined) {
                            $('#suggestedNorm').text(parseFloat(response.totalNorm).toFixed(4));
                        }
                        if (response.totalWaste !== undefined) {
                            $('#suggestedWaste').text(parseFloat(response.totalWaste).toFixed(4));
                        }
                        if (response.totalCost !== undefined) {
                            $('#suggestedCost').text(parseFloat(response.totalCost).toFixed(2));
                        }
                        if (response.optimization && response.optimization.message) {
                            $('#optimizationMessage').text(response.optimization.message);
                        } else if (response.message) {
                            $('#optimizationMessage').text(response.message);
                        }
                        
                        // Populate optimized lines DataTable
                        if (response.optimization && response.optimization.optimizedLines && response.optimization.optimizedLines.length > 0) {
                            populateOptimizedLinesTable(response.optimization.optimizedLines);
                            // Set optimization flag
                            isOptimized = true;
                            $('#IsOptimized').val('true');
                        }
                        
                        $('#optimizationSection').show();
                    } else {
                        var errorMsg = response && response.message ? response.message : '@L.Js("Mes_Norm_UnknownErrorOccurred")';
                        alert('@L.Js("Mes_Norm_ErrorPrefix")' + errorMsg);
                        console.error('Optimize error response:', response);
                    }
                },
                error: function (xhr, status, error) {
                    $('#calculateBtn').prop('disabled', false).html('<i class="bx bx-calculator"></i> ' + '@L.Js("Mes_Norm_Optimize")');
                    var errorMessage = '@L.Js("Mes_Norm_ServerError")';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        try {
                            var errorObj = JSON.parse(xhr.responseText);
                            if (errorObj.message) {
                                errorMessage = errorObj.message;
                            }
                        } catch (e) {
                            errorMessage = '@L.Js("Mes_Norm_ErrorPrefix")' + error;
                        }
                    }
                    alert(errorMessage);
                    console.error('AJAX Error:', { xhr: xhr, status: status, error: error });
                    console.error('Request data:', viewModel);
                }
            });
        }

        function applyOptimizedValuesToMainTable() {
            // Check if optimized lines table exists and has data
            var optimizedTable = $('#optimizedLinesTable');
            if (!optimizedTable.is(':visible') || optimizedTable.length === 0) {
                return; // No optimized values to apply
            }

            // Get all rows from optimized table
            // If DataTable is initialized, use DataTable API to get rows
            var optimizedRows;
            if (typeof optimizedLinesDataTable !== 'undefined' && optimizedLinesDataTable) {
                // Use DataTable API to get all rows (including paginated ones)
                optimizedRows = optimizedLinesDataTable.rows().nodes();
            } else {
                // Fallback to regular jQuery selector
                optimizedRows = optimizedTable.find('tbody tr');
            }
            
            if (optimizedRows.length === 0) {
                return; // No rows in optimized table
            }


            // Create a map of optimized values by line ID and also by materialId+length
            var optimizedMapById = {};
            var optimizedMapByMaterial = {};
            $(optimizedRows).each(function() {
                var row = $(this);
                var lineId = parseInt(row.find('.opt-length').data('line-id')) || 0;
                var materialId = parseInt(row.find('.opt-length').data('material-id')) || 0;
                
                var length = parseFloat(row.find('.opt-length').val()) || 0;
                var quantity = parseInt(row.find('.opt-quantity').val()) || 0;
                var consumption = parseFloat(row.find('.opt-consumption').val()) || 0;
                var waste = parseFloat(row.find('.opt-waste').val()) || 0;
                var price = parseFloat(row.find('.opt-price').val()) || 0;
                var totalCost = parseFloat(row.find('.opt-total-cost').text().replace(/[^\d.-]/g, '')) || 0;
                
                var optData = {
                    lineId: lineId,
                    materialId: materialId,
                    length: length,
                    quantity: quantity,
                    consumption: consumption,
                    waste: waste,
                    price: price,
                    totalCost: totalCost
                };
                
                if (lineId > 0) {
                    optimizedMapById[lineId] = optData;
                }
                
                if (materialId > 0 && length > 0) {
                    var key = materialId + '_' + length.toFixed(2);
                    if (!optimizedMapByMaterial[key]) {
                        optimizedMapByMaterial[key] = [];
                    }
                    optimizedMapByMaterial[key].push(optData);
                }
            });
            
            if (Object.keys(optimizedMapById).length === 0 && Object.keys(optimizedMapByMaterial).length === 0) {
                return;
            }

            // First, clear all existing rows' selection
            $('.line-row').each(function() {
                $(this).find('.line-select').prop('checked', false);
            });

            // Apply optimized values to main table rows
            var appliedCount = 0;
            $('.line-row').each(function() {
                var mainRow = $(this);
                // Find ID in hidden input
                var lineIdInput = mainRow.find('input[name*=".ID"]');
                var lineId = 0;
                if (lineIdInput.length > 0) {
                    lineId = parseInt(lineIdInput.val()) || 0;
                }
                
                var materialSelect = mainRow.find('.material-select');
                var materialId = parseInt(materialSelect.val()) || 0;
                var currentLength = parseFloat(mainRow.find('.length-input').val()) || 0;
                
                var optimized = null;
                
                // First try to match by line ID
                if (lineId > 0 && optimizedMapById[lineId]) {
                    optimized = optimizedMapById[lineId];
                }
                // If not found, try to match by materialId + length
                else if (materialId > 0 && currentLength > 0) {
                    var key = materialId + '_' + currentLength.toFixed(2);
                    if (optimizedMapByMaterial[key] && optimizedMapByMaterial[key].length > 0) {
                        optimized = optimizedMapByMaterial[key][0];
                        // Remove from array to avoid duplicate matches
                        optimizedMapByMaterial[key].shift();
                        if (optimizedMapByMaterial[key].length === 0) {
                            delete optimizedMapByMaterial[key];
                        }
                    }
                }

                if (optimized) {
                    
                    // Update input fields
                    mainRow.find('.length-input').val(optimized.length);
                    mainRow.find('.quantity-input').attr('min', '0').val(optimized.quantity);
                    mainRow.find('.price-input').val(optimized.price);
                    
                    // Update display spans and hidden fields
                    mainRow.find('.consumption').text(optimized.consumption.toFixed(4));
                    var consumptionInput = mainRow.find('input[name*=".ConsumptionPerProduct"]');
                    if (consumptionInput.length > 0) {
                        consumptionInput.val(optimized.consumption.toFixed(4));
                    }
                    
                    // Update waste input field
                    var wasteInput = mainRow.find('.waste-input');
                    if (wasteInput.length > 0) {
                        wasteInput.val(optimized.waste.toFixed(4));
                    } else {
                        mainRow.find('.waste').text(optimized.waste.toFixed(4));
                    }
                    
                    setWasteManual(mainRow, true);
                    var cleanCost = optimized.consumption * optimized.price;
                    var wasteCost = optimized.waste * optimized.price;
                    var totalCost = cleanCost + wasteCost;
                    mainRow.find('.clean-cost').text(cleanCost.toFixed(2));
                    mainRow.find('.waste-cost').text(wasteCost.toFixed(2));
                    mainRow.find('.total-cost').text(totalCost.toFixed(2));
                    var totalCostInput = mainRow.find('input[name*=".TotalCostPerProduct"]');
                    if (totalCostInput.length > 0) {
                        totalCostInput.val(totalCost.toFixed(2));
                    }
                    
                    // Ensure the line is selected
                    mainRow.find('.line-select').prop('checked', true);
                    
                    // Don't recalculate row - we want to keep the optimized values
                    // Just update the CalculatedLengthMm hidden field if needed
                    var lengthInput = mainRow.find('input[name*=".CalculatedLengthMm"]');
                    if (lengthInput.length > 0) {
                        lengthInput.val(optimized.length);
                    }
                    
                    appliedCount++;
                }
            });
            

            // Recalculate totals after applying optimized values
            recalculateTotals();
        }
        </script>
    }
