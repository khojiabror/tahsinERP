@model tahsinERP.ViewModels.ProductNormViewModel
@{
    ViewBag.Title = L.T("Mes_Norm_ViewTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var unitNameMap = ViewBag.UnitNameMap as Dictionary<int, string> ?? new Dictionary<int, string>();
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Norm">@L.T("Mes_Norm_IndexTitle")</a></li>
                                    <li class="breadcrumb-item active">@L.T("View")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        <div id="normContent">
                                        <h4 class="text-primary mb-3">@L.T("Mes_ProductInfo")</h4>
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>@L.T("Mes_ProductNo")</label>
                                                    <input type="text" class="form-control" value="@Model.ProductCode" readonly />
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>@L.T("Mes_ProductName")</label>
                                                    <input type="text" class="form-control" value="@Model.ProductName" readonly />
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Month")</label>
                                                    <input type="text" class="form-control" value="@Model.Period" readonly />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Norm_EffectiveFrom")</label>
                                                    <input type="text" class="form-control" value="@(Model.EffectiveFrom?.ToString("yyyy-MM-dd") ?? "-")" readonly />
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>@L.T("Mes_Norm_EffectiveTo")</label>
                                                    <input type="text" class="form-control" value="@(Model.EffectiveTo?.ToString("yyyy-MM-dd") ?? "-")" readonly />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label>@L.T("Comment")</label>
                                            <textarea class="form-control" rows="2" readonly>@Model.Comment</textarea>
                                        </div>

                                        <hr>

                                        <h4 class="text-primary mb-3">@L.T("Mes_Norm_CuttingVariants")</h4>
                                        <div class="table-responsive">
                                            <table class="table table-striped table-bordered table-sm norm-details-table">
                                                <thead class="thead-light">
                                                    <tr>
                                                        <th>@L.T("Mes_Norm_Material")</th>
                                                        <th>@L.T("Mes_MaterialCode")</th>
                                                        <th>@L.T("Mes_Norm_LengthMm")</th>
                                                        <th>@L.T("Mes_Norm_StandardLengthMm")</th>
                                                        <th>@L.T("Mes_Norm_Qty")</th>
                                                        <th>@L.T("Unit")</th>
                                                        <th>@L.T("Mes_Norm_ConsumptionM")</th>
                                                        <th>@L.T("Mes_Norm_WasteM")</th>
                                                        <th>@L.T("Price")</th>
                                                        <th>@L.T("Mes_Norm_CleanConsumptionAmount")</th>
                                                        <th>@L.T("Mes_Norm_WasteAmount")</th>
                                                        <th>@L.T("Mes_Norm_TotalPrice")</th>
                                                        <th>@L.T("Mes_Norm_CuttingMethod")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.CuttingLines != null && Model.CuttingLines.Any())
                                                    {
                                                        foreach (var line in Model.CuttingLines)
                                                        {
                                                            var unitPriceValue = line.UnitPrice ?? 0;
                                                            var cleanCostValue = line.ConsumptionPerProduct * unitPriceValue;
                                                            var wasteCostValue = line.WastePerProduct * unitPriceValue;
                                                            var totalCostValue = cleanCostValue + wasteCostValue;
                                                            <tr>
                                                                <td>@(line.MaterialName ?? line.MaterialCode ?? "-")</td>
                                                                <td>@(line.MaterialCode ?? "-")</td>
                                                                <td>@(line.CalculatedLengthMm?.ToString("F2") ?? "-")</td>
                                                                <td>@(line.StandardLengthMm?.ToString("F2") ?? "-")</td>
                                                                <td>@line.Quantity</td>
                                                                <td>
                                                                    @(line.UnitID.HasValue && unitNameMap.ContainsKey(line.UnitID.Value) ? unitNameMap[line.UnitID.Value] : "-")
                                                                </td>
                                                                <td>@line.ConsumptionPerProduct.ToString("F4")</td>
                                                                <td>@line.WastePerProduct.ToString("F4")</td>
                                                                <td>@(line.UnitPrice?.ToString("F2") ?? "-")</td>
                                                                <td>@cleanCostValue.ToString("F2")</td>
                                                                <td>@wasteCostValue.ToString("F2")</td>
                                                                <td>@totalCostValue.ToString("F2")</td>
                                                                <td>@(string.IsNullOrWhiteSpace(line.CuttingMethod) ? "-" : line.CuttingMethod)</td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="13" class="text-center text-muted">@L.T("Mes_Norm_NoCuttingVariants")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <hr>

                                        <h4 class="text-primary mb-3">@L.T("Mes_Norm_TotalsHeader")</h4>
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="card text-white" style="background: linear-gradient(135deg, #a8e6cf 0%, #7dd3a0 100%); border: none;">
                                                    <div class="card-body">
                                                        <h4>@L.T("Mes_Norm_TotalNormWoodM")</h4>
                                                        <br />
                                                        <small>@L.T("Mes_Norm_WoodOnly")</small>
                                                        <h4>@Model.TotalNorm.ToString("F4")</h4>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="card text-white" style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%); border: none;">
                                                    <div class="card-body">
                                                        <h6>@L.T("Mes_Norm_TotalWasteM")</h6>
                                                        <br />
                                                        <small>@L.T("Mes_Norm_WoodOnly")</small>
                                                        <h4>@Model.TotalWaste.ToString("F4")</h4>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <hr>

                                        <h4 class="text-primary mb-3">@L.T("Mes_Norm_AmountsHeader")</h4>
                                        @{
                                            // Calculate sums from model - barcha elementlar uchun
                                            decimal totalSarfSumma = Model.CuttingLines
                                                .Where(l => l.UnitPrice.HasValue && l.ConsumptionPerProduct > 0)
                                                .Sum(l => l.ConsumptionPerProduct * l.UnitPrice.Value);
                                            
                                            decimal totalChiqindiSumma = Model.CuttingLines
                                                .Where(l => l.UnitPrice.HasValue && l.WastePerProduct > 0)
                                                .Sum(l => l.UnitPrice.Value * l.WastePerProduct);
                                            
                                            decimal umumiySumma = totalSarfSumma + totalChiqindiSumma;
                                        }
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="card text-white" style="background: linear-gradient(135deg, #a8e6cf 0%, #7dd3a0 100%); border: none;">
                                                    <div class="card-body">
                                                        <h6>@L.T("Mes_Norm_TotalCleanConsumptionAmount")</h6>
                                                        <br />
                                                        <small>@L.T("Mes_Norm_AllElements")</small>
                                                        <h4>@totalSarfSumma.ToString("F2")</h4>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="card text-white" style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%); border: none;">
                                                    <div class="card-body">
                                                        <h6>@L.T("Mes_Norm_TotalWasteAmountShort")</h6>
                                                        <br />
                                                        <small>@L.T("Mes_Norm_AllElements")</small>
                                                        <h4>@totalChiqindiSumma.ToString("F2")</h4>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="card" style="background-color: #ffeaa7; border-color: #fdcb6e;">
                                                    <div class="card-body">
                                                        <h6>@L.T("Mes_Norm_TotalAmount")</h6>
                                                        <br />
                                                        <small class="text-muted">@L.T("Mes_Norm_AllElements")</small>
                                                        <h4>@umumiySumma.ToString("F2")</h4>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <hr>
                                        </div>
                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <button id="generatePDF" class="btn btn-outline-danger">
                                                    <i class='bx bx-save'></i> PDF
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary" onclick="window.print();">
                                                    <i class='bx bx-printer'></i> @L.T("Print")
                                                </button>
                                                @if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
                                                {
                                                    <a href="@Url.Action("Edit", "Norm", new { normVersionId = Model.NormVersionID })" class="btn btn-primary">
                                                        <i class="bx bx-edit"></i> @L.T("Edit")
                                                    </a>
                                                }
                                                <a href="@Url.Action("Details", "Norm", new { id = Model.ProductID })" class="btn btn-secondary">
                                                    <i class="bx bx-arrow-back"></i> @L.T("Back")
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <style>
        .norm-details-table th, .norm-details-table td { white-space: nowrap; font-size: 12px; }
        /* Excel-like freeze: first column (Material) stays visible on horizontal scroll */
        .norm-details-table th:first-child,
        .norm-details-table td:first-child {
            position: sticky;
            left: 0;
            z-index: 3;
            background: #ffffff;
        }
        .norm-details-table thead th:first-child {
            z-index: 4;
            background: #f8f9fa;
        }

        @@media print {
            body * { visibility: hidden; }
            #normContent, #normContent * { visibility: visible !important; }
            #normContent { position: absolute; left: 0; top: 0; width: 100%; color: #000 !important; }
            .content-header, .navbar, .menu, footer, .breadcrumb, .no-print { display: none !important; }
            .app-content, .content-wrapper, .content-body { padding: 0 !important; overflow: visible !important; }
            .card, .card-body { border: none !important; box-shadow: none !important; padding: 0.5rem !important; }
            .norm-details-table th, .norm-details-table td { font-size: 10px !important; padding: 0.2rem !important; }
            .table-responsive { overflow: visible !important; }
        }
    </style>

    <!-- html2pdf.js library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
    
    <script>
        // Wait for jQuery and html2pdf to be loaded
        (function() {
            function initPDFScript() {
                // Check if jQuery is available
                if (typeof jQuery === 'undefined' || typeof jQuery.fn === 'undefined') {
                    setTimeout(initPDFScript, 100);
                    return;
                }
                
                var $ = jQuery;
                
                $(document).ready(function () {
                    // Wait for html2pdf to be fully loaded
                    function waitForHtml2Pdf(callback, maxAttempts) {
                        var attempts = 0;
                        var checkInterval = setInterval(function() {
                            attempts++;
                            if (typeof html2pdf !== 'undefined') {
                                clearInterval(checkInterval);
                                callback();
                            } else if (attempts >= maxAttempts) {
                                clearInterval(checkInterval);
                                alert('@L.Js("Mes_PdfLibNotLoaded")');
                            }
                        }, 100);
                    }
                    
                    // Use event delegation for PDF button
                    $(document).on('click', '#generatePDF', function (e) {
                        e.preventDefault();
                        
                        var btn = $(this);
                        var originalHtml = btn.html();
                        btn.prop('disabled', true).html('<i class="bx bx-loader-alt bx-spin"></i> ' + '@L.Js("Mes_PdfGenerating")');

                        waitForHtml2Pdf(function() {
                            // Get the content to convert to PDF - use the invoice-edit-wrapper
                            var element = document.getElementById('normContent');
                            
                            if (!element) {
                                alert('@L.Js("Mes_Norm_PdfNoContent")');
                                btn.prop('disabled', false).html(originalHtml);
                                return;
                            }
                            
                            // Configure PDF options
                            var productCode = '@(Model?.ProductCode ?? "Norm")';
                            var period = '@(Model?.Period ?? DateTime.Now.ToString("yyyy-MM"))';
                            var orientation = 'landscape';
                            
                            var opt = {
                                margin: [0.15, 0.15, 0.15, 0.15],
                                filename: 'Norm_' + productCode + '_' + period + '.pdf',
                                image: { type: 'jpeg', quality: 0.98 },
                                html2canvas: { 
                                    scale: 2,
                                    useCORS: true,
                                    logging: false,
                                    scrollX: 0,
                                    scrollY: 0,
                                    windowWidth: element.scrollWidth,
                                    windowHeight: element.scrollHeight
                                },
                                jsPDF: { 
                                    unit: 'in', 
                                    format: 'a3',
                                    orientation: orientation
                                },
                                pagebreak: { mode: ['css', 'legacy'] }
                            };
                            
                            // Generate PDF
                            html2pdf().set(opt).from(element).save().then(function() {
                                // Restore button
                                btn.prop('disabled', false).html(originalHtml);
                            }).catch(function(error) {
                                console.error('PDF yaratishda xatolik:', error);
                                alert('@L.Js("Mes_PdfError") ' + (error.message || '@L.Js("Mes_UnknownError")'));
                                btn.prop('disabled', false).html(originalHtml);
                            });
                        }, 50);
                    });
                });
            }
            
            // Start initialization
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initPDFScript);
            } else {
                initPDFScript();
            }
        })();
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

