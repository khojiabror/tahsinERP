@model tahsinERP.ViewModels.ProductNormViewModel
@{
    ViewBag.Title = "Norma kiritish - Ko'rish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="~/Norm">Norma kiritish</a></li>
                                    <li class="breadcrumb-item active">Ko'rish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        <h4 class="text-primary mb-3">Mahsulot ma'lumotlari</h4>
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Mahsulot raqami</label>
                                                    <input type="text" class="form-control" value="@Model.ProductCode" readonly />
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Mahsulot nomi</label>
                                                    <input type="text" class="form-control" value="@Model.ProductName" readonly />
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Oy</label>
                                                    <input type="text" class="form-control" value="@Model.Period" readonly />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>Samarali sanadan</label>
                                                    <input type="text" class="form-control" value="@(Model.EffectiveFrom?.ToString("yyyy-MM-dd") ?? "-")" readonly />
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>Samarali sanagacha</label>
                                                    <input type="text" class="form-control" value="@(Model.EffectiveTo?.ToString("yyyy-MM-dd") ?? "-")" readonly />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label>Izoh</label>
                                            <textarea class="form-control" rows="2" readonly>@Model.Comment</textarea>
                                        </div>

                                        <hr>

                                        <h4 class="text-primary mb-3">Kesish variantlari</h4>
                                        <div class="table-responsive">
                                            <table class="table table-striped table-bordered">
                                                <thead class="thead-light">
                                                    <tr>
                                                        <th>Material</th>
                                                        <th>Material kodi</th>
                                                        <th>Uzunlik (mm)</th>
                                                        <th>Standart uzunlik (mm)</th>
                                                        <th>Miqdori</th>
                                                        <th>Sarflanish (m)</th>
                                                        <th>Chiqindi (m)</th>
                                                        <th>Narx</th>
                                                        <th>Toza sarf summa</th>
                                                        <th>Chiqindi summa</th>
                                                        <th>Jami narx</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.CuttingLines != null && Model.CuttingLines.Any())
                                                    {
                                                        foreach (var line in Model.CuttingLines)
                                                        {
                                                            var unitPriceValue = line.UnitPrice ?? 0;
                                                            var cleanCostValue = line.ConsumptionPerProduct * unitPriceValue;
                                                            var wasteCostValue = line.WastePerProduct * unitPriceValue;
                                                            var totalCostValue = cleanCostValue + wasteCostValue;
                                                            <tr>
                                                                <td>@(line.MaterialName ?? line.MaterialCode ?? "-")</td>
                                                                <td>@(line.MaterialCode ?? "-")</td>
                                                                <td>@(line.CalculatedLengthMm?.ToString("F2") ?? "-")</td>
                                                                <td>@(line.StandardLengthMm?.ToString("F2") ?? "-")</td>
                                                                <td>@line.Quantity</td>
                                                                <td>@line.ConsumptionPerProduct.ToString("F4")</td>
                                                                <td>@line.WastePerProduct.ToString("F4")</td>
                                                                <td>@(line.UnitPrice?.ToString("F2") ?? "-")</td>
                                                                <td>@cleanCostValue.ToString("F2")</td>
                                                                <td>@wasteCostValue.ToString("F2")</td>
                                                                <td>@totalCostValue.ToString("F2")</td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="11" class="text-center text-muted">Kesish variantlari topilmadi.</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <hr>

                                        <h4 class="text-primary mb-3">Jami hisoblar</h4>
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="card text-white" style="background: linear-gradient(135deg, #a8e6cf 0%, #7dd3a0 100%); border: none;">
                                                    <div class="card-body">
                                                        <h4>Umumiy norma Yo'goch (m)</h4>
                                                        <br />
                                                        <small>faqat kesiladigan lar uchun</small>
                                                        <h4>@Model.TotalNorm.ToString("F4")</h4>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="card text-white" style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%); border: none;">
                                                    <div class="card-body">
                                                        <h6>Umumiy chiqindi (m)</h6>
                                                        <br />
                                                        <small>faqat kesiladigan lar uchun</small>
                                                        <h4>@Model.TotalWaste.ToString("F4")</h4>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <hr>

                                        <h4 class="text-primary mb-3">Summa hisoblar</h4>
                                        @{
                                            // Calculate sums from model - barcha elementlar uchun
                                            decimal totalSarfSumma = Model.CuttingLines
                                                .Where(l => l.UnitPrice.HasValue && l.ConsumptionPerProduct > 0)
                                                .Sum(l => l.ConsumptionPerProduct * l.UnitPrice.Value);
                                            
                                            decimal totalChiqindiSumma = Model.CuttingLines
                                                .Where(l => l.UnitPrice.HasValue && l.WastePerProduct > 0)
                                                .Sum(l => l.UnitPrice.Value * l.WastePerProduct);
                                            
                                            decimal umumiySumma = totalSarfSumma + totalChiqindiSumma;
                                        }
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="card text-white" style="background: linear-gradient(135deg, #a8e6cf 0%, #7dd3a0 100%); border: none;">
                                                    <div class="card-body">
                                                        <h6>Umumiy toza sarf summa</h6>
                                                        <br />
                                                        <small>barcha elementlar uchun</small>
                                                        <h4>@totalSarfSumma.ToString("F2")</h4>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="card text-white" style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%); border: none;">
                                                    <div class="card-body">
                                                        <h6>Umumiy chiqindi summa</h6>
                                                        <br />
                                                        <small>barcha elementlar uchun</small>
                                                        <h4>@totalChiqindiSumma.ToString("F2")</h4>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="card" style="background-color: #ffeaa7; border-color: #fdcb6e;">
                                                    <div class="card-body">
                                                        <h6>Umumiy summa</h6>
                                                        <br />
                                                        <small class="text-muted">barcha elementlar uchun</small>
                                                        <h4>@umumiySumma.ToString("F2")</h4>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <hr>

                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <button id="generatePDF" class="btn btn-outline-danger">
                                                    <i class='bx bx-save'></i> PDF
                                                </button>
                                                @if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
                                                {
                                                    <a href="@Url.Action("Edit", "Norm", new { normVersionId = Model.NormVersionID })" class="btn btn-primary">
                                                        <i class="bx bx-edit"></i> Tahrirlash
                                                    </a>
                                                }
                                                <a href="@Url.Action("Details", "Norm", new { id = Model.ProductID })" class="btn btn-secondary">
                                                    <i class="bx bx-arrow-back"></i> Orqaga
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <!-- html2pdf.js library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
    
    <script>
        // Wait for jQuery and html2pdf to be loaded
        (function() {
            function initPDFScript() {
                // Check if jQuery is available
                if (typeof jQuery === 'undefined' || typeof jQuery.fn === 'undefined') {
                    setTimeout(initPDFScript, 100);
                    return;
                }
                
                var $ = jQuery;
                
                $(document).ready(function () {
                    // Wait for html2pdf to be fully loaded
                    function waitForHtml2Pdf(callback, maxAttempts) {
                        var attempts = 0;
                        var checkInterval = setInterval(function() {
                            attempts++;
                            if (typeof html2pdf !== 'undefined') {
                                clearInterval(checkInterval);
                                callback();
                            } else if (attempts >= maxAttempts) {
                                clearInterval(checkInterval);
                                alert('PDF kutubxonasi yuklanmadi. Iltimos, sahifani yangilang.');
                            }
                        }, 100);
                    }
                    
                    // Use event delegation for PDF button
                    $(document).on('click', '#generatePDF', function (e) {
                        e.preventDefault();
                        
                        var btn = $(this);
                        var originalHtml = btn.html();
                        btn.prop('disabled', true).html('<i class="bx bx-loader-alt bx-spin"></i> PDF yaratilmoqda...');

                        waitForHtml2Pdf(function() {
                            // Get the content to convert to PDF - use the invoice-edit-wrapper
                            var element = document.querySelector('.invoice-edit-wrapper');
                            
                            if (!element) {
                                alert('PDF uchun kontent topilmadi. Element class: .invoice-edit-wrapper');
                                btn.prop('disabled', false).html(originalHtml);
                                return;
                            }
                            
                            // Configure PDF options
                            var productCode = '@(Model?.ProductCode ?? "Norm")';
                            var period = '@(Model?.Period ?? DateTime.Now.ToString("yyyy-MM"))';
                            var orientation = (window.erpExportHelpers && window.erpExportHelpers.getOrientationByElementSize)
                                ? window.erpExportHelpers.getOrientationByElementSize(element)
                                : 'portrait';
                            
                            var opt = {
                                margin: [8, 8, 8, 8],
                                filename: 'Norm_' + productCode + '_' + period + '.pdf',
                                image: { type: 'jpeg', quality: 0.98 },
                                html2canvas: { 
                                    scale: 2, 
                                    useCORS: true,
                                    logging: false,
                                    scrollX: 0,
                                    scrollY: 0,
                                    windowWidth: Math.max(element.scrollWidth, element.offsetWidth, document.body.scrollWidth),
                                    windowHeight: Math.max(element.scrollHeight, element.offsetHeight, document.body.scrollHeight)
                                },
                                jsPDF: { 
                                    unit: 'mm', 
                                    format: 'a4', 
                                    orientation: orientation
                                },
                                pagebreak: { mode: ['css', 'legacy'] }
                            };
                            
                            // Generate PDF
                            html2pdf().set(opt).from(element).save().then(function() {
                                // Restore button
                                btn.prop('disabled', false).html(originalHtml);
                            }).catch(function(error) {
                                console.error('PDF yaratishda xatolik:', error);
                                alert('PDF yaratishda xatolik yuz berdi: ' + (error.message || 'Noma\'lum xatolik'));
                                btn.prop('disabled', false).html(originalHtml);
                            });
                        }, 50);
                    });
                });
            }
            
            // Start initialization
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initPDFScript);
            } else {
                initPDFScript();
            }
        })();
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

