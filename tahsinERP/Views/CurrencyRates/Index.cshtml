@{
    ViewBag.Title = "Valyuta kurslari";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var rows = ViewBag.Rows as List<tahsinERP.Controllers.CurrencyRatesController.RateRow> ?? new List<tahsinERP.Controllers.CurrencyRatesController.RateRow>();
    var names = ViewBag.CurrencyNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    bool tableExists = ViewBag.TableExists ?? false;
    bool changePermit = tahsinERP.Models.RoleHelper.IsPermittedForAction(User.Identity.Name, "Currency", "Edit", true);
    DateTime from = ViewBag.FromDate;
    DateTime to = ViewBag.ToDate;
}
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                    <li class="breadcrumb-item"><a href="~/Currency">Valyutalar</a></li>
                    <li class="breadcrumb-item active">Kurslar</li>
                </ol>
            </div>
        </div>
        <div class="content-body">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (!tableExists)
            {
                <div class="alert alert-warning">
                    CURRENCY_RATES jadvali hali yaratilmagan (<code>Database_Migrations/CRM_2026_10_CurrencyRates.sql</code>).
                    Hozircha hisobotlar kursni to'g'ridan-to'g'ri cbu.uz'dan oladi va saqlamaydi.
                </div>
            }

            <div class="card">
                <div class="card-body">
                    <p class="text-muted mb-1">
                        Kurs — 1 birlik valyuta necha so'm. CRM hisobotlari va dashboard summalarni hujjat sanasidagi kurs bilan so'mga o'giradi.
                        Kurs jadvalda bo'lmasa cbu.uz'dan avtomatik olinib saqlanadi; bu yerda qo'lda tuzatish mumkin.
                    </p>
                    <form method="get" action="@Url.Action("Index")" class="row align-items-end">
                        <div class="col-md-3"><label>Valyuta</label>@Html.DropDownList("currencyId", ViewBag.Currencies as SelectList, "Barchasi", new { @class = "form-control" })</div>
                        <div class="col-md-3"><label>Dan</label><input type="date" name="fromDate" class="form-control" value="@from.ToString("yyyy-MM-dd")" /></div>
                        <div class="col-md-3"><label>Gacha</label><input type="date" name="toDate" class="form-control" value="@to.ToString("yyyy-MM-dd")" /></div>
                        <div class="col-md-3"><button type="submit" class="btn btn-primary w-100">Ko'rsatish</button></div>
                    </form>
                </div>
            </div>

            @if (changePermit && tableExists)
            {
                <div class="row">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <h6>Kursni qo'lda kiritish</h6>
                                @using (Html.BeginForm("Save", "CurrencyRates", FormMethod.Post, new { @class = "row align-items-end" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <div class="col-4">@Html.DropDownList("currencyId", ViewBag.Currencies as SelectList, new { @class = "form-control", required = "required" })</div>
                                    <div class="col-4"><input type="date" name="rateDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                                    <div class="col-4"><input type="number" name="rate" class="form-control" step="0.000001" min="0.000001" placeholder="so'm" required /></div>
                                    <div class="col-12 mt-1"><button type="submit" class="btn btn-success">Saqlash</button></div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <h6>CBU'dan davr bo'yicha yuklash</h6>
                                @using (Html.BeginForm("FetchFromCbu", "CurrencyRates", FormMethod.Post, new { @class = "row align-items-end" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <div class="col-4">@Html.DropDownList("currencyId", ViewBag.Currencies as SelectList, new { @class = "form-control", required = "required" })</div>
                                    <div class="col-4"><input type="date" name="fromDate" class="form-control" value="@from.ToString("yyyy-MM-dd")" required /></div>
                                    <div class="col-4"><input type="date" name="toDate" class="form-control" value="@to.ToString("yyyy-MM-dd")" required /></div>
                                    <div class="col-12 mt-1"><button type="submit" class="btn btn-outline-primary">Yetishmayotganlarni yuklash (≤ 92 kun)</button></div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr><th>Sana</th><th>Valyuta</th><th class="text-right">Kurs (so'm)</th><th>Manba</th></tr>
                            </thead>
                            <tbody>
                                @if (!rows.Any())
                                {
                                    <tr><td colspan="4" class="text-center text-muted">Bu davr uchun kurslar yo'q</td></tr>
                                }
                                @foreach (var r in rows)
                                {
                                    <tr>
                                        <td>@r.RateDate.ToString("dd.MM.yyyy")</td>
                                        <td>@(names.ContainsKey(r.CurrencyID) ? names[r.CurrencyID] : "#" + r.CurrencyID)</td>
                                        <td class="text-right">@r.Rate.ToString("N4")</td>
                                        <td>@(r.Source == "MANUAL" ? "Qo'lda" : r.Source)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
