@{
    ViewBag.Title = "Xarid arizalari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    bool changePermit = ViewBag.ChangePermit as bool? ?? false;
}
<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Xarid arizalari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "PRequisitions")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi ariza
                            </a>
                        </div>
                    }

                    <!-- Status Filter -->
                    <div class="row mb-2">
                        <div class="col-md-3">
                            @using (Html.BeginForm("Index", "PRequisitions", FormMethod.Get, new { id = "requisitionsFilter" }))
                            {
                                <div class="form-group">
                                    <label for="statusFilter">Status bo'yicha filtrlash</label>
                                    @Html.DropDownList("statusFilter", ViewBag.StatusList as SelectList, new { @class = "form-control select2" })
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="requisitionsTable" class="table dt-responsive nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Ariza raqami</th>
                                                    <th>Sana</th>
                                                    <th>Bo'lim</th>
                                                    <th>So'rovchi</th>
                                                    <th>Status</th>
                                                    <th>Mahsulotlar soni</th>
                                                    <th>Jami summa</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

@section Scripts {
    <script src="~/Scripts/srm/srm-server-table.js"></script>
    <script>
        $(document).ready(function () {
            var detailsUrl = '@Url.Action("Details", "PRequisitions")/';
            var convertUrl = '@Url.Action("ConvertToOrder", "PRequisitions")/';
            var statusClasses = { Draft: 'badge-secondary', Submitted: 'badge-info', Approved: 'badge-success', Rejected: 'badge-danger', ConvertedToOrder: 'badge-primary' };
            var columns = [
                { data: 'requisitionNo', render: function (v, t, r) { return '<a href="' + detailsUrl + r.id + '">' + srmEsc(v) + '</a>'; } },
                { data: 'date' },
                { data: 'department', render: function (v) { return srmEsc(v || '-'); } },
                { data: 'requester', render: function (v) { return srmEsc(v || '-'); } },
                { data: 'status', render: function (v) { return '<span class="badge ' + (statusClasses[v] || 'badge-secondary') + '">' + srmEsc(v) + '</span>'; } },
                { data: 'lineCount' },
                { data: 'total' }
            ];
            @if (changePermit)
            {
                <text>
                columns.push({
                    data: null, orderable: false, render: function (v, t, r) {
                        var html = '<div class="d-flex"><a href="' + detailsUrl + r.id + '" class="btn btn-sm btn-icon btn-outline-primary mr-1" title="Ko&#39;rish"><i class="bx bx-show"></i></a>';
                        if (r.status === 'Approved') {
                            html += '<a href="' + convertUrl + r.id + '" class="btn btn-sm btn-icon btn-outline-success mr-1" title="Buyurtmaga aylantirish"><i class="bx bx-cart"></i></a>';
                        }
                        return html + '</div>';
                    }
                });
                </text>
            }
            var table = srmServerTable('#requisitionsTable', {
                dataUrl: '@Url.Action("IndexData", "PRequisitions")',
                exportUrl: '@Url.Action("ExportExcel", "PRequisitions")',
                filterForm: '#requisitionsFilter',
                order: [[1, 'desc']],
                columns: columns
            });
            $('#requisitionsFilter select').on('change', function () { table.ajax.reload(); });
            $('#requisitionsFilter').on('submit', function (e) { e.preventDefault(); table.ajax.reload(); });
        });
    </script>
}
