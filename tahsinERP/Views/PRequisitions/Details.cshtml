@model tahsinERP.Models.P_REQUISITIONS
@{
    ViewBag.Title = "Xarid arizasi - " + Model.RequisitionNo;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "PRequisitions", "Details"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "PRequisitions");

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/PRequisitions/Index">Xarid arizalari</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @Model.RequisitionNo
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="row mb-2">
                                        <div class="col-12">
                                            <h4 class="text-primary">Ariza ma'lumotlari</h4>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <strong>Ariza raqami:</strong><br />
                                            @Model.RequisitionNo
                                        </div>
                                        <div class="col-md-3">
                                            <strong>Ariza sanasi:</strong><br />
                                            @Model.RequisitionDate.ToString("dd.MM.yyyy")
                                        </div>
                                        <div class="col-md-3">
                                            <strong>Status:</strong><br />
                                            @{
                                                var statusClass = "badge-secondary";
                                                switch (Model.Status)
                                                {
                                                    case "Draft": statusClass = "badge-secondary"; break;
                                                    case "Submitted": statusClass = "badge-info"; break;
                                                    case "Approved": statusClass = "badge-success"; break;
                                                    case "Rejected": statusClass = "badge-danger"; break;
                                                    case "ConvertedToOrder": statusClass = "badge-primary"; break;
                                                }
                                            }
                                            <span class="badge @statusClass">@Model.Status</span>
                                        </div>
                                        <div class="col-md-3">
                                            @if (changePermit && Model.Status == "Approved")
                                            {
                                                <a href="@Url.Action("ConvertToOrder", "PRequisitions", new { id = Model.ID })" class="btn btn-success">
                                                    <i class="bx bx-cart"></i> Buyurtmaga aylantirish
                                                </a>
                                            }
                                        </div>
                                    </div>

                                    <hr />

                                    <div class="row">
                                        <div class="col-md-6">
                                            <strong>Bo'lim:</strong><br />
                                            @{
                                                var department = Model.DepartmentID.HasValue ? 
                                                    (ViewBag.Departments as List<tahsinERP.Models.HR_ORG_UNITS>)?.FirstOrDefault(d => d.ID == Model.DepartmentID.Value) : null;
                                            }
                                            @(department?.Name ?? "-")
                                        </div>
                                        <div class="col-md-6">
                                            <strong>So'rovchi:</strong><br />
                                            @{
                                                var requester = ViewBag.Requesters as List<tahsinERP.Models.HR_EMPLOYEES>;
                                                var requesterEmployee = requester?.FirstOrDefault(e => e.ID == Model.RequesterID);
                                            }
                                            @(requesterEmployee?.FullName ?? "-")
                                        </div>
                                        <div class="col-md-6 mt-2">
                                            <strong>Aloqa telefon:</strong><br />
                                            @(Model.ContactPhone ?? "-")
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <strong>Xarid qilish maqsadi:</strong><br />
                                            <p>@(Model.Purpose ?? "-")</p>
                                        </div>
                                    </div>

                                    <hr />

                                    <h5 class="mt-3">Mahsulotlar</h5>
                                    <div class="table-responsive">
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>Mahsulot kodi</th>
                                                    <th>Mahsulot nomi</th>
                                                    <th>Miqdor</th>
                                                    <th>Birlik</th>
                                                    <th>Tahminiy narx</th>
                                                    <th>Summa</th>
                                                    <th>Prioritet</th>
                                                    <th>Kerak bo'lgan sana</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.P_REQUISITION_PRODUCTS != null && Model.P_REQUISITION_PRODUCTS.Any())
                                                {
                                                    int index = 1;
                                                    foreach (var product in Model.P_REQUISITION_PRODUCTS)
                                                    {
                                                        <tr>
                                                            <td>@index</td>
                                                            <td>@(product.PRODUCT?.PNo ?? "-")</td>
                                                            <td>@(product.PRODUCT?.Name ?? "-")</td>
                                                            <td>@product.Quantity.ToString("N2")</td>
                                                            <td>@(product.UNIT?.ShortName ?? "-")</td>
                                                            <td>@(product.EstimatedPrice?.ToString("N2") ?? "0.00")</td>
                                                            <td>@(product.Amount?.ToString("N2") ?? "0.00")</td>
                                                            <td>
                                                                @{
                                                                    var priorityClass = "badge-secondary";
                                                                    if (product.Priority == "High") priorityClass = "badge-danger";
                                                                    else if (product.Priority == "Medium") priorityClass = "badge-warning";
                                                                    else if (product.Priority == "Low") priorityClass = "badge-info";
                                                                }
                                                                <span class="badge @priorityClass">@(product.Priority ?? "Medium")</span>
                                                            </td>
                                                            <td>@(product.RequiredDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                                                        </tr>
                                                        index++;
                                                    }
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td colspan="6" class="text-right"><strong>Jami:</strong></td>
                                                    <td><strong>@(Model.P_REQUISITION_PRODUCTS?.Sum(p => p.Amount ?? 0)?.ToString("N2") ?? "0.00")</strong></td>
                                                    <td colspan="2"></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>

                                    @if (Model.P_REQUISITION_APPROVALS != null && Model.P_REQUISITION_APPROVALS.Any())
                                    {
                                        <hr />
                                        <h5 class="mt-3">Tasdiqlash jarayoni</h5>
                                        <div class="table-responsive">
                                            <table class="table table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th>Rol</th>
                                                        <th>Tasdiqlovchi</th>
                                                        <th>Status</th>
                                                        <th>Sana</th>
                                                        <th>Izoh</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var approval in Model.P_REQUISITION_APPROVALS.OrderBy(a => a.SortOrder))
                                                    {
                                                        <tr>
                                                            <td>@approval.Role</td>
                                                            <td>@(approval.ApproverName ?? "-")</td>
                                                            <td>
                                                                @{
                                                                    var approvalStatusClass = "badge-secondary";
                                                                    if (approval.Status == "Approved") approvalStatusClass = "badge-success";
                                                                    else if (approval.Status == "Rejected") approvalStatusClass = "badge-danger";
                                                                }
                                                                <span class="badge @approvalStatusClass">@(approval.Status ?? "Pending")</span>
                                                            </td>
                                                            <td>@(approval.ApprovalDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                                                            <td>@(approval.Comments ?? "-")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <a href="@Url.Action("Index", "PRequisitions")" class="btn btn-secondary">
                                                <i class="bx bx-arrow-back"></i> Orqaga
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

