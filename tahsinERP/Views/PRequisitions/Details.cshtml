@model tahsinERP.Models.P_REQUISITIONS
@{
    ViewBag.Title = L.T("Srm_RequisitionTitleNo", Model.RequisitionNo);
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "PRequisitions");
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/PRequisitions/Index">@L.T("Menu_PurchaseRequests")</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @Model.RequisitionNo
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-12">
                                        <h4 class="text-primary">@L.T("Srm_RequisitionInfo")</h4>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-3">
                                        <strong>@L.T("Srm_RequisitionNo"):</strong><br />
                                        @Model.RequisitionNo
                                    </div>
                                    <div class="col-md-3">
                                        <strong>@L.T("Srm_RequisitionDate"):</strong><br />
                                        @Model.RequisitionDate.ToString("dd.MM.yyyy")
                                    </div>
                                    <div class="col-md-3">
                                        <strong>@L.T("Status"):</strong><br />
                                        @{
                                            var statusClass = "badge-secondary";
                                            switch (Model.Status)
                                            {
                                                case "Draft": statusClass = "badge-secondary"; break;
                                                case "Submitted": statusClass = "badge-info"; break;
                                                case "Approved": statusClass = "badge-success"; break;
                                                case "Rejected": statusClass = "badge-danger"; break;
                                                case "ConvertedToOrder": statusClass = "badge-primary"; break;
                                            }
                                        }
                                        <span class="badge @statusClass">@tahsinERP.Services.Procurement.RequisitionText.Status(Model.Status)</span>
                                    </div>
                                    <div class="col-md-3">
                                        @if (changePermit && Model.Status == "Approved")
                                        {
                                            <a href="@Url.Action("ConvertToOrder", "PRequisitions", new { id = Model.ID })" class="btn btn-success">
                                                <i class="bx bx-cart"></i> @L.T("Srm_ConvertToOrder")
                                            </a>
                                        }
                                        @if (changePermit && Model.Status == "Draft")
                                        {
                                            using (Html.BeginForm("Submit", "PRequisitions", new { id = Model.ID }, FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-primary" onclick="return confirm('@L.Js("Srm_ConfirmSubmitRequisition")');">
                                                    <i class="bx bx-send"></i> @L.T("Srm_SendForApproval")
                                                </button>
                                            }
                                        }
                                        @if (changePermit && Model.Status == "Submitted")
                                        {
                                            using (Html.BeginForm("Approve", "PRequisitions", new { id = Model.ID }, FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success mb-1" onclick="return confirm('@L.Js("Srm_ConfirmApproveRequisition")');">
                                                    <i class="bx bx-check"></i> @L.T("Approve")
                                                </button>
                                            }
                                            using (Html.BeginForm("Reject", "PRequisitions", new { id = Model.ID }, FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <textarea name="reason" class="form-control mb-1" rows="2" placeholder="@L.T("Srm_RejectReason")" required></textarea>
                                                <button type="submit" class="btn btn-danger">
                                                    <i class="bx bx-x"></i> @L.T("Reject")
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                                @if (TempData["SuccessMessage"] != null)
                                {
                                    <div class="alert alert-success mt-1">@TempData["SuccessMessage"]</div>
                                }
                                @if (TempData["ErrorMessage"] != null)
                                {
                                    <div class="alert alert-danger mt-1">@TempData["ErrorMessage"]</div>
                                }
                                @if (Model.Status == "Rejected" && !string.IsNullOrWhiteSpace(Model.RejectionReason))
                                {
                                    <div class="alert alert-warning mt-1"><strong>@L.T("Srm_RejectReason"):</strong> @Model.RejectionReason</div>
                                }

                                <hr />

                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>@L.T("Srm_Department"):</strong><br />
                                        @{
                                            var department = Model.DepartmentID.HasValue ? 
                                                (ViewBag.Departments as List<tahsinERP.Models.HR_ORG_UNITS>)?.FirstOrDefault(d => d.ID == Model.DepartmentID.Value) : null;
                                        }
                                        @(department?.Name ?? "-")
                                    </div>
                                    <div class="col-md-6">
                                        <strong>@L.T("Srm_Requester"):</strong><br />
                                        @{
                                            var requester = ViewBag.Requesters as List<tahsinERP.Models.HR_EMPLOYEES>;
                                            var requesterEmployee = requester?.FirstOrDefault(e => e.ID == Model.RequesterID);
                                        }
                                        @(requesterEmployee?.FullName ?? "-")
                                    </div>
                                    <div class="col-md-6 mt-2">
                                        <strong>@L.T("Srm_ContactPhone"):</strong><br />
                                        @(Model.ContactPhone ?? "-")
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-12">
                                        <strong>@L.T("Srm_PurchasePurpose"):</strong><br />
                                        <p>@(Model.Purpose ?? "-")</p>
                                    </div>
                                </div>

                                <hr />

                                <h5 class="mt-3">@L.T("Srm_Products")</h5>
                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>@L.T("Srm_ProductCode")</th>
                                                <th>@L.T("Srm_ProductName")</th>
                                                <th>@L.T("Quantity")</th>
                                                <th>@L.T("Unit")</th>
                                                <th>@L.T("Srm_EstimatedPrice")</th>
                                                <th>@L.T("Amount")</th>
                                                <th>@L.T("Srm_Priority")</th>
                                                <th>@L.T("Srm_RequiredDate")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.P_REQUISITION_PRODUCTS != null && Model.P_REQUISITION_PRODUCTS.Any())
                                            {
                                                int index = 1;
                                                foreach (var product in Model.P_REQUISITION_PRODUCTS)
                                                {
                                                    <tr>
                                                        <td>@index</td>
                                                        <td>@(product.PRODUCT?.PNo ?? "-")</td>
                                                        <td>@(product.PRODUCT?.Name ?? "-")</td>
                                                        <td>@product.Quantity.ToString("N2")</td>
                                                        <td>@(product.UNIT?.ShortName ?? "-")</td>
                                                        <td>@(product.EstimatedPrice?.ToString("N2") ?? "0.00")</td>
                                                        <td>@(product.Amount?.ToString("N2") ?? "0.00")</td>
                                                        <td>
                                                            @{
                                                                var priorityClass = "badge-secondary";
                                                                if (product.Priority == "High") { priorityClass = "badge-danger"; }
                                                                else if (product.Priority == "Medium") { priorityClass = "badge-warning"; }
                                                                else if (product.Priority == "Low") { priorityClass = "badge-info"; }
                                                            }
                                                            <span class="badge @priorityClass">@tahsinERP.Services.Procurement.RequisitionText.Priority(product.Priority ?? "Medium")</span>
                                                        </td>
                                                        <td>@(product.RequiredDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                                                    </tr>
                                                    index++;
                                                }
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="6" class="text-right"><strong>@L.T("Total"):</strong></td>
                                                <td><strong>@((Model.P_REQUISITION_PRODUCTS?.Sum(p => p.Amount ?? 0) ?? 0).ToString("N2"))</strong></td>
                                                <td colspan="2"></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>

                                @if (Model.P_REQUISITION_APPROVALS != null && Model.P_REQUISITION_APPROVALS.Any())
                                {
                                    <hr />
                                    <h5 class="mt-3">@L.T("Srm_ApprovalProcess")</h5>
                                    <div class="table-responsive">
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Srm_Role")</th>
                                                    <th>@L.T("Srm_Approver")</th>
                                                    <th>@L.T("Status")</th>
                                                    <th>@L.T("Date")</th>
                                                    <th>@L.T("Comment")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var approval in Model.P_REQUISITION_APPROVALS.OrderBy(a => a.SortOrder))
                                                {
                                                    <tr>
                                                        <td>@tahsinERP.Services.Procurement.RequisitionText.Role(approval.Role)</td>
                                                        <td>@(approval.ApproverName ?? "-")</td>
                                                        <td>
                                                            @{
                                                                var approvalStatusClass = "badge-secondary";
                                                                if (approval.Status == "Approved") { approvalStatusClass = "badge-success"; }
                                                                else if (approval.Status == "Rejected") { approvalStatusClass = "badge-danger"; }
                                                            }
                                                            <span class="badge @approvalStatusClass">@tahsinERP.Services.Procurement.RequisitionText.Status(approval.Status ?? "Pending")</span>
                                                        </td>
                                                        <td>@(approval.ApprovalDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                                                        <td>@(approval.Comments ?? "-")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                <div class="row mt-3">
                                    <div class="col-12">
                                        <a href="@Url.Action("Index", "PRequisitions")" class="btn btn-secondary">
                                            <i class="bx bx-arrow-back"></i> @L.T("Back")
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

