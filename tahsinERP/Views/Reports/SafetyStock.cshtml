@model tahsinERP.ViewModels.Reports.SRMSafetyStockViewModel
@{
    ViewBag.Title = L.T("Doc_RepSafetyStockTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item ">
                                    @Html.Link(L.T("Doc_RepSrmReports"), "SRMDashboard", module: "Supplier")
                                </li>
                                <li class="breadcrumb-item active">
                                    Zaxira zaxirasi (Safety stock)
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <section class="invoice-list-wrapper">
                <div class="users-list-filter px-1 mb-1">
                    @using (Html.BeginForm("SafetyStock", "Reports", FormMethod.Get, new { @class = "form" }))
                    {
                        <div class="row border rounded py-2 mb-2">
                            <div class="col-md-2 col-sm-6">
                                <label>@L.T("Doc_RepWarehouseColon")</label>
                                @Html.DropDownList("warehouseId", Model.Warehouses as IEnumerable<SelectListItem>, new { @class = "form-control" })
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <label>@L.T("Doc_RepCategoryColon")</label>
                                @Html.DropDownList("categoryId", Model.Categories as IEnumerable<SelectListItem>, new { @class = "form-control" })
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <label>@L.T("Doc_RepProductTypeColon")</label>
                                <select name="productType" class="form-control">
                                    <option value="" @(string.IsNullOrEmpty(Model.ProductType) ? "selected=\"selected\"" : "")>@L.T("All")</option>
                                    <option value="finished" @(Model.ProductType == "finished" ? "selected=\"selected\"" : "")>@L.T("Menu_FinishedGoods")</option>
                                    <option value="raw" @(Model.ProductType == "raw" ? "selected=\"selected\"" : "")>@L.T("Menu_RawMaterials")</option>
                                </select>
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <label>@L.T("Doc_RepFromColon")</label>
                                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <label>@L.T("Doc_RepToColon")</label>
                                <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-1 col-sm-6">
                                <label>@L.T("Doc_RepServiceLevel")</label>
                                <input type="number" name="serviceLevel" class="form-control" min="80" max="99" step="1" value="@Model.ServiceLevel" title="Mijoz talabini qondirish ehtimoli (masalan 95)" />
                            </div>
                            <div class="col-md-1 col-sm-6">
                                <label>@L.T("Doc_RepLeadTime")</label>
                                <input type="number" name="leadTimeDays" class="form-control" min="1" max="60" step="1" value="@Model.LeadTimeDays" title="Buyurtmadan yetkazib berishgacha kunlar" />
                            </div>
                            <div class="col-md-1 col-sm-6 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary btn-block">
                                    <i class="bx bx-refresh"></i> @L.T("Doc_RepCalculate")
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-md-12 col-sm-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="safetyTable" class="table table-striped table-bordered nowrap" style="width:100%">
                                        <thead>
                                            <tr class="table-primary">
                                                <th>@L.T("Code")</th>
                                                <th>@L.T("Doc_RepProduct")</th>
                                                <th>@L.T("Unit")</th>
                                                <th class="text-right">@L.T("Doc_RepAvgDailyDemand")</th>
                                                <th class="text-right">@L.T("Doc_RepStdDev")</th>
                                                <th class="text-right">@L.T("Doc_RepSafetyStock")</th>
                                                <th class="text-right">@L.T("Doc_RepStockDays")</th>
                                                <th class="text-right">@L.T("Doc_RepReorderPoint")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.Items)
                                            {
                                                var rowClass = "";
                                                if (item.SafetyDOH.HasValue && item.SafetyDOH.Value < 3)
                                                {
                                                    rowClass = "table-danger";
                                                }
                                                else if (item.SafetyDOH.HasValue && item.SafetyDOH.Value < 7)
                                                {
                                                    rowClass = "table-warning";
                                                }
                                                else
                                                {
                                                    rowClass = "table-light";
                                                }
                                                <tr class="@rowClass">
                                                    <td>@item.ProductCode</td>
                                                    <td>@item.ProductName</td>
                                                    <td>@item.UnitName</td>
                                                    <td class="text-right">@item.AverageDailyDemand.ToString("N2")</td>
                                                    <td class="text-right">@item.StdDevDailyDemand.ToString("N2")</td>
                                                    <td class="text-right">@item.SafetyStock.ToString("N2")</td>
                                                    <td class="text-right">@(item.SafetyDOH.HasValue ? item.SafetyDOH.Value.ToString("N1") : "-")</td>
                                                    <td class="text-right">@item.ReorderPoint.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
}</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#safetyTable').DataTable({
                language: erpDataTable.language,
                pageLength: 50,
                scrollX: true,
                dom: 'lBfrtip',
                buttons: erpDataTable.buttons({ landscape: true, pdfOptions: { pageSize: 'A3', title: '@L.Js("Doc_RepSafetyStock")' } })
            });
        });
    </script>
}
