@model tahsinERP.ViewModels.Reports.SRMSafetyStockViewModel
@{
    ViewBag.Title = "Zaxira zaxirasi va qayta buyurtma nuqtasi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item ">
                                    SRM Hisobotlar
                                </li>
                                <li class="breadcrumb-item active">
                                    Zaxira zaxirasi (Safety stock)
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <section class="invoice-list-wrapper">
                <div class="users-list-filter px-1 mb-1">
                    @using (Html.BeginForm("SafetyStock", "Reports", FormMethod.Get, new { @class = "form" }))
                    {
                        <div class="row border rounded py-2 mb-2">
                            <div class="col-md-2 col-sm-6">
                                <label>Ombor:</label>
                                @Html.DropDownList("warehouseId", Model.Warehouses as IEnumerable<SelectListItem>, new { @class = "form-control" })
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <label>Kategoriya:</label>
                                @Html.DropDownList("categoryId", Model.Categories as IEnumerable<SelectListItem>, new { @class = "form-control" })
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <label>Mahsulot turi:</label>
                                <select name="productType" class="form-control">
                                    <option value="" @(string.IsNullOrEmpty(Model.ProductType) ? "selected=\"selected\"" : "")>Barchasi</option>
                                    <option value="finished" @(Model.ProductType == "finished" ? "selected=\"selected\"" : "")>Tayyor mahsulot</option>
                                    <option value="raw" @(Model.ProductType == "raw" ? "selected=\"selected\"" : "")>Xomashyo</option>
                                </select>
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <label>Dan:</label>
                                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <label>Gacha:</label>
                                <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-1 col-sm-6">
                                <label>Xizmat darajasi, %</label>
                                <input type="number" name="serviceLevel" class="form-control" min="80" max="99" step="1" value="@Model.ServiceLevel" title="Mijoz talabini qondirish ehtimoli (masalan 95)" />
                            </div>
                            <div class="col-md-1 col-sm-6">
                                <label>Yetkazish muddati, kun</label>
                                <input type="number" name="leadTimeDays" class="form-control" min="1" max="60" step="1" value="@Model.LeadTimeDays" title="Buyurtmadan yetkazib berishgacha kunlar" />
                            </div>
                            <div class="col-md-1 col-sm-6 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary btn-block">
                                    <i class="bx bx-refresh"></i> Hisoblash
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-md-12 col-sm-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="safetyTable" class="table table-striped table-bordered nowrap" style="width:100%">
                                        <thead>
                                            <tr class="table-primary">
                                                <th>Kod</th>
                                                <th>Mahsulot</th>
                                                <th>Birlik</th>
                                                <th class="text-right">O'rtacha kunlik talab</th>
                                                <th class="text-right">Og'ilish (kunlik)</th>
                                                <th class="text-right">Zaxira zaxirasi</th>
                                                <th class="text-right">Zaxira (kun)</th>
                                                <th class="text-right">Qayta buyurtma nuqtasi</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.Items)
                                            {
                                                var rowClass = "";
                                                if (item.SafetyDOH.HasValue && item.SafetyDOH.Value < 3)
                                                {
                                                    rowClass = "table-danger";
                                                }
                                                else if (item.SafetyDOH.HasValue && item.SafetyDOH.Value < 7)
                                                {
                                                    rowClass = "table-warning";
                                                }
                                                else
                                                {
                                                    rowClass = "table-light";
                                                }
                                                <tr class="@rowClass">
                                                    <td>@item.ProductCode</td>
                                                    <td>@item.ProductName</td>
                                                    <td>@item.UnitName</td>
                                                    <td class="text-right">@item.AverageDailyDemand.ToString("N2")</td>
                                                    <td class="text-right">@item.StdDevDailyDemand.ToString("N2")</td>
                                                    <td class="text-right">@item.SafetyStock.ToString("N2")</td>
                                                    <td class="text-right">@(item.SafetyDOH.HasValue ? item.SafetyDOH.Value.ToString("N1") : "-")</td>
                                                    <td class="text-right">@item.ReorderPoint.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
}</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#safetyTable').DataTable({
                language: {
                    search: "Qidirish:",
                    lengthMenu: "_MENU_ ta ko'rsatish",
                    info: "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    infoEmpty: "Yozuvlar yo'q",
                    infoFiltered: "(jami _MAX_ ta yozuvdan filtrlangan)",
                    paginate: {
                        first: "Birinchi",
                        last: "Oxirgi",
                        next: "Keyingi",
                        previous: "Oldingi"
                    },
                    zeroRecords: "Ma'lumot topilmadi"
                },
                pageLength: 50,
                scrollX: true,
                dom: 'lBfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bx bxs-file-excel"></i> Excel',
                        className: 'btn btn-success mr-1'
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bx bxs-file-pdf"></i> PDF',
                        className: 'btn btn-danger',
                        orientation: 'landscape',
                        pageSize: 'A3',
                        title: 'Zaxira zaxirasi'
                    }
                ]
            });
        });
    </script>
}
