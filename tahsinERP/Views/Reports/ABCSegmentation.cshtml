@model tahsinERP.ViewModels.Reports.SRMABCSegmentationViewModel
@{
    ViewBag.Title = "ABC / XYZ segmentatsiya";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item ">
                                    SRM Hisobotlar
                                </li>
                                <li class="breadcrumb-item active">
                                    ABC / XYZ segmentatsiya
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <section class="invoice-list-wrapper">
                <div class="users-list-filter px-1 mb-1">
                    @using (Html.BeginForm("ABCSegmentation", "Reports", FormMethod.Get, new { @class = "form" }))
                    {
                        <div class="row border rounded py-2 mb-2">
                            <div class="col-md-3 col-sm-6">
                                <label>Ombor:</label>
                                @Html.DropDownList("warehouseId", Model.Warehouses as IEnumerable<SelectListItem>, new { @class = "form-control" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label>Dan:</label>
                                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label>Gacha:</label>
                                <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-3 col-sm-6 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary btn-block">
                                    <i class="bx bx-refresh"></i> Hisoblash
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-md-12 col-sm-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="abcTable" class="table table-striped table-bordered nowrap" style="width:100%">
                                        <thead>
                                            <tr class="table-primary">
                                                <th>Kod</th>
                                                <th>Xomashyo</th>
                                                <th>Birlik</th>
                                                <th class="text-right">Talab (jami)</th>
                                                <th class="text-right">Ulush, %</th>
                                                <th class="text-right">Kumulyativ, %</th>
                                                <th>ABC</th>
                                                <th class="text-right">CoV</th>
                                                <th>XYZ</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.Items)
                                            {
                                                var abcClass = item.ABCClass;
                                                var xyzClass = item.XYZClass;
                                                var rowClass = "";
                                                if (abcClass == "A") { rowClass = "table-success"; }
                                                else if (abcClass == "B") { rowClass = "table-warning"; }
                                                else { rowClass = "table-light"; }
                                                <tr class="@rowClass">
                                                    <td>@item.ProductCode</td>
                                                    <td>@item.ProductName</td>
                                                    <td>@item.UnitName</td>
                                                    <td class="text-right">@item.TotalDemand.ToString("N2")</td>
                                                    <td class="text-right">@item.SharePercent.ToString("N1")</td>
                                                    <td class="text-right">@item.CumSharePercent.ToString("N1")</td>
                                                    <td class="text-center font-weight-bold">@item.ABCClass</td>
                                                    <td class="text-right">@item.CoefficientOfVariation.ToString("N2")</td>
                                                    <td class="text-center font-weight-bold">@item.XYZClass</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-12 col-sm-12 mt-2">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title mb-0">ABC / XYZ segmentatsiya izohi</h4>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>ABC klassifikatsiya (qiymat bo'yicha, oddiy so'zlar bilan):</strong></p>
                            <ul class="mb-1">
                                <li><strong>A klass (taxminan 80% qiymat):</strong> eng muhim, asosiy pul aylanadigan pozitsiyalar. Soni kam, lekin summasi juda katta. Ularni eng sinchkov nazorat qilish kerak.</li>
                                <li><strong>B klass (keyingi taxminan 15% qiymat):</strong> o'rtacha muhim pozitsiyalar. Ular bo'yicha boshqaruv ham muhim, lekin A klassdek qattiq emas.</li>
                                <li><strong>C klass (qolgan kichik qiymat qismi):</strong> juda ko'p turdagi, lekin umumiy qiymatda ulushi kichik bo'lgan oddiy pozitsiyalar. Ular uchun soddaroq boshqaruv yetarli bo'ladi.</li>
                            </ul>
                            <p class="mb-1"><strong>XYZ klassifikatsiya (talabning barqarorligi bo'yicha):</strong></p>
                            <ul class="mb-0">
                                <li><strong>X klass:</strong> talab deyarli bir xil, o'zgarishi juda past. Bunday pozitsiyalarni prognoz qilish va rejalashtirish eng oson.</li>
                                <li><strong>Y klass:</strong> talab o'rtacha o'zgaradi, mavsumiylik yoki trend bor. Prognoz o'rtacha aniqlikda bo'ladi.</li>
                                <li><strong>Z klass:</strong> talab juda notekis, ba'zan bor, ba'zan yo'q (sporadik). Prognoz qilish qiyin, shuning uchun safety stock siyosati ehtiyotkor va konservativ bo'lishi kerak.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
}</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#abcTable').DataTable({
                language: {
                    search: "Qidirish:",
                    lengthMenu: "_MENU_ ta ko'rsatish",
                    info: "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    infoEmpty: "Yozuvlar yo'q",
                    infoFiltered: "(jami _MAX_ ta yozuvdan filtrlangan)",
                    paginate: {
                        first: "Birinchi",
                        last: "Oxirgi",
                        next: "Keyingi",
                        previous: "Oldingi"
                    },
                    zeroRecords: "Ma'lumot topilmadi"
                },
                pageLength: 50,
                scrollX: true,
                dom: 'lBfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bx bxs-file-excel"></i> Excel',
                        className: 'btn btn-success mr-1'
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bx bxs-file-pdf"></i> PDF',
                        className: 'btn btn-danger',
                        orientation: 'landscape',
                        pageSize: 'A3',
                        title: 'ABC / XYZ segmentatsiya'
                    }
                ]
            });
        });
    </script>
}

