@model tahsinERP.ViewModels.Reports.SRMABCSegmentationViewModel
@{
    ViewBag.Title = L.T("Doc_RepAbcXyz");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item ">
                                    @L.T("Doc_RepSrmReports")
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Doc_RepAbcXyz")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <section class="invoice-list-wrapper">
                <div class="users-list-filter px-1 mb-1">
                    @using (Html.BeginForm("ABCSegmentation", "Reports", FormMethod.Get, new { @class = "form" }))
                    {
                        <div class="row border rounded py-2 mb-2">
                            <div class="col-md-3 col-sm-6">
                                <label>@L.T("Doc_RepWarehouseColon")</label>
                                @Html.DropDownList("warehouseId", Model.Warehouses as IEnumerable<SelectListItem>, new { @class = "form-control" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label>@L.T("Doc_RepFromColon")</label>
                                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label>@L.T("Doc_RepToColon")</label>
                                <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-3 col-sm-6 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary btn-block">
                                    <i class="bx bx-refresh"></i> @L.T("Doc_RepCalculate")
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-md-12 col-sm-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="abcTable" class="table table-striped table-bordered nowrap" style="width:100%">
                                        <thead>
                                            <tr class="table-primary">
                                                <th>@L.T("Code")</th>
                                                <th>@L.T("Menu_RawMaterials")</th>
                                                <th>@L.T("Unit")</th>
                                                <th class="text-right">@L.T("Doc_RepDemandTotal")</th>
                                                <th class="text-right">@L.T("Doc_RepSharePct")</th>
                                                <th class="text-right">@L.T("Doc_RepCumulativePct")</th>
                                                <th>ABC</th>
                                                <th class="text-right">CoV</th>
                                                <th>XYZ</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.Items)
                                            {
                                                var abcClass = item.ABCClass;
                                                var xyzClass = item.XYZClass;
                                                var rowClass = "";
                                                if (abcClass == "A") { rowClass = "table-success"; }
                                                else if (abcClass == "B") { rowClass = "table-warning"; }
                                                else { rowClass = "table-light"; }
                                                <tr class="@rowClass">
                                                    <td>@item.ProductCode</td>
                                                    <td>@item.ProductName</td>
                                                    <td>@item.UnitName</td>
                                                    <td class="text-right">@item.TotalDemand.ToString("N2")</td>
                                                    <td class="text-right">@item.SharePercent.ToString("N1")</td>
                                                    <td class="text-right">@item.CumSharePercent.ToString("N1")</td>
                                                    <td class="text-center font-weight-bold">@item.ABCClass</td>
                                                    <td class="text-right">@item.CoefficientOfVariation.ToString("N2")</td>
                                                    <td class="text-center font-weight-bold">@item.XYZClass</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-12 col-sm-12 mt-2">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title mb-0">@L.T("Doc_RepAbcXyzNote")</h4>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>@L.T("Doc_RepAbcHeader")</strong></p>
                            <ul class="mb-1">
                                <li><strong>@L.T("Doc_RepAClass")</strong> @L.T("Doc_RepAText")</li>
                                <li><strong>@L.T("Doc_RepBClass")</strong> @L.T("Doc_RepBText")</li>
                                <li><strong>@L.T("Doc_RepCClass")</strong> @L.T("Doc_RepCText")</li>
                            </ul>
                            <p class="mb-1"><strong>@L.T("Doc_RepXyzHeader")</strong></p>
                            <ul class="mb-0">
                                <li><strong>@L.T("Doc_RepXClass")</strong> @L.T("Doc_RepXText")</li>
                                <li><strong>@L.T("Doc_RepYClass")</strong> @L.T("Doc_RepYText")</li>
                                <li><strong>@L.T("Doc_RepZClass")</strong> @L.T("Doc_RepZText")</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
}</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#abcTable').DataTable({
                language: erpDataTable.language,
                pageLength: 50,
                scrollX: true,
                dom: 'lBfrtip',
                buttons: erpDataTable.buttons({ landscape: true, pdfOptions: { title: '@L.Js("Doc_RepAbcXyz")', pageSize: 'A3' } })
            });
        });
    </script>
}

