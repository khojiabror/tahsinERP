@{
    ViewBag.Title = L.T("Srm_OrderTracking");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Srm_OrderTracking")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    <!-- Filters -->
                    @using (Html.BeginForm("Index", "PurchaseOrderTracking", FormMethod.Get, new { id = "trackingFilter" }))
                    {
                        <div class="row mb-2">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="purchaseTypeFilter">@L.T("Srm_PurchaseType")</label>
                                    @Html.DropDownList("purchaseTypeFilter", ViewBag.PurchaseTypeList as SelectList, new { @class = "form-control select2" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="statusFilter">@L.T("Status")</label>
                                    @Html.DropDownList("statusFilter", ViewBag.StatusList as SelectList, new { @class = "form-control select2" })
                                </div>
                            </div>
                        </div>
                    }

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="trackingTable" class="table dt-responsive nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>@L.T("Srm_OrderNo")</th>
                                                    <th>@L.T("Srm_Supplier")</th>
                                                    <th>@L.T("Date")</th>
                                                    <th>@L.T("Type")</th>
                                                    <th>@L.T("Srm_Order")</th>
                                                    <th>@L.T("Srm_Contract")</th>
                                                    <th>@L.T("Srm_Invoice")</th>
                                                    <th>@L.T("Menu_Warehouse")</th>
                                                    <th>@L.T("Status")</th>
                                                    <th>@L.T("Actions")</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

@section Scripts {
    <script src="~/Scripts/srm/srm-server-table.js"></script>
    <script>
        $(document).ready(function () {
            var detailsUrl = '@Url.Action("Details", "PurchaseOrderTracking")/';
            var statusText = { Created: '@L.Js("Srm_TrackStatus_Created")', ContractCreated: '@L.Js("Srm_TrackStatus_ContractCreated")', Invoiced: '@L.Js("Srm_TrackStatus_Invoiced")', Received: '@L.Js("Srm_TrackStatus_Received")' };
            var statusClasses = { Created: 'badge-info', ContractCreated: 'badge-warning', Invoiced: 'badge-primary', Received: 'badge-success' };
            function stage(title, missingTitle) {
                return title
                    ? '<i class="bx bx-check-circle text-success" style="font-size: 24px;" title="' + srmEsc(title) + '"></i>'
                    : '<i class="bx bx-x-circle text-danger" style="font-size: 24px;" title="' + srmEsc(missingTitle) + '"></i>';
            }
            var columns = [
                { data: 'orderNo', render: function (v, t, r) { return '<a href="' + detailsUrl + r.id + '">' + srmEsc(v) + '</a>'; } },
                { data: 'supplier', render: function (v) { return v ? srmEsc(v) : '<span class="text-muted">-</span>'; } },
                { data: 'date' },
                { data: 'indirect', render: function (v) { return v ? '<span class="badge badge-info">Indirect</span>' : '<span class="badge badge-primary">Direct</span>'; } },
                { data: 'date', orderable: false, className: 'text-center', render: function (v) { return stage('@L.Js("Srm_CreatedOn")'.replace('{0}', v), ''); } },
                { data: 'contract', orderable: false, className: 'text-center', render: function (v) { return stage(v, '@L.Js("Srm_ContractNotCreated")'); } },
                { data: 'invoice', orderable: false, className: 'text-center', render: function (v) { return stage(v, '@L.Js("Srm_InvoiceNotCreated")'); } },
                { data: 'receipt', orderable: false, className: 'text-center', render: function (v) { return stage(v, '@L.Js("Srm_NotReceived")'); } },
                { data: 'status', render: function (v) { return '<span class="badge ' + (statusClasses[v] || 'badge-secondary') + '">' + srmEsc(statusText[v] || v) + '</span>'; } },
                {
                    data: null, orderable: false, render: function (v, t, r) {
                        return '<a href="' + detailsUrl + r.id + '" class="btn btn-sm btn-icon btn-outline-primary" title="@L.Js("Details")"><i class="bx bx-show"></i></a>';
                    }
                }
            ];
            var table = srmServerTable('#trackingTable', {
                dataUrl: '@Url.Action("IndexData", "PurchaseOrderTracking")',
                filterForm: '#trackingFilter',
                order: [[2, 'desc']],
                columns: columns
            });
            $('#trackingFilter select').on('change', function () { table.ajax.reload(); });
        });
    </script>
}
