@model tahsinERP.Models.SUPPLIER
@{
    ViewBag.Title = "Ta'minotchi tafsilotlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "Supplier", "Details"))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Supplier") ||
                        tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Suppliers") ||
                        tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Supplier", "Edit");

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Supplier">Ta'minotchilar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @Model.Name ma'lumotlari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Ta'minotchi ma'lumotlari</h4>
                                <div class="heading-elements">
                                    @if (changePermit)
                                    {
                                        <a href="@Url.Action("Edit", "Supplier", new { id = Model.ID })" class="btn btn-sm btn-warning">
                                            <i class="bx bx-edit-alt"></i> Tahrirlash
                                        </a>
                                    }
                                    <a href="@Url.Action("Index", "Supplier")" class="btn btn-sm btn-secondary">
                                        <i class="bx bx-arrow-back"></i> Orqaga
                                    </a>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h5 class="text-primary">Asosiy ma'lumotlar</h5>
                                            <table class="table table-borderless">
                                                <tr>
                                                    <th width="40%">Nomi:</th>
                                                    <td><strong>@Model.Name</strong></td>
                                                </tr>
                                                <tr>
                                                    <th>DUNS:</th>
                                                    <td>@(Model.DUNS ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>Turi:</th>
                                                    <td>@(Model.Type ?? "-")</td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col-md-6">
                                            <h5 class="text-primary">Geografik ma'lumotlar</h5>
                                            <table class="table table-borderless">
                                                <tr>
                                                    <th width="40%">Mamlakat:</th>
                                                    <td>@(Model.Country ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>Shahar:</th>
                                                    <td>@(Model.City ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>Manzil:</th>
                                                    <td>@(Model.Address ?? "-")</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <hr />

                                    <div class="row">
                                        <div class="col-md-6">
                                            <h5 class="text-primary">Murojaat ma'lumotlari</h5>
                                            <table class="table table-borderless">
                                                <tr>
                                                    <th width="40%">Direktor:</th>
                                                    <td>@(Model.DirectorName ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>Aloqa shaxsi:</th>
                                                    <td>@(Model.ContactPersonName ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>Telefon:</th>
                                                    <td>@(Model.Telephone ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>Email:</th>
                                                    <td>@(Model.Email ?? "-")</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <hr />

                                    <!-- Related Documents Section -->
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <h5 class="text-primary mb-3">Bog'liq hujjatlar</h5>
                                            <div class="btn-group" role="group">
                                                <a href="@Url.Action("Index", "PContracts", new { supplierID = Model.ID })" class="btn btn-outline-primary">
                                                    <i class="bx bx-file"></i> Shartnomalar (@ViewBag.ContractsCount)
                                                </a>
                                                <a href="@Url.Action("Index", "POrders", new { supplierID = Model.ID })" class="btn btn-outline-primary">
                                                    <i class="bx bx-list-ul"></i> Buyurtmalar (@ViewBag.OrdersCount)
                                                </a>
                                                <a href="@Url.Action("Index", "PInvoices", new { supplierID = Model.ID })" class="btn btn-outline-primary">
                                                    <i class="bx bx-receipt"></i> Invoyslar (@ViewBag.InvoicesCount)
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
