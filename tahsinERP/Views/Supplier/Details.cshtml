@model tahsinERP.Models.SUPPLIER
@{
    ViewBag.Title = L.T("Srm_SupplierDetailsTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Supplier") ||
                        tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Suppliers") ||
                        tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Supplier", "Edit");
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/Supplier">@L.T("Menu_Suppliers")</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Srm_NamedInfo", Model.Name)
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">@L.T("Srm_SupplierInfo")</h4>
                            <div class="heading-elements">
                                @if (changePermit)
                                {
                                    <a href="@Url.Action("Edit", "Supplier", new { id = Model.ID })" class="btn btn-sm btn-warning">
                                        <i class="bx bx-edit-alt"></i> @L.T("Edit")
                                    </a>
                                }
                                <a href="@Url.Action("Index", "Supplier")" class="btn btn-sm btn-secondary">
                                    <i class="bx bx-arrow-back"></i> @L.T("Back")
                                </a>
                            </div>
                        </div>
                        <div class="card-content">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h5 class="text-primary">@L.T("Srm_MainInfo")</h5>
                                        <table class="table table-borderless">
                                            <tr>
                                                <th width="40%">@L.T("Name"):</th>
                                                <td><strong>@Model.Name</strong></td>
                                            </tr>
                                            <tr>
                                                <th>DUNS:</th>
                                                <td>@(Model.DUNS ?? "-")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Type"):</th>
                                                <td>@(Model.Type ?? "-")</td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-md-6">
                                        <h5 class="text-primary">@L.T("Srm_GeoData")</h5>
                                        <table class="table table-borderless">
                                            <tr>
                                                <th width="40%">@L.T("Srm_Country"):</th>
                                                <td>@(Model.Country ?? "-")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Srm_City"):</th>
                                                <td>@(Model.City ?? "-")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Address"):</th>
                                                <td>@(Model.Address ?? "-")</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <hr />

                                <div class="row">
                                    <div class="col-md-6">
                                        <h5 class="text-primary">@L.T("Srm_ContactInfo")</h5>
                                        <table class="table table-borderless">
                                            <tr>
                                                <th width="40%">@L.T("Srm_Director"):</th>
                                                <td>@(Model.DirectorName ?? "-")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Srm_ContactPerson"):</th>
                                                <td>@(Model.ContactPersonName ?? "-")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Phone"):</th>
                                                <td>@(Model.Telephone ?? "-")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Email"):</th>
                                                <td>@(Model.Email ?? "-")</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <hr />

                                <!-- Related Documents Section -->
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <h5 class="text-primary mb-3">@L.T("Srm_RelatedDocs")</h5>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Index", "PContracts", new { supplierID = Model.ID })" class="btn btn-outline-primary">
                                                <i class="bx bx-file"></i> @L.T("Menu_Contracts") (@ViewBag.ContractsCount)
                                            </a>
                                            <a href="@Url.Action("Index", "POrders", new { supplierID = Model.ID })" class="btn btn-outline-primary">
                                                <i class="bx bx-list-ul"></i> @L.T("Menu_Orders") (@ViewBag.OrdersCount)
                                            </a>
                                            <a href="@Url.Action("Index", "PInvoices", new { supplierID = Model.ID })" class="btn btn-outline-primary">
                                                <i class="bx bx-receipt"></i> @L.T("Menu_Invoices") (@ViewBag.InvoicesCount)
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
