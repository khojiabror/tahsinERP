@model tahsinERP.Models.SUPPLIER
@{
    ViewBag.Title = L.T("Create");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("Create", "Supplier", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Supplier/Index">@L.T("Menu_Suppliers")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Srm_AddSupplier")
                                    </li>
                                </ol>
                                <div class="invoice-create-btn mb-1">

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <!-- app invoice View Page -->
                <section class="basic-select2">
                    <div class="row">
                        <!-- invoice view page -->
                        <div class="col-xl-9 col-md-8 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row">
                                            <div class="col-lg-12 col-md-6 mt-25">
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                <hr>
                                                <h6 class="invoice-to">@L.T("Name")</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control round", @placeholder = L.T("Name") , @required="required"  })
                                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">DUNS</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.DUNS, new { @class = "form-control round", @placeholder = "DUNS", @type = "number" })
                                                    @Html.ValidationMessageFor(model => model.DUNS, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">@L.T("Type")</h6>
                                                <fieldset class="form-group">
                                                    @Html.TextBoxFor(model => model.Type, new { @class = "form-control round", @placeholder = L.T("Type"), @required = "required"})
                                                    @Html.ValidationMessageFor(model => model.Type, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">@L.T("Srm_Country")</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.Country, new { @class = "form-control round", @placeholder = L.T("Srm_Country") })
                                                    @Html.ValidationMessageFor(model => model.Country, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">@L.T("Srm_City")</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.City, new { @class = "form-control round", @placeholder = L.T("Srm_City") })
                                                    @Html.ValidationMessageFor(model => model.City, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">@L.T("Address")</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.Address, new { @class = "form-control round", @placeholder = L.T("Address") })
                                                    @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">@L.T("Srm_PhoneNumber")</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.Telephone, new { @class = "form-control round", @placeholder = L.T("Srm_PhoneNumber") })
                                                    @Html.ValidationMessageFor(model => model.Telephone, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">@L.T("Srm_EmailLabel")</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.Email, new { @class = "form-control round", @placeholder = L.T("Srm_EmailAddress")})
                                                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">@L.T("Srm_ContactEmployee")</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.ContactPersonName, new { @class = "form-control round", @placeholder = L.T("Srm_ContactEmployee") })
                                                    @Html.ValidationMessageFor(model => model.ContactPersonName, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <h6 class="invoice-to">@L.T("Srm_DirectorName")</h6>
                                                <fieldset class="invoice-address form-group">
                                                    @Html.TextBoxFor(model => model.DirectorName, new { @class = "form-control round", @placeholder = L.T("Srm_DirectorName") })
                                                    @Html.ValidationMessageFor(model => model.DirectorName, "", new { @class = "text-danger" })
                                                </fieldset>
                                                <ul class="list-group list-group-flush">
                                                    <li class="list-group-item border-0 pb-0">
                                                        <button class="btn btn-primary btn-block subtotal-preview-btn" name="create" type="submit" value="Create">
                                                            <i class='bx bx-save'></i>
                                                            @L.T("Save")
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                        <hr>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}