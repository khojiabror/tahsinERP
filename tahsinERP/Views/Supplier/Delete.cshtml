@model tahsinERP.Models.SUPPLIER
@{
    ViewBag.Title = L.T("Delete");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("Delete", "Supplier", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item ">
                                        <a href="~/Supplier">@L.T("Menu_Suppliers")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Srm_DeleteNamed", Model.Name)
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <!-- app invoice View Page -->
                <section class="invoice-edit-wrapper">
                    <div class="row">
                        <!-- invoice view page -->
                        <div class="col-xl-9 col-md-8 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body pb-0 mx-25">
                                        <div class="row invoice-info">
                                            <div class="col-lg-12 col-md-6 mt-25">
                                                <h4 class="text-primary">@L.T("Srm_CompanyInfo")</h4>
                                                <hr />
                                                <span><b>@L.T("Name")</b>: @Html.DisplayFor(model => model.Name, new { @class = "form-control" })</span>
                                                <br />
                                                <span><b>DUNS</b>: @Html.DisplayFor(model => model.DUNS, new { @class = "form-control" })</span>
                                                <hr />
                                                <section>
                                                    <div>
                                                        <h6 class="text-primary">@L.T("Srm_GeoInfo")</h6>
                                                        <span><b>@L.T("Srm_Source")</b>: @Html.DisplayFor(model => model.Type, new { @class = "form-control" })</span>
                                                        <br />
                                                        <span><b>@L.T("Srm_CountryOf")</b>: @Html.DisplayFor(model => model.Country, new { @class = "form-control" })</span>
                                                        <br />
                                                        <span><b>@L.T("Srm_CityOf")</b>: @Html.DisplayFor(model => model.City, new { @class = "form-control" })</span>
                                                        <br />
                                                        <span><b>@L.T("Srm_AddressOf")</b>: @Html.DisplayFor(model => model.Address, new { @class = "form-control" })</span>
                                                        <br />
                                                        <hr />
                                                    </div>
                                                </section>
                                                <h6 class="text-primary">@L.T("Srm_ForContact")</h6>
                                                <span><b>@L.T("Srm_Head")</b>: @Html.DisplayFor(model => model.DirectorName, new { @class = "form-control" })</span>
                                                <br />
                                                <span><b>@L.T("Srm_ResponsibleEmployee")</b>: @Html.DisplayFor(model => model.ContactPersonName, new { @class = "form-control" })</span>
                                                <br />
                                                <span><b>@L.T("Srm_EmailLabel")</b>: @Html.DisplayFor(model => model.Email, new { @class = "form-control" })</span>
                                                <br />
                                                <span><b>@L.T("Srm_PhoneNumber"):</b>: @Html.DisplayFor(model => model.Telephone, new { @class = "form-control" })</span>
                                                <br />
                                            </div>
                                            <ul class="list-group list-group-flush">
                                                <li class="list-group-item border-0 pb-0">
                                                    <button class="btn btn-danger bg-light btn-block subtotal-preview-btn" name="delete" type="submit" value="Delete" onclick="return confirm('@L.Js("Srm_ConfirmDeleteInvoice")')">
                                                        <i class='bx bx-trash'></i>
                                                        @L.T("Delete")
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                        <hr>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}