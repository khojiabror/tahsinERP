@model tahsinERP.Models.HR_EMPLOYEE_HISTORY
@{
    ViewBag.Title = L.T("Hr_HistEdit");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_HistTitle")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Edit")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(model => model.ID)

                                <div class="form-group">
                                    @Html.LabelFor(model => model.EmployeeID, L.T("Hr_Employee"), new { @class = "control-label" })
                                    <span class="text-danger">*</span>
                                    @Html.DropDownListFor(model => model.EmployeeID, ViewBag.EmployeeID as SelectList, L.T("Hr_SelectEmployee"), new { @class = "form-control select2", required = "required" })
                                    @Html.ValidationMessageFor(model => model.EmployeeID, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.ActionType, L.T("Hr_HistActionHistory"), new { @class = "control-label" })
                                    <span class="text-danger">*</span>
                                    @{
                                        var actionTypeList = new SelectList(
                                            new[] { 
                                                new { Value = "History", Text = L.T("Hr_HistActionHistory") },
                                                new { Value = "Transfer", Text = L.T("Hr_EmpTransfer") }, 
                                                new { Value = "Dismissal", Text = L.T("Hr_HistActionDismissal") } 
                                            }, 
                                            "Value", 
                                            "Text", 
                                            Model?.ActionType ?? "History");
                                    }
                                    @Html.DropDownListFor(model => model.ActionType, actionTypeList, L.T("Select"), new { @class = "form-control", id = "ActionType", required = "required" })
                                    @Html.ValidationMessageFor(model => model.ActionType, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.FromOrgUnitID, L.T("Hr_OrgUnit"), new { @class = "control-label" })
                                    @Html.DropDownListFor(model => model.FromOrgUnitID, ViewBag.FromOrgUnitID as SelectList, L.T("Hr_SelectOrgUnit"), new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(model => model.FromOrgUnitID, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.FromPositionID, L.T("Hr_Position"), new { @class = "control-label" })
                                    @Html.DropDownListFor(model => model.FromPositionID, ViewBag.FromPositionID as SelectList, L.T("Hr_SelectPosition"), new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(model => model.FromPositionID, "", new { @class = "text-danger" })
                                </div>

                                <div id="toOrgUnitGroup" class="form-group" style="@(Model.ActionType == "Transfer" ? "display:block;" : "display:none;")">
                                    @Html.LabelFor(model => model.ToOrgUnitID, L.T("Hr_NewOrgUnit"), new { @class = "control-label" })
                                    @Html.DropDownListFor(model => model.ToOrgUnitID, ViewBag.ToOrgUnitID as SelectList, L.T("Hr_SelectNewOrgUnit"), new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(model => model.ToOrgUnitID, "", new { @class = "text-danger" })
                                </div>

                                <div id="toPositionGroup" class="form-group" style="@(Model.ActionType == "Transfer" ? "display:block;" : "display:none;")">
                                    @Html.LabelFor(model => model.ToPositionID, L.T("Hr_NewPosition"), new { @class = "control-label" })
                                    @Html.DropDownListFor(model => model.ToPositionID, ViewBag.ToPositionID as SelectList, L.T("Hr_SelectNewPosition"), new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(model => model.ToPositionID, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    <label class="control-label">@L.T("Hr_StartDate")</label>
                                    <span class="text-danger">*</span>
                                    <input type="date" name="EffectiveDateFrom" class="form-control" value="@(ViewBag.EffectiveDateFrom ?? Model.EffectiveDateFrom.ToString("yyyy-MM-dd"))" required />
                                    @Html.ValidationMessageFor(model => model.EffectiveDateFrom, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    <label class="control-label">@L.T("Hr_EndDate")</label>
                                    <span class="text-danger">*</span>
                                    <input type="date" name="EffectiveDateTo" id="EffectiveDateTo" class="form-control" value="@(ViewBag.EffectiveDateTo ?? (Model.EffectiveDateTo?.ToString("yyyy-MM-dd")))" required />
                                    <small class="text-muted">@L.T("Hr_HistPeriodHint")</small>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.Reason, L.T("Hr_Reason"), new { @class = "control-label" })
                                    @Html.TextAreaFor(model => model.Reason, new { @class = "form-control", rows = "3" })
                                    @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-save"></i> @L.T("Save")
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("Cancel")</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

@section Scripts
{
    <script>
        $(document).ready(function() {
            // Initialize Select2 with proper selected values
            $('.select2').each(function() {
                var $select = $(this);
                $select.select2({ 
                    width: '100%',
                    allowClear: false
                });
                
                // Ensure selected value is set
                var selectedValue = $select.val();
                if (selectedValue) {
                    $select.val(selectedValue).trigger('change');
                }
            });

            // Show/hide "To" fields based on ActionType
            var actionType = $('#ActionType').val();
            if (actionType === 'Transfer') {
                $('#toOrgUnitGroup').show();
                $('#toPositionGroup').show();
            } else {
                $('#toOrgUnitGroup').hide();
                $('#toPositionGroup').hide();
            }

            $('#ActionType').on('change', function() {
                var actionType = $(this).val();
                if (actionType === 'Transfer') {
                    $('#toOrgUnitGroup').show();
                    $('#toPositionGroup').show();
                } else {
                    $('#toOrgUnitGroup').hide();
                    $('#toPositionGroup').hide();
                }
            });
        });
    </script>
}

