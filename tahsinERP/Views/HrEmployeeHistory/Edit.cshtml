@model tahsinERP.Models.HR_EMPLOYEE_HISTORY
@{
    ViewBag.Title = "Xodimlar staji tahrirlash";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "HrEmployees"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Xodimlar staji</a></li>
                                    <li class="breadcrumb-item active">Tahrirlash</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(model => model.ID)

                                <div class="form-group">
                                    @Html.LabelFor(model => model.EmployeeID, "Xodim", new { @class = "control-label" })
                                    <span class="text-danger">*</span>
                                    @Html.DropDownListFor(model => model.EmployeeID, ViewBag.EmployeeID as SelectList, "Xodimni tanlang", new { @class = "form-control select2", required = "required" })
                                    @Html.ValidationMessageFor(model => model.EmployeeID, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.ActionType, "Ishlaganini qayd etish", new { @class = "control-label" })
                                    <span class="text-danger">*</span>
                                    @{
                                        var actionTypeList = new SelectList(
                                            new[] { 
                                                new { Value = "History", Text = "Ishlaganini qayd etish" },
                                                new { Value = "Transfer", Text = "Boshqa lavozimga o'tkazish" }, 
                                                new { Value = "Dismissal", Text = "Ishdan bo'shatish" } 
                                            }, 
                                            "Value", 
                                            "Text", 
                                            Model?.ActionType ?? "History");
                                    }
                                    @Html.DropDownListFor(model => model.ActionType, actionTypeList, "Tanlang", new { @class = "form-control", id = "ActionType", required = "required" })
                                    @Html.ValidationMessageFor(model => model.ActionType, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.FromOrgUnitID, "Bo'lim", new { @class = "control-label" })
                                    @Html.DropDownListFor(model => model.FromOrgUnitID, ViewBag.FromOrgUnitID as SelectList, "Bo'limni tanlang", new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(model => model.FromOrgUnitID, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.FromPositionID, "Lavozim", new { @class = "control-label" })
                                    @Html.DropDownListFor(model => model.FromPositionID, ViewBag.FromPositionID as SelectList, "Lavozimni tanlang", new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(model => model.FromPositionID, "", new { @class = "text-danger" })
                                </div>

                                <div id="toOrgUnitGroup" class="form-group" style="@(Model.ActionType == "Transfer" ? "display:block;" : "display:none;")">
                                    @Html.LabelFor(model => model.ToOrgUnitID, "Yangi bo'lim", new { @class = "control-label" })
                                    @Html.DropDownListFor(model => model.ToOrgUnitID, ViewBag.ToOrgUnitID as SelectList, "Yangi bo'limni tanlang", new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(model => model.ToOrgUnitID, "", new { @class = "text-danger" })
                                </div>

                                <div id="toPositionGroup" class="form-group" style="@(Model.ActionType == "Transfer" ? "display:block;" : "display:none;")">
                                    @Html.LabelFor(model => model.ToPositionID, "Yangi lavozim", new { @class = "control-label" })
                                    @Html.DropDownListFor(model => model.ToPositionID, ViewBag.ToPositionID as SelectList, "Yangi lavozimni tanlang", new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(model => model.ToPositionID, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    <label class="control-label">Boshlanish sanasi</label>
                                    <span class="text-danger">*</span>
                                    <input type="date" name="EffectiveDateFrom" class="form-control" value="@(ViewBag.EffectiveDateFrom ?? Model.EffectiveDateFrom.ToString("yyyy-MM-dd"))" required />
                                    @Html.ValidationMessageFor(model => model.EffectiveDateFrom, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    <label class="control-label">Tugash sanasi</label>
                                    <span class="text-danger">*</span>
                                    <input type="date" name="EffectiveDateTo" id="EffectiveDateTo" class="form-control" value="@(ViewBag.EffectiveDateTo ?? (Model.EffectiveDateTo?.ToString("yyyy-MM-dd")))" required />
                                    <small class="text-muted">Bu xodimning shu lavozimda ishlagan muddati</small>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.Reason, "Sabab", new { @class = "control-label" })
                                    @Html.TextAreaFor(model => model.Reason, new { @class = "form-control", rows = "3" })
                                    @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-save"></i> Saqlash
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">Bekor qilish</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

@section Scripts
{
    <script>
        $(document).ready(function() {
            // Initialize Select2 with proper selected values
            $('.select2').each(function() {
                var $select = $(this);
                $select.select2({ 
                    width: '100%',
                    allowClear: false
                });
                
                // Ensure selected value is set
                var selectedValue = $select.val();
                if (selectedValue) {
                    $select.val(selectedValue).trigger('change');
                }
            });

            // Show/hide "To" fields based on ActionType
            var actionType = $('#ActionType').val();
            if (actionType === 'Transfer') {
                $('#toOrgUnitGroup').show();
                $('#toPositionGroup').show();
            } else {
                $('#toOrgUnitGroup').hide();
                $('#toPositionGroup').hide();
            }

            $('#ActionType').on('change', function() {
                var actionType = $(this).val();
                if (actionType === 'Transfer') {
                    $('#toOrgUnitGroup').show();
                    $('#toPositionGroup').show();
                } else {
                    $('#toOrgUnitGroup').hide();
                    $('#toPositionGroup').hide();
                }
            });
        });
    </script>
}

