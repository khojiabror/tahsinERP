@model tahsinERP.Models.HR_EMPLOYEE_HISTORY
@{
    ViewBag.Title = "Xodim tarixini qo'shish";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Xodimlar staji</a></li>
                                    <li class="breadcrumb-item active">Qo'shish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @using (Html.BeginForm("Create", "HrEmployeeHistory", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.EmployeeID, "Xodim", new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.EmployeeID, ViewBag.EmployeeID as SelectList, "Xodimni tanlang", new { @class = "form-control select2", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.EmployeeID, "", new { @class = "text-danger" })
                                            <small class="text-muted">Faqat ishdan bo'shatilgan yoki nofaol xodimlarni tanlash mumkin</small>
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.FromOrgUnitID, "Bo'lim", new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.FromOrgUnitID, ViewBag.FromOrgUnitID as SelectList, "Bo'limni tanlang", new { @class = "form-control select2", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.FromOrgUnitID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.FromPositionID, "Lavozim", new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.FromPositionID, ViewBag.FromPositionID as SelectList, "Lavozimni tanlang", new { @class = "form-control select2", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.FromPositionID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="control-label">Boshlanish sanasi</label>
                                            <span class="text-danger">*</span>
                                            @Html.TextBoxFor(model => model.EffectiveDateFrom, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @required = "required", @name = "EffectiveDateFrom" })
                                            @Html.ValidationMessageFor(model => model.EffectiveDateFrom, "", new { @class = "text-danger" })
                                            <small class="text-muted">Xodimning shu lavozimda ishlashni boshlagan sanasi</small>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label">Tugash sanasi</label>
                                            <span class="text-danger">*</span>
                                            <input type="date" name="EffectiveDateTo" id="EffectiveDateTo" class="form-control" required />
                                            <small class="text-muted">Xodimning shu lavozimda ishlashni tugatgan sanasi</small>
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Reason, "Sabab", new { @class = "control-label" })
                                            @Html.TextAreaFor(model => model.Reason, new { @class = "form-control", @rows = "3", @placeholder = "Sababni kiriting (ixtiyoriy)" })
                                            @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-save"></i> Saqlash
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">Bekor qilish</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

@section Scripts
{
    <script>
        $(document).ready(function() {
            $('.select2').select2({ width: '100%' });
        });
    </script>
}
