@model tahsinERP.Models.HR_EMPLOYEE_HISTORY
@{
    ViewBag.Title = L.T("Hr_HistAdd");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat controller'da tekshiriladi (HRM-M04: view ichidagi Response.Redirect olib tashlandi) *@
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L.T("Hr_HistTitle")</a></li>
                                    <li class="breadcrumb-item active">@L.T("Add")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @using (Html.BeginForm("Create", "HrEmployeeHistory", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.EmployeeID, L.T("Hr_Employee"), new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.EmployeeID, ViewBag.EmployeeID as SelectList, L.T("Hr_SelectEmployee"), new { @class = "form-control select2", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.EmployeeID, "", new { @class = "text-danger" })
                                            <small class="text-muted">@L.T("Hr_HistOnlyInactiveHint")</small>
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.FromOrgUnitID, L.T("Hr_OrgUnit"), new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.FromOrgUnitID, ViewBag.FromOrgUnitID as SelectList, L.T("Hr_SelectOrgUnit"), new { @class = "form-control select2", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.FromOrgUnitID, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.FromPositionID, L.T("Hr_Position"), new { @class = "control-label" })
                                            <span class="text-danger">*</span>
                                            @Html.DropDownListFor(model => model.FromPositionID, ViewBag.FromPositionID as SelectList, L.T("Hr_SelectPosition"), new { @class = "form-control select2", @required = "required" })
                                            @Html.ValidationMessageFor(model => model.FromPositionID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="control-label">@L.T("Hr_StartDate")</label>
                                            <span class="text-danger">*</span>
                                            @Html.TextBoxFor(model => model.EffectiveDateFrom, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @required = "required", @name = "EffectiveDateFrom" })
                                            @Html.ValidationMessageFor(model => model.EffectiveDateFrom, "", new { @class = "text-danger" })
                                            <small class="text-muted">@L.T("Hr_HistStartHint")</small>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label">@L.T("Hr_EndDate")</label>
                                            <span class="text-danger">*</span>
                                            <input type="date" name="EffectiveDateTo" id="EffectiveDateTo" class="form-control" required />
                                            <small class="text-muted">@L.T("Hr_HistEndHint")</small>
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Reason, L.T("Hr_Reason"), new { @class = "control-label" })
                                            @Html.TextAreaFor(model => model.Reason, new { @class = "form-control", @rows = "3", @placeholder = L.T("Hr_ReasonPh") })
                                            @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-save"></i> @L.T("Save")
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">@L.T("Cancel")</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

@section Scripts
{
    <script>
        $(document).ready(function() {
            $('.select2').select2({ width: '100%' });
        });
    </script>
}
