                    </div>
                </div>
            </section>
            <!-- Dashboard Analytics end -->

            @if (ViewBag.ShowCookieConsent)
            {
                <script>
                    (function() {
                        function showCookieConsent() {
                            if (typeof jQuery !== 'undefined') {
                                jQuery(document).ready(function () {
                                    jQuery("#cookieConsent").modal('show');
                                });
                            } else {
                                setTimeout(showCookieConsent, 100);
                            }
                        }
                        if (document.readyState === 'loading') {
                            document.addEventListener('DOMContentLoaded', showCookieConsent);
                        } else {
                            showCookieConsent();
                        }
                    })();
                </script>
            }
        </div>
    </div>
</div>
<!-- END: Content-->

<!-- BEGIN: Page Vendor JS-->
<script src="~/app-assets/vendors/js/charts/apexcharts.min.js"></script>
<!-- END: Page Vendor JS-->
<!-- BEGIN: Page JS-->
<!-- dashboard-ecommerce.js o'chirildi - o'z chart kodlarimiz ishlatilmoqda va bu fayl jQuery xatosiga sabab bo'lmoqda -->
<!-- <script src="~/app-assets/js/scripts/pages/dashboard-ecommerce.js"></script> -->
<!-- END: Page JS-->

<script>
    // jQuery yuklanguncha kutish
    (function() {
        function initCharts() {
            if (typeof jQuery === 'undefined' || typeof ApexCharts === 'undefined') {
                setTimeout(initCharts, 100);
                return;
            }
            
            var $ = jQuery;
            
            // AJAX so'rovlar uchun umumiy sozlamalar
            $.ajaxSetup({
                timeout: 30000, // 30 soniya timeout
                error: function(xhr, status, error) {
                    console.error('AJAX xatosi:', status, error);
                }
            });
            
            $(window).on("load", function () {
                // Loading overlay'ni majburiy ravishda yashirish (agar xato bo'lsa ham)
                setTimeout(function() {
                    $('html').removeClass('loading').addClass('loaded');
                    $('.content-overlay').hide();
                }, 1500);
                
                // iPack korxonasi yashil ranglari
                var $primary = '#198754'; // To'q yashil
                var $primary_light = '#20c997'; // Yengil yashil
                var $danger = '#FF5B5C';
                var $warning = '#FDAC41';
                var $info = '#00CFDD';
                var $success = '#39DA8A';
                var $secondary = '#828D99';
                var $gray_light = '#828D99';

        // Finance Plan vs Fact Chart
        $.ajax({
            url: '/Home/GetFinancePlanVsFact',
            method: 'GET',
            timeout: 30000,
            success: function (data) {
            if (data && data.length > 0) {
                var periods = data.map(x => x.period);
                var planData = data.map(x => x.plan);
                var factData = data.map(x => x.fact);

                var financePlanVsFactOptions = {
                    chart: {
                        height: 350,
                        type: 'line',
                        zoom: { enabled: false },
                        toolbar: { show: false },
                        sparkline: { enabled: false }
                    },
                    colors: [$primary, $primary_light],
                    dataLabels: { enabled: false },
                    stroke: { 
                        curve: 'smooth', 
                        width: 3,
                        lineCap: 'round'
                    },
                    series: [
                        { name: 'Reja', data: planData },
                        { name: 'Haqiqat', data: factData }
                    ],
                    title: { 
                        text: 'Moliya - Reja vs Haqiqat', 
                        align: 'left',
                        style: { fontSize: '16px', fontWeight: 600 }
                    },
                    grid: { 
                        row: { colors: ['#f3f3f3', 'transparent'], opacity: 0.5 },
                        borderColor: '#e7e7e7',
                        strokeDashArray: 3
                    },
                    xaxis: { 
                        categories: periods,
                        axisBorder: { show: false },
                        axisTicks: { show: false },
                        labels: { style: { colors: '#828D99' } }
                    },
                    yaxis: { 
                        title: { text: 'Summa', style: { color: '#828D99' } },
                        labels: { style: { colors: '#828D99' } }
                    },
                    legend: { 
                        position: 'top', 
                        horizontalAlign: 'right',
                        markers: { radius: 50, height: 8, width: 8 }
                    },
                    tooltip: {
                        theme: 'light',
                        y: {
                            formatter: function(val) {
                                return val.toLocaleString() + " so'm";
                            }
                        }
                    }
                };

                var financePlanVsFactChart = new ApexCharts(
                    document.querySelector("#finance-plan-vs-fact-chart"),
                    financePlanVsFactOptions
                );
                financePlanVsFactChart.render();
            }
            },
            error: function(xhr, status, error) {
                console.error('Finance Plan vs Fact xatosi:', error);
                $('#finance-plan-vs-fact-chart').html('<p class="text-center text-muted">Ma\'lumot yuklanmadi</p>');
            }
        });

        // Finance Cash Summary Chart
        $.ajax({
            url: '/Home/GetFinanceCashSummary',
            method: 'GET',
            timeout: 30000,
            success: function (data) {
            if (data && data.length > 0) {
                var accountNames = data.map(x => x.accountName);
                var closingBalances = data.map(x => x.closingBalance);

                var financeCashSummaryOptions = {
                    chart: {
                        height: 350,
                        type: 'bar',
                        toolbar: { show: false }
                    },
                    colors: [$info],
                    plotOptions: {
                        bar: {
                            horizontal: false,
                            columnWidth: '50%',
                            endingShape: 'rounded',
                            borderRadius: 4
                        }
                    },
                    dataLabels: { enabled: false },
                    stroke: { 
                        show: true, 
                        width: 2, 
                        colors: ['transparent'],
                        curve: 'smooth'
                    },
                    series: [{ name: 'Yopilish balansi', data: closingBalances }],
                    xaxis: { 
                        categories: accountNames,
                        axisBorder: { show: false },
                        axisTicks: { show: false },
                        labels: { 
                            style: { colors: '#828D99' },
                            rotate: -45,
                            rotateAlways: false
                        }
                    },
                    yaxis: { 
                        title: { text: 'Summa', style: { color: '#828D99' } },
                        labels: { style: { colors: '#828D99' } }
                    },
                    fill: { 
                        type: 'gradient',
                        gradient: {
                            shade: 'light',
                            type: 'vertical',
                            shadeIntensity: 0.3,
                            gradientToColors: [$info],
                            inverseColors: false,
                            opacityFrom: 1,
                            opacityTo: 0.8,
                            stops: [0, 50, 100]
                        }
                    },
                    grid: {
                        borderColor: '#e7e7e7',
                        strokeDashArray: 3
                    },
                    tooltip: {
                        theme: 'light',
                        y: {
                            formatter: function (val) {
                                return val.toLocaleString() + " so'm"
                            }
                        }
                    }
                };

                var financeCashSummaryChart = new ApexCharts(
                    document.querySelector("#finance-cash-summary-chart"),
                    financeCashSummaryOptions
                );
                financeCashSummaryChart.render();
            }
            },
            error: function(xhr, status, error) {
                console.error('Finance Cash Summary xatosi:', error);
                $('#finance-cash-summary-chart').html('<p class="text-center text-muted">Ma\'lumot yuklanmadi</p>');
            }
        });

        // CRM Sales Orders Chart
        $.ajax({
            url: '/Home/GetCRMSalesOrdersStats',
            method: 'GET',
            timeout: 30000,
            success: function (data) {
            if (data && data.length > 0) {
                var periods = data.map(x => x.period);
                var orderCounts = data.map(x => x.orderCount);
                var totalAmounts = data.map(x => x.totalAmount);

                var crmSalesOrdersOptions = {
                    chart: {
                        height: 350,
                        type: 'bar',
                        toolbar: { show: false }
                    },
                    colors: [$success, $primary],
                    plotOptions: {
                        bar: {
                            horizontal: false,
                            columnWidth: '50%',
                            endingShape: 'rounded',
                            borderRadius: 4
                        }
                    },
                    dataLabels: { enabled: false },
                    stroke: { 
                        show: true, 
                        width: 2, 
                        colors: ['transparent'],
                        curve: 'smooth'
                    },
                    series: [
                        { name: 'Buyurtmalar soni', data: orderCounts },
                        { name: 'Jami summa', data: totalAmounts }
                    ],
                    xaxis: { 
                        categories: periods,
                        axisBorder: { show: false },
                        axisTicks: { show: false },
                        labels: { style: { colors: '#828D99' } }
                    },
                    yaxis: { 
                        title: { text: 'Qiymat', style: { color: '#828D99' } },
                        labels: { style: { colors: '#828D99' } }
                    },
                    fill: { 
                        type: 'gradient',
                        gradient: {
                            shade: 'light',
                            type: 'vertical',
                            shadeIntensity: 0.3,
                            gradientToColors: [$success, $primary],
                            inverseColors: false,
                            opacityFrom: 1,
                            opacityTo: 0.8,
                            stops: [0, 50, 100]
                        }
                    },
                    grid: {
                        borderColor: '#e7e7e7',
                        strokeDashArray: 3
                    },
                    legend: { 
                        position: 'top', 
                        horizontalAlign: 'right',
                        markers: { radius: 50, height: 8, width: 8 }
                    },
                    tooltip: {
                        theme: 'light',
                        y: {
                            formatter: function(val) {
                                return val.toLocaleString();
                            }
                        }
                    }
                };

                var crmSalesOrdersChart = new ApexCharts(
                    document.querySelector("#crm-sales-orders-chart"),
                    crmSalesOrdersOptions
                );
                crmSalesOrdersChart.render();
            }
            },
            error: function(xhr, status, error) {
                console.error('CRM Sales Orders xatosi:', error);
                $('#crm-sales-orders-chart').html('<p class="text-center text-muted">Ma\'lumot yuklanmadi</p>');
            }
        });

        // CRM Customers Statistics
        $.ajax({
            url: '/Home/GetCRMCustomersStats',
            method: 'GET',
            timeout: 30000,
            success: function (data) {
            if (data) {
                var crmCustomersOptions = {
                    chart: {
                        height: 350,
                        type: 'radialBar',
                        toolbar: { show: false }
                    },
                    colors: [$success, $primary, $warning],
                    series: [data.totalCustomers, data.activeCustomers, data.totalOrders],
                    plotOptions: {
                        radialBar: {
                            offsetY: -10,
                            hollow: { 
                                size: '40%',
                                background: '#fff'
                            },
                            track: { 
                                margin: 10, 
                                background: '#e7edf3',
                                strokeWidth: '97%'
                            },
                            dataLabels: {
                                name: { 
                                    fontSize: '15px', 
                                    offsetY: 25,
                                    color: '#828D99',
                                    fontWeight: 500
                                },
                                value: { 
                                    fontSize: '30px', 
                                    offsetY: -15,
                                    fontWeight: 600,
                                    color: '#475F7B'
                                },
                                total: {
                                    show: true,
                                    label: 'Jami',
                                    fontSize: '16px',
                                    fontWeight: 600,
                                    color: '#475F7B',
                                    formatter: function() {
                                        return data.totalCustomers + data.activeCustomers + data.totalOrders;
                                    }
                                }
                            }
                        }
                    },
                    stroke: { 
                        lineCap: 'round',
                        curve: 'smooth'
                    },
                    fill: {
                        type: 'gradient',
                        gradient: {
                            shade: 'light',
                            type: 'horizontal',
                            shadeIntensity: 0.5,
                            gradientToColors: [$success, $primary, $warning],
                            inverseColors: false,
                            opacityFrom: 1,
                            opacityTo: 0.8,
                            stops: [0, 50, 100]
                        }
                    },
                    labels: ['Jami mijozlar', 'Faol mijozlar', 'Buyurtmalar'],
                    legend: {
                        show: true,
                        position: 'bottom',
                        fontSize: '14px',
                        markers: { radius: 50, height: 8, width: 8 }
                    }
                };

                var crmCustomersChart = new ApexCharts(
                    document.querySelector("#crm-customers-chart"),
                    crmCustomersOptions
                );
                crmCustomersChart.render();

                $('#crm-orders').text(data.totalOrders);
            }
            },
            error: function(xhr, status, error) {
                console.error('CRM Customers Stats xatosi:', error);
                $('#crm-customers-chart').html('<p class="text-center text-muted">Ma\'lumot yuklanmadi</p>');
            }
        });

        // SRM Product Stocks Chart
        $.ajax({
            url: '/Home/GetSRMMaterialRequirements',
            method: 'GET',
            timeout: 30000,
            success: function (data) {
            if (data && data.length > 0) {
                var productNos = data.map(x => x.productNo);
                var stocks = data.map(x => x.totalStock);

                var srmMaterialRequirementsOptions = {
                    chart: {
                        height: 350,
                        type: 'bar',
                        horizontal: true,
                        toolbar: { show: false }
                    },
                    colors: [$warning],
                    plotOptions: {
                        bar: { 
                            horizontal: true,
                            borderRadius: 4,
                            columnWidth: '60%'
                        }
                    },
                    dataLabels: { enabled: false },
