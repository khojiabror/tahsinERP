                                    <h4 class="card-title mb-0">Vazifalar Moduli</h4>
                                </div>
                                <i class="bx bx-dots-vertical-rounded font-medium-3 cursor-pointer"></i>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div id="tasks-stats-chart"></div>
                                </div>
