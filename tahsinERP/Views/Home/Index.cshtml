@{
    ViewBag.Title = L.T("Core_HomeTitle");
    // Bo'limlar paket (sinovda tanlangan modullar) va rol ruxsati bo'yicha — HomeSections (HomeController.cs)
    var sec = (tahsinERP.Controllers.HomeSections)ViewBag.Sections;
    var tiles = (System.Collections.Generic.List<tahsinERP.Controllers.HomeModuleTile>)ViewBag.ModuleTiles;
    bool showGauge = sec.Sales || sec.Production || sec.Tasks;
}
<!-- BEGIN: Content-->
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2">
                <div class="row breadcrumbs-top">
                    @*<div class="col-12">
                        <h2 class="content-header-title float-left mb-0">Dashboard</h2>
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                                <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                <li class="breadcrumb-item active">Dashboard</li>
                            </ol>
                        </div>
                    </div>*@
                </div>
            </div>
        </div>
        <div class="content-body">
            <section id="dashboard-ecommerce">
                @if (tiles.Count > 0)
                {
                    <div class="row" id="home-module-tiles">
                        @foreach (var t in tiles)
                        {
                            <div class="col-xl-2 col-md-3 col-sm-4 col-6">
                                <a href="@t.Url" class="card text-center mb-1"><div class="card-body py-1">
                                    <i class="bx @t.Icon font-large-1 text-primary"></i>
                                    <p class="mb-0 mt-50 text-truncate">@L.T(t.TitleKey)</p>
                                </div></a>
                            </div>
                        }
                    </div>
                }
                @if (!sec.Any)
                {
                    <div class="row"><div class="col-12"><div class="card"><div class="card-body">
                        <h4 class="mb-50">@L.T("Core_ExecPanelTitle")</h4>
                        <p class="text-muted mb-0">@L.T("Core_HomeNoExecSections")</p>
                    </div></div></div></div>
                }
                else
                {
                <div class="row mb-1">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body d-flex flex-wrap justify-content-between align-items-center">
                                <div>
                                    <h4 class="mb-50">@L.T("Core_ExecPanelTitle")</h4>
                                    <small class="text-muted">@L.T("Core_ExecPanelSubtitle")</small>
                                </div>
                                <div class="d-flex align-items-center mt-1 mt-md-0">
                                    @if (sec.Stock)
                                    {
                                        <select id="warehouseFilter" class="form-control mr-1" style="min-width: 220px;">
                                            <option value="">@L.T("Core_AllWarehousesRaw")</option>
                                        </select>
                                    }
                                    <input type="date" id="fromDate" class="form-control mr-1" style="min-width: 150px;" />
                                    <input type="date" id="toDate" class="form-control mr-1" style="min-width: 150px;" />
                                    <button class="btn btn-primary" id="applyFilters">
                                        <i class="bx bx-refresh mr-25"></i> @L.T("Refresh")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    @if (sec.Sales)
                    {
                        <div class="col-xl-3 col-sm-6 col-12"><div class="card"><div class="card-body"><p class="mb-0 text-muted">@L.T("Core_KpiMonthlyConversion")</p><h2 class="mb-50" id="kpi-conversion">0%</h2><small class="text-muted">@L.T("Core_KpiContractToOrder")</small></div></div></div>
                    }
                    @if (sec.Sales)
                    {
                        <div class="col-xl-3 col-sm-6 col-12"><div class="card"><div class="card-body"><p class="mb-0 text-muted">@L.T("Core_KpiSalesFulfillment")</p><h2 class="mb-50" id="kpi-fulfillment">0%</h2><small class="text-muted">@L.T("Core_KpiOrderToInvoice")</small></div></div></div>
                    }
                    @if (sec.Production)
                    {
                        <div class="col-xl-3 col-sm-6 col-12"><div class="card"><div class="card-body"><p class="mb-0 text-muted">@L.T("Core_KpiProductionExec")</p><h2 class="mb-50" id="kpi-production">0%</h2><small class="text-muted">@L.T("Core_KpiPlanToActual")</small></div></div></div>
                    }
                    @if (sec.Tasks)
                    {
                        <div class="col-xl-3 col-sm-6 col-12"><div class="card"><div class="card-body"><p class="mb-0 text-muted">@L.T("Core_KpiTasksExec")</p><h2 class="mb-50" id="kpi-tasks">0%</h2><small class="text-muted"><span id="task-done">0</span>/<span id="task-total">0</span> @L.T("Core_KpiDone")</small></div></div></div>
                    }
                </div>

                <div class="row">
                    @if (sec.Stock)
                    {
                        <div class="col-xl-3 col-sm-6 col-12"><div class="card"><div class="card-body"><p class="mb-0 text-muted">@L.T("Core_KpiDoh")</p><h3 id="kpi-doh">@L.T("Core_DaysValue", 0)</h3></div></div></div>
                    }
                    @if (sec.Stock)
                    {
                        <div class="col-xl-3 col-sm-6 col-12"><div class="card"><div class="card-body"><p class="mb-0 text-muted">@L.T("Core_KpiCoverageDays")</p><h3 id="kpi-coverage">@L.T("Core_DaysValue", 0)</h3></div></div></div>
                    }
                    @if (sec.Sales)
                    {
                        <div class="col-xl-3 col-sm-6 col-12"><div class="card"><div class="card-body"><p class="mb-0 text-muted">@L.T("Core_KpiSalesOrders")</p><h3 id="kpi-orders-amount">0</h3></div></div></div>
                    }
                    @if (sec.Sales)
                    {
                        <div class="col-xl-3 col-sm-6 col-12"><div class="card"><div class="card-body"><p class="mb-0 text-muted">@L.T("Core_KpiInvoiceVolume")</p><h3 id="kpi-invoice-amount">0</h3></div></div></div>
                    }
                </div>

                <div class="row match-height">
                    @if (sec.Sales)
                    {
                        <div class="col-lg-6 col-12">
                            <div class="card">
                                <div class="card-header"><h4 class="card-title mb-0">@L.T("Core_ChartSalesTrend")</h4></div>
                                <div class="card-body"><div id="sales-funnel-chart"></div></div>
                            </div>
                        </div>
                    }
                    @if (sec.Production)
                    {
                        <div class="col-lg-6 col-12">
                            <div class="card">
                                <div class="card-header"><h4 class="card-title mb-0">@L.T("Core_ChartProductionTrend")</h4></div>
                                <div class="card-body"><div id="production-trend-chart"></div></div>
                            </div>
                        </div>
                    }
                </div>

                <div class="row match-height">
                    @if (sec.Stock)
                    {
                        <div class="col-lg-6 col-12">
                            <div class="card">
                                <div class="card-header"><h4 class="card-title mb-0">@L.T("Core_ChartCoverageRisk")</h4></div>
                                <div class="card-body"><div id="coverage-heat-chart"></div></div>
                            </div>
                        </div>
                    }
                    @if (showGauge)
                    {
                        <div class="col-lg-6 col-12">
                            <div class="card">
                                <div class="card-header"><h4 class="card-title mb-0">@L.T("Core_ChartExecutionKpi")</h4></div>
                                <div class="card-body"><div id="execution-gauge-chart"></div></div>
                            </div>
                        </div>
                    }
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header"><h4 class="card-title mb-0">@L.T("Core_SignalPanel")</h4></div>
                            <div class="card-body"><div id="insight-list"></div></div>
                        </div>
                    </div>
                </div>
                }
            </section>

        </div>
    </div>
</div>
<!-- END: Content-->

<!-- BEGIN: Page Vendor JS-->
<script src="~/app-assets/vendors/js/charts/apexcharts.min.js"></script>
<!-- END: Page Vendor JS-->
<!-- BEGIN: Page JS-->
<!-- dashboard-ecommerce.js o'chirildi - o'z chart kodlarimiz ishlatilmoqda va bu fayl jQuery xatosiga sabab bo'lmoqda -->
<!-- <script src="~/app-assets/js/scripts/pages/dashboard-ecommerce.js"></script> -->
<!-- END: Page JS-->

<script>
    (function () {
        var charts = {};
        var currencyShortname = '@(ViewBag.CurrencyShortname ?? "")';
        var warehouseInitialized = false;
        var hasExec = @(sec.Any ? "true" : "false");
        function el(id) { return document.getElementById(id); }
        var T = {
            days: '@L.Js("Core_DaysValue")',
            noSignal: '@L.Js("Core_NoSignal")',
            order: '@L.Js("Core_SeriesOrder")',
            invoice: '@L.Js("Core_SeriesInvoice")',
            amount: '@L.Js("Amount")',
            planQty: '@L.Js("Core_SeriesPlanQty")',
            actualQty: '@L.Js("Core_SeriesActualQty")',
            qty: '@L.Js("Quantity")',
            coverageDays: '@L.Js("Core_KpiCoverageDays")',
            stock: '@L.Js("Core_StockLabel")',
            dailyDemand: '@L.Js("Core_DailyDemand")',
            orderExec: '@L.Js("Core_OrderExec")',
            productionExec: '@L.Js("Core_KpiProductionExec")',
            taskExec: '@L.Js("Core_TaskExec")',
            avgControl: '@L.Js("Core_AvgControl")',
            allWarehouses: '@L.Js("Core_AllWarehousesRaw")',
            warehouseN: '@L.Js("Core_WarehouseN")',
            notLoaded: '@L.Js("Core_DataNotLoaded")',
            panelNotLoaded: '@L.Js("Core_ExecPanelNotLoaded")'
        };
        function days(v) { return T.days.replace('{0}', v); }

        function formatSpaceNumber(value, decimals) {
            var d = typeof decimals === 'number' ? decimals : 0;
            var n = Number(value || 0);
            var fixed = n.toFixed(d);
            var parts = fixed.split('.');
            parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
            return d > 0 ? parts.join('.') : parts[0];
        }

        function formatAmount(value, decimals) {
            return formatSpaceNumber(value, typeof decimals === 'number' ? decimals : 0) + (currencyShortname ? (' ' + currencyShortname) : '');
        }

        function formatPercent(value) {
            return Number(value || 0).toFixed(1) + '%';
        }

        function destroyCharts() {
            Object.keys(charts).forEach(function (k) {
                if (charts[k] && typeof charts[k].destroy === 'function') charts[k].destroy();
            });
            charts = {};
        }

        function renderInsights(insights) {
            var html = '';
            (insights || []).forEach(function (x) {
                var color = x.level === 'high' ? 'danger' : (x.level === 'medium' ? 'warning' : 'success');
                html += '<div class="alert alert-light-' + color + ' mb-1"><i class="bx bx-bell mr-50"></i>' + x.text + '</div>';
            });
            if (!el('insight-list')) return;
            el('insight-list').innerHTML = html || '<p class="text-muted mb-0">' + T.noSignal + '</p>';
        }

        function renderSalesFunnelChart(data) {
            if (!el('sales-funnel-chart')) return;
            var trend = data.trend || [];
            var periods = trend.map(function (x) { return x.period; });
            charts.sales = new ApexCharts(document.querySelector("#sales-funnel-chart"), {
                chart: { type: 'line', height: 330, stacked: false, toolbar: { show: true } },
                series: [
                    { name: T.order, type: 'column', data: trend.map(function (x) { return x.orderAmount; }) },
                    { name: T.invoice, type: 'column', data: trend.map(function (x) { return x.invoiceAmount; }) }
                ],
                stroke: { width: [0, 0], curve: 'smooth' },
                colors: ['#39DA8A', '#00CFDD'],
                xaxis: { categories: periods },
                yaxis: [{ title: { text: T.amount }, labels: { formatter: function (v) { return formatSpaceNumber(v, 0); } } }],
                tooltip: {
                    shared: true,
                    intersect: false,
                    y: { formatter: function (val) { return formatAmount(val, 2); } }
                },
                legend: { position: 'top' }
            });
            charts.sales.render();
        }

        function renderProductionTrendChart(data) {
            if (!el('production-trend-chart')) return;
            var trend = data.trend || [];
            var periods = trend.map(function (x) { return x.period; });
            charts.production = new ApexCharts(document.querySelector("#production-trend-chart"), {
                chart: { type: 'line', height: 330, stacked: false, toolbar: { show: true } },
                series: [
                    { name: T.planQty, type: 'line', data: trend.map(function (x) { return x.plannedQty; }) },
                    { name: T.actualQty, type: 'line', data: trend.map(function (x) { return x.producedQty; }) }
                ],
                stroke: { width: [3, 3], curve: 'smooth' },
                colors: ['#FDAC41', accentColor()],
                xaxis: { categories: periods },
                yaxis: [{ title: { text: T.qty }, labels: { formatter: function (v) { return formatSpaceNumber(v, 0); } } }],
                tooltip: {
                    shared: true,
                    intersect: false,
                    y: { formatter: function (val) { return formatSpaceNumber(val, 2); } }
                },
                legend: { position: 'top' }
            });
            charts.production.render();
        }

        function renderCoverageChart(data) {
            if (!el('coverage-heat-chart')) return;
            var stock = (data.stockCoverage || []).slice(0, 12);
            charts.coverage = new ApexCharts(document.querySelector("#coverage-heat-chart"), {
                chart: { type: 'bar', height: 340, toolbar: { show: false } },
                series: [{ name: T.coverageDays, data: stock.map(function (x) { return x.coverageDays; }) }],
                plotOptions: {
                    bar: {
                        horizontal: true,
                        distributed: true,
                        borderRadius: 4,
                        colors: {
                            ranges: [
                                { from: 0, to: 20, color: '#FF5B5C' },
                                { from: 20, to: 45, color: '#FDAC41' },
                                { from: 45, to: 90, color: '#39DA8A' },
                                { from: 90, to: 9999, color: '#6c757d' }
                            ]
                        }
                    }
                },
                dataLabels: {
                    enabled: true,
                    formatter: function (v) { return days(formatSpaceNumber(v, 1)); }
                },
                xaxis: { categories: stock.map(function (x) { return x.product; }) },
                tooltip: {
                    y: {
                        formatter: function (val, opts) {
                            var i = opts.dataPointIndex;
                            var item = stock[i] || {};
                            return days(formatSpaceNumber(val, 1)) + ' | ' + T.stock + ': ' + formatSpaceNumber(item.stockQty || 0, 2) + ' | ' + T.dailyDemand + ': ' + formatSpaceNumber(item.avgDailyDemand || 0, 2);
                        }
                    }
                }
            });
            charts.coverage.render();
        }

        function renderExecutionGauge(data) {
            if (!el('execution-gauge-chart')) return;
            var k = data.kpis || {}, s = data.sections || {};
            // faqat ko'rsatilayotgan modullar halqalari
            var rings = [];
            if (s.sales) rings.push({ v: k.orderFulfillmentRate || 0, l: T.orderExec, c: '#1f8ef1' });
            if (s.production) rings.push({ v: k.productionExecutionRate || 0, l: T.productionExec, c: accentColor() });
            if (s.tasks) rings.push({ v: k.taskCompletionRate || 0, l: T.taskExec, c: '#FDAC41' });
            charts.gauge = new ApexCharts(document.querySelector("#execution-gauge-chart"), {
                chart: { type: 'radialBar', height: 340 },
                series: rings.map(function (r) { return r.v; }),
                labels: rings.map(function (r) { return r.l; }),
                colors: rings.map(function (r) { return r.c; }),
                plotOptions: {
                    radialBar: {
                        offsetY: 0,
                        startAngle: -130,
                        endAngle: 130,
                        hollow: { size: '30%' },
                        dataLabels: {
                            name: { fontSize: '13px' },
                            value: {
                                fontSize: '22px',
                                formatter: function (v) { return Number(v).toFixed(1) + '%'; }
                            },
                            total: {
                                show: true,
                                label: T.avgControl,
                                formatter: function (w) {
                                    var s = w.globals.seriesTotals;
                                    var avg = s.reduce(function (a, b) { return a + b; }, 0) / s.length;
                                    return avg.toFixed(1) + '%';
                                }
                            }
                        }
                    }
                }
            });
            charts.gauge.render();
        }

        function bindKpis(k) {
            $('#kpi-conversion').text(formatPercent(k.salesConversionRate));
            $('#kpi-fulfillment').text(formatPercent(k.orderFulfillmentRate));
            $('#kpi-production').text(formatPercent(k.productionExecutionRate));
            $('#kpi-tasks').text(formatPercent(k.taskCompletionRate));
            $('#task-done').text(formatSpaceNumber(k.completedTasks || 0, 0));
            $('#task-total').text(formatSpaceNumber(k.totalTasks || 0, 0));
            $('#kpi-doh').text(days(formatSpaceNumber(k.dohDays || 0, 1)));
            $('#kpi-coverage').text(days(formatSpaceNumber(k.coverageDays || 0, 1)));
            $('#kpi-orders-amount').text(formatAmount(k.orderAmount, 2));
            $('#kpi-invoice-amount').text(formatAmount(k.invoiceAmount, 2));
        }

        function bindWarehouseOptions(data) {
            if (warehouseInitialized) return;
            var list = data.warehouses || [];
            var current = data.selectedWarehouseId;
            var html = '<option value="">' + T.allWarehouses + '</option>';
            list.forEach(function (w) {
                var selected = current && Number(current) === Number(w.id) ? ' selected' : '';
                html += '<option value="' + w.id + '"' + selected + '>' + (w.name || T.warehouseN.replace('{0}', w.id)) + '</option>';
            });
            $('#warehouseFilter').html(html);
            warehouseInitialized = true;
        }

        function loadExecutiveDashboard() {
            var fromDate = $('#fromDate').val();
            var toDate = $('#toDate').val();
            var warehouseId = $('#warehouseFilter').val() || '';
            $.ajax({
                url: '/Home/GetExecutiveDashboard',
                method: 'GET',
                data: { fromDate: fromDate, toDate: toDate, warehouseId: warehouseId },
                success: function (data) {
                    if (!data || data.error) {
                        $('#insight-list').html('<p class="text-danger mb-0">' + (data && data.error ? data.error : T.notLoaded) + '</p>');
                        return;
                    }
                    bindWarehouseOptions(data);
                    destroyCharts();
                    bindKpis(data.kpis || {});
                    renderInsights(data.insights || []);
                    renderSalesFunnelChart(data);
                    renderProductionTrendChart(data);
                    renderCoverageChart(data);
                    renderExecutionGauge(data);
                },
                error: function () {
                    $('#insight-list').html('<p class="text-danger mb-0">' + T.panelNotLoaded + '</p>');
                }
            });
        }

        function init() {
            if (!hasExec) return;
            if (typeof jQuery === 'undefined' || typeof ApexCharts === 'undefined') {
                return setTimeout(init, 100);
            }
            var now = new Date();
            var to = now.toISOString().split('T')[0];
            var fromObj = new Date(now.getFullYear(), now.getMonth() - 1, now.getDate());
            var from = fromObj.toISOString().split('T')[0];
            $('#fromDate').val(from);
            $('#toDate').val(to);
            $('#applyFilters').on('click', loadExecutiveDashboard);
            $('#warehouseFilter').on('change', loadExecutiveDashboard);
            loadExecutiveDashboard();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>
