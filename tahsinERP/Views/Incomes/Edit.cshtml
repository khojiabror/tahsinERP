@model tahsinERP.ViewModels.IncomeEditViewModel
@using System.Collections.Generic
@{
    ViewBag.Title = L.T("Wh_Inc_EditTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var unitsList = ViewBag.Units as SelectList;
    var unitsData = new List<object>();

    if (unitsList != null)
    {
        foreach (SelectListItem item in unitsList)
        {
            unitsData.Add(new { Value = item.Value, Text = item.Text });
        }
    }

    var requireDloc = ViewBag.RequireDloc == true;
    var dlocEnabled = ViewBag.DlocEnabled == true;
    var dlocLocationsJson = ViewBag.DlocLocationsJson as string ?? "[]";
}

@* Ruxsat controller action'ida tekshiriladi (SRM-M05). *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Incomes/Index">@L.T("Wh_IncListTitle")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Edit")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @if (TempData["Error"] != null)
                                        {
                                            <div class="alert alert-danger">
                                                @TempData["Error"]
                                            </div>
                                        }

                                        @using (Html.BeginForm("Edit", "Incomes", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form", @id = "incomeForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(model => model.ID)
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row">
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="DocNo">@L.T("Wh_DocNo")</label>
                                                    @Html.TextBoxFor(model => model.DocNo, new { @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.DocNo, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="IssueDateTime">@L.T("Wh_DateTime")</label>
                                                    @Html.TextBoxFor(model => model.IssueDateTime, "{0:yyyy-MM-ddTHH:mm}", new { @type = "datetime-local", @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.IssueDateTime, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="ReceivingWHID">@L.T("Wh_ReceiverWarehouse")</label>
                                                    @Html.DropDownListFor(model => model.ReceivingWHID, ViewBag.Warehouses as SelectList, L.T("Wh_SelectDashed"), new { @class = "form-control select2", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.ReceivingWHID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="CurrencyID">@L.T("Currency")</label>
                                                    @Html.DropDownListFor(model => model.CurrencyID, ViewBag.Currencies as SelectList, L.T("Wh_SelectDashed"), new { @class = "form-control select2", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-6 col-12 form-group">
                                                    <label for="Description">@L.T("Comment")</label>
                                                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = "2" })
                                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-6 col-12 form-group">
                                                    <label for="incomeFile">@L.T("Wh_Inc_NewDocPdf")</label>
                                                    <input type="file" name="incomeFile" id="incomeFile" class="form-control" accept=".pdf" />
                                                </div>
                                            </div>

                                            <br />
                                            <h5>@L.T("Wh_Inc_Products")</h5>
                                            <p class="text-muted small mb-2">@L.T("Wh_VatHint")</p>
                                            
                                            <div class="table-responsive">
                                                <table id="incomeProductsTable" class="table table-bordered doc-lines">
                                                    <thead>
                                                        <tr>
                                                            <th>@L.T("Wh_Product")</th>
                                                            <th>@L.T("Wh_ProductName")</th>
                                                            @if (dlocEnabled)
                                                            {
                                                                <th>DLOC @(requireDloc ? Html.Raw("<span class=\"text-danger\">*</span>") : null)</th>
                                                            }
                                                            <th>@L.T("Quantity")</th>
                                                            <th>@L.T("Unit")</th>
                                                            <th>@L.T("Wh_UnitPrice")</th>
                                                            <th>@L.T("Wh_VatPct")</th>
                                                            <th>@L.T("Total")</th>
                                                            <th>@L.T("Comment")</th>
                                                            <th>@L.T("Actions")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (Model.IncomeProducts != null)
                                                        {
                                                            for (int i = 0; i < Model.IncomeProducts.Count; i++)
                                                            {
                                                                var product = Model.IncomeProducts[i];
                                                                <tr data-row-index="@i">
                                                                    <td>
                                                                        <select name="IncomeProducts[@i].ProductID" class="form-control product-select select2" required>
                                                                            <option value="">@L.T("Wh_SelectDashed")</option>
                                                                            @if (product.ProductID > 0)
                                                                            {
                                                                                <option value="@product.ProductID" data-name="@product.ProductName" data-pno="@product.ProductPNo" selected>@(product.ProductPNo + " - " + product.ProductName)</option>
                                                                            }
                                                                        </select>
                                                                        @Html.HiddenFor(m => m.IncomeProducts[i].ProductPNo, new { @class = "product-pno" })
                                                                        @Html.HiddenFor(m => m.IncomeProducts[i].ID)
                                                                    </td>
                                                                    <td>
                                                                        <input type="text" class="form-control product-name-display" value="@product.ProductName" disabled />
                                                                        @Html.HiddenFor(m => m.IncomeProducts[i].ProductName, new { @class = "product-name" })
                                                                    </td>
                                                                    @if (dlocEnabled)
                                                                    {
                                                                        <td>
                                                                            @if (requireDloc)
                                                                            {
                                                                                @Html.DropDownListFor(m => m.IncomeProducts[i].LocationID, ViewBag.DlocLocations as SelectList, L.T("Wh_SelectDots"), new { @class = "form-control dloc-select select2", required = "required" })
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="text-muted small">@L.T("Wh_NoDloc")</span>
                                                                            }
                                                                        </td>
                                                                    }
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.IncomeProducts[i].Amount, "{0:0.######}", new { @type = "number", @class = "form-control amount-input", @step = "0.01", @min = "0", @required = "required" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.DropDownListFor(m => m.IncomeProducts[i].UnitID, ViewBag.Units as SelectList, L.T("Wh_SelectDashed"), new { @class = "form-control unit-select select2", @required = "required" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.IncomeProducts[i].PiecePrice, "{0:0.######}", new { @type = "number", @class = "form-control price-input", @step = "0.01", @min = "0" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.IncomeProducts[i].VATRate, "{0:0.######}", new { @type = "number", @class = "form-control vat-input", @step = "0.01", @min = "0", @max = "100" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.IncomeProducts[i].TotalPrice, "{0:0.############}", new { @type = "number", @class = "form-control total-price", @readonly = "readonly" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.IncomeProducts[i].Comment, new { @class = "form-control comment-input" })
                                                                    </td>
                                                                    <td>
                                                                        <button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="@(dlocEnabled ? 8 : 6)" class="text-right"><strong>@L.T("Wh_TotalColon")</strong></td>
                                                            <td id="totalAmount" class="text-right"><strong>@(Model.TotalPrice?.ToString("N2") ?? "0.00")</strong></td>
                                                            <td colspan="2"></td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>

                                            @Html.Partial("~/Views/Incomes/_DocFormActions.cshtml", "Incomes")
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section scripts {
        <script src="~/Scripts/srm/srm-doc-lines.js"></script>
        <script src="~/Scripts/srm/srm-doc-forms.js"></script>
        <script src="~/Scripts/app/indexed-rows.js"></script>
        <script src="~/Scripts/app/product-select.js"></script>
        <script>
            (function ($) {
                $(document).ready(function () {
                    $('.select2').select2();

                    var productRowIndex = @(Model.IncomeProducts?.Count ?? 0);
                    var productSearchUrl = '@Url.Action("Search", "ProductLookup")';
                    // Serverda chizilgan qatorlar ham server qidiruviga o'tadi (SRM-P05)
                    ProductSelect.attach($('select.product-select'), productSearchUrl);
                    var units = @Html.Raw(Json.Encode(unitsData));
                    var requireDloc = @(requireDloc ? "true" : "false");
                    var dlocEnabled = @(dlocEnabled ? "true" : "false");
                    var dlocLocations = @Html.Raw(dlocLocationsJson);

                    function escapeHtml(text) { return srmDocLines.escapeHtml(text); }

                    function buildProductOptions(selectedId, pno, name) { return srmIncomeForm.productOptions(selectedId, pno, name); }

                    function buildUnitOptions(selectedId) { return srmDocLines.unitOptions(units, selectedId); }

                    function buildDlocOptions(selectedId) { return srmIncomeForm.dlocOptions(dlocLocations, selectedId); }

                    function syncProductFields($row) { srmIncomeForm.syncProduct($row); }

                    function recalcRow($row) { srmIncomeForm.recalcRow($row); }

                    $('#incomeProductsTable tbody tr').each(function () {
                        var $r = $(this);
                        syncProductFields($r);
                        recalcRow($r);
                    });

                    updateTotal();

                    $('#addRowBtn').click(function () {
                        var dlocTd = '';
                        if (dlocEnabled && requireDloc) {
                            dlocTd = '<td><select name="IncomeProducts[' + productRowIndex + '].LocationID" class="form-control dloc-select select2" required>' +
                                buildDlocOptions(null) + '</select></td>';
                        } else if (dlocEnabled) {
                            dlocTd = '<td class="small text-muted">@L.Js("Wh_NoDloc")</td>';
                        }
                        var row = '<tr data-row-index="' + productRowIndex + '">' +
                            '<td>' +
                                '<select name="IncomeProducts[' + productRowIndex + '].ProductID" class="form-control product-select select2" required>' +
                                    buildProductOptions(null) +
                                '</select>' +
                                '<input type="hidden" name="IncomeProducts[' + productRowIndex + '].ProductPNo" class="product-pno" value="" />' +
                                '<input type="hidden" name="IncomeProducts[' + productRowIndex + '].ID" value="" />' +
                            '</td>' +
                            '<td>' +
                                '<input type="text" class="form-control product-name-display" value="" disabled />' +
                                '<input type="hidden" name="IncomeProducts[' + productRowIndex + '].ProductName" class="product-name" value="" />' +
                            '</td>' +
                            dlocTd +
                            '<td><input type="number" name="IncomeProducts[' + productRowIndex + '].Amount" class="form-control amount-input" step="0.01" min="0" required /></td>' +
                            '<td>' +
                                '<select name="IncomeProducts[' + productRowIndex + '].UnitID" class="form-control unit-select select2" required>' +
                                    buildUnitOptions(null) +
                                '</select>' +
                            '</td>' +
                            '<td><input type="number" name="IncomeProducts[' + productRowIndex + '].PiecePrice" class="form-control price-input" step="0.01" min="0" /></td>' +
                            '<td><input type="number" name="IncomeProducts[' + productRowIndex + '].VATRate" class="form-control vat-input" value="0" step="0.01" min="0" max="100" /></td>' +
                            '<td><input type="number" name="IncomeProducts[' + productRowIndex + '].TotalPrice" class="form-control total-price" readonly /></td>' +
                            '<td><input type="text" name="IncomeProducts[' + productRowIndex + '].Comment" class="form-control comment-input" /></td>' +
                            '<td><button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button></td>' +
                            '</tr>';

                        $('#incomeProductsTable tbody').append(row);
                        var $row = $('#incomeProductsTable tbody tr').last();

                        if (typeof $.fn.select2 !== 'undefined') {
                            ProductSelect.attach($row.find('select.product-select'), productSearchUrl);
                            $row.find('select.unit-select').select2();
                            if (dlocEnabled && requireDloc) {
                                $row.find('select.dloc-select').select2();
                            }
                        }

                        syncProductFields($row);
                        recalcRow($row);
                        productRowIndex++;
                    });

                    $(document).on('click', '.remove-row', function () {
                        $(this).closest('tr').remove();
                        updateTotal();
                    });

                    $(document).on('change', '.product-select', function () {
                        var $row = $(this).closest('tr');
                        syncProductFields($row);
                    });

                    $(document).on('input', '.amount-input, .price-input, .vat-input', function () {
                        recalcRow($(this).closest('tr'));
                        updateTotal();
                    });

                    function updateTotal() { srmDocLines.updateTotal(); }
                });
            })(jQuery);
        </script>
    }
}
