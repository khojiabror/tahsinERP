@model tahsinERP.Models.INCOME
@using tahsinERP.Services.DlocFifo
@{
    ViewBag.Title = L.T("Wh_Inc_DetailsTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var dlocEnabled = ViewBag.DlocEnabled == true;
    var hasDlocLocations = ViewBag.HasDlocLocations == true;
    var incomeDocIds = ViewBag.DocIds as List<int> ?? new List<int>();
    var hasIncomeDocs = incomeDocIds.Count > 0;
}

@* Ruxsat controller action'ida tekshiriladi (SRM-M05). *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Incomes/Index">@L.T("Wh_IncListTitle")</a>
                                    </li>
                                    <li class="breadcrumb-item active">@L.T("Wh_DetailsCrumb")</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@L.T("Wh_Inc_DocInfo")</h4>
                                <div class="heading-elements">
                                    @if (ViewBag.CanEdit == true)
                                    {
                                        <a href="@Url.Action("Edit", "Incomes", new { id = Model.ID })" class="btn btn-sm btn-warning">
                                            <i class="bx bx-edit-alt"></i> @L.T("Edit")
                                        </a>
                                    }
                                    <a href="@Url.Action("Index", "Incomes")" class="btn btn-sm btn-secondary">
                                        <i class="bx bx-arrow-back"></i> @L.T("Back")
                                    </a>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    @if (TempData["Success"] != null)
                                    {
                                        <div class="alert alert-success">@TempData["Success"]</div>
                                    }
                                    @if (TempData["Error"] != null)
                                    {
                                        <div class="alert alert-danger">@TempData["Error"]</div>
                                    }
                                    <div class="row">
                                        <div class="col-md-6">
                                            <table class="table table-borderless">
                                                <tr>
                                                    <th width="40%">@L.T("Wh_DocNoColon")</th>
                                                    <td>@Model.DocNo</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Wh_DateColon")</th>
                                                    <td>@Model.IssueDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Wh_ReceiverWarehouseColon")</th>
                                                    <td>@(Model.Warehouse?.WHName ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Wh_SenderWarehouseColon")</th>
                                                    <td>@(Model.Warehouse1?.WHName ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Wh_InvoiceColon")</th>
                                                    <td>
                                                        @if (Model.P_INVOICES != null)
                                                        {
                                                            <a href="@Url.Action("Details", "PInvoices", new { id = Model.InvoiceID })">@Model.P_INVOICES.InvoiceNo</a>
                                                        }
                                                        else if (!string.IsNullOrEmpty(Model.Description) && Model.Description.Contains("Chiqimdan avtomatik bog'langan:"))
                                                        {
                                                            <span class="badge badge-info">@L.T("Wh_AutoCreated")</span>
                                                            if (ViewBag.LinkedExpenseId != null)
                                                            {
                                                                <a href="@Url.Action("Details", "Expenses", new { id = ViewBag.LinkedExpenseId })" class="ml-1">@(ViewBag.LinkedExpenseDocNo) <i class="bx bx-link-external"></i></a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted ml-1">@L.T("Wh_Inc_FromExpense")</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span>-</span>
                                                        }
                                                    </td>
                                                </tr>
                                                @if (!string.IsNullOrEmpty(Model.Description) && Model.Description.Contains("Chiqimdan avtomatik bog'langan:"))
                                                {
                                                    <tr>
                                                        <th>@L.T("Wh_SourceColon")</th>
                                                        <td>
                                                            <span class="badge badge-info">@L.T("Wh_AutoCreated")</span>
                                                            @if (ViewBag.LinkedExpenseId != null)
                                                            {
                                                                <a href="@Url.Action("Details", "Expenses", new { id = ViewBag.LinkedExpenseId })" class="ml-1">@L.T("Wh_Inc_ExpenseDocColon") @(ViewBag.LinkedExpenseDocNo) <i class="bx bx-link-external"></i></a>
                                                            }
                                                            else
                                                            {
                                                                <small class="text-muted ml-1">@L.T("Wh_Inc_AutoCreatedFromSrm")</small>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </table>
                                        </div>
                                        <div class="col-md-6">
                                            <table class="table table-borderless">
                                                <tr>
                                                    <th width="40%">@L.T("Wh_CurrencyColon")</th>
                                                    <td>@(Model.CURRENCy1?.Shortname ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Wh_TotalQtyColon")</th>
                                                    <td>@(Model.Amount?.ToString("N2") ?? "0.00")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Wh_TotalAmountColon")</th>
                                                    <td><strong>@(Model.TotalPrice?.ToString("N2") ?? "0.00")</strong></td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Wh_StatusOnlyColon")</th>
                                                    <td>
                                                        @if (Model.RecieveStatus == true)
                                                        {
                                                            <span class="badge badge-success">@L.T("Wh_StReceived")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-warning">@L.T("Wh_StPending")</span>
                                                        }
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Wh_CommentColon")</th>
                                                    <td>
                                                        @if (ViewBag.LinkedExpenseId != null && !string.IsNullOrEmpty(Model.Description) && Model.Description.Contains("Chiqimdan avtomatik bog'langan:"))
                                                        {
                                                            var marker = "Chiqimdan avtomatik bog'langan: ";
                                                            var idx = Model.Description.IndexOf(marker);
                                                            var rest = idx >= 0 ? Model.Description.Substring(idx + marker.Length) : Model.Description;
                                                            var dashIdx = rest.IndexOf(" - ");
                                                            var suffix = (dashIdx >= 0 && rest.Length > dashIdx + 3) ? rest.Substring(dashIdx + 3) : "";
                                                            <span>@L.T("Wh_Inc_AutoLinkedFromExpense") </span>
                                                            <a href="@Url.Action("Details", "Expenses", new { id = ViewBag.LinkedExpenseId })">@(ViewBag.LinkedExpenseDocNo)</a>
                                                            @(string.IsNullOrEmpty(suffix) ? "" : " - " + suffix)
                                                        }
                                                        else
                                                        {
                                                            @(Model.Description ?? "-")
                                                        }
                                                    </td>
                                                </tr>
                                            </table>
                                            @if (ViewBag.IncomePolicyMessage != null)
                                            {
                                                <div class="alert alert-warning mt-2 mb-0 py-1 px-2 small">
                                                    @ViewBag.IncomePolicyMessage
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <hr />
                                    <h5>@L.T("Wh_Inc_Products")</h5>

                                    @if (ViewBag.CanMrpReceive == true)
                                    {
                                        if (dlocEnabled && hasDlocLocations)
                                        {
                                            <p class="text-muted small mb-2">@L.T("Wh_Inc_SelectDlocThenReceive")</p>
                                        }
                                        using (Html.BeginForm("Receive", "Incomes", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", Model.ID)

                                            @Html.Partial("_IncomeLinesTable", Model, new ViewDataDictionary(ViewData) { { "editableDloc", true } })

                                            <div class="mt-2">
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bx bx-check"></i> @L.T("Wh_Receive")
                                                </button>
                                            </div>
                                        }
                                        using (Html.BeginForm("Reject", "Incomes", FormMethod.Post, new { @class = "d-inline ml-1", onsubmit = "return confirm('" + L.Js("Wh_Inc_RejectConfirm") + "');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", Model.ID)
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bx bx-x"></i> @L.T("Wh_Reject")
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        @Html.Partial("_IncomeLinesTable", Model, new ViewDataDictionary(ViewData) { { "editableDloc", false } })
                                    }

                                    @if (hasIncomeDocs)
                                    {
                                        <hr />
                                        <h5>@L.T("Wh_Inc_Docs")</h5>
                                        <ul>
                                            @foreach (var docId in incomeDocIds)
                                            {
                                                <li>
                                                    <a href="@Url.Action("DownloadDoc", "Incomes", new { id = docId })" target="_blank">
                                                        <i class="bx bx-file"></i> @L.T("Wh_DocNum", docId)
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
