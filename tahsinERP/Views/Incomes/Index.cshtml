@using System.Linq
@{
    ViewBag.Title = L.T("Wh_IncListTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    bool changePermit = ViewBag.ChangePermit as bool? ?? false;
    var assignedWarehouseIds = ViewBag.AssignedWarehouseIds as List<int> ?? new List<int>();
    bool canCreate = changePermit && (ViewBag.CanCreateManualIncome as bool? ?? false);
    var fromDate = ViewBag.FromDate as DateTime?;
    var toDate = ViewBag.ToDate as DateTime?;
}
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Wh_IncListTitle")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
            }
            <section class="invoice-list-wrapper">
                @if (canCreate)
                {
                    <div class="invoice-create-btn mb-1">
                        <a href="@Url.Action("Create", "Incomes")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                            <i class="bx bx-plus"></i> @L.T("Wh_NewIncome")
                        </a>
                    </div>
                }

                <div class="users-list-filter px-1">
                    @using (Html.BeginForm("Index", "Incomes", FormMethod.Get, new { @class = "form", id = "incomesFilter" }))
                    {
                        <div class="row border rounded py-2 mb-2">
                            <div class="col-12 col-sm-6 col-lg-2">
                                <label>@L.T("Wh_Warehouse")</label>
                                @Html.DropDownList("warehouseId", ViewBag.Warehouses as SelectList, L.T("All"), new { @class = "form-control" })
                            </div>
                            <div class="col-12 col-sm-6 col-lg-2">
                                <label>@L.T("Status")</label>
                                <select name="status" class="form-control">
                                    <option value="">@L.T("All")</option>
                                    <option value="1" @(ViewBag.Status != null && (int)ViewBag.Status == 1 ? "selected" : "")>@L.T("Wh_StReceived")</option>
                                    <option value="0" @(ViewBag.Status != null && (int)ViewBag.Status == 0 ? "selected" : "")>@L.T("Wh_StPending")</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-2">
                                <label>@L.T("DateFrom")</label>
                                <input type="date" name="fromDate" class="form-control" value="@(fromDate.HasValue ? fromDate.Value.ToString("yyyy-MM-dd") : "")" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-2">
                                <label>@L.T("DateTo")</label>
                                <input type="date" name="toDate" class="form-control" value="@(toDate.HasValue ? toDate.Value.ToString("yyyy-MM-dd") : "")" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bx bx-search"></i> @L.T("Search")
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-md-12 col-sm-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="incomesTable" class="table table-striped table-bordered nowrap" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>@L.T("Wh_DocNo")</th>
                                                <th>@L.T("Wh_InvoiceNo")</th>
                                                <th>@L.T("Wh_Warehouse")</th>
                                                <th>@L.T("Wh_TotalAmount")</th>
                                                <th>@L.T("Status")</th>
                                                <th>@L.T("Date")</th>
                                                @if (changePermit)
                                                {
                                                    <th>@L.T("Actions")</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/Scripts/srm/srm-server-table.js"></script>
    <script>
        $(document).ready(function () {
            var detailsUrl = '@Url.Action("Details", "Incomes")/';
            var editUrl = '@Url.Action("Edit", "Incomes")/';
            var deleteUrl = '@Url.Action("Delete", "Incomes")/';
            var invoiceUrl = '@Url.Action("Details", "PInvoices")/';
            var columns = [
                { data: 'docNo', render: function (v, t, r) { return '<a href="' + detailsUrl + r.id + '">' + srmEsc(v) + '</a>'; } },
                { data: 'invoiceNo', render: function (v, t, r) { return r.invoiceId ? '<a href="' + invoiceUrl + r.invoiceId + '">' + srmEsc(v) + '</a>' : '<span class="text-muted">-</span>'; } },
                { data: 'warehouse', render: function (v) { return srmEsc(v || '-'); } },
                { data: 'total' },
                { data: 'received', render: function (v) { return v ? '<span class="badge badge-success">@L.Js("Wh_StReceived")</span>' : '<span class="badge badge-warning">@L.Js("Wh_StPending")</span>'; } },
                { data: 'date' }
            ];
            @if (changePermit)
            {
                <text>
                columns.push({
                    data: null, orderable: false, render: function (v, t, r) {
                        var html = '<div class="d-flex"><a href="' + detailsUrl + r.id + '" class="btn btn-sm btn-icon btn-outline-primary mr-1" title="@L.Js("View")"><i class="bx bx-show"></i></a>';
                        if (r.canModify && !r.received) {
                            html += '<a href="' + editUrl + r.id + '" class="btn btn-sm btn-icon btn-outline-warning mr-1" title="@L.Js("Edit")"><i class="bx bx-edit-alt"></i></a>';
                        }
                        if (r.canModify) {
                            html += '<a href="' + deleteUrl + r.id + '" class="btn btn-sm btn-icon btn-outline-danger" title="@L.Js("Delete")"><i class="bx bx-trash"></i></a>';
                        }
                        return html + '</div>';
                    }
                });
                </text>
            }
            srmServerTable('#incomesTable', {
                dataUrl: '@Url.Action("IndexData", "Incomes")',
                exportUrl: '@Url.Action("ExportExcel", "Incomes")',
                filterForm: '#incomesFilter',
                order: [[5, 'desc']],
                columns: columns
            });
        });
    </script>
}
