@model List<tahsinERP.Models.INCOME>
@using System.Linq
@{
    ViewBag.Title = "Ombor kirimlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    bool changePermit = ViewBag.ChangePermit as bool? ?? false;
    var assignedWarehouseIds = ViewBag.AssignedWarehouseIds as List<int> ?? new List<int>();
    bool canCreate = changePermit && (ViewBag.CanCreateManualIncome as bool? ?? false);
}
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item active">
                                    Ombor kirimlari
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
            }
            <section class="invoice-list-wrapper">
                @if (canCreate)
                {
                    <div class="invoice-create-btn mb-1">
                        <a href="@Url.Action("Create", "Incomes")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                            <i class="bx bx-plus"></i> Yangi kirim
                        </a>
                    </div>
                }

                <div class="users-list-filter px-1">
                    @using (Html.BeginForm("Index", "Incomes", FormMethod.Get, new { @class = "form" }))
                    {
                        <div class="row border rounded py-2 mb-2">
                            <div class="col-12 col-sm-6 col-lg-3">
                                <label>Ombor</label>
                                @Html.DropDownList("warehouseId", ViewBag.Warehouses as SelectList, "Barchasi", new { @class = "form-control" })
                            </div>
                            <div class="col-12 col-sm-6 col-lg-3">
                                <label>Status</label>
                                <select name="status" class="form-control">
                                    <option value="">Barchasi</option>
                                    <option value="1" @(ViewBag.Status != null && (int)ViewBag.Status == 1 ? "selected" : "")>Qabul qilingan</option>
                                    <option value="0" @(ViewBag.Status != null && (int)ViewBag.Status == 0 ? "selected" : "")>Kutilmoqda</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bx bx-search"></i> Qidirish
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-md-12 col-sm-12">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="incomesTable" class="table table-striped table-bordered nowrap" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Hujjat raqami</th>
                                                <th>Invoys raqami</th>
                                                <th>Ombor</th>
                                                <th>Jami summa</th>
                                                <th>Status</th>
                                                <th>Sana</th>
                                                @if (changePermit)
                                                {
                                                    <th>Amallar</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model != null && Model.Any())
                                            {
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>
                                                            <a href="@Url.Action("Details", "Incomes", new { id = item.ID })">@item.DocNo</a>
                                                        </td>
                                                        <td>
                                                            @if (item.P_INVOICES != null)
                                                            {
                                                                <a href="@Url.Action("Details", "PInvoices", new { id = item.InvoiceID })">@item.P_INVOICES.InvoiceNo</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">-</span>
                                                            }
                                                        </td>
                                                        <td>@(item.Warehouse?.WHName ?? "-")</td>
                                                        <td>@(item.TotalPrice?.ToString("N2") ?? "0.00")</td>
                                                        <td>
                                                            @if (item.RecieveStatus == true)
                                                            {
                                                                <span class="badge badge-success">Qabul qilingan</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge badge-warning">Kutilmoqda</span>
                                                            }
                                                        </td>
                                                        <td>@item.IssueDateTime.ToString("dd.MM.yyyy")</td>
                                                        @if (changePermit)
                                                        {
                                                            bool canModify = assignedWarehouseIds.Contains(item.ReceivingWHID);
                                                            <td>
                                                                <div class="d-flex">
                                                                    <a href="@Url.Action("Details", "Incomes", new { id = item.ID })" class="btn btn-sm btn-icon btn-outline-primary mr-1" title="Ko'rish">
                                                                        <i class="bx bx-show"></i>
                                                                    </a>
                                                                    @if (canModify && item.RecieveStatus != true)
                                                                    {
                                                                        <a href="@Url.Action("Edit", "Incomes", new { id = item.ID })" class="btn btn-sm btn-icon btn-outline-warning mr-1" title="Tahrirlash">
                                                                            <i class="bx bx-edit-alt"></i>
                                                                        </a>
                                                                    }
                                                                    @if (canModify)
                                                                    {
                                                                        <a href="@Url.Action("Delete", "Incomes", new { id = item.ID })" class="btn btn-sm btn-icon btn-outline-danger" title="O'chirish" onclick="return confirm('Ushbu kirim hujjatini o\'chirishni tasdiqlaysizmi?');">
                                                                            <i class="bx bx-trash"></i>
                                                                        </a>
                                                                    }
                                                                </div>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#incomesTable').DataTable({
                "language": {
                    "search": "Qidirish:",
                    "lengthMenu": "_MENU_ ta ko'rsatish",
                    "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    "infoEmpty": "Yozuvlar yo'q",
                    "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                    "paginate": {
                        "first": "Birinchi",
                        "last": "Oxirgi",
                        "next": "Keyingi",
                        "previous": "Oldingi"
                    },
                    "zeroRecords": "Ma'lumot topilmadi"
                },
                "pageLength": 25,
                "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Barchasi"]],
                "order": [[3, "desc"]],
                "columnDefs": [
                    { "type": "date", "targets": 3 }
                ],
                "scrollX": true,
                dom: 'lBfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bx bxs-file-excel"></i> Excel',
                        titleAttr: 'Excelga yuklash',
                        className: 'btn btn-success mr-1',
                        filename: function () {
                            var now = new Date();
                            var dateStr = now.getFullYear() +
                                String(now.getMonth() + 1).padStart(2, '0') +
                                String(now.getDate()).padStart(2, '0') + '_' +
                                String(now.getHours()).padStart(2, '0') +
                                String(now.getMinutes()).padStart(2, '0') +
                                String(now.getSeconds()).padStart(2, '0');
                            return 'Ombor_kirimlari_' + dateStr;
                        },
                        exportOptions: {
                            columns: ':visible',
                            format: {
                                body: function (data, row, column, node) {
                                    return data.replace(/<[^>]*>/g, '').trim();
                                }
                            }
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bx bxs-file-pdf"></i> PDF',
                        titleAttr: 'PDFga yuklash',
                        className: 'btn btn-danger',
                        filename: function () {
                            var now = new Date();
                            var dateStr = now.getFullYear() +
                                String(now.getMonth() + 1).padStart(2, '0') +
                                String(now.getDate()).padStart(2, '0') + '_' +
                                String(now.getHours()).padStart(2, '0') +
                                String(now.getMinutes()).padStart(2, '0') +
                                String(now.getSeconds()).padStart(2, '0');
                            return 'Ombor_kirimlari_' + dateStr;
                        },
                        exportOptions: {
                            columns: ':visible',
                            format: {
                                body: function (data, row, column, node) {
                                    return data.replace(/<[^>]*>/g, '').trim();
                                }
                            }
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        title: 'Ombor kirimlari',
                        customize: function (doc) {
                            doc.defaultStyle.fontSize = 9;
                            doc.styles.tableHeader.fontSize = 10;
                        }
                    }
                ]
            });
        });
    </script>
    }
