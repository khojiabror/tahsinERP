@model tahsinERP.ViewModels.IncomeCreateViewModel
@using System.Collections.Generic
@{
    ViewBag.Title = L.T("Wh_Inc_CreateTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var unitsList = ViewBag.Units as SelectList;
    var unitsData = new List<object>();

    if (unitsList != null)
    {
        foreach (SelectListItem item in unitsList)
        {
            unitsData.Add(new { Value = item.Value, Text = item.Text });
        }
    }

    var requireDloc = ViewBag.RequireDloc == true;
    var dlocEnabled = ViewBag.DlocEnabled == true;
    var dlocLocationsJson = ViewBag.DlocLocationsJson as string ?? "[]";
    var defaultWhId = ViewBag.DefaultWarehouseId as int?;
    var dlocManageUrl = Url.Action("Index", "WarehouseLocations", new { warehouseId = defaultWhId });
    var dlocCreateUrl = Url.Action("Create", "WarehouseLocations", new { warehouseId = defaultWhId });
}

@* Ruxsat controller action'ida tekshiriladi (SRM-M05). *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/Incomes/Index">@L.T("Wh_IncListTitle")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Wh_NewIncome")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                @if (ViewBag.NoWarehouseError != null)
                {
                    <div class="alert alert-danger" style="font-size:1.1rem; font-weight:600;">
                        @ViewBag.NoWarehouseError
                    </div>
                }
                else
                {
                    <section id="form-repeater-wrapper">
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body">
                                            @using (Html.BeginForm("Create", "Incomes", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form", @id = "incomeForm" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                                <div class="row">
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label for="DocNo">@L.T("Wh_DocNo")</label>
                                                        @Html.TextBoxFor(model => model.DocNo, new { @class = "form-control", @placeholder = L.T("Wh_AutoGenerated") })
                                                        @Html.ValidationMessageFor(model => model.DocNo, "", new { @class = "text-danger" })
                                                        <small class="text-muted">@L.T("Wh_AutoGeneratedHint")</small>
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label for="IssueDateTime">@L.T("Wh_DateTime")</label>
                                                        @Html.TextBoxFor(model => model.IssueDateTime, "{0:yyyy-MM-ddTHH:mm}", new { @type = "datetime-local", @class = "form-control", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.IssueDateTime, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label for="InvoiceID">@L.T("Wh_Invoice")</label>
                                                        @Html.DropDownListFor(model => model.InvoiceID, ViewBag.Invoices as SelectList, L.T("Wh_SelectDashed"), new { @class = "form-control select2", @id = "invoiceSelect" })
                                                        @Html.ValidationMessageFor(model => model.InvoiceID, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <button type="button" class="btn btn-outline-primary mt-2" id="loadInvoiceBtn" style="display:none;">
                                                            <i class="bx bx-refresh"></i> @L.T("Wh_Inc_LoadInvoiceProducts")
                                                        </button>
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label for="ReceivingWHID">@L.T("Wh_ReceiverWarehouse")</label>
                                                        @Html.DropDownListFor(model => model.ReceivingWHID, ViewBag.Warehouses as SelectList, L.T("Wh_SelectDashed"), new { @class = "form-control select2", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.ReceivingWHID, "", new { @class = "text-danger" })
                                                    </div>
                                                    @if (dlocEnabled && requireDloc)
                                                    {
                                                        <div class="col-12">
                                                            <div class="alert alert-info py-1 px-2 mb-2 small">
                                                                @L.T("Wh_Inc_DlocRequiredHint")
                                                            </div>
                                                        </div>
                                                    }
                                                    else if (dlocEnabled)
                                                    {
                                                        <div class="col-12">
                                                            <div class="alert alert-warning py-1 px-2 mb-2 small">
                                                                @L.T("Wh_Inc_NoDlocYet")
                                                                <a href="@dlocCreateUrl" target="_blank">@L.T("Wh_Inc_CreateLocation")</a>
                                                                (@L.T("Wh_Inc_Or") <a href="@dlocManageUrl" target="_blank">@L.T("Wh_Inc_ListLink")</a>), @L.T("Wh_Inc_ThenRefresh")
                                                            </div>
                                                        </div>
                                                    }
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label for="CurrencyID">@L.T("Currency")</label>
                                                        @Html.DropDownListFor(model => model.CurrencyID, ViewBag.Currencies as SelectList, L.T("Wh_SelectDashed"), new { @class = "form-control select2", @required = "required" })
                                                        @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-6 col-12 form-group">
                                                        <label for="Description">@L.T("Comment")</label>
                                                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = "2" })
                                                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-6 col-12 form-group">
                                                        <label for="incomeFile">@L.T("Wh_Inc_DocPdf")</label>
                                                        <input type="file" name="incomeFile" id="incomeFile" class="form-control" accept=".pdf" />
                                                    </div>
                                                </div>

                                                <br />
                                                <h5>@L.T("Wh_Inc_Products")</h5>
                                                <p class="text-muted small mb-2">@L.T("Wh_VatHintInput")</p>
                                                if (dlocEnabled && requireDloc)
                                                {
                                                    <p class="text-muted small mb-2">@L.T("Wh_Inc_DlocCapacityHint")</p>
                                                }
                                                
                                                 <div class="table-responsive">
                                                    <table id="incomeProductsTable" class="table table-bordered">
                                                        <thead>
                                                            <tr>
                                                                <th>@L.T("Wh_Product")</th>
                                                                <th>@L.T("Wh_ProductName")</th>
                                                                @if (dlocEnabled)
                                                                {
                                                                    <th>DLOC @if (requireDloc) { <span class="text-danger">*</span> }</th>
                                                                    <th>@L.T("Wh_Inc_LocationCapacity")</th>
                                                                }
                                                                <th>@L.T("Quantity")</th>
                                                                <th>@L.T("Unit")</th>
                                                                <th>@L.T("Wh_UnitPrice")</th>
                                                                <th>@L.T("Wh_VatPct")</th>
                                                                <th>@L.T("Total")</th>
                                                                <th>@L.T("Comment")</th>
                                                                <th>@L.T("Actions")</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody></tbody>
                                                        <tfoot>
                                                            <tr>
                                                                <td colspan="@(dlocEnabled ? 8 : 6)" class="text-right"><strong>@L.T("Wh_TotalColon")</strong></td>
                                                                <td id="totalAmount" class="text-right"><strong>0.00</strong></td>
                                                                <td colspan="2"></td>
                                                            </tr>
                                                        </tfoot>
                                                    </table>
                                                </div>

                                                @Html.Partial("~/Views/Incomes/_DocFormActions.cshtml", "Incomes")
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>

    @section scripts {
        <script src="~/Scripts/srm/srm-doc-lines.js"></script>
        <script src="~/Scripts/srm/srm-doc-forms.js"></script>
        <script src="~/Scripts/app/indexed-rows.js"></script>
        <script src="~/Scripts/app/product-select.js"></script>
        <script>
            (function ($) {
                $(document).ready(function () {
                    $('.select2').select2();

                    var productRowIndex = 0;
                    var productSearchUrl = '@Url.Action("Search", "ProductLookup")';
                    var units = @Html.Raw(Json.Encode(unitsData));
                    var requireDloc = @(requireDloc ? "true" : "false");
                    var dlocEnabled = @(dlocEnabled ? "true" : "false");
                    var dlocLocations = @Html.Raw(dlocLocationsJson);
                    var dlocPutawayUrl = '@Url.Action("GetDlocPutawayInfo", "Incomes")';
                    var dlocCreateUrl = '@dlocCreateUrl';

                    $('#invoiceSelect').on('change', function () {
                        if ($(this).val()) {
                            $('#loadInvoiceBtn').show();
                        } else {
                            $('#loadInvoiceBtn').hide();
                        }
                    });

                    $('#loadInvoiceBtn').click(function () {
                        var invoiceId = $('#invoiceSelect').val();
                        if (!invoiceId) {
                            alert('@L.Js("Wh_Inc_SelectInvoice")');
                            return;
                        }

                        $.ajax({
                            url: '@Url.Action("LoadInvoiceProducts", "Incomes")',
                            type: 'POST',
                            data: { invoiceId: invoiceId },
                            success: function (response) {
                                if (response.success) {
                                    $('#incomeProductsTable tbody').empty();
                                    productRowIndex = 0;

                                    response.data.forEach(function (item) {
                                        var vr = typeof item.VATRate === 'number' ? item.VATRate : 0;
                                        addProductRow(item.ProductID, item.ProductPNo, item.ProductName,
                                                     item.Amount, item.UnitID, item.PiecePrice, item.TotalPrice, '', vr);
                                    });

                                    updateTotal();
                                    alert('@L.Js("Wh_Inc_InvoiceProductsLoaded")');
                                } else {
                                    alert('@L.Js("Wh_ErrorPrefix") ' + response.message);
                                }
                            },
                            error: function () {
                                alert('@L.Js("Wh_ServerErrorOccurred")');
                            }
                        });
                    });

                    $('#addRowBtn').click(function () {
                        addProductRow(null, '', '', 0, null, 0, 0, '', 0);
                    });

                    function escapeHtml(text) { return srmDocLines.escapeHtml(text); }

                    function buildProductOptions(selectedId, pno, name) { return srmIncomeForm.productOptions(selectedId, pno, name); }

                    function buildUnitOptions(selectedId) { return srmDocLines.unitOptions(units, selectedId); }

                    function buildDlocOptions(selectedId) { return srmIncomeForm.dlocOptions(dlocLocations, selectedId); }

                    function refreshDlocCapacity($row) {
                        if (!requireDloc) return;
                        var locId = $row.find('.dloc-select').val();
                        var amount = parseFloat($row.find('.amount-input').val()) || 0;
                        var $hint = $row.find('.dloc-capacity-hint');
                        if (!locId) {
                            $hint.removeClass('text-danger text-success').addClass('text-muted')
                                .text('@L.Js("Wh_SelectDloc")');
                            $row.data('dlocOk', false);
                            return;
                        }
                        $.get(dlocPutawayUrl, { locationId: locId, incomingQty: amount }, function (res) {
                            if (!res || !res.success) {
                                $hint.removeClass('text-success').addClass('text-danger')
                                    .text(res && res.message ? res.message : '@L.Js("Wh_NoDataReceived")');
                                $row.data('dlocOk', false);
                                return;
                            }
                            var txt = '@L.Js("Wh_Inc_CapCurrent") ' + Number(res.currentQty).toFixed(2) +
                                ' | Min: ' + Number(res.minCapacity).toFixed(2) +
                                ' | Max: ' + Number(res.maxCapacity).toFixed(2) +
                                ' | @L.Js("Wh_Inc_CapFree") ' + Number(res.availableQty).toFixed(2);
                            if (amount > 0) {
                                txt += ' | @L.Js("Wh_Inc_CapAfter") ' + Number(res.afterQty).toFixed(2);
                            }
                            $hint.removeClass('text-muted text-danger text-success');
                            if (res.isOk) {
                                $hint.addClass('text-success').text(txt);
                                $row.data('dlocOk', true);
                            } else {
                                $hint.addClass('text-danger').text((res.message || txt) + ' — @L.Js("Wh_Inc_IncomeNotPossible")');
                                $row.data('dlocOk', false);
                            }
                        }).fail(function () {
                            $hint.removeClass('text-success').addClass('text-danger').text('@L.Js("Wh_ServerError")');
                            $row.data('dlocOk', false);
                        });
                    }

                    function syncProductFields($row) { srmIncomeForm.syncProduct($row); }

                    function recalcRow($row) { srmIncomeForm.recalcRow($row); }

                    function addProductRow(productId, productPNo, productName, amount, unitId, piecePrice, totalPrice, comment, vatRate, locationId) {
                        var vr = typeof vatRate === 'number' && !isNaN(vatRate) ? vatRate : 0;
                        var merged = comment || '';
                        var dlocCols = '';
                        if (dlocEnabled) {
                            if (requireDloc) {
                                dlocCols =
                                    '<td><select name="IncomeProducts[' + productRowIndex + '].LocationID" class="form-control dloc-select select2" required>' +
                                        buildDlocOptions(locationId) +
                                    '</select></td>' +
                                    '<td class="small"><span class="dloc-capacity-hint text-muted">@L.Js("Wh_SelectDloc")</span></td>';
                            } else {
                                dlocCols =
                                    '<td class="small">' +
                                        '<select class="form-control" disabled><option>@L.Js("Wh_Inc_NoLocation")</option></select>' +
                                        '<a href="' + dlocCreateUrl + '" target="_blank" class="d-block mt-1">+ @L.Js("Wh_Inc_CreatePlace")</a>' +
                                    '</td>' +
                                    '<td class="small text-warning">@L.Js("Wh_Inc_CreateDlocFirst")</td>';
                            }
                        }
                        var row = '<tr data-row-index="' + productRowIndex + '">' +
                            '<td>' +
                                '<select name="IncomeProducts[' + productRowIndex + '].ProductID" class="form-control product-select select2" required>' +
                                    buildProductOptions(productId, productPNo, productName) +
                                '</select>' +
                                '<input type="hidden" name="IncomeProducts[' + productRowIndex + '].ProductPNo" class="product-pno" value="' + escapeHtml(productPNo || '') + '" />' +
                            '</td>' +
                            '<td>' +
                                '<input type="text" class="form-control product-name-display" value="' + escapeHtml(productName || '') + '" disabled />' +
                                '<input type="hidden" name="IncomeProducts[' + productRowIndex + '].ProductName" class="product-name" value="' + escapeHtml(productName || '') + '" />' +
                            '</td>' +
                            dlocCols +
                            '<td><input type="number" name="IncomeProducts[' + productRowIndex + '].Amount" class="form-control amount-input" value="' + (amount || 0) + '" step="0.01" min="0" required /></td>' +
                            '<td>' +
                                '<select name="IncomeProducts[' + productRowIndex + '].UnitID" class="form-control unit-select select2" required>' +
                                    buildUnitOptions(unitId) +
                                '</select>' +
                            '</td>' +
                            '<td><input type="number" name="IncomeProducts[' + productRowIndex + '].PiecePrice" class="form-control price-input" value="' + (piecePrice || 0) + '" step="0.01" min="0" /></td>' +
                            '<td><input type="number" name="IncomeProducts[' + productRowIndex + '].VATRate" class="form-control vat-input" value="' + vr + '" step="0.01" min="0" max="100" /></td>' +
                            '<td><input type="number" name="IncomeProducts[' + productRowIndex + '].TotalPrice" class="form-control total-price" value="' + (totalPrice || 0) + '" readonly /></td>' +
                            '<td><input type="text" name="IncomeProducts[' + productRowIndex + '].Comment" class="form-control comment-input" value="' + escapeHtml(merged) + '" /></td>' +
                            '<td><button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button></td>' +
                            '</tr>';

                        $('#incomeProductsTable tbody').append(row);
                        var $row = $('#incomeProductsTable tbody tr').last();

                        if (typeof $.fn.select2 !== 'undefined') {
                            ProductSelect.attach($row.find('select.product-select'), productSearchUrl);
                            $row.find('select.unit-select').select2();
                            if (dlocEnabled && requireDloc) {
                                $row.find('select.dloc-select').select2();
                            }
                        }

                        syncProductFields($row);
                        recalcRow($row);
                        if (requireDloc && locationId) {
                            refreshDlocCapacity($row);
                        }
                        productRowIndex++;
                    }

                    $(document).on('click', '.remove-row', function () {
                        $(this).closest('tr').remove();
                        updateTotal();
                    });

                    $(document).on('change', '.product-select', function () {
                        var $row = $(this).closest('tr');
                        syncProductFields($row);
                    });

                    $(document).on('input', '.amount-input, .price-input, .vat-input', function () {
                        var $row = $(this).closest('tr');
                        recalcRow($row);
                        updateTotal();
                        if (requireDloc && $(this).hasClass('amount-input')) {
                            refreshDlocCapacity($row);
                        }
                    });

                    $(document).on('change', '.dloc-select', function () {
                        refreshDlocCapacity($(this).closest('tr'));
                    });

                    function updateTotal() { srmDocLines.updateTotal(); }

                    $('#incomeForm').submit(function (e) {
                        if ($('#incomeProductsTable tbody tr').length === 0) {
                            e.preventDefault();
                            alert('@L.Js("Wh_NeedOneProduct")');
                            return false;
                        }
                        if (requireDloc) {
                            var invalid = false;
                            $('#incomeProductsTable tbody tr').each(function () {
                                var $row = $(this);
                                var locId = $row.find('.dloc-select').val();
                                if (!locId) {
                                    invalid = true;
                                    alert('@L.Js("Wh_Inc_DlocPerProduct")');
                                    return false;
                                }
                                if ($row.data('dlocOk') === false) {
                                    invalid = true;
                                    alert('@L.Js("Wh_Inc_DlocOverCapacity")');
                                    return false;
                                }
                            });
                            if (invalid) {
                                e.preventDefault();
                                return false;
                            }
                        }
                    });
                });
            })(jQuery);
        </script>
    }
}
