@model tahsinERP.Models.UNIT
@{
    ViewBag.Title = L.T("Prd_AddUnitTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    using (Html.BeginForm("Create", "UNIT", FormMethod.Post, new { enctype = "multipart/form-data" }))  // Ensure enctype is set
    {
        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="~/UNIT/Index">@L.T("Menu_Units")</a>
                                        </li>
                                        <li class="breadcrumb-item active">
                                            @L.T("Prd_AddNewUnit")
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="basic-select2">
                        <div class="row">
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="card-body pb-0 mx-25">
                                            <div class="row">
                                                <div class="col-lg-12 col-md-6 mt-25">
                                                    @Html.AntiForgeryToken()
                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                    <hr>
                                                    <h6 class="invoice-to">@L.T("Name"):</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.UnitName, new { @class = "form-control round", @placeholder = L.T("Prd_EnterUnitName") })
                                                        @Html.ValidationMessageFor(model => model.UnitName, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Prd_ShortName"):</h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.ShortName, new { @class = "form-control round", @placeholder = L.T("Prd_EnterShortName") })
                                                        @Html.ValidationMessageFor(model => model.ShortName, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <h6 class="invoice-to">@L.T("Prd_CodeOf"):<i class='bx bx-info-circle' data-toggle="tooltip" data-placement="right" title="@L.T("Prd_UnitCustomsCodeHint")"></i></h6>
                                                    <fieldset class="invoice-address form-group">
                                                        @Html.TextBoxFor(model => model.Code, new { @class = "form-control round", @placeholder = L.T("Prd_EnterCode") })
                                                        @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger" })
                                                    </fieldset>
                                                    <ul class="list-group list-group-flush">
                                                        <li class="list-group-item border-0 pb-0">
                                                            <button class="btn btn-primary btn-block subtotal-preview-btn" name="create" type="submit" value="Create">
                                                                <i class='bx bx-save'></i>
                                                                @L.T("Save")
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                            <hr>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
