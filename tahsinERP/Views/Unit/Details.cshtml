@model tahsinERP.Models.UNIT

@{
    ViewBag.Title = "Batafsil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/UNIT/Index">O'lchov birliklari</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Batafsil sahifasi
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-xl-12 col-md-12 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body pb-0 mx-25">
                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 mt-25">
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <h4 class="text-primary">Birlik ma'lumotlari</h4>
                                            <hr>

                                            <div class="row my-2 py-50">
                                                <div class="col-sm-12 col-12 order-2 order-sm-1">
                                                    @Html.AntiForgeryToken()
                                                    <hr />
                                                    <span><b>Nomi</b>: @Html.DisplayFor(model => model.UnitName, new { @class = "form-control" })</span>
                                                    <br />
                                                    <span><b>Qisqa Nomi</b>: @Html.DisplayFor(model => model.ShortName, new { @class = "form-control" })</span>
                                                    <br />
                                                    <span><b>Kodi<i class='bx bx-info-circle' data-toggle="tooltip" data-placement="right" title="Bojxona tizimidagi o'lchov birliklari kodi"></i></b>: @Html.DisplayFor(model => model.Code, new { @class = "form-control" })</span>
                                                    <hr />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <hr>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
