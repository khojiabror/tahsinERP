@model IEnumerable<dynamic>
@{
    ViewBag.Title = "NORM Kesish Variantlari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <h5 class="content-header-title float-left pr-1 mb-0">NORM Kesish Variantlari</h5>
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb p-0 mb-0">
                                    <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                                    <li class="breadcrumb-item active">NORM Kesish</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Edit", "NormCutting")" class="btn btn-success">
                                <i class="bx bx-plus"></i> Yangi NORM qo'shish
                            </a>
                        </div>
                    }

                    <div class="users-list-filter px-1 mb-2">
                        <form method="get" action="@Url.Action("Index", "NormCutting")">
                            <div class="row border rounded py-2">
                                <div class="col-12 col-sm-6 col-lg-4">
                                    <label for="productId">Mahsulot</label>
                                    <fieldset class="form-group">
                                        @Html.DropDownList("productId", ViewBag.Products as SelectList, "Barcha mahsulotlar", new { @class = "form-control", @id = "productId" })
                                    </fieldset>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-4 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-search"></i> Qidirish
                                    </button>
                                    <a href="@Url.Action("Index", "NormCutting")" class="btn btn-secondary ml-2">
                                        <i class="bx bx-refresh"></i> Tozalash
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-bordered table-hover" id="normTable">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th>Mahsulot raqami</th>
                                                    <th>Mahsulot nomi</th>
                                                    <th>Oy</th>
                                                    <th>Samarali sanadan</th>
                                                    <th>Samarali sanagacha</th>
                                                    <th>Izoh</th>
                                                    <th>Variantlar soni</th>
                                                    <th class="text-center">Amallar</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@item.ProductCode</td>
                                                            <td>@item.ProductName</td>
                                                            <td>@item.Period</td>
                                                            <td>@(item.EffectiveFrom?.ToString("yyyy-MM-dd") ?? "-")</td>
                                                            <td>@(item.EffectiveTo?.ToString("yyyy-MM-dd") ?? "-")</td>
                                                            <td>@(item.Comment ?? "-")</td>
                                                            <td>@item.LineCount</td>
                                                            <td class="text-center">
                                                                <a href="@Url.Action("Edit", "NormCutting", new { normVersionId = item.NormVersionID })" class="btn btn-sm btn-outline-primary" title="Tahrirlash">
                                                                    <i class="bx bx-edit"></i>
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="8" class="text-center text-muted">Ma'lumotlar topilmadi</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $('#normTable').DataTable({
                "language": {
                    "search": "Qidirish:",
                    "lengthMenu": "_MENU_ ta ko'rsatish",
                    "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    "infoEmpty": "Yozuvlar yo'q",
                    "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                    "paginate": {
                        "first": "Birinchi",
                        "last": "Oxirgi",
                        "next": "Keyingi",
                        "previous": "Oldingi"
                    },
                    "zeroRecords": "Ma'lumot topilmadi"
                },
                "pageLength": 25,
                "order": [[2, "desc"]]
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}

