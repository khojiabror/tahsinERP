@model tahsinERP.ViewModels.PContractSViewModel
@{
    ViewBag.Title = "CreateSteel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    /* Hide the default file input */
    .custom-file-input {
        display: none;
    }

    /* Style the custom button */
    .custom-file-button {
        display: inline-block;
        padding: 10px 20px;
        font-size: 16px;
        color: #fff;
        background-color: #007bff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        text-align: center;
    }

        /* Optional: Change button color on hover */
        .custom-file-button:hover {
            background-color: #0056b3;
        }
</style>
@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "PContract"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/PContract/Index">Shartnomalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Shartnoma yaratish
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("CreateSteel", "PContract", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form repeater-default" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            // WRHS_InComes
                                            <div class="row justify-content-around d-flex align-items-start">
                                                @*Left Part*@
                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Shartnoma raqami:</h6>
                                                            @Html.TextBoxFor(model => model.ContractNo, new { @type = "text", @class = "form-control", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Ta'minotchi:</h6>
                                                            @Html.DropDownListFor(model => model.SupplierID, (SelectList)ViewBag.Supplier, new { @class = "form-control select2", @id = "supplierDropdown" })
                                                            @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Valyuta<i class='bx bx-info-circle' data-toggle="tooltip" data-placement="right" title="Valyuta ma'lumotlarini sozlamalardan o'zgartiring"></i>:</h6>
                                                            @Html.DropDownListFor(model => model.CurrencyID, ViewBag.currencies as SelectList, new { @class = "form-control select2" })
                                                            @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">IDN raqami:</h6>
                                                            @Html.TextBoxFor(model => model.IDN, new { @type = "number", @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.IDN, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>

                                                @*Right Part*@
                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">Incoterms:</h6>
                                                            @Html.TextBoxFor(model => model.Incoterms, new { @type = "text", @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Incoterms, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <h6 class="invoice-to">To'lov sharti:</h6>
                                                            @Html.TextBoxFor(model => model.PaymentTerms, new { @type = "text", @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.PaymentTerms, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group position-relative has-icon-left">
                                                            <label for="dateInput">Tuzilgan sanasi:</label>
                                                            @Html.TextBoxFor(model => model.IssuedDate, new { @class = "form-control", @id = "dateInputIssued", @name = "Date", @placeholder = "Tuzilgan sanasi" })
                                                            @Html.ValidationMessageFor(model => model.IssuedDate, "", new { @class = "text-danger" })
                                                            <div class="form-control-position mt-2">
                                                                <i class='bx bx-calendar'></i>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group position-relative has-icon-left">
                                                            <label for="dateInput">Tugaydigan sanasi:</label>
                                                            @Html.TextBoxFor(model => model.DueDate, new { @class = "form-control", @id = "dateInputDue", @name = "Date", @placeholder = "Tuzilgan sanasi" })
                                                            @Html.ValidationMessageFor(model => model.DueDate, "", new { @class = "text-danger" })
                                                            <div class="form-control-position mt-2">
                                                                <i class='bx bx-calendar'></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <br />
                                            </div>
                                            <div class="col-md-6 col-12 form-group">
                                                <hr />
                                                <h6>Shartnoma fayli(PDF)ni yuklang</h6>
                                                @Html.TextBoxFor(model => model.File, new { type = "file", @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.File, "", new { @class = "text-danger" })
                                                <hr />
                                            </div>
                                            <br />
                                            <h4>Ehtiyot qismlar</h4>
                                            <div data-repeater-list="Parts">
                                                <div data-repeater-item id="repeaterItem">
                                                    <div class="row justify-content-between">
                                                        <input type="hidden" name="ID" />
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Marka">Marka</label>
                                                            @Html.DropDownList("Marka", (SelectList)ViewBag.steelMarka, new { @class = "form-control select" })
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Marka, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Standart">Specification</label>
                                                            @Html.DropDownList("Standart", (SelectList)ViewBag.steelStandart, new { @class = "form-control select" })
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Standart, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Coating">Coating</label>
                                                            @Html.DropDownList("Coating", (SelectList)ViewBag.steelCoating, new { @class = "form-control select" })
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Coating, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Unit">Thickness</label>
                                                            @Html.DropDownList("Thickness", (SelectList)ViewBag.steelThickness, new { @class = "form-control select" })
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Thickness, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_width">Width</label>
                                                            <input type="number" name="Width" class="form-control" id="Part_Amount" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Width, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Unit">O'lchov birligi<i class='bx bx-info-circle' data-toggle="tooltip" data-placement="right" title="O'lchov birligi ma'lumotlarini sozlamalardan o'zgartiring"></i></label>
                                                            @Html.DropDownList("UnitID", (SelectList)ViewBag.units, new { @class = "form-control select" })
                                                            @Html.ValidationMessageFor(model => model.Parts[0].UnitID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <h6 for="Part_Quantity">Miqdori</h6>
                                                            <input type="text" name="Quantity" class="form-control Part_Quantity" id="Part_Quantity"
                                                                   placeholder="misol: 0.01"
                                                                   oninput="this.value = this.value.replace(',', '.');" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Quantity, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <h6 for="Part_Price">Narx</h6>
                                                            <input type="text" name="Price" class="form-control Part_Price" id="Part_Price"
                                                                   placeholder="misol: 0.01"
                                                                   oninput="this.value = this.value.replace(',', '.');" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].Price, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_TotalPrice">Umumiy Narxi</label>
                                                            <input type="number" name="Price" step="0.1" class="form-control Part_TotalPrice" id="Part_TotalPrice" disabled="disabled" />
                                                            @Html.ValidationMessageFor(model => model.Parts[0].TotalPrice, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label for="Part_Unit">HSCODE</label>
                                                            @Html.DropDownList("HscodeID", (SelectList)ViewBag.hscodes, new { @class = "form-control select" })
                                                            @Html.ValidationMessageFor(model => model.Parts[0].HsCodeID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group d-flex align-items-center pt-2">
                                                            <button data-repeater-delete type="button" class="btn btn-danger">O'chirish</button>
                                                        </div>
                                                    </div>
                                                    <hr>
                                                </div>
                                            </div>
                                            <button data-repeater-create type="button" class="btn btn-primary">Yangi qism qo'shish</button>
                                            // Save button
                                            <ul class="list-group list-group-flush">
                                                <li class="list-group-item border-0 pb-0">
                                                    <button class="btn btn-primary btn-block subtotal-preview-btn" name="create" type="submit" value="Create">
                                                        <i class='bx bx-save'></i>
                                                        Saqlash
                                                    </button>
                                                </li>
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
6<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Initialize flatpickr for the first calendar (Issued Date)
        flatpickr("#dateInputIssued", {
            dateFormat: "d.m.Y",  // Ensures the format will be day.month.year
            altInput: true,  // Optional: creates an alternate input for better UX
            altFormat: "F j, Y",  // Format displayed in alt input
            weekNumbers: true,  // Optional: display week numbers in the calendar
            locale: "en",  // Set locale to English to avoid confusion with date formats
            onChange: function (selectedDates, dateStr, instance) {
                // Format the date to Y-m-d when it's selected
                const formattedDate = flatpickr.formatDate(selectedDates[0], "Y-m-d");
                document.getElementById("dateInputIssued").value = formattedDate;  // Update the input field with the formatted date
            }
        });

        // Initialize flatpickr for the second calendar (Due Date)
        flatpickr("#dateInputDue", {
            dateFormat: "d.m.Y",  // Ensures the format will be day.month.year
            altInput: true,  // Optional: creates an alternate input for better UX
            altFormat: "F j, Y",  // Format displayed in alt input
            weekNumbers: true,  // Optional: display week numbers in the calendar
            locale: "en",  // Set locale to English to avoid confusion with date formats
            onChange: function (selectedDates, dateStr, instance) {
                // Format the date to Y-m-d when it's selected
                const formattedDate = flatpickr.formatDate(selectedDates[0], "Y-m-d");
                document.getElementById("dateInputDue").value = formattedDate;  // Update the input field with the formatted date
            }
        });
    });
</script>
<script>
    document.addEventListener('input', function (event) {
        if (event.target.matches('.Part_Price') || event.target.matches('.Part_Quantity')) {
            // Find the row of the input field
            const row = event.target.closest('[data-repeater-item]');

            // Get the price and quantity inputs within the same row
            const priceInput = row.querySelector('.Part_Price');
            const quantityInput = row.querySelector('.Part_Quantity');
            const totalPriceInput = row.querySelector('.Part_TotalPrice');

            // Parse the values as numbers and calculate the total price
            const price = parseFloat(priceInput.value) || 0;
            const quantity = parseFloat(quantityInput.value) || 0;
            const totalPrice = price * quantity;

            // Update the TotalPrice field
            totalPriceInput.value = totalPrice.toFixed(6); // Adjust decimal places as needed
        }
    });
</script>