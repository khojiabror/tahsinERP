@model tahsinERP.ViewModels.SContractViewModel
@using System.Collections.Generic
@{
    ViewBag.Title = L.T("Create");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var productsList = ViewBag.Products as SelectList;
    var unitsList = ViewBag.Units as SelectList;
    var productsData = new List<object>();
    var unitsData = new List<object>();

    if (productsList != null)
    {
        foreach (SelectListItem item in productsList)
        {
            productsData.Add(new { Value = item.Value, Text = item.Text });
        }
    }

    if (unitsList != null)
    {
        foreach (SelectListItem item in unitsList)
        {
            unitsData.Add(new { Value = item.Value, Text = item.Text });
        }
    }
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SContract/Index">@L.T("Menu_Contracts")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Crm_CtrCreate")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Create", "SContract", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form", @id = "contractForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row">
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="ContractNo">@L.T("Crm_ContractNo")</label>
                                                    @Html.TextBoxFor(model => model.ContractNo, new { @class = "form-control", @required = "required", @placeholder = L.T("Crm_CtrNoEnter") })
                                                    @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="IssuedDate">@L.T("Date")</label>
                                                    @Html.TextBoxFor(model => model.IssuedDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.IssuedDate, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="CustomerID">@L.T("Crm_Client")</label>
                                                    @Html.DropDownListFor(model => model.CustomerID, (SelectList)ViewBag.CustomerID, L.T("SelectPlaceholder"), new { @class = "form-control select2", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.CustomerID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="CurrencyID">@L.T("Currency")</label>
                                                    @Html.DropDownListFor(model => model.CurrencyID, ViewBag.currencies as SelectList, L.T("SelectPlaceholder"), new { @class = "form-control select2", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="DueDate">@L.T("Crm_DueDate")</label>
                                                    @Html.TextBoxFor(model => model.DueDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.DueDate, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="Incoterms">Incoterms</label>
                                                    @Html.TextBoxFor(model => model.Incoterms, new { @class = "form-control" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="PaymentTerms">@L.T("Crm_CtrPaymentTerms")</label>
                                                    @Html.TextBoxFor(model => model.PaymentTerms, new { @class = "form-control" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="PaymentDays">@L.T("Crm_CtrPaymentDays")</label>
                                                    @Html.TextBoxFor(model => model.PaymentDays, new { @type = "number", @min = "0", @max = "3650", @step = "1", @class = "form-control", @placeholder = L.T("Crm_CtrEg30") })
                                                    @Html.ValidationMessageFor(model => model.PaymentDays, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="Amount">@L.T("Crm_TotalAmount")</label>
                                                    @Html.TextBoxFor(model => model.Amount, new { @type = "number", @class = "form-control", @id = "Amount", @readonly = "readonly", @placeholder = L.T("Crm_CtrAutoCalc") })
                                                </div>
                                            </div>

                                            <br />
                                            <h5>@L.T("Crm_ContractProducts")</h5>

                                            <div class="table-responsive">
                                                <table id="contractProductsTable" class="table table-bordered doc-lines">
                                                    <thead>
                                                        <tr>
                                                            <th>@L.T("Crm_Product")</th>
                                                            <th>@L.T("Quantity")</th>
                                                            <th>@L.T("Unit")</th>
                                                            <th>@L.T("Price")</th>
                                                            <th>@L.T("Crm_CtrVatPct")</th>
                                                            <th>@L.T("Crm_CtrTotalPrice")</th>
                                                            <th>@L.T("Actions")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="5" class="text-right"><strong>@L.T("Total"):</strong></td>
                                                            <td id="totalAmount" class="text-right"><strong>0</strong></td>
                                                            <td></td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>

                                            <div class="row mt-2">
                                                <div class="col-12">
                                                    <button type="button" class="btn btn-outline-primary" id="addRowBtn">
                                                        <i class="bx bx-plus"></i> @L.T("Add")
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-12">
                                                    <button type="submit" class="btn btn-success">
                                                        <i class="bx bx-save"></i> @L.T("Save")
                                                    </button>
                                                    <a href="@Url.Action("Index", "SContract")" class="btn btn-secondary">
                                                        <i class="bx bx-x"></i> @L.T("Cancel")
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script type="application/json" id="contractProductsConfig">@Html.Raw(Json.Encode(new
    {
        mode = "create",
        products = productsData,
        units = unitsData,
        initialRows = (Model.ProductList ?? new List<tahsinERP.ViewModels.SContractProductViewModel>())
            .Select(p => new { p.ProductID, p.Amount, p.UnitID, p.PiecePrice, p.VatPercent })
    }))</script>
    <script src="@Url.Content("~/Scripts/app/indexed-rows.js")"></script>
    <script src="@Url.Content("~/Scripts/app/product-select.js")"></script>
    <script src="@Url.Content("~/Scripts/crm/contract-products.js")"></script>
}
