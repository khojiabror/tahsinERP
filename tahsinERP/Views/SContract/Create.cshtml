@model tahsinERP.ViewModels.SContractViewModel
@using System.Collections.Generic
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var productsList = ViewBag.Products as SelectList;
    var unitsList = ViewBag.Units as SelectList;
    var productsData = new List<object>();
    var unitsData = new List<object>();

    if (productsList != null)
    {
        foreach (SelectListItem item in productsList)
        {
            productsData.Add(new { Value = item.Value, Text = item.Text });
        }
    }

    if (unitsList != null)
    {
        foreach (SelectListItem item in unitsList)
        {
            unitsData.Add(new { Value = item.Value, Text = item.Text });
        }
    }
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "SContract"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SContract/Index">Shartnomalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Shartnoma yaratish
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Create", "SContract", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form", @id = "contractForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row">
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="ContractNo">Shartnoma raqami</label>
                                                    @Html.TextBoxFor(model => model.ContractNo, new { @class = "form-control", @required = "required", @placeholder = "Shartnoma raqamini kiriting" })
                                                    @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="IssuedDate">Sana</label>
                                                    @Html.TextBoxFor(model => model.IssuedDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.IssuedDate, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="CustomerID">Mijoz</label>
                                                    @Html.DropDownListFor(model => model.CustomerID, (SelectList)ViewBag.CustomerID, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.CustomerID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="CurrencyID">Valyuta</label>
                                                    @Html.DropDownListFor(model => model.CurrencyID, ViewBag.currencies as SelectList, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="DueDate">Muddat</label>
                                                    @Html.TextBoxFor(model => model.DueDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @required = "required" })
                                                    @Html.ValidationMessageFor(model => model.DueDate, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="Incoterms">Incoterms</label>
                                                    @Html.TextBoxFor(model => model.Incoterms, new { @class = "form-control" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="PaymentTerms">To'lov shartlari</label>
                                                    @Html.TextBoxFor(model => model.PaymentTerms, new { @class = "form-control" })
                                                </div>
                                                <div class="col-md-3 col-12 form-group">
                                                    <label for="Amount">Jami summa</label>
                                                    @Html.TextBoxFor(model => model.Amount, new { @type = "number", @class = "form-control", @id = "Amount", @readonly = "readonly", @placeholder = "Avtomatik hisoblanadi" })
                                                </div>
                                            </div>

                                            <br />
                                            <h5>Shartnoma mahsulotlari</h5>

                                            <div class="table-responsive">
                                                <table id="contractProductsTable" class="table table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>Mahsulot</th>
                                                            <th>Miqdor</th>
                                                            <th>Birlik</th>
                                                            <th>Narx</th>
                                                            <th>QQS (%)</th>
                                                            <th>Jami narx</th>
                                                            <th>Amallar</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="5" class="text-right"><strong>Jami:</strong></td>
                                                            <td id="totalAmount" class="text-right"><strong>0</strong></td>
                                                            <td></td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>

                                            <div class="row mt-2">
                                                <div class="col-12">
                                                    <button type="button" class="btn btn-outline-primary" id="addRowBtn">
                                                        <i class="bx bx-plus"></i> Qo'shish
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-12">
                                                    <button type="submit" class="btn btn-success">
                                                        <i class="bx bx-save"></i> Saqlash
                                                    </button>
                                                    <a href="@Url.Action("Index", "SContract")" class="btn btn-secondary">
                                                        <i class="bx bx-x"></i> Bekor qilish
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        (function () {
            function initContractProducts() {
                if (typeof jQuery === 'undefined') {
                    setTimeout(initContractProducts, 100);
                    return;
                }

                var $ = jQuery;

                $(document).ready(function () {
                    if (typeof $.fn.select2 !== 'undefined') {
                        $('.select2').select2();
                    }

                    var productRowIndex = 0;
                    var products = @Html.Raw(Json.Encode(productsData));
                    var units = @Html.Raw(Json.Encode(unitsData));

                    $(document).on('click', '#addRowBtn', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        addProductRow(null, 0, null, 0, 0);
                        return false;
                    });

                    function addProductRow(productId, quantity, unitId, price, vatPercent) {
                        var row = '<tr data-row-index="' + productRowIndex + '">' +
                            '<td>' +
                                '<select name="ProductList[' + productRowIndex + '].ProductID" class="form-control product-select select2" required>' +
                                '<option value="">---Tanlang---</option>';

                        products.forEach(function (product) {
                            var selected = product.Value == productId ? 'selected' : '';
                            row += '<option value="' + product.Value + '" ' + selected + '>' + product.Text + '</option>';
                        });

                        row += '</select>' +
                            '<input type="hidden" name="ProductList[' + productRowIndex + '].ID" value="0" />' +
                            '</td>' +
                            '<td><input type="number" name="ProductList[' + productRowIndex + '].Amount" class="form-control quantity-input" value="' + (quantity || 0) + '" step="1" min="1" required /></td>' +
                            '<td>' +
                                '<select name="ProductList[' + productRowIndex + '].UnitID" class="form-control unit-select select2" required>' +
                                '<option value="">---Tanlang---</option>';

                        units.forEach(function (unit) {
                            var selected = unit.Value == unitId ? 'selected' : '';
                            row += '<option value="' + unit.Value + '" ' + selected + '>' + unit.Text + '</option>';
                        });

                        row += '</select></td>' +
                            '<td><input type="number" name="ProductList[' + productRowIndex + '].PiecePrice" class="form-control price-input" value="' + (price || 0) + '" step="0.01" min="0" required /></td>' +
                            '<td><input type="number" name="ProductList[' + productRowIndex + '].VatPercent" class="form-control vat-input" value="' + (vatPercent || 12) + '" step="0.01" min="0" max="100" /></td>' +
                            '<td><input type="number" class="form-control total-with-vat" value="0" readonly /></td>' +
                            '<td><button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button></td>' +
                            '</tr>';

                        $('#contractProductsTable tbody').append(row);

                        if (typeof $.fn.select2 !== 'undefined') {
                            $('select.product-select.select2').last().select2();
                            $('select.unit-select.select2').last().select2();
                        }

                        productRowIndex++;
                        updateRowTotal($('#contractProductsTable tbody tr').last());
                        updateTotal();
                    }

                    function updateRowTotal($row) {
                        var quantity = parseFloat($row.find('.quantity-input').val()) || 0;
                        var price = parseFloat($row.find('.price-input').val()) || 0;
                        var vatPercent = parseFloat($row.find('.vat-input').val()) || 0;
                        var baseTotal = quantity * price;
                        var totalWithVat = baseTotal + (baseTotal * vatPercent / 100);
                        $row.find('.total-with-vat').val(totalWithVat.toFixed(2));
                    }

                    function updateTotal() {
                        var total = 0;
                        $('.total-with-vat').each(function () {
                            total += parseFloat($(this).val()) || 0;
                        });
                        $('#totalAmount').text(total.toFixed(2));
                        $('#Amount').val(Math.round(total));
                    }

                    function reindexRows() {
                        $('#contractProductsTable tbody tr').each(function (index) {
                            $(this).attr('data-row-index', index);
                            $(this).find('select, input').each(function () {
                                var name = $(this).attr('name');
                                if (name) {
                                    name = name.replace(/\[(\d+)\]/, '[' + index + ']');
                                    $(this).attr('name', name);
                                }
                            });
                        });
                        productRowIndex = $('#contractProductsTable tbody tr').length;
                    }

                    $(document).on('click', '.remove-row', function () {
                        $(this).closest('tr').remove();
                        reindexRows();
                        updateTotal();
                    });

                    $(document).on('input', '.quantity-input, .price-input, .vat-input', function () {
                        var $row = $(this).closest('tr');
                        updateRowTotal($row);
                        updateTotal();
                    });

                    $('#contractForm').submit(function (e) {
                        reindexRows();
                        if ($('#contractProductsTable tbody tr').length === 0) {
                            e.preventDefault();
                            alert('Kamida bitta mahsulot qo\'shilishi kerak');
                            return false;
                        }
                    });
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initContractProducts);
            } else {
                initContractProducts();
            }
        })();
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
