@model tahsinERP.ViewModels.SContractViewModel
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "SContract"))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SContract/Index">Shartnomalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Shartnoma yaratish
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <section id="form-repeater-wrapper">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        @using (Html.BeginForm("Create", "SContract", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form repeater-default" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row justify-content-around d-flex align-items-start">
                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="ContractNo">Shartnoma raqami</label>
                                                            @Html.TextBoxFor(model => model.ContractNo, new { @type = "text", @class = "form-control", @required = "required", @placeholder = "Shartnoma raqamini kiriting" })
                                                            @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="CustomerID">Mijoz</label>
                                                            @Html.DropDownListFor(model => model.CustomerID, (SelectList)ViewBag.CustomerID, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.CustomerID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="CurrencyID">Valyuta</label>
                                                            @Html.DropDownListFor(model => model.CurrencyID, ViewBag.currencies as SelectList, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="Amount">Jami summa</label>
                                                            @Html.TextBoxFor(model => model.Amount, new { @type = "number", @class = "form-control", @id = "Amount", @readonly = "readonly", @placeholder = "Avtomatik hisoblanadi" })
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-lg-6 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="Incoterms">Incoterms</label>
                                                            @Html.TextBoxFor(model => model.Incoterms, new { @type = "text", @class = "form-control", @placeholder = "Incoterms shartlarini kiriting" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group">
                                                            <label for="PaymentTerms">To'lov shartlari</label>
                                                            @Html.TextBoxFor(model => model.PaymentTerms, new { @type = "text", @class = "form-control", @placeholder = "To'lov shartlarini kiriting" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group position-relative has-icon-left">
                                                            <label for="IssuedDate">Tuzilgan sanasi</label>
                                                            @Html.TextBoxFor(model => model.IssuedDate, "{0:yyyy-MM-dd}", new { @id = "IssuedDate", @class = "form-control", @required = "required" })
                                                            <div class="form-control-position">
                                                                <i class='bx bx-calendar'></i>
                                                            </div>
                                                            @Html.ValidationMessageFor(model => model.IssuedDate, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-6 col-12 form-group position-relative has-icon-left">
                                                            <label for="DueDate">Tugaydigan sana</label>
                                                            @Html.TextBoxFor(model => model.DueDate, "{0:yyyy-MM-dd}", new { @id = "DueDate", @class = "form-control", @required = "required" })
                                                            <div class="form-control-position">
                                                                <i class='bx bx-calendar'></i>
                                                            </div>
                                                            @Html.ValidationMessageFor(model => model.DueDate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <br />
                                            <h4>Maxsulotlar</h4>
                                            <div data-repeater-list="ProductList">
                                                <div data-repeater-item>
                                                    <div class="row justify-content-between">
                                                        <input type="hidden" name="ID" value="0" />
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label>Maxsulot</label>
                                                            @Html.DropDownList("ProductID", (SelectList)ViewBag.Products, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label>O'lchov birligi</label>
                                                            @Html.DropDownList("UnitID", (SelectList)ViewBag.Units, "---Tanlang---", new { @class = "form-control select2", @required = "required" })
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label>Miqdori</label>
                                                            <input type="number" name="Amount" class="form-control product-amount" placeholder="Miqdori" step="1" min="1" required />
                                                        </div>
                                                        <div class="col-md-2 col-sm-12 form-group">
                                                            <label>Birlik narxi</label>
                                                            <input type="number" name="PiecePrice" class="form-control product-price" placeholder="Birlik narxi" step="0.01" min="0" required />
                                                        </div>
                                                        <div class="col-md-1 col-sm-12 form-group d-flex align-items-center pt-2">
                                                            <button data-repeater-delete type="button" class="btn btn-danger">O'chirish</button>
                                                        </div>
                                                    </div>
                                                    <hr>
                                                </div>
                                            </div>

                                            <button data-repeater-create type="button" class="btn btn-primary">Yangi maxsulot qo'shish</button>

                                            <ul class="list-group list-group-flush">
                                                <li class="list-group-item border-0 pb-0">
                                                    <button class="btn btn-primary btn-block subtotal-preview-btn" type="submit">
                                                        <i class='bx bx-save'></i>
                                                        Saqlash
                                                    </button>
                                                </li>
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            // Initialize flatpickr
            if (typeof flatpickr !== 'undefined') {
                flatpickr("#IssuedDate", {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "d.m.Y",
                    locale: "uz"
                });
                flatpickr("#DueDate", {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "d.m.Y",
                    locale: "uz"
                });
            }

            // Calculate total amount
            function calculateTotalAmount() {
                var total = 0;
                $('div[data-repeater-item]').each(function () {
                    var amount = parseFloat($(this).find('input[name="Amount"]').val()) || 0;
                    var price = parseFloat($(this).find('input[name="PiecePrice"]').val()) || 0;
                    total += amount * price;
                });
                $('#Amount').val(Math.round(total));
            }

            $(document).on('input change', 'input[name="Amount"], input[name="PiecePrice"]', function () {
                calculateTotalAmount();
            });

            $(document).on('click', '[data-repeater-create]', function () {
                setTimeout(calculateTotalAmount, 200);
            });

            $(document).on('click', '[data-repeater-delete]', function () {
                setTimeout(calculateTotalAmount, 200);
            });

            calculateTotalAmount();
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
