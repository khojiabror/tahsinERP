@model List<tahsinERP.Models.S_CONTRACTS>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Sotuv shartnomalari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "SContract")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi shartnoma
                            </a>
                        </div>
                    }

                    <!-- Filters -->
                    <div class="users-list-filter px-1">
                        @using (Html.BeginForm("Index", "SContract", FormMethod.Get, new { @class = "form" }))
                        {
                            <div class="row border rounded py-2 mb-2">
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Qidirish</label>
                                    <input type="text" name="searchTerm" class="form-control" placeholder="Shartnoma raqami..." value="@ViewBag.SearchTerm" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Mijoz</label>
                                    @Html.DropDownList("customerID", ViewBag.Customers as SelectList, "Barchasi", new { @class = "form-control" })
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Dan</label>
                                    <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Gacha</label>
                                    <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bx bx-search"></i> Qidirish
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="row mb-2">
                                        <div class="col-md-6">
                                            <span class="text-muted">Jami: @ViewBag.TotalItems ta yozuv</span>
                                        </div>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table invoice-data-table dt-responsive nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>
                                                        <a href="@Url.Action("Index", "SContract", new { searchTerm = ViewBag.SearchTerm, customerID = ViewBag.CustomerID, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, sortOrder = ViewBag.SortOrder == "contractNo" ? "contractNo_desc" : "contractNo", page = ViewBag.CurrentPage })">
                                                            Shartnoma raqami
                                                            @if (ViewBag.SortOrder == "contractNo")
                                                            {
                                                                <i class="bx bx-sort-up"></i>
                                                            }
                                                            else if (ViewBag.SortOrder == "contractNo_desc")
                                                            {
                                                                <i class="bx bx-sort-down"></i>
                                                            }
                                                        </a>
                                                    </th>
                                                    <th>Mijoz</th>
                                                    <th>
                                                        <a href="@Url.Action("Index", "SContract", new { searchTerm = ViewBag.SearchTerm, customerID = ViewBag.CustomerID, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, sortOrder = ViewBag.SortOrder == "date" ? "date_desc" : "date", page = ViewBag.CurrentPage })">
                                                            Sana
                                                            @if (ViewBag.SortOrder == "date")
                                                            {
                                                                <i class="bx bx-sort-up"></i>
                                                            }
                                                            else if (ViewBag.SortOrder == "date_desc")
                                                            {
                                                                <i class="bx bx-sort-down"></i>
                                                            }
                                                        </a>
                                                    </th>
                                                    <th>Summa</th>
                                                    <th>Valyuta</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "SContract", new { id = item.ID })">@item.ContractNo</a>
                                                            </td>
                                                            <td>
                                                                @if (item.CUSTOMER != null)
                                                                {
                                                                    <a href="@Url.Action("Details", "Customer", new { id = item.CustomerID })">@(item.CUSTOMER.Name ?? "")</a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            <td>@item.IssuedDate.ToString("dd.MM.yyyy")</td>
                                                            <td>@(item.Amount?.ToString("N2") ?? "0.00")</td>
                                                            <td>@(item.CURRENCy?.Shortname ?? "")</td>
                                                            @if (changePermit)
                                                            {
                                                                <td>
                                                                    <div>
                                                                        <a href="@Url.Action("Edit", "SContract", new { id = item.ID })" title="Tahrirlash"><i class="bx bx-edit-alt"></i></a>
                                                                        <a href="@Url.Action("Delete", "SContract", new { id = item.ID })" title="O'chirish"><i class="bx bx-trash"></i></a>
                                                                    </div>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="@(changePermit ? 6 : 5)" class="text-center">Ma'lumot topilmadi</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- Pagination -->
                                    @if (ViewBag.TotalPages > 1)
                                    {
                                        <div class="row mt-3">
                                            <div class="col-md-6">
                                                <span class="text-muted">
                                                    Sahifa @ViewBag.CurrentPage dan @ViewBag.TotalPages (@ViewBag.TotalItems ta yozuv)
                                                </span>
                                            </div>
                                            <div class="col-md-6">
                                                <nav>
                                                    <ul class="pagination justify-content-end">
                                                        @if (ViewBag.CurrentPage > 1)
                                                        {
                                                            <li class="page-item">
                                                                <a class="page-link" href="@Url.Action("Index", "SContract", new { searchTerm = ViewBag.SearchTerm, customerID = ViewBag.CustomerID, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, sortOrder = ViewBag.SortOrder, page = ViewBag.CurrentPage - 1 })">
                                                                    Oldingi
                                                                </a>
                                                            </li>
                                                        }
                                                        @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                                                        {
                                                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                                                <a class="page-link" href="@Url.Action("Index", "SContract", new { searchTerm = ViewBag.SearchTerm, customerID = ViewBag.CustomerID, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, sortOrder = ViewBag.SortOrder, page = i })">
                                                                    @i
                                                                </a>
                                                            </li>
                                                        }
                                                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                                        {
                                                            <li class="page-item">
                                                                <a class="page-link" href="@Url.Action("Index", "SContract", new { searchTerm = ViewBag.SearchTerm, customerID = ViewBag.CustomerID, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, sortOrder = ViewBag.SortOrder, page = ViewBag.CurrentPage + 1 })">
                                                                    Keyingi
                                                                </a>
                                                            </li>
                                                        }
                                                    </ul>
                                                </nav>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
