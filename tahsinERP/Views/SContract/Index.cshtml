@model List<tahsinERP.Models.S_CONTRACTS>
@{
    ViewBag.Title = "Ro'yxat";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    bool changePermit = tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString());

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Sotuv shartnomalari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "SContract")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi shartnoma
                            </a>
                        </div>
                    }

                    <!-- Filters -->
                    <div class="users-list-filter px-1">
                        @using (Html.BeginForm("Index", "SContract", FormMethod.Get, new { @class = "form" }))
                        {
                            <div class="row border rounded py-2 mb-2">
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Qidirish</label>
                                    <input type="text" name="searchTerm" class="form-control" placeholder="Shartnoma raqami..." value="@ViewBag.SearchTerm" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Mijoz</label>
                                    @Html.DropDownList("customerID", ViewBag.Customers as SelectList, "Barchasi", new { @class = "form-control" })
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Dan</label>
                                    <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2">
                                    <label>Gacha</label>
                                    <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bx bx-search"></i> Qidirish
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="contractDataTable" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Shartnoma raqami</th>
                                                    <th>Mijoz</th>
                                                    <th>Sana</th>
                                                    <th>Summa</th>
                                                    <th>Valyuta</th>
                                                    @if (changePermit)
                                                    {
                                                        <th class="text-center">Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "SContract", new { id = item.ID })" class="font-weight-bold">
                                                                    @item.ContractNo
                                                                </a>
                                                            </td>
                                                            <td>
                                                                @if (item.CUSTOMER != null)
                                                                {
                                                                    <a href="@Url.Action("Details", "Customer", new { id = item.CustomerID })" class="font-weight-bold">
                                                                        @(item.CUSTOMER.Name ?? "")
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            <td>@item.IssuedDate.ToString("dd.MM.yyyy")</td>
                                                            <td>@(item.Amount?.ToString("N2") ?? "0.00")</td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(item.CURRENCy?.Shortname))
                                                                {
                                                                    <span class="badge badge-light-primary">@item.CURRENCy.Shortname</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            @if (changePermit)
                                                            {
                                                                <td class="text-center">
                                                                    <a href="@Url.Action("Edit", "SContract", new { id = item.ID })" 
                                                                       class="btn btn-sm btn-outline-primary" title="Tahrirlash">
                                                                        <i class="bx bx-edit"></i>
                                                                    </a>
                                                                    <a href="@Url.Action("Delete", "SContract", new { id = item.ID })" 
                                                                       class="btn btn-sm btn-outline-danger" title="O'chirish">
                                                                        <i class="bx bx-trash"></i>
                                                                    </a>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        (function () {
            function initSContractTable() {
                if (typeof window.jQuery === 'undefined' || typeof window.jQuery.fn.DataTable === 'undefined') {
                    setTimeout(initSContractTable, 100);
                    return;
                }
                var $ = window.jQuery;
                if (!$('#contractDataTable').length) return;

                var changePermit = @(changePermit ? "true" : "false");
            
                var columnDefs = [];
                if (changePermit) {
                    columnDefs.push({ "orderable": false, "targets": -1 });
                }
            
                $('#contractDataTable').DataTable({
                "language": {
                    "search": "Qidirish:",
                    "lengthMenu": "_MENU_ ta ko'rsatish",
                    "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    "infoEmpty": "Yozuvlar yo'q",
                    "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                    "paginate": {
                        "first": "Birinchi",
                        "last": "Oxirgi",
                        "next": "Keyingi",
                        "previous": "Oldingi"
                    },
                    "zeroRecords": "Ma'lumot topilmadi"
                },
                "pageLength": 25,
                "order": [[2, "desc"]],
                "columnDefs": columnDefs,
                dom: 'lBfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bx bxs-file-excel"></i> Excel',
                        titleAttr: 'Excelga yuklash',
                        className: 'btn btn-success mr-1',
                        filename: function () {
                            var now = new Date();
                            var dateStr = now.getFullYear() + 
                                String(now.getMonth() + 1).padStart(2, '0') + 
                                String(now.getDate()).padStart(2, '0') + '_' +
                                String(now.getHours()).padStart(2, '0') + 
                                String(now.getMinutes()).padStart(2, '0') + 
                                String(now.getSeconds()).padStart(2, '0');
                            return 'Shartnomalar_' + dateStr;
                        },
                        exportOptions: {
                            columns: changePermit ? ':not(:last-child)' : ':visible',
                            format: {
                                body: function (data, row, column, node) {
                                    return data.replace(/<[^>]*>/g, '').trim();
                                }
                            }
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bx bxs-file-pdf"></i> PDF',
                        titleAttr: 'PDFga yuklash',
                        className: 'btn btn-danger',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        filename: function () {
                            var now = new Date();
                            var dateStr = now.getFullYear() + 
                                String(now.getMonth() + 1).padStart(2, '0') + 
                                String(now.getDate()).padStart(2, '0') + '_' +
                                String(now.getHours()).padStart(2, '0') + 
                                String(now.getMinutes()).padStart(2, '0') + 
                                String(now.getSeconds()).padStart(2, '0');
                            return 'Shartnomalar_' + dateStr;
                        },
                        exportOptions: {
                            columns: changePermit ? ':not(:last-child)' : ':visible',
                            format: {
                                body: function (data, row, column, node) {
                                    return data.replace(/<[^>]*>/g, '').trim();
                                }
                            }
                        },
                        title: 'Shartnomalar ro\'yxati',
                        customize: function (doc) {
                            doc.defaultStyle.fontSize = 9;
                            doc.styles.tableHeader.fontSize = 10;
                        }
                    }
                ],
                "scrollX": true
            });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initSContractTable);
            } else {
                initSContractTable();
            }
        })();
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
