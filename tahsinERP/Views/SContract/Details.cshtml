@model tahsinERP.Models.S_CONTRACTS
@{
    ViewBag.Title = "Batafsil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var type = ViewBag.Type;
}
@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SContract/Index">Shartnomalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Shartnoma sahifasi
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-xl-12 col-md-12 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body pb-0 mx-25">
                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 mt-25">
                                            <hr />
                                            <section>
                                                <div>
                                                    <br />
                                                    <h4 class="text-primary">Xaridor ma'lumotlari</h4>
                                                    <span>
                                                        <b>Nomi</b>: @Html.DisplayFor(model => model.CUSTOMER.Name, new { @class = "form-control" })
                                                    </span>
                                                    <hr />
                                                    <span>
                                                        <b>DUNS</b>: @Html.DisplayFor(model => model.CUSTOMER.DUNS, new { @class = "form-control" })
                                                    </span>
                                                    <hr />
                                                </div>
                                            </section>
                                            <h4 class="text-primary">Shartnoma  ma'lumotlari</h4>
                                            @if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "Customer", "Details"))
                                            {
                                                <div class="mb-2">
                                                    <a href="@Url.Action("Customer", "Reconciliation", new { id = Model.CustomerID, contractId = Model.ID })" class="btn btn-sm btn-outline-primary">
                                                        <i class="bx bx-transfer-alt"></i> Akt-sverki (ushbu shartnoma)
                                                    </a>
                                                </div>
                                            }
                                            <hr />
                                            <span>
                                                <b>Shartnoma raqami</b>: @Html.DisplayFor(model => model.ContractNo, new { @class = "form-control" })
                                            </span>
                                            <hr />
                                            <span>
                                                <b>Tuzilgan sanasi</b>: @Model.IssuedDate.ToString("dd.MM.yyyy")
                                            </span>
                                            <hr />
                                            <span>
                                                <b>Amal qilish sanasi</b>: @Model.DueDate.ToString("dd.MM.yyyy")
                                            </span>
                                            <hr />
                                            @{
                                                var totalAmount = ViewBag.ContractedTotal as double? ?? 0d;
                                            }
                                            <span>
                                                <b>Umumiy summasi</b>:
                                                <span class="text-success font-weight-bold">
                                                    @totalAmount.ToString("N2")
                                                </span>
                                            </span>
                                            <hr />
                                            @{
                                                var baseAmount = totalAmount / 1.12d;
                                                var vatAmount = totalAmount - baseAmount;
                                            }
                                            <span>
                                                <b>QQS (12%)</b>: @vatAmount.ToString("N2")
                                            </span>
                                            <hr />
                                            <span>
                                                <b>QQSsiz summa (88%)</b>: @baseAmount.ToString("N2")
                                            </span>
                                            <hr />
                                            <span>
                                                <b>Valyuta</b>: @Html.DisplayFor(model => model.CURRENCy.Shortname, new { @class = "form-control" })
                                            </span>
                                            <hr />
                                            <span>
                                                <b>Incoterms</b>: @Html.DisplayFor(model => model.Incoterms, new { @class = "form-control" })
                                            </span>
                                            <hr />
                                            <span>
                                                <b>To`lov sharti</b>: @Html.DisplayFor(model => model.PaymentTerms, new { @class = "form-control" })
                                            </span>
                                            <hr />

                                        </div>
                                    </div>
                                    <section id="column-selectors">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="card">
                                                    <div class="card-header">
                                                        <h4 class="card-title">Shartnoma predmeti</h4>
                                                    </div>
                                                    <div class="card-content">
                                                        <div class="card-body card-dashboard">
                                                            <div class="table-responsive">
                                                                <table class="table table-striped dataex-html5-selectors" style="width:100%">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Detal raqami</th>
                                                                            <th>Detal nomi</th>
                                                                            <th>Birlik narxi</th>
                                                                            <th>QQS (%)</th>
                                                                            <th>Jami narx</th>
                                                                            <th>O'lchov birligi</th>
                                                                            <th>Miqdori</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var item in ViewBag.ProductList)
                                                                        {
                                                                            <tr>
                                                                                @{
                                                                                    var baseTotal = item.PiecePrice * item.Amount;
                                                                                    var vatPercent = 12d;
                                                                                    var totalWithVat = baseTotal + (baseTotal * vatPercent / 100);
                                                                                }
                                                                                <td>
                                                                                    <a href="~/Product/Details/@item.PRODUCT.ID">@item.PRODUCT.PNo</a>
                                                                                </td>
                                                                                <td>
                                                                                    @item.PRODUCT.Name
                                                                                </td>
                                                                                <td>
                                                                                    @item.PiecePrice
                                                                                </td>
                                                                                <td>
                                                                                    @vatPercent.ToString("N2")
                                                                                </td>
                                                                                <td>
                                                                                    @totalWithVat.ToString("N2")
                                                                                </td>
                                                                                <td>
                                                                                    @item.UNIT.ShortName
                                                                                </td>
                                                                                <td>
                                                                                    @item.Amount
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                    <hr>

                                    <!-- Linked Orders -->
                                    @{
                                        var linkedOrders = ViewBag.LinkedOrders as List<tahsinERP.Models.S_ORDERS>;
                                        var ordersCount = ViewBag.OrdersCount as int? ?? 0;
                                    }
                                    @if (linkedOrders != null && linkedOrders.Any())
                                    {
                                        <section id="column-selectors">
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="card">
                                                        <div class="card-header d-flex justify-content-between align-items-center">
                                                            <h4 class="card-title">Bog'langan buyurtmalar</h4>
                                                            @if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
                                                            {
                                                                <a href="@Url.Action("ManageOrders", "SContract", new { contractID = Model.ID })" class="btn btn-sm btn-primary">
                                                                    <i class="bx bx-link"></i> Buyurtmalarni boshqarish
                                                                </a>
                                                            }
                                                        </div>
                                                        <div class="card-content">
                                                            <div class="card-body card-dashboard">
                                                                <div class="table-responsive">
                                                                    <table class="table table-striped" style="width:100%">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Buyurtma raqami</th>
                                                                                <th>Sana</th>
                                                                                <th>Summa</th>
                                                                                <th>Valyuta</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var order in linkedOrders)
                                                                            {
                                                                                <tr>
                                                                                    <td>
                                                                                        <a href="@Url.Action("Details", "SOrder", new { id = order.ID })">@order.OrderNo</a>
                                                                                    </td>
                                                                                    <td>@order.IssuedDate.ToString("dd.MM.yyyy")</td>
                                                                                    <td>@(order.Amount?.ToString("N2") ?? "0.00")</td>
                                                                                    <td>@(order.CURRENCy1?.Shortname ?? "")</td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>
                                    }

                                    <!-- Totals Comparison -->
                                    @{
                                        var contractedTotal = ViewBag.ContractedTotal as double? ?? 0;
                                        var orderedTotal = ViewBag.OrderedTotal as double? ?? 0;
                                        var invoicedTotal = ViewBag.InvoicedTotal as decimal? ?? 0;
                                    }
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5 class="card-title">Xulosa</h5>
                                                </div>
                                                <div class="card-body">
                                                    <table class="table table-sm">
                                                        <thead>
                                                            <tr>
                                                                <th>Ko'rsatkich</th>
                                                                <th>Summa</th>
                                                                <th>Holati</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td>Shartnoma bo'yicha</td>
                                                                <td>@contractedTotal.ToString("N2")</td>
                                                                <td><span class="badge badge-info">Shartnoma</span></td>
                                                            </tr>
                                                            <tr>
                                                                <td>Buyurtma bo'yicha</td>
                                                                <td>@orderedTotal.ToString("N2")</td>
                                                                <td>
                                                                    @if (orderedTotal <= 0)
                                                                    {
                                                                        <span class="badge badge-danger">Bajarilmadi</span>
                                                                    }
                                                                    else if (orderedTotal >= contractedTotal)
                                                                    {
                                                                        <span class="badge badge-success">To'liq bajarildi</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge badge-warning">Qisman bajarildi</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td>Invoys bo'yicha</td>
                                                                <td>@invoicedTotal.ToString("N2")</td>
                                                                <td>
                                                                    @if (invoicedTotal <= 0)
                                                                    {
                                                                        <span class="badge badge-danger">Bajarilmadi</span>
                                                                    }
                                                                    else if (invoicedTotal >= (decimal)contractedTotal)
                                                                    {
                                                                        <span class="badge badge-success">To'liq bajarildi</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge badge-warning">Qisman bajarildi</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Navigation Links -->
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <h5 class="text-primary mb-3">Bog'liq hujjatlar</h5>
                                            <div class="btn-group" role="group">
                                                <a href="@Url.Action("Index", "SOrder", new { contractID = Model.ID })" class="btn btn-outline-primary">
                                                    <i class="bx bx-list-ul"></i> Buyurtmalar (@ordersCount)
                                                </a>
                                                <a href="@Url.Action("Index", "SalesInvoices", new { contractID = Model.ID })" class="btn btn-outline-primary">
                                                    <i class="bx bx-receipt"></i> Invoyslar (@ViewBag.InvoicesCount)
                                                </a>
                                                @if (Model.CUSTOMER != null)
                                                {
                                                    <a href="@Url.Action("Details", "Customer", new { id = Model.CustomerID })" class="btn btn-outline-primary">
                                                        <i class="bx bx-user"></i> Mijoz
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}