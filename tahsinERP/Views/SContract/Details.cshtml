@model tahsinERP.Models.S_CONTRACTS
@{
    ViewBag.Title = L.T("Details");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var type = ViewBag.Type;
}
@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SContract/Index">@L.T("Menu_Contracts")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Crm_CtrPage")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-xl-12 col-md-12 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body pb-0 mx-25">
                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 mt-25">
                                            <hr />
                                            <section>
                                                <div>
                                                    <br />
                                                    <h4 class="text-primary">@L.T("Crm_CustomerInfo")</h4>
                                                    <span>
                                                        <b>@L.T("Name")</b>: @Html.DisplayFor(model => model.CUSTOMER.Name, new { @class = "form-control" })
                                                    </span>
                                                    <hr />
                                                    <span>
                                                        <b>DUNS</b>: @Html.DisplayFor(model => model.CUSTOMER.DUNS, new { @class = "form-control" })
                                                    </span>
                                                    <hr />
                                                </div>
                                            </section>
                                            <h4 class="text-primary">@L.T("Crm_CtrInfo")</h4>
                                            @if (tahsinERP.Models.RoleHelper.IsPermittedForAction(User.Identity.Name, "Customer", "Details", false))
                                            {
                                                <div class="mb-2">
                                                    <a href="@Url.Action("Customer", "Reconciliation", new { id = Model.CustomerID, contractId = Model.ID })" class="btn btn-sm btn-outline-primary">
                                                        <i class="bx bx-transfer-alt"></i> @L.T("Crm_CtrReconThis")
                                                    </a>
                                                </div>
                                            }
                                            <hr />
                                            <span>
                                                <b>@L.T("Crm_ContractNo")</b>: @Html.DisplayFor(model => model.ContractNo, new { @class = "form-control" })
                                            </span>
                                            <hr />
                                            <span>
                                                <b>@L.T("Crm_CtrIssuedDate")</b>: @Model.IssuedDate.ToString("dd.MM.yyyy")
                                            </span>
                                            <hr />
                                            <span>
                                                <b>@L.T("Crm_CtrValidUntil")</b>: @Model.DueDate.ToString("dd.MM.yyyy")
                                            </span>
                                            <hr />
                                            @{
                                                var totalAmount = ViewBag.ContractedTotal as decimal? ?? 0m;
                                                var baseAmount = ViewBag.ContractedBase as decimal? ?? 0m;
                                                var vatAmount = ViewBag.ContractedVat as decimal? ?? 0m;
                                                var vatRate = ViewBag.ContractedVatRate as decimal? ?? 0m;
                                            }
                                            <span>
                                                <b>@L.T("Crm_TotalAmount")</b>:
                                                <span class="text-success font-weight-bold">
                                                    @totalAmount.ToString("N2")
                                                </span>
                                            </span>
                                            <hr />
                                            <span>
                                                <b>@L.T("Crm_CtrVatRate", vatRate.ToString("N2"))</b>: @vatAmount.ToString("N2")
                                            </span>
                                            <hr />
                                            <span>
                                                <b>@L.T("Crm_CtrAmountExVat")</b>: @baseAmount.ToString("N2")
                                            </span>
                                            <hr />
                                            <span>
                                                <b>@L.T("Currency")</b>: @Html.DisplayFor(model => model.CURRENCy.Shortname, new { @class = "form-control" })
                                            </span>
                                            <hr />
                                            <span>
                                                <b>Incoterms</b>: @Html.DisplayFor(model => model.Incoterms, new { @class = "form-control" })
                                            </span>
                                            <hr />
                                            <span>
                                                <b>@L.T("Crm_CtrPaymentTerms")</b>: @Html.DisplayFor(model => model.PaymentTerms, new { @class = "form-control" })
                                            </span>
                                            <hr />
                                            <span>
                                                <b>@L.T("Crm_PaymentDue")</b>: @(Model.PaymentDays.HasValue ? L.T("Crm_DaysN", Model.PaymentDays) : "-")
                                            </span>
                                            <hr />

                                        </div>
                                    </div>
                                    <section id="column-selectors">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="card">
                                                    <div class="card-header">
                                                        <h4 class="card-title">@L.T("Crm_CtrSubject")</h4>
                                                    </div>
                                                    <div class="card-content">
                                                        <div class="card-body card-dashboard">
                                                            <div class="table-responsive">
                                                                <table class="table table-striped dataex-html5-selectors" style="width:100%">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>@L.T("Crm_CtrPartNo")</th>
                                                                            <th>@L.T("Crm_CtrPartName")</th>
                                                                            <th>@L.T("Crm_UnitPrice")</th>
                                                                            <th>@L.T("Crm_CtrVatPct")</th>
                                                                            <th>@L.T("Crm_CtrTotalPrice")</th>
                                                                            <th>@L.T("Unit")</th>
                                                                            <th>@L.T("Quantity")</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (tahsinERP.Models.S_CONTRACT_PRODUCTS item in ViewBag.ProductList)
                                                                        {
                                                                            <tr>
                                                                                @{
                                                                                    var baseTotal = (item.PiecePrice * item.Amount);
                                                                                    var lineVat = (item.vatamount ?? 0m);
                                                                                    var vatPercent = baseTotal > 0 && lineVat > 0
                                                                                        ? Math.Round(lineVat / baseTotal * 100m, 2)
                                                                                        : 0m;
                                                                                    var totalWithVat = item.totalamount ?? (baseTotal + lineVat);
                                                                                }
                                                                                <td>
                                                                                    <a href="~/Product/Details/@item.PRODUCT.ID">@item.PRODUCT.PNo</a>
                                                                                </td>
                                                                                <td>
                                                                                    @item.PRODUCT.Name
                                                                                </td>
                                                                                <td>
                                                                                    @item.PiecePrice.ToString("0.######")
                                                                                </td>
                                                                                <td>
                                                                                    @vatPercent.ToString("N2")
                                                                                </td>
                                                                                <td>
                                                                                    @totalWithVat.ToString("N2")
                                                                                </td>
                                                                                <td>
                                                                                    @item.UNIT.ShortName
                                                                                </td>
                                                                                <td>
                                                                                    @item.Amount.ToString("0.######")
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                    <hr>

                                    <!-- Linked Orders -->
                                    @{
                                        var linkedOrders = ViewBag.LinkedOrders as List<tahsinERP.Models.S_ORDERS>;
                                        var ordersCount = ViewBag.OrdersCount as int? ?? 0;
                                    }
                                    @if (linkedOrders != null && linkedOrders.Any())
                                    {
                                        <section id="column-selectors">
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="card">
                                                        <div class="card-header d-flex justify-content-between align-items-center">
                                                            <h4 class="card-title">@L.T("Crm_CtrLinkedOrders")</h4>
                                                            @if (tahsinERP.Models.RoleHelper.IsPermittedForAction(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString(), true))
                                                            {
                                                                <a href="@Url.Action("ManageOrders", "SContract", new { contractID = Model.ID })" class="btn btn-sm btn-primary">
                                                                    <i class="bx bx-link"></i> @L.T("Crm_CtrManageOrders")
                                                                </a>
                                                            }
                                                        </div>
                                                        <div class="card-content">
                                                            <div class="card-body card-dashboard">
                                                                <div class="table-responsive">
                                                                    <table class="table table-striped" style="width:100%">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>@L.T("Crm_OrderNo")</th>
                                                                                <th>@L.T("Date")</th>
                                                                                <th>@L.T("Amount")</th>
                                                                                <th>@L.T("Currency")</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var order in linkedOrders)
                                                                            {
                                                                                <tr>
                                                                                    <td>
                                                                                        <a href="@Url.Action("Details", "SOrder", new { id = order.ID })">@order.OrderNo</a>
                                                                                    </td>
                                                                                    <td>@order.IssuedDate.ToString("dd.MM.yyyy")</td>
                                                                                    <td>@(order.Amount?.ToString("N2") ?? "0.00")</td>
                                                                                    <td>@(order.CURRENCy1?.Shortname ?? "")</td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>
                                    }

                                    <!-- Totals Comparison -->
                                    @{
                                        var contractedTotal = ViewBag.ContractedTotal as decimal? ?? 0;
                                        var contractedQty = ViewBag.ContractedQty as decimal? ?? 0;
                                        var orderedTotal = ViewBag.OrderedTotal as decimal? ?? 0;
                                        var orderedQty = ViewBag.OrderedQty as decimal? ?? 0;
                                        var invoicedTotal = ViewBag.InvoicedTotal as decimal? ?? 0;
                                        var invoicedQty = ViewBag.InvoicedQty as decimal? ?? 0;
                                    }
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5 class="card-title">@L.T("Crm_CtrSummary")</h5>
                                                </div>
                                                <div class="card-body">
                                                    <table class="table table-sm">
                                                        <thead>
                                                            <tr>
                                                                <th>@L.T("Crm_CtrIndicator")</th>
                                                                <th>@L.T("Quantity")</th>
                                                                <th>@L.T("Amount")</th>
                                                                <th>@L.T("Status")</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td>@L.T("Crm_CtrByContract")</td>
                                                                <td>@contractedQty.ToString("N2")</td>
                                                                <td>@contractedTotal.ToString("N2")</td>
                                                                <td><span class="badge badge-info">@L.T("Crm_Contract")</span></td>
                                                            </tr>
                                                            <tr>
                                                                <td>@L.T("Crm_CtrByOrder")</td>
                                                                <td>@orderedQty.ToString("N2")</td>
                                                                <td>@orderedTotal.ToString("N2")</td>
                                                                <td>
                                                                    @if (orderedTotal <= 0)
                                                                    {
                                                                        <span class="badge badge-danger">@L.T("Crm_CtrNotFulfilled")</span>
                                                                    }
                                                                    else if (orderedTotal >= contractedTotal)
                                                                    {
                                                                        <span class="badge badge-success">@L.T("Crm_CtrFullyFulfilled")</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge badge-warning">@L.T("Crm_CtrPartiallyFulfilled")</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td>@L.T("Crm_CtrByInvoice")</td>
                                                                <td>@invoicedQty.ToString("N2")</td>
                                                                <td>@invoicedTotal.ToString("N2")</td>
                                                                <td>
                                                                    @if (invoicedTotal <= 0)
                                                                    {
                                                                        <span class="badge badge-danger">@L.T("Crm_CtrNotFulfilled")</span>
                                                                    }
                                                                    else if (invoicedTotal >= (decimal)contractedTotal)
                                                                    {
                                                                        <span class="badge badge-success">@L.T("Crm_CtrFullyFulfilled")</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge badge-warning">@L.T("Crm_CtrPartiallyFulfilled")</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Navigation Links -->
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <h5 class="text-primary mb-3">@L.T("Crm_RelatedDocs")</h5>
                                            <div class="btn-group" role="group">
                                                <a href="@Url.Action("Index", "SOrder", new { contractID = Model.ID })" class="btn btn-outline-primary">
                                                    <i class="bx bx-list-ul"></i> @L.T("Menu_Orders") (@ordersCount)
                                                </a>
                                                <a href="@Url.Action("Index", "SalesInvoices", new { contractID = Model.ID })" class="btn btn-outline-primary">
                                                    <i class="bx bx-receipt"></i> @L.T("Menu_Invoices") (@ViewBag.InvoicesCount)
                                                </a>
                                                @if (Model.CUSTOMER != null)
                                                {
                                                    <a href="@Url.Action("Details", "Customer", new { id = Model.CustomerID })" class="btn btn-outline-primary">
                                                        <i class="bx bx-user"></i> @L.T("Crm_Client")
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
