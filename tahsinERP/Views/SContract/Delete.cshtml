@model tahsinERP.Models.S_CONTRACTS
@{
    ViewBag.Title = L.T("Delete");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var productList = ViewBag.ProductList as IEnumerable<tahsinERP.Models.S_CONTRACT_PRODUCTS>;
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SContract">@L.T("Menu_Contracts")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Crm_CtrDeleteNamed", Model.ContractNo)
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title text-danger">@L.T("Crm_CtrDeleteTitle")</h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="alert alert-warning">
                                        <h5>@L.T("Crm_Attention")</h5>
                                        <p>@L.T("Crm_CtrDeleteWarning")</p>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <table class="table table-borderless">
                                                <tr>
                                                    <th width="40%">@L.T("Crm_Client"):</th>
                                                    <td>@(Model.CUSTOMER?.Name ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Crm_ContractNo"):</th>
                                                    <td>@Model.ContractNo</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Crm_CtrIssuedDate"):</th>
                                                    <td>@Model.IssuedDate.ToString("dd.MM.yyyy")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Crm_CtrValidUntil"):</th>
                                                    <td>@Model.DueDate.ToString("dd.MM.yyyy")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Amount"):</th>
                                                    <td><strong>@(Model.Amount?.ToString("0.######"))</strong></td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Currency"):</th>
                                                    <td>@(Model.CURRENCy?.Shortname ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>Incoterms:</th>
                                                    <td>@(Model.Incoterms ?? "-")</td>
                                                </tr>
                                                <tr>
                                                    <th>@L.T("Crm_CtrPaymentTerms"):</th>
                                                    <td>@(Model.PaymentTerms ?? "-")</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    @if (productList != null && productList.Any())
                                    {
                                        <div class="table-responsive mt-2">
                                            <table class="table table-striped table-bordered" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>@L.T("Crm_ProductNo")</th>
                                                        <th>@L.T("Name")</th>
                                                        <th>@L.T("Unit")</th>
                                                        <th>@L.T("Quantity")</th>
                                                        <th>@L.T("Price")</th>
                                                        <th>@L.T("Total")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in productList)
                                                    {
                                                        var lineTotal = item.PiecePrice * item.Amount;
                                                        <tr>
                                                            <td>@(item.PRODUCT?.PNo ?? "-")</td>
                                                            <td>@(item.PRODUCT?.Name ?? "-")</td>
                                                            <td>@(item.UNIT?.ShortName ?? item.UNIT?.UnitName ?? "-")</td>
                                                            <td>@item.Amount.ToString("0.######")</td>
                                                            <td>@item.PiecePrice.ToString("N2")</td>
                                                            <td>@lineTotal.ToString("N2")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    @using (Html.BeginForm("Delete", "SContract", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(model => model.ID)

                                        <div class="form-actions mt-3">
                                            <button type="submit" class="btn btn-danger" onclick="return confirm('@L.Js("Crm_CtrConfirmDelete")');">
                                                <i class="bx bx-trash"></i> @L.T("Crm_YesDelete")
                                            </button>
                                            <a href="@Url.Action("Index", "SContract")" class="btn btn-secondary">
                                                <i class="bx bx-x"></i> @L.T("Cancel")
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
