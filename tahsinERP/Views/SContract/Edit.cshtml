@model tahsinERP.ViewModels.SContractViewModel
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, ViewContext.RouteData.Values["controller"].ToString(), ViewContext.RouteData.Values["action"].ToString()))
{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SContract/Index">Shartnomalar</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Shartnoma tahrirlash
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row">
                    <div class="col-xl-12 col-md-12 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body pb-0 mx-25">
                                    @using (Html.BeginForm("Edit", "SContract", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(model => model.ID)
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                <div class="row">
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>Shartnoma raqami</label>
                                                        @Html.TextBoxFor(model => model.ContractNo, new { @class = "form-control" })
                                                        @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>Mijoz</label>
                                                        @Html.DropDownListFor(model => model.CustomerID, (SelectList)ViewBag.Customers, new { @class = "form-control select2" })
                                                        @Html.ValidationMessageFor(model => model.CustomerID, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>Tuzilgan sanasi</label>
                                                        @Html.TextBoxFor(model => model.IssuedDate, "{0:yyyy-MM-dd}", new { @id = "IssuedDate", @class = "form-control" })
                                                        @Html.ValidationMessageFor(model => model.IssuedDate, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>Tugaydigan sana</label>
                                                        @Html.TextBoxFor(model => model.DueDate, "{0:yyyy-MM-dd}", new { @id = "DueDate", @class = "form-control" })
                                                        @Html.ValidationMessageFor(model => model.DueDate, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>Incoterms</label>
                                                        @Html.TextBoxFor(model => model.Incoterms, new { @class = "form-control" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>To'lov sharti</label>
                                                        @Html.TextBoxFor(model => model.PaymentTerms, new { @class = "form-control" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>Valyuta</label>
                                                        @Html.DropDownListFor(model => model.CurrencyID, ViewBag.currencies as SelectList, new { @class = "form-control select2" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>Umumiy summasi</label>
                                                        @Html.TextBoxFor(model => model.Amount, new { @class = "form-control", @id = "Amount", @readonly = "readonly" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <section id="column-selectors">
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="card">
                                                        <div class="card-header">
                                                            <h4 class="card-title">Shartnoma predmeti</h4>
                                                        </div>
                                                        <div class="card-content">
                                                            <div class="card-body card-dashboard">
                                                                <div class="table-responsive">
                                                                    <table class="table table-striped" style="width:100%">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Maxsulot</th>
                                                                                <th>Birlik narxi</th>
                                                                                <th>O'lchov birligi</th>
                                                                                <th>Miqdori</th>
                                                                                <th>Amallar</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @for (int i = 0; i < Model.ProductList.Count; i++)
                                                                            {
                                                                                <tr>
                                                                                    <td>
                                                                                        @Html.HiddenFor(m => m.ProductList[i].ID)
                                                                                        @Html.HiddenFor(m => m.ProductList[i].ProductID)
                                                                                        @Model.ProductList[i].ProductPNo
                                                                                    </td>
                                                                                    <td>
                                                                                        @Html.TextBoxFor(m => m.ProductList[i].PiecePrice, new { @class = "form-control product-price-edit" })
                                                                                    </td>
                                                                                    <td>
                                                                                        @Html.DropDownListFor(m => m.ProductList[i].UnitID, (SelectList)ViewBag.Units, new { @class = "form-control" })
                                                                                    </td>
                                                                                    <td>
                                                                                        @Html.TextBoxFor(m => m.ProductList[i].Amount, new { @class = "form-control product-amount-edit" })
                                                                                    </td>
                                                                                    <td>
                                                                                        <a href="~/SContract/DeleteProduct/@Model.ProductList[i].ID" onclick="return confirm('Ushbu shartnoma maxsulotini o\'chirib yuborishga ishonchingiz komilmi?')">
                                                                                            <i class="bx bx-trash"></i>
                                                                                        </a>
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>

                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <button class="btn btn-primary" type="submit">Saqlash</button>
                                                <a href="~/SContract/Index" class="btn btn-danger">Bekor qilish</a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            if (typeof flatpickr !== 'undefined') {
                flatpickr("#IssuedDate", {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "d.m.Y",
                    locale: "uz"
                });
                flatpickr("#DueDate", {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "d.m.Y",
                    locale: "uz"
                });
            }

            function calculateTotalAmount() {
                var total = 0;
                $('.product-price-edit').each(function () {
                    var $row = $(this).closest('tr');
                    var price = parseFloat($(this).val()) || 0;
                    var amount = parseFloat($row.find('.product-amount-edit').val()) || 0;
                    total += price * amount;
                });
                $('#Amount').val(Math.round(total));
            }

            $(document).on('input change', '.product-price-edit, .product-amount-edit', function () {
                calculateTotalAmount();
            });

            calculateTotalAmount();
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
