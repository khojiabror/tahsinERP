@model tahsinERP.ViewModels.SContractViewModel
@{
    ViewBag.Title = L.T("Edit");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ruxsat serverda tekshiriladi ([Permission] / controller) — CRM-S01 *@
@{
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="~/SContract/Index">@L.T("Menu_Contracts")</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        @L.T("Crm_CtrEdit")
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="row">
                    <div class="col-xl-12 col-md-12 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body pb-0 mx-25">
                                    @using (Html.BeginForm("Edit", "SContract", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(model => model.ID)
                                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                                        if (TempData["ErrorMessage"] != null)
                                        {
                                            <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
                                        }

                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 mt-25">
                                                <div class="row">
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>@L.T("Crm_ContractNo")</label>
                                                        @Html.TextBoxFor(model => model.ContractNo, new { @class = "form-control" })
                                                        @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>@L.T("Crm_Client")</label>
                                                        @Html.DropDownListFor(model => model.CustomerID, (SelectList)ViewBag.Customers, new { @class = "form-control select2" })
                                                        @Html.ValidationMessageFor(model => model.CustomerID, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>@L.T("Crm_CtrIssuedDate")</label>
                                                        @Html.TextBoxFor(model => model.IssuedDate, "{0:yyyy-MM-dd}", new { @type = "date", @id = "IssuedDate", @class = "form-control" })
                                                        @Html.ValidationMessageFor(model => model.IssuedDate, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>@L.T("Crm_CtrEndDate")</label>
                                                        @Html.TextBoxFor(model => model.DueDate, "{0:yyyy-MM-dd}", new { @type = "date", @id = "DueDate", @class = "form-control" })
                                                        @Html.ValidationMessageFor(model => model.DueDate, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>Incoterms</label>
                                                        @Html.TextBoxFor(model => model.Incoterms, new { @class = "form-control" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>@L.T("Crm_CtrPaymentTerms")</label>
                                                        @Html.TextBoxFor(model => model.PaymentTerms, new { @class = "form-control" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>@L.T("Crm_CtrPaymentDays")</label>
                                                        @Html.TextBoxFor(model => model.PaymentDays, new { @type = "number", @min = "0", @max = "3650", @step = "1", @class = "form-control", @placeholder = L.T("Crm_CtrEg30") })
                                                        @Html.ValidationMessageFor(model => model.PaymentDays, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>@L.T("Currency")</label>
                                                        @Html.DropDownListFor(model => model.CurrencyID, ViewBag.currencies as SelectList, new { @class = "form-control select2" })
                                                    </div>
                                                    <div class="col-md-3 col-12 form-group">
                                                        <label>@L.T("Crm_TotalAmount")</label>
                                                        @Html.TextBoxFor(model => model.Amount, new { @class = "form-control", @id = "Amount", @readonly = "readonly" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <section id="column-selectors">
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="card">
                                                    <div class="card-header">
                                                        <h4 class="card-title">@L.T("Crm_CtrSubject")</h4>
                                                        <button type="button" class="btn btn-sm btn-success float-right" id="addProductBtn">
                                                            <i class="bx bx-plus"></i> @L.T("Crm_CtrAddProduct")
                                                        </button>
                                                    </div>
                                                    <div class="card-content">
                                                        <div class="card-body card-dashboard">
                                                            <div class="table-responsive">
                                                                <table class="table table-striped" id="productTable" style="width:100%">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>@L.T("Crm_Product")</th>
                                                                            <th>@L.T("Quantity")</th>
                                                                            <th>@L.T("Unit")</th>
                                                                            <th>@L.T("Crm_UnitPrice")</th>
                                                                            <th>@L.T("Crm_CtrVatPct")</th>
                                                                            <th>@L.T("Crm_CtrTotalPrice")</th>
                                                                            <th>@L.T("Actions")</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody id="productTableBody">
                                                                        @for (int i = 0; i < Model.ProductList.Count; i++)
                                                                        {
                                                                            <tr data-index="@i">
                                                                                <td>
                                                                                    @Html.HiddenFor(m => m.ProductList[i].ID)
                                                                                    @Html.HiddenFor(m => m.ProductList[i].ProductID)
                                                                                    <span class="product-display">@Model.ProductList[i].ProductPNo</span>
                                                                                </td>
                                                                                <td>
                                                                                    <input type="number" name="ProductList[@i].Amount" class="form-control product-amount-edit" value="@tahsinERP.Services.Crm.CrmNumber.ForInput(Model.ProductList[i].Amount)" step="0.01" min="0.01" required />
                                                                                </td>
                                                                                <td>
                                                                                    @Html.DropDownList($"ProductList[{i}].UnitID", new SelectList(((SelectList)ViewBag.Units).Items, "ID", "Extra", Model.ProductList[i].UnitID), new { @class = "form-control" })
                                                                                </td>
                                                                                <td>
                                                                                    <input type="number" name="ProductList[@i].PiecePrice" class="form-control product-price-edit" value="@tahsinERP.Services.Crm.CrmNumber.ForInput(Model.ProductList[i].PiecePrice)" step="0.01" min="0" required />
                                                                                </td>
                                                                                <td>
                                                                                    <input type="number" name="ProductList[@i].VatPercent" class="form-control vat-input" value="@Model.ProductList[i].VatPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" step="0.01" min="0" max="100" />
                                                                                </td>
                                                                                <td>
                                                                                    <input type="number" class="form-control total-with-vat" value="0" readonly />
                                                                                </td>
                                                                                <td>
                                                                                    @if (Model.ProductList[i].ID > 0)
                                                                                    {
                                                                                        <a href="#" data-post-url="@Url.Action("DeleteProduct", "SContract", new { id = Model.ProductList[i].ID })" data-confirm="@L.T("Crm_CtrConfirmDeleteProduct")">
                                                                                            <i class="bx bx-trash"></i>
                                                                                        </a>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <button type="button" class="btn btn-sm btn-danger remove-product-row">
                                                                                            <i class="bx bx-trash"></i>
                                                                                        </button>
                                                                                    }
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>

                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <button class="btn btn-primary" type="submit">@L.T("Save")</button>
                                                <a href="~/SContract/Index" class="btn btn-danger">@L.T("Cancel")</a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section scripts {
        <script type="application/json" id="contractProductsConfig">@Html.Raw(Json.Encode(new
        {
            mode = "edit",
            startIndex = Model.ProductList.Count,
            products = ((IEnumerable<SelectListItem>)(ViewBag.Products as SelectList) ?? Enumerable.Empty<SelectListItem>()).Select(x => new { x.Value, x.Text }),
            units = ((IEnumerable<SelectListItem>)(ViewBag.Units as SelectList) ?? Enumerable.Empty<SelectListItem>()).Select(x => new { x.Value, x.Text })
        }))</script>
        <script src="@Url.Content("~/Scripts/app/indexed-rows.js")"></script>
        <script src="@Url.Content("~/Scripts/app/product-select.js")"></script>
        <script src="@Url.Content("~/Scripts/crm/contract-products.js")"></script>
    }
}
