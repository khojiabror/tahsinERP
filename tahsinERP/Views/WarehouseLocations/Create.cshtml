@model tahsinERP.ViewModels.WarehouseLocationEditViewModel
@{
    ViewBag.Title = "Yangi DLOC qo'shish";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lockWarehouse = ViewBag.LockWarehouse as bool? ?? false;
    var returnWarehouseId = Model.WarehouseID > 0 ? (int?)Model.WarehouseID : null;
}

@if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "Warehouse", "Index"))
{
    using (Html.BeginForm("Create", "WarehouseLocations", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="app-content content">
            <div class="content-overlay"></div>
            <div class="content-wrapper">
                <div class="content-header row">
                    <div class="content-header-left col-12 mb-2 mt-1">
                        <div class="row breadcrumbs-top">
                            <div class="col-12">
                                <div class="breadcrumb-wrapper col-12">
                                    <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                        <li class="breadcrumb-item">
                                            <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="@Url.Action("Index", "Warehouse")">Korxona omborlari</a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="@Url.Action("Index", "WarehouseLocations", new { warehouseId = returnWarehouseId })">DLOC</a>
                                        </li>
                                        <li class="breadcrumb-item active">Yangi DLOC</li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <section class="basic-select2">
                        <div class="row">
                            <div class="col-xl-9 col-md-8 col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h4 class="card-title">Yangi joylashuv (DLOC)</h4>
                                    </div>
                                    <div class="card-content">
                                        <div class="card-body">
                                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                                            <div class="form-group">
                                                <label for="WarehouseID">Ombor <span class="text-danger">*</span></label>
                                                @if (lockWarehouse && Model.WarehouseID > 0)
                                                {
                                                    @Html.HiddenFor(m => m.WarehouseID)
                                                    @Html.DropDownListFor(m => m.WarehouseID, ViewBag.Warehouses as SelectList, new { @class = "form-control", disabled = "disabled" })
                                                    <small class="text-muted">Ombor Warehouse sahifasidan tanlangan</small>
                                                }
                                                else
                                                {
                                                    @Html.DropDownListFor(m => m.WarehouseID, ViewBag.Warehouses as SelectList, "---Tanlang---", new { @class = "form-control select2", required = "required" })
                                                }
                                                @Html.ValidationMessageFor(m => m.WarehouseID, "", new { @class = "text-danger" })
                                            </div>

                                            <div class="form-group">
                                                <label for="LocationCode">Joy kodi (DLOC) <span class="text-danger">*</span></label>
                                                @Html.TextBoxFor(m => m.LocationCode, new { @class = "form-control", @placeholder = "Masalan: A-01-02", required = "required" })
                                                @Html.ValidationMessageFor(m => m.LocationCode, "", new { @class = "text-danger" })
                                            </div>

                                            <div class="form-group">
                                                <label for="LocationName">Nomi</label>
                                                @Html.TextBoxFor(m => m.LocationName, new { @class = "form-control", @placeholder = "Joy nomi (ixtiyoriy)" })
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="MinCapacity">Min sig'im</label>
                                                        @Html.TextBoxFor(m => m.MinCapacity, new { @class = "form-control", type = "number", step = "0.01", min = "0" })
                                                        @Html.ValidationMessageFor(m => m.MinCapacity, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="MaxCapacity">Max sig'im</label>
                                                        @Html.TextBoxFor(m => m.MaxCapacity, new { @class = "form-control", type = "number", step = "0.01", min = "0" })
                                                        @Html.ValidationMessageFor(m => m.MaxCapacity, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <div class="custom-control custom-checkbox">
                                                    @Html.CheckBoxFor(m => m.AllowMixedLots, new { @class = "custom-control-input" })
                                                    <label class="custom-control-label" for="AllowMixedLots">Lot aralashtirishga ruxsat</label>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <div class="custom-control custom-checkbox">
                                                    @Html.CheckBoxFor(m => m.AllowMixedProducts, new { @class = "custom-control-input" })
                                                    <label class="custom-control-label" for="AllowMixedProducts">Mahsulot aralashtirishga ruxsat</label>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <div class="custom-control custom-checkbox">
                                                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "custom-control-input" })
                                                    <label class="custom-control-label" for="IsActive">Faol</label>
                                                </div>
                                            </div>

                                            <div class="form-actions">
                                                <button type="submit" class="btn btn-primary">
                                                    <i class="bx bx-save"></i> Saqlash
                                                </button>
                                                <a href="@Url.Action("Index", "WarehouseLocations", new { warehouseId = returnWarehouseId })" class="btn btn-light">
                                                    <i class="bx bx-x"></i> Bekor qilish
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }

    <script>
        $(document).ready(function () {
            $('.select2').select2({ placeholder: "Tanlang", allowClear: true });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
