@model tahsinERP.Models.P_CONTRACTS
@using tahsinERP.Services
@{
    ViewBag.Title = L.T("Srm_ContractDetailsTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var docIds = ViewBag.DocIds as System.Collections.Generic.List<int> ?? new System.Collections.Generic.List<int>();
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/PContracts/Index">@L.T("Menu_PurchaseContracts")</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Srm_DetailsTitle")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">@L.T("Srm_ContractInfo")</h4>
                            <div class="heading-elements">
                                @if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "PContracts"))
                                {
                                    <a href="@Url.Action("Edit", "PContracts", new { id = Model.ID })" class="btn btn-sm btn-warning">
                                        <i class="bx bx-edit-alt"></i> @L.T("Edit")
                                    </a>
                                }
                                @if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "Supplier", "Details"))
                                {
                                    <a href="@Url.Action("Supplier", "Reconciliation", new { id = Model.SupplierID, contractId = Model.ID })" class="btn btn-sm btn-outline-primary">
                                        <i class="bx bx-transfer-alt"></i> @L.T("Srm_Reconciliation")
                                    </a>
                                }
                                <a href="@Url.Action("Index", "PContracts")" class="btn btn-sm btn-secondary">
                                    <i class="bx bx-arrow-back"></i> @L.T("Back")
                                </a>
                            </div>
                        </div>
                        <div class="card-content">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <table class="table table-borderless">
                                            <tr>
                                                <th width="40%">@L.T("Srm_ContractNo"):</th>
                                                <td>@Model.ContractNo</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Date"):</th>
                                                <td>@Model.IssuedDate.ToString("dd.MM.yyyy")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Menu_Company"):</th>
                                                <td>@(Model.COMPANy?.Name ?? "-")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Srm_Supplier"):</th>
                                                <td>
                                                    @if (Model.SUPPLIER != null)
                                                    {
                                                        <a href="@Url.Action("Details", "Supplier", new { id = Model.SupplierID })">@Model.SUPPLIER.Name</a>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Currency"):</th>
                                                <td>@(Model.CURRENCy?.Shortname ?? "-")</td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-md-6">
                                        <table class="table table-borderless">
                                            <tr>
                                                <th width="40%">@L.T("Srm_ContractAmount"):</th>
                                                <td><strong>@(Model.Amount?.ToString("N2") ?? "0.00")</strong></td>
                                            </tr>
                                            @{
                                                var contractProducts = Model.P_CONTRACT_PRODUCTS;
                                                var baseAmount = contractProducts != null ? contractProducts.Sum(p => p.Amount) : 0m;
                                                var vatAmount = contractProducts != null ? contractProducts.Sum(p => (p.VATAmount ?? 0)) : 0m;
                                                var totalAmount = contractProducts != null ? contractProducts.Sum(p => p.TotalAmount ?? PContractVatHelper.CalculateLineTotalWithVat(p.Amount, p.VATAmount)) : 0m;
                                                var vatPercent = PContractVatHelper.GetVatPercentFromLine(baseAmount, vatAmount);
                                            }
                                            <tr>
                                                <th>@L.T("Srm_VatPercentLabel", vatPercent.ToString("N2"))</th>
                                                <td>@vatAmount.ToString("N2")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Srm_AmountWithoutVat"):</th>
                                                <td>@baseAmount.ToString("N2")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Srm_TotalWithVat"):</th>
                                                <td><strong>@totalAmount.ToString("N2")</strong></td>
                                            </tr>
                                            <tr>
                                                <th>Incoterms:</th>
                                                <td>@(Model.Incoterms ?? "-")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Srm_PaymentTerms"):</th>
                                                <td>@(Model.PaymentTerms ?? "-")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Srm_DueDate"):</th>
                                                <td>@Model.DueDate.ToString("dd.MM.yyyy")</td>
                                            </tr>
                                            <tr>
                                                <th>IDN:</th>
                                                <td>@(Model.IDN ?? "-")</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <hr />

                                <section id="column-selectors">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h4 class="card-title">@L.T("Srm_ContractProducts")</h4>
                                                </div>
                                                <div class="card-content">
                                                    <div class="card-body card-dashboard">
                                                        <div class="table-responsive">
                                                            <table class="table table-striped dataex-html5-selectors" style="width:100%">
                                                                <thead>
                                                                    <tr>
                                                                        <th>@L.T("Srm_ProductCode")</th>
                                                                        <th>@L.T("Srm_ProductName")</th>
                                                                        <th>@L.T("Quantity")</th>
                                                                        <th>@L.T("Unit")</th>
                                                                        <th>@L.T("Price")</th>
                                                                        <th>@L.T("Srm_VatPercent")</th>
                                                                        <th>@L.T("Srm_TotalPrice")</th>
                                                                        <th>MOQ</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (Model.P_CONTRACT_PRODUCTS != null && Model.P_CONTRACT_PRODUCTS.Any())
                                                                    {
                                                                        foreach (var product in Model.P_CONTRACT_PRODUCTS)
                                                                        {
                                                                            <tr>
                                                                                @{
                                                                                    var baseTotal = product.Amount;
                                                                                    vatPercent = PContractVatHelper.GetVatPercentFromLine(product.Amount, product.VATAmount);
                                                                                    var totalWithVat = product.TotalAmount ?? PContractVatHelper.CalculateLineTotalWithVat(product.Amount, product.VATAmount);
                                                                                }
                                                                                <td>
                                                                                    @if (product.PRODUCT != null && product.PRODUCT.ID > 0)
                                                                                    {
                                                                                        <a href="@Url.Action("Details", "Product", new { id = product.PRODUCT.ID })">@(product.PRODUCT.PNo ?? "-")</a>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span>-</span>
                                                                                    }
                                                                                </td>
                                                                                <td>@(product.PRODUCT?.Name ?? "-")</td>
                                                                                <td>@product.Quantity.ToString("N2")</td>
                                                                                <td>@(product.UNIT?.ShortName ?? "-")</td>
                                                                                <td>@product.Price.ToString("N2")</td>
                                                                                <td>@vatPercent.ToString("N2")</td>
                                                                                <td>@totalWithVat.ToString("N2")</td>
                                                                                <td>@(product.MOQ?.ToString("N2") ?? "-")</td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <tr>
                                                                            <td colspan="8" class="text-center">@L.T("Srm_ProductsNotFound")</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <hr />

                                <!-- Linked Invoices -->
                                @{
                                    var linkedInvoices = ViewBag.LinkedInvoices as List<tahsinERP.Models.P_INVOICES>;
                                    var invoicesCount = ViewBag.InvoicesCount as int? ?? 0;
                                }
                                @if (linkedInvoices != null && linkedInvoices.Any())
                                {
                                    <section id="column-selectors">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="card">
                                                    <div class="card-header d-flex justify-content-between align-items-center">
                                                        <h4 class="card-title">@L.T("Srm_LinkedInvoices")</h4>
                                                    </div>
                                                    <div class="card-content">
                                                        <div class="card-body card-dashboard">
                                                            <div class="table-responsive">
                                                                <table class="table table-striped" style="width:100%">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>@L.T("Srm_InvoiceNo")</th>
                                                                            <th>@L.T("Date")</th>
                                                                            <th>@L.T("Amount")</th>
                                                                            <th>@L.T("Currency")</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var invoice in linkedInvoices)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    <a href="@Url.Action("Details", "PInvoices", new { id = invoice.ID })">@invoice.InvoiceNo</a>
                                                                                </td>
                                                                                <td>@invoice.InvoiceDate.ToString("dd.MM.yyyy")</td>
                                                                                <td>@((invoice.Amount ?? 0).ToString("N2"))</td>
                                                                                <td>@(invoice.CURRENCy?.Shortname ?? "")</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                }

                                <!-- Totals Comparison -->
                                @{
                                    var contractedTotal = ViewBag.ContractedTotal as decimal? ?? 0;
                                    var orderedTotal = ViewBag.OrderedTotal as decimal? ?? 0;
                                    var invoicedTotal = ViewBag.InvoicedTotal as decimal? ?? 0;
                                }
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <div class="card">
                                            <div class="card-header">
                                                <h5 class="card-title">@L.T("Srm_Summary")</h5>
                                            </div>
                                            <div class="card-body">
                                                <table class="table table-sm">
                                                    <thead>
                                                        <tr>
                                                            <th>@L.T("Srm_Indicator")</th>
                                                            <th>@L.T("Amount")</th>
                                                            <th>@L.T("Srm_StatusOf")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>@L.T("Srm_ByContract")</td>
                                                            <td>@contractedTotal.ToString("N2")</td>
                                                            <td><span class="badge badge-info">@L.T("Srm_Contract")</span></td>
                                                        </tr>
                                                        <tr>
                                                            <td>@L.T("Srm_ByOrder")</td>
                                                            <td>@orderedTotal.ToString("N2")</td>
                                                            <td>
                                                                @if (orderedTotal > contractedTotal)
                                                                {
                                                                    <span class="badge badge-warning">@L.T("Srm_Exceeded")</span>
                                                                }
                                                                else if (orderedTotal == contractedTotal)
                                                                {
                                                                    <span class="badge badge-success">@L.T("Srm_Full")</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge badge-info">@L.T("Srm_Partial")</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>@L.T("Srm_ByInvoice")</td>
                                                            <td>@invoicedTotal.ToString("N2")</td>
                                                            <td>
                                                                @if (invoicedTotal > contractedTotal)
                                                                {
                                                                    <span class="badge badge-warning">@L.T("Srm_Exceeded")</span>
                                                                }
                                                                else if (invoicedTotal == contractedTotal)
                                                                {
                                                                    <span class="badge badge-success">@L.T("Srm_Full")</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge badge-info">@L.T("Srm_Partial")</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Navigation Links -->
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <h5 class="text-primary mb-3">@L.T("Srm_RelatedDocs")</h5>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Index", "POrders", new { contractID = Model.ID })" class="btn btn-outline-primary">
                                                <i class="bx bx-list-ul"></i> @L.T("Menu_Orders") (@ViewBag.OrdersCount)
                                            </a>
                                            <a href="@Url.Action("Index", "PInvoices", new { contractID = Model.ID })" class="btn btn-outline-primary">
                                                <i class="bx bx-receipt"></i> @L.T("Menu_Invoices") (@invoicesCount)
                                            </a>
                                            @if (Model.SUPPLIER != null)
                                            {
                                                <a href="@Url.Action("Details", "Supplier", new { id = Model.SupplierID })" class="btn btn-outline-primary">
                                                    <i class="bx bx-user"></i> @L.T("Srm_Supplier")
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>

                                @if (docIds.Any())
                                {
                                    <hr />
                                    <h5>@L.T("Srm_ContractDocs")</h5>
                                    <ul>
                                        @foreach (var docId in docIds)
                                        {
                                            <li>
                                                <a href="@Url.Action("DownloadDoc", "PContracts", new { id = docId })" target="_blank">
                                                    <i class="bx bx-file"></i> @L.T("Srm_ContractDocNo", docId)
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
