@model tahsinERP.Models.P_CONTRACTS
@{
    ViewBag.Title = L.T("Srm_DeleteContract");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/PContracts/Index">@L.T("Menu_PurchaseContracts")</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @L.T("Delete")
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title text-danger">@L.T("Srm_DeleteContract")</h4>
                        </div>
                        <div class="card-content">
                            <div class="card-body">
                                <div class="alert alert-warning">
                                    <h5>@L.T("Srm_Attention")</h5>
                                    <p>@L.T("Srm_ConfirmDeleteContractIrrev")</p>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <table class="table table-borderless">
                                            <tr>
                                                <th width="40%">@L.T("Srm_ContractNo"):</th>
                                                <td>@Model.ContractNo</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Date"):</th>
                                                <td>@Model.IssuedDate.ToString("dd.MM.yyyy")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Srm_Supplier"):</th>
                                                <td>@(Model.SUPPLIER?.Name ?? "-")</td>
                                            </tr>
                                            <tr>
                                                <th>@L.T("Srm_ContractAmount"):</th>
                                                <td><strong>@(Model.Amount?.ToString("N2") ?? "0.00")</strong></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                @using (Html.BeginForm("Delete", "PContracts", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.HiddenFor(model => model.ID)

                                    <div class="form-actions">
                                        <button type="submit" class="btn btn-danger">
                                            <i class="bx bx-trash"></i> @L.T("Srm_YesDelete")
                                        </button>
                                        <a href="@Url.Action("Index", "PContracts")" class="btn btn-secondary">
                                            <i class="bx bx-x"></i> @L.T("Cancel")
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
