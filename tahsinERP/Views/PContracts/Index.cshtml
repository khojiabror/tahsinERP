@{
    ViewBag.Title = "Xarid shartnomalari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    bool changePermit = ViewBag.ChangePermit as bool? ?? false;
}
<div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Xarid shartnomalari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "PContracts")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi shartnoma (Direct)
                            </a>
                            <a href="@Url.Action("Create", "PContracts", new { purchaseType = "Indirect" })" class="btn btn-info bg-light invoice-create ml-1" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi shartnoma (Indirect)
                            </a>
                        </div>
                    }

                    <div class="card mb-2">
                        <div class="card-body py-1">
                            @using (Html.BeginForm("Index", "PContracts", FormMethod.Get, new { @class = "form", id = "pContractsFilter" }))
                            {
                                <div class="row">
                                    <div class="col-md-2 form-group mb-1">
                                        <label for="purchaseTypeFilter">Xarid turi</label>
                                        @Html.DropDownList("purchaseTypeFilter", new SelectList(new[]
                                        {
                                            new { Value = "", Text = "Barchasi" },
                                            new { Value = "Direct", Text = "Direct Purchase" },
                                            new { Value = "Indirect", Text = "Indirect Purchase" }
                                        }, "Value", "Text", ViewBag.PurchaseTypeFilter), new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3 form-group mb-1">
                                        <label for="supplierID">Ta'minotchi</label>
                                        @Html.DropDownList("supplierID", ViewBag.Suppliers as SelectList, "Barchasi", new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-3 form-group mb-1">
                                        <label for="contractID">Shartnoma</label>
                                        @Html.DropDownList("contractID", ViewBag.Contracts as SelectList, "Barchasi", new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-2 form-group mb-1">
                                        <label for="fromDate">Dan</label>
                                        <input type="date" id="fromDate" name="fromDate" class="form-control" value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")" />
                                    </div>
                                    <div class="col-md-2 form-group mb-1">
                                        <label for="toDate">Gacha</label>
                                        <input type="date" id="toDate" name="toDate" class="form-control" value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <button type="submit" class="btn btn-primary btn-sm mr-1"><i class="bx bx-filter"></i> Filtrlash</button>
                                        <a href="@Url.Action("Index", "PContracts")" class="btn btn-outline-secondary btn-sm">Tozalash</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="pContractsTable" class="table dt-responsive nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Shartnoma raqami</th>
                                                    <th>Ta'minotchi</th>
                                                    <th>Turi</th>
                                                    <th>Shartnoma summasi</th>
                                                    <th>To'lov shartlari</th>
                                                    <th>Sana</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

@section Scripts {
    <script src="~/Scripts/srm/srm-server-table.js"></script>
    <script>
        $(document).ready(function () {
            var detailsUrl = '@Url.Action("Details", "PContracts")/';
            var editUrl = '@Url.Action("Edit", "PContracts")/';
            var deleteUrl = '@Url.Action("Delete", "PContracts")/';
            var supplierUrl = '@Url.Action("Details", "Supplier")/';
            var columns = [
                { data: 'contractNo', render: function (v, t, r) { return '<a href="' + detailsUrl + r.id + '">' + srmEsc(v) + '</a>'; } },
                { data: 'supplier', render: function (v, t, r) { return v ? '<a href="' + supplierUrl + r.supplierId + '">' + srmEsc(v) + '</a>' : '<span class="text-muted">-</span>'; } },
                { data: 'indirect', render: function (v) { return v ? '<span class="badge badge-info">Indirect</span>' : '<span class="badge badge-primary">Direct</span>'; } },
                { data: 'amount' },
                { data: 'paymentTerms', render: function (v) { return srmEsc(v || '-'); } },
                { data: 'date' }
            ];
            @if (changePermit)
            {
                <text>
                columns.push({
                    data: null, orderable: false, render: function (v, t, r) {
                        return '<div class="d-flex">' +
                            '<a href="' + detailsUrl + r.id + '" class="btn btn-sm btn-icon btn-outline-primary mr-1" title="Ko&#39;rish"><i class="bx bx-show"></i></a>' +
                            '<a href="' + editUrl + r.id + '" class="btn btn-sm btn-icon btn-outline-warning mr-1" title="Tahrirlash"><i class="bx bx-edit-alt"></i></a>' +
                            '<a href="' + deleteUrl + r.id + '" class="btn btn-sm btn-icon btn-outline-danger" title="O&#39;chirish" onclick="return confirm(&quot;Ushbu shartnomani o&#39;chirishni tasdiqlaysizmi?&quot;);"><i class="bx bx-trash"></i></a>' +
                            '</div>';
                    }
                });
                </text>
            }
            var table = srmServerTable('#pContractsTable', {
                dataUrl: '@Url.Action("IndexData", "PContracts")',
                exportUrl: '@Url.Action("ExportExcel", "PContracts")',
                filterForm: '#pContractsFilter',
                order: [[5, 'desc']],
                columns: columns
            });
            $('#pContractsFilter').on('submit', function (e) { e.preventDefault(); table.ajax.reload(); });
        });
    </script>
}
