@model List<tahsinERP.Models.P_CONTRACTS>
@{
    ViewBag.Title = "Xarid shartnomalari";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (tahsinERP.Models.RoleHelper.IsViewPermitted(User.Identity.Name, "PContracts", "Index"))
{
    bool changePermit = false;
    if (tahsinERP.Models.RoleHelper.IsChangePermitted(User.Identity.Name, "PContracts"))
    {
        changePermit = true;
    }

    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-12 mb-2 mt-1">
                    <div class="row breadcrumbs-top">
                        <div class="col-12">
                            <div class="breadcrumb-wrapper col-12">
                                <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                    <li class="breadcrumb-item">
                                        <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Xarid shartnomalari
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-body">
                <section class="invoice-list-wrapper">
                    @if (changePermit)
                    {
                        <div class="invoice-create-btn mb-1">
                            <a href="@Url.Action("Create", "PContracts")" class="btn btn-success bg-light invoice-create" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi shartnoma (Direct)
                            </a>
                            <a href="@Url.Action("Create", "PContracts", new { purchaseType = "Indirect" })" class="btn btn-info bg-light invoice-create ml-1" role="button" aria-pressed="true">
                                <i class="bx bx-plus"></i> Yangi shartnoma (Indirect)
                            </a>
                        </div>
                    }

                    <!-- Purchase Type Filter -->
                    <div class="row mb-2">
                        <div class="col-md-3">
                            @using (Html.BeginForm("Index", "PContracts", FormMethod.Get))
                            {
                                <div class="form-group">
                                    <label for="purchaseTypeFilter">Xarid turi</label>
                                    @Html.DropDownList("purchaseTypeFilter", new SelectList(new[]
                                    {
                                        new { Value = "", Text = "Barchasi" },
                                        new { Value = "Direct", Text = "Direct Purchase" },
                                        new { Value = "Indirect", Text = "Indirect Purchase" }
                                    }, "Value", "Text", Request.QueryString["purchaseTypeFilter"]), new { @class = "form-control select2", @onchange = "this.form.submit();" })
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="pContractsTable" class="table zero-configuration dt-responsive nowrap" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>Shartnoma raqami</th>
                                                    <th>Ta'minotchi</th>
                                                    <th>Turi</th>
                                                    <th>Shartnoma summasi</th>
                                                    <th>To'lov shartlari</th>
                                                    <th>Sana</th>
                                                    @if (changePermit)
                                                    {
                                                        <th>Amallar</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a href="@Url.Action("Details", "PContracts", new { id = item.ID })">@item.ContractNo</a>
                                                            </td>
                                                            <td>
                                                                @if (item.SUPPLIER != null)
                                                                {
                                                                    <a href="@Url.Action("Details", "Supplier", new { id = item.SupplierID })">@item.SUPPLIER.Name</a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @{
                                                                    var contractType = item.PurchaseType == 1 ? "Indirect" : "Direct";
                                                                    var contractTypeClass = item.PurchaseType == 1 ? "badge-info" : "badge-primary";
                                                                }
                                                                <span class="badge @contractTypeClass">@contractType</span>
                                                            </td>
                                                            <td>@(item.Amount?.ToString("N2") ?? "0.00")</td>
                                                            <td>@(item.PaymentTerms ?? "-")</td>
                                                            <td>@item.IssuedDate.ToString("dd.MM.yyyy")</td>
                                                            @if (changePermit)
                                                            {
                                                                <td>
                                                                    <div class="d-flex">
                                                                        <a href="@Url.Action("Details", "PContracts", new { id = item.ID })" class="btn btn-sm btn-icon btn-outline-primary mr-1" title="Ko'rish">
                                                                            <i class="bx bx-show"></i>
                                                                        </a>
                                                                        <a href="@Url.Action("Edit", "PContracts", new { id = item.ID })" class="btn btn-sm btn-icon btn-outline-warning mr-1" title="Tahrirlash">
                                                                            <i class="bx bx-edit-alt"></i>
                                                                        </a>
                                                                        <a href="@Url.Action("Delete", "PContracts", new { id = item.ID })" class="btn btn-sm btn-icon btn-outline-danger" title="O'chirish" onclick="return confirm('Ushbu shartnomani o\'chirishni tasdiqlaysizmi?');">
                                                                            <i class="bx bx-trash"></i>
                                                                        </a>
                                                                    </div>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $('#pContractsTable').DataTable({
                "language": {
                    "search": "Qidirish:",
                    "lengthMenu": "_MENU_ ta ko'rsatish",
                    "info": "_TOTAL_ ta yozuvdan _START_ dan _END_ gacha",
                    "infoEmpty": "Yozuvlar yo'q",
                    "infoFiltered": "(jami _MAX_ ta yozuvdan filtrlangan)",
                    "paginate": {
                        "first": "Birinchi",
                        "last": "Oxirgi",
                        "next": "Keyingi",
                        "previous": "Oldingi"
                    },
                    "zeroRecords": "Ma'lumot topilmadi"
                },
                "pageLength": 25,
                "order": [[4, "desc"]],
                dom: 'lBfrtip',
                buttons: [
                    { extend: 'excelHtml5', text: '<i class="bx bxs-file-excel"></i> Excel', titleAttr: 'Excelga yuklash', className: 'btn btn-success btn-sm mr-1', exportOptions: { columns: ':visible', format: { body: function(d) { return (d||'').toString().replace(/<[^>]*>/g,'').trim(); } } } },
                    { extend: 'pdfHtml5', text: '<i class="bx bxs-file-pdf"></i> PDF', titleAttr: 'PDFga yuklash', className: 'btn btn-danger btn-sm', pageSize: 'A4', exportOptions: { columns: ':visible', format: { body: function(d) { return (d||'').toString().replace(/<[^>]*>/g,'').trim(); } } } }
                ]
            });
        });
    </script>
}
else
{
    Response.Redirect(Url.Action("Index", "ViewNotAuthorized"));
}
