@model tahsinERP.ViewModels.PContract.PContractCreateViewModel
@using System.Collections.Generic
@{
    ViewBag.Title = L.T("Srm_NewPurchaseContract");
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Prepare data for JavaScript
    var purchasableProductsList = ViewBag.PurchasableProducts as SelectList;
    var unitsList = ViewBag.Units as SelectList;
    var hsCodesList = ViewBag.HSCodes as SelectList;
    var purchasableProductsData = new List<object>();
    var unitsData = new List<object>();
    var hsCodesData = new List<object>();
    
    if (purchasableProductsList != null)
    {
        foreach (SelectListItem item in purchasableProductsList)
        {
            purchasableProductsData.Add(new { Value = item.Value, Text = item.Text });
        }
    }
    
    if (unitsList != null)
    {
        foreach (SelectListItem item in unitsList)
        {
            unitsData.Add(new { Value = item.Value, Text = item.Text });
        }
    }
    
    if (hsCodesList != null)
    {
        foreach (SelectListItem item in hsCodesList)
        {
            hsCodesData.Add(new { Value = item.Value, Text = item.Text });
        }
    }
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-12 mb-2 mt-1">
                <div class="row breadcrumbs-top">
                    <div class="col-12">
                        <div class="breadcrumb-wrapper col-12">
                            <ol class="breadcrumb rounded-pill breadcrumb-divider">
                                <li class="breadcrumb-item">
                                    <a href="~/Home"><i class="bx bx-home-alt"></i></a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="~/PContracts/Index">@L.T("Menu_PurchaseContracts")</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    @{
                                        var purchaseType = Request.QueryString["purchaseType"];
                                        var purchaseTypeText = purchaseType == "Indirect" ? L.T("Srm_NewContractIndirect") : L.T("Srm_NewContractDirect");
                                    }
                                    @purchaseTypeText
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <section id="form-repeater-wrapper">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    @using (Html.BeginForm("Create", "PContracts", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form", @id = "contractForm", data_renumber = "ContractProducts" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        if (purchaseType == "Indirect")
                                        {
                                            <input type="hidden" name="PurchaseType" value="Indirect" />
                                        }

                                        <div class="row">
                                            @if (purchaseType == "Indirect")
                                            {
                                                <div class="col-12 mb-2">
                                                    <div class="alert alert-info">
                                                        <i class="bx bx-info-circle"></i> <strong>@L.T("Srm_IndirectPurchase"):</strong> @L.T("Srm_IndirectContractHint")
                                                    </div>
                                                </div>
                                            }
                                            <div class="col-md-3 col-12 form-group">
                                                <label for="ContractNo">@L.T("Srm_ContractNo")</label>
                                                @Html.TextBoxFor(model => model.ContractNo, new { @class = "form-control", @placeholder = L.T("Srm_AutoGenerated") })
                                                @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
                                                <small class="text-muted">@L.T("Srm_AutoGenIfEmpty")</small>
                                            </div>
                                            <div class="col-md-3 col-12 form-group">
                                                <label for="IssuedDate">@L.T("Date")</label>
                                                @Html.TextBoxFor(model => model.IssuedDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @required = "required" })
                                                @Html.ValidationMessageFor(model => model.IssuedDate, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-3 col-12 form-group">
                                                <label for="SupplierID">@L.T("Srm_Supplier")</label>
                                                @Html.DropDownListFor(model => model.SupplierID, ViewBag.Suppliers as SelectList, L.T("SelectPlaceholder"), new { @class = "form-control select2", @required = "required" })
                                                @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-3 col-12 form-group">
                                                <label for="CurrencyID">@L.T("Currency")</label>
                                                @Html.DropDownListFor(model => model.CurrencyID, ViewBag.Currencies as SelectList, L.T("SelectPlaceholder"), new { @class = "form-control select2", @required = "required" })
                                                @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-3 col-12 form-group">
                                                <label for="DueDate">@L.T("Srm_DueDate")</label>
                                                @Html.TextBoxFor(model => model.DueDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @required = "required" })
                                                @Html.ValidationMessageFor(model => model.DueDate, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-3 col-12 form-group">
                                                <label for="Incoterms">Incoterms</label>
                                                @Html.TextBoxFor(model => model.Incoterms, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.Incoterms, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-3 col-12 form-group">
                                                <label for="PaymentTerms">@L.T("Srm_PaymentTerms")</label>
                                                @Html.TextBoxFor(model => model.PaymentTerms, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.PaymentTerms, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-3 col-12 form-group">
                                                <label for="IDN">IDN</label>
                                                @Html.TextBoxFor(model => model.IDN, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.IDN, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-9 col-12 form-group">
                                                <label for="contractFile">@L.T("Srm_ContractFilePdf")</label>
                                                <input type="file" name="contractFile" id="contractFile" class="form-control" accept=".pdf" />
                                            </div>
                                        </div>

                                        <br />
                                        <h5>@L.T("Srm_ContractProducts")</h5>
                                        
                                        <div class="table-responsive">
                                            <table id="contractProductsTable" class="table table-bordered doc-lines">
                                                <thead>
                                                    <tr>
                                                        <th>@L.T("Srm_Product")</th>
                                                        <th>@L.T("Quantity")</th>
                                                        <th>@L.T("Unit")</th>
                                                        <th>@L.T("Price")</th>
                                                        <th>@L.T("Srm_VatPercent")</th>
                                                        <th>@L.T("Srm_TotalPrice")</th>
                                                        <th>MOQ</th>
                                                        <th>HS Code</th>
                                                        <th>@L.T("Actions")</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                                <tfoot>
                                                    <tr>
                                                        <td colspan="5" class="text-right"><strong>@L.T("Total"):</strong></td>
                                                        <td id="totalAmount" class="text-right"><strong>0.00</strong></td>
                                                        <td colspan="3"></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>

                                        <div class="row mt-2">
                                            <div class="col-12">
                                                <button type="button" class="btn btn-outline-primary" id="addRowBtn">
                                                    <i class="bx bx-plus"></i> @L.T("Add")
                                                </button>
                                            </div>
                                        </div>

                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <button type="submit" class="btn btn-success">
                                                    <i class="bx bx-save"></i> @L.T("Save")
                                                </button>
                                                <a href="@Url.Action("Index", "PContracts")" class="btn btn-secondary">
                                                    <i class="bx bx-x"></i> @L.T("Cancel")
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<script src="@Url.Content("~/Scripts/app/indexed-rows.js")"></script>
<script src="@Url.Content("~/Scripts/app/product-select.js")"></script>

<script>
    // Wait for jQuery to be available
    (function() {
        function initContractProducts() {
            if (typeof jQuery === 'undefined') {
                console.error('jQuery is not loaded!');
                setTimeout(initContractProducts, 100);
                return;
            }

            var $ = jQuery;
            
            $(document).ready(function () {
                if (typeof $.fn.select2 !== 'undefined') {
                    $('.select2').select2();
                }

                var productRowIndex = 0;
                var purchasableProducts = @Html.Raw(Json.Encode(purchasableProductsData));
                var units = @Html.Raw(Json.Encode(unitsData));
                var hsCodes = @Html.Raw(Json.Encode(hsCodesData));
                // Mahsulot ro'yxati qatorlarga yozilmaydi — select2 qidiruvi (SRM-P02)

                // Add row button handler - use delegated event only (prevents double binding)
                $(document).on('click', '#addRowBtn', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    addProductRow(null, 0, null, 0, 0, null, null);
                    return false;
                });

                function addProductRow(productId, quantity, unitId, price, vatPercent, moq, hsCodeId) {
                    var row = '<tr data-row-index="' + productRowIndex + '">' +
                        '<td>' +
                            '<select name="ContractProducts[' + productRowIndex + '].ProductID" class="form-control product-select" required>' +
                            ProductSelect.optionsHtml(purchasableProducts, productId);
                    
                    row += '</select></td>' +
                        '<td><input type="number" name="ContractProducts[' + productRowIndex + '].Quantity" class="form-control quantity-input" value="' + (quantity || 0) + '" step="0.01" min="0" required /></td>' +
                        '<td>' +
                            '<select name="ContractProducts[' + productRowIndex + '].UnitID" class="form-control unit-select select2" required>' +
                            '<option value="">@L.Js("SelectPlaceholder")</option>';
                    
                    units.forEach(function (unit) {
                        var selected = unit.Value == unitId ? 'selected' : '';
                        row += '<option value="' + unit.Value + '" ' + selected + '>' + htmlEscape(unit.Text) + '</option>';
                    });
                    
                    row += '</select></td>' +
                        '<td><input type="number" name="ContractProducts[' + productRowIndex + '].Price" class="form-control price-input" value="' + (price || 0) + '" step="0.01" min="0" required /></td>' +
                        '<td><input type="number" name="ContractProducts[' + productRowIndex + '].VatPercent" class="form-control vat-input" value="' + (vatPercent || 12) + '" step="0.01" min="0" max="100" /></td>' +
                        '<td><input type="number" name="ContractProducts[' + productRowIndex + '].Amount" class="form-control total-price" value="0" readonly /></td>' +
                        '<td><input type="number" name="ContractProducts[' + productRowIndex + '].MOQ" class="form-control moq-input" value="' + (moq || 0) + '" step="0.01" min="0" /></td>' +
                        '<td>' +
                            '<select name="ContractProducts[' + productRowIndex + '].HSCodeID" class="form-control hs-code-select">' +
                            ProductSelect.optionsHtml(hsCodes, hsCodeId);
                    
                    row += '</select></td>' +
                        '<td><button type="button" class="btn btn-sm btn-danger remove-row"><i class="bx bx-trash"></i></button></td>' +
                        '</tr>';

                    $('#contractProductsTable tbody').append(row);
                    
                    if (typeof $.fn.select2 !== 'undefined') {
                        ProductSelect.attach($('select.product-select').last(), purchasableProducts);
                        $('select.unit-select.select2').last().select2();
                        // HS kodlar ham (~11 000 ta) qatorga yozilmaydi — qidiruv bilan (SRM-P02)
                        ProductSelect.attach($('select.hs-code-select').last(), hsCodes);
                    }

                    productRowIndex++;
                }

                $(document).on('click', '.remove-row', function () {
                    $(this).closest('tr').remove();
                    updateTotal();
                });

                $(document).on('input', '.quantity-input, .price-input, .vat-input', function () {
                    var $row = $(this).closest('tr');
                    var quantity = parseFloat($row.find('.quantity-input').val()) || 0;
                    var price = parseFloat($row.find('.price-input').val()) || 0;
                    var vatPercent = parseFloat($row.find('.vat-input').val()) || 0;
                    var baseTotal = quantity * price;
                    var total = baseTotal + (baseTotal * vatPercent / 100);
                    $row.find('.total-price').val(total.toFixed(2));
                    updateTotal();
                });

                function updateTotal() {
                    var total = 0;
                    $('.total-price').each(function () {
                        total += parseFloat($(this).val()) || 0;
                    });
                    $('#totalAmount').text(total.toFixed(2));
                }

                $('#contractForm').submit(function (e) {
                    if ($('#contractProductsTable tbody tr').length === 0) {
                        e.preventDefault();
                        alert('@L.Js("Srm_AtLeastOneProduct")');
                        return false;
                    }
                });
            });
        }
        
        // Start initialization
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initContractProducts);
        } else {
            initContractProducts();
        }
    })();
</script>
