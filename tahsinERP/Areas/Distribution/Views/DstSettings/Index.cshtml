@using tahsinERP.Areas.Distribution.Controllers
@{
    ViewBag.Title = DstLocalization.T("Settings");
    bool canChange = ViewBag.DstCanChange == true;
    var roles = (List<DstSettingsController.RoleLimitRow>)ViewBag.Roles;
    var warehouses = (List<DstSettingsController.WarehouseRow>)ViewBag.Warehouses;
    var limits = (List<DstSettingsController.StockLimitRow>)ViewBag.Limits;
    int? warehouseId = ViewBag.WarehouseId;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var general = (Dictionary<string, string>)ViewBag.General;
    Func<string, string> G = k => general.ContainsKey(k) ? general[k] : null;
    var accounts = (List<SelectListItem>)ViewBag.Accounts;
    var payAllowed = (G("AgentPayMethods") ?? "CASH,CARD,CLICK").Split(',');
    var payMethods = new[] { "CASH", "CARD", "CLICK", "PAYME", "UZUM", "TRANSFER" };
}
@Html.AntiForgeryToken()
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        @Html.Partial("_DstHeader", (string)ViewBag.Title)
        <div class="content-body">
            <div class="card">
                <div class="card-header"><h4 class="card-title">@DstLocalization.T("Settings_General")</h4></div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="form-group col-md-2"><label>@DstLocalization.T("Settings_MinOrder")</label><input id="gMinOrder" type="number" min="0" step="1000" class="form-control" value="@G("MinOrderAmount")" @(canChange ? "" : "disabled") /></div>
                        <div class="form-group col-md-2"><label>@DstLocalization.T("Settings_LargeOrder")</label><input id="gLarge" type="number" min="0" step="1000" class="form-control" value="@G("LargeOrderAmount")" @(canChange ? "" : "disabled") /></div>
                        <div class="form-group col-md-2"><label>@DstLocalization.T("Settings_Radius")</label><input id="gRadius" type="number" min="20" max="5000" step="10" class="form-control" value="@(G("VisitRadiusM") ?? "200")" @(canChange ? "" : "disabled") /></div>
                        <div class="form-group col-md-3">
                            <label>@DstLocalization.T("Settings_HandoverAccount")</label>
                            <select id="gAccount" class="form-control" @(canChange ? "" : "disabled")>
                                <option value="">—</option>
                                @foreach (var a in (List<SelectListItem>)ViewBag.Accounts)
                                {
                                    <option value="@a.Value" @(a.Value == G("AgentCashAccountId") ? "selected" : "")>@a.Text</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-md-3"><label>@DstLocalization.T("Settings_BotUsername")</label><input id="gBot" class="form-control" placeholder="my_company_bot" value="@G("BotUsername")" @(canChange ? "" : "disabled") /></div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4"><label>@DstLocalization.T("Settings_BotPublicUrl")</label><input id="gBotUrl" class="form-control" placeholder="https://bot.example.uz" value="@G("BotPublicUrl")" @(canChange ? "" : "disabled") /></div>
                        <div class="form-group col-md-4 d-flex align-items-end">
                            <div class="custom-control custom-checkbox mb-50">
                                <input type="checkbox" class="custom-control-input" id="gSelfie" @(G("RequireSelfie") == "1" ? "checked" : "") @(canChange ? "" : "disabled") />
                                <label class="custom-control-label" for="gSelfie">@DstLocalization.T("Settings_RequireSelfie")</label>
                            </div>
                        </div>
                    </div>
                    <p class="small text-muted">@DstLocalization.T("Settings_GeneralHint")</p>
                    @if (canChange) { <button type="button" class="btn btn-primary btn-sm" id="gSave">@DstLocalization.T("Save")</button> }
                </div>
            </div>
            <div class="card">
                <div class="card-header"><h4 class="card-title">@DstLocalization.T("Settings_AgentPayments")</h4></div>
                <div class="card-body">
                    <p class="small text-muted">@DstLocalization.T("Settings_AgentPaymentsHint")</p>
                    <div class="table-responsive">
                        <table class="table table-sm" id="payTable" style="max-width:640px">
                            <thead><tr><th>@DstLocalization.T("Payment_Method")</th><th class="text-center">@DstLocalization.T("Settings_AgentAccepts")</th><th>@DstLocalization.T("Settings_PayAccount")</th></tr></thead>
                            <tbody>
                                @foreach (var m in payMethods)
                                {
                                    <tr data-method="@m">
                                        <td>@DstLocalization.T("PayMethod_" + m)</td>
                                        <td class="text-center"><input type="checkbox" data-f="on" @(payAllowed.Contains(m) ? "checked" : "") @(canChange ? "" : "disabled") /></td>
                                        <td>
                                            @if (m == "CASH")
                                            {
                                                <span class="text-muted small">@DstLocalization.T("Settings_CashStaysWithAgent")</span>
                                            }
                                            else
                                            {
                                                <select class="form-control form-control-sm" data-f="acc" @(canChange ? "" : "disabled")>
                                                    <option value="">—</option>
                                                    @foreach (var a in accounts)
                                                    {
                                                        <option value="@a.Value" @(a.Value == G("AgentAccount_" + m) ? "selected" : "")>@a.Text</option>
                                                    }
                                                </select>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (canChange) { <button type="button" class="btn btn-primary btn-sm" id="paySave">@DstLocalization.T("Save")</button> }
                </div>
            </div>
            <div class="row">
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-header"><h4 class="card-title">@DstLocalization.T("DiscountLimits")</h4></div>
                        <div class="card-body">
                            <p class="small text-muted">@DstLocalization.T("DiscountLimits_Hint")</p>
                            <table class="table table-sm">
                                <thead><tr><th>@DstLocalization.T("Role")</th><th class="text-right">Max %</th></tr></thead>
                                <tbody>
                                    @foreach (var r in roles)
                                    {
                                        <tr>
                                            <td>@r.Role</td>
                                            <td class="text-right" style="width:110px">
                                                <input type="number" min="0" max="100" step="0.5" class="form-control form-control-sm text-right"
                                                       data-role="@r.RoleID" value="@(r.MaxPercent?.ToString("0.##", inv))" @(canChange ? "" : "disabled") />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-header"><h4 class="card-title">@DstLocalization.T("Warehouses")</h4></div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>@DstLocalization.T("Warehouse")</th>
                                            <th>@DstLocalization.T("Warehouse_SalesPoint")</th>
                                            <th>@DstLocalization.T("Warehouse_AllowNegative")</th>
                                            <th>@DstLocalization.T("Warehouse_Zone")</th>
                                            <th class="text-right">@DstLocalization.T("MinStock")</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var w in warehouses)
                                        {
                                            <tr data-wh="@w.WarehouseID" class="@(w.WarehouseID == warehouseId ? "table-active" : "")">
                                                <td>@w.Name</td>
                                                <td><input type="checkbox" data-f="sales" @(w.IsSalesPoint ? "checked" : "") @(canChange ? "" : "disabled") /></td>
                                                <td><input type="checkbox" data-f="neg" @(w.AllowNegative ? "checked" : "") @(canChange ? "" : "disabled") /></td>
                                                <td><input class="form-control form-control-sm" data-f="zone" value="@w.DeliveryZone" maxlength="200" @(canChange ? "" : "disabled") /></td>
                                                <td class="text-right"><a href="@Url.Action("Index", new { warehouseId = w.WarehouseID })">@w.MinLimits</a></td>
                                                <td class="text-right">
                                                    @if (canChange) { <button type="button" class="btn btn-sm btn-outline-primary" data-wh-save><i class="bx bx-save"></i></button> }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <p class="small text-muted mb-0">@DstLocalization.T("Warehouse_Hint")</p>
                        </div>
                    </div>
                    @if (warehouseId.HasValue)
                    {
                        <div class="card">
                            <div class="card-header"><h4 class="card-title">@DstLocalization.T("MinStock") — @warehouses.Where(w => w.WarehouseID == warehouseId).Select(w => w.Name).FirstOrDefault()</h4></div>
                            <div class="card-body">
                                @if (canChange)
                                {
                                    <div class="form-row mb-1">
                                        <div class="col-md-6"><select id="slProduct" class="form-control" style="width:100%"></select></div>
                                        <div class="col-md-2"><input id="slQty" type="number" min="0" step="0.0001" class="form-control" placeholder="@DstLocalization.T("MinStock")" /></div>
                                        <div class="col-md-3"><input id="slMax" type="number" min="0" step="0.0001" class="form-control" placeholder="@DstLocalization.T("MinStock_Max")" title="@DstLocalization.T("MinStock_MaxHint")" /></div>
                                        <div class="col-md-1"><button type="button" id="slAdd" class="btn btn-success btn-block"><i class="bx bx-plus"></i></button></div>
                                    </div>
                                }
                                <table class="table table-sm mb-0">
                                    <tbody>
                                        @foreach (var l in limits)
                                        {
                                            <tr>
                                                <td>@l.Product</td>
                                                <td class="text-right">@l.MinQty.ToString("0.####") @l.Unit</td>
                                                <td class="text-right text-muted">@(l.MaxQty.HasValue ? "→ " + l.MaxQty.Value.ToString("0.####") : "")</td>
                                                <td class="text-right">
                                                    @if (canChange) { <button type="button" class="btn btn-sm btn-outline-danger" data-sl-remove="@l.ProductID"><i class="bx bx-trash"></i></button> }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_DstScripts")
    <script>
        $(function () {
            $('#gSave').on('click', function () {
                dstPost('@Url.Action("SaveGeneral")', {
                    minOrderAmount: $('#gMinOrder').val(), largeOrderAmount: $('#gLarge').val(), visitRadiusM: $('#gRadius').val(),
                    agentCashAccountId: $('#gAccount').val(), botUsername: $('#gBot').val(),
                    requireSelfie: $('#gSelfie').is(':checked'), botPublicUrl: $('#gBotUrl').val()
                }).done(function () { dstNotify(); });
            });
            $('#paySave').on('click', function () {
                var data = { methods: [] };
                $('#payTable tr[data-method]').each(function () {
                    var m = $(this).data('method');
                    if ($(this).find('[data-f=on]').is(':checked')) data.methods.push(m);
                    var acc = $(this).find('[data-f=acc]');
                    if (acc.length) data['account' + m.charAt(0) + m.slice(1).toLowerCase()] = acc.val();
                });
                dstPost('@Url.Action("SaveAgentPayments")', data).done(function () { dstNotify(); });
            });
            $('input[data-role]').on('change', function () {
                dstPost('@Url.Action("SaveDiscountLimit")', { roleId: $(this).data('role'), maxPercent: $(this).val() }).done(function () { dstNotify(); });
            });
            $('[data-wh-save]').on('click', function () {
                var tr = $(this).closest('tr');
                dstPost('@Url.Action("SaveWarehouse")', {
                    warehouseId: tr.data('wh'), isSalesPoint: tr.find('[data-f=sales]').is(':checked'),
                    allowNegative: tr.find('[data-f=neg]').is(':checked'), deliveryZone: tr.find('[data-f=zone]').val()
                }).done(function () { dstNotify(); });
            });
            @if (warehouseId.HasValue)
            {
                <text>
                $('#slProduct').select2({
                    ajax: { url: '@Url.Action("SearchProducts", "DstPrices")', dataType: 'json', delay: 300, data: function (p) { return { q: p.term }; } }
                });
                $('#slAdd').on('click', function () {
                    dstPost('@Url.Action("SaveStockLimit")', { warehouseId: @warehouseId, productId: $('#slProduct').val(), minQty: $('#slQty').val(), maxQty: $('#slMax').val() })
                        .done(function () { location.reload(); });
                });
                $('[data-sl-remove]').on('click', function () {
                    dstPost('@Url.Action("SaveStockLimit")', { warehouseId: @warehouseId, productId: $(this).data('slRemove'), minQty: '' })
                        .done(function () { location.reload(); });
                });
                </text>
            }
        });
    </script>
}
