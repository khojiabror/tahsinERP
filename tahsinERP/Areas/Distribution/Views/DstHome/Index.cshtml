@{
    ViewBag.Title = DstLocalization.T("Module_Title");
    string current = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName;
    string user = User.Identity.Name;
    var tiles = new[]
    {
        new { Controller = "DstOrders", Icon = "bx-cart", Title = DstLocalization.T("Orders"), Hint = DstLocalization.T("Tile_Orders") },
        new { Controller = "DstStock", Icon = "bx-box", Title = DstLocalization.T("Stock"), Hint = DstLocalization.T("Tile_Stock") },
        new { Controller = "DstPayments", Icon = "bx-money", Title = DstLocalization.T("Payments"), Hint = DstLocalization.T("Tile_Payments") },
        new { Controller = "DstDebts", Icon = "bx-receipt", Title = DstLocalization.T("Debts"), Hint = DstLocalization.T("Tile_Debts") },
        new { Controller = "DstReturns", Icon = "bx-undo", Title = DstLocalization.T("Returns"), Hint = DstLocalization.T("Tile_Returns") },
        new { Controller = "DstField", Icon = "bx-current-location", Title = DstLocalization.T("Field"), Hint = DstLocalization.T("Tile_Field") },
        new { Controller = "DstCustomers", Icon = "bx-store", Title = DstLocalization.T("Customers"), Hint = DstLocalization.T("Tile_Customers") },
        new { Controller = "DstProducts", Icon = "bx-package", Title = DstLocalization.T("Products"), Hint = DstLocalization.T("Tile_Products") },
        new { Controller = "DstPrices", Icon = "bx-purchase-tag", Title = DstLocalization.T("Prices"), Hint = DstLocalization.T("Tile_Prices") },
        new { Controller = "DstTerritories", Icon = "bx-map-alt", Title = DstLocalization.T("Territories"), Hint = DstLocalization.T("Tile_Territories") },
        new { Controller = "DstTeams", Icon = "bx-group", Title = DstLocalization.T("Teams"), Hint = DstLocalization.T("Tile_Teams") },
        new { Controller = "DstDictionaries", Icon = "bx-book", Title = DstLocalization.T("Dictionaries"), Hint = DstLocalization.T("Tile_Dictionaries") },
        new { Controller = "DstSettings", Icon = "bx-cog", Title = DstLocalization.T("Settings"), Hint = DstLocalization.T("Tile_Settings") },
        new { Controller = "DstImport", Icon = "bxs-file-excel", Title = DstLocalization.T("Import"), Hint = DstLocalization.T("Tile_Import") }
    };
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-8 col-12 mb-2 mt-1">
                <div class="breadcrumb-wrapper">
                    <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                        <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                        <li class="breadcrumb-item active">@DstLocalization.T("Module_Title")</li>
                    </ol>
                </div>
            </div>
            <div class="content-header-right col-md-4 col-12 mb-2 mt-1 text-md-right">
                @using (Html.BeginForm("SetLanguage", "DstHome", new { area = "Distribution" }, FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="btn-group btn-group-sm" role="group" aria-label="@DstLocalization.T("Language")">
                        <button type="submit" name="language" value="uz" class="btn @(current == "ru" ? "btn-outline-primary" : "btn-primary")">O'zbekcha</button>
                        <button type="submit" name="language" value="ru" class="btn @(current == "ru" ? "btn-primary" : "btn-outline-primary")">Русский</button>
                    </div>
                }
            </div>
        </div>

        <div class="content-body">
            <p class="text-muted">@DstLocalization.T("Module_Intro")</p>
            <div class="row">
                @foreach (var t in tiles.Where(t => tahsinERP.Models.RoleHelper.IsViewPermitted(user, t.Controller, "Index")))
                {
                    <div class="col-xl-3 col-md-4 col-sm-6">
                        <a href="@Url.Action("Index", t.Controller, new { area = "Distribution" })" class="card text-center" style="display:block">
                            <div class="card-body">
                                <div class="avatar bg-rgba-primary p-50 m-0 mb-1"><div class="avatar-content"><i class="bx @t.Icon text-primary font-medium-5"></i></div></div>
                                <h6 class="mb-25">@t.Title</h6>
                                <p class="small text-muted mb-0">@t.Hint</p>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
