@model List<tahsinERP.Areas.Distribution.Services.TerritoryTree.Node>
@{
    ViewBag.Title = DstLocalization.T("Territories");
    var usage = (Dictionary<int, int>)ViewBag.Usage;
    bool canChange = ViewBag.DstCanChange == true;
    bool ru = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName == "ru";
    string[] levelNames = { "", DstLocalization.T("Territory_Region"), DstLocalization.T("Territory_District"), DstLocalization.T("Territory_Area") };
}
@Html.AntiForgeryToken()
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        @Html.Partial("_DstHeader", (string)ViewBag.Title)
        <div class="content-body">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title mb-0">@ViewBag.Title</h4>
                    @if (canChange)
                    {
                        <button type="button" class="btn btn-success btn-sm" data-dst-edit data-parent="">
                            <i class="bx bx-plus"></i> @DstLocalization.T("Territory_AddRegion")
                        </button>
                    }
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>@DstLocalization.T("Name")</th>
                                    <th>@DstLocalization.T("NameRu")</th>
                                    <th>@DstLocalization.T("Level")</th>
                                    <th class="text-right">@DstLocalization.T("Customers")</th>
                                    <th>@DstLocalization.T("Status")</th>
                                    @if (canChange)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var n in Model)
                                {
                                    var t = n.Item;
                                    int used;
                                    usage.TryGetValue(t.ID, out used);
                                    <tr class="@(t.IsActive ? "" : "text-muted")">
                                        <td style="padding-left:@(12 + n.Depth * 24)px">
                                            @if (n.Depth > 0) { <span class="text-muted">└</span> }
                                            @t.Name
                                        </td>
                                        <td>@t.NameRu</td>
                                        <td>@levelNames[t.Level]</td>
                                        <td class="text-right">@used</td>
                                        <td>@(t.IsActive ? DstLocalization.T("Active") : DstLocalization.T("Inactive"))</td>
                                        @if (canChange)
                                        {
                                            <td class="text-right text-nowrap">
                                                @if (t.Level < 3)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-success" title="@DstLocalization.T("Territory_AddChild")"
                                                            data-dst-edit data-parent="@t.ID"><i class="bx bx-plus"></i></button>
                                                }
                                                <button type="button" class="btn btn-sm btn-outline-primary" title="@DstLocalization.T("Edit")"
                                                        data-dst-edit data-id="@t.ID" data-parent="@t.ParentID" data-name="@t.Name" data-name-ru="@t.NameRu"><i class="bx bx-edit-alt"></i></button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" title="@DstLocalization.T("ToggleActive")"
                                                        data-dst-toggle="@t.ID"><i class="bx bx-power-off"></i></button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" title="@DstLocalization.T("Delete")"
                                                        data-dst-delete="@t.ID"><i class="bx bx-trash"></i></button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="territoryModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">@DstLocalization.T("Territories")</h5></div>
            <div class="modal-body">
                <input type="hidden" id="tId" />
                <div class="form-group">
                    <label>@DstLocalization.T("Parent")</label>
                    <select id="tParent" class="form-control">
                        <option value="">— @DstLocalization.T("Territory_Region") —</option>
                        @foreach (var n in Model.Where(x => x.Item.Level < 3))
                        {
                            <option value="@n.Item.ID">@n.Path</option>
                        }
                    </select>
                </div>
                <div class="form-group"><label>@DstLocalization.T("Name")</label><input id="tName" class="form-control" maxlength="100" /></div>
                <div class="form-group"><label>@DstLocalization.T("NameRu")</label><input id="tNameRu" class="form-control" maxlength="100" /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-dismiss="modal">@DstLocalization.T("Cancel")</button>
                <button type="button" class="btn btn-primary" id="tSave">@DstLocalization.T("Save")</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_DstScripts")
    <script>
        $(function () {
            var urls = {
                save: '@Url.Action("Save")', toggle: '@Url.Action("Toggle")', del: '@Url.Action("Delete")'
            };
            $('[data-dst-edit]').on('click', function () {
                var b = $(this);
                $('#tId').val(b.data('id') || '');
                $('#tParent').val(b.data('parent') === undefined ? '' : String(b.data('parent')));
                $('#tName').val(b.data('name') || '');
                $('#tNameRu').val(b.data('nameRu') || '');
                $('#territoryModal').modal('show');
            });
            $('#tSave').on('click', function () {
                dstPost(urls.save, {
                    id: $('#tId').val(), parentId: $('#tParent').val(),
                    name: $('#tName').val(), nameRu: $('#tNameRu').val()
                }).done(function () { location.reload(); });
            });
            $('[data-dst-toggle]').on('click', function () {
                dstPost(urls.toggle, { id: $(this).data('dstToggle') }).done(function () { location.reload(); });
            });
            $('[data-dst-delete]').on('click', function () {
                if (!confirm(dstI18n.confirm)) return;
                dstPost(urls.del, { id: $(this).data('dstDelete') }).done(function () { location.reload(); });
            });
        });
    </script>
}
