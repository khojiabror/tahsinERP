@using tahsinERP.Areas.Distribution.Data.Entities
@{
    ViewBag.Title = DstLocalization.T("Payments");
    bool canChange = ViewBag.DstCanChange == true;
}
@Html.AntiForgeryToken()
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        @Html.Partial("_DstHeader", (string)ViewBag.Title)
        <div class="content-body">
            <div class="card">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center">
                    <h4 class="card-title mb-0">@ViewBag.Title</h4>
                    <div>
                        @if (canChange)
                        {
                            <button type="button" class="btn btn-success btn-sm" data-toggle="modal" data-target="#customerPick"><i class="bx bx-plus"></i> @DstLocalization.T("Payment_Receive")</button>
                        }
                        <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Cash")"><i class="bx bx-wallet"></i> @DstLocalization.T("Cash_Title")</a>
                    </div>
                </div>
                <div class="card-body">
                    <form id="payFilter" class="form-row mb-1">
                        <div class="col-md-3 mb-50">
                            <select name="method" class="form-control form-control-sm">
                                <option value="">@DstLocalization.T("Payment_Method")</option>
                                @foreach (var m in PaymentMethods.All) { <option value="@m">@DstLocalization.T("PayMethod_" + m)</option> }
                            </select>
                        </div>
                        <div class="col-md-3 mb-50">
                            <select name="state" class="form-control form-control-sm">
                                <option value="">@DstLocalization.T("All")</option>
                                <option value="onhand">@DstLocalization.T("Payment_OnHand")</option>
                                <option value="cancelled">@DstLocalization.T("Order_Cancelled")</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-50"><input type="date" name="from" class="form-control form-control-sm" /></div>
                        <div class="col-md-3 mb-50"><input type="date" name="to" class="form-control form-control-sm" /></div>
                    </form>
                    <table id="payTable" class="table table-striped table-bordered" style="width:100%">
                        <thead>
                            <tr>
                                <th>@DstLocalization.T("Order_No")</th><th>@DstLocalization.T("Date")</th><th>@DstLocalization.T("Customer")</th>
                                <th>@DstLocalization.T("Amount")</th><th>@DstLocalization.T("Payment_Method")</th><th>@DstLocalization.T("Payment_ReceivedBy")</th>
                                <th>@DstLocalization.T("Payment_Account")</th><th>@DstLocalization.T("Orders")</th><th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="customerPick" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">@DstLocalization.T("Customer")</h5></div>
            <div class="modal-body"><select id="pickCustomer" class="form-control" style="width:100%"></select></div>
            <div class="modal-footer"><button type="button" class="btn btn-primary" id="pickNext">@DstLocalization.T("Apply")</button></div>
        </div>
    </div>
</div>
@Html.Partial("_PaymentModal")

@section Scripts {
    @Html.Partial("_DstScripts")
    <script>
        $(function () {
            var money = new Intl.NumberFormat('ru-RU');
            var canChange = @(canChange ? "true" : "false");
            var table = dstServerTable('#payTable', {
                dataUrl: '@Url.Action("IndexData")', filterForm: '#payFilter', order: [[1, 'desc']],
                columns: [
                    { data: 'docNo', render: function (v, t, r) { return dstEsc(v) + (r.source !== 'web' ? ' <span class="badge badge-light-info">' + dstEsc(r.source) + '</span>' : ''); } },
                    { data: 'date' },
                    { data: 'customer', orderable: false, render: dstEsc },
                    { data: 'amount', className: 'text-right', render: function (v, t, r) { return r.cancelled ? '<s class="text-muted">' + money.format(v) + '</s>' : money.format(v); } },
                    { data: 'method', orderable: false, render: dstEsc },
                    { data: 'receiver', orderable: false, render: dstEsc },
                    { data: 'account', orderable: false, render: function (v, t, r) {
                        if (r.cancelled) return '<span class="text-danger" title="' + dstEsc(r.reason) + '">@DstLocalization.T("Order_Cancelled")</span>';
                        return r.onHand ? '<span class="badge badge-light-warning">@DstLocalization.T("Payment_OnHand")</span>' : dstEsc(v);
                    } },
                    { data: 'order', orderable: false, render: dstEsc },
                    { data: null, orderable: false, render: function (v, t, r) {
                        return canChange && !r.cancelled && !r.handedOver ? '<button type="button" class="btn btn-sm btn-outline-danger" data-cancel="' + r.id + '"><i class="bx bx-x"></i></button>' : '';
                    } }
                ]
            });
            window.dstAfterPayment = function () { table.ajax.reload(null, false); };
            $('#payTable').on('click', '[data-cancel]', function () {
                var reason = prompt('@DstLocalization.T("Reason")');
                if (!reason) return;
                dstPost('@Url.Action("Cancel")', { id: $(this).data('cancel'), reason: reason }).done(function () { table.ajax.reload(null, false); });
            });
            $('#pickCustomer').select2({
                dropdownParent: $('#customerPick'),
                ajax: { url: '@Url.Action("SearchCustomers", "DstOrders")', dataType: 'json', delay: 300, data: function (p) { return { q: p.term }; } }
            });
            $('#pickNext').on('click', function () {
                var d = $('#pickCustomer').select2('data')[0];
                if (!d) return;
                $('#customerPick').modal('hide');
                dstPaymentModal({ customerId: d.id, customerName: d.text });
            });
        });
    </script>
}
