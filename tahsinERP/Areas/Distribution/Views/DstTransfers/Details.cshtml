@using tahsinERP.Areas.Distribution.Controllers
@using tahsinERP.Areas.Distribution.Data.Entities
@{
    var act = (TransferAct)ViewBag.Act;
    var lines = (List<DstTransfersController.ActLineRow>)ViewBag.Lines;
    ViewBag.Title = act.DocNo;
    ViewBag.DstParent = DstLocalization.T("Transfers");
    bool canSeeCost = ViewBag.DstCanSeeCost == true;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        @Html.Partial("_DstHeader", (string)ViewBag.Title)
        <div class="content-body">
            @if (TempData["DstSaved"] != null) { <div class="alert alert-success">@TempData["DstSaved"]</div> }
            @if (TempData["DstError"] != null) { <div class="alert alert-danger">@TempData["DstError"]</div> }
            @if (act.Status == DocumentStatus.Cancelled) { <div class="alert alert-secondary">@DstLocalization.T("Order_Cancelled"): @act.CancelReason</div> }
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">@act.DocNo — @DstLocalization.T("Transfer_Act")</h4>
                    <div>
                        <a class="btn btn-outline-primary btn-sm" target="_blank" href="@Url.Action("Print", new { id = act.ID })"><i class="bx bx-printer"></i> @DstLocalization.T("Print")</a>
                        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index")">@DstLocalization.T("Back")</a>
                    </div>
                </div>
                <div class="card-body">
                    <p>
                        @DstLocalization.T("Transfer_From"): <b>@ViewBag.From</b> (@ViewBag.ExpenseDocNo) →
                        @DstLocalization.T("Transfer_To"): <b>@ViewBag.To</b> (@ViewBag.IncomeDocNo) ·
                        @DstLocalization.T("Date"): @act.DocDate.ToString("dd.MM.yyyy") · @ViewBag.Author
                        @if (act.Note != null) { <br /><span class="text-muted">@act.Note</span> }
                    </p>
                    @Html.Partial("_ActTable", Tuple.Create(act, lines, canSeeCost))
                    @if (act.Status == DocumentStatus.Posted && ViewBag.DstCanChange == true)
                    {
                        using (Html.BeginForm("Cancel", "DstTransfers", new { area = "Distribution", id = act.ID }, FormMethod.Post,
                            new { @class = "form-inline mt-1", onsubmit = "return confirm('" + DstLocalization.T("Transfer_CancelHint").Replace("'", "\\'") + "')" }))
                        {
                            @Html.AntiForgeryToken()
                            <input name="reason" class="form-control form-control-sm mr-50" placeholder="@DstLocalization.T("Reason")" required minlength="3" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="@DstLocalization.T("Transfer_CancelHint")">@DstLocalization.T("Transfer_CancelAct")</button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
