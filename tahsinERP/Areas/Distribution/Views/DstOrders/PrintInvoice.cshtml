@model tahsinERP.Areas.Distribution.Services.Orders.OrderDetailsModel
@{
    Layout = null;
    var o = Model.Order;
    var s = (tahsinERP.Areas.Distribution.Services.Orders.OrderDetailsModel.Shipment)ViewBag.Shipment;
    var byLine = Model.Lines.ToDictionary(l => l.ID);
    string Q(decimal v) => v.ToString("0.####");
    int n = 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@DstLocalization.T("Print_Invoice") @s.DocNo</title>
    @Html.Partial("_PrintStyles")
</head>
<body>
    <div class="sheet">
        <div class="noprint"><button onclick="window.print()">@DstLocalization.T("Print")</button></div>
        <h1>@DstLocalization.T("Print_Invoice") № @s.DocNo</h1>
        <div class="muted">@s.Date.ToString("dd.MM.yyyy") · @DstLocalization.T("Order_No"): @o.DocNo</div>
        <div class="meta">
            <div>
                <b>@DstLocalization.T("Print_Supplier"):</b><br />
                @(Model.Warehouse ?? "")
            </div>
            <div>
                <b>@DstLocalization.T("Print_Receiver"):</b> @Model.Customer.Name<br />
                @if (!string.IsNullOrEmpty(Model.Profile?.INN)) { <span>@DstLocalization.T("INN"): @Model.Profile.INN<br /></span> }
                @Model.Customer.Address @Model.Customer.Telephone
            </div>
        </div>
        <table>
            <thead>
                <tr>
                    <th class="c">#</th><th>@DstLocalization.T("Product")</th><th class="r">@DstLocalization.T("Qty")</th>
                    <th class="r">@DstLocalization.T("Price")</th><th class="r">@DstLocalization.T("Amount")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sl in s.Lines)
                {
                    var l = byLine[sl.OrderLineID];
                    decimal qtyUnit = l.Factor == 0 ? sl.QtyBase : sl.QtyBase / l.Factor;
                    <tr>
                        <td class="c">@(++n)</td>
                        <td>@l.PNo — @l.Product</td>
                        <td class="r">@Q(qtyUnit) @l.Unit</td>
                        <td class="r">@(qtyUnit == 0 ? "" : Math.Round(sl.Amount / qtyUnit, 2).ToString("N2"))</td>
                        <td class="r">@sl.Amount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><th colspan="4" class="r">@DstLocalization.T("Total")</th><th class="r">@s.Total.ToString("N2")</th></tr>
            </tfoot>
        </table>
        <p class="muted">
            @DstLocalization.T("PaymentDays"): @(Model.Profile?.PaymentDays ?? 0) ·
            @DstLocalization.T("Debt"): @Model.Credit.Balance.ToString("N0") @DstLocalization.T("Currency_Sum")
        </p>
        <div class="sign"><div>@DstLocalization.T("Print_Released")</div><div>@DstLocalization.T("Print_Received")</div></div>
    </div>
</body>
</html>
