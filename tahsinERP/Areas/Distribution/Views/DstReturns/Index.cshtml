@{
    ViewBag.Title = DstLocalization.T("Returns");
    bool canChange = ViewBag.DstCanChange == true;
}
@Html.AntiForgeryToken()
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        @Html.Partial("_DstHeader", (string)ViewBag.Title)
        <div class="content-body">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title mb-0">@ViewBag.Title</h4>
                    @if (canChange) { <a class="btn btn-success btn-sm" href="@Url.Action("Create")"><i class="bx bx-plus"></i> @DstLocalization.T("Return_New")</a> }
                </div>
                <div class="card-body">
                    <form id="retFilter" class="form-row mb-1">
                        <div class="col-md-3 mb-50"><input type="date" name="from" class="form-control form-control-sm" /></div>
                        <div class="col-md-3 mb-50"><input type="date" name="to" class="form-control form-control-sm" /></div>
                    </form>
                    <table id="retTable" class="table table-striped table-bordered" style="width:100%">
                        <thead>
                            <tr>
                                <th>@DstLocalization.T("Order_No")</th><th>@DstLocalization.T("Date")</th><th>@DstLocalization.T("Customer")</th>
                                <th>@DstLocalization.T("Total")</th><th>@DstLocalization.T("Warehouse")</th><th>@DstLocalization.T("Reason")</th><th>@DstLocalization.T("Orders")</th><th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_DstScripts")
    <script>
        $(function () {
            var money = new Intl.NumberFormat('ru-RU');
            var canChange = @(canChange ? "true" : "false");
            var table = dstServerTable('#retTable', {
                dataUrl: '@Url.Action("IndexData")', filterForm: '#retFilter', order: [[1, 'desc']],
                columns: [
                    { data: 'docNo', render: dstEsc },
                    { data: 'date' },
                    { data: 'customer', orderable: false, render: dstEsc },
                    { data: 'total', orderable: false, className: 'text-right', render: function (v, t, r) { return r.cancelled ? '<s class="text-muted" title="' + dstEsc(r.cancelReason) + '">' + money.format(v) + '</s>' : money.format(v); } },
                    { data: 'warehouse', orderable: false, render: function (v, t, r) { return dstEsc(v) + (r.defect ? ' <span class="badge badge-light-danger">@DstLocalization.T("Return_Defect")</span>' : ''); } },
                    { data: 'reason', orderable: false, render: dstEsc },
                    { data: 'order', orderable: false, render: dstEsc },
                    { data: null, orderable: false, render: function (v, t, r) {
                        return canChange && !r.cancelled ? '<button type="button" class="btn btn-sm btn-outline-danger" data-cancel="' + r.id + '"><i class="bx bx-x"></i></button>' : '';
                    } }
                ]
            });
            $('#retTable').on('click', '[data-cancel]', function () {
                var reason = prompt('@DstLocalization.T("Reason")');
                if (!reason) return;
                dstPost('@Url.Action("Cancel")', { id: $(this).data('cancel'), reason: reason }).done(function () { table.ajax.reload(null, false); });
            });
        });
    </script>
}
