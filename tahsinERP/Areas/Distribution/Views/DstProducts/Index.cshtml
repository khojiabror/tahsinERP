@{
    ViewBag.Title = DstLocalization.T("Products");
    bool canChange = ViewBag.DstCanChange == true;
}
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        @Html.Partial("_DstHeader", (string)ViewBag.Title)
        <div class="content-body">
            <div class="card">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center">
                    <h4 class="card-title mb-0">@ViewBag.Title</h4>
                    <div>
                        <a class="btn btn-outline-primary btn-sm" href="~/Product/Create"><i class="bx bx-plus"></i> @DstLocalization.T("Product_Create")</a>
                        @if (canChange)
                        {
                            <a class="btn btn-outline-success btn-sm" href="@Url.Action("Index", "DstImport", new { kind = "products" })"><i class="bx bxs-file-excel"></i> @DstLocalization.T("Import")</a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <form id="productFilter" class="form-row mb-1">
                        <div class="col-md-4 mb-50">
                            @Html.DropDownList("categoryId", (List<SelectListItem>)ViewBag.Categories, DstLocalization.T("All_Categories"), new { @class = "form-control form-control-sm" })
                        </div>
                        <div class="col-md-3 mb-50">
                            @Html.DropDownList("brandId", (List<SelectListItem>)ViewBag.Brands, DstLocalization.T("All_Brands"), new { @class = "form-control form-control-sm" })
                        </div>
                        <div class="col-md-3 mb-50">
                            <select name="sale" class="form-control form-control-sm">
                                <option value="">@DstLocalization.T("All")</option>
                                <option value="yes">@DstLocalization.T("Product_OnSale")</option>
                                <option value="no">@DstLocalization.T("Product_NotOnSale")</option>
                            </select>
                        </div>
                    </form>
                    <table id="productsTable" class="table table-striped table-bordered" style="width:100%">
                        <thead>
                            <tr>
                                <th>@DstLocalization.T("Article")</th>
                                <th>@DstLocalization.T("Name")</th>
                                <th>@DstLocalization.T("Category")</th>
                                <th>@DstLocalization.T("Brand")</th>
                                <th>@DstLocalization.T("Units")</th>
                                <th>@DstLocalization.T("Barcodes")</th>
                                <th>@DstLocalization.T("Price_Default")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_DstScripts")
    <script>
        $(function () {
            var editUrl = '@Url.Action("Edit")/';
            var money = new Intl.NumberFormat('ru-RU');
            dstServerTable('#productsTable', {
                dataUrl: '@Url.Action("IndexData")',
                filterForm: '#productFilter',
                order: [[1, 'asc']],
                columns: [
                    { data: 'pno', render: dstEsc },
                    { data: 'name', render: function (v, t, r) {
                        var s = dstEsc(v);
                        if (r.nameRu) s += '<div class="small text-muted">' + dstEsc(r.nameRu) + '</div>';
                        if (!r.hasProfile) s += ' <span class="badge badge-light-secondary">@DstLocalization.T("Product_NoProfile")</span>';
                        else if (!r.sale) s += ' <span class="badge badge-light-warning">@DstLocalization.T("Product_NotOnSale")</span>';
                        return s;
                    } },
                    { data: 'category', render: dstEsc },
                    { data: 'brand', render: dstEsc },
                    { data: 'units', orderable: false, render: function (v, t, r) { return dstEsc(r.unit) + (v ? ' +' + v : ''); } },
                    { data: 'barcodes', orderable: false, className: 'text-right' },
                    { data: 'price', className: 'text-right', render: function (v) { return v === null ? '<span class="text-danger">—</span>' : money.format(v); } },
                    { data: null, orderable: false, render: function (v, t, r) {
                        return '<a class="btn btn-sm btn-outline-primary" href="' + editUrl + r.id + '"><i class="bx bx-edit-alt"></i></a>';
                    } }
                ]
            });
        });
    </script>
}
