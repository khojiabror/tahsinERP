@model string
@* Sahifa sarlavhasi (breadcrumb). Model — sahifa nomi; ViewBag.DstParent — ixtiyoriy oraliq bo'g'in. *@
<div class="content-header row">
    <div class="content-header-left col-12 mb-2 mt-1">
        <div class="breadcrumb-wrapper">
            <ol class="breadcrumb rounded-pill breadcrumb-divider d-flex align-items-center">
                <li class="breadcrumb-item"><a href="~/Home"><i class="bx bx-home-alt"></i></a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "DstHome", new { area = "Distribution" })">@DstLocalization.T("Module_Title")</a></li>
                @if (ViewBag.DstParent != null)
                {
                    <li class="breadcrumb-item">@ViewBag.DstParent</li>
                }
                <li class="breadcrumb-item active">@Model</li>
            </ol>
        </div>
    </div>
</div>
