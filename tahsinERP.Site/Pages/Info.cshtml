@page "/{lang:regex(^(uz|ru)$)}/page/{slug}"
@model InfoModel
@{
    ViewData["Page"] = Model;
    var pg = Model.PageContent;
    var s = Model.Catalog.Settings;
}
<div class="container page narrow">
    <nav class="crumbs" aria-label="breadcrumb"><a href="@Site.Url("/")">@Model.T("Home")</a><span>/</span><span aria-current="page">@Model.Heading</span></nav>
    <h1>@Model.Heading</h1>
    <div class="prose">@SafeText.Render(T.Pick(Model.Lang, pg.BodyUz, pg.BodyRu))</div>
    @if (s.Phone != null || s.Address != null)
    {
        <div class="card-panel contact-card">
            @if (s.Phone != null) { <a href="tel:@s.Phone"><b>@s.Phone</b></a> }
            @if (s.Address != null) { <span class="muted">@s.Address</span> }
        </div>
    }
</div>
