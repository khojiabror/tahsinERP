<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Client bazasiga ulanish. Har kompaniyada boshqacha bo'lishi mumkin —
         generatorni ishga tushirishdan oldin shu qatorni to'g'rilang yoki
         dastur ichidagi "Ulanish" maydonidan kiriting. -->
    <add name="ClientDb"
         connectionString="Data Source=.;Initial Catalog=DBTHSN;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
